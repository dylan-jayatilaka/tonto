--langdef=foo
--map-foo=+.foo
--regex-foo=/^# +define +([A-Z0-9_]+)/\1/m,macro/
--regex-foo=/^   type ([A-Z][A-Z0-9_(){},]*)/\1/t,type/
--regex-foo=/^   array type ([A-Z][A-Z0-9_(){},]*)/\1/a,arrayType/
--regex-foo=/^   ([a-zA-Z][a-zA-Z0-9_]*[a-zA-Z0-9]) :: +[A-Z][A-Z0-9_(){},]*\*?/\1/v,moduleVar/
--regex-foo=/^     ([a-zA-Z][a-zA-Z0-9_]*[a-zA-Z0-9]?) :: +[A-Z][A-Z0-9_(){},]*\*?/\1/c,component/
--regex-foo=/^   ([a-zA-Z][a-zA-Z0-9]|[a-df-zA-Z][a-mo-zA-Z0-9_][a-ce-z0-9]|[a-zA-Z][a-zA-Z0-9_]{2,}[a-zA-Z0-9])([(][^)"]*[)])?( *result *[(][^)]*[)])?( *$| *::)/\1/p,procedure/
--regex-foo=/^   interface +([a-z][a-zA-Z0-9_]*[a-z0-9])/\1/i,interface/
--foo-types=+mtvcpi
--langmap=foo:+(macros).foo
--totals
--verbose
--sort=no
