{

   ! Exercise 4 -- the deformation density in the N-C=O plane, before and
   ! after the X-ray constraint.
   !
   ! Run it in this directory, in place:
   !
   !    ../../build/tonto --basis-library ../../basis_sets
   !
   ! The deformation density is
   !
   !    rho(molecule) - sum of spherical free-atom densities
   !
   ! i.e. what the electrons did when the atoms formed bonds: it is positive
   ! in the bonds and in the lone pairs, negative where density was drawn
   ! away. This job computes it twice on the same grid -- once from the
   ! ordinary wavefunction, once from the wavefunction fitted to the 817
   ! reflections -- so the two pictures can be subtracted.
   !
   ! Tonto writes the grid values; it does not draw the picture. The gnuplot
   ! commands are in the workshop document.

   name= urea_deformation

   basis_name= def2-SVP

   charge= 0
   multiplicity= 1

   CIF= { file_name= urea.HBB.cif2  data_block_name= urea }
   process_CIF

   crystal= {

      xray_data= {

         wavelength= 0.3173 angstrom

         partition_model= oc-hirshfeld

         optimise_extinction= NO
         optimise_scale_factor= YES

         do_residual_cube= NO

         REDIRECT urea.hkl

      }
   }


   ! ---- 1. the ordinary wavefunction -----------------------------------

   scfdata= {
      kind=            rhf
      initial_density= promolecule
      convergence= 0.001
      diis= { convergence_tolerance= 0.01 }
   }
   scf

   ! The plane. Atom 4 is C, atom 1 is O, atom 2 is N1, so the x axis runs
   ! C->O and the y axis C->N1: the plane of the amide group. The grid is
   ! 6 x 6 Angstrom, 101 x 101 points -- fine enough to contour smoothly.
   plot_grid= {
      kind= deformation_density
      centre_atom= 4
      x_axis_atoms= 4 1
      y_axis_atoms= 4 2
      x_width= 6 angstrom
      y_width= 6 angstrom
      n_points= 201
      plot_format= gnuplot
   }

   plot


   ! ---- 2. the same plane, from the constrained wavefunction ------------

   scfdata= {
      kind= xray_rhf
      initial_density= restricted
      convergence= 0.001
      diis= { convergence_tolerance= 0.01 }
      max_iterations= 60
      initial_lambda= 0.001
      lambda_step=    0.001
      lambda_max=     0.001
   }
   scf

   plot_grid= {
      kind= deformation_density
      centre_atom= 4
      x_axis_atoms= 4 1
      y_axis_atoms= 4 2
      x_width= 6 angstrom
      y_width= 6 angstrom
      n_points= 201
      plot_format= gnuplot
   }

   plot

   delete_scf_archives

}
