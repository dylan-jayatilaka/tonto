{
   ! Read a small MTZ reflection file, little- and big-endian copies of the
   ! same twelve reflections, and a four-atom PDB model; set the cell and
   ! spacegroup and the reflections from the MTZ file; and make cell maps
   ! from its columns. The files are made by scripts/make_test_mtz.py.
   name= tiny
   output_style_options= { real_precision= 4 }

   mtz= { file_name= tiny_le.mtz  f_calc_column= FC  phase_column= PHIC  put }
   process_mtz
   put_reflection_data

   mtz= { file_name= tiny_be.mtz  f_calc_column= FC  phase_column= PHIC  put }

   pdb_file= tiny.pdb
   put_atom_coordinates

   cell_map= { kind= mtz  mtz_columns= FC PHIC  mtz_sigma_column= none }
   put_cell_map
   cell_map= { mtz_columns= FP PHIC  mtz_sigma_column= SIGFP }
   put_cell_map
   cell_map= { moment_kind= riesz  sphere_atom= O  sphere_bond_atom= C  sphere_radius= 0.5 angstrom }
   put_cell_map_sphere_averages
}
