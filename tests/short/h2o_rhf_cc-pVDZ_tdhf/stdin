{

   keyword_echo_on
   
   output_style_options= {
      real_precision= 4
   }

   name=     h2o
   
   ! What basis to use?
   basis_name= cc-pVDZ
   
   ! Charge of molecule
   charge=   0
   multiplicity= 1
   
   ! List of atoms and coordinates
   atoms= {

      ! Data order ... note units!
      keys= { label= { units= angstrom } pos= }

      ! Atoms and coordinates
      data= {
         8     -0.028260    0.000029    0.000000
         1      0.599917    0.767685    0.000000
         1      0.599941   -0.767609    0.000000
      }

   }

   ! Write out info
   put

   ! SCF options
   scfdata= {
      initial_density= promolecule
      kind=            rhf
      convergence=     0.01
      diis= { convergence_tolerance= 0.001 }
   }
   scf

   ! CIS/TDHF
   ! No state selection: tol_S= 0.0
   td_data= {
      method=         r-CIS-s=0&1
      implementation= in-core
      tol_S= 0.0
      n_evals= 8
      n_max_show= 10
      show_iterations= NO
      show_evecs=      NO
      archive_results= NO
   }

   ! In core
   td_data= { implementation= in-core }
   td_data= { method= r-TDHF-s=0&1        } TD_excited_states
   td_data= { method= r-CIS-s=0&1         } TD_excited_states
   td_data= { method= u-CIS               } TD_excited_states

   ! Davidson
   td_data= { implementation= davidson }
   td_data= { method= r-CIS-ss-s=0&1      } TD_excited_states
   td_data= { method= u-CIS-ss            } TD_excited_states

   ! SCF options
   scfdata= {
      initial_MOs=  restricted
      initial_density= promolecule
      kind=         rhf
      convergence=  0.01
      diis= { convergence_tolerance= 0.001 }
      VMO_canonisation= hunt-goddard-3
   }
   scf

   ! State selection 100 eV canonical VMOs
   td_data= { tol_S= 100.0 eV }
   td_data= { method= u-CIS-ss            } TD_excited_states

   ! State selection 100 eV & IVOs & M=0
   td_data= {
      method=         u-CIS-ss
      implementation= davidson 
      tol_S= 100.0 eV 
      use_IVO_energies= T 
      archive_results= NO
   }
   td_data= { use_IVO_energies= T }
   td_data= { method= u-CIS-ss            } TD_excited_states
   td_data= { method= u-CIS-ss use_M_0= T } TD_excited_states

}

