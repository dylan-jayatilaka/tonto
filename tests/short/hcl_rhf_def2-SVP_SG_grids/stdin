{

   ! The published standard grids SG-0, SG-1, SG-2 and SG-3, as
   ! "becke_grid= { kind= sg-0 }" and so on: the number of points for
   ! each atom and the electron count on each grid.
   ! H and Cl have a published partition in every one of them.

   name=     hcl

   output_style_options= {
      real_precision= 6
   }

   basis_name= def2-SVP
   use_spherical_basis= TRUE

   charge=   0
   multiplicity= 1

   atoms= {

      keys= { label= { units= angstrom } pos= }

      data= {
         17      0.000000    0.000000    0.000000
          1      0.000000    0.000000    1.275000
      }

   }

   scfdata= {

      initial_density= promolecule
      kind=            rhf
      direct=          on
      convergence= 0.000001
      diis= { convergence_tolerance= 0.000001 }

      output= NO
      output_results= YES
   }

   scf
   make_natural_orbitals

   becke_grid= { kind= sg-0 }
   integrate_ed_numerically

   becke_grid= { kind= sg-1 }
   integrate_ed_numerically

   becke_grid= { kind= sg-2 }
   integrate_ed_numerically

   becke_grid= { kind= sg-3 }
   integrate_ed_numerically

   delete_scf_archives
}
