{

   ! RI-J for the coulomb matrix, COSX for the exchange matrix.
   ! ORCA 6.1.1 RIJCOSX def2/J gives -75.956924651; the exact RHF
   ! energy is -75.956818631.

   name=     h2o

   output_style_options= {
      real_precision= 8
   }

   basis_name= def2-SVP
   auxiliary_basis_name= def2-universal-jfit
   use_spherical_basis= TRUE

   charge=   0
   multiplicity= 1

   atoms= {

      keys= { label= { units= angstrom } pos= }

      data= {
         8     -0.028260    0.000029    0.000000
         1      0.599917    0.767685    0.000000
         1      0.599941   -0.767609    0.000000
      }

   }

   scfdata= {

      initial_density= promolecule
      kind=            rhf
      direct=          on
      use_RI_J=        TRUE
      use_COSX=        TRUE
      convergence= 0.000001
      diis= { convergence_tolerance= 0.000001 }

      output_results= YES
   }

   scf
   delete_scf_archives
}
