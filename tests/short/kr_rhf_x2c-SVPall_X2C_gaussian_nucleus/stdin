{

   ! Scalar-relativistic (X2C) Hartree-Fock on the krypton atom, spherical
   ! x2c-SVPall, with the gaussian nucleus of Visscher and Dyall. PySCF's
   ! spin-free X2C with the same basis, the same speed of light and the
   ! same nucleus gives -2787.687161752; with a point nucleus the energy
   ! is -2787.706164503.

   name=     kr_x2c_gn

   nucleus_model= gaussian

   output_style_options= {
      real_precision= 8
   }

   basis_name= x2c-SVPall
   use_spherical_basis= TRUE

   charge=   0
   multiplicity= 1

   atoms= {

      keys= { label= { units= angstrom } pos= }

      data= {
         36     0.0  0.0  0.0
      }

   }

   scfdata= {

      initial_density= core
      kind=            rhf
      relativity_kind= x2c

      direct=          on
      convergence= 0.000001
      diis= { convergence_tolerance= 0.000001 }

      output= NO
      output_results= YES
   }

   scf
   delete_scf_archives
}
