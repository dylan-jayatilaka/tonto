{

   ! Unrestricted B3LYP (the Gaussian form, VWN3) on the water cation,
   ! spherical def2-SVP. ORCA B3LYP/G NoRI gives -75.9054149180; with the
   ! default grid Tonto should sit within a few 1e-6 of it. This guards two
   ! defects fixed on 2026-10-04: the B3LYP potentials carried the B88 and
   ! LYP gradient terms at weight 1 instead of 0.72 and 0.81, and the
   ! beta-spin B88 potential used the alpha-spin factor. Both moved this
   ! energy by about 2e-4 and left the closed-shell BLYP untouched.

   name=     h2o+

   output_style_options= {
      real_precision= 8
   }

   basis_name= def2-SVP
   use_spherical_basis= TRUE

   charge=   1
   multiplicity= 2

   atoms= {

      keys= { label= { units= angstrom } pos= }

      data= {
         8     -0.028260    0.000029    0.000000
         1      0.599917    0.767685    0.000000
         1      0.599941   -0.767609    0.000000
      }

   }

   scfdata= {

      initial_density= promolecule
      kind=            uks

      dft_exchange_functional= b3lypgx
      dft_correlation_functional= b3lypgc
      direct=          on
      eri_accuracy= high
      convergence= 0.000001
      diis= { convergence_tolerance= 0.000001 }

      output_results= YES
   }

   scf
   delete_scf_archives
}
