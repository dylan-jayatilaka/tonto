{

  ! This job reads the MP2 natural orbitals of urea (STO-3G, relaxed density,
  ! written by ORCA 6.1 through orca_2mkl) from a Molden file. A natural
  ! orbital file has fractional occupations and no molecular orbitals.

   name= urea

   charge= 0
   multiplicity= 1

   read_molden_file urea_mp2_nos.molden

   put

}
