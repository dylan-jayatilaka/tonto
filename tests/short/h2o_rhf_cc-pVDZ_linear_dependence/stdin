{

   ! Water, cc-pVDZ, with the linear dependence tolerance raised so that
   ! basis functions are filtered out. The SCF must still converge: the
   ! DIIS error is taken in the space of the functions that are kept.

   name=     h2o_filtered

   output_style_options= {
      real_precision= 6
   }

   basis_name= cc-pVDZ

   charge=   0
   multiplicity= 1

   atoms= {

      keys= { label= { units= angstrom } pos= }

      data= {
         8     -0.028260    0.000029    0.000000
         1      0.599917    0.767685    0.000000
         1      0.599941   -0.767609    0.000000
      }

   }

   scfdata= {

      initial_density= promolecule
      kind=            rhf

      linear_dependence_tol= 0.05

      direct=          on
      convergence= 0.000001
      diis= { convergence_tolerance= 0.000001 }

      output= NO
      output_results= YES
   }

   scf
   delete_scf_archives
}
