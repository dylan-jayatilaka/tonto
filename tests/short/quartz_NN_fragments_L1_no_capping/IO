! Nearest-neighbour fragment construction for quartz at level 1 with capping
! turned off. Guards the level compensation in set_NN_capped_groups: uncapped,
! one shell fewer is asked of do_NN_defragment, since that routine always adds
! the shell beyond "level".
!
! The heavy atoms here must match those of quartz_NN_fragments_L1 exactly:
! H4O4Si -> O4Si and H6OSi2 -> OSi2.
!
! See tests/short/quartz_NN_fragments_L1/IO for the provenance of
! quartz_init.cif.

   input:   quartz_init.cif

   output:  group-1-O4Si.xyz
   output:  group-2-OSi2.xyz

   delete:  group-1-O4Si
   delete:  group-2-OSi2
