{

   ! Scalar-relativistic (X2C) Hartree-Fock on the krypton atom, spherical
   ! x2c-SVPall, point nucleus. PySCF's spin-free X2C with the same basis
   ! and the same speed of light gives -2787.706164503; without X2C the
   ! energy is -2734.571443493.

   name=     kr_x2c

   output_style_options= {
      real_precision= 8
   }

   basis_name= x2c-SVPall
   use_spherical_basis= TRUE

   charge=   0
   multiplicity= 1

   atoms= {

      keys= { label= { units= angstrom } pos= }

      data= {
         36     0.0  0.0  0.0
      }

   }

   scfdata= {

      initial_density= core
      kind=            rhf
      relativity_kind= x2c

      direct=          on
      convergence= 0.000001
      diis= { convergence_tolerance= 0.000001 }

      output_results= YES
   }

   scf
   delete_scf_archives
}
