{

   ! A Cartesian Hessian by finite differences of SCF energies, then the
   ! normal modes with the rigid-body motion projected out, and the ADPs
   ! of the stiff internal modes.

   name= h2o

   output_style_options= { real_precision= 6 }

   basis_name= STO-3G

   charge= 0
   multiplicity= 1

   atoms= {
      keys= { label= { units= angstrom } pos= }
      data= {
         O     -0.028260    0.000029    0.000000
         H      0.599917    0.767685    0.000000
         H      0.599941   -0.767609    0.000000
      }
   }

   scfdata= {
      initial_density= core
      kind=            rhf
      direct=          on
      convergence=     1.0e-11
      diis= { convergence_tolerance= 1.0e-8 }
      output=          NO
      output_results=  YES
   }
   scf

   fd_hessian_step= 0.01
   make_fd_hessian

   normal_mode_analysis
   put_normal_modes

   internal_adp_temperature= 100
   make_internal_adps
   put_internal_adps

}
