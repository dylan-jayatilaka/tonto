! Nearest-neighbour fragment construction for quartz at level 2 -- two shells
! of neighbours before capping. This is the shell-counting test: an off-by-one
! in the growth loop changes the chemical formula, and hence the file name.
!
! See tests/short/quartz_NN_fragments_L1/IO for the provenance of
! quartz_init.cif.

   input:   quartz_init.cif

   output:  group-1-H12O4Si5.xyz
   output:  group-2-H6O7Si2.xyz

   delete:  group-1-H12O4Si5
   delete:  group-2-H6O7Si2
