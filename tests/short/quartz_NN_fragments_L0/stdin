{

!  Nearest-neighbour fragmentation of a covalent network solid, at the
!  degenerate level: no shell of neighbours at all, so each fragment is
!  a single asymmetric unit atom with every bond replaced by a cap.
!
!  This is the edge case of the scheme, and the one most likely to break:
!  the fragment is built entirely out of capping atoms.
!
!     group-1-H4Si   silane, SiH4, around the 4-coordinate silicon
!     group-2-H2O    water,  OH2,  around the 2-coordinate oxygen
!
!  Davidson (2023) chapter 5 calls this L0+H, and reports it as by far
!  the worst model -- GoF^2 near 100 against about 10 at level 1. That is
!  a statement about the chemistry, not about this code: a bare atom in a
!  shell of hydrogens is a poor model of an atom in quartz. The test is
!  only that the fragment built is the one asked for.
!
!  Expected geometry, from the CCDC covalent radii:
!
!     Si-H   1.4300 A   = r_cov(Si) 1.20 + r_cov(H) 0.23
!     O-H    0.9100 A   = r_cov(O)  0.68 + r_cov(H) 0.23

   name= quartz

   output_style_options= { real_precision= 4 }

   basis_name= STO-3G

   charge= 0
   multiplicity= 1

   CIF= { file_name= quartz_init.cif }
   process_CIF

   crystal= {
      xray_data= {
         NN_level= 0
         use_NN_capping= TRUE
      }
   }

   put_atom_groups

}
