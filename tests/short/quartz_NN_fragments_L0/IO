! Nearest-neighbour fragment construction for quartz at level 0 -- a single
! asymmetric unit atom, capped on every bond. Silane around the silicon and
! water around the oxygen.
!
! The assertion is partly in the file NAMES: put_atom_group_mols names each
! fragment "group-<n>-<chemical formula>", so a wrong fragmentation leaves
! the declared output missing and the test fails loudly.
!
! See tests/short/quartz_NN_fragments_L1/IO for the provenance of
! quartz_init.cif.

   input:   quartz_init.cif

   output:  group-1-H4Si.xyz
   output:  group-2-H2O.xyz

   delete:  group-1-H4Si
   delete:  group-2-H2O
