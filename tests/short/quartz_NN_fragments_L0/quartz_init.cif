# =====================================================================
# alpha-quartz, SiO2 -- structural data only
# =====================================================================
#
# Trimmed from Quartz1_CD.cif (Olex2 1.5 / SHELXL 2019-3, 16 Jan 2024),
# the independent atom model refinement of a synchrotron-style single
# crystal measurement made at Bern by Yaser Balmohammadi, provided by
# Simon Grabowsky. Ag Kalpha, 100 K.
#
# This is the same crystal, though NOT the same data reduction, as the
# one used in chapter 5 of
#
#    M. L. Davidson, "Beyond X-rays: a critical analysis of quantum
#    chemistry based X-ray structure refinement and wavefunction
#    fitting techniques", PhD thesis, UWA, June 2023
#
# which reports the first Hirshfeld atom refinement of a covalent
# network solid. That reduction has 1134 unique reflections against
# this one's 1748; see tests/short/quartz_NN_fragments_L1/IO.
#
# Only the structure is kept here: the original file embeds all 162822
# measured reflections and is 169885 lines long.

data_quartz

_symmetry_cell_setting              Trigonal
_symmetry_space_group_name_H-M      'P 31 2 1'
_symmetry_space_group_name_Hall     'P 31 2"'
_symmetry_Int_Tables_number         '152'

loop_
    _symmetry_equiv_pos_as_xyz
'x, y, z'
'-y, x-y, z+1/3'
'-x+y, -x, z+2/3'
'y, x, -z'
'x-y, -y, -z+2/3'
'-x, -x+y, -z+1/3'

# =========
# Unit cell
# =========

_cell_length_a                   4.903720(20)
_cell_length_b                   4.903720(20)
_cell_length_c                   5.399640(30)
_cell_angle_alpha               90.000000(0)
_cell_angle_beta                90.000000(0)
_cell_angle_gamma              120.000000(0)
_cell_volume                   112.447000(1000)

_cell_measurement_temperature   100.00(10)

# =====
# Atoms
# =====

loop_
_atom_site_label
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_U_iso_or_equiv
_atom_site_adp_type
_atom_site_occupancy
_atom_site_disorder_group
  Si1   0.00000000(0)  0.53189(2)     0.66666700(0)  0.00314(1)   Uani  1.000000  0
   O1   0.27055(3)     0.85769(3)     0.55002(2)     0.00572(2)   Uani  1.000000  0

# ====
# ADPs
# ====

loop_
_atom_site_aniso_label
_atom_site_aniso_U_11
_atom_site_aniso_U_22
_atom_site_aniso_U_33
_atom_site_aniso_U_12
_atom_site_aniso_U_13
_atom_site_aniso_U_23
