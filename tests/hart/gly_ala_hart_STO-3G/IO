! fragHAR through hart: glycyl-L-alanine, two capped residues in the
! asymmetric unit, refined as separate charged fragments.
!
! This is the acceptance test for milestone H1 (docs/HART.md). It is the same
! science as tests/long/gly_ala_fragHAR_rhf_STO-3G, driven by argv instead of a
! job file, and it reproduces that reference to every digit the reference
! prints -- R(F) 0.0324, GoF 3.3535, N_r 2514, N_p 181, scale 0.9768.
!
! Why each option is here, since none of them is hart's default:
!
!   --mmcif t        residue (compound sequence) labels, hence Ryde-capped
!                    fragments rather than one connected group
!   --group-charges  the zwitterion: +1 on the glycine end, -1 on the alanine
!                    end. Braced, and quoted so the shell keeps the minus sign
!   --fos 0          no F/sigma pruning. hart defaults to 3, DIFFRACTION_DATA
!                    defaults to off, and the tonto job leaves it off -- with
!                    pruning on, N_r would not be 2514
!   --wavelength     this CIF has no _diffrn_radiation_wavelength item
!   --residual-cube f  the cube is 9 MB and the tonto job disables it too
!
! gly_ala_100K_F2.hkl is the tonto-format gly_ala_100K.hkl reduced to the plain
! `h k l F2 sigma` columns hart's --std-f2 reader takes (hart deliberately does
! not speak tonto's keyword hkl format):
!
!     awk 'NF==7 && $1 ~ /^-?[0-9]+$/ && $2 ~ /^-?[0-9]+$/ && $3 ~ /^-?[0-9]+$/ \
!          {print $1, $2, $3, $5, $6}' gly_ala_100K.hkl
!
! Column 4 is junk in the original key list, which is why $5/$6 and not $4/$5.

   program: hart
   args:    --job glyala --basis STO-3G --grid-accuracy low --mmcif t --fos 0 --residual-cube f --wavelength 0.59960 --group-charges '{ 1 -1 }' --std-f2 gly_ala_100K_F2.hkl gly_ala_100K.cif
   input:   gly_ala_100K.cif
   input:   gly_ala_100K_F2.hkl
   output:  glyala.out
   output:  glyala.archive.cif
   delete:  glyala.err
   delete:  glyala.HBB.cif2
   delete:  glyala.archive.fcf
   delete:  glyala.archive.fco
   delete:  glyala.cartesian.cif2
   delete:  glyala.fcf6
   delete:  glyala.fractional.cif1
   delete:  1-GLY
   delete:  1-GLY.xyz
   delete:  1-GLY.MOs,r
   delete:  1-GLY.MO_energies,r
   delete:  1-GLY.density_mx,r
   delete:  2-ALA
   delete:  2-ALA.xyz
   delete:  2-ALA.MOs,r
   delete:  2-ALA.MO_energies,r
   delete:  2-ALA.density_mx,r
   delete:  stdout.F_z_vs_stl
   delete:  stdout.Delta_F_vs_stl
   delete:  stdout.F_z_vs_F_exp
   delete:  stdout.QQ_plot_with_hkl
   delete:  stdout.QQ_plot.gnuplot
