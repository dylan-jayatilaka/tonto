  --basis STO-3G
  --grid-accuracy low
  --mmcif t
  --fos 0
  --residual-cube f
  --wavelength 0.59960
  --group-charges "{ 1 -1 }"
  --std-f2 gly_ala_100K_F2.hkl
  gly_ala_100K.cif

