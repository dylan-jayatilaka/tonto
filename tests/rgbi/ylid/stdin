{

   name=     ylid
   
   output_style_options= {
      real_precision= 4
   }
   
   read_molden_file ylid.molden
   
   put

   delete_scf_archives

   scfdata= { output= no }

   ! Roby population analysis
   robydata= {
      kind= atom_bond_analysis
      ! vdW contacts off: they are numerically the least stable part of the
      ! Roby analysis (weak, long-range overlaps against loose convergence),
      ! and were the whole of this test's macOS/Linux disagreement -- 14 of
      ! 17 differing hunks fell inside the vdW section. This test is here to
      ! exercise Roby bond indices, which do not need them. See
      ! ANTLR4_DEFERRED.md.
      analyze_vdw_atom_pairs= F
      output_theta_info= NO
   }

   roby_analysis

}

