{

   keyword_echo_on

!  Hirshfeld atom refinement of a covalent network solid, quartz, using
!  nearest-neighbour atom-centred fragments at level 1 with hydrogen
!  capping -- the L1+H model of Davidson (2023) chapter 5.
!
!  Two fragments, one per asymmetric unit atom:
!     group-1  Si(OH)4, orthosilicic acid, around the silicon
!     group-2  H3Si-O-SiH3, silyloxysilane, around the oxygen

   output_style_options= { real_precision= 4 }

   name= quartz

   basis_name= def2-SVP

   charge= 0
   multiplicity= 1

   cif= { file_name= quartz_init.cif }
   process_cif

   crystal= {

      xray_data= {

         wavelength= 0.56087

         partition_model= oc-hirshfeld

         optimise_extinction= NO

         do_residual_cube= FALSE

         NN_level= 1
         use_NN_capping= TRUE

         REDIRECT HKLdata.quartz

         show_refinement_output=  FALSE
         show_refinement_results= TRUE

      }
   }

   put

   scfdata= {
      kind= fragment-rhf
      initial_density= promolecule
      damp_factor= 0.99
      level_shift= 100
   }

   fraghar_refinement

!  Refine again with the extinction correction switched on, so that both sets
!  of results appear in this output: uncorrected above, corrected below.
!
!  The crystal is not rebuilt. read_crystal and read_xray_data both read
!  keywords into the existing objects, so the reflections, the fragments and
!  the refined structure all carry over and only the one switch changes. The
!  nesting is needed only because xray_data= is a CRYSTAL keyword and there is
!  no route to it from the top level of a job file.

   crystal= {
      xray_data= {
         optimise_extinction= YES
      }
   }

   fraghar_refinement

}
