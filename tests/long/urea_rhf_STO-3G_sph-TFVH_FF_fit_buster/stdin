{ 

  ! This job does a Hirshfeld atom refinement, with Salvador atoms whose
  ! radii come from the promolecule density (tfvh), based on a self
  ! consistent cluster charge SCF; then fits each atom's spherical form
  ! factor to Gaussians and writes them for BUSTER, with the retyped PDB
  ! file. The job of this name without _buster writes SHELX SFAC lines.

   name= urea

   output_style_options= { real_precision= 4 }

   basis_name= STO-3G

   charge= 0
   multiplicity= 1

   CIF= { file_name= urea_init.cif }
   process_CIF

   crystal= {

      xray_data= {

         partition_model= oc-sph-tfvh
         FF_fit_format= buster

         optimise_extinction= NO
         optimise_scale_factor= YEs

         do_residual_cube= NO

         show_refinement_output=  FALSE
         show_refinement_results= TRUE 
      
      }
   }

   scfdata= {
      initial_density= promolecule
      kind=            rhf
      convergence= 0.0001
      diis= { convergence_tolerance= 0.001 }
      output= NO
      output_results= YES
   }
   scf

   ! HAR
   HAR_refinement

   fit_sph_atom_ffs

   delete_scf_archives

}

 
