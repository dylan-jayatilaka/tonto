{

  ! This job makes the cluster of the urea molecule and the six molecules it
  ! hydrogen-bonds to, and lists the TFVC radii at the density and the
  ! electrostatic-potential minima. Bonds between two outer atoms copy the
  ! wall of an equivalent bond of the central molecule.

   name= urea

   output_style_options= { real_precision= 4 }

   basis_name= STO-3G

   charge= 0
   multiplicity= 1

   CIF= { file_name= urea_init.cif }
   process_CIF

   cluster= {
      generation_method= within_radius
      radius= 2.5 Angstrom
      defragment= true
      make_info
   }
   create_cluster

   crystal= { xray_data= { partition_model= oc-salvador } }

   scfdata= {
      initial_density= promolecule
      kind=            rhf
      convergence= 0.0001
      diis= { convergence_tolerance= 0.001 }
      output= NO
      output_results= YES
   }
   scf

   make_salvador_info
   put_salvador_radii

   delete_scf_archives

}
