{

   ! Hirshfeld atom refinement of urea at B3LYP/def2-TZVP, then maps of the
   ! cell from the Fourier coefficients: the model density, the observed
   ! density with the model's phases, and the local moments of each for
   ! l = 1 and l = 2 (the norm over m, Gaussian window 0.5 A).

   name= urea

   output_style_options= { real_precision= 4 }

   basis_name= def2-TZVP

   charge= 0
   multiplicity= 1

   CIF= { file_name= urea_init.cif }
   process_CIF

   crystal= {

      xray_data= {

         partition_model= oc-hirshfeld

         optimise_extinction= NO
         optimise_scale_factor= YES

         do_residual_cube= NO

         show_refinement_output=  FALSE
         show_refinement_results= TRUE

      }
   }

   scfdata= {
      initial_density= promolecule
      kind=            rks
      dft_exchange_functional= b3lypgx
      dft_correlation_functional= b3lypgc
      convergence= 0.0001
      diis= { convergence_tolerance= 0.001 }
      output= NO
      output_results= YES
   }
   scf

   HAR_refinement

   delete_scf_archives

   ! The maps, on the unit cell
   plot_grid= {
      kind= cell_map
      use_unit_cell_as_bbox
      desired_separation= 0.4 bohr
      plot_format= gaussian.cube
   }

   ! From the model structure factors
   cell_map= { kind= f_calc }
   put_cell_map
   plot_grid= { plot_label= f_calc }
   plot
   cell_map= { l_value= 1  window_width= 0.5 angstrom }
   plot_grid= { plot_label= f_calc_l1 }
   plot
   cell_map= { l_value= 2 }
   plot_grid= { plot_label= f_calc_l2 }
   plot

   ! From the observed structure factors, phased by the model
   cell_map= { kind= f_exp  l_value= -1 }
   put_cell_map
   plot_grid= { plot_label= f_exp }
   plot
   cell_map= { l_value= 1 }
   plot_grid= { plot_label= f_exp_l1 }
   plot
   cell_map= { l_value= 2 }
   plot_grid= { plot_label= f_exp_l2 }
   plot

}
