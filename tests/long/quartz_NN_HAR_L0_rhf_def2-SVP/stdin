{

   keyword_echo_on

!  Hirshfeld atom refinement of a covalent network solid, quartz, using
!  nearest-neighbour atom-centred fragments at level 0 with hydrogen
!  capping -- the L0+H model of Davidson (2023) chapter 5.
!
!  Two fragments, one per asymmetric unit atom:
!     group-1  SiH4, silane, around the silicon
!     group-2  OH2,  water,  around the oxygen

   output_style_options= { real_precision= 4 }

   name= quartz

   basis_name= def2-SVP

   charge= 0
   multiplicity= 1

   cif= { file_name= quartz_init.cif }
   process_cif

   crystal= {

      xray_data= {

         wavelength= 0.56087

         partition_model= oc-hirshfeld

         optimise_extinction= NO

         do_residual_cube= FALSE

         NN_level= 0
         use_NN_capping= TRUE

         REDIRECT HKLdata.quartz

         show_refinement_output=  FALSE
         show_refinement_results= TRUE

      }
   }

   put

   scfdata= {
      kind= fragment-rhf
      initial_density= promolecule
      damp_factor= 0.99
      level_shift= 100
   }

   fraghar_refinement

}
