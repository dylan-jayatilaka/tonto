{

   keyword_echo_on

   ! Print non-energetic quantities to 4 dp, as most of the other test jobs
   ! already do. At the convergence settings used here they are only good to
   ! about 4 dp anyway -- refinement statistics (R factors, GoF) and derived
   ! moments drift in the 3rd-4th place between platforms -- so printing 6 dp
   ! records noise as though it were signal, and made this test fail the
   ! last-digit criterion on a difference that is not physically meaningful.
   ! Energies, which are good to ~6 dp in Hartree, are unaffected.
   output_style_options= { real_precision= 4 }

   name= glyala

   basis_name= STO-3G

   cif= {
      file_name= gly_ala_100K.cif
      mmCIF_format= TRUE
   }
   process_cif



   crystal= {

      xray_data= {

         wavelength= 0.59960

         partition_model=         oc-hirshfeld

         optimise_extinction= NO

         do_residual_cube= FALSE

         use_Ryde_capping= YES

       ! use_disk_SFs= yes ! <<<<<<<<<<<
       ! use_text_sfs= YES

         REDIRECT gly_ala_100K.hkl

         show_refinement_output=  FALSE
         show_refinement_results= TRUE

      }
   }

   put

   scfdata= {
      kind= fragment-rhf
      initial_density= promolecule
      damp_factor= 0.99
      level_shift= 100
   }
 ! scf

   ! Change charge/multiplicity
   atom_groups= {

      keys= { charge= }

      altered_data= { 
         1  1 
         2 -1
      }

   }

   fraghar_refinement

}
