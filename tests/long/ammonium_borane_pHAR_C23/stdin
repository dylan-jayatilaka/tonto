{ 

   keyword_echo_on

   name= Test_B6H6

   ! Process the CIF
   CIF= {
       file_name= B6H6_grown.cif
    }

   name= Test_B6H6
   
!   basis_directory= /usr/local/bin/basis_sets
   basis_name= pob-TZVP-rev2

   ! Irrelevant for periodic
   charge= 0
   multiplicity= 1

   c23_XML_file_name= GenerateXML.XML
   process_cif_and_c23_xml

   name= Test_B6H6

   crystal= {    
      spacegroup= { hermann_mauguin_symbol= "f m -3 m" }
      xray_data= {   
         thermal_smearing_model= atom-based
         partition_model= oc-crystal23
         optimise_extinction= false
         correct_dispersion= no
         optimise_scale_factor= true
         wavelength= 0.71073 Angstrom
         REDIRECT tonto_data_on_F_20rfl.hkl
         f_sigma_cutoff= 4
         tol_for_shift_on_esd= 0.010000
         refine_H_U_iso= no
	 max_iterations= 30
	 show_fit_output= FALSE
	 show_fit_results= TRUE

      }  
   }  

   phar_defragment
   ha_fit
}
