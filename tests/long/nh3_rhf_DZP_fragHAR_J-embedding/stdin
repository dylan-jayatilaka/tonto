{

  ! A short fragment Hirshfeld atom refinement with the Coulomb embedding,
  ! the molecule being the one fragment: the neighbour molecules within
  ! 3.5 angstrom enter by their density and nuclei, the rest of the
  ! crystal by cluster charges, and the fragment SCF is repeated until
  ! its density agrees with that of its neighbours. Two refinement cycles
  ! only, to keep it quick. The ordinary HAR of the same crystal is
  ! nh3_rhf_DZP_HAR_J-embedding.

   name=     nh3

   output_style_options= { real_precision= 3 }

   basis_name= DZP

   charge=   0
   multiplicity= 1


   ! Crystal data - including reflections
   crystal= {

      spacegroup= {  hermann_mauguin_symbol=  "P 21 3" }

      unit_cell= {
         angles=       90.0   90.0   90.0   Degree   ! Note units:
         dimensions=  5.1305 5.1305 5.1305  Angstrom ! Default is atomic units
      }

      xray_data= {

         wavelength= 0.59960

         partition_model= oc-hirshfeld

         optimise_extinction= NO

         min_iterations= 1
         max_iterations= 2

         display_near_0_eigenvectors= NO

         do_residual_cube= FALSE

         ! Reflections here
         REDIRECT data.nh3

         show_refinement_output=  FALSE
         show_refinement_results= TRUE

      }

   }


   ! Atom fraction coordinates and ADPs
   atoms= {

      keys= { label= { axis_system= crystal } pos= { units= angstrom^2 } thermal_tensor= }

      data= {
         N  0.2103   0.2103   0.2103   0.03720  0.03720  0.03720  -0.0009  -0.0009  -0.0009
         H  0.3722   0.2627   0.1113   0.0530   0.0530   0.0530    0.00     0.00     0.00
         H  0.1113   0.3722   0.2627   0.0530   0.0530   0.0530    0.00     0.00     0.00
         H  0.2627   0.1113   0.3722   0.0530   0.0530   0.0530    0.00     0.00     0.00
      }

   }

   put

   ! Integrationo grid to get Hirshfeld charges.
   becke_grid = {
      set_defaults
      accuracy= high
   }


   ! The whole molecule is one fragment
   atom_groups= {
      keys= { name= atom_indices= }
      data= {
         ammonia { 1 ... 4 }
      }
   }

   scfdata= {
     kind=            fragment-rhf
     initial_density= promolecule
     use_SC_cluster_charges= TRUE
     cluster_radius= 8 angstrom
     embedding_radius= 3.5 angstrom
     convergence= 0.00001
     diis= { convergence_tolerance= 0.00001 }
   }

   fraghar_refinement

}
