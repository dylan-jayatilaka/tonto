{

   ! Solid ammonia, P 21 3, described in its subgroup P 1 21 1 (origin
   ! moved by -1/4 along c), so that two molecules are independent: two
   ! fragments, each embedded in the density of its neighbours within
   ! 3.5 angstrom and in cluster charges to 8 angstrom. The two are
   ! equivalent in P 21 3, so their energies must be equal, and the same
   ! as for the one molecule of P 21 3. put_fragment_neighbours lists
   ! the neighbours; its table of pair sums must be symmetric.

   name=     nh3

   output_style_options= { real_precision= 6 }

   basis_name= DZP

   crystal= {
      spacegroup= {  hermann_mauguin_symbol=  "P 1 21 1" }
      unit_cell= {
         angles=       90.0   90.0   90.0   Degree
         dimensions=  5.1305 5.1305 5.1305  Angstrom
      }
   }

   atoms= {
      keys= { label= { axis_system= crystal } pos= }
      data= {
         N    0.2103   0.2103  -0.0397
         H    0.3722   0.2627  -0.1387
         H    0.1113   0.3722   0.0127
         H    0.2627   0.1113   0.1222
         N    0.7103   0.2897  -0.4603
         H    0.8722   0.2373  -0.3613
         H    0.6113   0.1278  -0.5127
         H    0.7627   0.3887  -0.6222
      }
   }

   atom_groups= {
      keys= { name= atom_indices= }
      data= {
         nh3_a { 1 ... 4 }
         nh3_b { 5 ... 8 }
      }
   }

   put

   becke_grid = {
      set_defaults
      accuracy= high
   }

   scfdata= {
     kind=            fragment-rhf
     initial_density= promolecule
     use_SC_cluster_charges= TRUE
     cluster_radius= 8 angstrom
     embedding_radius= 3.5 angstrom embedding_update_tolerance= 0.000000001
     convergence= 0.000000001
     diis= { convergence_tolerance= 0.000000001 }
   }

   scf

   put_fragment_neighbours

}
