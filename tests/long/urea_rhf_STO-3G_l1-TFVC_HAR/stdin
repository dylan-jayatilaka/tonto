{ 

  ! This job does a Hirshfeld atom refinement with spherically averaged
  ! Salvador atoms plus each atom's l = 1 (dipolar) density term (l1-tfvc),
  ! based on a self consistent cluster charge SCF. The spherical atom alone
  ! (sph-tfvc) does not converge on this job.

   name= urea

   output_style_options= { real_precision= 4 }

   basis_name= STO-3G

   charge= 0
   multiplicity= 1

   CIF= { file_name= urea_init.cif }
   process_CIF

   crystal= {

      xray_data= {

         partition_model= oc-l1-tfvc

         optimise_extinction= NO
         optimise_scale_factor= YEs

         do_residual_cube= NO

         show_refinement_output=  FALSE
         show_refinement_results= TRUE 
      
      }
   }

   scfdata= {
      initial_density= promolecule
      kind=            rhf
      convergence= 0.0001
      diis= { convergence_tolerance= 0.001 }
      output= NO
      output_results= YES
   }
   scf

   ! HAR
   HAR_refinement

   delete_scf_archives

}

 
