         .RHO:make_laplacian_orbital_grid_r(D,P,NO,.NOs.r(:,n), pt)

         occ = .NO_occ_nos.r(n)

         K_grid = K_grid + occ*NO*(D(:,1)+D(:,2)+D(:,3))
