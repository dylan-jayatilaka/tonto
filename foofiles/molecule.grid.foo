      label = trim(label) // trim(.plot_grid.bond_density_atom(2).to_str)
      if (.plot_grid.bond_density_atom.dim==3) &
      label = trim(label) // ":" // trim(.plot_grid.bond_density_atom(3).to_str)
      label = trim(label) // ")_weight_grid"

      ! Print out
