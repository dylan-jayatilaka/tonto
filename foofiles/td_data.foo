   end

   put_options
   ! Prints summary of what options being used.
      self :: IN

      n,lo,hv :: INT

      ::put_banner

      stdout.flush
      stdout.show("Method                    = ", .method)
      stdout.show("Implementation            = ", .implementation)

      stdout.flush
      stdout.show("# of states wanted        = ", .n_evals)
      stdout.show("# of trial evecs to keep  = ", .n_keep)
      stdout.show("Max. # of iterations      = ", .max_iterations)
      stdout.show("Residual convergence tol  = ", .tol_Davidson)

      stdout.flush
    ! stdout.text("Dimensions")
    ! stdout.flush
    ! stdout.show("n_a                       = ", .n_a)
    ! stdout.show("n_b                       = ", .n_b)
      stdout.show("n_occ                     = ", .n_occ)
      stdout.show("n_vir                     = ", .n_vir)
      stdout.show("n_occ x n_vir             = ", .n_occ*.n_vir)

    ! stdout.flush
    ! stdout.text("Tolerances & convergence:")
    ! stdout.flush
    ! stdout.show("Minimum # of iterations   =", .min_iterations)

      stdout.flush
      stdout.text("State selection:")
      stdout.flush
      stdout.show("Single excitation window  =", .tol_S)
      n  = .no_of_singles
      lo = .min_O_in_S_window
      hv = .max_V_in_S_window
      stdout.show("# of states in window     =", n)
      stdout.show("omega                     =", .omega)
      stdout.show("Doubles selection tol     =", .tol_D)
      stdout.show("Lowest  HOMO in window    = ", lo)
      stdout.show("Highest LUMO in window    = ", hv)
      stdout.show("Use S window MOs?         =", .use_S_window_MOs)

      stdout.flush

   end

   put_MO_energies
   ! Prints out the MO energies. May make use of .single 
   ! excitation energy to reduce output.
      self :: IN

      no,lo,hv :: INT

      stdout.flush
      stdout.text("===========")
      stdout.text("MO energies")
      stdout.text("===========")

      if (.single.deallocated) then

         ! No S window info
         stdout.flush
         stdout.text("Occupied MO energies:")
         stdout.put(.Eo)
        
         stdout.flush
         stdout.text("Virtual MO energies:")
         stdout.put(.Ev)

      else

         ! Use S window to reduce output
         no = .n_occ
         lo = .min_O_in_S_window
         hv = .max_V_in_S_window

         stdout.flush
         stdout.text(". Only the topmost HOMO, and lowest LUMO, energies")
         stdout.text("  are written below, those in the S window.")
         stdout.flush
         stdout.text(". All energies are in ascending order")
         stdout.flush
         stdout.show("No. of occupied MOs       = ", .n_occ)
         stdout.show("Lowest  HOMO in window    = ", lo)
         stdout.show("Highest LUMO in window    = ", hv)


         stdout.flush
         stdout.text("Occupied MO energies:")
         stdout.put(.Eo(lo:no))

         stdout.flush
         stdout.text("Virtual MO energies:")
         stdout.put(.Ev(1:hv))


      end


   end

