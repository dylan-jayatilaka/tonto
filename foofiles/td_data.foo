!  ============
!  TD calc info
!  ============

   do_sqrt_evals result(res) ::: PURE
   ! Return TRUE if the eigenvalues of the TD equations
   ! should be square-rooted.
      self :: IN
      res  :: BIN
      res = .method.includes("-tdhf")
   end

   is_an_SS_method result(res) ::: PURE
   ! Return TRUE if the method is a state-slected method.
      self :: IN
      res  :: BIN
      res = .method.includes("-ss")
   end

   is_CIS result(res) ::: PURE
   ! Return TRUE if it is a CIS/Tamm-Dancoff calculation 
   ! which does not require an off-diagonal "B" matrix.
      self :: IN
      res  :: BIN
      res = .method.includes("-cis")
   end

   is_Tamm_Dancoff result(res) ::: PURE
   ! Return TRUE if it is a CIS/Tamm-Dancoff calculation 
   ! which does not require an off-diagonal "B" matrix.
      self :: IN
      res  :: BIN
      res = .method.includes("-cis")
   end

   has_states result(res) ::: PURE
   ! Return TRUE if the states have been calculated.
   ! It is assumed that these are singlet states and
   ! if a triplet calculation is run afterwards, those
   ! states are appended.
      self :: IN
      res  :: BIN
      res = .eval.allocated AND .evec.allocated
   end

!  ====================
!  State selection info
!  ====================

   no_of_singles result (res) ::: pure
   ! The number of single excitations which satisfy the tol_S
   ! excitation window.
      self :: IN
      res  :: INT

      i,a :: INT
      val :: REAL

      if (.tol_S.equals(ZERO)) then

         res = .n_vir*.n_occ

      else

         res = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            if (val<.tol_S) then
               res = res + 1
            end
         end
         end

      end

   end

   no_of_doubles result(res) ::: PURE
   ! The number of double excitations within energy .tol_D
   ! of excitation energy .omega.
      self :: IN
      res  :: INT

      i,a,ai :: INT
      j,b,bj :: INT
      Eai,Ebj,val :: REAL
      OList,VList :: VEC{INT}@

      ! Exit?
      res = .no_of_singles
      if (res==0) return
      if (.single.deallocated) return
      if (.omega.equals(ZERO)) return

      ! List of allowed occs and virs
      OList = .Os_in_S_window
      VList = .Vs_in_S_window

      ! Get the energy differences
      res = 0
      do i = .n_occ,1,-1
      do a = 1,.n_vir
         ai = a + (i-1)*.n_vir
         Eai = .Ev(a) - .Eo(i)
         do j = .n_occ,1,-1
         do b = 1,.n_vir
            bj = b + (j-1)*.n_vir
            if (bj>ai) cycle
            if (.use_S_window_MOs) then
            if (NOT any(i==OList)) cycle
            if (NOT any(a==VList)) cycle
            if (NOT any(j==OList)) cycle
            if (NOT any(b==VList)) cycle
            end
            Ebj = .Ev(b) - .Eo(j)
            val = Eai + Ebj
            if (abs(val-.omega)<.tol_D AND val<.tol_S) then
               res = res + 1
            end
         end
         end
      end
      end

   end

   Os_in_S_window result (res) ::: leaky, PURE
   ! List of occupied MOs in the singles-excitation window.
      self :: IN
      res  :: VEC{INT}@

      i :: INT

      if (.single.allocated AND NOT .tol_S.is_zero) then
         res = .single(:,2)
         res.remove_repetitions
      else
         res = [ ( i, i=1,.n_occ) ]
      end

   end

   Vs_in_S_window result (res) ::: leaky, PURE
   ! List of virtual MOs in the singles-excitation window.
      self :: IN
      res  :: VEC{INT}@

      i :: INT

      if (.single.allocated AND NOT .tol_S.is_zero) then
         res = .single(:,1)
         res.remove_repetitions
      else
         res = [ (i, i=1,.n_vir) ]
      end

   end

   V_of_VO(vo) result(res) ::: pure
   ! The V index in a compressed VO pair-index
      self :: IN
      vo   :: VEC{INT}, IN
      res  :: VEC{INT}(vo.dim)
      res = modulo(vo,.n_vir) ! remainder
   end

   O_of_VO(vo) result(res) ::: pure
   ! The V index in a compressed VO pair-index
      self :: IN
      vo   :: VEC{INT}, IN
      res  :: VEC{INT}(vo.dim)
      res = (vo-1)/.n_vir + 1
   end

   min_O_in_S_window result(res) ::: PURE
   ! Minimum value of the occupied orbital index in the S window.
      self :: IN
      res  :: INT
      res = minval(.Os_in_S_window)
   end

   max_V_in_S_window result(res) ::: PURE
   ! Minimum value of the occupied orbital index in the S window.
      self :: IN
      res  :: INT
      res = maxval(.Vs_in_S_window)
   end

!  =======================
!  State selection methods
!  =======================

   docu_sort_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("sort_singles")
      stdout.flush
      stdout.text(". Sort the single-excitations into increasing energy order.")
      stdout.text("  Not needed, but recommended for interpretation of the states")
      if (present(die)) stop
   end

   sort_singles ::: leaky, PURE
   ! Sorts single excitations by smallest eigenvalue energy 
   ! difference, and keep pairs in the single(:,1:2) array.
      self :: INOUT

      i,a, n :: INT
      val :: REAL
      ind :: VEC{INT}@

      ! Can proceed?
      n = .no_of_singles
      if (n==0) return

      ! Leaky !!!!!!!!!!!
      .deltaE.create(n)
      .single.create(n,2)
      !!!!!!!!!!!!!!!!!!!

      if (.tol_S.is_zero) then

         ! Get all
         n = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            n = n + 1
            .deltaE(n)   = val
            .single(n,1) = a
            .single(n,2) = i
         end
         end

      else

         ! Get delta E and S indices
         n = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            if (val<.tol_S) then
               n = n + 1
               .deltaE(n)   = val
               .single(n,1) = a
               .single(n,2) = i
            end
         end
         end

      end

      ! Sort
      ind.create(n)
      .deltaE.quick_sort(ind)

      ! Reorder
      .deltaE      = .deltaE(ind)
      .single(:,1) = .single(ind,1)
      .single(:,2) = .single(ind,2)

      ! Set min & max OMO and VMO
      .min_OMO = .min_O_in_S_window
      .max_VMO = .max_V_in_S_window

   end

   docu_find_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("find_doubles")
      stdout.flush
      stdout.text(". Find all double excitations within a certain tolerance")
      stdout.text("  of a previously entered excitation energy, entered via")
      stdout.text("  omega= and tol_D=")
      if (present(die)) stop
   end

   find_doubles ::: leaky, PURE
   ! Find the double excitations within a certain tolerance
      self :: INOUT

      n :: INT
      i,a,ai :: INT
      j,b,bj :: INT
      Eai,Ebj,val :: REAL
      OList,VList :: VEC{INT}@
      ind :: VEC{INT}@
      del :: VEC{REAL}@

      ! Can we proceed?
      n = .no_of_doubles
      if (n==0) return

      .delEab.create(n)
      .double.create(n,2)

      ! List of allowed occs and virs
      OList = .Os_in_S_window
      VList = .Vs_in_S_window

      ! Get the energy differences
      n = 0
      do i = .n_occ,1,-1
      do a = 1,.n_vir
         ai = a + (i-1)*.n_vir
         Eai = .Ev(a) - .Eo(i)
         do j = .n_occ,1,-1
         do b = 1,.n_vir
            bj = b + (j-1)*.n_vir
            if (bj>ai) cycle
            if (.use_S_window_MOs) then
            if (NOT any(i==OList)) cycle
            if (NOT any(a==VList)) cycle
            if (NOT any(j==OList)) cycle
            if (NOT any(b==VList)) cycle
            end
            Ebj = .Ev(b) - .Eo(j)
            val = Eai + Ebj
            if (abs(val-.omega)<.tol_D AND val<.tol_S) then
               n = n + 1
               .delEab(n)   = val - .omega ! Note sign
               .double(n,1) = ai
               .double(n,2) = bj
            end
         end
         end
      end
      end

      ! Sort by abs difference
      ind.create(n)
      del = abs(.delEab)
      del.quick_sort(ind)
      del.destroy

      ! Reorder
      .delEab      = .delEab(ind)
      .double(:,1) = .double(ind,1)
      .double(:,2) = .double(ind,2)

   end

