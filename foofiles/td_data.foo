 !  =======
 !  Inquiry
 !  =======

   is_Tamm_Dancoff result(res) ::: PURE
   ! Return TRUE if it is a Tamm-Dancoff calculation which 
   ! does not require an off-diagonal "B" matrix.
      self :: IN
      res  :: BIN
      res = .method.includes("-tda")
   end

   no_of_singles result (res) ::: pure
   ! The number of single excitations which satisfy the tol_S
   ! excitation window.
      self :: IN
      res  :: INT

      i,a :: INT
      val :: REAL

      if (.tol_S.equals(ZERO)) then

         res = .n_vir*.n_occ

      else

         res = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            if (val<.tol_S) then
               res = res + 1
            end
         end
         end

      end

   end

   no_of_doubles result(res) ::: PURE
   ! The number of double excitations within energy .tol_D
   ! of excitation energy .omega.
      self :: IN
      res  :: INT

      i,a,ai :: INT
      j,b,bj :: INT
      Eai,Ebj,val :: REAL
      OList,VList :: VEC{INT}@

      ! Exit?
      res = .no_of_singles
      if (res==0) return
      if (.single.deallocated) return
      if (.omega.equals(ZERO)) return

      ! List of allowed occs and virs
      OList = .Os_in_S_window
      VList = .Vs_in_S_window

      ! Get the energy differences
      res = 0
      do i = .n_occ,1,-1
      do a = 1,.n_vir
         ai = a + (i-1)*.n_vir
         Eai = .Ev(a) - .Eo(i)
         do j = .n_occ,1,-1
         do b = 1,.n_vir
            bj = b + (j-1)*.n_vir
            if (bj>ai) cycle
            if (.use_S_window_MOs) then
            if (NOT any(i==OList)) cycle
            if (NOT any(a==VList)) cycle
            if (NOT any(j==OList)) cycle
            if (NOT any(b==VList)) cycle
            end
            Ebj = .Ev(b) - .Eo(j)
            val = Eai + Ebj
            if (abs(val-.omega)<.tol_D AND val<.tol_S) then
               res = res + 1
            end
         end
         end
      end
      end

   end

   Os_in_S_window result (res) ::: leaky, PURE
   ! List of occupied MOs in the singles-excitation window.
      self :: IN
      res  :: VEC{INT}@

      i :: INT

      if (.tol_S.is_zero) then
         res = [ ( i, i=1,.n_occ) ]
      else
         res = .single(:,2)
         res.remove_repetitions
      end

   end

   Vs_in_S_window result (res) ::: leaky, PURE
   ! List of virtual MOs in the singles-excitation window.
      self :: IN
      res  :: VEC{INT}@

      i :: INT

      if (.tol_S.is_zero) then
         res = [ (i, i=1,.n_vir) ]
      else
         res = .single(:,1)
         res.remove_repetitions
      end

   end

   V_of_VO(vo) result(res) ::: pure
   ! The V index in a compressed VO pair-index
      self :: IN
      vo   :: VEC{INT}, IN
      res  :: VEC{INT}(vo.dim)
      res = modulo(vo,.n_vir) ! remainder
   end

   O_of_VO(vo) result(res) ::: pure
   ! The V index in a compressed VO pair-index
      self :: IN
      vo   :: VEC{INT}, IN
      res  :: VEC{INT}(vo.dim)
      res = (vo-1)/.n_vir + 1
   end

   min_O_in_S_window result(res) ::: PURE
   ! Minimum value of the occupied orbital index in the S window.
      self :: IN
      res  :: INT
      res = minval(.Os_in_S_window)
   end

   max_V_in_S_window result(res) ::: PURE
   ! Minimum value of the occupied orbital index in the S window.
      self :: IN
      res  :: INT
      res = maxval(.Vs_in_S_window)
   end


 !  =======
 !  Methods
 !  =======

   docu_sort_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("sort_singles")
      stdout.flush
      stdout.text(". Sort the single-excitations into increasing energy order.")
      stdout.text("  Not needed, but recommended for interpretation of the states")
      if (present(die)) stop
   end

   sort_singles ::: leaky, PURE
   ! Sorts the single excitations by smallest energy difference, and
   ! keeps the order in an array.
      self :: INOUT

      i,a, n :: INT
      val :: REAL
      ind :: VEC{INT}@

      ! Can proceed?
      n = .no_of_singles
      if (n==0) return

      .deltaE.create(n)
      .single.create(n,2)

      if (.tol_S.is_zero) then

         ! Get all
         n = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            n = n + 1
            .deltaE(n)   = val
            .single(n,1) = a
            .single(n,2) = i
         end
         end

      else

         ! Get delta E and S indices
         n = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            if (val<.tol_S) then
               n = n + 1
               .deltaE(n)   = val
               .single(n,1) = a
               .single(n,2) = i
            end
         end
         end

      end

      ! Sort
      ind.create(n)
      .deltaE.quick_sort(ind)

      ! Reorder
      .deltaE      = .deltaE(ind)
      .single(:,1) = .single(ind,1)
      .single(:,2) = .single(ind,2)

   end

   docu_find_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("find_doubles")
      stdout.flush
      stdout.text(". Find all double excitations within a certain tolerance")
      stdout.text("  of a previously entered excitation energy, entered via")
      stdout.text("  omega= and tol_D=")
      if (present(die)) stop
   end

   find_doubles ::: leaky, PURE
   ! Find the double excitations within a certain tolerance
      self :: INOUT

      n :: INT
      i,a,ai :: INT
      j,b,bj :: INT
      Eai,Ebj,val :: REAL
      OList,VList :: VEC{INT}@
      ind :: VEC{INT}@
      del :: VEC{REAL}@
      vi0 :: BIN

      ! Can we proceed?
      n = .no_of_doubles
      if (n==0) return

      vi0 = val.is_zero

      .delEab.create(n)
      .double.create(n,2)

      ! List of allowed occs and virs
      OList = .Os_in_S_window
      VList = .Vs_in_S_window

      ! Get the energy differences
      n = 0
      do i = .n_occ,1,-1
      do a = 1,.n_vir
         ai = a + (i-1)*.n_vir
         Eai = .Ev(a) - .Eo(i)
         do j = .n_occ,1,-1
         do b = 1,.n_vir
            bj = b + (j-1)*.n_vir
            if (bj>ai) cycle
            if (.use_S_window_MOs) then
            if (NOT any(i==OList)) cycle
            if (NOT any(a==VList)) cycle
            if (NOT any(j==OList)) cycle
            if (NOT any(b==VList)) cycle
            end
            Ebj = .Ev(b) - .Eo(j)
            val = Eai + Ebj
            if (abs(val-.omega)<.tol_D AND (val<.tol_S OR vi0)) then
               n = n + 1
               .delEab(n)   = val - .omega ! Note sign
               .double(n,1) = ai
               .double(n,2) = bj
            end
         end
         end
      end
      end

      ! Sort by abs difference
      ind.create(n)
      del = abs(.delEab)
      del.quick_sort(ind)
      del.destroy

      ! Reorder
      .delEab      = .delEab(ind)
      .double(:,1) = .double(ind,1)
      .double(:,2) = .double(ind,2)

   end

 !  ===============
 !  Output routines
 !  ===============

   put_banner ::: selfless
   ! Prints out the coupled-perturbed banner
      self :: IN

      stdout.flush
      stdout.text("==================================")
      stdout.text("Time-dependent mean-field response")
      stdout.text("==================================")
      stdout.flush

   end

   docu_put_options(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_options")
      stdout.flush
      stdout.text(". Display a summary of options used to perform the")
      stdout.text("  response equation calculations")
      if (present(die)) stop
   end

   put_options
   ! Prints out a summary of what options being used.
      self :: IN

      n :: INT

      ::put_banner

      stdout.flush
      stdout.show("Method                    =", .method)
      stdout.show("Implementation            =", .implementation)

      stdout.flush
      stdout.text("Dimensions")
      stdout.flush
      stdout.show("n_a                       = ", .n_a)
      stdout.show("n_b                       = ", .n_a)
      stdout.show("n_occ                     = ", .n_occ)
      stdout.show("n_vir                     = ", .n_vir)

      stdout.flush
      stdout.text("Tolerances & convergence:")
      stdout.flush
      stdout.show("|Delta P| convergence tol =", .tol_P)
      stdout.show("Davidson  convergence tol =", .tol_Davidson)
      stdout.show("Minimum # of iterations   =", .min_iterations)
      stdout.show("Maximum # of iterations   =", .max_iterations)

      stdout.flush
      stdout.text("State selection & dressing:")
      stdout.flush
      stdout.show("Single excitation window  =", .tol_S)
      n = .no_of_singles
      stdout.show("# of states in window     =", n)
      stdout.show("omega                     =", .omega)
      stdout.show("Doubles selection tol     =", .tol_D)
      stdout.show("Use S window MOs?         =", .use_S_window_MOs)

      stdout.flush

   end

   put_MO_energies
   ! Prints out the MO energies. May make use of .single 
   ! excitation energy to reduce output.
      self :: IN

      no,lo,hv :: INT

      stdout.flush
      stdout.text("===========")
      stdout.text("MO energies")
      stdout.text("===========")

      if (.single.deallocated) then

         ! No S window info
         stdout.flush
         stdout.text("Occupied MO energies:")
         stdout.put(.Eo)
        
         stdout.flush
         stdout.text("Virtual MO energies:")
         stdout.put(.Ev)

      else

         ! Use S window to reduce output
         no = .n_occ
         lo = .min_O_in_S_window
         hv = .max_V_in_S_window

         stdout.flush
         stdout.text(". Only the topmost HOMO, and lowest LUMO, energies")
         stdout.text("  are written below, those in the S window.")
         stdout.flush
         stdout.text(". All energies are in ascending order")
         stdout.flush
         stdout.show("No. of occupied MOs       = ", .n_occ)
         stdout.show("Lowest  HOMO in window    = ", lo)
         stdout.show("Highest LUMO in window    = ", hv)


         stdout.flush
         stdout.text("Occupied MO energies:")
         stdout.put(.Eo(lo:no))

         stdout.flush
         stdout.text("Virtual MO energies:")
         stdout.put(.Ev(1:hv))


      end


   end

   put_MOs
   ! Print out the occupied MOs.
      self :: IN

      stdout.flush
      stdout.text("===")
      stdout.text("MOs")
      stdout.text("===")

      stdout.flush
      stdout.text("Occupied MOs:")
      stdout.put(.MOo)

   end

   docu_put_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("sort_singles")
      stdout.flush
      stdout.text(". Display table of the sorted singles states")
      if (present(die)) stop
   end

   put_singles
   ! Print out the sorted singles states.
      self :: INOUT

      table :: VEC{TABLE_COLUMN}@
      n, m :: INT

      n = .single.dim1
      m = .n_max_show

      stdout.flush
      stdout.text("=============================")
      stdout.text("Single excitation state order")
      stdout.text("=============================")
      stdout.flush
      stdout.text(". The 'singles window'")
      stdout.flush
      stdout.text("  Single excitation determinants S are selected so")
      stdout.text("  that (Delta E), the excitation energy calculated")
      stdout.text("  by Koopman's orbital energy differences, is less")
      stdout.text("  than a given tolerance tol_S.")
      stdout.flush
      stdout.text(". Did you consider using improved virtual MOs?")
      stdout.text("  Pure HF energy differences may be poor.")
      stdout.flush
      stdout.text(". Indices 0 and below are HOMOs (occupied)")
      stdout.text("  Indices 1 and above are LUMOs (virtuals)")
      stdout.flush
      stdout.show("Singles tolerance, tol_S  =", .tol_S)
      stdout.show("# of states in window     =", n)
      if (n==0) return
      stdout.show("# of states to display    =", m)
      stdout.show("Min. occupied MO          =", .min_O_in_S_window-.n_occ)
      stdout.show("Max. virtual  MO          =", .max_V_in_S_window)

      if (m>0) n = min(n,m)

      table.create(3)

      table(1).set_heading("LUMO")
      table(1).set_subhead("(v)")
      table(2).set_heading("HOMO")
      table(2).set_subhead("(o)")
      table(3).set_heading("Delta E")
      table(3).set_subhead("Ev-Eo")

      table(1).set_values(.single(1:n,1))
      table(2).set_values(.single(1:n,2)-.n_occ)
      table(3).set_values(.deltaE(1:n))

      table.put(label_rows=TRUE)

      table.destroy

   end

   docu_put_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_doubles")
      stdout.flush
      stdout.text(". Display table of the double-excitation detetrminants")
      stdout.text("  within the omega-window used to correct the TD response")
      stdout.text("  equations.")
      if (present(die)) stop
   end

   put_doubles
   ! Print out the interacting double excitations
      self :: INOUT

      table :: VEC{TABLE_COLUMN}@
      n :: INT

      stdout.flush
      stdout.text("============================")
      stdout.text("Selected doubles in S window")
      stdout.text("============================")
      stdout.flush
      stdout.text(". The 'doubles window'")
      stdout.flush
      stdout.text("  Double excitation determinants D are selected so")
      stdout.text("  that (E_D-omega), the difference the between E_D,")
      stdout.text("  the Koopman's excitation energy of D, and omega,")
      stdout.text("  the energy of a selected state, is less than a")
      stdout.text("  given tolerance tol_D")
      stdout.flush
      stdout.text(". Also, doubles must lie in the 'singles window'.")
      stdout.flush
      stdout.text(". In addition, the double excitation energy E_D")
      stdout.text("  must be less than tol_S. And only orbitals which")
      stdout.text("  appear in the S window are considered for D's.")
      stdout.flush
      stdout.text(". Indices 1 and above are LUMOs (virtuals)")
      stdout.text("  Indices 0 and below are HOMOs (occupied)")
      stdout.text("  O1, V1 are indices of the 1st excitation,")
      stdout.text("  O2, V2 for the 2nd (nominally) and VO1 >= VO2")
      stdout.flush
      stdout.text(". Energies sorted in increasing order of increasing")
      stdout.text("  absolute difference |E_D-omega|, from omega")
      stdout.flush
      stdout.show("Omega                     =", .omega)
      stdout.show("Doubles tolerance, tol_D  =", .tol_D)
      stdout.show("Singles tolerance, tol_S  =", .tol_S)
      stdout.show("Use only S window MOs?    =", .use_S_window_MOs)
      n = .no_of_doubles
      stdout.show("# of doubles in S window  =", n)
      stdout.flush

      if (n==0) return

      table.create(6)

      table(1).set_heading("V1")
      table(2).set_heading("O1")
      table(3).set_heading("V2")
      table(4).set_heading("O2")
      table(5).set_heading("E_D")
      table(6).set_heading("E_D-omega")

      table(1).set_values(.V_of_VO(.double(:,1)))
      table(2).set_values(.O_of_VO(.double(:,1))-.n_occ)
      table(3).set_values(.V_of_VO(.double(:,2)))
      table(4).set_values(.O_of_VO(.double(:,2))-.n_occ)
      table(5).set_values(.delEab+.omega)
      table(6).set_values(.delEab)

      table.put(label_rows=TRUE)

      table.destroy

   end

   put_results
   ! Print out the interacting double excitations
      self :: INOUT

      table :: VEC{TABLE_COLUMN}@
      n, m  :: INT

      n = .no_of_singles
      m = .n_max_show

      stdout.flush
      stdout.text("=================")
      stdout.text("TD excited states")
      stdout.text("=================")
      stdout.flush
      stdout.text(". Only the lowest states are shown")
      stdout.text(". This version does no state selection")
      stdout.flush
      stdout.show("Method                    =", .method)
      stdout.show("Implementation            =", .implementation)
      stdout.show("# of states in window     =", n)
      stdout.show("# of states to display    =", m)
      stdout.flush

      if (n==0) return
      if (m>0) n = min(n,m)

      ! Print table
      table.create(2)

      table(1).set_heading("Excitation")
      table(1).set_heading("       /au")
      table(2).set_heading("Excitation")
      table(2).set_heading("       /eV")

      table(1).set_values(.eval(1:n))
      table(2).set_values(.eval(1:n)*EV_PER_HARTREE)

      table.put(label_rows=TRUE)

      table.destroy

   end

end
