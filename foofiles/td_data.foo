!  Davidson output
!  ===============

   put_results
   ! Print out the interacting double excitations
      self :: INOUT

   ENSURE(.eval.allocated,"no eval's")


      table :: VEC{TABLE_COLUMN}@
      n :: INT

      n = .eval.dim

      stdout.flush
      stdout.text("============================")
      stdout.text("CIS/TD excited state results")
      stdout.text("============================")
      stdout.flush
      stdout.show("Method                       =", .method)
      stdout.show("Implementation               =", .implementation)
      stdout.flush
      stdout.text("Singles window")
      stdout.show("  tol_S             =", .tol_S)
      stdout.show("  tol_S / eV        =", .tol_S*EV_PER_HARTREE)
      if (.implementation/="in-core" OR .is_an_SS_method) then
      stdout.show("  No. of singles    =", n)
      end
      stdout.flush
      stdout.text("Orbital range")
      stdout.show("  Min. occupied MO  =", .min_OMO-.n_occ)
      stdout.show("  Max. virtual  MO  =", .max_VMO)
      stdout.flush
      stdout.show("Use IVO energies?            =", .use_IVO_energies)
      stdout.flush
      stdout.text("Dressing energy")
      stdout.show("  omega            =", .omega)
      stdout.show("  omega / eV       =", .omega*EV_PER_HARTREE)
      stdout.flush
      stdout.text("Doubles window")
      stdout.show("  tol_D            =", .tol_D)
      stdout.show("  tol_D / eV       =", .tol_D*EV_PER_HARTREE)

      if (n==0) return

      if (.Slab.allocated) then; table.create(3)
      else;                      table.create(2)
      end

      ! Print table
      table(1).set_heading("Delta E")
      table(1).set_subhead("    /au")
      table(1).set_real_precision(4)
      table(1).set_width(10)
      table(1).set_values(.eval(1:n))

      table(2).set_heading("Delta E")
      table(2).set_subhead("    /eV")
      table(2).set_real_precision(2)
      table(2).set_width(8)
      table(2).set_values(.eval(1:n)*EV_PER_HARTREE)

      if (.Slab.allocated) then

      ! A singlet & triplet calculation
      table(3).set_heading(" State")
      table(3).set_subhead("  spin")
      table(3).set_width(3)
      table(3).set_values(.Slab(1:n))

      end

      table.put(label_rows=TRUE)

      table.destroy

   end

   set_D_table_headings ::: leaky, PURE
   ! Set up the Davidson table
      self :: INOUT

      i,n :: INT
      state :: STR

      n = .n_evals

      ! Set table headings
      .table.create(n+2)
      .table(1).set_heading("Iter")
      .table(1).force_width(5)

      .table(2).set_heading("Resid")
      .table(2).set_subhead(" norm")
      .table(2).set_real_precision(4)
      .table(2).set_width(9)

      if (.is_unrestricted) then;      state = "?"
      else if (.is_singlet_calc) then; state = "S"
      else;                            state = "T"
      end
      
      do i = 1,n
      if (.Slab.allocated) then
      .table(i+2).set_heading(trim(.Slab(i)))
      else
      .table(i+2).set_heading(trim(state)//trim(i.to_str))
      end
      .table(i+2).set_width(7)
      .table(i+2).set_real_precision(2)
      end

   end

   put_D_table_header
   ! Prints out the Davidson header, and table heading.
      self :: IN

   ENSURE(.table.allocated,"no table created")

      d :: INT

      d = .no_of_singles

      stdout.flush
      stdout.text("=====================")
      stdout.text("Davidson diagonaliser")
      stdout.text("=====================")

      stdout.flush
      stdout.text(". State energies are in eV")
      stdout.flush
      stdout.text(". n_keep is the number of trial eigenvector sets to")
      stdout.text("  keep in the block Davidson procedure.")
      stdout.flush
      stdout.text(". n_occ*n_vir is the maximum size of the Davidson matrix")
      stdout.text("  but a fewer of determinants are used if state selected")
      stdout.text("  method is used.")
      stdout.flush
      stdout.text(". Convergence decided by the maximum of the absolute")
      stdout.text("  norm of the residual of each eigenvector.")
    ! stdout.flush
    ! stdout.text(". For unrestricted calcs the no. of eigenvalues is")
    ! stdout.text("  four times more than asked, to allow for triplets.")

      stdout.flush
      stdout.text("No. of electrons")
      stdout.show("  n_occ             = ", .n_occ)
      stdout.show("  n_vir             = ", .n_vir)
      stdout.show("  n_occ x n_vir     = ", .n_occ*.n_vir)

      stdout.flush
      stdout.text("Davidson options")
      stdout.show("  n_evals wanted    = ", .n_evals)
      stdout.show("  n_keep  blocks    = ", .n_keep)
      stdout.show("  No. determinants  = ", .single.dim1)
      stdout.show("  Max. iterations   = ", .max_iterations)
      stdout.show("  Convergence tol.  = ", .tol_Davidson)

      ! Put the table
      .table.put_headings

   end

   put_D_table_body_and_footer
   ! Print out the Davidson table body for the current iteration.
   ! If converged, print out footer as well.
      self :: INOUT

   ENSURE(.table.allocated,"no table created")
   ENSURE(.eval.allocated, "no eigenvalue")

      i :: INT

      ! Set table body (leaky)
      .table(1).set_values([.iteration],auto=FALSE)
      .table(2).set_values([.max_res(.n_trial)],auto=FALSE)
    ! .table(3).set_values([.collapse])
      do i = 1,.n_evals
      .table(i+2).set_values([.eval(i)*EV_PER_HARTREE])
      end

      ! Put out the body
      .table.put_body

      ! Clear columns for next time (UNleaky!)
      .table.clear_columns

      if (.converged) then
        .table.put_footer
        stdout.flush
        if (.converged) then; stdout.text("* * * Converged * * *")
        else;                 stdout.text("* * * NOT CONVERGED * * *")
        end
        .table.put_footer
        stdout.flush
      end

   end

   put_evecs
   ! Print out the eigenvectors
      self :: IN

   ENSURE(.single.allocated,"no single states")
   ENSURE(.evec.allocated,  "evec unallocated")

      if (NOT .show_evecs) return

      if (NOT .is_unrestricted) then; .put_r_evecs
      else;                           .put_u_evecs
      end

   end

   put_r_evecs ::: private
   ! Print out the eigenvectors
      self :: IN

   ENSURE(.single.allocated,"no single states")
   ENSURE(.evec.allocated,  "evec unallocated")

      table :: VEC{TABLE_COLUMN}@
      arrow :: VEC{STR}@
      Is,As :: VEC{STR}@
      wI,wA :: INT
      evec  :: MAT{REAL}@
      d,n,i :: INT
      val :: REAL
      num :: STR

      stdout.flush
      stdout.text("===================")
      stdout.text("Eigenvector columns")
      stdout.text("===================")
      stdout.flush

      d = .evec.dim1

      Is.create(d)
      As.create(d)
      arrow.create(d)

      Is  = .r_O_singles_str
      As  = .r_V_singles_str
      arrow = "->"

      Is.get_max_str_length(wI,spaces=0)
      As.get_max_str_length(wA,spaces=0)

      n = .eval.dim

      table.create(4+n)

      table(1).set_column_spacing(0)
      table(1).set_heading("I")
      table(1).set_width(wI+1)
      table(1).set_values(Is)

      table(2).set_column_spacing(0)
      table(2).set_heading("->")
      table(2).set_width(3)
      table(2).set_values(arrow)

      table(3).set_column_spacing(0)
      table(3).set_heading("A")
      table(3).set_width(wA+1)
      table(3).set_values(As)

      table(4).set_heading("Ev-Eo")
      table(4).set_subhead("  /eV")
      table(4).set_real_precision(2)
      table(4).set_width(5)
      table(4).set_values(.deltaE*EV_PER_HARTREE)

      do i = 1,n
      val = .eval(i)*EV_PER_HARTREE
      num = trim(val.to_str("f10.2"))
      table(4+i).set_heading(.Slab(i))
      table(4+i).set_subhead(trim(num))
      table(4+i).set_real_precision(4)
      table(4+i).set_width(9)
      table(4+i).set_values(.evec(:,i))
      end

      table.put(label_rows=TRUE)

      table.destroy
      evec.destroy
      arrow.destroy
      As.destroy
      Is.destroy

   end

   put_u_evecs ::: private
   ! Print out the eigenvectors
      self :: IN

   ENSURE(.single.allocated,"no single states")
   ENSURE(.evec.allocated,  "evec unallocated")

      table :: VEC{TABLE_COLUMN}@
      Is,As :: VEC{STR}@
      arrow :: VEC{STR}@
      delEv :: VEC{REAL}@
      delE  :: VEC{STR}@
      wI,wA :: INT
      evec  :: MAT{REAL}@
      d,d4, n,i :: INT
      val :: REAL
      num :: STR

      stdout.flush
      stdout.text("===================")
      stdout.text("Eigenvector columns")
      stdout.text("===================")

      stdout.flush

      if (NOT .use_M_0) then
      stdout.text("The four numbers per excitation correspond to:")
      stdout.flush
      stdout.text("  I alpha -> A alpha i.e. aa")
      stdout.text("  I alpha -> A beta  i.e. ab")
      stdout.text("  I beta  -> A alpha i.e. ba")
      stdout.text("  I beta  -> A beta  i.e. bb")
      stdout.flush
      stdout.text("The ab and ba terms are spin flip excitations and make")
      stdout.text("M = -1 and M = +1 triplet components.")
      stdout.flush
      stdout.text("The aa and bb terms make M = 0 components for singlet and")
      stdout.text("triplet with same sign combinations being the former.")
      else
      stdout.text("The two non-zero numbers per excitation correspond to")
      stdout.flush
      stdout.text(". I alpha -> A alpha i.e. aa")
      stdout.text(". I beta  -> A beta  i.e. bb")
      stdout.flush
      stdout.text("These generate the M = 0 components for singlet and")
      stdout.text("triplet, with same sign combinations being a singlet.")
      end

      stdout.flush

      n = min(.eval.dim,.n_max_show)

      d4 = .evec.dim1
      d  = d4/4

      ENSURE(d4==d*4,"evec dim1 not a multiple of 4")

      Is.create(d4)
      As.create(d4)
      delE.create(d4)
      delEv.create(d4)
      arrow.create(d4)

      Is  = .u_O_singles_str
      As  = .u_V_singles_str

      arrow = " "
      arrow(1:d4:4) = "->"
      delEv = .deltaE*EV_PER_HARTREE
      delE  = " "
      delE(1:d4:4) = delEv.to_str("f",5,2)

      Is.get_max_str_length(wI,spaces=0)
      As.get_max_str_length(wA,spaces=0)

      ! Swap order back
      evec.create(d4,n)
      if (.method=="u-cis") then
         ! Order: is aa, ab, ba, bb
         evec = .evec(:,1:n) 
      else
         ! Put to:  aa, ab, ba, bb
         evec(1:d4:4,:) = .evec(    1:d  ,:)
         evec(2:d4:4,:) = .evec(d  +1:d*2,:)
         evec(3:d4:4,:) = .evec(d*2+1:d*3,:)
         evec(4:d4:4,:) = .evec(d*3+1:d*4,:)
      end

      table.create(4+n)

      table(1).set_column_spacing(0)
      table(1).set_heading("I")
      table(1).set_width(wI+1)
      table(1).set_values(Is)
      
      table(2).set_column_spacing(0)
      table(2).set_heading("->")
      table(2).set_width(3)
      table(2).set_values(arrow)

      table(3).set_column_spacing(0)
      table(3).set_heading("A")
      table(3).set_width(wA+1)
      table(3).set_values(As)

      table(4).set_heading("Ev-Eo")
      table(4).set_subhead("  /eV")
      table(4).set_width(5)
      table(4).set_values(delE)

      do i = 1,n
      val = .eval(i)*EV_PER_HARTREE
      num = trim(val.to_str("f10.2"))
      table(4+i).set_heading(.Slab(i))
      table(4+i).set_subhead(trim(num))
      table(4+i).set_real_precision(4)
      table(4+i).set_width(9)
      table(4+i).set_values(evec(:,i))
      end

      ! No rows
      table.put

      table.destroy
      evec.destroy

      arrow.destroy
      delEv.destroy
      delE.destroy
      As.destroy
      Is.destroy

   end

end
