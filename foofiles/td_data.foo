   put_singles
   ! Print out the sorted singles states.
      self :: INOUT

      table :: VEC{TABLE_COLUMN}@
      n, m :: INT

      n = .single.dim1
      m = .n_max_show

      stdout.flush
      stdout.text("=============================")
      stdout.text("Single excitation state order")
      stdout.text("=============================")
      stdout.flush
      stdout.text(". The 'singles window'")
      stdout.flush
      stdout.text("  Single excitation determinants S are selected so")
      stdout.text("  that (Delta E), the excitation energy calculated")
      stdout.text("  by Koopman's orbital energy differences, is less")
      stdout.text("  than a given tolerance tol_S.")
      stdout.flush
      stdout.text(". Did you consider using improved virtual MOs?")
      stdout.text("  Pure HF energy differences may be poor.")
      stdout.flush
      stdout.text(". Indices 0 and below are HOMOs (occupied)")
      stdout.text("  Indices 1 and above are LUMOs (virtuals)")
      stdout.flush
      stdout.show("Singles tolerance, tol_S  =", .tol_S)
      stdout.show("# of states in window     =", n)
      if (n==0) return
      stdout.show("# of states to display    =", m)
      stdout.show("Min. occupied MO          =", .min_O_in_S_window-.n_occ)
      stdout.show("Max. virtual  MO          =", .max_V_in_S_window)

      if (m>0) n = min(n,m)

      table.create(3)

      table(1).set_heading("LUMO")
      table(1).set_subhead("(v)")
      table(2).set_heading("HOMO")
      table(2).set_subhead("(o)")
      table(3).set_heading("Delta E")
      table(3).set_subhead("Ev-Eo")

      table(1).set_values(.single(1:n,1))
      table(2).set_values(.single(1:n,2)-.n_occ)
      table(3).set_values(.deltaE(1:n))

      table.put(label_rows=TRUE)

      table.destroy

   end

