module TD_DATA

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create ::: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy ::: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part ::: leaky, PURE
   ! Destroy the pointer parts of self
      self :: INOUT

      .MOo.destroy
      .MOv.destroy
      .Eo.destroy
      .Ev.destroy

      .single.destroy
      .deltaE.destroy
      .double.destroy
      .delEab.destroy

      .eval.destroy
      .evec.destroy

   end

!  ===============================================
!  Set defaults, reset, update and realted methods
!  ===============================================

   update ::: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT
      .find_singles
    ! .find_doubles
   end

   set_defaults(n_bf,n_a,n_b) ::: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT
      n_bf  :: INT, IN
      n_a   :: INT, IN
      n_b   :: INT, IN

      ! Leave existing options, if any
      .n_bf = n_bf
      .n_a  = n_a
      .n_b  = n_b

      ! Restricted case only
      .n_occ = n_a
      .n_vir = n_bf - n_a

   end

   set_defaults(MOs,MO_energies,IVO_energies) ::: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT
      MOs   :: MAT{REAL}, IN
      MO_energies  :: VEC{REAL}, IN
      IVO_energies :: VEC{REAL}@, optional, IN

   ENSURE(.n_occ>0,"n_occ is not set, call set_defaults!")

      no :: INT

      ! Get OMOs and VMOs
      no = .n_occ
      .MOo = MOs(:,   1: no)
      .MOv = MOs(:,no+1:.n_bf)

      ! Note: canonised energies from Fvv are used if
      ! VMO_canonisation was requested in scf_data block.
      .Eo = MO_energies(   1: no)
      .Ev = MO_energies(no+1:.n_bf)
      .Ei = .Ev

      ! Copy if there
      if (present(IVO_energies))  then
      if (IVO_energies.allocated) then
      .Ei = IVO_energies
      end
      end

   end

   set_archive_results(val) ::: PURE
   ! Set whether to archive vectors and eigenvalues to disk
      self :: INOUT
      val  :: BIN, IN
      .archive_results = val
   end

   set_implementation(val) ::: PURE
   ! Set the type of implementation for the method.
      self :: INOUT
      val  :: STR, IN

   ENSURE(val.is_one_of(["in-core ","davidson"]),"unknown method")

      .implementation = val.lower_cased

   end

   set_method(val)
   ! Set the kind of TD method to use.
      self :: INOUT
      val  :: STR, IN

      .method = val.lower_cased

      select case (.method)

      ! Davidson
      case("r-cis-ss-s=0   ")
      case("r-cis-ss-s=0&1 ")
      case("r-cis-ss-s=1    ")
    ! case("r-cis-ss-s=0-d1") ! Testing
    ! case("r-cis-ss-s=0-d2") ! Testing
    ! case("r-cis-ss-s=0-v0") ! Testing
      case("u-cis-ss       ")

      ! In-core
      case("r-cis-s=0      ")
      case("r-cis-s=0&1    ")
      case("r-cis-s=1      ")
    ! case("r-cis-ss-s=0   ") ! See above
      case("r-tdhf-s=0     ")
      case("r-tdhf-s=0&1   ")
      case("r-tdhf-s=1     ")
      case("u-cis          "); .tol_S = ZERO
      case("u-cis-v1       ")

      case default; UNKNOWN(.method)

      end

   end

   set_n_evals(val) ::: PUREr
   ! Set number of excited-state eigenvalues to search for.
      self :: INOUT
      val  :: INT, IN

   ENSURE(val>0,"n_evals must be +ve")

    if (.is_unrestricted) then
   ENSURE(mod(val,4)==0,"n_evals must be multiple of 4")
    end

      .n_evals = val

      ! Set the same number to show
      .set_n_max_show(val)

   end

   set_n_keep(val) ::: PURE
   ! Set the maximum number of eigensolutions to keep.
      self :: INOUT
      val  :: INT, IN

   ENSURE(val>0,"n_keep must be +ve")
   ENSURE(val>2,"n_keep must be at least 3")
   ENSURE(val>2,"n_keep must be more than n_evals")

      .n_keep = val

   end

   set_n_max_show(val) ::: PURE
   ! Set number of states (i.e. selected singles, doubles, eigenvalues)
   ! to display in the output. A zero value means show all.
      self :: INOUT
      val  :: INT, IN

      .n_max_show = val

      ! No point calculating more
   !  if (val<.n_evals) .set_n_evals(val)

   end

   set_omega(val) ::: PURE
   ! Set energy .omega from which interacting double
   ! excitation determinants are to be selected.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"omega must be +ve")

      .omega = val

   end

   set_show_evecs(val) ::: PURE
   ! Set whether to show the eigenvalue column output.
      self :: INOUT
      val  :: BIN, IN
      .show_evecs = val
   end

   set_tol_D(val) ::: PURE
   ! Set double-excitation determinant energy selection tolerance
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"tol_D must be +ve")

      .tol_D = val

   end

   set_tol_Davidson(val) ::: PURE!
   ! Set Davidson iteration convergence tolerance on eigenvectors
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"tol_Davidson must be +ve")

      .tol_Davidson = val

   end

   set_tol_S(val) ::: PURE
   ! Set the single-excitation tolerance window.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>=ZERO,"tol_S must be non -ve")

      .tol_S = val

   end

   set_use_IVO_energies(val) ::: PURE
   ! Set whether to use improved virtual energies (IVOs) from
   ! a previous SCF canonicalisation to define determinants
   ! which comprise the S window.
      self :: INOUT
      val  :: BIN, IN
      .use_IVO_energies = val
   end

   set_use_M_0(val) ::: PURE
   ! Set whether to use M=0 basis only.
      self :: INOUT
      val  :: BIN, IN
      .use_M_0 = val
   end

   set_use_MGS(val) ::: PURE
   ! Set whether to use Modified Gram-Schmidt QR orthonormalisation.
   ! If not set, Davidson uses the Householde QR algorithm.
      self :: INOUT
      val  :: BIN, IN
      .use_MGS = val
   end

!   set_use_S_window_MOs(val) ::: pure
!   ! Set whether to use only MOs in the the single excitation
!   ! list of determinants to construct interacting doubles
!   ! excitations (on top of being within the tol_D energy window).
!      self :: INOUT
!      val  :: BIN, IN
!      .use_S_window_MOs = val
!   end

!  =============
!  Input methods
!  =============

   read_keywords ::: get_from(OBJECT), recursive, leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) ::: leaky
   ! Process a command "keyword". Data is inputted from "stdin", unless
   ! "word" is a sequence of blank separated strings. In this case,
   ! the sequence is processed as if it were a separate file.
      self :: INOUT
      keyword :: STR, IN

      word :: STR
      die  :: BIN

      word = keyword
      word.to_lower_case

      select case (word)

      case ("archive_results=   "); .read_archive_results
      case ("find_doubles       "); .find_doubles
      case ("find_singles       "); .find_singles
      case ("implementation=    "); .read_implementation
      case ("max_keep=          "); .read_n_keep
      case ("method=            "); .read_method
      case ("n_eig=             "); .read_n_evals
      case ("n_evals=           "); .read_n_evals
      case ("n_keep=            "); .read_n_keep
      case ("n_max_show=        "); .read_n_max_show
      case ("n_states=          "); .read_n_evals
      case ("omega=             "); .read_omega
      case ("put_mo_energies    "); .put_MO_energies
      case ("put_mos            "); .put_MOs
      case ("put_options        "); .put_options
      case ("put_doubles        "); .put_doubles
      case ("put_evecs          "); .put_evecs
      case ("put_singles        "); .put_singles
      case ("show_evecs         "); .read_show_evecs
      case ("tol_d=             "); .read_tol_D
      case ("tol_davidson=      "); .read_tol_Davidson
      case ("tol_s=             "); .read_tol_S
      case ("use_ivo_energies=  "); .read_use_IVO_energies
      case ("use_m_0=           "); .read_use_M_0
    ! case ("use_s_window_mos=  "); .read_use_S_window_MOs

      ! Documentation
      case ("help?              "); TD_DATA:docu_help
      case ("find_doubles?      "); TD_DATA:docu_find_doubles(die)
      case ("find_singles?      "); TD_DATA:docu_find_singles(die)
      case ("max_keep=?         "); TD_DATA:docu_n_keep(die)
      case ("method=?           "); TD_DATA:docu_method(die)
      case ("n_evals=?          "); TD_DATA:docu_n_evals(die)
      case ("n_keep=?           "); TD_DATA:docu_n_keep(die)
      case ("n_max_show=?       "); TD_DATA:docu_n_max_show(die)
      case ("omega=?            "); TD_DATA:docu_omega(die)
      case ("put_doubles?       "); TD_DATA:docu_put_doubles(die)
      case ("put_options?       "); TD_DATA:docu_put_options(die)
      case ("put_singles?       "); TD_DATA:docu_put_singles(die)
      case ("tol_d=?            "); TD_DATA:docu_tol_D(die)
      case ("tol_davidson=?     "); TD_DATA:docu_tol_Davidson(die)
      case ("tol_s=?            "); TD_DATA:docu_tol_S(die)
    ! case ("use_s_window_mos=? "); TD_DATA:docu_use_S_window_MOs(die)

      case default;            UNKNOWN(word)
      end

   end


   docu_help ::: selfless, private
   ! Documentation.

      stdout.flush
      stdout.flush
      stdout.text("================")
      stdout.text("Help for TD_DATA")
      stdout.text("================")

      TD_DATA:docu_find_doubles
      TD_DATA:docu_find_singles
      TD_DATA:docu_n_keep
      TD_DATA:docu_method
      TD_DATA:docu_n_evals
      TD_DATA:docu_omega
      TD_DATA:docu_put_doubles
      TD_DATA:docu_put_options
      TD_DATA:docu_put_singles
      TD_DATA:docu_tol_D
      TD_DATA:docu_tol_Davidson

      DIE("end of help documentation")

   end

! A

   read_archive_results ::: get_from(OBJECT:read_and_set, VAL?=>BIN, SET?=>.set_archive_results), private
   ! Generic read and set
   end

! I

   read_implementation ::: get_from(OBJECT:read_and_set, VAL?=>STR, SET?=>.set_implementation), private
   ! Generic read and set
   end

! M

   docu_n_keep(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("n_keep= INT    [32]")
      stdout.text("max_keep= INT  [32]")
      stdout.flush
      stdout.text(". The maximum number of trial eigenvectors to keep when")
      stdout.text("  using the Davidson method to obtain eigenstates of the")
      stdout.text("  response equations.")
      stdout.flush
      stdout.text(". See Crouzeix et al  (1994) SIAM J Sci Comput 15_p. 62-76")
      if (present(die)) stop
   end

   read_n_keep ::: get_from(OBJECT:read_and_set, VAL?=>INT, SET?=>.set_n_keep), private
   ! Generic read and set
   end

   docu_method(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("method= STR  ['rtdhf-singlet']")
      stdout.flush
      stdout.text(". The kind of mean-field method used in the response equations")
      stdout.flush
      stdout.text(". Allowed values: 'utdhf', 'rtdhf-singlet', 'rtdhf-triplet'")
      if (present(die)) stop
   end

   read_method ::: get_from(OBJECT:read_and_set, VAL?=>STR, SET?=>.set_method), private
   ! Generic read and set
   end

! N

   docu_n_evals(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("n_eig=")
      stdout.text("n_evals=")
      stdout.text("n_states= INT [4]")
      stdout.flush
      stdout.text(". The number of excitated state eigenvalues wanted")
      stdout.text("  when solving the CIS/TD response equations via the")
      stdout.text("  iterative Davidson method")
      stdout.flush
      stdout.text(". Excitation energies are sorted from smallest first")
      stdout.flush
      stdout.text(". Must be less than the number of single excitation")
      stdout.text("  states used in the model")
      if (present(die)) stop
   end

   read_n_evals ::: get_from(OBJECT:read_and_set, VAL?=>INT, SET?=>.set_n_evals), private
   ! Generic read and set
   end

   docu_n_max_show(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("n_max_show= INT  [25]")
      stdout.flush
      stdout.text(". The number of states i.e. selected singles, doubles, or")
      stdout.text("  excitation energies to display in the output")
      stdout.flush
      stdout.text(". A zero value means show all.")
      if (present(die)) stop
   end

   read_n_max_show ::: get_from(OBJECT:read_and_set, VAL?=>INT, SET?=>.set_n_max_show), private
   ! Generic read and set
   end

! S

   read_show_evecs ::: get_from(OBJECT:read_and_set, VAL?=>BIN, SET?=>.set_show_evecs), private
   ! Generic read and set
   end

! O

   docu_omega(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("omega= REAL  [0.000]")
      stdout.flush
      stdout.text(". An energy above the ground state of a particular excited")
      stdout.text("  state, used to determine a list of double excitations")
      stdout.text("  (whose energy lies within a certain energy tolerance")
      stdout.text("  tol_D of that state, the doubles energies being calculated")
      stdout.text("  by Koopman's theorem orbital energy differences) and which")
      stdout.text("  are used to 'dress' or 'correct' the mean-field response")
      stdout.text("  equations for the energy of that particular excited state.")
      stdout.flush
      stdout.text(". See Maitra et al (2004) JCP 13 p. 5932.")
      stdout.text("  See Mazur et al (2009) J Comp Chem 30 p. 811-7")
      stdout.flush
      stdout.text(". See also tol_D=")
      if (present(die)) stop
   end

   read_omega ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_omega), private
   ! Generic read and set a quantity with units
   end

