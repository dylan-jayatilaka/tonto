   put_doubles
   ! Print out the interacting double excitations
      self :: INOUT

      table :: VEC{TABLE_COLUMN}@
      n :: INT

      stdout.flush
      stdout.text("============================")
      stdout.text("Selected doubles in S window")
      stdout.text("============================")
      stdout.flush
      stdout.text(". The 'doubles window'")
      stdout.flush
      stdout.text("  Double excitation determinants D are selected so")
      stdout.text("  that (E_D-omega), the difference the between E_D,")
      stdout.text("  the Koopman's excitation energy of D, and omega,")
      stdout.text("  the energy of a selected state, is less than a")
      stdout.text("  given tolerance tol_D")
      stdout.flush
      stdout.text(". Also, doubles must lie in the 'singles window'.")
      stdout.flush
      stdout.text(". In addition, the double excitation energy E_D")
      stdout.text("  must be less than tol_S. And only orbitals which")
      stdout.text("  appear in the S window are considered for D's.")
      stdout.flush
      stdout.text(". Indices 1 and above are LUMOs (virtuals)")
      stdout.text("  Indices 0 and below are HOMOs (occupied)")
      stdout.text("  O1, V1 are indices of the 1st excitation,")
      stdout.text("  O2, V2 for the 2nd (nominally) and VO1 >= VO2")
      stdout.flush
      stdout.text(". Energies sorted in increasing order of increasing")
      stdout.text("  absolute difference |E_D-omega|, from omega")
      stdout.flush
      stdout.show("Omega                     =", .omega)
      stdout.show("Doubles tolerance, tol_D  =", .tol_D)
      stdout.show("Singles tolerance, tol_S  =", .tol_S)
      stdout.show("Use only S window MOs?    =", .use_S_window_MOs)
      n = .no_of_doubles
      stdout.show("# of doubles in S window  =", n)
      stdout.flush

      if (n==0) return

      table.create(6)

      table(1).set_heading("V1")
      table(2).set_heading("O1")
      table(3).set_heading("V2")
      table(4).set_heading("O2")
      table(5).set_heading("E_D")
      table(6).set_heading("E_D-omega")

      table(1).set_values(.V_of_VO(.double(:,1)))
      table(2).set_values(.O_of_VO(.double(:,1))-.n_occ)
      table(3).set_values(.V_of_VO(.double(:,2)))
      table(4).set_values(.O_of_VO(.double(:,2))-.n_occ)
      table(5).set_values(.delEab+.omega)
      table(6).set_values(.delEab)

      table.put(label_rows=TRUE)

      table.destroy

   end

   put_results
   ! Print out the interacting double excitations
      self :: INOUT

      table :: VEC{TABLE_COLUMN}@
      n, m  :: INT

      ! Summary options
      .put_options

      n = .no_of_singles
      m = .n_max_show

      stdout.flush
      stdout.text("============================")
      stdout.text("CIS/TD excited state results")
      stdout.text("============================")
      stdout.flush
      stdout.text(". Only the lowest states are shown")
      stdout.flush
      stdout.text(". In-core implementations do no state selection (SS)")
      stdout.text("  UNLESS an SS-type method is specifically chosen AND")
      stdout.text("  in addition, tol_S>0. (If tol_S is zero, all single")
      stdout.text("  excitation states are used).")
      stdout.flush
      stdout.show("Method                       =", .method)
      stdout.show("Implementation               =", .implementation)
      stdout.show("Singles tolerance, tol_S     =", .tol_S)
      if (.implementation/="in-core" OR .is_an_SS_method) then
      stdout.show("# of S states in window      =", n)
      end
      stdout.show("# of excited states to show  =", m)
      stdout.flush

      if (n==0) return
      if (m>0) n = min(n,m)

      if (NOT .S.allocated) then; table.create(2)
      else;                       table.create(3)
      end

      ! Print table
      table(1).set_heading("Delta E")
      table(1).set_subhead("    /au")
      table(1).set_real_precision(4)
      table(1).set_width(14)
      table(1).set_values(.eval(1:n))

      table(2).set_heading("Delta E")
      table(2).set_subhead("    /eV")
      table(2).set_real_precision(2)
      table(2).set_width(12)
      table(2).set_values(.eval(1:n)*EV_PER_HARTREE)

      if (.S.allocated) then

      ! A singlet & triplet calculation
      table(3).set_heading(" State")
      table(3).set_subhead("  spin")
      table(3).set_width(3)
      table(3).set_values(.S(1:n))

      end
      
      table.put(label_rows=TRUE)
      
      table.destroy

   end

!  =======================
!  Davidson iteration info
!  =======================

   Davidson_done result (res) ::: PURE
   ! Return TRUE if the Davidson procedure is done i.e. either 
   ! converged or gone on for too long ... and, it must also 
   ! have executed the requested minimum number of times ...
      self :: IN
      res :: BIN
      res = (.converged OR .reached_max_it) AND .reached_min_it
   end

   collapse result (res) ::: pure
   ! Collapse the Davidson subspace down to one set.
      self :: IN
      res :: BIN
      res = .n_trial==.n_keep
   end

   converged result (res) ::: PURE
   ! Return TRUE if the max residual norm is converged
      self :: IN
      res :: BIN
      res = .residual<.tol_Davidson
   end

   residual result (res) ::: PURE
   ! Return current maximum of the Ritz-vector residuals.
   ! NOTE: .max_res must be set externally beforehand!
      self :: IN
      res :: REAL

   ENSURE(.max_res.allocated,"max_res not allocated")

      res = .max_res(.n_trial)

   end

   set_max_res(val) ::: leaky, PURE
   ! Set the maximum residual vector length for this iteration.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(.max_res.allocated,"no max_res")

      i :: INT

      i = .n_trial
      .max_res(i) = val

   end

   reached_max_it result (res) ::: pure
   ! Return TRUE if we reached too many iterations
      self :: IN
      res :: BIN
      res = .iteration >= .max_iterations
   end

   reached_min_it result (res) ::: pure
   ! Return TRUE if there have been enough iterations.
      self :: IN
      res :: BIN
      res = .iteration >= .min_iterations
   end

!  ==================
!  Davidson iteration
!  ==================

   initialise_iteration ::: leaky, PURE
   ! Initialise the Davidson iterations
      self :: INOUT

      d,n :: INT

      .iteration = 0
      .n_trial   = 0

      ! Sizes
      d = .deltaE.dim ! "d" could nvo
      n = .n_evals    ! Usually n << d

      ! Evals & evecs (leaky)
      .eval.create(n)
      .evec.create(d,n)

      ! Max. residual vector lengths (leaky)
      .max_res.create(.n_keep) 
      .max_res = ZERO

      ! Davidson temporaries
      .Vao.create(n,.n_bf,.n_bf) ! Density matrices
      .Aao.create(n,.n_bf,.n_bf) ! A.V in AO basis

      ! Set headings & do banner
      .set_D_table_headings
      .put_D_table_header

   end

   update_iteration ::: pure
   ! Update the SCF iteration
      self :: INOUT

      .iteration = .iteration + 1
      .n_trial   = .n_trial   + 1 ! Always incremented

   end

   reset_subspace ::: pure
   ! Reset the Davidson subspace to one trial vector set.
      self :: INOUT

    ! best :: INT

      ! Get the best
    ! best = .max_res.index_of_minimum

      ! Keep last error
      .max_res(1 ) = .max_res(.n_trial)
      .max_res(2:) = ZERO

      ! One trial set
      .n_trial = 1

   end

   fst_trial_vector result (res) ::: pure
   ! Return the index of the first trial vector column
   ! in the current Davidson iteration.
      self :: IN
      res  :: INT

      n,n_tr :: INT

      n    = .n_evals 
      n_tr = .n_trial
      res  = n*(n_tr-1) + 1

   end

   lst_trial_vector result (res) ::: pure
   ! Return the index of the last trial vector column
   ! in the current Davidson iteration.
      self :: IN
      res  :: INT

      n,n_tr :: INT

      n    = .n_evals 
      n_tr = .n_trial
      res  = n*n_tr

   end

   best_trial_vector_set result (res) ::: pure
   ! Get the trial set with the best residuals.
   ! NOTE: can't be used yet.
      self :: IN
      res  :: INT
      res = .max_res.index_of_minimum
   end


!  =======================
!  Efficient A x V product
!  =======================

   do_diag_AV_bit(AV,V) ::: PURE
   ! Do the diag(A).V matrix product on single-excitation
   ! trial vectors "V" and put the result into "AV". 
   ! Can cope with non-canonical VMOs if the VV sector of 
   ! the Fock matrix .Fv is allocated.
      self :: IN  
      AV :: MAT{REAL}, OUT
      V  :: MAT{REAL}, IN
   
   ENSURE(AV.is_same_shape_as(V),"inconsistent shape, V and AV")
   ENSURE(AV.dim2==.n_evals,"wrong dim2, AV")

      ai, a,i :: INT
      bj, b,j :: INT
      d,n :: INT

      ! Sizes
      d = .single.dim1

      if (NOT .Fv.allocated) then

         ! Canonical VMOs
         do n  = 1,.n_evals
         do ai = 1,d
            AV(ai,n) = .deltaE(ai)*V(ai,n)
         end
         end

      else

         ! Noncanonical VMO case
         do ai = 1,d
            a  = .single(ai,1)
            i  = .single(ai,2)
            AV(ai,:) = -.Eo(i)*V(ai,:)
            do bj = 1,d
               b  = .single(bj,1)
               j  = .single(bj,2)
               if (i/=j) cycle
               AV(ai,:) = AV(ai,:) + .Fv(a,b)*V(bj,:)
            end
         end

      end

   end


   change_V_to_AO(Vao,V) ::: PURE
   ! Back transform trial eigenvectors "V" into symmetric 
   ! (n_bf x n_bf) AO sized density matrices "Vao", for 
   ! each excited state eigenvalue. Needed to calculate 
   ! the 2e-part of the A.V Davidson step in CIS/TD eqns. 
   ! NOTE: the result does *not* accu,mulate.
      self :: IN  
      Vao  :: MAT3{REAL}, OUT
      V    :: MAT{REAL}, IN
   
   ENSURE(Vao.dim1==.n_evals,"inconsistent dim1, Vao")

      ai, a,i :: INT
      d,no,lo :: INT 
      n, p, q :: INT
      W :: MAT3{REAL}@

      ! Sizes & limits
      d  = .single.dim1
      no = .n_occ
      lo = .min_OMO

      ! Single index transform temporary
      W.create([1,.n_bf],[lo,no],[1,.n_evals])
      W = ZERO

      ! Transform "a" index of "V" -> "W"
      do n  = 1, .n_evals
      do p  = 1, .n_bf
      do ai = 1, d
         a = .single(ai,1)
         i = .single(ai,2)
         ! a -> p
         W(p,i,n) = W(p,i,n) + .MOv(p,a)*V(ai,n)
      end
      end
      end

      ! Transform "i" index of "W" -> "Vao"
      Vao = ZERO
      do n = 1, .n_evals
      do i = lo, no
      do p = 1, .n_bf
      do q = 1, .n_bf
         ! i -> q
         Vao(n,p,q) = Vao(n,p,q) + .MOo(q,i)*W(p,i,n)
      end
      end
      end
      end

      ! Clean up
      W.destroy

   end

!   transform_V_to_AO_v0(V,DM) ::: PURE
!   ! Back transform trial eigenvectors "V" to symmetric 
!   ! (n_bf x n_bf) AO sized *non symmetric* density 
!   ! matrices "DM", one for each excited state eigenvalue. 
!   ! For calculating the 2e-part of the (A x V) Davidson 
!   ! step in the CIS/TD equations. 
!      self :: IN  
!      V  :: MAT{REAL}, IN
!      DM :: MAT3{REAL}, OUT
!   
!   ENSURE(DM.dim1==.n_evals,"inconsistent dim1, DM")
!
!      ai,a,i :: INT
!      d,no,n :: INT 
!      lo, hv :: INT 
!      C :: MAT{REAL}@
!
!      ! Sizes & limits
!      d  = .single.dim1
!      no = .n_occ
!      lo = .min_OMO
!      hv = .max_VMO
!
!      ! Single excitations
!      C.create([1,hv],[lo,no])
!
!      ! Make the DM
!      do n = 1,.n_evals
!
!         ! Convert to C_ai(MO)
!         ! NOTE: this is transposed
!         C = ZERO
!         do ai = 1,d
!            a = .single(ai,1)
!            i = .single(ai,2)
!            C(a,i) = V(ai,n)
!         end
!
!         ! C_ai (MO) -> DM(AO)
!         C.back_transform_to(DM(n,:,:),.MOv(:,1:hv),.MOo(:,lo:no))
!       ! DM(n,:,:).symmetrize
!
!      end
!
!      ! Clean up
!      C.destroy
!
!   end


   change_V_to_MO(V,Vao) ::: PURE
   ! Transform the (n_bf x n_bf) matrices "Vao" and *accumulate*
   ! into trial eigenvectors "V" in the state basis.
      self :: IN  
      V    :: MAT{REAL},  INOUT
      Vao  :: MAT3{REAL}, IN
   
   ENSURE(Vao.dim1==V.dim2,  "incompatible dim1 & dim2, Vao & V")
   ENSURE(Vao.dim1==.n_evals,"wrong dim1, Vao")
   ENSURE(Vao.dim2==.n_bf,   "wrong dim2, Vao")
   ENSURE(Vao.dim3==.n_bf,   "wrong dim3, Vao")

      ai, a,i :: INT
      d,no,lo :: INT 
      n, p, q :: INT
      W :: MAT3{REAL}@

      ! Sizes
      d  = .single.dim1
      no = .n_occ
      lo = .min_OMO

      ! Transform "a" index
      W.create([1,.n_evals],[1,.n_bf],[lo,no])
      W = ZERO

      ! Transform "q" index
      do i = lo,no
      do q = 1,.n_bf
      do p = 1,.n_bf
      do n = 1,.n_evals
         W(n,p,i) = W(n,p,i) + Vao(n,p,q)*.MOo(q,i)
      end
      end
      end
      end

      ! Transform "p" index
      do n = 1,.n_evals
      do p = 1,.n_bf
      do ai = 1,d
         a = .single(ai,1)
         i = .single(ai,2)
         V(ai,n) = V(ai,n) + W(n,p,i)*.MOv(p,a)
      end
      end
      end

      ! Clean up
      W.destroy

   end

!   transform_AV_to_V_v0(AV,V) ::: PURE
!   ! Transform the (n_bf x n_bf) matrices "AV" and *accumulate*
!   ! into trial eigenvectors "V" in the state basis.
!      self :: IN  
!      AV :: MAT3{REAL}, IN
!      V  :: MAT{REAL},  INOUT
!   
!   ENSURE(AV.dim2==.n_bf,   "wrong dim2, AV")
!   ENSURE(AV.dim2==AV.dim3, "AV not square in dim2 & dim3")
!   ENSURE(AV.dim1==.n_evals,"inconsistent dim1, AV")
!   ENSURE(AV.dim1==V.dim2,  "inconsistent dim2, V")
!
!      ai,a,i :: INT
!      d,no,n :: INT 
!      lo, hv :: INT 
!      C :: MAT{REAL}@
!
!      ! Sizes & limits
!      d  = .single.dim1
!      no = .n_occ
!      lo = .min_OMO
!      hv = .max_VMO
!
!      ! Single excitations
!      C.create([1,hv],[lo,no])
!
!      do n = 1,.n_evals
!
!         ! AV (MO)  -> C_ai(MO)
!         AV(n,:,:).change_basis_to(C,.MOv(:,1:hv),.MOo(:,lo:no))
!
!         ! C_ai(MO) -> V
!         do ai = 1,d
!            a = .single(ai,1)
!            i = .single(ai,2)
!            V(ai,n) = V(ai,n) + C(a,i)
!         end
!
!      end
!
!      ! Clean up
!      C.destroy
!
!   end


!  ===============
!  Davidson output
!  ===============

   set_D_table_headings ::: leaky, PURE
   ! Set up the Davidson table
      self :: INOUT

      i :: INT

      ! Set table headings
      .table.create(.n_evals+2)
      .table(1).set_heading("Iter")
      .table(1).force_width(5)

      .table(2).set_heading("Resid")
      .table(2).set_subhead(" norm")
      .table(2).set_real_precision(4)
      .table(2).set_width(9)

      do i = 1,.n_evals
      .table(i+2).set_heading("S"//trim(i.to_str))
      .table(i+2).set_real_precision(2)
      .table(i+2).set_width(7)
      end

   end

   put_D_table_header
   ! Prints out the Davidson header, and table heading.
      self :: IN

   ENSURE(.table.allocated,"no table created")

      d :: INT

      d = .no_of_singles

      stdout.flush
      stdout.text("=====================")
      stdout.text("Davidson diagonaliser")
      stdout.text("=====================")

      stdout.flush
      stdout.text(". State energies are in eV")
      stdout.text(". Convergence measured by maximum residual vector norm")

      stdout.flush
      stdout.show("Dimension of matrix        = ",d)
      stdout.show("No. of states wanted       = ",.n_evals)
      stdout.show("Trial vector sets to keep  = ",.n_keep)
      stdout.show("Max. no. of iterations     = ",.max_iterations)
      stdout.show("Convergence tolerance      = ",.tol_Davidson)
      stdout.flush

      ! Put the table
      .table.put_headings

   end

   put_D_table_body_and_footer
   ! Print out the Davidson table body for the current iteration.
   ! If converged, print out footer as well.
      self :: INOUT

   ENSURE(.table.allocated,"no table created")
   ENSURE(.eval.allocated, "no eigenvalue")

      i :: INT

      ! Set table body (leaky)
      .table(1).set_values([.iteration],auto=FALSE)
      .table(2).set_values([.max_res(.n_trial)],auto=FALSE)
    ! .table(3).set_values([.collapse])
      do i = 1,.n_evals
      .table(i+2).set_values([.eval(i)*EV_PER_HARTREE])
      end

      ! Put out the body
      .table.put_body

      ! Clear columns for next time (UNleaky!)
      .table.clear_columns

      if (.Davidson_done) then 
        .table.put_footer
        stdout.flush
        if (.converged) then; stdout.text("* * * Converged * * *")
        else;                 stdout.text("* * * NOT CONVERGED * * *")
        end
        .table.put_footer
        stdout.flush
      end

   end

   put_evecs
   ! Print out the eigenvectors
      self :: IN

   ENSURE(.single.allocated,"no single states")
   ENSURE(.evec.allocated,  "evec unallocated")

      table :: VEC{TABLE_COLUMN}@
      i :: INT

      ! Summary options
      .put_options

      stdout.flush
      stdout.text("===================")
      stdout.text("Eigenvector columns")
      stdout.text("===================")
      stdout.flush

      table.create(3+.n_evals)

      table(1).set_heading("LUMO")
      table(1).set_subhead("(v)")
      table(2).set_heading("HOMO")
      table(2).set_subhead("(o)")
      table(3).set_heading("Delta E")
      table(3).set_subhead("Ev-Eo")

      table(1).set_values(.single(:,1))
      table(2).set_values(.single(:,2)-.n_occ)
      table(3).set_values(.deltaE)
      do i = 1,.n_evals
      table(3+i).set_values(.evec(:,i))
      end

      table.put(label_rows=TRUE)

      table.destroy

   end


end
