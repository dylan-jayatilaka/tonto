!  ============
!  TD calc info
!  ============

   is_restricted result(res) ::: pure
   ! Return TRUE if the method is *only* a S=0 state
      self :: IN
      res  :: BIN
      res = .method.includes("r-")
   end

   is_unrestricted result(res) ::: pure
   ! Return TRUE if the method is *only* a S=0 state
      self :: IN
      res  :: BIN
      res = .method.includes("u-")
   end

   is_singlet_calc result(res) ::: PURE
   ! Return TRUE if the method is *only* a S=0 state
      self :: IN
      res  :: BIN
      res = .method.includes("-s=0") AND NOT .method.includes("-s=0&1")
   end

   is_triplet_calc result(res) ::: PURE
   ! Return TRUE if the method is *only* a S=1 state
      self :: IN
      res  :: BIN
      res = .method.includes("-s=1")
   end

   is_s0_and_s1_calc result(res) ::: PURE
   ! Return TRUE if the method *both* an S=0 and S=1 state.
   ! This test is used to append results.
      self :: IN
      res  :: BIN
      res = .method.includes("-s=0&1")
   end

   do_sqrt_evals result(res) ::: PURE
   ! Return TRUE if TD eigenvalues should be square-rooted.
      self :: IN
      res  :: BIN
      res = .method.includes("-tdhf")
   end

   is_an_SS_method result(res) ::: PURE
   ! Return TRUE if the method is a state-slected method.
      self :: IN
      res  :: BIN
      res = .method.includes("-ss")
   end

   is_CIS result(res) ::: PURE
   ! Return TRUE if it is a CIS/Tamm-Dancoff calculation
   ! which does not require an off-diagonal "B" matrix.
      self :: IN
      res  :: BIN
      res = .method.includes("-cis")
   end

   is_Tamm_Dancoff result(res) ::: PURE
   ! Return TRUE if it is a CIS/Tamm-Dancoff calculation
   ! which does not require an off-diagonal "B" matrix.
      self :: IN
      res  :: BIN
      res = .method.includes("-cis")
   end

   has_states result(res) ::: pure
   ! Return TRUE if the states have been calculated.
   ! It is assumed that these are singlet states and
   ! if a triplet calculation is run afterwards, those
   ! states are appended.
      self :: IN
      res  :: BIN
      res = .eval.allocated AND .evec.allocated
   end

   is_M0_singlet(i) result(res) ::: PURE
   ! Return TRUE if vector "i" is an M=0 singlet.
      self :: IN
      i    :: INT, IN
      res  :: BIN

   ENSURE(.use_M_0,"not an M=0 calculation")
   ENSURE(.evec.allocated,"no state evec's")
   ENSURE(i>0 AND i<= .V.dim2,"state index not in allowed range")

      d1,d3, n :: INT

      d1 = .evec.dim1/4
      d3 = d1*3
      n   = .evec(1:d1,i).index_of_largest_value
      res = .evec(d3+n,i).same_sign_as(.evec(n,i))

   end

!  ====================
!  State selection info
!  ====================

   no_of_singles result (res) ::: pure
   ! The number of single excitations which satisfy the tol_S
   ! excitation window.
      self :: IN
      res  :: INT

      i,a :: INT
      val :: REAL

      if (.tol_S.equals(ZERO)) then

         res = .n_vir*.n_occ

      else

         res = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            if (val<.tol_S) then
               res = res + 1
            end
         end
         end

      end

   end

   no_of_doubles result (res) ::: PURE
   ! The number of double excitations within energy .tol_D
   ! of excitation energy .omega.
      self :: IN
      res  :: INT

      n,d :: INT
      i,a, ai :: INT
      j,b, bj :: INT
      Eai,Ebj,val :: REAL

      ! Exit?
      res = .no_of_singles
      if (res==0) return
      if (.single.deallocated) return
      if (.omega.equals(ZERO)) return
      if (.tol_D.equals(ZERO)) return

      ! List of allowed occs and virs
      d = .single.dim1

      n = 0
      do ai = 1,d
         a  = .single(ai,1)
         i  = .single(ai,2)
         Eai = .deltaE(ai)
         do bj = 1,ai
            b  = .single(bj,1)
            j  = .single(bj,2)
            Ebj = .deltaE(bj)
            val = Eai + Ebj
            if (abs(val-.omega)<.tol_D AND val<.tol_S) then
               n = n + 1
            end
         end
      end

      res = n

   end

   r_O_singles_str result (res) ::: leaky, PURE
   ! List of occupied MOs in the singles-excitation window.
   ! Restricted version.
      self :: IN
      res  :: VEC{STR}@

   ENSURE(.single.allocated,"no single's array")


      d, i,omo :: INT

      d = .single.dim1

      res.create(d)
      do i = 1,d
         omo = .single(i,2) - .n_occ
         res(i) = trim(omo.to_str)
      end

   end

   r_V_singles_str result (res) ::: leaky, PURE
   ! List of occupied MOs in the singles-excitation window.
   ! Restricted version.
      self :: IN
      res  :: VEC{STR}@

   ENSURE(.single.allocated,"no single's array")


      d, i,vmo :: INT

      d = .single.dim1

      res.create(d)
      do i = 1,d
         vmo = .single(i,1)
         res(i) = trim(vmo.to_str)
      end

   end

   u_O_singles_str result (res) ::: leaky, PURE
   ! List of occupied MOs in the singles-excitation window.
   ! Unrestricted version.
      self :: IN
      res  :: VEC{STR}@

   ENSURE(.single.allocated,"no single's array")


      d,d4, i,omo :: INT

      d  = .single.dim1
      d4 = 4*d

      res.create(d4)
      res = " "
      do i = 1,d4,4
         omo = .single((i+3)/4,2) - .n_occ
         res(i) = trim(omo.to_str)
      end

   end

   u_V_singles_str result (res) ::: leaky, PURE
   ! List of occupied MOs in the singles-excitation window.
   ! Unrestricted version.
      self :: IN
      res  :: VEC{STR}@

   ENSURE(.single.allocated,"no single's array")


      d,d4, i,vmo :: INT

      d  = .single.dim1

      res.create(d4)
      res = " "
      do i = 1,d4,4
         vmo = .single((i+3)/4,1)
         res(i) = trim(vmo.to_str)
      end

   end

!  =======================
!  State selection methods
!  =======================

   docu_find_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("find_singles")
      stdout.flush
      stdout.text(". Find and sort the single-excitations into increasing")
      stdout.text("  Koopman's energy order.")
      if (present(die)) stop
   end

   find_singles ::: leaky, PURE
   ! Sorts single excitations by smallest eigenvalue energy
   ! difference, and keep pairs in the single(:,1:2) array.
      self :: INOUT

      i,a, n :: INT
      val :: REAL
      ind :: VEC{INT}@

      ! Below cannot be undone.
      if (.use_IVO_energies) then
         ENSURE(.Ei.allocated,"no IVO energies allocated")
         .Ev = .Ei
      end

      ! Can proceed?
      n = .no_of_singles
      if (n==0) return

      ! Leaky !!!!!!!!!!!
      .deltaE.create(n)
      .single.create(n,2)
      !!!!!!!!!!!!!!!!!!!

      ! Get delta E and singles indices.
      ! Loop over occupieds from HOMO down and virtuals 
      ! from LUMO up so the energy difference is roughly 
      ! in increasing Koopmans energy order, but in the 
      ! end the energies are sorted.
      if (.tol_S.is_zero) then

         ! No window - get all
         n = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            n = n + 1
            .deltaE(n)   = val
            .single(n,1) = a
            .single(n,2) = i
         end
         end

      else

         ! Use window
         n = 0
         do i = .n_occ,1,-1
         do a = 1,.n_vir
            val = .Ev(a) - .Eo(i)
            if (val<.tol_S) then
               n = n + 1
               .deltaE(n)   = val
               .single(n,1) = a
               .single(n,2) = i
            end
         end
         end

      end

      ! Sort into increasing E difference
      ind.create(n)
      .deltaE.quick_sort(ind)

      ! Reorder
      .deltaE      = .deltaE(ind)
      .single(:,1) = .single(ind,1)
      .single(:,2) = .single(ind,2)

      ! Set min & max OMO and VMO
      .min_OMO = minval(.single(:,2))
      .max_VMO = maxval(.single(:,1))

   end

   docu_find_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("find_doubles")
      stdout.flush
      stdout.text(". Find all double excitations within a certain tolerance")
      stdout.text("  of a previously entered excitation energy, entered via")
      stdout.text("  omega= and tol_D=")
      if (present(die)) stop
   end

   find_doubles ::: leaky, PURE
   ! Find double excitations in S window, within .tol_D
   ! of the chosen excitation energy .omega. Also find
   ! all singles parents for each double.
      self :: INOUT

   ENSURE(.single.allocated,"no single's array")
   ENSURE(.deltaE.allocated,"no deltaE array")
   ENSURE(.omega>ZERO, "target excitation energy omega is zero!")
   ENSURE(.tol_D>ZERO, "tol_D is zero!")

      d,n :: INT
      ai, a,i :: INT
      bj, b,j :: INT
      Eai,Ebj,val :: REAL
      n_S,f,l :: INT
      cnt :: VEC{INT}@

      ! Can we proceed?
      n = .no_of_doubles
      if (n==0) return

      ! List of allowed occs and virs
      d = .single.dim1

      .delEab.create(n)
      .double.create(n,2)

      n = 0
      do ai = 1,d
         a  = .single(ai,1)
         i  = .single(ai,2)
         Eai = .deltaE(ai)
         do bj = ai,d                      ! Swap
            b  = .single(bj,1)
            j  = .single(bj,2)
            Ebj = .deltaE(bj)
            val = Eai + Ebj
            if (abs(val-.omega)<.tol_D AND val<.tol_S) then
               n = n + 1
               .delEab(n)   = val - .omega ! Note sign
               .double(n,1) = ai 
               .double(n,2) = bj 
            end
         end
      end

      ! Count distinct singles-parent classes
      .double(:,1).make_repetition_count(cnt,n_S)

      ! Make S_list parent array
      ! First and last indices where parent single "bj" has 
      ! different "ai" values. These parents are used to 
      ! generate Fock matrix elements and may be used to make
      ! a new singles-singles CIS block.
      .S_list.create(n_S,2)
      l = 0
      i = 0
      do 
         f = l + 1
         l = l + cnt(f)
         i = i + 1
         .S_list(i,1) = f
         .S_list(i,2) = l
         if (i==n_S) exit
      end

      cnt.destroy

    if (n>0) then
   ENSURE(all(.S_list<= n),"bad S_list")
    end

   end

!  ==================
!  Davidson iteration
!  ==================

! Inquiry

   converged result (res) ::: PURE
   ! Return TRUE if the Davidson procedure is done i.e. either
   ! converged or gone on for too long ... and, it must also
   ! have executed the requested minimum number of times ...
      self :: IN
      res :: BIN
      res = .residual<.tol_Davidson       &
        AND .iteration >= .min_iterations &
        AND .iteration <= .max_iterations
   end

   collapse result (res) ::: pure
   ! Collapse the Davidson subspace down to one set.
      self :: IN
      res :: BIN
      res = .n_trial==.n_keep
   end

   fst_trial_vector result (res) ::: pure
   ! Return the index of the first trial vector column
   ! in the current Davidson iteration.
      self :: IN
      res  :: INT

      n,b :: INT

      n   = .n_evals
      b   = .n_trial
      res = n*(b-1) + 1

   end

   lst_trial_vector result (res) ::: pure
   ! Return the index of the last trial vector column
   ! in the current Davidson iteration.
      self :: IN
      res  :: INT

      n,b :: INT

      n   = .n_evals
      b   = .n_trial
      res = n*b

   end

   best_trial_vector_set result (res) ::: pure
   ! Get the trial set with the best residuals.
   ! NOTE: can't be used yet.
      self :: IN
      res  :: INT
      res = .max_res.index_of_minimum
   end

   residual result (res) ::: PURE
   ! Return current maximum of the Ritz-vector residuals.
   ! NOTE: .max_res must be set externally beforehand!
      self :: IN
      res :: REAL

   ENSURE(.max_res.allocated,"max_res not allocated")

      res = .max_res(.n_trial)

   end

   set_max_res(val) ::: leaky, PURE
   ! Set the maximum residual vector length for this iteration.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(.max_res.allocated,"no max_res")

      i :: INT

      i = .n_trial
      .max_res(i) = val

   end

!  =================
!  Iteration control
!  =================

   initialize_Davidson(name) ::: leaky
   ! Initialise the Davidson iterations
   ! Use archive "name" for any initial vectors.
      self :: INOUT
      name :: STR, IN

      d0,d1,d2,d3 :: INT
      d, n,n4, s  :: INT
      n_max   :: INT
      archive :: ARCHIVE

      .iteration = 0
      .n_trial   = 0

      ! Dimensions
      n = .n_evals 
      d = .single.dim1   ! "d" <= nv*no
      if (.is_unrestricted) then
         d = 4*d
      end

      ! Evals & evecs (leaky)
      .eval.create(n)
      .evec.create(d,n)

      ! Max. residual vector lengths (leaky)
      .max_res.create(.n_keep)
      .max_res = ZERO

      ! Temporaries for CIS part
      n = .n_evals
      n_max = n*.n_keep
      .V.create(d,n_max)    ! Davidson trial vector columns
      .W.create(d,n_max)    ! W = A.V in MO basis
      .R.create(d)          ! Residual vector

      ! Initial vectors
      ! The single-excitations states should be well-ordered
      ! e.g. in increasing energy and with sensible shape.
      ! Consider DFT, non-canonical VMOs, or Fermi-Amaldi.
      if (.is_restricted) then

         .V(:,1:n).to_unit_mx

      else

         ! Zero
         .V = ZERO

         archive.set(name,"CIS_evec,u")

         if (archive.exists AND .archive_results) then

            ! Read archive, make labels
            archive.read(.evec)
            .V(:,1:n) =  .evec
            archive.set(name,"CIS_eval,u")
            archive.read(.eval)
            .make_u_Slab
          ! .put_evecs

         else


            if (NOT .use_M_0) then

               ! Initialise S=0 & S=1
               ! shape(V) is really (d,4,n*n_keep)
               d  = .single.dim1
               d0 = 0
               do s = 1,n,4
                  d0 = d0 + 1 
                  d1 = d0 + d
                  d2 = d1 + d
                  d3 = d2 + d
                  .V(d0,s  ) = ONE ! aa
                  .V(d1,s+1) = ONE ! ba
                  .V(d2,s+2) = ONE ! ab
                  .V(d3,s+3) = ONE ! bb
               end

            else

               d  = .single.dim1
               d0 = 0
               do s = 1,n,2        ! Double above case
                  d0 = d0 + 1      ! 2,3,4 ...
                  d1 = d0 + d
                  d2 = d1 + d
                  d3 = d2 + d
                  .V(d0,s  ) = ONE ! aa
                  .V(d3,s+1) = ONE ! bb
               end

            end

         end

      end

      ! Davidson temporaries for CIS part
      ! --- V or J & K in AO basis
      if (.is_restricted) then
         .Vao.create( n,.n_bf,.n_bf)   ! Density matrices
         .Aao.create( n,.n_bf,.n_bf)   ! A.V in AO basis
      else
         n4 = 4*n
         .Vao.create(n4,.n_bf,.n_bf)
         .Jao.create(n4,.n_bf,.n_bf)   ! J & K bits of A.V
         .Kao.create(n4,.n_bf,.n_bf)   
      end

      ! Set table headings
      .set_D_table_headings

   end

   update_iteration ::: pure
   ! Update the SCF iteration
      self :: INOUT

      .iteration = .iteration + 1
      .n_trial   = .n_trial   + 1 ! Always incremented

   end

   reset_subspace ::: pure
   ! Reset the Davidson subspace to one trial vector set.
      self :: INOUT

      n :: INT

      ! Keep last vectors
      n = .evec.dim2
      .V(:,1:n) = .evec  

      ! Keep last error
      .max_res(1 ) = .max_res(.n_trial)
      .max_res(2:) = ZERO

      ! One trial set
      .n_trial = 1

   end

   finalize_iteration ::: leaky, PURE
   ! Clean up memory for Davidson procedure
      self :: INOUT

      ! Temporaries
      if (.is_restricted) then
         .Aao.destroy
         .Vao.destroy
      else
         .Kao.destroy
         .Jao.destroy
         .Vao.destroy
      end

      .R.destroy
      .W.destroy
      .V.destroy

   end

   store_results(name) ::: leaky
   ! Store the results, make table Slab info.
   ! NOTE: merging of S=0 and S=1 
      self :: INOUT
      name :: STR, IN

      ! Clean up !!!!!!!!
      .finalize_iteration
      !!!!!!!!!!!!!!!!!!!

      if (.is_restricted) then
         .:store_r_results(name)
         .make_r_Slab
      else
         .:store_u_results(name)
         .make_u_Slab
      end

   end

   store_r_results(name) ::: leaky, private
   ! Save results in core and on disk.
   ! In core needed for later merging of S=0 and S=1 results.
      self :: INOUT
      name :: STR, IN

      archive :: ARCHIVE

      ! Store singlets
      if (.is_singlet_calc) then
         .eval0 = .eval
         .evec0 = .evec
      end
      
      ! Store triplets
      if (.is_triplet_calc) then
         .eval1 = .eval
         .evec1 = .evec
      end

      if (NOT .archive_results) return

      ! Archive singlets
      if (.is_singlet_calc) then
         archive.set(name,"CIS_eval_S=0,r")
         archive.write(.eval0)
         archive.set(name,"CIS_evec_S=0,r")
         archive.write(.evec0)
      end
      
      ! Archive triplets
      if (.is_triplet_calc) then
         archive.set(name,"CIS_eval_S=1,r")
         archive.write(.eval1)
         archive.set(name,"CIS_evec_S=1,r")
         archive.write(.evec1)
      end

   end

   make_r_Slab ::: leaky, private, PURE
   ! Make restricted Slab labels for output table.
      self :: INOUT

      ord :: VEC{INT}@
      n,i :: INT

      n = .evec.dim2

      if (.is_singlet_calc) then
         .Slab.create(n) ! Labels
         ord = [ (i, i=1,n) ]
         .Slab = spread("S",1,n)//ord.to_str
         ord.destroy
      end
      
      if (.is_triplet_calc) then
         .Slab.create(n) ! Labels
         ord = [ (i, i=1,n) ]
         .Slab = spread("T",1,n)//ord.to_str
         ord.destroy
      end

   end

   store_u_results(name) ::: leaky, private
   ! Store unrestricted results on disk only.
   ! Clean up, store the results, with sorting if needed.
   ! UNRESTRICTED CASE.
      self :: INOUT
      name :: STR, IN

      archive :: ARCHIVE

      if (NOT .archive_results) return

      ! Archive
      archive.set(name,"CIS_evec,u")
      archive.write(.evec)
      archive.set(name,"CIS_eval,u")
      archive.write(.eval)

   end

   make_u_Slab ::: leaky, private
   ! Make unrestricted Slab labels for output table.
      self :: INOUT

      cnt  :: VEC{INT}@
      eval :: VEC{REAL}@
      n,i, n_kind :: INT
      k1,k2,k3, nt,ns :: INT

      n = .evec.dim2

      .Slab.create(n) ! Labels
      .Slab = " "

      if (NOT .use_M_0) then

         eval = .eval*EV_PER_HARTREE
         eval.make_repetition_count(cnt,n_kind,eps=TOL(3))

         k1 = 0
         k2 = 0
         k3 = 0
         do i = 1,n
            select case (cnt(i))
            case (0)
               .Slab(i) = " "
            case (1)
               k1 = k1 + 1
               .Slab(i)   = "S"//trim(k1.to_str)
            case (2)
               k2 = k2 + 1
               .Slab(i)   = "D"//trim(k2.to_str)
            case (3)
               k3 = k3 + 1
               .Slab(i)   = "T"//trim(k3.to_str)
            end
         end
         cnt.destroy
         eval.destroy

      else

         ns = 0
         nt = 0
         do i = 1,n
            if (.is_M0_singlet(i)) then
               ns = ns + 1
               .Slab(i) = "S"//trim(ns.to_str)
            else
               nt = nt + 1
               .Slab(i) = "T"//trim(nt.to_str)
            end
         end

      end

   end

   merge_S01_results ::: leaky, PURE
   ! Merge S=0 and S=1 results ready for printing
   ! RESTART BECOMES IMPOSSIBLE IN THIS CASE.
      self :: INOUT

   ENSURE(.is_s0_and_s1_calc,"not a S=0&1 calc")

      ind :: VEC{INT}@
      ord :: VEC{INT}@
      d,n,i :: INT

      n = .evec.dim2

      .eval = [ .eval0, .eval1 ]
      
      d = .evec.dim1
      .evec.create(d,2*n)
      .evec(:,  1:n) = .evec0
      .evec(:,n+1: ) = .evec1
      
      ! Set S values
      .S.create(2*n)
      .S(  1:n) = 0
      .S(n+1: ) = 1
      
      ! State order
      .Slab.create(2*n)
      ord.create(2*n)
      
      ! Singlet lower in energy
      ord(  1:n) = [ (i, i=1,n) ]
      ord(n+1: ) = [ (i, i=1,n) ]
      
      .Slab(  1:n) = spread("S",1,n)//ord(  1:n).to_str
      .Slab(n+1: ) = spread("T",1,n)//ord(n+1: ).to_str
      
      ord.destroy
      
      ! Sort
      ind.create(2*n)
      .eval.quick_sort(ind)
      
      ! Reorder
      .S    =      .S(ind)
      .eval =   .eval(ind)
      .evec = .evec(:,ind)
      .Slab =   .Slab(ind)
      
      ind.destroy
      
   end

!  =======================
!  Efficient A x V product
!  =======================

   make_u_diag_AV(AV,V) ::: PURE
   ! Do the *unrestricted* diag(A).V matrix product on the
   ! single-excitation trial vectors "V" and put the result
   ! into "AV". Will assume non-canonical VMOs if the VV
   ! sector of the Fock matrix .Fv is allocated.
   ! NOTE: if the G state is included nothing need be done
   ! if an initial vector V (1 0 0 ... )^T is used, it should
   ! remain unmofied if no S or D matrix elements are used.
      self :: IN
      AV :: MAT{REAL}, OUT
      V  :: MAT{REAL}, IN

   ENSURE(AV.is_same_shape_as(V),"inconsistent shape, V and AV")
   ENSURE(AV.dim2==.n_evals,"wrong dim2, AV")
   ENSURE(AV.dim1==4*.single.dim1,"wrong dim1, AV")

      ai, a,i :: INT
      bj, b,j :: INT
      d,d2,d3, n :: INT
      Eai,Ei,Fab :: REAL

      ! NOTE: d refers to the *restricted* case.
      ! The unrestricted case is *FOUR* times as big.
      ! The spin order in V is: aa, ba, ab, bb for each "ai"
      d  = .single.dim1
      d2 = 2*d
      d3 = 3*d

      if (NOT .Fv.allocated) then

         ! Canonical VMOs
         do n  = 1,V.dim2
         do ai = 1,d
            Eai = .deltaE(ai)
            AV(   ai,n) = Eai*V(   ai,n) ! aa
            AV(d +ai,n) = Eai*V(d +ai,n) ! ba
            AV(d2+ai,n) = Eai*V(d2+ai,n) ! ab
            AV(d3+ai,n) = Eai*V(d3+ai,n) ! bb
         end
         end

      else

         ! Noncanonical VMO case
         do n  = 1,V.dim2
         do ai = 1,d
            a  = .single(ai,1)
            i  = .single(ai,2)
            Ei = -.Eo(i)
            AV(   ai,n) = Ei*V(   ai,n) ! aa
            AV(d +ai,n) = Ei*V(d +ai,n) ! bb
            AV(d2+ai,n) = Ei*V(d2+ai,n) ! ab
            AV(d3+ai,n) = Ei*V(d3+ai,n) ! bb
            do bj = 1,d
               b  = .single(bj,1)
               j  = .single(bj,2)
               if (i/=j) cycle
               Fab = .Fv(a,b)
               AV(   ai,n) = AV(   ai,n) + Fab*V(   bj,n) ! aa
               AV(d +ai,n) = AV(d +ai,n) + Fab*V(d +bj,n) ! ba
               AV(d2+ai,n) = AV(d2+ai,n) + Fab*V(d2+bj,n) ! ab
               AV(d3+ai,n) = AV(d3+ai,n) + Fab*V(d3+bj,n) ! bb
            end
         end
         end

      end

   end

   make_r_diag_AV(AV,V) ::: PURE
   ! Do the diag(A).V matrix product on single-excitation
   ! trial vectors "V" and put the result into "AV".
   ! Can cope with non-canonical VMOs if the VV sector of
   ! the Fock matrix .Fv is allocated.
      self :: IN
      AV :: MAT{REAL}, OUT
      V  :: MAT{REAL}, IN

   ENSURE(AV.is_same_shape_as(V),"inconsistent shape, V and AV")
   ENSURE(AV.dim2==.n_evals,"wrong dim2, AV")
   ENSURE(AV.dim1==.single.dim1,"wrong dim1, AV")

      ai, a,i :: INT
      bj, b,j :: INT
      d,n :: INT

      ! Sizes
      d = .single.dim1

      if (NOT .Fv.allocated) then

         ! Canonical VMOs
         do n  = 1,V.dim2
         do ai = 1,d
            AV(ai,n) = .deltaE(ai)*V(ai,n)
         end
         end

      else

         ! Noncanonical VMO case
         do n  = 1,V.dim2
         do ai = 1,d
            a  = .single(ai,1)
            i  = .single(ai,2)
            AV(ai,n) = -.Eo(i)*V(ai,n)
            do bj = 1,d
               b  = .single(bj,1)
               j  = .single(bj,2)
               if (i/=j) cycle
               AV(ai,n) = AV(ai,n) + .Fv(a,b)*V(bj,n)
            end
         end
         end

      end

   end


!   change_u_V_to_AO(Vao,V) ::: PURE
!   ! ***************************************
!   ! NOTE: Only the _r_ code is used, below.
!   ! ***************************************
!   ! Back transform *unrestricted* Davidson trial vectors
!   ! "V" into symmetric (n_bf x n_bf) AO-sized density mx's
!   ! "Vao", for each excited state eigenvalue. Needed to get
!   ! the 2e-part of the A.V Davidson step in CIS/TD eqns.
!   ! NOTE: "V" is 4 times the size of the restricted case.
!   !       Due to the the spin blocks: aa, ba, ab bb.
!   ! NOTE: the result does *not* accumulate.
!      self :: IN
!      Vao  :: MAT3{REAL}, OUT
!      V    :: MAT{REAL}, IN
!
!   ENSURE(Vao.dim1==4*.n_evals,"inconsistent dim1, Vao")
!
!      d,d2,d3,d4 :: INT
!      ai,a,i :: INT
!      no, lo :: INT
!      n, p,q :: INT
!      val :: REAL
!      W :: MAT3{REAL}@
!
!      ! Sizes & limits
!      d  = .single.dim1 - 1 ! Remove G
!      d2 = 2*d
!      d3 = 3*d
!      d4 = 4*d
!
!      no = .n_occ
!      lo = .min_OMO
!
!      ! Single index transform temporary
!      ! Last index stores spin blocks.
!      W.create([1,.n_bf],[lo,no],[1,4*.n_evals])
!      W = ZERO
!
!      ! Transform "a" index of "V" -> "W"
!      do n  = 1, .n_evals
!      do p  = 1, .n_bf
!      do ai = 2, d+1
!         a = .single(ai,1)
!         i = .single(ai,2)
!         ! a -> p
!         val = .MOv(p,a)
!         W(p,i,n  ) = W(p,i,n  ) + val*V(   ai,n) ! aa
!         W(p,i,n+1) = W(p,i,n+1) + val*V(d +ai,n) ! ba
!         W(p,i,n+2) = W(p,i,n+2) + val*V(d2+ai,n) ! ab
!         W(p,i,n+3) = W(p,i,n+3) + val*V(d3+ai,n) ! bb
!      end
!      end
!      end
!
!      ! Transform "i" index of "W" -> "Vao"
!      Vao = ZERO
!      do n = 1, .n_evals
!      do i = lo, no
!      do p = 1, .n_bf
!      do q = 1, .n_bf
!         ! i -> q
!         val = .MOo(q,i)
!         Vao(n  ,p,q) = Vao(n  ,p,q) + val*W(p,i,n  )
!         Vao(n+1,p,q) = Vao(n+1,p,q) + val*W(p,i,n+1)
!         Vao(n+2,p,q) = Vao(n+2,p,q) + val*W(p,i,n+2)
!         Vao(n+3,p,q) = Vao(n+3,p,q) + val*W(p,i,n+3)
!      end
!      end
!      end
!      end
!
!      ! Clean up
!      W.destroy
!
!   end

   change_r_V_to_AO(Vao,V) ::: PURE
   ! Back transform trial eigenvectors "V" into symmetric
   ! (n_bf x n_bf) AO sized density matrices "Vao", for
   ! each excited state eigenvalue. Needed to calculate
   ! the 2e-part of the A.V Davidson step in CIS/TD eqns.
   ! NOTE: the result does *not* accumulate.
      self :: IN
      Vao  :: MAT3{REAL}, OUT
      V    :: MAT{REAL}, IN

   ENSURE(Vao.dim1==V.dim2,"inconsistent dim1, Vao")

      ai, a,i :: INT
      d,no,lo :: INT
      n, p, q :: INT
      W :: MAT3{REAL}@

      ! Sizes & limits
      d  = .single.dim1
      no = .n_occ
      lo = .min_OMO

      ! Single-index transform temporary
      W.create([1,.n_bf],[lo,no],[1,V.dim2])
      W = ZERO

      ! Transform "a" index of "V" -> "W"
      do n  = 1, V.dim2
      do p  = 1, .n_bf
      do ai = 1, d
         a = .single(ai,1)
         i = .single(ai,2)
         ! a -> p
         W(p,i,n) = W(p,i,n) + .MOv(p,a)*V(ai,n)
      end
      end
      end

      ! Transform "i" index of "W" -> "Vao"
      Vao = ZERO
      do i = lo, no
      do p = 1, .n_bf
      do q = 1, .n_bf
      do n = 1, Vao.dim1
         ! i -> q
         Vao(n,p,q) = Vao(n,p,q) + .MOo(q,i)*W(p,i,n)
      end
      end
      end
      end

      ! Clean up
      W.destroy

   end


   change_u_V_to_MO(V,Jao,Kao) ::: PURE
   ! Transform and *ACCUMULATE* AO-basis "Jao" and "Kao"
   ! matrices from the 2e part of the CIS equations into
   ! the correct spin blocks of the unrestricted Davidson
   ! trial eigenvectors "V" in single-excitation MO basis.
   ! Accumulation is needed so as to add onto the 1e term.
   ! NOTE:
   ! For each eigenvalue "n" in V(:,n) the spin blocks for 
   ! the first index "ai" are contiguous in the order:
   ! aa, ba, ab, bb, each block comprising "d" elements.
   ! The n=1 G state is not considered for V.
      self :: IN
      V   :: MAT{REAL},  INOUT
      Jao :: MAT3{REAL}, IN
      Kao :: MAT3{REAL}, IN

   ENSURE(Jao.dim1==4* V.dim2, "incompatible dim1 & dim2, Jao & V")
   ENSURE(Jao.dim1==4*.n_evals,"wrong dim1, Jao")
   ENSURE(Jao.dim2==.n_bf,     "wrong dim2, Jao")
   ENSURE(Jao.dim3==.n_bf,     "wrong dim3, Jao")
   ENSURE(Kao.is_same_shape_as(Jao),"Kao inconsistent shape with Jao")

      d0,d1,d2,d3 :: INT
      n1,n2,n3,n4 :: INT
      d,no,lo :: INT
      ai, a,i :: INT
      n, p, q :: INT
      WJ, WK  :: MAT3{REAL}@
      Jaa,Jbb :: REAL
      Kaa,Kbb :: REAL
      Kba,Kab :: REAL
      val     :: REAL

      ! Sizes
      d  = .single.dim1
      no = .n_occ
      lo = .min_OMO

      n1 = V.dim2
      n2 = 2*n1
      n3 = 3*n1
      n4 = 4*n1

      ! Single-index transform temporaries
      WJ.create([1,n4],[1,.n_bf],[lo,no])
      WK.create([1,n4],[1,.n_bf],[lo,no])
      WJ = ZERO
      WK = ZERO

      ! Transform "q" index
      do i = lo,no
      do q = 1, .n_bf
         val = .MOo(q,i)
         do p = 1, .n_bf
         do n = 1, n4
            Jaa = Jao(n,p,q)*val
            Kaa = Kao(n,p,q)*val
            WJ(n,p,i) = WJ(n,p,i) + Jaa
            WK(n,p,i) = WK(n,p,i) + Kaa
         end
         end
      end
      end

      ! Transform "p" index, *accumulate* in "V"
      ! For each eigenvalue "n" in V(:,n) the spin blocks for 
      ! the first index "ai" (starting at 2, since 1 is the G 
      ! state) are contiguous in the order aa, ba, ab, bb,
      ! each block comprising "d" elements
      do p  = 1,.n_bf
      do ai = 1,d
         a = .single(ai,1)
         i = .single(ai,2)
         d0 =     ai
         d1 = d + d0
         d2 = d + d1
         d3 = d + d2
         val = .MOv(p,a)
         do n = 1, n1
            Jaa = WJ(   n,p,i)*val
            Jbb = WJ(n3+n,p,i)*val
            Kaa = WK(   n,p,i)*val
            Kba = WK(n1+n,p,i)*val
            Kab = WK(n2+n,p,i)*val
            Kbb = WK(n3+n,p,i)*val
            V(d0,n) = V(d0,n) + Jaa - Kaa + Jbb ! (ai)_aa
            V(d1,n) = V(d1,n) - Kba             ! (ai)_ba
            V(d2,n) = V(d2,n) - Kab             ! (ai)_ab
            V(d3,n) = V(d3,n) + Jbb - Kbb + Jaa ! (ai)_bb
         end
      end
      end

      ! Clean up
      WK.destroy
      WJ.destroy

   end

   change_r_V_to_MO(V,Vao) ::: PURE
   ! Transform and *accumulate* AO-basis matrices "Vao" back
   ! into Davidson trial eigenvectors "V" in the state basis.
      self :: IN
      V    :: MAT{REAL},  INOUT
      Vao  :: MAT3{REAL}, IN

   ENSURE(Vao.dim1==V.dim2,  "incompatible dim1 & dim2, Vao & V")
   ENSURE(Vao.dim1==.n_evals,"wrong dim1, Vao")
   ENSURE(Vao.dim2==.n_bf,   "wrong dim2, Vao")
   ENSURE(Vao.dim3==.n_bf,   "wrong dim3, Vao")

      ai, a,i :: INT
      d,no,lo :: INT
      n, p, q :: INT
      W :: MAT3{REAL}@

      ! Sizes
      d  = .single.dim1
      no = .n_occ
      lo = .min_OMO

      ! Transform "a" index
      W.create([1,V.dim2],[1,.n_bf],[lo,no])
      W = ZERO

      ! Transform "q" index
      do i = lo,no
      do q = 1,.n_bf
      do p = 1,.n_bf
      do n = 1,V.dim2
         W(n,p,i) = W(n,p,i) + Vao(n,p,q)*.MOo(q,i)
      end
      end
      end
      end

      ! Transform "p" index
      do n = 1,V.dim2
      do p = 1,.n_bf
      do ai = 1,d
         a = .single(ai,1)
         i = .single(ai,2)
         V(ai,n) = V(ai,n) + W(n,p,i)*.MOv(p,a)
      end
      end
      end

      ! Clean up
      W.destroy

   end

!   change_AV_to_MO(AV,V) ::: PURE
!   ! Transform the (n_bf x n_bf) matrices "AV" and *accumulate*
!   ! into trial eigenvectors "V" in the state basis.
!      self :: IN
!      AV :: MAT3{REAL}, IN
!      V  :: MAT{REAL},  INOUT
!
!   ENSURE(AV.dim2==.n_bf,   "wrong dim2, AV")
!   ENSURE(AV.dim2==AV.dim3, "AV not square in dim2 & dim3")
!   ENSURE(AV.dim1==.n_evals,"inconsistent dim1, AV")
!   ENSURE(AV.dim1==V.dim2,  "inconsistent dim2, V")
!
!      ai,a,i :: INT
!      d,no,n :: INT
!      lo, hv :: INT
!      C :: MAT{REAL}@
!
!      ! Sizes & limits
!      d  = .single.dim1
!      no = .n_occ
!      lo = .min_OMO
!      hv = .max_VMO
!
!      ! Single excitations
!      C.create([1,hv],[lo,no])
!
!      do n = 1,.n_evals
!
!         ! AV (MO)  -> C_ai(MO)
!         AV(n,:,:).change_basis_to(C,.MOv(:,1:hv),.MOo(:,lo:no))
!
!         ! C_ai(MO) -> V
!         do ai = 1,d
!            a = .single(ai,1)
!            i = .single(ai,2)
!            V(ai,n) = V(ai,n) + C(a,i)
!         end
!
!      end
!
!      ! Clean up
!      C.destroy
!
!   end


!  ======================
!  State selection output
!  ======================

   put_banner
   ! Prints out the coupled-perturbed banner
      self :: IN

      stdout.flush
      stdout.text("============================")
      stdout.text("CIS/TD excited state options")
      stdout.text("============================")
      stdout.flush

      .put_options
      .put_MO_energies
      .put_singles
    ! .put_doubles

   end

   docu_put_options(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_options")
      stdout.flush
      stdout.text(". Display a summary of options used to perform the")
      stdout.text("  response equation calculations")
      if (present(die)) stop
   end

   put_options
   ! Prints summary of what options being used.
      self :: IN

      n :: INT

      stdout.flush
      stdout.show("Method              = ", .method)
      stdout.show("Implementation      = ", .implementation)
      stdout.show("Use IVO energies?   = ", .use_IVO_energies)
      stdout.show("Use M=0 states?     = ", .use_M_0)

      stdout.flush
      stdout.text("No. of electrons")
      stdout.show("  n_occ             = ", .n_occ)
      stdout.show("  n_vir             = ", .n_vir)
      stdout.show("  n_occ x n_vir     = ", .n_occ*.n_vir)

      n  = .no_of_singles

      stdout.flush
      stdout.text("Davidson options")
      stdout.show("  n_evals wanted    = ", .n_evals)
      stdout.show("  n_keep  blocks    = ", .n_keep)
      stdout.show("  No. determinants  = ", n)
      stdout.show("  Max. iterations   = ", .max_iterations)
      stdout.show("  Convergence tol   = ", .tol_Davidson)

      stdout.flush
      stdout.text("Singles window")
      stdout.show("  tol_S             =", .tol_S)
      stdout.show("  tol_S / eV        =", .tol_S*EV_PER_HARTREE)
      if (.implementation/="in-core" OR .is_an_SS_method) then
      stdout.show("  No. of singles    =", n)
      end
      stdout.flush
      stdout.text("Orbital range")
      stdout.show("  Min. occupied MO  =", .min_OMO-.n_occ+1)
      stdout.show("  Max. virtual  MO  =", .max_VMO)
      stdout.flush
      stdout.text("Dressing energy")
      stdout.show("  omega             =", .omega)
      stdout.show("  omega / eV        =", .omega*EV_PER_HARTREE)
      stdout.flush
      stdout.text("Doubles window")
      stdout.show("  tol_D             =", .tol_D)
      stdout.show("  tol_D / eV        =", .tol_D*EV_PER_HARTREE)

      stdout.flush

   end

   put_MO_energies
   ! Prints out the MO energies. May make use of .single
   ! excitation energy to reduce output.
      self :: IN

      no,lo,hv :: INT

      stdout.flush
      stdout.text("===========")
      stdout.text("MO energies")
      stdout.text("===========")

      if (.single.deallocated) then

         ! No S window info
         stdout.flush
         stdout.text("OMO energies:")
         stdout.put(.Eo)

         hv = min(.Ev.dim,10) ! Limit output

         stdout.flush
         stdout.text("VMO energies:")
         stdout.put(.Ev(1:hv))

      else

         ! Use S window to reduce output
         no = .n_occ
         lo = .min_OMO
         hv = min(.max_VMO,10) ! Limit output

         stdout.flush
         stdout.text(". Only the topmost HOMO, and lowest LUMO, energies")
         stdout.text("  are written below, those in the S window.")
         stdout.flush
         stdout.text(". All energies are in ascending order")
         stdout.flush
         stdout.show("  No. of OMOs       = ", .n_occ)
         stdout.show("  Min. occupied MO  =", .min_OMO-.n_occ+1)
         stdout.show("  Max. virtual  MO  =", .max_VMO)


         stdout.flush
         stdout.text("OMO energies:")
         stdout.put(.Eo(lo:no))

         stdout.flush
         stdout.text("VMO energies:")
         stdout.put(.Ev(1:hv))


      end


   end

   put_MOs
   ! Print out the occupied MOs.
      self :: IN

      stdout.flush
      stdout.text("===")
      stdout.text("MOs")
      stdout.text("===")

      stdout.flush
      stdout.text("Occupied MOs:")
      stdout.put(.MOo)

   end

   docu_put_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_singles")
      stdout.flush
      stdout.text(". Display table of the sorted singles states")
      if (present(die)) stop
   end

   put_singles
   ! Print out the sorted singles states.
      self :: IN

      table :: VEC{TABLE_COLUMN}@
      arrow :: VEC{STR}@
      n, m  :: INT

      n = .no_of_singles
      m = .n_max_show

      stdout.flush
      stdout.text("=================")
      stdout.text("CI singles window")
      stdout.text("=================")
      stdout.flush
      stdout.text(". Single excitations S are selected in an energy window")
      stdout.text("  so that:")
      stdout.flush
      stdout.text("     |E_S| < tol_S,")
      stdout.flush
      stdout.text("  where E_S is the singles excitation energy calculated")
      stdout.text("  by Koopman's theorem i.e. orbital energy differences,")
      stdout.flush
      stdout.text(". Single excitation S is specified by:")
      stdout.text("  - I -> A where I < 1 are occupied MOs; 0 is the HOMO")
      stdout.text("  -        where A > 0 are virtual  MOs; 1 is the LUMO")
      stdout.flush
      stdout.text(". Improved virtual MO energies may be used, if requested,")
      stdout.text("  and if VMO canonicalisation was used in the SCF.")
      stdout.flush
      stdout.text("Singles window")
      stdout.show("  tol_S             =", .tol_S)
      stdout.show("  tol_S / eV        =", .tol_S*EV_PER_HARTREE)
      stdout.show("  No. of singles    =", n)
      stdout.flush
      stdout.text("Orbital range")
      stdout.show("  Min. occupied MO  =", .min_OMO-.n_occ+1)
      stdout.show("  Max. virtual  MO  =", .max_VMO)
      stdout.flush
      stdout.show("Use IVO energies?   =", .use_IVO_energies)
      stdout.flush
      stdout.show("No. of to display   =", m)
      stdout.flush

      DIE_IF(n==0,"no single excitations in the window")

      if (m>0) n = min(n,m)

      arrow.create(n)
      arrow = "->"

      table.create(5)

      table(1).set_heading("I")
      table(1).set_values(.single(1:n,2)-.n_occ)

      table(2).set_column_spacing(0)
      table(2).set_heading("->")
      table(2).set_width(3)
      table(2).set_values(arrow)

      table(3).set_heading("A")
      table(3).set_values(.single(1:n,1))

      table(4).set_heading("Ev-Eo")
      table(4).set_subhead(" /au")
      table(4).set_real_precision(3)
      table(4).set_width(8)
      table(4).set_values(.deltaE(1:n))

      table(5).set_heading("Ev-Eo")
      table(5).set_subhead(" /eV")
      table(5).set_real_precision(3)
      table(5).set_width(8)
      table(5).set_values(.deltaE(1:n)*EV_PER_HARTREE)

      table.put(label_rows=TRUE)

      table.destroy
      arrow.destroy

   end

   docu_put_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_doubles")
      stdout.flush
      stdout.text(". Display table of the double-excitation detetrminants")
      stdout.text("  within the omega-window used to correct the TD response")
      stdout.text("  equations.")
      if (present(die)) stop
   end

   put_doubles
   ! Print out the interacting double excitations
      self :: IN

   ENSURE(.single.allocated,"No single array")
   ENSURE(.double.allocated,"No single array")
   ENSURE(.S_list.allocated,"No S_list array")

      table :: VEC{TABLE_COLUMN}@
      arrow :: VEC{STR}@
      S_par :: VEC{STR}@
      n :: INT


      stdout.flush
      stdout.text("=================")
      stdout.text("CI doubles window")
      stdout.text("=================")
      stdout.flush
      stdout.text(". Double excitations D are selected in an energy")
      stdout.text("  window such that:") 
      stdout.flush
      stdout.text("   |E_D - omega| < tol_D,")
      stdout.flush
      stdout.text("  where E_D is D's Koopmans excitation energy,")
      stdout.text("  and omega is a user-specified target energy,")
      stdout.text("  usually a particular excitation energy, and")
      stdout.text("  tol_D is a user-specified tolerance. Also")
      stdout.text("  D must still lie with the singles window i.e.")
      stdout.text("  we must still have: |E_D| < tol_S")
      stdout.flush
      stdout.text(". Double D is made by two singles:")
      stdout.text("  - I -> A label the 1st excitation")
      stdout.text("  - J -> B label the 2nd excitation")
      stdout.text("  where:")
      stdout.text("  - I, J < 1 are occupied MOs; 0 is the HOMO")
      stdout.text("  - A, B > 0 are virtual  MOs; 1 is the LUMO")
      stdout.flush
      stdout.text(". Different classes of Ds coming from a particular")
      stdout.text("  single excitation parent (P: J -> B) are starred.")
      stdout.text("  Eacjh P is used to generate Fock matrix elements,")
      stdout.text("  and to make another CIS block for that class.")
      stdout.flush
      stdout.text("Dressing energy")
      stdout.show("  omega            =", .omega)
      stdout.show("  omega / eV       =", .omega*EV_PER_HARTREE)
      stdout.flush
      stdout.text("Doubles window")
      stdout.show("  tol_D            =", .tol_D)
      stdout.show("  tol_D / eV       =", .tol_D*EV_PER_HARTREE)
      stdout.show("  No. of doubles   =", n)
      stdout.show("  No. of classes   =", .S_list.dim1)
      stdout.flush
      stdout.text("Singles window")
      stdout.show("  tol_S            =", .tol_S)
      stdout.show("  tol_S / eV       =", .tol_S*EV_PER_HARTREE)
      stdout.show("  No. of singles   =", .single.dim1)

      n = .no_of_doubles

      stdout.flush
      stdout.flush

      if (n==0) return

      arrow.create(n)
      arrow = "->"

      S_par.create(n)
      S_par = " "
      S_par(.S_list(:,1)) = "*"

      table.create(11)

      table(1).set_heading("AI")
      table(2).set_heading("BJ")
      table(3).set_heading("P?")

      table(4).set_heading("I")
      table(5).set_column_spacing(0)
      table(5).set_heading("->")
      table(5).set_width(3)
      table(6).set_heading("A")

      table(7).set_heading("J")
      table(8).set_column_spacing(0)
      table(8).set_heading("->")
      table(8).set_width(3)
      table(9).set_heading("B")

      table(10).set_heading("E_D")
      table(10).set_subhead("/eV")
      table(10).set_real_precision(2)

      table(11).set_heading("E_D-w")
      table(11).set_subhead("/eV")
      table(11).set_real_precision(2)

      table( 1).set_values(.double(:,2))                    ! AI
      table( 2).set_values(.double(:,1))                    ! BJ
      table( 3).set_values(S_par)
      table( 4).set_values(.single(.double(:,2),2)-.n_occ)  ! I
      table( 5).set_values(arrow)
      table( 6).set_values(.single(.double(:,2),1))         ! A
      table( 7).set_values(.single(.double(:,1),2)-.n_occ)  ! J
      table( 8).set_values(arrow)
      table( 9).set_values(.single(.double(:,1),1))         ! B
      table(10).set_values((.delEab+.omega)*EV_PER_HARTREE) ! + sign correct
      table(11).set_values( .delEab*EV_PER_HARTREE)

      table.put(label_rows=TRUE)

      table.destroy
      S_par.destroy
      arrow.destroy

   end

