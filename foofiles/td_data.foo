      stdout.flush
      stdout.text(". The energy tolerance to select interacting double excited")
      stdout.text("  determinants from a given excitation energy, specified by")
      stdout.text("  the omega= option.")
      stdout.flush
      stdout.text(". See Maitra et al (2004) JCP 13 p. 5932.")
      stdout.text("  See Mazur et al (2009) J Comp Chem 30 p. 811-7")
      if (present(die)) stop
   end

   read_tol_D ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_tol_D), private
   ! Generic read and set a quantity with units
   end

   docu_tol_Davidson(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("tol_Davidson= REAL")
      stdout.flush
      stdout.text(". The whole-state convergence criteria used in the iterative")
      stdout.text("  Davidson method used to obtain the excitation energies.")
      stdout.flush
      stdout.text(". See also max_keep= and n_evals=")
      if (present(die)) stop
   end

   read_tol_Davidson ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_tol_Davidson), private
   ! Generic read and set a quantity with units
   end

   docu_tol_S(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("tol_S= REAL [0.75]")
      stdout.flush
      stdout.text(". A tolerance to exclude single determinant excitations")
      stdout.text("  whose excitation energy is too large (from the ground")
      stdout.text("  state determinant (according to Koopman's theorem orbital")
      stdout.text("  energy differences).")
      if (present(die)) stop
   end

   read_tol_S ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_tol_S), private
   ! Generic read and set a quantity with units
   end

