module TD_DATA

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create ::: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy ::: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part ::: leaky, PURE
   ! Destroy the pointer parts of self
      self :: INOUT

      .MOs.destroy 

      .ov.destroy
      .vo.destroy

   end

!  ===============================================
!  Set defaults, reset, update and realted methods
!  ===============================================

   set_defaults ::: leaky, PURE
   ! Set default SCF data values
      self :: INOUT

      .method = "rhf"

      ! Tolerances
      .tol_D        = TOL(2)
      .tol_P        = TOL(2)
      .tol_Davidson = TOL(2)

      .iteration      = 0
      .min_iterations = 1
      .max_iterations = 3

   end

   set_defaults(n_bf,n_a,n_b) ::: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT
      n_bf  :: INT, IN
      n_a   :: INT, IN
      n_b   :: INT, IN

      .set_defaults

      .n_bf = n_bf
      .n_a  = n_a
      .n_b  = n_b

      ! Restricted case only
      .n_occ = n_a
      .n_vir = n_bf - n_a

   end

   set_defaults(MOs,MO_energies) ::: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT
      MOs   :: MAT{REAL}, IN
      MO_energies :: VEC{REAL}, IN

      .MOs = MOs
      .eig = MO_energies

   end

   set_max_keep(val) ::: PURE
   ! Set maximum number of eigensolutions to keep.
      self :: INOUT
      val  :: INT, IN

   ENSURE(val>0,"max_keep must be +ve")
   ENSURE(val>.n_eig,"max_keep must be more than n_eig")

      .max_keep = val

   end

   set_method(val) ::: PURE
   ! Set the type of calculation method.
      self :: INOUT
      val  :: STR, IN

   ENSURE(val.is_one_of(["rtd","rhf"]),"unknown method")

      .method = val

   end

   set_n_eig(val) ::: PUREr
   ! Set number of eigensolutions to serach for.
      self :: INOUT
      val  :: INT, IN

   ENSURE(val>0,"n_eig must be +ve")

      .n_eig = val

   end

   set_omega(val) ::: PURE
   ! Set energy .omega from which interacting double
   ! excitation determinants are to be selected.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"omega must be +ve")

      .omega = val

   end

   set_tol_D(val) ::: PURE
   ! Set double-excitation determinant energy selection tolerance
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"tol_D must be +ve")

      .tol_D = val

   end

   set_tol_Davidson(val) ::: PURE!
   ! Set Davidson iteration convergence tolerance on eigenvectors
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"tol_Davidson must be +ve")

      .tol_Davidson = val

   end

   set_tol_P(val) ::: PURE
   ! Set the density matrix change tolerance for convergence.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO,"tol_P must be +ve")

      .tol_P = val

   end

!  =============
!  Input methods
!  =============

   read_keywords ::: get_from(OBJECT), recursive, leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) ::: leaky
   ! Process a command "keyword". Data is inputted from "stdin", unless
   ! "word" is a sequence of blank separated strings. In this case,
   ! the sequence is processed as if it were a separate file.
      self :: INOUT
      keyword :: STR, IN

      word :: STR
      die  :: BIN

      word = keyword
      word.to_lower_case

      select case (word)

      case ("find_doubles   "); .find_doubles
      case ("max_keep=      "); .read_max_keep
      case ("method=        "); .read_method
      case ("n_eig=         "); .read_n_eig
      case ("omega=         "); .read_omega
      case ("put_mo_info    "); .put_MO_info
      case ("put_options    "); .put_options
      case ("put_doubles    "); .put_doubles
      case ("put_singles    "); .put_singles
      case ("sort_singles   "); .sort_singles
      case ("tol_d=         "); .read_tol_D
      case ("tol_davidson=  "); .read_tol_Davidson
      case ("tol_p=         "); .read_tol_P

      ! Documentation
      case ("help?          "); TD_DATA:docu_help
      case ("find_doubles?  "); TD_DATA:docu_find_doubles(die)
      case ("max_keep=?     "); TD_DATA:docu_max_keep(die)
      case ("method=?       "); TD_DATA:docu_method(die)
      case ("n_eig=?        "); TD_DATA:docu_n_eig(die)
      case ("omega=?        "); TD_DATA:docu_omega(die)
      case ("put_doubles?   "); TD_DATA:docu_put_doubles(die)
      case ("put_options?   "); TD_DATA:docu_put_options(die)
      case ("put_singles?   "); TD_DATA:docu_put_singles(die)
      case ("sort_singles?  "); TD_DATA:docu_sort_singles(die)
      case ("tol_d=?        "); TD_DATA:docu_tol_D(die)
      case ("tol_davidson=? "); TD_DATA:docu_tol_Davidson(die)
      case ("tol_p=?        "); TD_DATA:docu_tol_p(die)

      case default;            UNKNOWN(word)
      end

   end


   docu_help ::: selfless, private
   ! Documentation.

      stdout.flush
      stdout.flush
      stdout.text("================")
      stdout.text("Help for TD_DATA")
      stdout.text("================")

      TD_DATA:docu_find_doubles
      TD_DATA:docu_max_keep
      TD_DATA:docu_method
      TD_DATA:docu_n_eig
      TD_DATA:docu_omega
      TD_DATA:docu_put_doubles
      TD_DATA:docu_put_options
      TD_DATA:docu_put_singles
      TD_DATA:docu_sort_singles
      TD_DATA:docu_tol_D
      TD_DATA:docu_tol_Davidson
      TD_DATA:docu_tol_p

      DIE("end of help documentation")

   end


   docu_max_keep(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("max_keep= INT")
      stdout.flush
      stdout.text(". The maximum number of trial eigenvectors to keep when")
      stdout.text("  using the Davidson method to obtain eigenstates of the")
      stdout.text("  response equations")
      stdout.flush
      stdout.text(". See Crouzeix et al  (1994) SIAM J Sci Comput 15_p. 62-76")
      if (present(die)) stop
   end

   read_max_keep ::: get_from(OBJECT:read_and_set, VAL?=>INT, SET?=>.set_max_keep), private
   ! Generic read and set a quantity with units
   end

   docu_method(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("method= STR")
      stdout.flush
      stdout.text(". The kind of mean-field method used in the response equations")
      stdout.flush
      stdout.text(". Allowed values: rhf, rks")
      if (present(die)) stop
   end

   read_method
   ! Read and set the type of calculation "method"
      self :: INOUT

      val :: STR

      stdin.read(val)
      .set_method(val)

   end


   docu_n_eig(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("n_eig= INT")
      stdout.flush
      stdout.text(". The number of eigenvalues (excitation energies) wanted")
      stdout.text("  when solving the response equations")
      stdout.flush
      stdout.text(". It is, presumably, much less than the number of single")
      stdout.text("  excitation, or other, states used in the model")
      stdout.flush
      stdout.text(". See also put_single, put_doubles")
      if (present(die)) stop
   end

   read_n_eig ::: get_from(OBJECT:read_and_set, VAL?=>INT, SET?=>.set_n_eig), private
   ! Generic read and set a quantity with units
   end


   docu_omega(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("omega= REAL")
      stdout.flush
      stdout.text(". The energy of a particular state (above the ground state)")
      stdout.text("  for which double excitations within a certain tolerance tol_D")
      stdout.text("  are to be considered")
      stdout.flush
      stdout.text(". See also tol_D=")
      if (present(die)) stop
   end

   read_omega ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_omega), private
   ! Generic read and set a quantity with units
   end


   docu_tol_D(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("tol_D= REAL")
      stdout.flush
      stdout.text(". The energy tolerance to select interacting double excited")
      stdout.text("  determinants from a given excitation energy specified by")
      stdout.text("  the omega= option")
      stdout.flush
      stdout.text(". See Mazur et al (2009) J Comp Chem 30 p. 811-7")
      if (present(die)) stop
   end

   read_tol_D ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_tol_D), private
   ! Generic read and set a quantity with units
   end


   docu_tol_Davidson(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("tol_Davidson= REAL")
      stdout.flush
      stdout.text(". The who-state convergence criteria used in the iterative")
      stdout.text("  Davidson method used to obtain the excitation energies")
      stdout.flush
      stdout.text(". See also max_keep= , n_eig= and tol_P=")
      if (present(die)) stop
   end

   read_tol_Davidson ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_tol_Davidson), private
   ! Generic read and set a quantity with units
   end

   docu_tol_P(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("tol_P= REAL")
      stdout.flush
      stdout.text(". The convergence criteria used one the individual")
      stdout.text("  density matrix, or excitation, coefficients")
      stdout.flush
      stdout.text(". See also max_keep= , n_eig= and tol_Davidson=")
      if (present(die)) stop
   end

   read_tol_P ::: get_from(OBJECT:read_and_set, VAL?=>REAL, SET?=>.set_tol_P), private
   ! Generic read and set a quantity with units
   end

 !  =======
 !  Methods
 !  =======

   no_of_singles result(res) ::: PURE
   ! The number of single excitations which satisfy the tol_S
   ! excitation window.
      self :: IN
      res  :: INT

      Ei,Ea, val :: REAL
      i,a :: INT

      res = 0

      do i = 1,.n_occ
         Ei = .eig(i)
         do a = .n_occ+1,.n_vir
            Ea = .eig(a)
            val = Ea - Ei
            if (val<.tol_S) then
               res = res + 1
            end
         end
      end

   end

   docu_sort_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("sort_singles")
      stdout.flush
      stdout.text(". Sortthe single-excitation determinants into increasing")
      stdout.text("  energy order. Not strictly necessary but recommended")
      stdout.text("  for interpretation of the states")
      if (present(die)) stop
   end

   sort_singles ::: leaky, PURE
   ! Sorts the single excitations by smallest energy difference, and
   ! keeps the order in an array.
      self :: INOUT

      i,a,ai, n :: INT
      Ea,Ei,val :: REAL
      ind :: VEC{INT}@

      n = .no_of_singles

      ! Create the o-v indices array
      .deltaE.create(n)
      .single.create(n,2)

      ! Get the energy differences
      ai = 0
      do i = 1,.n_occ
         Ei = .eig(i)
         do a = .n_occ+1,.n_vir
            Ea = .eig(a)
            val = Ea - Ei
            if (val<.tol_S) then
               ai = ai + 1
               .deltaE(ai) = val
               .single(ai,1) = a
               .single(ai,2) = i
            end
         end
      end

      ! Sort
      ind.create(n)
      .deltaE.quick_sort(ind)

      ! Reorder
      .deltaE = .deltaE(ind)
      .single(:,1) = .single(ind,1)
      .single(:,2) = .single(ind,2)

   end


   no_of_doubles result(res) ::: pure
   ! The number of double excitations within energy .tol_D
   ! of excitation energy .omega.
      self :: IN
      res  :: INT

      i,a,ai :: INT
      j,b,bj :: INT
      Eai,Ebj,val :: REAL

      res = 0

      if (.omega.equals(ZERO)) return

      ! Get the energy differences
      ai = 0
      do i = 1,.n_occ
      do a = .n_occ+1,.n_vir
         ai = ai + 1
         Eai = .eig(a) + .eig(i)
         bj  = 0
         do j = 1,.n_occ
         do b = .n_occ+1,.n_vir
            bj = bj + 1
            if (bj>ai) cycle
            Ebj = .eig(b) + .eig(j)
            val = Eai + Ebj
            if (abs(.omega-val)<.tol_D) then
               res = res + 1
            end
         end
         end
      end
      end

   end

   docu_find_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("find_doubles")
      stdout.flush
      stdout.text(". Find the double excitations within a certain tolerance")
      stdout.text("  of a previously entered excitation energy omega")
      stdout.flush
      stdout.text(". See also the omega=")
      if (present(die)) stop
   end

   find_doubles ::: leaky, PURE
   ! Find the double excitations within a certain tolerance
      self :: INOUT

   ENSURE(.omega>ZERO,"No energy omega specified")

      n :: INT
      i,a,ai :: INT
      j,b,bj :: INT
      Eai,Ebj,val :: REAL
      ind :: VEC{INT}@

      n = .no_of_doubles

      ! Create the o-v indices array
      .delEab.create(n)
      .double.create(n,2)

      ! Get the energy differences
      n = 0
      ai = 0
      do i = 1,.n_occ
      do a = .n_occ+1,.n_vir
         ai = ai + 1
         Eai = .eig(a) + .eig(i)
         bj  = 0
         do j = 1,.n_occ
         do b = .n_occ+1,.n_vir
            bj = bj + 1
            if (bj>ai) cycle
            Ebj = .eig(b) + .eig(j)
            val = Eai + Ebj
            if (abs(.omega-val)<.tol_D) then
               n = n + 1
               .delEab(n)  = val
               .double(n,1) = ai
               .double(n,2) = bj
            end
         end
         end
      end
      end

      ! Sort
      ind.create(n)
      .delEab.quick_sort(ind)

      ! Reorder
      .delEab = .delEab(ind)
      .double(:,1) = .double(ind,1)
      .double(:,2) = .double(ind,2)

   end


   V_of_VO(vo) result(res) ::: pure
   ! The V index in a compressed VO pair-index
      self :: IN
      vo   :: VEC{INT}, IN
      res  :: VEC{INT}(vo.dim)
      res = modulo(vo,.n_occ)
   end

   O_of_VO(vo) result(res) ::: pure
   ! The V index in a compressed VO pair-index
      self :: IN
      vo   :: VEC{INT}, IN
      res  :: VEC{INT}(vo.dim)
      res = (vo-1)/.n_occ
   end

 !  ===============
 !  Output routines
 !  ===============

   put_banner ::: selfless
   ! Prints out the coupled-perturbed banner
      self :: IN

      stdout.flush
      stdout.text("==================================")
      stdout.text("Time-dependent mean-field response")
      stdout.text("==================================")
      stdout.flush

   end


   docu_put_options(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_options")
      stdout.flush
      stdout.text(". Display a summary of options used to perform the")
      stdout.text("  response equation calculations")
      if (present(die)) stop
   end

   put_options
   ! Prints out a summary of what options are stored in scfdata
      self :: IN

      n :: INT

      ::put_banner

      stdout.flush
      stdout.show("Method                    =", .method)

      stdout.flush
      stdout.text("Dimensions")
      stdout.flush
      stdout.show("n_a                       ", .n_a)
      stdout.show("n_b                       ", .n_a)
      stdout.show("n_occ                     ", .n_occ)
      stdout.show("n_vir                     ", .n_occ)

      stdout.flush
      stdout.text("Tolerances & convergence:")
      stdout.flush
      stdout.show("Single excitation window  =", .tol_S)
      stdout.show("Doubles selection tol     =", .tol_D)
      stdout.show("|Delta P| convergence tol =", .tol_P)
      stdout.show("Davidson  convergence tol =", .tol_Davidson)
      stdout.show("Minimum # of iterations   =", .min_iterations)
      stdout.show("Maximum # of iterations   =", .max_iterations)

      stdout.flush
      n = .no_of_singles
      stdout.show("# of states in window     =", n)

   end


   put_MO_info
   ! Prints out a summary of what options are stored in scfdata
      self :: IN

      stdout.flush
      stdout.text("================")
      stdout.text("MOs and energies")
      stdout.text("================")

      stdout.flush
      stdout.text("MO eigenvalues (au)")
      stdout.put(.eig)

      stdout.flush
      stdout.text("MOs")
      stdout.put(.MOs)

   end


   docu_put_singles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("sort_singles")
      stdout.flush
      stdout.text(". Display table of the sorted singles states")
      if (present(die)) stop
   end

   put_singles
   ! Print out the sorted singles states.
      self :: INOUT

   ENSURE(.single.allocated,"No single determinants!")

      table :: VEC{TABLE_COLUMN}@

      stdout.flush
      stdout.text("=============================")
      stdout.text("Single excitation state order")
      stdout.text("=============================")
      stdout.flush
      stdout.text(". The virtual orbitals are listed first")
      stdout.text(". Index 0 is corresponds to the HOMO")
      stdout.text(". Index 1 is corresponds to the LUMO")
      stdout.flush

      table.create(3)

      table(1).set_heading("LUMO")
      table(2).set_heading("HOMO")
      table(3).set_heading("Delta E")

      table(1).set_values(.single(:,1)-.n_occ)
      table(2).set_values(.single(:,2)-.n_occ)
      table(3).set_values(.deltaE)

      table.put(label_rows=TRUE)

      table.destroy

   end


   docu_put_doubles(die) ::: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("put_doubles")
      stdout.flush
      stdout.text(". Display table of the double-excitation detetrminants")
      stdout.text("  within the omega-window used to correct the TD response")
      stdout.text("  equations.")
      if (present(die)) stop
   end

   put_doubles
   ! Print out the interacting double excitations
      self :: INOUT

   ENSURE(.double.allocated,"No doubles!")

      table :: VEC{TABLE_COLUMN}@

      stdout.flush
      stdout.text("=============================")
      stdout.text("Interacting doubles in window")
      stdout.text("=============================")
      stdout.flush
      stdout.text(". The VO indices are compressed with V runs faster than O")
      stdout.flush
      stdout.show("Doubles selection tol     =", .tol_D)
      stdout.show("omega                     =", .omega)
      stdout.show("# of doubles in window    =",.double.dim1)
      stdout.flush

      table.create(7)

      table(1).set_heading("VO1")
      table(2).set_heading("V")
      table(3).set_heading("O")
      table(4).set_heading("VO2")
      table(5).set_heading("V")
      table(6).set_heading("O")
      table(7).set_heading("Delta E")

      table(1).set_values(.double(:,1)-.n_occ)
      table(2).set_values(.V_of_VO(.double(:,1))-.n_occ)
      table(3).set_values(.O_of_VO(.double(:,1))-.n_occ)
      table(4).set_values(.double(:,2))
      table(5).set_values(.V_of_VO(.double(:,2))-.n_occ)
      table(6).set_values(.O_of_VO(.double(:,2))-.n_occ)
      table(7).set_values(.delEab)

      table.put(label_rows=TRUE)

      table.destroy

   end

end
