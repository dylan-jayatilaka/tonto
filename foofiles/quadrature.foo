!------------------------------------------------------------------------------
!
!==============================================================================
! QUADRATURE
!
! For integrating one dimensional functions by using quadrature. Most of the
! method implemented so far are for Gauss type quadratures --- i.e.  getting
! abscissas and weights based on orthogonal polynomial theory. The Gauss
! quadratures are based on the Numerical Recipes, pp. 144-149.
!
! The following Gauss quadratures are available, with weight function W(x):
! . Gauss-Chebyshev (1st kind): W(x) = (1-x^2)^{-1/2},        -1 < x < 1
! . Gauss-Chebyshev (2nd kind): W(x) = (1-x^2)^{+1/2},        -1 < x < 1
! . Gauss-Chebyshev (3rd kind): W(x) = (x/(1-x))^{+1/2},       0 < x < 1
! . Gauss-Laguerre:             W(x) = x^alpha e^-x,           0 < x < inf
! . Gauss-Legendre:             W(x) = 1,                     -1 < x < 1
! . Gauss-Hermite:              W(x) = e^{-x^2},            -inf < x < inf
! . Gauss-Jacobi:               W(x) = (1-x)^alpha(1+x)^beta, -1 < x < 1
!
! The following standard quadratures are available:
! . Open rectangle    :       0 < x < 1
! . Extended trapezoid:       0 < x < 1
! . Extended Simpson  :       0 < x < 1
! Note that the extended trapezoid method becomes the Euler-Maclaurin formula
! if the derivatives at the endpoints can be made zero.
!
! NOTE: is is up to you to transforms the points and weights to the appropriate
! integration interval in your problem.
!
! Copyright (C) Dylan Jayatilaka, 2004
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!==============================================================================

module QUADRATURE

   implicit none

   allowed_kinds :: VEC{STR}(len=25,12), private

   data allowed_kinds/ &
      "extended_simpson         ", &                
      "extended_trapezoid       ", &                
      "gauss_chebyshev_1st      ", &     
      "gauss_chebyshev_2nd      ", &     
      "gauss_chebyshev_3rd      ", &     
      "gauss_laguerre           ", & 
      "gauss_legendre           ", & 
      "gauss_hermite            ", &
      "gauss_jacobi             ", &
      "open_extended_simpson    ", &
      "open_extended_trapezoid  ", &
      "open_rectangle           "  /                

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

!  ===========
!  Set methods
!  ===========

   set_eps(eps) :: PURE
   ! Set the relative accuracy needed for the roots. Used only for Gauss
   ! quadrature methods.
      self :: INOUT
      eps :: REAL, IN

   ENSURE(eps>ZERO,"must have +ve eps")

      .eps = eps

   end

   set_maxit(maxit) :: PURE
   ! Set the maximum number of iterations to use when solving for the roots.
   ! Used only for Gauss quadrature methods.
      self :: INOUT
      maxit :: INT, IN

   ENSURE(maxit>0,"maxit must be positive")

      .maxit = maxit

   end

   set_kind(kind) :: PURE
   ! Set the kind of interpolation to use. 
      self :: INOUT
      kind :: STR, IN

   ENSURE(kind.is_one_of(allowed_kinds),"unrecognized kind, "//trim(kind))

      .kind = kind.lower_cased

   end

   set_n_pts(n_pts) :: PURE
   ! Set the number of quadrature points wanted
      self  :: INOUT
      n_pts :: INT, IN

   ENSURE(n_pts>0,"n_points must be positive")

      .n_pts = n_pts

   end
   
   set_Gauss_Laguerre_alpha(alpha) :: PURE
   ! Set the Gauss-Laguerre alpha parameter
      self :: INOUT
      alpha :: REAL, IN

      .Gauss_Laguerre_alpha = alpha

   end

   set_Gauss_Jacobi_alpha(alpha) :: PURE
   ! Set the Gauss-Jacobi alpha parameter
      self :: INOUT
      alpha :: REAL, IN

      .Gauss_Jacobi_alpha = alpha

   end

   set_Gauss_Jacobi_beta(beta) :: PURE
   ! Set the Gauss-Jacobi beta parameter
      self :: INOUT
      beta :: REAL, IN

      .Gauss_Jacobi_beta = beta

   end

!  ==========================
!  Finalize quadrature points 
!  ==========================

   set_quadrature_points :: leaky, PURE
   ! Set the quadrature points. NOTE: if you want non-standard limits you must
   ! call .set_limits after this routine to rescale the points and weights
      self :: INOUT

   ENSURE(.kind/=" ","the kind of quadrature has not been set")
   ENSURE(.n_pts>0,"no points have been set")

      if (.kind(1:5)=="gauss") then; .set_roots_and_weights
      else;                          .set_points_and_weights
      end

      .finalized = TRUE

   end

   set_limits(limits) :: PURE
   ! Read in the limits of integration
      self :: INOUT
      limits :: VEC{REAL}(2), IN

   ENSURE(limits(1)<=limits(2),"lower limit must be smaller than upper limit")
   ENSURE(.finalized,"set limits after defining quadrature points and weights")

      .lower_limit = limits(1)
      .upper_limit = limits(2)

      .rescale_points_and_weights

   end

   rescale_points_and_weights :: private, PURE
   ! Rescale the points and weights using a linear transformation, if different
   ! lower and upper limits have been used.
      self :: INOUT

   ENSURE(.kind.is_one_of(allowed_kinds([1,2,3,4,5,7,9,12])),"unrecognized kind, "//trim(.kind))
   ENSURE(.kind/=" ","the kind of quadrature has not been set")
   ENSURE(.n_pts>0,"no points have been set")
   ENSURE(.finalized,"set limits after defining quadrature points and weights")

      select case (.kind)
      case ("extended_simpson   "); .rescale_z0p1
      case ("extended_trapezoid "); .rescale_z0p1
      case ("gauss_chebyshev_1st"); .rescale_m1p1
      case ("gauss_chebyshev_2nd"); .rescale_m1p1
      case ("gauss_chebyshev_3rd"); .rescale_z0p1
      case ("gauss_laguerre     "); ! DIE("cant rescale linearly")
      case ("gauss_legendre     "); .rescale_m1p1
      case ("gauss_hermite      "); ! DIE("cant rescale linearly")
      case ("gauss_jacobi       "); .rescale_m1p1
      case ("open_rectangle     "); .rescale_z0p1
      end

   end

   rescale_m1p1 :: private, PURE
   ! Rescale the points and weights using a linear transformation, from the
   ! range [-1,1] to the new range.
      self :: INOUT

   ENSURE(.kind/=" ","the kind of quadrature has not been set")
   ENSURE(.n_pts>0,"no points have been set")
   ENSURE(.finalized,"set limits after defining quadrature points and weights")

      s,m :: REAL
      i :: INT

      if (.lower_limit==-ONE AND .upper_limit==ONE) return

      s = HALF*(.upper_limit-.lower_limit)
      m = HALF*(.upper_limit+.lower_limit)

      do i = 1,.n_pts
         .pts(i) = s*.pts(i) + m
         .wts(i) = s*.wts(i)
      end

   end

   rescale_z0p1 :: private, PURE
   ! Rescale the points and weights using a linear transformation, from the
   ! range [0,1] to the new range.
      self :: INOUT

   ENSURE(.kind/=" ","the kind of quadrature has not been set")
   ENSURE(.n_pts>0,"no points have been set")
   ENSURE(.finalized,"set limits after defining quadrature points and weights")

      s,m :: REAL
      i :: INT

      if (.lower_limit==ZERO AND .upper_limit==ONE) return

      s = (.upper_limit-.lower_limit)
      m = HALF*(.upper_limit+.lower_limit)

      do i = 1,.n_pts
         .pts(i) = s*(.pts(i)-HALF) + m
         .wts(i) = s*.wts(i)
      end

   end

!  ==================================
!  Gauss quadrature roots and weights
!  ==================================

   set_roots_and_weights :: leaky, private, PURE
   ! Set the Gauss-Legendre roots and weights
      self :: INOUT

   ENSURE(.kind.is_one_of(allowed_kinds(3:9)),"unrecognized kind, "//trim(.kind))
   ENSURE(.n_pts>0,"must have positive number of points")
   ENSURE(.kind(1:5)=="gauss","must be a gauss quadrature")

      .pts.create(.n_pts)  ! These are the roots
      .wts.create(.n_pts)

      select case (.kind)
      case ("gauss_chebyshev_1st"); .set_Gauss_Chebyshev_1st
      case ("gauss_chebyshev_2nd"); .set_Gauss_Chebyshev_2nd
      case ("gauss_chebyshev_3rd"); .set_Gauss_Chebyshev_3rd
      case ("gauss_laguerre     "); .set_Gauss_Laguerre
      case ("gauss_legendre     "); .set_Gauss_Legendre
      case ("gauss_hermite      "); .set_Gauss_Hermite
      case ("gauss_jacobi       "); .set_Gauss_Jacobi
      end

   end

   set_Gauss_Chebyshev_1st :: private, PURE
   ! Set the Gauss-Legendre roots and weights
      self :: INOUT

      i :: INT
      pi_n,c :: REAL

      .lower_limit = -ONE
      .upper_limit = ONE

      pi_n = PI/.n_pts

      .wts = pi_n

      do i = 1,.n_pts

         c = cos(pi_n*(i-HALF))
         .pts(i) = c

         if (NOT .fold_wt_fn_in) cycle

         ! Include weight function in quadrature weight
         .wts(i) = .wts(i) * sqrt(ONE-c*c)

      end

   end

   set_Gauss_Chebyshev_2nd :: private, PURE
   ! Set the Gauss-Legendre roots and weights
      self :: INOUT

      i :: INT
      pi_n,c :: REAL

      .lower_limit = -ONE
      .upper_limit = ONE

      pi_n = PI/(.n_pts+1)

      do i = 1,.n_pts

         c = cos(i*pi_n)

         .pts(i) = c
         .wts(i) = pi_n * (ONE-c*c) 

         if (NOT .fold_wt_fn_in) cycle

         ! Include weight function in quadrature weight
         .wts(i) = .wts(i) / sqrt(ONE-c*c)

      end

   end

   set_Gauss_Chebyshev_3rd :: private, PURE
   ! Set the Gauss-Legendre roots and weights
      self :: INOUT

      i :: INT
      pi_n,c :: REAL

      .lower_limit = ZERO
      .upper_limit = ONE

      pi_n = PI/(2*.n_pts+1)

      do i = 1,.n_pts

         c = cos(pi_n*(i-HALF))
         c = c*c

         .pts(i) = c
         .wts(i) = pi_n * TWO*c

         if (NOT .fold_wt_fn_in) cycle

         ! Include weight function in quadrature weight
         .wts(i) = .wts(i) * sqrt((ONE-c)/c)

      end

   end

   set_Gauss_Laguerre :: private, PURE
   ! Set the Gauss-Laguerre roots and weights
      self :: INOUT

      i,j,n,i2,it :: INT
      a,p1,p2,p3,pp,z,z1,g1,g2 :: REAL

      .lower_limit = ZERO
      .upper_limit = huge(ONE)

      n = .n_pts
      a = .Gauss_Laguerre_alpha

      ! Starting guesses (Numerical Recipes, gaulag): each root starts
      ! from the previous one, so "z" is carried across the loop.
      z = ZERO

      do i = 1,n

         i2 = i-2

         select case (i)
         case(1);      z = (ONE+a)*(THREE+0.92d0*a)/(ONE+2.4d0*n+1.8d0*a)
         case(2);      z = z + (15.0d0+6.25d0*a)/(ONE+0.9d0*a+2.5d0*n)
         case default; z = z + ((ONE+2.55d0*i2)/(1.9d0*i2)+1.26d0*i2*a/(ONE+3.5d0*i2))*(z-.pts(i2))/(ONE+0.3d0*a)
         end

         it = 0
         do 
            it = it + 1
            p1 = ONE
            p2 = ZERO
            do j = 1,n
               p3 = p2
               p2 = p1
               p1 = ((2*j-1+a-z)*p2 - (j-1+a)*p3)/j
            end
            pp = (n*p1 - (n+a)*p2)/z
            z1 = z
            z = z1 - p1/pp
            if (abs(z-z1)<.eps) exit
         end

         ENSURE(it<=.maxit,"too many interations")

         .pts(i) = z
         g1 = a+n
         g2 = n
         .wts(i) = -exp(g1.ln_gamma-g2.ln_gamma)/(pp*n*p2)

      end

      if (NOT .fold_wt_fn_in) return

      do i = 1,.n_pts
         z = .pts(i)
         z = z**(-a)*exp(z)
         .wts(i) = .wts(i) * z
      end

   end

   set_Gauss_Legendre :: private, PURE
   ! Set the Gauss-Legendre roots and weights
      self :: INOUT

      i,j,n,m,it :: INT
      p1,p2,p3,pp,x1,x2,xl,xm,z,z1 :: REAL

      .lower_limit = -ONE
      .upper_limit = ONE

      ! Can change these limits and it will still work
      x1 = -ONE ! lower_limit
      x2 = +ONE ! upper_limit

      n = .n_pts
      m = (n+1)/2

      xm = HALF*(x2+x1)
      xl = HALF*(x2-x1)

      do i = 1,m

         z = cos(PI*(i-QUARTER)/(n+HALF))
         it = 0

         do
            it = it + 1
            p1 = ONE
            p2 = ZERO
            do j = 1,n
               p3 = p2
               p2 = p1
               p1 = ((2*j-1)*z*p2 - (j-1)*p3)/j
            end
            pp = n*(z*p1-p2)/(z*z-ONE)
            z1 = z
            z = z1 - p1/pp
            if (abs(z-z1)<.eps) exit
         end

         ENSURE(it<=.maxit,"too many iterations")

         .pts(i)      = xm - xl*z
         .pts(n+1-i)  = xm + xl*z
         .wts(i)     = TWO*xl/((ONE-z*z)*pp*pp)
         .wts(n+1-i) = .wts(i)

      end

   end

   set_Gauss_Hermite :: private, PURE
   ! Set the Gauss-Hermite roots and weights
      self :: INOUT

      i,j,n,m,it :: INT
      pim4,p1,p2,p3,pp,z,z1 :: REAL

      .lower_limit = -huge(ONE)
      .upper_limit =  huge(ONE)


      pim4 = 0.75112554444649425d0
      n = .n_pts
      m = (n+1)/2

      ! Starting guesses (Numerical Recipes, gauher); "z" is carried
      ! across the loop, each root starting from the previous one.
      z = ZERO

      do i = 1,m

         select case (i)
            case (1);     z = sqrt(REALIFY(2*n+1)) - 1.85575d0*(2*n+1)**(-SIXTH)
            case (2);     z = z - 1.14d0*n**0.426d0/z
            case (3);     z = 1.86d0*z - 0.86d0*.pts(1)
            case (4);     z = 1.91d0*z - 0.91d0*.pts(2)
            case default; z = TWO*z - .pts(i-2)
         end

         it = 0
         do 
            it = it + 1
            p1 = pim4
            p2 = ZERO
            do j = 1,n
               p3 = p2
               p2 = p1
               p1 = z*sqrt(TWO/j)*p2 - sqrt(REALIFY(j-1)/REALIFY(j))*p3
            end
            pp = sqrt(TWO*n)*p2
            z1 = z
            z = z1 - p1/pp
            if (abs(z-z1)<.eps) exit
         end

         ENSURE(it<=.maxit,"too many interations")

         .pts(i)      =  z
         .pts(n+1-i)  = -z
         .wts(i)     = TWO/(pp*pp)
         .wts(n+1-i) = .wts(i)

      end

      if (NOT .fold_wt_fn_in) return

      do i = 1,.n_pts
         z = .pts(i)
         z = exp(z*z)
         .wts(i) = .wts(i) * z
      end

   end

   set_Gauss_Jacobi :: private, PURE
   ! Set the Gauss-Jacobi roots and weights
      self :: INOUT

      i,j,n,it :: INT
      al,be,albe,an,bn,a,b,c,r1,r2,r3,p1,p2,p3,pp,z,z1,tmp,g1,g2,g3,g4 :: REAL

      .lower_limit = -ONE
      .upper_limit =  ONE

      al   = .Gauss_Jacobi_alpha
      be   = .Gauss_Jacobi_beta
      albe = al + be

      n = .n_pts

      ! Starting guesses (Numerical Recipes, gaujac); "z" is carried
      ! across the loop, each root starting from the previous one.
      z = ZERO

      do i = 1,n

         if (i==1) then
            an = al/n
            bn = be/n
            r1 = (ONE+al)*(2.78d0/(FOUR+n*n)+0.768d0*an/n)
            r2 = ONE + 1.48d0*an + 0.96d0*bn + 0.452d0*an*an + 0.83d0*an*bn
            z = ONE - r1/r2
         else if (i==2) then
            r1 = (4.1d0+al)/((ONE+al)*(ONE+0.156d0*al))
            r2 = ONE + 0.06d0*(n-EIGHT)*(ONE+0.12d0*al)/n
            r3 = ONE + 0.012d0*be*(ONE+0.25d0*abs(al))/n
            z = z - (ONE-z)*r1*r2*r3
         else if (i==3) then
            r1 = (1.67d0+0.28d0*al)/(ONE+0.37d0*al)
            r2 = ONE + 0.22d0*(n-EIGHT)/n
            r3 = ONE + EIGHT*be/((6.28d0+be)*n*n)
            z = z - (.pts(1)-z)*r1*r2*r3
         else if (i==(n-1)) then
            r1 = (ONE+0.235d0*be)/(0.766d0+0.119d0*be)
            r2 = ONE/(ONE+0.639d0*(n-FOUR)/(ONE+0.71d0*(n-FOUR)))
            r3 = ONE/(ONE+20.0d0*al/((7.5d0+al)*n*n))
            z = z + (z-.pts(n-3))*r1*r2*r3
         else if (i==n) then
            r1 = (ONE+0.37d0*be)/(1.67d0+0.28d0*be)
            r2 = ONE/(ONE+0.22d0*(n-EIGHT)/n)
            r3 = ONE/(ONE+EIGHT*al/((6.28d0+al)*n*n))
            z = z + (z-.pts(n-2))*r1*r2*r3
         else 
            z = THREE*.pts(i-1) - THREE*.pts(i-2) + .pts(i-3)
         end

         it = 0
         do 
            it = it + 1
            tmp = TWO + albe
            p1 = (al-be+tmp*z)/TWO
            p2 = ONE
            do j = 2,n
               p3 = p2
               p2 = p1
               tmp = 2*j + albe
               a = 2*j*(j+albe)*(tmp-TWO)
               b = (tmp-ONE)*(al*al-be*be+tmp*(tmp-TWO)*z)
               c = TWO*(j-1+al)*(j-1+be)*tmp
               p1 = (b*p2-c*p3)/a
            end
            pp = (n*(al-be-tmp*z)*p1 + TWO*(n+al)*(n+be)*p2)/(tmp*(ONE-z*z))
            z1 = z
            z = z1 - p1/pp
            if (abs(z-z1)<.eps) exit
         end

         ENSURE(it<=.maxit,"too many interations")

         .pts(i) =  z
         g1 = al+n
         g2 = be+n
         g3 = n+ONE
         g4 = n+albe+ONE
         .wts(i) = exp(g1.ln_gamma+g2.ln_gamma-g3.ln_gamma-g4.ln_gamma) *tmp*TWO**albe / (pp*p2)

      end

      if (NOT .fold_wt_fn_in) return

      do i = 1,.n_pts
         z = .pts(i)
         z = (1-z)**(-al) * (1+z)**(-be)
         .wts(i) = .wts(i) * z
      end

   end

!  ============================
!  Non-Gauss points and weights
!  ============================

   set_points_and_weights :: leaky, private, PURE
   ! Set the points and weights
      self :: INOUT

   ENSURE(.kind.is_one_of(allowed_kinds([1,2,3,4,10,11,12])),"unrecognized kind, "//trim(.kind))
   ENSURE(.n_pts>0,"must have positive number of points")

      .pts.create(.n_pts)  ! These are the roots
      .wts.create(.n_pts)

      select case (.kind)
      case ("extended_simpson       "); .set_extended_simpson
      case ("extended_trapezoid     "); .set_extended_trapezoid
      case ("open_extended_simpson  "); .set_open_extended_simpson
      case ("open_extended_trapezoid"); .set_open_extended_trapezoid
      case ("open_rectangle         "); .set_open_rectangle
      end

   end

   set_open_rectangle :: private, PURE
   ! Set open rectangle points and weights in the interval [0,1].
      self :: INOUT

   ENSURE(.n_pts>=3,"must at least 1 points")

      i :: INT
      h,h2,r :: REAL

      .lower_limit = ZERO
      .upper_limit = ONE

      h  = ONE/(.n_pts+1)
      h2 = 1.5d0*h

      .wts = h
      .wts(1) = h2
      .wts(.n_pts) = h2

      r = h

      do i = 1,.n_pts
         .pts(i) = r
         r = r + h
      end

   end

   set_extended_trapezoid :: private, PURE
   ! Set extended trapezoid points and weights. The error is (-n h^3
   ! f''(z)/12) where n in the number of points minus one, h is the
   ! point spacing, and z is a number in the integration interval,
   ! which is here [0,1].
      self :: INOUT

   ENSURE(.n_pts>=2,"must at least 2 points")

      i :: INT
      h,h2,r :: REAL

      .lower_limit = ZERO
      .upper_limit = ONE

      h  = ONE/(.n_pts-1)
      h2 = HALF*h

      .wts = h
      .wts(1) = h2
      .wts(.n_pts) = h2

      r = ZERO

      do i = 1,.n_pts
         .pts(i) = r
         r = r + h
      end

   end

   set_open_extended_trapezoid :: private, PURE
   ! Set open extended trapezoid points and weights. Use this if you
   ! know that the function to be quadrated is zero on the endpoints.
   ! The error is (-n h^3 f''(z)/12) where n in the number of points
   ! minus one, h is the point spacing, and z is a number in the
   ! integration interval, which is here [0,1].
      self :: INOUT

   ENSURE(.n_pts>2,"must have greater than 2 points")

      i :: INT
      h,r :: REAL

      .lower_limit = ZERO
      .upper_limit = ONE

      h  = ONE/(.n_pts+1)

      .wts = h

      r = h

      do i = 1,.n_pts
         .pts(i) = r
         r = r + h
      end

   end

   set_extended_simpson :: private, PURE
   ! Set extended Simpson points and weights
   ! The error is (-n h^5 f''''(z)/90) where n in the number of points minus one,
   ! h is the point spacing, and z is a number in the integration interval,
   ! which is here [0,1].
      self :: INOUT

   ENSURE(.n_pts>=5,"must at least 5 points")
   ENSURE(mod(.n_pts,2)==1,"must have odd number of points")

      i :: INT
      h,h2,h3,h4,r :: REAL

      .lower_limit = ZERO
      .upper_limit = ONE

      h3 = THIRD/(.n_pts-1)
      h4 = FOUR*h3
      h2 =  TWO*h3
      h  = THREE*h3

      .wts(1) = h3
      .wts(.n_pts) = h3

      do i = 2,.n_pts-1,2
         .wts(i) = h4
      end

      do i = 3,.n_pts-2,2
         .wts(i) = h2
      end

      r = ZERO
      do i = 1,.n_pts
         .pts(i) = r
         r = r + h
      end

   end

   set_open_extended_simpson :: private, PURE
   ! Set open extended Simpson points and weights: Numerical Recipes
   ! eq. (4.1.20), the fourth-order open formula on n interior points
   ! x_i = i h, h = 1/(n+1), in [0,1]. Exact for cubics; the endpoint
   ! values are never used, so the integrand may be singular there.
      self :: INOUT

   ENSURE(.n_pts>=7,"must have at least 7 points")
   ENSURE(mod(.n_pts,2)==1,"must have odd number of points")

      i,n :: INT
      h,h2,h4,r :: REAL

      .lower_limit = ZERO
      .upper_limit = ONE

      n  = .n_pts
      h  = ONE/(n+1)
      h4 = FOUR*THIRD*h
      h2 = TWO*THIRD*h

      ! End weights, 27/12, 0, 13/12, mirrored at the other end
      .wts(1)   = 2.25d0*h; .wts(n)   = .wts(1)
      .wts(2)   = ZERO;     .wts(n-1) = ZERO
      .wts(3)   = h*13.0d0/12.0d0
      .wts(n-2) = .wts(3)

      ! Interior Simpson alternation 4/3, 2/3, ...
      do i = 4,n-3,2
         .wts(i) = h4
      end

      do i = 5,n-3,2
         .wts(i) = h2
      end

      r = h
      do i = 1,.n_pts
         .pts(i) = r
         r = r + h
      end

   end

!  ==================
!  Quadrature methods
!  ==================

   quadrate(func) result (res)
   ! Quadrate the function "func".
      self :: IN
      interface
         func(x) result (res)
            x :: REAL, IN
            res :: REAL
         end
      end
      res :: REAL

   ENSURE(.n_pts>0,"no points")
   ENSURE(.pts.allocated,"no points")
   ENSURE(.wts.allocated,"no weights")

      i :: INT
      f :: VEC{REAL}@

      f.create(.n_pts)

      do i = 1,.n_pts
         f(i) = func(.pts(i))
      end

      res = sum(.wts*f)

      f.destroy

   end

!  ==========
!  Self-check
!  ==========

   check_rules result (n_failed) :: selfless, public, leaky
   ! Check every rule against integrals known in closed form, print one
   ! line per rule, and return the number of rules that failed. Each
   ! Gauss rule is tested on the moments of its own weight function,
   ! which an n-point rule reproduces exactly up to degree 2n-1; each
   ! Newton-Cotes rule on the polynomials it must integrate exactly.
   ! Driven by run_quadrature (the `quadrature_rules` ctest).
      n_failed :: INT

      q :: QUADRATURE

      n_failed = 0

      stdout.flush
      stdout.text("Quadrature rule exactness (max |error|)")
      stdout.flush

      QUADRATURE::check_legendre(q,8,n_failed)
      QUADRATURE::check_chebyshev_1st(q,8,n_failed)
      QUADRATURE::check_chebyshev_2nd(q,8,n_failed)
      QUADRATURE::check_chebyshev_3rd(q,8,n_failed)
      QUADRATURE::check_laguerre(q,8,n_failed)
      QUADRATURE::check_hermite(q,8,n_failed)
      QUADRATURE::check_jacobi(q,8,n_failed)
      QUADRATURE::check_newton_cotes(q,"open_rectangle          ",1,n_failed)
      QUADRATURE::check_newton_cotes(q,"extended_trapezoid      ",1,n_failed)
      QUADRATURE::check_open_trapezoid(q,n_failed)
      QUADRATURE::check_newton_cotes(q,"extended_simpson        ",3,n_failed)
      QUADRATURE::check_newton_cotes(q,"open_extended_simpson   ",3,n_failed)

      stdout.flush
      stdout.show("Rules failed =",n_failed)

   end

   report_check(name,err,tol,n_failed) :: selfless, private
   ! Print one line and count a failure
      name :: STR, IN
      err,tol :: REAL, IN
      n_failed :: INT, INOUT
      if (err<=tol) then
         stdout.text("  "//trim(name)//" ok    "//err.to_str)
      else
         stdout.text("  "//trim(name)//" FAIL  "//err.to_str)
         n_failed = n_failed + 1
      end
   end

   double_factorial(k) result (res) :: selfless, private, pure
   ! k!! as a REAL, with (-1)!! = 0!! = 1
      k :: INT, IN
      res :: REAL
      i :: INT
      res = ONE
      i = k
      do
         if (i<2) exit
         res = res*i
         i = i - 2
      end
   end

   check_legendre(q,n,n_failed) :: selfless, private, leaky
   ! int_{-1}^{1} x^k dx = 2/(k+1) for even k, 0 for odd k
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err :: REAL
      q.set_kind("gauss_legendre")
      q.set_n_pts(n)
      q.set_quadrature_points
      err = ZERO
      do k = 0,2*n-1
         exact = ZERO
         if (mod(k,2)==0) exact = TWO/(k+1)
         err = max(err,abs(sum(q.wts*q.pts**k)-exact))
      end
      QUADRATURE::report_check("gauss_legendre         ",err,TOL(12),n_failed)
   end

   check_chebyshev_1st(q,n,n_failed) :: selfless, private, leaky
   ! The weights are folded, w_i = (pi/n) sqrt(1-x_i^2); undo the fold and
   ! test int x^k/sqrt(1-x^2) dx = pi (k-1)!!/k!! for even k
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err :: REAL
      q.set_kind("gauss_chebyshev_1st")
      q.set_n_pts(n)
      q.set_quadrature_points
      err = ZERO
      do k = 0,2*n-1
         exact = ZERO
         if (mod(k,2)==0) exact = PI*QUADRATURE::double_factorial(k-1)/QUADRATURE::double_factorial(k)
         err = max(err,abs(sum(q.wts*q.pts**k/sqrt(ONE-q.pts**2))-exact))
      end
      QUADRATURE::report_check("gauss_chebyshev_1st    ",err,TOL(12),n_failed)
   end

   check_chebyshev_2nd(q,n,n_failed) :: selfless, private, leaky
   ! int x^k sqrt(1-x^2) dx = pi (k-1)!!/(k+2)!! for even k
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err :: REAL
      q.set_kind("gauss_chebyshev_2nd")
      q.set_n_pts(n)
      q.set_quadrature_points
      err = ZERO
      do k = 0,2*n-1
         exact = ZERO
         if (mod(k,2)==0) exact = PI*QUADRATURE::double_factorial(k-1)/QUADRATURE::double_factorial(k+2)
         err = max(err,abs(sum(q.wts*q.pts**k*sqrt(ONE-q.pts**2))-exact))
      end
      QUADRATURE::report_check("gauss_chebyshev_2nd    ",err,TOL(12),n_failed)
   end

   check_chebyshev_3rd(q,n,n_failed) :: selfless, private, leaky
   ! int_0^1 x^k sqrt(x/(1-x)) dx = Gamma(k+3/2) Gamma(1/2) / Gamma(k+2)
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err,g1,g2,g3 :: REAL
      q.set_kind("gauss_chebyshev_3rd")
      q.set_n_pts(n)
      q.set_quadrature_points
      err = ZERO
      do k = 0,2*n-1
         g1 = k + 1.5d0
         g2 = HALF
         g3 = k + TWO
         exact = exp(g1.ln_gamma + g2.ln_gamma - g3.ln_gamma)
         err = max(err,abs(sum(q.wts*q.pts**k*sqrt(q.pts/(ONE-q.pts)))-exact))
      end
      QUADRATURE::report_check("gauss_chebyshev_3rd    ",err,TOL(12),n_failed)
   end

   check_laguerre(q,n,n_failed) :: selfless, private, leaky
   ! int_0^inf x^(k+a) e^-x dx = Gamma(k+a+1), a = 1. The folded weights
   ! carry x^-a e^x, so the integrand applied is x^(k+a) e^-x. Relative error.
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      a,exact,err,g :: REAL
      a = ONE
      q.set_kind("gauss_laguerre")
      q.set_n_pts(n)
      q.set_Gauss_Laguerre_alpha(a)
      q.set_quadrature_points
      err = ZERO
      do k = 0,2*n-1
         g = k + a + ONE
         exact = exp(g.ln_gamma)
         err = max(err,abs(sum(q.wts*q.pts**(k+a)*exp(-q.pts))-exact)/exact)
      end
      QUADRATURE::report_check("gauss_laguerre (rel)   ",err,TOL(10),n_failed)
   end

   check_hermite(q,n,n_failed) :: selfless, private, leaky
   ! int x^k e^-x^2 dx = Gamma((k+1)/2) for even k. Relative error, the
   ! moments reaching ~2000.
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err,g :: REAL
      q.set_kind("gauss_hermite")
      q.set_n_pts(n)
      q.set_quadrature_points
      err = ZERO
      do k = 0,2*n-1
         exact = ZERO
         if (mod(k,2)==0) then
            g = HALF*(k+1)
            exact = exp(g.ln_gamma)
         end
         if (mod(k,2)==0) err = max(err,abs(sum(q.wts*q.pts**k*exp(-q.pts**2))-exact)/exact)
      end
      QUADRATURE::report_check("gauss_hermite (rel)    ",err,TOL(10),n_failed)
   end

   check_jacobi(q,n,n_failed) :: selfless, private, leaky
   ! alpha = 1, beta = 2 (unequal on purpose): int x^k (1-x)(1+x)^2 dx for
   ! k = 0..3 is 4/3, 4/15, 4/15, 4/35
      q :: QUADRATURE, INOUT
      n :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err :: REAL
      q.set_kind("gauss_jacobi")
      q.set_n_pts(n)
      q.set_Gauss_Jacobi_alpha(ONE)
      q.set_Gauss_Jacobi_beta(TWO)
      q.set_quadrature_points
      err = ZERO
      do k = 0,3
         select case (k)
         case (0); exact = FOUR/THREE
         case (1); exact = FOUR/15.0d0
         case (2); exact = FOUR/15.0d0
         case (3); exact = FOUR/35.0d0
         end
         err = max(err,abs(sum(q.wts*q.pts**k*(ONE-q.pts)*(ONE+q.pts)**2)-exact))
      end
      QUADRATURE::report_check("gauss_jacobi           ",err,TOL(10),n_failed)
   end

   check_open_trapezoid(q,n_failed) :: selfless, private, leaky
   ! The open trapezoid omits the end points, so it is only right for an
   ! integrand that vanishes there. For f = x(1-x) on 11 points the
   ! Euler-Maclaurin error is exactly h^2/12 (f'(1)-f'(0)) = -h^2/6.
      q :: QUADRATURE, INOUT
      n_failed :: INT, INOUT
      exact,err,h :: REAL
      q.set_kind("open_extended_trapezoid")
      q.set_n_pts(11)
      q.set_quadrature_points
      h = ONE/12.0d0
      exact = ONE/SIX - h*h/SIX
      err = abs(sum(q.wts*q.pts*(ONE-q.pts))-exact)
      QUADRATURE::report_check("open_extended_trapezoid",err,TOL(12),n_failed)
   end

   check_newton_cotes(q,kind,degree,n_failed) :: selfless, private, leaky
   ! int_0^1 x^k dx = 1/(k+1), exact up to "degree", on 11 points
      q :: QUADRATURE, INOUT
      kind :: STR, IN
      degree :: INT, IN
      n_failed :: INT, INOUT
      k :: INT
      exact,err :: REAL
      q.set_kind(kind)
      q.set_n_pts(11)
      q.set_quadrature_points
      err = ZERO
      do k = 0,degree
         exact = ONE/(k+1)
         err = max(err,abs(sum(q.wts*q.pts**k)-exact))
      end
      QUADRATURE::report_check(kind,err,TOL(12),n_failed)
   end

! Test functions

   test_sin(x) result (res) :: selfless, public, pure
   ! Sine function for integrating
      x :: REAL, IN
      res :: REAL

      res = sin(x)

   end

   test_x2(x) result (res) :: selfless, public, pure
   ! x^2 function for integrating
      x :: REAL, IN
      res :: REAL

      res = x*x

   end

   test_x3(x) result (res) :: selfless, public, pure
   ! x^3 function for integrating
      x :: REAL, IN
      res :: REAL

      res = x*x*x

   end

   test_x4(x) result (res) :: selfless, public, pure
   ! x^4 function for integrating
      x :: REAL, IN
      res :: REAL

      res = x*x*x*x

   end

end
