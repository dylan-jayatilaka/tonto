   ENSURE(val>ZERO,"cutoff must be positive")

      .F_calc_cutoff = val

   end

   set_F_pred_cutoff(val) :: PURE
   ! Set the F_pred_cutoff
      self :: INOUT
      val :: REAL, IN

   ENSURE(val>ZERO,"cutoff must be positive")

      .F_pred_cutoff = val

   end

   set_I_pred_cutoff(val) :: PURE
   ! Set the I_pred_cutoff
      self :: INOUT
      val :: REAL, IN

   ENSURE(val>ZERO,"cutoff must be positive")

      .I_pred_cutoff = val

   end

