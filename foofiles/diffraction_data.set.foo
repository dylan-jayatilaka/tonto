module DIFFRACTION_DATA.SET

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part :: leaky, PURE
   ! Erase all pointer information
      self :: INOUT

      ! Reflection related data
      .destroy_reflection_data

      .refine_U_iso_for_atom.destroy
      ! Refinement/fit related data

      .refine_3rd_order_for_atom.destroy
      .refine_4th_order_for_atom.destroy
      .refine_atom_parameters.destroy
      .destroy_fit_data
      .destroy_refinement_data

   end

   destroy_reflection_data :: leaky, PURE
   ! Erase all reflection data
      self :: INOUT

      if (.reflection_data_exists) then

         .scale_factor          =  ONE
         .exp_scale_factor      = -ONE
         .extinction_factor     =  ZERO
         .extinction_factor_esd = -ONE

         .reflection0.destroy
         .unmerged_reflections.destroy
         .reflections.destroy
         .hkl_range.destroy
         .merg_applied = FALSE

         .scale_factors.destroy

      end

   end

   destroy_fit_data :: leaky, PURE
   ! Erase all generated fit arrays
      self :: INOUT

      .fit_table.destroy

      .dX.destroy
      .X_fit.destroy
      .X_fit0.destroy

      .fragment_covariance_mx.destroy
      .correlation_mx.destroy
      .covariance_mx.destroy
      .esd.destroy

   end

   destroy_refinement_data :: leaky, PURE
   ! Erase all generated refinement arrays
      self :: INOUT

      .ref_table.destroy

      .X_ref.destroy
      .X_ref0.destroy

   end

!  ===========
!  Set methods
!  ===========

   set_defaults :: leaky, PURE
   ! Set up a default diffraction_data object
      self :: INOUT

      .destroy_reflection_data

      .destroy_fit_data
      .set_fit_data

      .destroy_refinement_data
      .set_refinement_data

   end

   set_fit_data :: pure
   ! Set the defaults internal variables for a fit
      self :: INOUT
      std  :: DIFFRACTION_DATA

      ! Refinement/fit iteration data
      .fit_iteration           = std.fit_iteration
      .chi2_fit                = std.chi2_fit
      .chi2_fit0               = std.chi2_fit0
      .max_shift               = std.max_shift
      .max_esd                 = std.max_esd
      .max_shift_on_esd        = std.max_shift_on_esd
      .max_shift_on_esd_ind    = std.max_shift_on_esd_ind
      .max_shift_on_esd_par    = std.max_shift_on_esd_par
      .fit_finished            = std.fit_finished
      .fit_converged           = std.fit_converged
      .chi2_increased          = std.chi2_increased
      .too_many_fit_iterations = std.too_many_fit_iterations

      ! Near zero eigenvalues in the least-squares
      .n_0                     = std.n_0
      .near_0                  = std.near_0

   end

   set_refinement_data :: pure
   ! Set the defaults internal variables for a refinement
      self :: INOUT
      std  :: DIFFRACTION_DATA

      ! Refinement/fit iteration data
      .ref_iteration           = std.ref_iteration
      .chi2_ref                = std.chi2_ref
      .chi2_ref0               = std.chi2_ref0
      .max_refshift            = std.max_refshift
      .max_refesd              = std.max_refesd
      .max_refshift_on_esd     = std.max_refshift_on_esd
      .max_refshift_on_esd_ind = std.max_refshift_on_esd_ind
      .max_refshift_on_esd_par = std.max_refshift_on_esd_par
      .refinement_finished     = std.refinement_finished
      .refinement_converged    = std.refinement_converged
      .too_many_ref_iterations = std.too_many_ref_iterations

   end

   set_add_dispersion_to_F_calc(val) :: pure
   ! Set whether to correct dispersion in the refinement by adding the
   ! anomalous dispersion into F_calc and calculating the derivatives
   ! of the dispersion correction.
      self :: INOUT
      val :: BIN, IN
      .add_dispersion_to_F_calc = val
   end

   set_data_kind(val) :: PURE
   ! Read the data kind of crystal experiment
      self :: INOUT
      val :: STR, IN

   ENSURE(val.is_one_of(["x-ray","pnd  "]),"unknown data_kind, "//trim(val))

      .data_kind = val

      .data_kind.to_lower_case

   end

   set_fcf_file_name(val)
   ! Set the name of the fcf file from which to read in a unique set
   ! of reflections.
      self :: INOUT
      val  :: STR, IN

      file :: TEXTFILE

      .fcf_file_name = val

      file.set_name(val)
      DIE_IF(NOT file.exists,"the specified fcf file does not exist")

   end

   set_fit_structure(val) :: pure
   ! Set whether to rigid-fit the structure
      self :: INOUT
      val :: BIN, IN

      .fit_structure = val

      ! If fitting, you can't be refining
      if (NOT val) .refine_structure = NOT val

   end

   set_max_shift_on_esd(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.max_shift_on_esd), pure
   ! Generic set
   end

   set_max_shift_on_esd_par(val) :: get_from(OBJECT:set, VAL_TYPE?=>STR, ARG?=>.max_shift_on_esd_par), pure
   ! Generic set
   end

   set_max_refshift_on_esd(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.max_refshift_on_esd), pure
   ! Generic set
   end

   set_max_refshift_on_esd_par(val) :: get_from(OBJECT:set, VAL_TYPE?=>STR, ARG?=>.max_refshift_on_esd_par), pure
   ! Generic set
   end

   set_n_data_sets(val) :: PURE
   ! Set the number of data sets in a multiple-data-set refinement.
      self :: INOUT
      val :: INT, IN

   ENSURE(val>1,"n_data_sets must be non negative")

      .n_data_sets = val

   end

   set_n_param(val) :: PURE
   ! Set the number of paramters in the model "by hand"
      self :: INOUT
      val :: INT, IN

   ENSURE(val>1,"n_param must be non negative")

      .n_param = val
      .n_param_manually_set = TRUE

   end

   set_n_worst_reflections(val) :: pure
   ! Set the no. of worst reflections to show
      self :: INOUT
      val :: INT, IN
      .n_worst_reflections = val
   end

   set_partition_model(val) :: PURE
   ! Read the partition model to use to calculate the structure
   ! factors. So far, only "oc-hirshfeld" and "oc-tanaka" correspond
   ! to one-center atom-based partioning. The others are two-center
   ! basis-function-based partitionings which use all parts of the
   ! fragment density matrix (with 'repetition factors') to calculate
   ! the structure factors, and these two-center may not be used for
   ! geometric structure refinement.
      self :: INOUT
      val  :: STR, IN

      options :: VEC{STR}@

      options = [ "oc-crystal23  ", &
                  "crystal23     ", &
                  "oc-observed   ", &
                  "observed      ", &
                  "oc-g-hirshfeld", &
                  "g-hirshfeld   ", &
                  "oc-hirshfeld  ", &
                  "hirshfeld     ", &
                  "oc-g-salvador ", &
                  "g-salvador    ", &
                  "oc-salvador   ", &
                  "salvador      ", &
                  "tfva          ", &
                  "oc-sph-tfva   ", &
                  "sph-tfva      ", &
                  "tc-stewart    ", &
                  "tc-tanaka     "  ]
                  
   ENSURE(val.is_one_of(options),"unknown partition_model, "//trim(val))

      .partition_model = val
      .partition_model.to_lower_case

      ! Rename to standard form
      select case( .partition_model)
      case ("crystal23  "); .partition_model = "oc-crystal23"
      case ("observed   "); .partition_model = "oc-observed"
      case ("g-hirshfeld"); .partition_model = "oc-g-hirshfeld"
      case ("hirshfeld  "); .partition_model = "oc-hirshfeld"
      case ("g-salvador "); .partition_model = "oc-g-salvador"
      case ("salvador   "); .partition_model = "oc-salvador"
      case ("tfva       "); .partition_model = "oc-salvador"
      case ("sph-tfva   "); .partition_model = "oc-sph-tfva"
      end

      ! One-center partitions go with one-center TF models
      ! NOTE: for crystal23 density matrices it is assuned you are 
      ! doing an atom-based i.e. OC model
   ! if (.partition_model(1:3)=="oc-") &
    !    .set_temperature_factor_model("atom-based")

   end

   set_observed_density_shrinkage(val) :: PURE
   ! Set the fraction of robust residual density added to the IAM prior.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>=ZERO AND val<ONE,"observed_density_shrinkage must be in [0,1)")

      .observed_density_shrinkage = val

   end

   set_observed_density_min_TF(val) :: PURE
   ! Set the floor used when removing harmonic thermal motion.
      self :: INOUT
      val  :: REAL, IN

   ENSURE(val>ZERO AND val<=ONE,"observed_density_min_TF must be in (0,1]")

      .observed_density_min_TF = val

   end

   set_observed_density_zero_phase_sign(val) :: PURE
   ! Set an explicit sign hypothesis for a zero model phase.
      self :: INOUT
      val  :: INT, IN

   ENSURE(val==-1 OR val==0 OR val==1,"observed_density_zero_phase_sign must be -1, 0, or 1")

      .observed_density_zero_phase_sign = val

   end

   set_stockholder_model(val) :: PURE
   ! Set the Hirshfeld stockholder denominator used when the partition
   ! model is oc-crystal23. The source of the density and the way the
   ! partition is built are independent choices.
      self :: INOUT
      val  :: STR, IN

      options :: VEC{STR}@

      options = [ "cluster ", &
                  "periodic"  ]

   ENSURE(val.is_one_of(options),"unknown stockholder_model, "//trim(val))

      .stockholder_model = val
      .stockholder_model.to_lower_case

   end

   set_max_iterations(val) :: get_from(OBJECT:set, VAL_TYPE?=>INT, ARG?=>.max_iterations), pure
   ! Set the maximum number of iterations, for BOTH loops -- it caps
   ! .too_many_fit_iterations and .too_many_ref_iterations alike.
   !
   ! There was a `max_iterations=` keyword but no setter, so an argv-driven
   ! program could not bound a run at all. Callers must validate: the keyword
   ! reader's `max_iterations > min_iterations` check is an ENSURE and so
   ! compiles away in an optimised build.
   end

   set_do_residual_cube(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.do_residual_cube), pure
   ! Set whether to write a residual-density cube at the end of a refinement.
   ! There was a `do_residual_cube=` keyword but no setter, so a program driven
   ! by argv rather than a job file had no way to turn it off -- and the cube is
   ! the largest thing a refinement writes (9 MB for a dipeptide).
   end

   set_refine_extinction(val) :: pure
   ! Set whether to correct extinction or not according to the Larson formula
      self :: INOUT
      val :: BIN, IN
      .refine_extinction = val
      if (NOT val) .extinction_factor_esd = -ONE
   end

   set_extinction_factor(val,esd) :: PURE
   ! Set the secondary extinction factor, and its error "esd" if that is
   ! given. Without an esd the stored one is marked unavailable.
      self :: INOUT
      val :: REAL, IN
      esd :: REAL, optional, IN

   ENSURE(val>=ZERO,"negative extinction factor")

      .extinction_factor = val

      .extinction_factor_esd = -ONE
      if (present(esd)) .extinction_factor_esd = esd

   end

   set_refine_fragments(val) :: pure
   ! Set whether to refine fragments
      self :: INOUT
      val :: BIN, IN

      .refine_fragments = val

      ! If refining you can't be fitting
      if (val) .fit_structure = NOT val

   end

   set_refine_structure(val) :: pure
   ! Set whether to refine the structure
      self :: INOUT
      val :: BIN, IN

      .refine_structure = val

      ! If refining you can't be fitting
      if (val) .fit_structure = NOT val

   end

   set_refine_H_positions(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.refine_H_positions), pure
   ! Generic set
   end

   set_refine_H_ADPs(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.refine_H_ADPs), pure
   ! Generic set
   end

   set_refine_H_U_iso(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.refine_H_U_iso), pure
   ! Generic set
   end

   set_refine_4th_order(val) :: leaky, PURE
   ! Read the list of atoms for which fourth-order anharmonicty
   ! parameters are to be refined.
      self :: INOUT
      val :: VEC{STR}, IN

      .refine_4th_order_for_atom = val

      .refine_anharmonicity = TRUE

   end

   set_refine_4th_order_only(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.refine_4th_order_only), pure
   ! Generic set
   end

   set_refine_anharmonicity(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.refine_anharmonicity), pure
   ! Generic set
   end

   set_restart_HAR_with_promolecule(val) :: PURE
   ! Set whether to restart HAR with promolecule every time.
      self :: INOUT
      val :: BIN, IN
      .restart_HAR_with_promolecule = val
   end

   set_remove_disp_from_F_exp(val) :: pure
   ! Set whether to correct dispersion in the refinement by removing
   ! the anomalous dispersion from F_exp. This is an "XD_style"
   ! dispersion correction.
      self :: INOUT
      val :: BIN, IN
      .remove_dispersion_from_F_exp = val
   end

!   set_temperature_factor_model(val) :: PURE
!   ! Read the temperature factor model to use to correct for thermal
!   ! vibration in the calculated structure factors. Use "atom-based"
!   ! or "one-center" for usual ADP based model. Use "none" for static
!   ! structure factors. The remaining options are different
!   ! two-center models, see Jayatilaka & Grimwood (2001) Acta Cryst A.
!   ! NOTE: .partition_model subsumes this ....
!      self :: INOUT
!      val :: STR, IN
!
!   ENSURE(val.is_one_of(["none      ","one-center","atom-based","tc-coppens","tc-stewart","tc-tanaka "]),"unknown data_kind, "//trim(val))
!
!      .temperature_factor_model = val
!      .temperature_factor_model.to_lower_case
!
!   end

   set_wavelength(val)
   ! Read the experimental wavelength
      self :: INOUT
      val :: REAL, IN
      .wavelength = val
   end

   set_XCW(val) :: PURE
   ! Set if doing an XCW calculation - needed for calculating
   ! n_param, which is incremented by 1 for lambda.
      self :: INOUT
      val :: BIN, IN
      .XCW = val
   end

!  Cutoffs

   set_F_sigma_noise(val) :: PURE
   ! Set noise to add to F_exp and F_sigma, in units of F_sigma.
      self :: INOUT
      val :: REAL, IN
      .F_sigma_noise = val
   end

   set_F_sigma_cutoff(val) :: PURE
   ! Set the minimum acceptable value for F_exp/sigma
   ! NOTE: make sure zero is not entered ... just leave it off!
      self :: INOUT
      val :: REAL, IN

   ENSURE(val>ZERO,"cutoff must be positive")

      .F_sigma_cutoff = val

   end

   set_I_sigma_cutoff(val) :: PURE
   ! Set the minimum acceptable value for F2_exp/sigma
      self :: INOUT
      val :: REAL, IN

   ENSURE(val>ZERO,"cutoff must be positive")

      .I_sigma_cutoff = val

   end

   set_F_z_cutoff(val) :: PURE
   ! Set the F_z_cutoff (in sigma units) for prune_bad_reflections
