      val :: REAL, IN

   ENSURE(val>ZERO,"cutoff must be positive")

      .F_z_cutoff = val

   end

   set_I_z_cutoff(val) :: PURE
   ! Set the I_z_cutoff (in sigma units) for prune_bad_reflections
