!=================================================================
!
! XC_POTENTIAL:
!
! The outputs of a density functional on one batch of grid points: the
! energy per particle, the derivative "v_rho" of the functional with
! respect to the density of each spin channel, and for a gradient
! functional the vector "v_grad" which is contracted with the gradient of
! a basis function pair to give a matrix element of the potential. See
! DFT_FUNCTIONAL:new_r_potential and new_u_potential for the definitions.
! The arrays are laid out as those of XC_DENSITY.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!==================================================================

module XC_POTENTIAL

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   create_grids(den) :: leaky, PURE
   ! Allocate the arrays to match the densities "den" and set them to zero.
      self :: INOUT
      den :: XC_DENSITY, IN

      .destroy_ptr_part

      .energy.create(den.n_pt)
      .energy = ZERO
      .v_rho.create(den.n_pt,den.n_spin)
      .v_rho = ZERO
      if (den.has_gradient) then
         .v_grad.create(den.n_pt,3,den.n_spin)
         .v_grad = ZERO
      end

   end

   destroy_ptr_part :: leaky, PURE
   ! Deallocate the arrays
      self :: INOUT

      if (.v_grad.allocated) .v_grad.destroy
      if (.v_rho.allocated)  .v_rho.destroy
      if (.energy.allocated) .energy.destroy

   end

!  ===========
!  Set methods
!  ===========

   set_defaults :: leaky, PURE
   ! Set up defaults: no arrays
      self :: INOUT

      .destroy_ptr_part

   end

!  =======
!  Weights
!  =======

   multiply_by(wt) :: PURE
   ! Multiply the energy per particle and the potentials at each grid point
   ! by the quadrature weight "wt" of that point.
      self :: INOUT
      wt :: VEC{REAL}, IN

   ENSURE(wt.dim==.energy.dim,"wrong number of weights")

      s,k :: INT

      .energy = wt*.energy
      do s = 1,.v_rho.dim2
         .v_rho(:,s) = wt*.v_rho(:,s)
      end
      if (.v_grad.allocated) then
         do s = 1,.v_grad.dim3
            do k = 1,3
               .v_grad(:,k,s) = wt*.v_grad(:,k,s)
            end
         end
      end

   end

end
