contains

! ==========
! Allocation
! ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

! ============================================
! Set n_pts or polynomial order t to integrate
! ============================================

! Call one or the other

   set_n_pts(n_pts) :: leaky, PURE
   ! Set the number of points. If it is not one of the allowed number
   ! of points, it *increases* to the nearest number which is allowed.
      self  :: INOUT
      n_pts :: INT, IN

   ENSURE(n_pts>0,   "n_pts must be +ve")
   ENSURE(n_pts<1773,"n_pts must be less than 1773")

      select case (n_pts)
      case (   1:   2); .t=  1; .pts=ss00100002
      case (   3:   6); .t=  3; .pts=ss00300006
      case (   7:  12); .t=  5; .pts=ss00500012
      case (  13:  32); .t=  7; .pts=ss00700032
      case (  33:  48); .t=  9; .pts=ss00900048
      case (  49:  70); .t= 11; .pts=ss01100070
      case (  71:  94); .t= 13; .pts=ss01300094
      case (  95: 120); .t= 15; .pts=ss01500120
      case ( 121: 156); .t= 17; .pts=ss01700156
      case ( 157: 192); .t= 19; .pts=ss01900192
      case ( 193: 234); .t= 21; .pts=ss02100234
      case ( 235: 278); .t= 23; .pts=ss02300278
      case ( 279: 328); .t= 25; .pts=ss02500328
      case ( 329: 380); .t= 27; .pts=ss02700380
      case ( 381: 438); .t= 29; .pts=ss02900438
      case ( 439: 498); .t= 31; .pts=ss03100498
      case ( 499: 564); .t= 33; .pts=ss03300564
      case ( 565: 632); .t= 35; .pts=ss03500632
      case ( 633: 706); .t= 37; .pts=ss03700706
      case ( 707: 782); .t= 39; .pts=ss03900782
      case ( 783: 864); .t= 41; .pts=ss04100864
      case ( 865: 948); .t= 43; .pts=ss04300948
      case ( 949:1038); .t= 45; .pts=ss04501038
      case (1039:1130); .t= 47; .pts=ss04701130
      case (1131:1228); .t= 49; .pts=ss04901228
      case (1229:1328); .t= 51; .pts=ss05101328
      case (1329:1434); .t= 53; .pts=ss05301434
      case (1435:1542); .t= 55; .pts=ss05501542
      case (1543:1656); .t= 57; .pts=ss05701656
      case (1657:1772); .t= 59; .pts=ss05901772
      end

      .n_pts = .pts.dim2

   end

   set_t(t) :: leaky, PURE
   ! Set the order "t" of the polynomial to integrate exactly.  
   ! If the it is not allowed the value used is the next largest 
   ! one which is allowed.
      self :: INOUT
      t    :: INT, IN

   ENSURE(t>0, "t must be +ve")
   ENSURE(t<60,"t must be less than 60")

      select case (t)
      case (   1:   1); .t=  1; .pts=ss00100002
      case (   2:   3); .t=  3; .pts=ss00300006
      case (   4:   5); .t=  5; .pts=ss00500012
      case (   6:   7); .t=  7; .pts=ss00700032
      case (   8:   9); .t=  9; .pts=ss00900048
      case (  10:  11); .t= 11; .pts=ss01100070
      case (  12:  13); .t= 13; .pts=ss01300094
      case (  14:  15); .t= 15; .pts=ss01500120
      case (  16:  17); .t= 17; .pts=ss01700156
      case (  18:  19); .t= 19; .pts=ss01900192
      case (  20:  21); .t= 21; .pts=ss02100234
      case (  22:  23); .t= 23; .pts=ss02300278
      case (  24:  25); .t= 25; .pts=ss02500328
      case (  26:  27); .t= 27; .pts=ss02700380
      case (  28:  29); .t= 29; .pts=ss02900438
      case (  30:  31); .t= 31; .pts=ss03100498
      case (  32:  33); .t= 33; .pts=ss03300564
      case (  34:  35); .t= 35; .pts=ss03500632
      case (  36:  37); .t= 37; .pts=ss03700706
      case (  38:  39); .t= 39; .pts=ss03900782
      case (  40:  41); .t= 41; .pts=ss04100864
      case (  42:  43); .t= 43; .pts=ss04300948
      case (  44:  45); .t= 45; .pts=ss04501038
      case (  46:  47); .t= 47; .pts=ss04701130
      case (  48:  49); .t= 49; .pts=ss04901228
      case (  50:  51); .t= 51; .pts=ss05101328
      case (  52:  53); .t= 53; .pts=ss05301434
      case (  54:  55); .t= 55; .pts=ss05501542
      case (  56:  57); .t= 57; .pts=ss05701656
      case (  58:  59); .t= 59; .pts=ss05901772
      end

      .n_pts = .pts.dim2

   end

   put
   ! Put out basic info
      self :: IN

      stdout.flush
      stdout.text("==================")
      stdout.text("Womersley t-design")
      stdout.text("==================")
      stdout.flush
      stdout.text(". For anguklar integration with unit weights")
      stdout.flush
      stdout.text(". See web.maths.unsw.edu.au/~rsw/Sphere/EffSphDes/ss.html")

      stdout.flush
      stdout.show("t     =",.t)
      stdout.show("n_pts =",.n_pts)

      stdout.flush
      stdout.text("pts:")
      stdout.put(.pts)

   end

end
