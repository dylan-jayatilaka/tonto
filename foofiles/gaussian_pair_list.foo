!=====================================================================
!
! GAUSSIAN_PAIR_LIST :
!
! The primitive gaussian pairs of a molecule's basis that survive the
! pair cutoff, stored flat and grouped by (l_max,l_min) class. Built
! once per geometry; the two-electron kernels loop over two class
! blocks at a time, with no per-quartet set-up.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!=====================================================================

module GAUSSIAN_PAIR_LIST

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   set_sizes(n_pairs,n_classes) :: leaky, PURE
   ! Allocate the pair and class arrays for "n_pairs" pairs and
   ! "n_classes" classes.
      self :: INOUT
      n_pairs,n_classes :: INT, IN

      .n_pairs = n_pairs
      .n_classes = n_classes

      .class_first.create(n_classes)
      .class_last.create(n_classes)
      .class_l_sum.create(n_classes)
      .class_first_gaussian.create(n_classes)
      .class_n_gaussian.create(n_classes)
      .class_first = 1
      .class_last = 0
      .class_l_sum = 0
      .class_first_gaussian = 1
      .class_n_gaussian = 1

      .shell_pair.create(n_pairs)
      .factor.create(n_pairs)
      .exponent_sum.create(n_pairs)
      .exponent_inv.create(n_pairs)
      .prefactor.create(n_pairs)
      .center.create(3,n_pairs)
      .center_diff.create(3,n_pairs)

   end

!  ========
!  J kernel
!  ========

   add_to_J(JJ,PP,cutoff,I_max,P_max) :: PURE
   ! Add to the transfer-space coulomb vectors "JJ" the contribution of
   ! every primitive quartet, contracting at once with the transfer-space
   ! density "PP". Each unordered pair of primitive pairs is visited once.
   ! A pair of pairs is skipped when its Schwarz bound times the largest
   ! density element "P_max" of either shell pair is below "cutoff". The
   ! bound of a pair is the AO bound "I_max" of its shell pair, sqrt of
   ! the largest (ab|ab), scaled by the pair's share of the largest
   ! transfer-space bound in that shell pair; the transfer coefficients
   ! are common to a shell pair's primitives, but transfer-space values
   ! alone do not bound AO contributions. Within each
   ! class the pairs are taken by decreasing bound, so the inner loop stops
   ! at the first pair that fails against the class's largest density. The
   ! survivors for one "k" are done in batches of at most "batch_max"
   ! (partner,root) entries, see add_batch_to_J.
      self :: IN
      JJ :: VEC{EVEC{REAL}}, INOUT
      PP :: VEC{EVEC{REAL}}, IN
      cutoff :: REAL, IN
      I_max,P_max :: VEC{REAL}, IN

      batch_max :: INT, parameter = 256

      Ix,Iy,Iz :: MAT3{REAL}@
      rt,wt,Pg,fvp :: MAT{REAL}@
      ev,Q,Qc,Q_sp,class_P_max,xv,C00x,C00y,C00z,D00x,D00y,D00z,B10,B01,B00,W :: VEC{REAL}@
      nxe,nye,nze,nxf,nyf,nzf,order,idx,jv :: VEC{INT}@
      rys :: RYS
      A,B,k,j,k_pos,j_pos,j_last,sp_k,n_e,n_f,fe,ff,e,f,n,n_roots,l_e,l_f,l_max :: INT
      m,i,n_big,first,last,chunk,c0,mc :: INT
      zeta,eta,QPx,QPy,QPz,Qk,Pk,bound :: REAL

      l_max = maxval(.class_l_sum)
      Ix.create(batch_max,l_max+1,l_max+1)
      Iy.create(batch_max,l_max+1,l_max+1)
      Iz.create(batch_max,l_max+1,l_max+1)
      n = maxval(.class_n_gaussian)
      ev.create(n)
      Pg.create(batch_max,n)
      fvp.create(batch_max,n)
      nxe.create(n); nye.create(n); nze.create(n)
      nxf.create(n); nyf.create(n); nzf.create(n)
      C00x.create(batch_max); C00y.create(batch_max); C00z.create(batch_max)
      D00x.create(batch_max); D00y.create(batch_max); D00z.create(batch_max)
      B10.create(batch_max); B01.create(batch_max); B00.create(batch_max)
      W.create(batch_max)

      class_P_max.create(.n_classes)
      class_P_max = ZERO

      ! Schwarz bound of each pair; each class's pairs by decreasing bound
      Q.create(.n_pairs)
      .make_Schwarz_bounds(Q)
      Q_sp.create(size(I_max))
      Q_sp = ZERO
      do k = 1,.n_pairs
         sp_k = .shell_pair(k)
         Q_sp(sp_k) = max(Q_sp(sp_k),Q(k))
      end
      do k = 1,.n_pairs
         sp_k = .shell_pair(k)
         if (Q_sp(sp_k)>ZERO) Q(k) = I_max(sp_k)*Q(k)/Q_sp(sp_k)
      end
      order.create(.n_pairs)
      n_big = max(maxval(.class_last-.class_first+1),1)
      idx.create(n_big)
      jv.create(n_big)
      xv.create(n_big)
      do A = 1,.n_classes
         first = .class_first(A)
         last  = .class_last(A)
         if (last<first) cycle
         Qc.create(last-first+1)
         Qc = Q(first:last)
         Qc.quick_sort(idx(1:last-first+1),decreasing_order=TRUE)
         order(first:last) = first - 1 + idx(1:last-first+1)
         Qc.destroy
         class_P_max(A) = maxval(P_max(.shell_pair(first:last)))
      end

      do A = 1,.n_classes

         if (.class_last(A)<.class_first(A)) cycle

         l_e = .class_l_sum(A)
         n_e = .class_n_gaussian(A)
         fe  = .class_first_gaussian(A) - 1
         do e = 1,n_e
            nxe(e) = GAUSSIAN_DATA::nx(fe+e)
            nye(e) = GAUSSIAN_DATA::ny(fe+e)
            nze(e) = GAUSSIAN_DATA::nz(fe+e)
         end

         do B = 1,A

            if (.class_last(B)<.class_first(B)) cycle

            l_f = .class_l_sum(B)
            n_f = .class_n_gaussian(B)
            ff  = .class_first_gaussian(B) - 1
            do f = 1,n_f
               nxf(f) = GAUSSIAN_DATA::nx(ff+f)
               nyf(f) = GAUSSIAN_DATA::ny(ff+f)
               nzf(f) = GAUSSIAN_DATA::nz(ff+f)
            end

            n_roots = (l_e+l_f+2)/2
            rys.set_n_roots(n_roots)
            chunk = max(batch_max/n_roots,1)
            rt.destroy; wt.destroy
            rt.create(n_roots,chunk)
            wt.create(n_roots,chunk)

            do k_pos = .class_first(A),.class_last(A)

               k = order(k_pos)
               sp_k = .shell_pair(k)
               Qk = Q(k)
               Pk = P_max(sp_k)

               ! The largest bound in class B fails: so does every other
               if (Qk*Q(order(.class_first(B)))*max(Pk,class_P_max(B))<cutoff) cycle

               zeta = .exponent_sum(k)

               j_last = .class_last(B)
               if (A==B) j_last = k_pos

               ! Gather the surviving partners and their X
               m = 0
               do j_pos = .class_first(B),j_last
                  j = order(j_pos)
                  bound = Qk*Q(j)
                  if (bound*max(Pk,class_P_max(B))<cutoff) exit
                  if (bound*max(Pk,P_max(.shell_pair(j)))<cutoff) cycle
                  m = m + 1
                  jv(m) = j
                  eta = .exponent_sum(j)
                  QPx = .center(1,j) - .center(1,k)
                  QPy = .center(2,j) - .center(2,k)
                  QPz = .center(3,j) - .center(3,k)
                  xv(m) = zeta*eta/(zeta+eta)*(QPx*QPx + QPy*QPy + QPz*QPz)
               end

               do c0 = 1,m,chunk
                  mc = min(chunk,m-c0+1)
                  rys.get_weights_t2(mc,xv(c0:c0+mc-1),rt,wt)
                  .add_batch_to_J(JJ,PP,k,jv(c0:c0+mc-1),mc,n_roots,mc*n_roots, &
                     l_e,l_f,n_e,n_f,nxe,nye,nze,nxf,nyf,nzf,rt,wt,Ix,Iy,Iz, &
                     C00x,C00y,C00z,D00x,D00y,D00z,B10,B01,B00,W,Pg,fvp,ev)
               end

            end

         end
      end

   end

   add_batch_to_J(JJ,PP,k,jv,m,n_roots,n_p,l_e,l_f,n_e,n_f,nxe,nye,nze,nxf,nyf,nzf,rt,wt,Ix,Iy,Iz,C00x,C00y,C00z,D00x,D00y,D00z,B10,B01,B00,W,Pg,fvp,ev) :: private, PURE
   ! Add to "JJ" the quartets of pair "k" with the "m" pairs "jv", whose
   ! roots and weights are "rt" and "wt". Each (partner,root) is one entry
   ! p of n_p = m*n_roots, and every array is laid out with p first, so the
   ! 2D recursions and the contraction run down contiguous columns. The
   ! work arrays are explicit-shape views of the caller's buffers.
      self :: IN
      JJ :: VEC{EVEC{REAL}}, INOUT
      PP :: VEC{EVEC{REAL}}, IN
      k,m,n_roots,n_p,l_e,l_f,n_e,n_f :: INT, IN
      jv :: VEC{INT}(m), IN
      nxe,nye,nze :: VEC{INT}(*), IN
      nxf,nyf,nzf :: VEC{INT}(*), IN
      rt,wt :: MAT{REAL}(n_roots,m), IN
      Ix,Iy,Iz :: MAT3{REAL}(n_p,l_e+1,l_f+1), INOUT
      C00x,C00y,C00z,D00x,D00y,D00z,B10,B01,B00,W :: VEC{REAL}(n_p), INOUT
      Pg,fvp :: MAT{REAL}(n_p,n_f), INOUT
      ev :: VEC{REAL}(n_e), INOUT

      i,j,n,p,e,f,sp_k,sp_j,xe,ye,ze,xf,yf,zf :: INT
      zeta,eta,zinv,einv,rho,rho_zinv,rho_einv,half_zinv,half_einv :: REAL
      PAx,PAy,PAz,QCx,QCy,QCz,QPx,QPy,QPz,cc,t2,t2_rz,t2_re,t,s,pk,fac :: REAL

      sp_k = .shell_pair(k)
      zeta = .exponent_sum(k)
      zinv = .exponent_inv(k)
      half_zinv = HALF*zinv
      PAx = .center_diff(1,k)
      PAy = .center_diff(2,k)
      PAz = .center_diff(3,k)

      ! Recursion coefficients, weight and cd density for each entry
      p = 0
      do i = 1,m
         j = jv(i)
         sp_j = .shell_pair(j)
         eta  = .exponent_sum(j)
         einv = .exponent_inv(j)
         half_einv = HALF*einv
         QCx = .center_diff(1,j)
         QCy = .center_diff(2,j)
         QCz = .center_diff(3,j)
         QPx = .center(1,j) - .center(1,k)
         QPy = .center(2,j) - .center(2,k)
         QPz = .center(3,j) - .center(3,k)
         rho = zeta*eta/(zeta+eta)
         rho_zinv = rho*zinv
         rho_einv = rho*einv
         cc = TWOPI5ON2*.prefactor(k)*.prefactor(j)*sqrt(rho)*.factor(j)
         do n = 1,n_roots
            p = p + 1
            t2 = rt(n,i)
            t2_rz = t2*rho_zinv
            t2_re = t2*rho_einv
            C00x(p) = PAx + t2_rz*QPx
            C00y(p) = PAy + t2_rz*QPy
            C00z(p) = PAz + t2_rz*QPz
            D00x(p) = QCx - t2_re*QPx
            D00y(p) = QCy - t2_re*QPy
            D00z(p) = QCz - t2_re*QPz
            B10(p) = (ONE - t2_rz)*half_zinv
            B01(p) = (ONE - t2_re)*half_einv
            B00(p) = t2_rz*half_einv
            W(p) = cc*wt(n,i)
         end
      end
      do f = 1,n_f
         p = 0
         do i = 1,m
            t = PP(.shell_pair(jv(i))).element(f)
            do n = 1,n_roots
               p = p + 1
               Pg(p,f) = t
            end
         end
      end

      GAUSSIAN_PAIR_LIST::make_2d_batch(Ix,n_p,l_e,l_f,C00x,D00x,B10,B01,B00)
      GAUSSIAN_PAIR_LIST::make_2d_batch(Iy,n_p,l_e,l_f,C00y,D00y,B10,B01,B00)
      GAUSSIAN_PAIR_LIST::make_2d_batch(Iz,n_p,l_e,l_f,C00z,D00z,B10,B01,B00)
      do f = 1,l_f+1
      do e = 1,l_e+1
         do p = 1,n_p
            Iz(p,e,f) = Iz(p,e,f)*W(p)
         end
      end
      end

      ! Contract: ab side with the cd density, cd side with the ab density
      ev = ZERO
      fvp = ZERO
      do f = 1,n_f
         xf = nxf(f); yf = nyf(f); zf = nzf(f)
         do e = 1,n_e
            xe = nxe(e); ye = nye(e); ze = nze(e)
            pk = PP(sp_k).element(e)
            s = ZERO
            do p = 1,n_p
               t = Ix(p,xe,xf)*Iy(p,ye,yf)*Iz(p,ze,zf)
               s = s + t*Pg(p,f)
               fvp(p,f) = fvp(p,f) + t*pk
            end
            ev(e) = ev(e) + s
         end
      end

      fac = .factor(k)
      JJ(sp_k).element(1:n_e) = JJ(sp_k).element(1:n_e) + fac*ev
      p = 0
      do i = 1,m
         j = jv(i)
         if (j==k) then
            p = p + n_roots
            cycle
         end
         sp_j = .shell_pair(j)
         do n = 1,n_roots
            p = p + 1
            JJ(sp_j).element(1:n_f) = JJ(sp_j).element(1:n_f) + fac*fvp(p,1:n_f)
         end
      end

   end

   make_2d_batch(I,n_p,l_e,l_f,C00,D00,B10,B01,B00) :: selfless, private, PURE
   ! Make the 2D Rys integrals "I(p,e+1,f+1)", e<=l_e, f<=l_f, for one
   ! cartesian direction and all n_p entries p, by the vertical recursions.
      n_p,l_e,l_f :: INT, IN
      I :: MAT3{REAL}(n_p,l_e+1,l_f+1), INOUT
      C00,D00,B10,B01,B00 :: VEC{REAL}(n_p), IN

      p,e,f :: INT

      do p = 1,n_p
         I(p,1,1) = ONE
      end
      if (l_e>0) then
         do p = 1,n_p
            I(p,2,1) = C00(p)
         end
      end
      do e = 2,l_e
         do p = 1,n_p
            I(p,e+1,1) = C00(p)*I(p,e,1) + (e-1)*B10(p)*I(p,e-1,1)
         end
      end

      do f = 1,l_f
         if (f==1) then
            do p = 1,n_p
               I(p,1,2) = D00(p)
            end
         else
            do p = 1,n_p
               I(p,1,f+1) = D00(p)*I(p,1,f) + (f-1)*B01(p)*I(p,1,f-1)
            end
         end
         if (l_e>0) then
            do p = 1,n_p
               I(p,2,f+1) = C00(p)*I(p,1,f+1) + f*B00(p)*I(p,1,f)
            end
         end
         do e = 2,l_e
            do p = 1,n_p
               I(p,e+1,f+1) = C00(p)*I(p,e,f+1) + (e-1)*B10(p)*I(p,e-1,f+1) + f*B00(p)*I(p,e,f)
            end
         end
      end

   end

   make_Schwarz_bounds(Q) :: PURE
   ! Set "Q(k)" to the square root of the largest diagonal integral
   ! (e_k|e_k) of pair "k" over its (es| components, so that every
   ! (e_k|f_j) is bounded by Q(k)*Q(j).
      self :: IN
      Q :: VEC{REAL}(.n_pairs), OUT

      Ix,Iy,Iz :: MAT{REAL}@
      nxe,nye,nze :: VEC{INT}@
      rys :: RYS
      A,k,e,n,n_e,fe,l_e,l_max :: INT
      diag :: VEC{REAL}@
      zinv,half_zinv,t2_rz,B10,B00,cc :: REAL

      l_max = maxval(.class_l_sum)
      Ix.create(l_max+1,l_max+1)
      Iy.create(l_max+1,l_max+1)
      Iz.create(l_max+1,l_max+1)
      n = maxval(.class_n_gaussian)
      nxe.create(n); nye.create(n); nze.create(n)
      diag.create(n)

      do A = 1,.n_classes

         if (.class_last(A)<.class_first(A)) cycle

         l_e = .class_l_sum(A)
         n_e = .class_n_gaussian(A)
         fe  = .class_first_gaussian(A) - 1
         do e = 1,n_e
            nxe(e) = GAUSSIAN_DATA::nx(fe+e)
            nye(e) = GAUSSIAN_DATA::ny(fe+e)
            nze(e) = GAUSSIAN_DATA::nz(fe+e)
         end

         rys.set_n_roots(l_e+1)
         rys.get_weights(ZERO)

         do k = .class_first(A),.class_last(A)

            ! Both sides the same pair: X = 0, rho = zeta/2, QP = 0
            zinv = .exponent_inv(k)
            half_zinv = HALF*zinv
            cc = TWOPI5ON2*.prefactor(k)*.prefactor(k)*sqrt(HALF*.exponent_sum(k))

            diag(1:n_e) = ZERO
            do n = 1,l_e+1
               t2_rz = HALF*rys.root(n)
               B10 = (ONE - t2_rz)*half_zinv
               B00 = t2_rz*half_zinv
               GAUSSIAN_PAIR_LIST::make_2d(Ix,l_e,l_e,.center_diff(1,k),.center_diff(1,k),B10,B10,B00)
               GAUSSIAN_PAIR_LIST::make_2d(Iy,l_e,l_e,.center_diff(2,k),.center_diff(2,k),B10,B10,B00)
               GAUSSIAN_PAIR_LIST::make_2d(Iz,l_e,l_e,.center_diff(3,k),.center_diff(3,k),B10,B10,B00)
               do e = 1,n_e
                  diag(e) = diag(e) + rys.weight(n)*Ix(nxe(e),nxe(e))*Iy(nye(e),nye(e))*Iz(nze(e),nze(e))
               end
            end
            Q(k) = sqrt(abs(cc*maxval(diag(1:n_e))))

         end
      end

   end

   make_2d(I,l_e,l_f,C00,D00,B10,B01,B00) :: selfless, private, PURE
   ! Make the 2D Rys integrals "I(e+1,f+1)", e<=l_e, f<=l_f, for one
   ! cartesian direction by the vertical recursions.
      I :: MAT{REAL}, INOUT
      l_e,l_f :: INT, IN
      C00,D00,B10,B01,B00 :: REAL, IN

      e,f :: INT

      I(1,1) = ONE
      if (l_e>0) I(2,1) = C00
      do e = 2,l_e
         I(e+1,1) = C00*I(e,1) + (e-1)*B10*I(e-1,1)
      end

      do f = 1,l_f
         if (f==1) then; I(1,2) = D00
         else;           I(1,f+1) = D00*I(1,f) + (f-1)*B01*I(1,f-1)
         end
         do e = 1,l_e
            I(e+1,f+1) = C00*I(e,f+1) + f*B00*I(e,f)
            if (e>1) I(e+1,f+1) = I(e+1,f+1) + (e-1)*B10*I(e-1,f+1)
         end
      end

   end

end
