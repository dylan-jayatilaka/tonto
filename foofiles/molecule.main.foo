      case ("write_archive                 "); .put_archive
      case ("write_ascii_archive           "); .put_ascii_archive
      case ("write_tonto_fchk_mo           "); .put_tonto_FChk_MO
      case ("write_tonto_fchk_dm           "); .put_tonto_FChk_DM
      case ("write_morphy98_wfn_file       "); .put_morphy98_wfn_file
      case ("write_xyz_file                "); .put_xyz_file
      case ("write_fragment_xyz_file       "); .put_xyz_frag_file
      case ("write_xtal23_xyz_file         "); .put_xtal23_xyz_file

   ! case ("zero_off_atom_density         "); .zero_off_atom_density
