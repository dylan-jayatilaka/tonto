!---------------------------------------------------------------------------
!
! FOURIER_SUMS: Fourier transforms of a density given on a set of points.
!
! Plain procedures belonging to no object: the form factor routines in
! MOLECULE.RHO and MOLECULE.HAR prepare the points and weights, and call
! these to do the sums.
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!
!---------------------------------------------------------------------------

module FOURIER_SUMS

   implicit none

contains

   exp_ikr_sums(res,k_pts,pt,w) :: selfless, PURE
   ! Set "res(k)" to the sum over points "i" of w(i)*exp(i k.r_i),
   ! where "k" is row k of "k_pts" and "r_i" is row i of "pt".
      res   :: VEC{CPX}, OUT
      k_pts :: MAT{REAL}, IN
      pt    :: MAT{REAL}, IN
      w     :: VEC{REAL}, IN

   ENSURE(res.dim==k_pts.dim1,"res and k_pts: different number of k")
   ENSURE(k_pts.dim2==3,"k_pts: need 3 columns")
   ENSURE(pt.dim2==3,"pt: need 3 columns")
   ENSURE(w.dim==pt.dim1,"w and pt: different number of points")

      k1,k2,k3,kr :: REAL
      sf :: CPX
      k,i :: INT

      do k = 1,k_pts.dim1
         k1 = k_pts(k,1)
         k2 = k_pts(k,2)
         k3 = k_pts(k,3)
         sf = IMAGIFY(ZERO)
         do i = 1,pt.dim1
            kr = k1*pt(i,1)+k2*pt(i,2)+k3*pt(i,3)
            sf = sf + w(i)*exp(IMAGIFY(kr))
         end
         res(k) = sf
      end

   end

   sinc_kr_sums(res,k,r,w) :: selfless, PURE
   ! Set "res(j)" to the sum over points "i" of w(i)*sin(kr)/kr, with
   ! k = k(j) and r = r(i): the transform of a spherical density given
   ! at radii "r" with radial weights "w". The limit 1 is used at kr = 0.
      res :: VEC{REAL}, OUT
      k   :: VEC{REAL}, IN
      r   :: VEC{REAL}, IN
      w   :: VEC{REAL}, IN

   ENSURE(res.dim==k.dim,"res and k: different lengths")
   ENSURE(w.dim==r.dim,"w and r: different lengths")

      kr,sf :: REAL
      j,i :: INT

      do j = 1,k.dim
         sf = ZERO
         do i = 1,r.dim
            kr = k(j)*r(i)
            if (kr==ZERO) then; sf = sf + w(i)
            else;               sf = sf + w(i)*sin(kr)/kr
            end
         end
         res(j) = sf
      end

   end

end
