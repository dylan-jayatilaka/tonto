   implicit none

contains

!  ============
!  Orbital grid
!  ============

   make_orbital_grid_r(Ogrid,Orb,pts,square) :: PURE
   ! Evaluate the orbital "Ogrid" for *one* AO-basis coefficient
   ! orbital column "Orb", on a set of grid "pts". 
   ! If present and TRUE, then "square" the result.
      self   :: IN
      Ogrid  :: VEC{REAL}, OUT
      Orb    :: VEC{REAL}, IN
      pts    :: MAT{REAL}, IN
      square :: BIN, optional, IN

   ENSURE(.basis_info_made, "no basis info")

      sq :: BIN
      sh :: SHELL1
      BFgrid :: MAT{REAL}@
      n_pts,s,fs,ls,ns :: INT

      sq = FALSE
      if (present(square)) sq = square

      n_pts = pts.dim1

      Ogrid = ZERO

      do s = 1,.n_shell

         .set_shell1_from(s,sh,fs,ls,ns)

         ! Basis Fn grid for shell s
         BFgrid.create(n_pts,ns)
         sh.make_grid(BFgrid,pts)

         Ogrid = Ogrid + matmul(BFgrid,Orb(fs:ls))

         BFgrid.destroy

      end

      if (sq) Ogrid = Ogrid*Ogrid

   end

!  ==================
!  Nabla orbital grid
!  ==================

   make_nabla_orbital_grid(Ngrid,Ogrid,Orb,pts) :: template
   ! Return the nabla orbital density "Ngrid", and orbital density
   ! grid "Ogrid" for *one* orbital coefficient column "Orb", on a set
   ! of points "pts".
      self  :: IN
      Ngrid :: MAT{TYPE?}, OUT
      Ogrid :: VEC{TYPE?}, OUT
      Orb   :: VEC{TYPE?}, IN
      pts   :: MAT{REAL}, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(Ngrid.dim2==3, "wrong dim2, Ngrid")
   ENSURE(Ngrid.dim1==pts.dim1,"inconsistent Ngrid and pts")
   ENSURE(Ogrid.dim ==pts.dim1,"inconsistent Ogrid and pts")

      sh     :: SHELL1
      Ngrids :: MAT3{REAL}@
      Bgrids :: MAT{REAL}@
      n_pts,fs,ls,ns,s :: INT

      n_pts = pts.dim1

      Ngrid = ZERO
      Ogrid = ZERO

      do s = 1,.n_shell

         .set_shell1_from(s,sh,fs,ls,ns)

         ! Nabla and Basis fn grid for shell s
         ! Second index are shell basis fns
         Ngrids.create(n_pts,ns,3)
         Bgrids.create(n_pts,ns)
         sh.make_nabla_grid(Ngrids,Bgrids,pts)

         Ngrid(:,1) = Ngrid(:,1) + matmul(Ngrids(:,:,1),Orb(fs:ls))
         Ngrid(:,2) = Ngrid(:,2) + matmul(Ngrids(:,:,2),Orb(fs:ls))
         Ngrid(:,3) = Ngrid(:,3) + matmul(Ngrids(:,:,3),Orb(fs:ls))
         Ogrid(:  ) = Ogrid(:  ) + matmul(Bgrids(:,:  ),Orb(fs:ls))

         Ngrids.destroy
         Bgrids.destroy

      end

   end

   make_nabla_orbital_grid_r(Ngrid,Ogrid,Orb,pts) :: get_from(make_nabla_orbital_grid, TYPE?=>REAL), PURE
   ! Return the nabla orbital density "Ngrid", and orbital density
   ! grid "Ogrid" for *one* orbital coefficient column "Orb", on a set
   ! of points "pts".
   end

!  ======================
!  Laplacian orbital grid
!  ======================

   make_laplacian_orbital_grid_r(L,N,O,Orb,pts) :: PURE
   ! Return the Laplacian orbital density grid "L", the Nabla orbital
   ! grid "N", and the Orbital grid "O" for *one* AO-basis orbital
   ! vector "Orb" on a set of grid points "pts"
      self :: IN
      L    :: MAT{REAL}, OUT 
      N    :: MAT{REAL}, OUT 
      O    :: VEC{REAL}, OUT
      Orb  :: VEC{REAL}, IN
      pts  :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(L.dim2==3,"wrong dim2, L")
   ENSURE(N.dim2==3,"wrong dim2, N")
   ENSURE(L.dim1==pts.dim1,"inconsistent dim1, L and pts")
   ENSURE(N.dim1==pts.dim1,"inconsistent dim1, N and pts")
   ENSURE(O.dim1==pts.dim1,"inconsistent dim1, O and pts")

      sh :: SHELL1
      Lgrid :: MAT3{REAL}@
      Ngrid :: MAT3{REAL}@
      Bgrid :: MAT{REAL}@
      n_pts,fs,ls,ns,s :: INT

      n_pts = pts.dim1

      L = ZERO
      N = ZERO
      O = ZERO

      do s = 1,.n_shell

         .set_shell1_from(s,sh,fs,ls,ns)

         ! Laplacian, Nabla, and regular Basis fn grids
         Lgrid.create(n_pts,ns,3)
         Ngrid.create(n_pts,ns,3)
         Bgrid.create(n_pts,ns  )
         sh.make_laplacian_grid(Lgrid,Ngrid,Bgrid,pts)

         L(:,1) = L(:,1) + matmul(Lgrid(:,:,1),Orb(fs:ls))
         L(:,2) = L(:,2) + matmul(Lgrid(:,:,2),Orb(fs:ls))
         L(:,3) = L(:,3) + matmul(Lgrid(:,:,3),Orb(fs:ls))
         N(:,1) = N(:,1) + matmul(Ngrid(:,:,1),Orb(fs:ls))
         N(:,2) = N(:,2) + matmul(Ngrid(:,:,2),Orb(fs:ls))
         N(:,3) = N(:,3) + matmul(Ngrid(:,:,3),Orb(fs:ls))
         O(:)   = O(:)   + matmul(Bgrid(:,:  ),Orb(fs:ls))

         Lgrid.destroy
         Ngrid.destroy
         Bgrid.destroy

      end

   end

!  =========================
!  Electron density routines
!  =========================

   make_ED_grid_at_pts(grid,pts) :: PURE
   ! Work out the electron "grid" on "pt" using ".natural orbitals" and
   ! the ".NO_occ_nos" vector. 
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN

   ENSURE(.NOs.allocated, "no natural orbitals")
   ENSURE(.NOs.has_real_genre, "no real NOs")

      relativity :: STR
      NOgenre    :: STR

      relativity = "none"
      if (.SCF_data.allocated) then
         relativity = .SCF_data.relativity_kind
         if (NOT .SCF_data.PCE_CORR) relativity = "none"
      end
      ENSURE(relativity=="none","relativistic densities unmaintained")

      NOgenre = .NOs.genre
      select case (NOgenre)
      case ("r "); .make_ED_grid_r(grid,pts)
      case ("u "); .make_ED_grid_u(grid,pts)
      end

   end

   make_ED_grid_r(grid,pts) :: PURE
   ! Make the "grid" for the supplied points "pts" from restricted 
   ! real density matrix (not NOs as in v1, which is deprecated).
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN

   ! .make_ED_grid_r_v1(grid,pts)
      .make_ED_grid_r_v2(grid,pts)

   end

   make_ED_grid_r_v2(grid,pts) :: PURE
   ! Make the electron density "grid" for the supplied points "pts"
   ! from restricted real .density_mx. Elements smaller than TOL(9)
   ! are ignored.
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN

   ENSURE(pts.dim2==3,  "wrong dim2, pts")
   ENSURE(.density_mx.is_allocated_with_genre("r "), "no restricted density_mx")

      .make_ED_grid_r_v2(grid,pts,.density_mx.r)

   end

   make_ED_grid_r(grid,pts,DM) :: PURE
   ! Make the "grid" for the supplied points "pts" from restricted 
   ! real density matrix "DM".
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN
      DM   :: MAT{REAL}, IN

      .make_ED_grid_r_v2(grid,pts,DM)

   end

   make_ED_grid_r_v2(grid,pts,DM,tol) :: PURE
   ! Add to "grid" the electron density values at the the points "pt",
   ! for density matrix "DM". Only terms bigger than "tol" are considered.
   ! NOTE: This is Kanghyun's version. Now working.
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN
      DM   :: MAT{REAL}, IN
      tol  :: REAL, optional, IN

   ENSURE(grid.dim==pts.dim1, "inconsistent dim1, grid & pts")
   ENSURE(pts.dim2==3,    "wrong dim2, pt")
   ENSURE(DM.is_square,   "wrong shape, DM")
   ENSURE(DM.dim1==.n_bf, "wrong size, DM")

      psi  :: VEC{EVEC{REAL}}@
      ind  :: VEC{EVEC{INT}}@
      mask :: VEC{BIN}@
      bf   :: MAT{REAL}@
      same,pi,pj :: VEC{INT}@
      n_pts, s,fs,ls,ns, i,j :: INT
      sh   :: SHELL1
      Dij  :: REAL
      eps  :: REAL

      ! Same as .becke_grid.basis_fn_cutoff
      eps = SHELL_BASIS_FN_CUTOFF
      if (present(tol)) eps = tol

      ! Zero
      grid = ZERO

      ! Sparse storage of significant b.f. values on grid:
      ! placed in "psi", corresponding indices in "ind".
      psi.create(.n_bf)
      ind.create(.n_bf)

      ! Loop over shells "s"
      n_pts = pts.dim1
      mask.create(n_pts)
      do s = 1,.n_shell 
         .set_shell1_from(s,sh,fs,ls,ns)
         bf.create(n_pts,ns)
         sh.make_grid(bf,pts(:,1),pts(:,2),pts(:,3))
         ! Basis fn. "i"
         do i = fs,ls
            mask = abs(bf(:,i-fs+1))>eps
            ! Store large values for each b.f.
            psi(i).element = pack(bf(:,i-fs+1)   ,mask)
            ind(i).element = pack([(j,j=1,n_pts)],mask)
         end
         bf.destroy
      end
      mask.destroy

      ! psi*psi product
      grid = ZERO 
      do i = 1,.n_bf 
      do j = 1,i
         ! DM is symmetric
         Dij = DM(i,j)
         if (j<i) Dij = Dij + Dij
         ! DM value large enough?
         if (abs(Dij)>eps) then
            VEC{INT}:common_indices_in(ind(i)[:],ind(j)[:],pi,pj,same)
            ! Common indices?
            if (same.dim>0) then
               grid(same) = grid(same) + Dij*psi(i)[pi]*psi(j)[pj]
            end
            pi.destroy
            pj.destroy
            same.destroy
         end
      end
      end

      ind.destroy
      psi.destroy

   end

! Should be deprecated? Version without NOs is better?

   make_ED_grid_r_v1(grid,pts) :: PURE
   ! Make the "grid" for the supplied points "pts" from
   ! restricted real natural orbitals
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN

   ENSURE(pts.dim2==3,  "wrong dim2, pts")
   ENSURE(.NOs.is_allocated_with_genre("r "), "no restricted NO's")
   ENSURE(.NO_occ_nos.r.allocated, "no occupation numbers")

      NO  :: VEC{REAL}@
      occ :: REAL
      n_occ,n :: INT

      n_occ = .no_of_occupied_NOs
      NO.create(pts.dim1)

      grid = ZERO

      parallel do n = 1,n_occ reduce(grid)
         .make_orbital_grid_r(NO,.NOs.r(:,n), pts)
         occ = .NO_occ_nos.r(n)
         grid = grid + occ*NO*NO
      end


      NO.destroy

   end

   make_ED_grid_r_v1(grid,pts,NO,occ) :: PURE
   ! Make the electron density "grid" for the supplied points "pts"
   ! from the natural orbitals "NO" and occupuation numbers "occ".
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN
      NO   :: MAT{REAL}, IN
      occ  :: VEC{REAL}, IN

   ENSURE(pts.dim2==3,"wrong dimension for points array")
   ENSURE(grid.dim==pts.dim1,"inconsistent number of points")

      NOn :: VEC{REAL}@
      n   :: INT

      NOn.create(pts.dim1)

      grid = ZERO
      do n = 1,NO.dim2
         if (occ(n)==ZERO) cycle
         .make_orbital_grid_r(NOn,NO(:,n),pts)
         grid = grid + occ(n)*NOn*NOn
      end

      NOn.destroy

   end

   make_ED_grid_u(grid,pts,sgn) :: PURE
   ! Make the electron density  "grid" for the supplied points "pt"
   ! from unrestricted real natural orbitals. If present "sgn" is used
   ! to determine whether the total density or spin density is to be
   ! calculated: sgn=1 means sum the alpha and beta densities to form
   ! the total density, sgn=-1 means to subtract, forming the Sz spin
   ! density.
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN
      sgn  :: INT, optional, IN

   ENSURE(pts.dim2==3,  "wrong dimension for points array")
   ENSURE(.NOs.is_allocated_with_genre("u "), "no unrestricted NO's")
   ENSURE(.NO_occ_nos.a.allocated, "no alpha occupation numbers")
   ENSURE(.NO_occ_nos.b.allocated, "no beta occupation numbers")

      NO :: VEC{REAL}@
      occ,fac :: REAL
      na,nb,n :: INT

      fac = ONE
      if (present(sgn)) fac = REALIFY(sgn)

      na = .no_of_occupied_NOs("alpha")
      nb = .no_of_occupied_NOs("beta")

      NO.create(pts.dim1)

      grid = ZERO

      do n = 1,na
         .make_orbital_grid_r(NO,.NOs.a(:,n),pts)
         occ = .NO_occ_nos.a(n)
         grid = grid + occ*NO*NO
      end

      do n = 1,nb
         .make_orbital_grid_r(NO,.NOs.b(:,n),pts)
         occ = .NO_occ_nos.b(n)
         grid = grid + fac*occ*NO*NO
      end

      ! Clean
      NO.destroy

   end

   integrate_ED_numerically
   ! Integrate the density numerically
      self :: INOUT

   ENSURE(.becke_grid.allocated,"no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      pt   :: MAT{REAL}@
      wt   :: VEC{REAL}@
      rho  :: VEC{REAL}@
      n_pt :: INT
      n_e  :: REAL

   ! Z    :: MAT{REAL}@
   ! i,j  :: INT
   ! V_ee :: REAL

      stdout.head("Numerically integrate the electron density")

      ! Make becke grid (leaky)
      .becke_grid.put
      .becke_grid.put_atom_info
      .becke_grid.make_grid(pt,wt)

      n_pt = pt.dim1

      rho.create(n_pt)

      .make_ED_grid_at_pts(rho,pt)

      n_e = sum(rho*wt)

      stdout.show("n_pt =",n_pt)
      stdout.show("n_e  =",n_e)

   ! stdout.text("wt:")
   ! do i = 1,wt.dim
   !     write(*,"(e20.12)") wt(i)
   ! end

   ! stdout.text("pt:")
   ! stdout.put(pt)
   ! do i = 1,pt.dim1
   !     write(*,"(3e20.12)") (pt(i,j), j=1,3)
   ! end

      rho.destroy
      wt.destroy
      pt.destroy

      ! Now do the int rho_2() r_12^{-1} dr2
   ! Z.create(.n_bf,.n_bf)
   ! pt.create(1,3)
   ! i = 1
   ! pt(1,:) = .atom(i).position
   ! .make_nuclear_attraction_mx(Z,[-ONE],pt)
   ! V_ee = .expectation(Z)
   ! stdout.text("V_ee:")
   ! write(*,"(e20.12)") V_ee
   ! pt.destroy
   ! Z.destroy

   end

!  ==================
!  Derivative ED grid
!  ==================

   make_derivative_rho_grid(N0,pts,D) :: leaky, PURE
   ! Make density grids "N0" on points "pt" using density matrices "D"
   ! skipping as points as possible. This routine will probably have
   ! to be batched over *spatially localised* points to reduce memory
   ! requirements.
      self :: IN
      N0   :: MAT{REAL}, OUT
      pts  :: MAT{REAL}, IN
      D   :: MAT3{REAL}, IN

   ENSURE(N0.dim1==pts.dim1,"N0 and pt: incompatible sizes")
   ENSURE(N0.dim2== D.dim3,"N0 and D: incompatible sizes")
   ENSURE(3     ==pts.dim2,"pt: wrong dim2")
   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.becke_grid.allocated,"no becke_grid")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms_for_atom")

      bf_lgval :: VEC{EVEC{INT}}@
      bf_grid0 :: VEC{EMAT{REAL}}@
      ra :: VEC{REAL}(3)
      xa,ya,za,a2 :: VEC{REAL}@
      ga0,gb0 :: VEC{REAL}@
      overlapping_atom, lga,lgb, sp :: VEC{INT}@
      DD :: MAT3{REAL}@
      sha :: SHELL1
      Dab, fac,val, ga,gb :: REAL
      atom_o,cutoff,n_pts,n_keep, bs, p,n, q,n_dens :: INT
      atom_a,fsa,lsa,sa,fa,la,na,a :: INT
      atom_b,fsb,lsb,sb,fb,lb,nb,b :: INT

      ! No of densities
      n_dens = D.dim3

      ! Basis function cutoff
      cutoff = floor(log10(.becke_grid.basis_fn_cutoff))

      ! Saved basis function grid and skip list
      bf_lgval.create(.n_shell)
      bf_grid0.create(.n_shell)

      ! Atom "a" displaced points and skip switches
      n_pts = pts.dim1
      xa.create(n_pts)
      ya.create(n_pts)
      za.create(n_pts)
      a2.create(n_pts)
      sp.create(n_pts)

      ! Create N0
      N0 = ZERO

      ! Loop atom_a
      do atom_a = 1,.n_atom

         fsa = .first_shell_for_atom(atom_a)
         lsa =  .last_shell_for_atom(atom_a)

         ! Make shell atom displaced points
         .atom(atom_a).make_displaced_pts(xa,ya,za,a2,pts,n_pts)

         ! Atom a position
         ra = .atom(atom_a).position

         ! Loop overlapping atom_b
         overlapping_atom = .overlapping_atoms_for_atom(atom_a).element
         do atom_o = 1,overlapping_atom.dim

            atom_b = overlapping_atom(atom_o)
            if (atom_b>atom_a) cycle

            fsb = .first_shell_for_atom(atom_b)
            lsb = min(.last_shell_for_atom(atom_b),lsa)

            ! Loop shells on atom a
            do sa = fsa,lsa

               fa = .first_basis_fn_for_shell(sa)
               la =  .last_basis_fn_for_shell(sa)
               na = la - fa + 1

               ! Set shell for index "sa"
               bs  = .basis_shell_for_shell(sa)
               sha = .basis_shell1pair(bs,1).a
               sha.position = ra

               ! Make shell "sa" basis function grid and lga values
               bf_grid0(sa).element.create(n_pts,na)
               lga.create(n_pts)
               sha.make_grid(bf_grid0(sa).element,n_pts,xa,ya,za,a2,lga)

               ! Save the values
               bf_lgval(sa).element = lga

               ! Loop shells on atom b
               do sb = fsb,min(lsb,sa)

                  fb = .first_basis_fn_for_shell(sb)
                  lb = .last_basis_fn_for_shell(sb)
                  nb = lb - fb + 1

                  ! Get the "sb" basis function grid
                  lgb = bf_lgval(sb).element

                  ! How many points in common?
                  n_keep = count((lga+lgb)>=cutoff)
                  if (n_keep==0) cycle

                  ! Make significant points
                  sp(1:n_keep) = pack([(n,n=1,n_pts)],mask=(lga+lgb)>=cutoff)

                  ! Factor
                  fac = TWO
                  if (sa==sb) fac = ONE

                  ! Density block
                  DD = D(fa:la,fb:lb,:)

                  if (na*nb==1) then

                     ga0 = bf_grid0(sa)[:,1]
                     gb0 = bf_grid0(sa)[:,1]
                     do q = 1,n_dens
                        Dab = fac*DD(1,1,q)
                        do p = 1,n_keep
                           n = sp(p)
                           ga = ga0(n)
                           gb = gb0(n)
                           val = ga*gb*Dab
                           N0(n,q) = N0(n,q) + val
                        end
                     end

                  else

                     ! Add density contribution to rho
                     do a = 1,na
                        ga0 = bf_grid0(sa)[:,a]
                        do b = 1,nb
                           gb0 = bf_grid0(sb)[:,b]
                           do q = 1,n_dens
                              Dab = fac*DD(a,b,q)
                              do p = 1,n_keep
                                 n = sp(p)
                                 ga = ga0(n)
                                 gb = gb0(n)
                                 val = ga*gb*Dab
                                 N0(n,q) = N0(n,q) + val
                              end
                           end
                        end
                     end

                     ! Clean up

                  end ! if ss or not ss
               end    ! -- loop sb
            end       ! -- loop sa
         end          ! -- atom_b
      end             ! -- atom_a

      ! Clean up
      sp.destroy
      a2.destroy
      za.destroy
      ya.destroy
      xa.destroy
      bf_grid0.destroy
      bf_lgval.destroy

   end

!  ========================
!  CRYSTAL232 density, fast
!  ========================

   make_CRYSTAL23_ED_grid_v1(grid,pts)
   ! Make the "grid" for the supplied points "pts" using the CRYSTAL23
   ! density marices which have been read in.
   ! This version from Kanghyun Chu, tested in  Matlab for NH3
   ! 7/12/23
      self :: IN
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN

   ENSURE(.crystal23.allocated , "Idiot! No crystal23 info read in!")
   ENSURE(.crystal23.density_mx.allocated , "no crystal23 density_mx info")

      psi  :: MAT{EVEC{REAL}}@
      ind  :: MAT{EVEC{INT}}@
      bf   :: MAT{REAL}@
      l_ind :: MAT{INT}@
      PSIPSI :: VEC{REAL}@
      common, posA, posB :: VEC{INT}@
      mask :: VEC{BIN}@
      cm :: MAT{REAL}(3,3)
      mt :: VEC{REAL}(3)
      mv,lv,rv,dv :: VEC{INT}(3)
      n_pts,n_g, s,fs,ls,ns :: INT
      n,l,r, m,i,j, l1,l2  :: INT
      tol :: REAL
      sh :: SHELL1

      ! Strange p basis function ordering
      GAUSSIAN_DATA:set_CRYSTAL23_ordering(TRUE)

      ! Array sizes
      n_g   = .crystal23.n_g
      n_pts = pts.dim1
      tol   = exp(-20.00)

      ! Unit cell matrix
      cm = .crystal23.Primitive_unit_cell.direct_mx ! This is the unit cell written in the XML file

      ! <<Kang's memo>>
      ! The "psi" and "ind" objects should have 2+1 indices.
      ! Former "2" dimensions have fixed sized: 
      !            (# of basis) X (# of cells)
      ! Last   "1" dimension has varying size:
      !        (of # of grid points where Basis_Func(r) > tolerance) 
      ! Sparse storage of significant b.f. values on grid 
      ! in "psi" and corresponding indices in "ind".
      psi.create(n_g,.n_bf)
      ind.create(n_g,.n_bf)
      mask.create(n_pts)
      do m = 1,n_g

         ! Left UC translational vector
         mv = .crystal23.g_latt(:,m) ! m-th IVDL 
         mt = matmul(cm,mv)          ! This is m-th CVDL

         do s = 1,.n_shell ! s: for every shell
            .set_shell1_from(s,sh,fs,ls,ns)
            sh.position = sh.position + mt ! either +mt or -mt
            bf.create(n_pts,ns)  ! bf:2D array: n_pt X ns
            sh.make_grid_s(bf,pts(:,1),pts(:,2),pts(:,3))
            do i = fs,ls
               mask = abs(bf(:,i-fs+1))>tol
               psi(m,i).element = pack(bf(:,i-fs+1)  ,mask)
               ind(m,i).element = pack([(j,j=1,n_pts)],mask)
            end
            bf.destroy
         end
      end

      mask.destroy

   ! stdout.text("pt:")
   ! stdout.put(pts)

      ! Values on grid & psi*psi product
      grid = ZERO 
      PSIPSI.create(n_pts) 

      ! m-cell loop
      do m = 1,n_g

         mv = .crystal23.g_latt(:,m)
         mt = matmul(cm,mv)          ! This is m-th CVDL

         ! List of allowed pairs
         l_ind.create(n_g,2) 
         n = 0
         do l = 1,n_g
            lv = .crystal23.g_latt(:,l)
            dv = lv + mv
            do r = 1,n_g
               rv = .crystal23.g_latt(:,r)
               if (dv.same_as(rv)) then 
                  n = n + 1
                  l_ind(n,1) = l 
                  l_ind(n,2) = r 
               end
            end 
         end
         l_ind.shrink(n,2)

         do i = 1,.n_bf ! psi(i, cell1)
         do j = 1,.n_bf ! psi(j, cell2)
        
            if (abs(.crystal23.density_mx(i,j,m)) < tol)  cycle        
         
            PSIPSI = ZERO 
            ! dim: (# Grid pointd)
            ! psi(i,m) , i:1..n_ba; m:1..n_g
            ! ind(i,m)
        
            do l = 1,l_ind.dim1

               l1 = l_ind(l,1)
               l2 = l_ind(l,2)
               VEC{INT}:common_indices_in(ind(l1,i)[:],ind(l2,j)[:],posA,posB,common)

               if (common.dim>0) then
                  ! Product for both basis functions being large
                  PSIPSI(common) = PSIPSI(common) &
                                 + psi(l1,i)[posA]*psi(l2,j)[posB]
               end

               posA.destroy
               posB.destroy
               common.destroy

            end
        
            ! Add up signinifcant parts
            grid = grid + .crystal23.density_mx(i,j,m) * PSIPSI
        
         end
         end

      end

   ! stdout.text("grid:")
   ! stdout.put(grid,by_column=TRUE)

      ! Clean
      PSIPSI.destroy

   end

!   make_CRYSTAL23_ED_grid(grid,pt)
!   ! Make the "grid" for the supplied points "pt" using the CRYSTAL23
!   ! density marices which have been read in.
!      self :: IN
!      grid :: VEC{REAL}, OUT
!      pt   :: MAT{REAL}, IN
!
!   ENSURE(.crystal23.allocated , "no crystal23 info")
!   ENSURE(.crystal23.density_mx.allocated , "no crystal23 density_mx info")
!
!      cm :: MAT{REAL}(3,3)
!      lt,rt    :: VEC{REAL}(3)
!      lv,rv,dv :: VEC{INT}(3)
!      l, r, d :: INT
!
!      GAUSSIAN_DATA:set_CRYSTAL23_ordering(TRUE)
!
!      ! Unit cell matrix
!      cm = .crystal23.Primitive_unit_cell.direct_mx ! Kang update 2024.Jun.11
!           ! Kang's note
!           !   crystal23's unit cell is always primitive cell
!           !   crystal  's unit cell is crystallogrphic conventional cell   
!
!      ! Values on grid
!      grid = ZERO
!
!      ! Left b.f. unit cell "l"
!      ! This is translated back to the first unit cell
!      do l = .crystal23.n_g,1,-1
!
!         ! Left UC translational vector
!         lv = .crystal23.g_latt(:,l) ! l-th IVDL
!         lt = matmul(cm,lv)          ! This is l-th CVDL
!
!         ! Diagonal contribution from DM^{l l}
!         .add_ED_grid(grid, pt, .crystal23.density_mx(:,:,1), lshft=lt , rshft=lt )
!
!         ! Right b.f. unit cell
!         do r = .crystal23.n_g,1,-1 ! Check from here! off-diagonal
!                                    ! density matrix contributions xxxxxxxxxx 
!
!            ! Done diagonal case, above?
!            if (r==l) cycle 
!
!            ! Right UC translational vector
!            rv = .crystal23.g_latt(:,r)
!            rt = matmul(cm,rv)         ! This is g-th CVDL
!
!            ! Difference between left & right cell vectors
!            ! "d" depends on how DM^{l r}_{a b} is defined when it
!            ! mutiplies the basis functions.
!            dv = rv - lv 
!            d  = .crystal23.g_latt.index_for_column(dv)
!
!            ! Do we have DM^d ?
!            if (d==0) cycle
!
!            ! Add contribution from shifted central unit cell
!            ! DYLAN: I think the P's are not read in correct?
!            .add_ED_grid(grid,pt,.crystal23.density_mx(:,:,d),lshft=lt,rshft=rt)
!
!         end
!
!      end
!
!   end 

!  ==================
!  Nabla density grid
!  ==================

   make_nabla_ED_grid(Ngrid,pts) :: PURE
   ! Return nabla of the electron density in "Ngrid" on points "pts".
      self  :: IN
      Ngrid :: MAT{REAL}, OUT
      pts   :: MAT{REAL}, IN

      if (trim(.NOs.number_kind)=="real") then
         .make_nabla_ED_grid_r(Ngrid,pts)
   ! else
   !    DIE("not implemented")
      end

   end

   make_nabla_ED_grid_r(Ngrid,pts) :: PURE
   ! Return nabla of electron density in "Ngrid" for points "pts".
   ! Using ".NOs" and their occupation numbers.
      self  :: IN
      Ngrid :: MAT{REAL}, OUT
      pts   :: MAT{REAL}, IN

   ENSURE(pts.dim2==3,   "wrong dim2, pts")
   ENSURE(Ngrid.dim2==3, "wrong dim2, Ngrid")
   ENSURE(.NOs.allocated,"no NOss")
   ENSURE(.NOs.is_allocated_with_genre("r "), "no restricted NO's")
   ENSURE(.NO_occ_nos.allocated, "no NO occupation numbers")
   ENSURE(.NO_occ_nos.is_allocated_with_genre("r "),"no restricted NO occupation numbers")

      orb  :: VEC{REAL}@
      Norb :: MAT{REAL}@
      occ  :: REAL
      n_pts,n_occ,n :: INT

      n_pts = pts.dim1
      n_occ = .no_of_occupied_NOs

      orb.create(n_pts)
      Norb.create(n_pts,3)

      Ngrid = ZERO

      do n = 1,n_occ

         ! Nabla grid for n-th NO 
         .make_nabla_orbital_grid_r(Norb,orb,.NOs.r(:,n), pts)

         occ = .NO_occ_nos.r(n)

         Ngrid(:,1) = Ngrid(:,1) + occ*orb(:)*Norb(:,1)
         Ngrid(:,2) = Ngrid(:,2) + occ*orb(:)*Norb(:,2)
         Ngrid(:,3) = Ngrid(:,3) + occ*orb(:)*Norb(:,3)

      end

      Ngrid = TWO * Ngrid

      ! Clean
      Norb.destroy
      orb.destroy

   end

   make_nabla_ED_grid(Ngrid,Egrid,pts) :: PURE
   ! Return nabla of electron density in "Ngrid" on points "pts".
   ! And also the electron density in "Egrid".
      self  :: IN
      Ngrid :: MAT{REAL}, OUT
      Egrid :: VEC{REAL}, OUT
      pts   :: MAT{REAL}, IN

      if (trim(.NOs.number_kind)=="real") then
         .make_nabla_ED_grid_r(Ngrid,Egrid,pts)
   ! else
   !    DIE("not implemented")
      end

   end

   make_nabla_ED_grid_r(Ngrid,Egrid,pts) :: PURE
   ! Return nabla of electron density in "Ngrid" on points "pts".
   ! And also the electron density in "Egrid".  Using the grid "pts"
   ! and the ".NOs" and their occupation numbers.
      self  :: IN
      Ngrid :: MAT{REAL}, OUT
      Egrid :: VEC{REAL}, OUT
      pts   :: MAT{REAL}, IN

   ENSURE(pts.dim2  ==3,  "wrong dim2, pts")
   ENSURE(Ngrid.dim2==3,  "wrong dim2, Ngrid")
   ENSURE(Ngrid.dim1==pts.dim1,"incosistent Ngrid and pts")
   ENSURE(Egrid.dim ==pts.dim1,"incosistent Egrid and pts")
   ENSURE(.NOs.allocated, "no natural orbitals")
   ENSURE(.NOs.is_allocated_with_genre("r "), "no restricted NO's")
   ENSURE(.NO_occ_nos.allocated, "no occupation numbers")
   ENSURE(.NO_occ_nos.is_allocated_with_genre("r "),"no occupation numbers")

      orb  :: VEC{REAL}@
      Norb :: MAT{REAL}@
      occ  :: REAL
      n_pts,n_occ,n :: INT

      n_pts = pts.dim1
      n_occ = .no_of_occupied_NOs

      orb.create(n_pts)
      Norb.create(n_pts,3)

      Ngrid = ZERO
      Egrid = ZERO

      do n = 1,n_occ

         ! Nabla grid for n-th NO 
         .make_nabla_orbital_grid_r(Norb,orb,.NOs.r(:,n), pts)

         occ = .NO_occ_nos.r(n)

         Ngrid(:,1) = Ngrid(:,1) + occ*orb(:)*Norb(:,1)
         Ngrid(:,2) = Ngrid(:,2) + occ*orb(:)*Norb(:,2)
         Ngrid(:,3) = Ngrid(:,3) + occ*orb(:)*Norb(:,3)
         Egrid(:)   = Egrid(:)   + occ*orb(:)* orb(:  )

      end

      Ngrid = TWO * Ngrid

      Norb.destroy
      orb.destroy

   end

!   make_nabla_density_grid_fdm_r(nabla_grid,pts)
!   ! Work out the nabla density on ".plot_grid" using ".natural orbitals" and the
!   ! ".occupation" number vector.
!   ! This method uses the finite difference method to calculate the gradient
!   ! from the density.  It is much slower, but useful for checking.
!     nabla_grid, pts :: MAT{REAL}
!   ENSURE(pts.dim2==3,  "wrong dimension for points array")
!   ENSURE(nabla_grid.dim2==3,  "wrong dimension for nabla_grid array")
!   ENSURE(.NOs.is_allocated_with_genre("r "), "no restricted NO's")
!   ENSURE(.NO_occ_nos.r.allocated, "no occupation #'s")
!     orb :: VEC{REAL}*
!     dens_1,dens_2,nabla_orb,comp :: VEC{REAL}*
!     pt1 :: MAT{REAL}*
!     alpha :: REAL
!     n_occ,n,n_pts,i :: INT
!     alpha = TOL(6)
!     n_pts = size(pts,1)
!     pt1.create(n_pts,3)
!     nabla_grid = ZERO
!     orb.create(n_pts)
!     dens_1.create(n_pts)
!     dens_2.create(n_pts)
!     nabla_orb.create(n_pts)
!     n_occ = .no_of_occupied_NOs
!     do n = 1,n_occ
!        do i = 1,3
!          comp => pt1(:,i)
!          pt1 = pts;    comp = comp + alpha
!          .make_orbital_grid_r(dens_1,.NOs.r(:,n),pt1,square=TRUE)
!          pt1 = pts;    comp = comp - alpha
!          .make_orbital_grid_r(dens_2,.NOs.r(:,n),pt1,square=TRUE)
!          nabla_orb = HALF/alpha * (dens_1 - dens_2)
!          .make_orbital_grid_r(orb,.NOs.r(:,n), pts)
!          nabla_grid(:,i) = nabla_grid(:,i) + .NO_occ_nos.r(n)*orb(:)*nabla_orb
!        end
!     end
!     nabla_grid = TWO*nabla_grid
!     nabla_orb.destroy
!     dens_2.destroy
!     dens_1.destroy
!     orb.destroy
!     pt1.destroy
!   end

! ==========================
! Laplacian density routines
! ==========================

   make_laplacian_ED_grid_r(Lgrid,pts) :: PURE
   ! Work out the electron density laplacian "Lgrid" on points "pts"
   ! using ".natural orbitals" and  the ".NO_occ_nos" vector.
      self  :: IN
      Lgrid :: VEC{REAL}, OUT
      pts   :: MAT{REAL}, IN

   ENSURE(pts.dim2==3, "wrong dim2, pts")
   ENSURE(.NOs.is_allocated_with_genre("r "), "no restricted real NO's")
   ENSURE(.NO_occ_nos.r.allocated, "no rean NO occupation #'s")

      O :: VEC{REAL}@
      N :: MAT{REAL}@
      L :: MAT{REAL}@
      n_pts,n_occ,i :: INT
      occ :: REAL

      n_pts = pts.dim1
      n_occ = .no_of_occupied_NOs

      O.create(n_pts)
      N.create(n_pts,3)
      L.create(n_pts,3)

      Lgrid = ZERO

      parallel do i = 1,n_occ reduce(Lgrid)

         .make_laplacian_orbital_grid_r(L,N,O,.NOs.r(:,i),pts)

         occ = .NO_occ_nos.r(i)

         Lgrid = Lgrid  &
               + occ * ( O(:) * (L(:,1)+L(:,2)+L(:,3)) & 
               + N(:,1)*N(:,1) + N(:,2)*N(:,2) + N(:,3)*N(:,3) )

      end

      Lgrid = TWO * Lgrid

      ! Clean
      L.destroy
      N.destroy
      O.destroy

   end

   make_laplacian_ED_grid_u(Lgrid,pts) :: PURE
   ! Work out the electron density laplacian "Lgrid" on points "pts"
   ! using ".natural orbitals" and  the ".NO_occ_nos" vector.
      self  :: IN
      Lgrid :: VEC{REAL}, OUT
      pts   :: MAT{REAL}, IN

   ENSURE(pts.dim2==3, "wrong dim2, pts")
   ENSURE(.NOs.is_allocated_with_genre("u"), "no unrestricted real NO's")
   ENSURE(.NO_occ_nos.is_allocated_with_genre("u"), "no unrestricted occupation numbers")

      O :: VEC{REAL}@
      N :: MAT{REAL}@
      L :: MAT{REAL}@
      na,nb,n_occ,n_pts,i :: INT
      occ :: REAL

      na    = .no_of_occupied_NOs("alpha")
      nb    = .no_of_occupied_NOs("alpha")
      n_occ = max(na,nb)

      n_pts = pts.dim1
      O.create(n_pts)
      N.create(n_pts,3)
      L.create(n_pts,3)

      Lgrid = ZERO

      parallel do i = 1,n_occ reduce(Lgrid)

         ! Alpha
         .make_laplacian_orbital_grid_r(L,N,O,.NOs.a(:,i),pts)
         occ = .NO_occ_nos.a(i)
         Lgrid = Lgrid  &
               + occ * ( O(:) * (L(:,1)+L(:,2)+L(:,3)) & 
               + N(:,1)*N(:,1) + N(:,2)*N(:,2) + N(:,3)*N(:,3) )

         ! Beta
         .make_laplacian_orbital_grid_r(L,N,O,.NOs.b(:,i),pts)
         occ = .NO_occ_nos.b(i)
         Lgrid = Lgrid  &
               + occ * ( O(:) * (L(:,1)+L(:,2)+L(:,3)) & 
               + N(:,1)*N(:,1) + N(:,2)*N(:,2) + N(:,3)*N(:,3) )

      end

      Lgrid = TWO * Lgrid

      ! Clean
      L.destroy
      N.destroy
      O.destroy

   end

!  ===================
!  Becke density grids
!  ===================

! For DFT

   set_up_becke_grid :: leaky, PURE
   ! Set up the Becke grids and overlapping atoms
      self :: INOUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")

      if (.becke_grid.deallocated) .becke_grid.create

      ! ALWAYS Set up integration grid
      ! (in case of new positions) (leaky)
      .becke_grid.set_atom_info(.atom) 
      .becke_grid.set_grid_data
      .destroy_XC_grid

      ! ALWAYS make the overlapping atom lists
      .set_overlapping_atoms_for_atom

   end

   put_grid_shell_errors
   ! For every atom and every radial shell of its DFT grid: the shell's
   ! contribution to the electron count and to the Dirac exchange energy
   ! integrated with the angular order the pruning scheme assigns, and the
   ! error of that and of L = 5, 11, 17, 23, 29 against L = 59 on the same
   ! shell. Becke-partitioned like the real grid. Run on a converged
   ! restricted density. A diagnostic for the adaptive-pruning work
   ! (DEFERRED.md); it says which shells are under- or over-resolved.
      self :: INOUT

   ENSURE(.becke_grid.allocated,"no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.density_mx.is_allocated_with_genre("r "),"needs a restricted density")

      Ls :: VEC{INT}(6)
      leb :: LEBEDEV@
      pt  :: MAT{REAL}@
      wt,rho :: VEC{REAL}@
      overlapping_atom :: VEC{INT}@
      S,X :: VEC{REAL}(6)
      a,i,k,n,nr,L,L_used,n_used,n_atom_pts :: INT
      r,wr,S_used,X_used,atom_err,atom_X :: REAL

      Ls = [5,11,17,23,29,59]

      if (.overlapping_atoms_for_atom.deallocated) .set_overlapping_atoms_for_atom

      stdout.flush
      stdout.text("=================================================")
      stdout.text("DFT grid: angular error per radial shell, by atom")
      stdout.text("=================================================")
      stdout.flush
      stdout.text("N     = shell contribution to the electron count")
      stdout.text("X     = shell contribution to the Dirac exchange energy, -(3/4)(3/pi)^(1/3) rho^(4/3)")
      stdout.text("dX(L) = X at Lebedev order L minus X at L = 59; 'used' is the order the pruning scheme assigns")
      stdout.flush

      do a = 1,.n_atom

         overlapping_atom = .overlapping_atoms_for_atom(a).element
         nr = .becke_grid.n_radial_pts_for_atom(a)
         atom_err = ZERO
         atom_X   = ZERO
         n_atom_pts = 0

         stdout.flush
         stdout.text("Atom "//trim(a.to_str)//"  "//trim(.atom(a).label))
         stdout.flush
         stdout.text("  shell   r/bohr   L used  n_pts       N used         X used        dX used"// &
                     "     dX(5)     dX(11)     dX(17)     dX(23)     dX(29)")

         do i = 1,nr

            .becke_grid.radial_shell_for_atom(a,i,r,wr)
            L_used = .becke_grid.angular_order_for_shell(a,i)

            ! The shell at each order, partitioned like the real grid
            do k = 1,6
               L = Ls(k)
               leb.destroy
               leb.create
               leb.set_l(L)
               n = leb.n_pts
               pt.create(n,3)
               wt.create(n)
               pt(:,1) = .atom(a).position(1) + r*leb.pts(:,1)
               pt(:,2) = .atom(a).position(2) + r*leb.pts(:,2)
               pt(:,3) = .atom(a).position(3) + r*leb.pts(:,3)
               wt = wr*leb.wts
               .becke_grid.apply_partition(pt,wt,a,overlapping_atom)
               rho.create(n)
               .make_ED_grid_r_v2(rho,pt)
               S(k) = sum(wt*rho)
               X(k) = -0.75d0*(THREE/PI)**THIRD * sum(wt*rho**(FOUR/THREE))
               if (L==L_used) then
                  S_used = S(k); X_used = X(k); n_used = n
               end
               rho.destroy
               wt.destroy
               pt.destroy
            end
            leb.destroy

            ! The used order is one of the six unless the scheme names another
            if (all(Ls/=L_used)) then
               leb.create
               leb.set_l(L_used)
               n = leb.n_pts
               pt.create(n,3)
               wt.create(n)
               pt(:,1) = .atom(a).position(1) + r*leb.pts(:,1)
               pt(:,2) = .atom(a).position(2) + r*leb.pts(:,2)
               pt(:,3) = .atom(a).position(3) + r*leb.pts(:,3)
               wt = wr*leb.wts
               .becke_grid.apply_partition(pt,wt,a,overlapping_atom)
               rho.create(n)
               .make_ED_grid_r_v2(rho,pt)
               S_used = sum(wt*rho)
               X_used = -0.75d0*(THREE/PI)**THIRD * sum(wt*rho**(FOUR/THREE))
               n_used = n
               rho.destroy
               wt.destroy
               pt.destroy
               leb.destroy
            end

            atom_err = atom_err + abs(X_used-X(6))
            atom_X   = atom_X + X_used
            n_atom_pts = n_atom_pts + n_used

            stdout.put(i,width=7)
            stdout.put(r,width=9,precision=4,fmt="f")
            stdout.put(L_used,width=7)
            stdout.put(n_used,width=7)
            stdout.put(S_used,width=13,precision=6,fmt="f")
            stdout.put(X_used,width=15,precision=8,fmt="f")
            stdout.put(X_used-X(6),width=11,precision=2,fmt="e")
            do k = 1,5
               stdout.put(X(k)-X(6),width=11,precision=2,fmt="e")
            end
            stdout.flush

         end

         stdout.flush
         stdout.show("  points on this atom's grid ..........",n_atom_pts)
         stdout.show("  X of this atom's grid ...............",atom_X)
         stdout.show("  sum over shells of |dX used| ........",atom_err)

      end

   end

   put_XC_batch_statistics :: leaky
   ! For batches of the molecular DFT grid: the number of batches, points
   ! per batch, significant basis functions per batch, and the costs
   ! sum(n_pts*n_sig) and sum(n_pts*n_sig^2), for per-atom batches, box
   ! batches (several cube edges and split limits) and radial-by-octant
   ! batches. A diagnostic for choosing the stage E batches (DEFERRED.md).
      self :: INOUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.becke_grid.allocated,"no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      hs :: VEC{REAL}(4)
      ms :: VEC{INT}(4)
      perm,first,last :: VEC{INT}@
      i,k,n :: INT

      hs = [ONE,1.5d0,TWO,THREE]
      ms = [64,128,256,512]

      if (.overlapping_atoms_for_atom.deallocated) .set_overlapping_atoms_for_atom
      if (.XC_pts.deallocated) .make_XC_grid
      n = .XC_pts.dim1

      stdout.flush
      stdout.text("===========================================")
      stdout.text("DFT grid: significant basis functions per batch")
      stdout.text("===========================================")
      stdout.flush
      stdout.show("Points in the grid .......",n)
      stdout.show("Basis function cutoff ....",.becke_grid.basis_fn_cutoff)
      stdout.flush
      stdout.text("  scheme   edge/bohr max_pts batches  mean_pts max_pts  mean_sig max_sig"// &
                  "   sum(n*s)   sum(n*s^2)")

      ! Per-atom batches, for reference
      perm.create(n)
      do i = 1,n
         perm(i) = i
      end
      first.create(.n_atom); first = .XC_first_pt
      last.create(.n_atom);  last  = .XC_last_pt
      .put_XC_batch_row("atom",ZERO,0,perm,first,last)
      perm.destroy; first.destroy; last.destroy

      do k = 1,4
         do i = 1,4
            .make_XC_box_batches(perm,first,last,hs(i),ms(k))
            .put_XC_batch_row("box",hs(i),ms(k),perm,first,last)
            perm.destroy; first.destroy; last.destroy
         end
         .make_XC_octant_batches(perm,first,last,ms(k))
         .put_XC_batch_row("octant",ZERO,ms(k),perm,first,last)
         perm.destroy; first.destroy; last.destroy
      end

   end

   put_XC_batch_row(scheme,h,max_pts,perm,first,last) :: private
   ! One row of put_XC_batch_statistics.
      self :: IN
      scheme :: STR, IN
      h :: REAL, IN
      max_pts :: INT, IN
      perm,first,last :: VEC{INT}, IN

      np :: VEC{INT}@
      mean_p,mean_s,cost1,cost2 :: REAL
      n_b,max_p,max_s :: INT

      n_b = first.dim
      np.create(n_b)
      np = last - first + 1
      max_p  = maxval(np)
      mean_p = sum(np)
      mean_p = mean_p/n_b
      np.destroy

      .get_XC_batch_costs(mean_s,max_s,cost1,cost2,perm,first,last)

      stdout.put(scheme,width=10)
      stdout.put(h,width=9,precision=2,fmt="f")
      stdout.put(max_pts,width=8)
      stdout.put(n_b,width=8)
      stdout.put(mean_p,width=10,precision=1,fmt="f")
      stdout.put(max_p,width=8)
      stdout.put(mean_s,width=10,precision=1,fmt="f")
      stdout.put(max_s,width=8)
      stdout.put(cost1,width=11,precision=3,fmt="e")
      stdout.put(cost2,width=13,precision=3,fmt="e")
      stdout.flush

   end

   get_XC_batch_costs(mean_s,max_s,cost1,cost2,perm,first,last) :: PURE
   ! For the batches perm(first(b):last(b)) of .XC_pts: the mean and largest
   ! number of significant basis functions "mean_s", "max_s", and the costs
   ! "cost1" = sum(n_pts*n_sig), "cost2" = sum(n_pts*n_sig^2). A shell is
   ! significant for a batch if its cutoff sphere reaches the bounding box
   ! of the batch's points, so it is kept whenever any point would keep it.
      self :: IN
      mean_s,cost1,cost2 :: REAL, OUT
      max_s :: INT, OUT
      perm,first,last :: VEC{INT}, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.XC_pts.allocated,"no XC grid")

      shell,first_shell,last_shell :: VEC{INT}@
      rn,rs :: REAL
      s,b,k,ns :: INT

      .make_XC_batch_shells(shell,first_shell,last_shell,perm,first,last)

      mean_s = ZERO
      max_s  = 0
      cost1  = ZERO
      cost2  = ZERO

      do b = 1,first.dim
         ns = 0
         do k = first_shell(b),last_shell(b)
            s = shell(k)
            ns = ns + .last_basis_fn_for_shell(s) - .first_basis_fn_for_shell(s) + 1
         end
         rn = last(b) - first(b) + 1
         rs = ns
         mean_s = mean_s + rs
         max_s  = max(max_s,ns)
         cost1  = cost1 + rn*rs
         cost2  = cost2 + rn*rs*rs
      end

      mean_s = mean_s/first.dim

      last_shell.destroy
      first_shell.destroy
      shell.destroy

   end

   make_XC_batches :: leaky, PURE
   ! Batch the molecular DFT grid for the XC quadrature: box batches with
   ! cubes of edge .becke_grid.XC_batch_box_edge and at most
   ! .becke_grid.XC_batch_max_pts points, each with its significant shells.
      self :: INOUT

   ENSURE(.XC_pts.allocated,"no XC grid")
   ENSURE(.basis_info_made,"no basis info")

      perm,first,last,shell,first_shell,last_shell :: VEC{INT}@

      .destroy_XC_batches

      .make_XC_box_batches(perm,first,last,.becke_grid.XC_batch_box_edge,.becke_grid.XC_batch_max_pts)
      .make_XC_batch_shells(shell,first_shell,last_shell,perm,first,last)

      .XC_batch_pt          = perm
      .XC_batch_first       = first
      .XC_batch_last        = last
      .XC_batch_shell       = shell
      .XC_batch_first_shell = first_shell
      .XC_batch_last_shell  = last_shell

      last_shell.destroy
      first_shell.destroy
      shell.destroy
      last.destroy
      first.destroy
      perm.destroy

   end

   make_XC_batch_shells(shell,first_shell,last_shell,perm,first,last) :: leaky, PURE
   ! For the batches perm(first(b):last(b)) of .XC_pts, the significant
   ! shells of batch "b", shell(first_shell(b):last_shell(b)): those whose
   ! basis_fn_cutoff sphere reaches the bounding box of the batch's points,
   ! so a shell is kept whenever any point of the batch would keep it.
      self :: IN
      shell,first_shell,last_shell :: VEC{INT}@, OUT
      perm,first,last :: VEC{INT}, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.XC_pts.allocated,"no XC grid")

      cen :: MAT{REAL}@
      r2m :: VEC{REAL}@
      lo,hi :: VEC{REAL}(3)
      cutoff,dd,d2 :: REAL
      s,b,q,p,j,n,n_b :: INT

      cutoff = .becke_grid.basis_fn_cutoff
      n_b = first.dim

      cen.create(3,.n_shell)
      r2m.create(.n_shell)
      do s = 1,.n_shell
         r2m(s) = .basis_shell1pair(.basis_shell_for_shell(s),1).a.r2_max(cutoff)
         cen(:,s) = .atom(.atom_for_shell(s)).position
      end

      shell.create(n_b*.n_shell)
      first_shell.create(n_b)
      last_shell.create(n_b)
      n = 0

      do b = 1,n_b

         lo =  huge(ONE)
         hi = -huge(ONE)
         do q = first(b),last(b)
            p = perm(q)
            do j = 1,3
               lo(j) = min(lo(j),.XC_pts(p,j))
               hi(j) = max(hi(j),.XC_pts(p,j))
            end
         end

         first_shell(b) = n + 1
         do s = 1,.n_shell
            d2 = ZERO
            do j = 1,3
               dd = max(ZERO,lo(j)-cen(j,s),cen(j,s)-hi(j))
               d2 = d2 + dd*dd
            end
            if (d2>r2m(s)) cycle
            n = n + 1
            shell(n) = s
         end
         last_shell(b) = n

      end

      shell.shrink(n)

      r2m.destroy
      cen.destroy

   end

   make_XC_box_batches(perm,first,last,h,max_pts) :: leaky, PURE
   ! Batch the molecular DFT grid spatially: cut the bounding box of .XC_pts
   ! into cubes of edge "h" (bohr), then split any cube holding more than
   ! "max_pts" points into octants until none does. Batch "b" is the points
   ! perm(first(b):last(b)); .XC_pts itself is not reordered.
      self :: IN
      perm,first,last :: VEC{INT}@, OUT
      h :: REAL, IN
      max_pts :: INT, IN

   ENSURE(.XC_pts.allocated,"no XC grid")
   ENSURE(h>ZERO,"cube edge must be positive")
   ENSURE(max_pts>0,"max_pts must be positive")

      lo,hi,c0 :: VEC{REAL}(3)
      nc :: VEC{INT}(3)
      oct_cnt,oct_pos :: VEC{INT}(8)
      cell,cnt,fill,codes,buf :: VEC{INT}@
      st_f,st_l :: VEC{INT}@
      st_h :: VEC{REAL}@
      st_c :: MAT{REAL}@
      hw :: REAL
      n,n_cell,n_leaf,n_st,cap,p,q,j,k,f,l,ix,iy,iz,code :: INT

      n = .XC_pts.dim1
      do j = 1,3
         lo(j) = minval(.XC_pts(:,j))
         hi(j) = maxval(.XC_pts(:,j))
         nc(j) = max(1,ceiling((hi(j)-lo(j))/h))
      end
      n_cell = nc(1)*nc(2)*nc(3)

      ! Bucket the points by cube: cube k is perm(cnt(k)+1:cnt(k+1))
      cell.create(n)
      cnt.create(n_cell+1)
      cnt = 0
      do p = 1,n
         ix = min(nc(1),1+int((.XC_pts(p,1)-lo(1))/h))
         iy = min(nc(2),1+int((.XC_pts(p,2)-lo(2))/h))
         iz = min(nc(3),1+int((.XC_pts(p,3)-lo(3))/h))
         k = ix + nc(1)*((iy-1) + nc(2)*(iz-1))
         cell(p) = k
         cnt(k+1) = cnt(k+1) + 1
      end
      do k = 2,n_cell+1
         cnt(k) = cnt(k) + cnt(k-1)
      end
      perm.create(n)
      fill.create(n_cell)
      fill = cnt(1:n_cell)
      do p = 1,n
         k = cell(p)
         fill(k) = fill(k) + 1
         perm(fill(k)) = p
      end
      fill.destroy
      cell.destroy

      ! Split over-full cubes by octants, depth first
      first.create(n)
      last.create(n)
      codes.create(n)
      buf.create(n)
      cap = 512
      st_f.create(cap)
      st_l.create(cap)
      st_h.create(cap)
      st_c.create(3,cap)
      n_leaf = 0

      do k = 1,n_cell

         f = cnt(k) + 1
         l = cnt(k+1)
         if (l<f) cycle

         iz = (k-1)/(nc(1)*nc(2))
         iy = (k-1-iz*nc(1)*nc(2))/nc(1)
         ix =  k-1-iz*nc(1)*nc(2) - iy*nc(1)
         n_st = 1
         st_f(1) = f
         st_l(1) = l
         st_h(1) = HALF*h
         st_c(1,1) = lo(1) + (ix+HALF)*h
         st_c(2,1) = lo(2) + (iy+HALF)*h
         st_c(3,1) = lo(3) + (iz+HALF)*h

         do while (n_st>0)

            f  = st_f(n_st)
            l  = st_l(n_st)
            hw = st_h(n_st)
            c0 = st_c(:,n_st)
            n_st = n_st - 1

            ! A batch; the size floor stops coincident points splitting forever
            if (l-f+1<=max_pts OR hw<1.0d-3) then
               n_leaf = n_leaf + 1
               first(n_leaf) = f
               last(n_leaf)  = l
               cycle
            end

            ! Reorder perm(f:l) by octant about the box centre
            oct_cnt = 0
            do q = f,l
               p = perm(q)
               code = 1
               if (.XC_pts(p,1)>c0(1)) code = code + 1
               if (.XC_pts(p,2)>c0(2)) code = code + 2
               if (.XC_pts(p,3)>c0(3)) code = code + 4
               codes(q) = code
               oct_cnt(code) = oct_cnt(code) + 1
            end
            oct_pos(1) = f - 1
            do j = 2,8
               oct_pos(j) = oct_pos(j-1) + oct_cnt(j-1)
            end
            do q = f,l
               code = codes(q)
               oct_pos(code) = oct_pos(code) + 1
               buf(oct_pos(code)) = perm(q)
            end
            perm(f:l) = buf(f:l)

            ! Push the non-empty octants
            q = f - 1
            do j = 1,8
               if (oct_cnt(j)>0) then
                  ENSURE(n_st<cap,"octree stack full")
                  n_st = n_st + 1
                  st_f(n_st) = q + 1
                  st_l(n_st) = q + oct_cnt(j)
                  st_h(n_st) = HALF*hw
                  st_c(1,n_st) = c0(1) + (2*mod(j-1,2)-1)*HALF*hw
                  st_c(2,n_st) = c0(2) + (2*mod((j-1)/2,2)-1)*HALF*hw
                  st_c(3,n_st) = c0(3) + (2*((j-1)/4)-1)*HALF*hw
               end
               q = q + oct_cnt(j)
            end

         end

      end

      first.shrink(n_leaf)
      last.shrink(n_leaf)

      st_c.destroy
      st_h.destroy
      st_l.destroy
      st_f.destroy
      buf.destroy
      codes.destroy
      cnt.destroy

   end

   make_XC_octant_batches(perm,first,last,max_pts) :: leaky, PURE
   ! Batch the molecular DFT grid per atom, by octant about the atom and then
   ! by radius, "max_pts" points at a time. The comparison for
   ! make_XC_box_batches.
      self :: IN
      perm,first,last :: VEC{INT}@, OUT
      max_pts :: INT, IN

   ENSURE(.XC_pts.allocated,"no XC grid")
   ENSURE(max_pts>0,"max_pts must be positive")

      key :: VEC{REAL}@
      idx,codes :: VEC{INT}@
      r0,d :: VEC{REAL}(3)
      n,n_leaf,a,f,l,m,q,p,code,f0 :: INT

      n = .XC_pts.dim1
      perm.create(n)
      first.create(n)
      last.create(n)
      n_leaf = 0

      do a = 1,.n_atom

         f = .XC_first_pt(a)
         l = .XC_last_pt(a)
         m = l - f + 1
         if (m<1) cycle

         r0 = .atom(a).position
         key.create(m)
         idx.create(m)
         codes.create(m)
         do q = 1,m
            p = f + q - 1
            d = .XC_pts(p,:) - r0
            code = 0
            if (d(1)>ZERO) code = code + 1
            if (d(2)>ZERO) code = code + 2
            if (d(3)>ZERO) code = code + 4
            codes(q) = code
            key(q) = code
            key(q) = 1000*key(q) + min(sqrt(dot_product(d,d)),999.0d0)
         end
         key.quick_sort(idx)

         ! Runs of one octant, cut every max_pts
         q = 1
         do while (q<=m)
            code = codes(idx(q))
            f0 = q
            do while (q<=m)
               if (codes(idx(q))/=code OR q-f0==max_pts) exit
               q = q + 1
            end
            n_leaf = n_leaf + 1
            first(n_leaf) = f - 1 + f0
            last(n_leaf)  = f - 1 + q - 1
            perm(f-1+f0:f-1+q-1) = f - 1 + idx(f0:q-1)
         end

         codes.destroy
         idx.destroy
         key.destroy

      end

      first.shrink(n_leaf)
      last.shrink(n_leaf)

   end

   make_XC_grid :: leaky, PURE
   ! Make the DFT integration grid for the whole molecule: every atom's
   ! partitioned grid, exactly as make_partitioned_grid returns it, laid
   ! end to end in .XC_pts/.XC_wts, with atom "a" occupying rows
   ! .XC_first_pt(a) to .XC_last_pt(a), and .XC_index holding each
   ! point's row in its unique-atom grid so the cached basis functions
   ! still apply. Built once per SCF, where the atom grids and their
   ! partition weights used to be rebuilt on every iteration. Points where
   ! the promolecule density is below .becke_grid.prune_rho_cutoff are
   ! dropped, if the atomic interpolators exist; the core is never touched.
   ! Never threshold on the weight: that was the 2026-09-10 grid defect
   ! (docs/DFT_STANDARDISATION.md 6b).
      self :: INOUT

   ENSURE(.becke_grid.allocated,"no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")

      pts :: VEC{EMAT{REAL}}@
      wts :: VEC{EVEC{REAL}}@
      ixs :: VEC{EVEC{INT}}@
      pt  :: MAT{REAL}@
      wt  :: VEC{REAL}@
      ix  :: MAT{REAL}@
      rho :: VEC{REAL}@
      overlapping_atom :: VEC{INT}@
      n_tot,c,f,l,k,n,b :: INT
      cut :: REAL
      prune :: BIN

      .destroy_XC_grid

      ! Prune by the promolecule density?
      cut   = .becke_grid.prune_rho_cutoff
      prune = cut>ZERO
      if (prune) prune = .atom.has_all_interpolators
      .XC_n_unpruned = 0
      .XC_first_pt.create(.n_atom)
      .XC_last_pt.create(.n_atom)

      ! The atom grids, one at a time
      pts.create(.n_atom)
      wts.create(.n_atom)
      ixs.create(.n_atom)
      n_tot = 0
      do c = 1,.n_atom
         overlapping_atom = .overlapping_atoms_for_atom(c).element
         .becke_grid.make_partitioned_grid(pt,wt,ix,c,overlapping_atom,index=TRUE)
         .XC_n_unpruned = .XC_n_unpruned + wt.dim
         if (prune) then
            rho.create(wt.dim)
            rho = ZERO
            do b = 1,overlapping_atom.dim
               .atom(overlapping_atom(b)).add_interpolated_density(rho,pt)
            end
            k = 0
            do n = 1,wt.dim
               if (rho(n)<cut) cycle
               k = k + 1
               pt(k,1) = pt(n,1)
               pt(k,2) = pt(n,2)
               pt(k,3) = pt(n,3)
               wt(k)   = wt(n)
               ix(k,1) = ix(n,1)
            end
            pt.shrink(k,3)
            wt.shrink(k)
            ix.shrink(k,1)
            rho.destroy
         end
         .XC_first_pt(c) = n_tot + 1
         n_tot = n_tot + wt.dim
         .XC_last_pt(c) = n_tot
         pts(c).element.create(pt.dim1,3)
         wts(c).element.create(wt.dim)
         ixs(c).element.create(wt.dim)
         pts(c).element = pt
         wts(c).element = wt
         do k = 1,wt.dim
            ixs(c)[k] = nint(ix(k,1))
         end
         ix.destroy
         pt.destroy
         wt.destroy
      end

      ! Lay them end to end
      .XC_pts.create(n_tot,3)
      .XC_wts.create(n_tot)
      .XC_index.create(n_tot)
      do c = 1,.n_atom
         f = .XC_first_pt(c)
         l = .XC_last_pt(c)
         .XC_pts(f:l,:) = pts(c).element
         .XC_wts(f:l)   = wts(c).element
         .XC_index(f:l) = ixs(c).element
      end

      ixs.destroy
      wts.destroy
      pts.destroy

   end

   get_XC_grid_for_atom(pt,wt,f0,c) :: leaky, PURE
   ! Return atom "c"'s slice of the molecular DFT grid and its own basis
   ! functions "f0" on it, building the grid first if it does not exist
   ! (a property job outside an SCF).
      self :: INOUT
      pt :: MAT{REAL}@, OUT
      wt :: VEC{REAL}@, OUT
      f0 :: MAT{REAL}@, OUT
      c  :: INT, IN

      f,l,n :: INT

      if (.XC_pts.deallocated) .make_XC_grid

      f = .XC_first_pt(c)
      l = .XC_last_pt(c)
      n = l - f + 1

      pt.create(n,3)
      wt.create(n)
      pt = .XC_pts(f:l,:)
      wt = .XC_wts(f:l)

      .becke_grid.get_atom_bf_grid(f0,c,.XC_index(f:l))

   end

   get_XC_grid_for_atom(pt,wt,f0,gx,gy,gz,c) :: leaky, PURE
   ! As above, with the gradients of the basis functions too.
      self :: INOUT
      pt :: MAT{REAL}@, OUT
      wt :: VEC{REAL}@, OUT
      f0 :: MAT{REAL}@, OUT
      gx,gy,gz :: MAT{REAL}@, OUT
      c  :: INT, IN

      f,l,n :: INT

      if (.XC_pts.deallocated) .make_XC_grid

      f = .XC_first_pt(c)
      l = .XC_last_pt(c)
      n = l - f + 1

      pt.create(n,3)
      wt.create(n)
      pt = .XC_pts(f:l,:)
      wt = .XC_wts(f:l)

      .becke_grid.get_atom_bf_grid(f0,gx,gy,gz,c,.XC_index(f:l))

   end

   make_rho_becke_atom_grid(N0,pt,wt,bf_skip,bf_grid0,c,D) :: leaky, PURE
   ! Make the density "N0" on the Becke grid ("pt","wt") for atom
   ! "c" given AO density matrix "D". Also return the "bf_skip" arrays
   ! and the "bf_grid0" array used for evaluating the rho (or other
   ! density functionals) on the grid.
      self :: INOUT
      N0 :: VEC{REAL}@, OUT
      pt :: MAT{REAL}@, OUT
      wt :: VEC{REAL}@, OUT
      bf_skip :: VEC{EVEC{BIN}}@, OUT
      bf_grid0 :: VEC{EMAT{REAL}}@, OUT
      c  :: INT, IN
      D  :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.density_mx.allocated,"no density matrix")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")

      xa,ya,za,a2 :: VEC{REAL}@
      ga0,gb0 :: VEC{REAL}@
      ra :: VEC{REAL}(3)
      overlapping_atom, pi,pj,pn :: VEC{INT}@
      skipa0,skipab, skipa,skipb :: VEC{BIN}@
      gridc0 :: MAT{REAL}@
      DD     :: MAT{REAL}@
      sha :: SHELL1
      cutoff, Dab, fac,val, ga,gb :: REAL
      n_pt,n_keep, ca,cb, oa,fsa,lsa,fba, ob,fsb,lsb :: INT
      sa,fa,la,na,ba, sb,fb,lb,nb, a,b,i,j,p,n :: INT

      ! Overlapping atoms
      overlapping_atom = .overlapping_atoms_for_atom(c).element

      ! Get the Becke grid for atom "c"
      .get_XC_grid_for_atom(pt,wt,gridc0,c)
      n_pt = pt.dim1

      ! Create N0
      N0.create(n_pt)
      N0 = ZERO

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Basis function grid and skip list
      bf_skip.create(.n_shell)
      bf_grid0.create(.n_shell)

      ! Atom "a" displaced points (from "c") and skip switches
      xa.create(n_pt)
      ya.create(n_pt)
      za.create(n_pt)
      a2.create(n_pt)
      skipa0.create(n_pt)
      skipab.create(n_pt)

      ! Loop c-overlapping atoms "oa"
      do ca = 1,overlapping_atom.dim

         oa  = overlapping_atom(ca)
         fsa = .first_shell_for_atom(oa)
         lsa =  .last_shell_for_atom(oa)
         fba = .first_basis_fn_for_atom(oa)
         ra  = .atom(oa).position

         ! Make the displaced points for atom "oa"
         .atom(oa).make_displaced_skip_pts(xa,ya,za,a2,skipa0,pt,n_pt,cutoff)

         ! Loop shells on atom a
         do sa = fsa,lsa

            fa = .first_basis_fn_for_shell(sa)
            la =  .last_basis_fn_for_shell(sa)
            na = la - fa + 1

            ! Set shell "sa"
            ba  = .basis_shell_for_shell(sa)
            sha = .basis_shell1pair(ba,1).a
            sha.position = ra

            ! Make shell "sa" skipa list
            skipa.create(n_pt)
            sha.make_skip_list(skipa,n_keep,a2,skipa0,n_pt,cutoff)

            ! Next shell "sa" if no sig. points
            if (n_keep==0) then
               skipa.destroy
               cycle
            end

            ! Assign the "sa" skipa list
            bf_skip(sa).element.create(skipa.dim)
            bf_skip(sa).element = skipa

            ! Make/copy the "sa" basis function grid
            ! This must be copied since skipa could be TRUE
            bf_grid0(sa).element.create(n_keep,na)
            if (oa==c) then
               do a = 1,na
                  i = 0
                  do n = 1,n_pt
                     if (skipa(n)) cycle
                     i = i + 1
                     bf_grid0(sa)[i,a] = gridc0(n,a+fa-fba)
                  end
               end
            else
               sha.make_skip_grid( &
                  bf_grid0(sa).element, &
                  n_keep,xa,ya,za,a2,skipa,n_pt)
            end

            ! Loop c-overlapping atoms b
            do cb = 1,ca

               ob  = overlapping_atom(cb)
               fsb = .first_shell_for_atom(ob)
               lsb =  .last_shell_for_atom(ob)

               ! Loop shells on atom b
               do sb = fsb,min(lsb,sa)

                  if (bf_skip(sb).element.deallocated) cycle

                  fb = .first_basis_fn_for_shell(sb)
                  lb = .last_basis_fn_for_shell(sb)
                  nb = lb - fb + 1

                  ! Set the "sb" basis function grid
                  skipb = bf_skip(sb).element

                  ! How many points in common?
                  skipab(1:n_pt) = skipa OR skipb
                  n_keep = count(NOT skipab(1:n_pt))
                  if (n_keep==0) cycle

                  ! Factor
                  fac = TWO
                  if (sa==sb) fac = ONE

                  ! Density block
                  DD = D(fa:la,fb:lb)

                  if (na*nb==1) then

                     ga0 = bf_grid0(sa)[:,1]
                     gb0 = bf_grid0(sb)[:,1]
                     Dab = fac*DD(1,1)

                     i = 0
                     j = 0
                     do n = 1,n_pt
                        if (NOT skipa(n)) i = i + 1
                        if (NOT skipb(n)) j = j + 1
                        if (skipab(n)) cycle
                        ga = ga0(i)
                        gb = gb0(j)
                        val = ga*gb*Dab
                        N0(n) = N0(n) + val
                     end

                  else

                     ! Create space for gathered index info
                     pi.create(n_keep)
                     pj.create(n_keep)
                     pn.create(n_keep)

                     ! Make mapper arrays
                     p = 0
                     i = 0
                     j = 0
                     do n = 1,n_pt
                        if (NOT skipa(n)) i = i + 1
                        if (NOT skipb(n)) j = j + 1
                        if (skipab(n)) cycle
                        p = p + 1
                        pi(p) = i
                        pj(p) = j
                        pn(p) = n
                     end

                     ! Add density contribution to rho
                     do a = 1,na
                        ga0 = bf_grid0(sa)[:,a]
                        do b = 1,nb
                           gb0 = bf_grid0(sb)[:,b]
                           Dab = fac*DD(a,b)
                           do p = 1,n_keep
                              i = pi(p)
                              j = pj(p)
                              n = pn(p)
                              ga = ga0(i)
                              gb = gb0(j)
                              val = ga*gb*Dab
                              N0(n) = N0(n) + val
                           end
                        end
                     end

                     ! Clean up
                     pn.destroy
                     pj.destroy
                     pi.destroy

                  end

               end ! -- loops sa,sb
            end
         end       ! -- lops ca,cb
      end

      ! Clean up
      skipab.destroy; skipa0.destroy
      a2.destroy
      za.destroy
      ya.destroy
      xa.destroy
      gridc0.destroy

   end

   make_rho_becke_atom_grid(N0,Nx,Ny,Nz,pt,wt,bf_skip,bf_gr0,bf_grx,bf_gry,bf_grz,c,D) :: leaky, PURE
   ! Make the density "N0" and its derivatives "Nx", "Ny", "Nz", on
   ! the Becke grid ("pt","wt") for atom "c" given AO density matrix
   ! "D". Also return the "bf_skip" array, and the basis function and
   ! basis function derivative arrays "bf_gr0", "bf_grx", "bf_gry", 
   ! "bf_grz" used for evaluating the density functionals on the grid.
      self :: INOUT
      N0,Nx,Ny,Nz :: VEC{REAL}@, OUT
      pt :: MAT{REAL}@, OUT
      wt :: VEC{REAL}@, OUT
      bf_skip :: VEC{EVEC{BIN}}@, OUT
      bf_gr0 :: VEC{EMAT{REAL}}@, OUT
      bf_grx,bf_gry,bf_grz :: VEC{EMAT{REAL}}@, OUT
      c  :: INT, IN
      D  :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.density_mx.allocated,"no density matrix")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")

      xa,ya,za,a2 :: VEC{REAL}@
      ra :: VEC{REAL}(3)
      overlapping_atom, pi,pj,pn :: VEC{INT}@
      skipa0,skipab, skipa :: VEC{BIN}@
      gridc0,gridcx,gridcy,gridcz :: MAT{REAL}@
      sha :: SHELL1
      cutoff, Dab, fac, ga,gb :: REAL
      n_pt,n_keep, ca,cb, oa,fsa,lsa,fba,offset, ob,fsb,lsb :: INT
      sa,fa,la,na,ba, sb,fb,lb,nb, a,b,i,j,p,n :: INT

      ! Overlapping atoms
      overlapping_atom = .overlapping_atoms_for_atom(c).element

      ! Get the Becke grid for atom "c"
      .get_XC_grid_for_atom(pt,wt,gridc0,gridcx,gridcy,gridcz,c)
      n_pt = pt.dim1

      ! Create N0
      N0.create(n_pt); N0 = ZERO
      Nx.create(n_pt); Nx = ZERO
      Ny.create(n_pt); Ny = ZERO
      Nz.create(n_pt); Nz = ZERO

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Basis function grid and skip list
      bf_skip.create(.n_shell)
      bf_gr0.create(.n_shell)
      bf_grx.create(.n_shell)
      bf_gry.create(.n_shell)
      bf_grz.create(.n_shell)

      ! Atom "a" displaced points (from "c") and skip switches
      xa.create(n_pt)
      ya.create(n_pt)
      za.create(n_pt)
      a2.create(n_pt)
      skipa0.create(n_pt)
      skipab.create(n_pt)
      pi.create(n_pt)
      pj.create(n_pt)
      pn.create(n_pt)

      ! Loop c-overlapping atoms "oa"
      do ca = 1,overlapping_atom.dim

         oa  = overlapping_atom(ca)
         fsa = .first_shell_for_atom(oa)
         lsa =  .last_shell_for_atom(oa)
         fba = .first_basis_fn_for_atom(oa)
         ra  = .atom(oa).position

         ! Make the displaced points for atom "oa"
         .atom(oa).make_displaced_skip_pts(xa,ya,za,a2,skipa0,pt,n_pt,cutoff)

         ! Loop shells on atom a
         do sa = fsa,lsa

            fa = .first_basis_fn_for_shell(sa)
            la =  .last_basis_fn_for_shell(sa)
            na = la - fa + 1

            ! Set shell "sa"
            ba  = .basis_shell_for_shell(sa)
            sha = .basis_shell1pair(ba,1).a
            sha.position = ra

            ! Make shell "sa" skipa list
            skipa.create(n_pt)
            sha.make_skip_list(skipa,n_keep,a2,skipa0,n_pt,cutoff)

            ! Next shell "sa" if no sig. points
            if (n_keep==0) then
               skipa.destroy
               cycle
            end

            ! Assign the "sa" skipa list
            bf_skip(sa).element.create(skipa.dim)
            bf_skip(sa).element = skipa

            ! Make/copy the "sa" basis function grid
            ! This must be copied since skipa could be TRUE
            bf_gr0(sa).element.create(n_keep,na)
            bf_grx(sa).element.create(n_keep,na)
            bf_gry(sa).element.create(n_keep,na)
            bf_grz(sa).element.create(n_keep,na)
            if (oa==c) then
               offset = fa-fba
               do a = 1,na
                  i = 0
                  do n = 1,n_pt
                     if (skipa(n)) cycle
                     i = i + 1
                     bf_gr0(sa)[i,a] = gridc0(n,a+offset)
                     bf_grx(sa)[i,a] = gridcx(n,a+offset)
                     bf_gry(sa)[i,a] = gridcy(n,a+offset)
                     bf_grz(sa)[i,a] = gridcz(n,a+offset)
                  end
               end
            else
               sha.make_skip_nabla_grid( &
                  bf_grx(sa).element,  &
                  bf_gry(sa).element,  &
                  bf_grz(sa).element,  &
                  bf_gr0(sa).element,  &
                  n_keep,xa,ya,za,a2,skipa,n_pt)
            end

            ! Loop c-overlapping atoms b
            do cb = 1,ca

               ob  = overlapping_atom(cb)
               fsb = .first_shell_for_atom(ob)
               lsb =  .last_shell_for_atom(ob)

               ! Loop shells on atom b
               do sb = fsb,min(lsb,sa)

                  if (bf_skip(sb).element.deallocated) cycle

                  fb = .first_basis_fn_for_shell(sb)
                  lb = .last_basis_fn_for_shell(sb)
                  nb = lb - fb + 1

                  ! How many points in common?
                  skipab(1:n_pt) = skipa OR bf_skip(sb).element
                  n_keep = count(NOT skipab(1:n_pt))
                  if (n_keep==0) cycle

                  ! Factor
                  fac = TWO
                  if (sa==sb) fac = ONE

                  ! Map common points to the "sa" and "sb" grids
                  p = 0
                  i = 0
                  j = 0
                  do n = 1,n_pt
                     if (NOT skipa(n)) i = i + 1
                     if (NOT bf_skip(sb)[n]) j = j + 1
                     if (skipab(n)) cycle
                     p = p + 1
                     pi(p) = i
                     pj(p) = j
                     pn(p) = n
                  end

                  ! Add density contribution to rho; grids read in place
                  do a = 1,na
                     do b = 1,nb
                        Dab = fac*D(fa+a-1,fb+b-1)
                        do p = 1,n_keep
                           i = pi(p)
                           j = pj(p)
                           n = pn(p)
                           ga = bf_gr0(sa)[i,a]
                           gb = bf_gr0(sb)[j,b]
                           N0(n) = N0(n) + Dab* ga*gb
                           Nx(n) = Nx(n) + Dab*(bf_grx(sa)[i,a]*gb + ga*bf_grx(sb)[j,b])
                           Ny(n) = Ny(n) + Dab*(bf_gry(sa)[i,a]*gb + ga*bf_gry(sb)[j,b])
                           Nz(n) = Nz(n) + Dab*(bf_grz(sa)[i,a]*gb + ga*bf_grz(sb)[j,b])
                        end
                     end
                  end

               end ! -- loops sa,sb
            end
         end       ! -- lops ca,cb
      end

      ! Clean up
      pn.destroy
      pj.destroy
      pi.destroy
      skipab.destroy
      skipa0.destroy
      a2.destroy
      za.destroy
      ya.destroy
      xa.destroy
      gridcz.destroy
      gridcy.destroy
      gridcx.destroy
      gridc0.destroy

   end

   make_rho_becke_atom_grid(N0a,N0b,pt,wt,bf_skip,bf_grid0,c,Da,Db) :: leaky, PURE
   ! Make the alpha and beta densities "N0a", "N0b" on the Becke grid
   ! ("pt","wt") for atom "c" given AO density matrices "Da", "Db".
   ! Also return the "bf_skip" arrays and the "bf_grid0" array used
   ! for evaluating the density (or density functionals) on the grid.
      self :: INOUT
      N0a,N0b :: VEC{REAL}@, OUT
      pt :: MAT{REAL}@, OUT
      wt :: VEC{REAL}@, OUT
      bf_skip :: VEC{EVEC{BIN}}@, OUT
      bf_grid0 :: VEC{EMAT{REAL}}@, OUT
      c  :: INT, IN
      Da,Db  :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")

      xa,ya,za,a2 :: VEC{REAL}@
      ga0,gb0 :: VEC{REAL}@
      ra :: VEC{REAL}(3)
      overlapping_atom, pi,pj,pn :: VEC{INT}@
      skipa0,skipab, skipa,skipb :: VEC{BIN}@
      gridc0  :: MAT{REAL}@
      DDa,DDb :: MAT{REAL}@
      sha :: SHELL1
      cutoff, Da_ab,Db_ab, fac, ga,gb,gab :: REAL
      n_pt,n_keep, ca,cb, oa,fsa,lsa,fba, ob,fsb,lsb :: INT
      sa,fa,la,na,ba, sb,fb,lb,nb, a,b,i,j,p,n :: INT

      ! Overlapping atoms
      overlapping_atom = .overlapping_atoms_for_atom(c).element

      ! Get the Becke grid for atom "c"
      .get_XC_grid_for_atom(pt,wt,gridc0,c)
      n_pt = pt.dim1

      ! Create N0a, N0b
      N0a.create(n_pt); N0a = ZERO
      N0b.create(n_pt); N0b = ZERO

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Basis function grid and skip list
      bf_skip.create(.n_shell)
      bf_grid0.create(.n_shell)

      ! Atom "a" displaced points (from "c") and skip switches
      xa.create(n_pt)
      ya.create(n_pt)
      za.create(n_pt)
      a2.create(n_pt)
      skipa0.create(n_pt)
      skipab.create(n_pt)

      ! Loop c-overlapping atoms "oa"
      do ca = 1,overlapping_atom.dim

         oa  = overlapping_atom(ca)
         fsa = .first_shell_for_atom(oa)
         lsa =  .last_shell_for_atom(oa)
         fba = .first_basis_fn_for_atom(oa)
         ra  = .atom(oa).position

         ! Make the displaced points for atom "oa"
         .atom(oa).make_displaced_skip_pts(xa,ya,za,a2,skipa0,pt,n_pt,cutoff)

         ! Loop shells on atom a
         do sa = fsa,lsa

            fa = .first_basis_fn_for_shell(sa)
            la =  .last_basis_fn_for_shell(sa)
            na = la - fa + 1

            ! Set shell "sa"
            ba  = .basis_shell_for_shell(sa)
            sha = .basis_shell1pair(ba,1).a
            sha.position = ra

            ! Make shell "sa" skipa list
            skipa.create(n_pt)
            sha.make_skip_list(skipa,n_keep,a2,skipa0,n_pt,cutoff)

            ! Next shell "sa" if no sig. points
            if (n_keep==0) then
               skipa.destroy
               cycle
            end

            ! Assign the "sa" skipa list
            bf_skip(sa).element.create(skipa.dim)
            bf_skip(sa).element = skipa

            ! Make/copy the "sa" basis function grid
            ! This must be copied since skipa could be TRUE
            bf_grid0(sa).element.create(n_keep,na)
            if (oa==c) then
               do a = 1,na
                  i = 0
                  do n = 1,n_pt
                     if (skipa(n)) cycle
                     i = i + 1
                     bf_grid0(sa)[i,a] = gridc0(n,a+fa-fba)
                  end
               end
            else
               sha.make_skip_grid(bf_grid0(sa).element,n_keep,xa,ya,za,a2,skipa,n_pt)
            end

            ! Loop c-overlapping atoms b
            do cb = 1,ca

               ob  = overlapping_atom(cb)
               fsb = .first_shell_for_atom(ob)
               lsb =  .last_shell_for_atom(ob)

               ! Loop shells on atom b
               do sb = fsb,min(lsb,sa)

                  if (bf_skip(sb).element.deallocated) cycle

                  fb = .first_basis_fn_for_shell(sb)
                  lb = .last_basis_fn_for_shell(sb)
                  nb = lb - fb + 1

                  ! Set the "sb" basis function grid
                  skipb = bf_skip(sb).element

                  ! How many points in common?
                  skipab(1:n_pt) = skipa OR skipb
                  n_keep = count(NOT skipab(1:n_pt))
                  if (n_keep==0) cycle

                  ! Factor
                  fac = TWO
                  if (sa==sb) fac = ONE

                  ! Density block
                  DDa = Da(fa:la,fb:lb)
                  DDb = Db(fa:la,fb:lb)

                  if (na*nb==1) then

                     ga0 = bf_grid0(sa)[:,1]
                     gb0 = bf_grid0(sb)[:,1]

                     Da_ab = fac*DDa(1,1)
                     Db_ab = fac*DDb(1,1)

                     i = 0
                     j = 0
                     do n = 1,n_pt
                        if (NOT skipa(n)) i = i + 1
                        if (NOT skipb(n)) j = j + 1
                        if (skipab(n)) cycle
                        ga = ga0(i)
                        gb = gb0(j)
                        gab = ga*gb
                        N0a(n) = N0a(n) + Da_ab*gab
                        N0b(n) = N0b(n) + Db_ab*gab
                     end

                  else

                     ! Create space for gathered index info
                     pi.create(n_keep)
                     pj.create(n_keep)
                     pn.create(n_keep)

                     ! Make mapper arrays
                     p = 0
                     i = 0
                     j = 0
                     do n = 1,n_pt
                        if (NOT skipa(n)) i = i + 1
                        if (NOT skipb(n)) j = j + 1
                        if (skipab(n)) cycle
                        p = p + 1
                        pi(p) = i
                        pj(p) = j
                        pn(p) = n
                     end

                     ! Add density contribution to rho
                     do a = 1,na
                        ga0 = bf_grid0(sa)[:,a]
                        do b = 1,nb
                           gb0 = bf_grid0(sb)[:,b]
                           Da_ab = fac*DDa(a,b)
                           Db_ab = fac*DDb(a,b)
                           do p = 1,n_keep
                              i = pi(p)
                              j = pj(p)
                              n = pn(p)
                              ga = ga0(i)
                              gb = gb0(j)
                              gab = ga*gb
                              N0a(n) = N0a(n) + Da_ab*gab
                              N0b(n) = N0b(n) + Db_ab*gab
                           end
                        end
                     end

                     ! Clean up
                     pn.destroy
                     pj.destroy
                     pi.destroy

                  end

               end ! -- loops sa,sb
            end
         end       ! -- lops ca,cb
      end

      ! Clean up
      skipab.destroy; skipa0.destroy
      a2.destroy
      za.destroy
      ya.destroy
      xa.destroy
      gridc0.destroy

   end

   make_rho_becke_atom_grid(N0a,N0b,Nxa,Nya,Nza,Nxb,Nyb,Nzb,pt,wt,bf_skip,bf_gr0,bf_grx,bf_gry,bf_grz,c,Da,Db) :: leaky, PURE
   ! Make the densities "N0a", "N0b" and their alpha/beta derivatives
   ! "Nxa", "Nya", "Nza", "Nxb", "Nyb", "Nzb", on the Becke grid
   ! ("pt","wt") for atom "c" given AO density matrices "Da", "Db".
   ! Also return the "bf_skip" array, and the basis function and basis
   ! function derivative arrays "bf_gr0", "bf_grx", "bf_gry",
   ! "bf_grz" for evaluating the density functionals on the grid.
      self :: INOUT
      N0a,N0b :: VEC{REAL}@, OUT
      Nxa,Nya,Nza :: VEC{REAL}@, OUT
      Nxb,Nyb,Nzb :: VEC{REAL}@, OUT
      pt :: MAT{REAL}@, OUT
      wt :: VEC{REAL}@, OUT
      bf_skip :: VEC{EVEC{BIN}}@, OUT
      bf_gr0,bf_grx,bf_gry,bf_grz :: VEC{EMAT{REAL}}@, OUT
      c  :: INT, IN
      Da,Db :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")

      xa,ya,za,a2 :: VEC{REAL}@
      ga0,gax,gay,gaz :: VEC{REAL}@
      gb0,gbx,gby,gbz :: VEC{REAL}@
      ra :: VEC{REAL}(3)
      overlapping_atom, pi,pj,pn :: VEC{INT}@
      skipa0,skipab, skipa,skipb :: VEC{BIN}@
      DDa,DDb :: MAT{REAL}@
      gridc0,gridcx,gridcy,gridcz :: MAT{REAL}@
      sha :: SHELL1
      cutoff, Da_ab,Db_ab, fac, ga,gb,gab,gx,gy,gz :: REAL
      n_pt,n_keep, ca,cb, oa,fsa,lsa,fba,offset, ob,fsb,lsb :: INT
      sa,fa,la,na,ba, sb,fb,lb,nb, a,b,i,j,p,n :: INT

      ! Overlapping atoms
      overlapping_atom = .overlapping_atoms_for_atom(c).element

      ! Get the Becke grid for atom "c"
      .get_XC_grid_for_atom(pt,wt,gridc0,gridcx,gridcy,gridcz,c)
      n_pt = pt.dim1

      ! Create N0 arrays
      N0a.create(n_pt); Nxa.create(n_pt); Nya.create(n_pt); Nza.create(n_pt)
      N0b.create(n_pt); Nxb.create(n_pt); Nyb.create(n_pt); Nzb.create(n_pt)
      N0a = ZERO; Nxa = ZERO; Nya = ZERO; Nza = ZERO
      N0b = ZERO; Nxb = ZERO; Nyb = ZERO; Nzb = ZERO

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Basis function grid and skip list
      bf_skip.create(.n_shell)
      bf_gr0.create(.n_shell)
      bf_grx.create(.n_shell)
      bf_gry.create(.n_shell)
      bf_grz.create(.n_shell)

      ! Atom "a" displaced points (from "c") and skip switches
      xa.create(n_pt)
      ya.create(n_pt)
      za.create(n_pt)
      a2.create(n_pt)
      skipa0.create(n_pt)
      skipab.create(n_pt)

      ! Loop c-overlapping atoms "oa"
      do ca = 1,overlapping_atom.dim

         oa  = overlapping_atom(ca)
         fsa = .first_shell_for_atom(oa)
         lsa =  .last_shell_for_atom(oa)
         fba = .first_basis_fn_for_atom(oa)
         ra  = .atom(oa).position

         ! Make the displaced points for atom "oa"
         .atom(oa).make_displaced_skip_pts(xa,ya,za,a2,skipa0,pt,n_pt,cutoff)

         ! Loop shells on atom a
         do sa = fsa,lsa

            fa = .first_basis_fn_for_shell(sa)
            la =  .last_basis_fn_for_shell(sa)
            na = la - fa + 1

            ! Set shell "sa"
            ba  = .basis_shell_for_shell(sa)
            sha = .basis_shell1pair(ba,1).a
            sha.position = ra

            ! Make shell "sa" skipa list
            skipa.create(n_pt)
            sha.make_skip_list(skipa,n_keep,a2,skipa0,n_pt,cutoff)

            ! Next shell "sa" if no sig. points
            if (n_keep==0) then
               skipa.destroy
               cycle
            end

            ! Assign the "sa" skipa list
            bf_skip(sa).element.create(skipa.dim)
            bf_skip(sa).element = skipa

            ! Make/copy the "sa" basis function grid
            ! This must be copied since skipa could be TRUE
            bf_gr0(sa).element.create(n_keep,na)
            bf_grx(sa).element.create(n_keep,na)
            bf_gry(sa).element.create(n_keep,na)
            bf_grz(sa).element.create(n_keep,na)
            if (oa==c) then
               offset = fa-fba
               do a = 1,na
                  i = 0
                  do n = 1,n_pt
                     if (skipa(n)) cycle
                     i = i + 1
                     bf_gr0(sa)[i,a] = gridc0(n,a+offset)
                     bf_grx(sa)[i,a] = gridcx(n,a+offset)
                     bf_gry(sa)[i,a] = gridcy(n,a+offset)
                     bf_grz(sa)[i,a] = gridcz(n,a+offset)
                  end
               end
            else
               sha.make_skip_nabla_grid( &
                  bf_grx(sa).element,  &
                  bf_gry(sa).element,  &
                  bf_grz(sa).element,  &
                  bf_gr0(sa).element,  &
                  n_keep,xa,ya,za,a2,skipa,n_pt)
            end

            ! Loop c-overlapping atoms b
            do cb = 1,ca

               ob  = overlapping_atom(cb)
               fsb = .first_shell_for_atom(ob)
               lsb =  .last_shell_for_atom(ob)

               ! Loop shells on atom b
               do sb = fsb,min(lsb,sa)

                  if (bf_skip(sb).element.deallocated) cycle

                  fb = .first_basis_fn_for_shell(sb)
                  lb = .last_basis_fn_for_shell(sb)
                  nb = lb - fb + 1

                  ! Set the "sb" basis function grid
                  skipb = bf_skip(sb).element

                  ! How many points in common?
                  skipab(1:n_pt) = skipa OR skipb
                  n_keep = count(NOT skipab(1:n_pt))
                  if (n_keep==0) cycle

                  ! Factor
                  fac = TWO
                  if (sa==sb) fac = ONE

                  ! Density block
                  DDa = Da(fa:la,fb:lb)
                  DDb = Db(fa:la,fb:lb)

                  if (na*nb==1) then

                     ga0 = bf_gr0(sa)[:,1]
                     gax = bf_grx(sa)[:,1]
                     gay = bf_gry(sa)[:,1]
                     gaz = bf_grz(sa)[:,1]

                     gb0 = bf_gr0(sb)[:,1]
                     gbx = bf_grx(sb)[:,1]
                     gby = bf_gry(sb)[:,1]
                     gbz = bf_grz(sb)[:,1]

                     Da_ab = fac*DDa(1,1)
                     Db_ab = fac*DDb(1,1)

                     i = 0
                     j = 0
                     do n = 1,n_pt
                        if (NOT skipa(n)) i = i + 1
                        if (NOT skipb(n)) j = j + 1
                        if (skipab(n)) cycle
                        ga = ga0(i)
                        gb = gb0(j)
                        gab = ga*gb
                        gx  = gax(i)*gb+ga*gbx(j)
                        gy  = gay(i)*gb+ga*gby(j)
                        gz  = gaz(i)*gb+ga*gbz(j)

                        N0a(n) = N0a(n) + Da_ab*gab
                        Nxa(n) = Nxa(n) + Da_ab*gx
                        Nya(n) = Nya(n) + Da_ab*gy
                        Nza(n) = Nza(n) + Da_ab*gz

                        N0b(n) = N0b(n) + Db_ab*gab
                        Nxb(n) = Nxb(n) + Db_ab*gx
                        Nyb(n) = Nyb(n) + Db_ab*gy
                        Nzb(n) = Nzb(n) + Db_ab*gz

                     end

                  else

                     ! Create space for gathered index info
                     pi.create(n_keep)
                     pj.create(n_keep)
                     pn.create(n_keep)

                     ! Make mapper arrays
                     p = 0
                     i = 0
                     j = 0
                     do n = 1,n_pt
                        if (NOT skipa(n)) i = i + 1
                        if (NOT skipb(n)) j = j + 1
                        if (skipab(n)) cycle
                        p = p + 1
                        pi(p) = i
                        pj(p) = j
                        pn(p) = n
                     end

                     ! Add density contribution to rho
                     do a = 1,na
                        ga0 = bf_gr0(sa)[:,a]
                        gax = bf_grx(sa)[:,a]
                        gay = bf_gry(sa)[:,a]
                        gaz = bf_grz(sa)[:,a]
                        do b = 1,nb
                           gb0 = bf_gr0(sb)[:,b]
                           gbx = bf_grx(sb)[:,b]
                           gby = bf_gry(sb)[:,b]
                           gbz = bf_grz(sb)[:,b]
                           Da_ab = fac*DDa(a,b)
                           Db_ab = fac*DDb(a,b)

                           do p = 1,n_keep
                              i = pi(p)
                              j = pj(p)
                              n = pn(p)

                              ga  = ga0(i)
                              gb  = gb0(j)
                              gab = ga*gb
                              gx  = gax(i)*gb+ga*gbx(j)
                              gy  = gay(i)*gb+ga*gby(j)
                              gz  = gaz(i)*gb+ga*gbz(j)

                              N0a(n) = N0a(n) + Da_ab*gab
                              Nxa(n) = Nxa(n) + Da_ab*gx
                              Nya(n) = Nya(n) + Da_ab*gy
                              Nza(n) = Nza(n) + Da_ab*gz

                              N0b(n) = N0b(n) + Db_ab*gab
                              Nxb(n) = Nxb(n) + Db_ab*gx
                              Nyb(n) = Nyb(n) + Db_ab*gy
                              Nzb(n) = Nzb(n) + Db_ab*gz

                           end

                        end
                     end

                     ! Clean up
                     pn.destroy
                     pj.destroy
                     pi.destroy

                  end

               end ! -- loops sa,sb
            end
         end       ! -- lops ca,cb
      end

      ! Clean up
      skipab.destroy
      skipa0.destroy
      a2.destroy
      za.destroy
      ya.destroy
      xa.destroy
      gridcz.destroy
      gridcy.destroy
      gridcx.destroy
      gridc0.destroy

   end

!  ======================
!  Set interpolator grids
!  ======================

! For faster Hirshfeld weight function evaluation

   make_ANO_interpolators :: leaky
   ! Get the gaussian ANO interpolators. Note that for gaussian ANO
   ! interpolators the atom.basis_kind's must have been "gaussian" at
   ! the time the interpolator was made.
      self :: INOUT

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom(1).basis_kind=="gaussian","the basis_kind is not gaussian!")
   ENSURE(.n_atom_kind>0,"no atom kinds set")

      template :: INTERPOLATOR@
      a,b :: INT
      done :: VEC{BIN}@

      ! Already there?
      if (.has_all_interpolators) return

      done.create(.n_atom)
      done = FALSE

      do a = 1,.n_atom

         ! Skip?
         if (done(a)) cycle

         ! Make the interpolator
         if (.atom(a).interpolator.deallocated) then
            if (.interpolator.allocated) then
               .atom(a).make_interpolator(.interpolator)
            else
               .make_interpolator_sqrt_x1x(template)
               .atom(a).make_interpolator(template)
               template.destroy
            end
         end

         done(a) = TRUE

         ! Copy interpolartor to other atoms
         do b = a+1,.n_atom
            ! Skip?
            if (done(b)) cycle
            if (NOT .atom(b).is_same_kind_as(.atom(a))) cycle
            ! Copy 
            .atom(b).interpolator = .atom(a).interpolator
            done(b) = TRUE
         end

      end

      done.destroy 

   end

   make_slater_interpolators :: leaky
   ! Make the slaterbasis orbital density interpolators.
   ! Make them using the defaults set in a give "interpolator".
      self :: INOUT

   ENSURE(.slaterbasis.allocated,"no slaterbasis")

      template :: INTERPOLATOR@
      i :: INT

   ! stdout.flush
   ! stdout.text("Making slater interpolators ...")

      ! Make the interpolators
      if (.interpolator.allocated) then

         ! User defined interpolator
         do i = 1,.slaterbasis.dim
            .slaterbasis(i).make_interpolator(.interpolator)
         end

      else

         ! Default interpolator
         .make_interpolator_sqrt(template)
         do i = 1,.slaterbasis.dim
            .slaterbasis(i).make_interpolator(template)
         end
         template.destroy

      end

      ! Set .atom to use this interpolator
      if (.atom.allocated) .atom.set_basis_kind("slater")

   end

   make_coppens_interpolators :: leaky
   ! Make the coppensbasis orbital density interpolators.
   ! Make them using the defaults set in a give "interpolator".
   ! Otherwise use an atom density cutoff "tol".
   ! NOTE: any existing interpolators are destroyed first
      self :: INOUT

   ENSURE(.coppensbasis.allocated,"no slaterbasis")

      template :: INTERPOLATOR@
      i :: INT

      stdout.flush
      stdout.text("Making coppens interpolators ...")

      ! Make the interpolators
      if (.interpolator.allocated) then

         do i = 1,.coppensbasis.dim  ! Make the interpolators
            .coppensbasis(i).make_interpolator(.interpolator)
         end

      else

         .make_interpolator_sqrt(template)
         do i = 1,.coppensbasis.dim  ! Make the interpolators
            .coppensbasis(i).make_interpolator(template)
         end
         template.destroy

      end

      ! Set .atom to use this interpolator
      if (.atom.allocated) .atom.set_basis_kind("coppens")

   end

   make_interpolator_sqrt(interpolator) :: leaky
   ! Make a non-gaussian interpolator. These typically used for
   ! stockholder weight functions.
      self :: IN
      interpolator :: INTERPOLATOR@

      cluster :: CLUSTER

      ! Create default interpolator
      interpolator.create

      ! Reset default table eps
      interpolator.set_table_eps(cluster.atom_density_cutoff)

      ! If a saved cluster exists, use a table eps from that
      if (.saved.allocated) then
      if (.saved.cluster.allocated) then
      if (.saved.cluster.info_made) then
         interpolator.set_table_eps(.saved.cluster.atom_density_cutoff)
      end
      end
      end

      ! Set a linear-sqrt interpolator
      interpolator.set_interpolation_method("linear")
      interpolator.set_range_mapping("none")
      interpolator.set_domain_mapping("sqrt")
      interpolator.set_table_length(900d0)
      interpolator.set_table_spacing(0.1d0)

   end

   make_interpolator_sqrt_x1x(interpolator) :: leaky
   ! Make a gaussian interpolator.
      self :: IN
      interpolator :: INTERPOLATOR@

      cluster :: CLUSTER

      ! Create default interpolator
      interpolator.create

      ! Reset default table eps
      interpolator.set_table_eps(cluster.atom_density_cutoff)

      ! If a saved cluster exists, use a table eps from that
      if (.saved.allocated) then
      if (.saved.cluster.allocated) then
      if (.saved.cluster.info_made) then
         interpolator.set_table_eps(.saved.cluster.atom_density_cutoff)
      end
      end
      end

      ! Set a linear-sqrt interpolator
      interpolator.set_interpolation_method("cubic_spline")
      interpolator.set_range_mapping("none")
      interpolator.set_domain_mapping("sqrt(x/(1-x))*scale")
      interpolator.set_table_length(ONE)
      interpolator.set_spacing(0.0001d0)

   end

!  =========================
!  ED at a point & on a line
!  =========================

   ED_at_point(pt) result (res) :: PURE
   ! Return the electron density at a single point "pt"
   ! NOTE: This is Kanghyun's version. Now working.
      self :: IN
      pt   :: VEC{REAL}(3), IN
      res  :: REAL

      grid :: VEC{REAL}(1)

      .make_ED_grid_r(grid,reshape(pt,[1,3]))
      res = grid(1)

   end

   ED_between_points(ra,rb,n_pts) result (res) :: PURE
   ! Return ED on equally spaced grid points between "ra" and "rb"
   ! as the first and last points, inclusive.
      self  :: IN
      ra    :: VEC{REAL}(3), IN
      rb    :: VEC{REAL}(3), IN
      n_pts :: INT, IN
      res   :: VEC{REAL}(n_pts)

   ENSURE(n_pts>3,"too few points")

      pts :: MAT{REAL}@
      del :: VEC{REAL}(3)
      p   :: VEC{REAL}(3)
      i   :: INT

      pts.create(n_pts,3)

      ! Step vector
      del = rb - ra
      del = del/(n_pts-1)

      ! Line of points
      p = ra
      do i = 1,n_pts
         pts(i,1) = p(1)
         pts(i,2) = p(2)
         pts(i,3) = p(3)
         p = p + del
      end

      .make_ED_grid_r(res,pts)

      ! Clean
      pts.destroy

   end

   ED_between_points(ra,rb,n_pts,DM) result (res) :: PURE
   ! Return ED on equally spaced grid points between "ra" and "rb"
   ! as the first and last points, inclusive. "DM" is the density
   ! matrix used to calculated the electron density.
      self  :: IN
      ra    :: VEC{REAL}(3), IN
      rb    :: VEC{REAL}(3), IN
      n_pts :: INT, IN
      DM    :: MAT{REAL}, IN
      res   :: VEC{REAL}(n_pts)

   ENSURE(n_pts>3,"too few points")

      pts :: MAT{REAL}@
      del :: VEC{REAL}(3)
      p   :: VEC{REAL}(3)
      i   :: INT

      pts.create(n_pts,3)

      ! Step vector
      del = rb - ra
      del = del/(n_pts-1)

      ! Line of points
      p = ra
      do i = 1,n_pts
         pts(i,1) = p(1)
         pts(i,2) = p(2)
         pts(i,3) = p(3)
         p = p + del
      end

      .make_ED_grid_r(res,pts,DM)

      ! Clean
      pts.destroy

   end

   make_ED_interpolator_between_atoms(a,b)
   ! Make the .interpolator for the ED between two atoms "a" and "b"
      self :: INOUT
      a,b  :: INT, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.interpolator.allocated,"no interpolator info, specify n_data=")
   ENSURE(.interpolator.n_data>0,"wrong no. of data, interpolator")

      n_pts :: INT
      pts   :: VEC{REAL}@
      line  :: VEC{REAL}@
      ra,rb :: VEC{REAL}(3)
      del   :: VEC{REAL}(3)
      stp,val :: REAL
      i :: INT

      ! How many points?
      n_pts = .interpolator.n_data

      ! Positions
      ra = .atom(a).position
      rb = .atom(b).position

      ! Step vector
      del = rb - ra
      del = del/(n_pts-1)
      stp = norm2(del)

      ! Points as steps
      pts.create(n_pts)
      val = ZERO
      do i = 1,n_pts
         pts(i) = val
         val = val + stp
      end

      ! Make ED line values
      line = .ED_between_points(ra,rb,n_pts)

      ! Set domain scale factor. May not be required.
      .interpolator.set_data_points(pts)
      .interpolator.set_data_values(line)

      ! Clean
      line.destroy
      pts.destroy

   end

   promolecule_ED_at_point(pt) result (res) :: PURE
   ! Return promolecule ED at a point "pt".
      self :: IN
      pt   :: VEC{REAL}(3), IN
      res  :: REAL

   ENSURE(.atom.allocated,"no atoms")

      grid :: VEC{REAL}(1)
      a :: INT

      ! Sum up the atom grid values
      res = ZERO
      parallel do a = 1,.n_atom reduce(res)
         .atom(a).make_ED_grid(grid,reshape(pt,[1,3]))
         res = res + grid(1)
      end


   end

!  ======================
!  Promolecule density mx
!  ======================

   add_ANO_densities(DM) :: leaky
   ! Add the ANO densities to make the total density matrix
      self :: IN
      DM   :: OPMATRIX@, OUT

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.has_all_ANO_matrices,"no ANOs")

      a,b,f,l :: INT

      ! Create
      DM.create(.n_bf,"r ")

      ! Set to zero
      DM.r = ZERO

      ! Add 'em up
      do a = 1,.n_atom

         ! Transfer non-unique atoms
         do b = 1,.n_atom

            if (NOT .atom(b).is_same_kind_as(.atom(a))) cycle

            f = .first_basis_fn_for_atom(b)
            l =  .last_basis_fn_for_atom(b)
            DM.r(f:l,f:l) = .atom(a).density_mx.r

         end

      end

      ! Symmetrize
      DM.r.symmetric_reflect

   end

!  ============================
!  Stockholder atom weight grid
!  ============================

   apply_stockholder_atom_weight(grid,a,pts) :: PURE
   ! Apply (i.e. multiply) "grid" by the stockholder weight function
   ! for the atom with index "a" using supplied points "pts".
   ! * If .use_interpolators is TRUE then interpolators are used.
   ! * If .use_interpolators is FALSE then interpolators could still
   !   be used if explicitly set for each atom (however the
   !   overlapping_atoms array will not be used to eliminate work).
   !   More likely the density will be explicitly evaluated.
      self :: IN
      grid :: VEC{REAL}, INOUT
      a    :: INT, IN
      pts  :: MAT{REAL}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(grid.dim==pts.dim1,"incompatible dim1, grid & pts")

      Wa :: VEC{REAL}@

      ! Only needed for more than one atom
      if (.n_atom>1) then

         ! Get weights
         Wa.create(pts.dim1)
         .make_stockholder_atom_weight(Wa,a,pts)

         ! Apply them
         grid = grid*Wa

         ! Clean
         Wa.destroy

      end

   end

   make_stockholder_atom_weight(grid,a,pts) :: PURE
   ! Make the "grid" of stockholder weight function values for the
   ! atom with index "a" on supplied points "pts".
   ! * If .use_interpolators is TRUE then interpolators are used.
   ! * If .use_interpolators is FALSE then interpolators could still
   !   be used if explicitly set for each atom (however the
   !   overlapping_atoms array will not be used to eliminate work).
   !   More likely the density will be explicitly evaluated.
      self :: IN
      grid :: VEC{REAL}, OUT
      a    :: INT, IN
      pts  :: MAT{REAL}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(grid.dim==pts.dim1,"incompatible dim1, grid & pts")

      if (.n_atom==1) then

         ! Avoid this case if possible
         grid = ONE

      else

         ! Get weights
         if (.use_interpolators) then
            ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
            ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")
            .make_stockholder_atom_weight_int(grid,a,pts,.overlapping_atoms_for_atom(a).element)
         else
            .make_stockholder_atom_weight_acc(grid,a,pts)
         end

      end

   end

   make_stockholder_atom_weight_acc(grid,a,pts) :: private, PURE
   ! Make the Hirshfeld stockholder weight density "grid" for the atom
   ! with index "a" using supplied points "pts".
   ! NOTE: This DOES NOT USE an interpolated density for each atom
   ! UNLESS use_interpolators is explicitly set. In this case you
   ! should probably use the next routine which uses the
   ! overlapping_atoms.
      self :: IN
      grid :: VEC{REAL}, OUT
      a    :: INT, IN
      pts  :: MAT{REAL}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(grid.dim==pts.dim1,"incompatible dim1, grid & pts")

      rho_a   :: VEC{REAL}@
      n_pts,i :: INT

      ! Allocate temporary densities
      n_pts = grid.dim
      rho_a.create(n_pts)

      ! Make density for atom "a" in "rho_a"
      .atom(a).make_ED_grid(rho_a,pts)

      ! Make total density in "grid"
      grid = rho_a
      do i = 1,.n_atom
         if (i==a) cycle
         .atom(i).add_ED_grid(grid,pts)
      end

      ! Make the stockholder weight
      do i = 1,n_pts
         if (grid(i)>epsilon(ONE)) then; grid(i) = rho_a(i)/grid(i)
         else;                           grid(i) = ZERO
         end
      end
      rho_a.destroy

   end

   make_stockholder_atom_weight_int(grid,a,pts,overlapping_atom) :: private, PURE
   ! Make the Hirshfeld stockholder atom weight desity "grid" for the
   ! atom with index "a" using supplied points "pts" and given a list
   ! of "overlapping_atom". This makes use of a previously calculated
   ! interpolated density for each atom.
   ! NOTE: the CLUSTER.atom_density_cutoff must be the same as the
   !       the BECKE_GRID.basis_fn_cutoff
      self :: IN
      grid :: VEC{REAL}, OUT
      a    :: INT, IN
      pts  :: MAT{REAL}, IN
      overlapping_atom :: VEC{INT}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(grid.dim==pts.dim1,"incompatible dim1, grid & pts")

      rho_a :: VEC{REAL}@
      n_pts,i,j :: INT

      ! Allocate temporary densities
      n_pts = grid.dim
      rho_a.create(n_pts)

      ! Make density for atom "a"
      .atom(a).make_interpolated_density(rho_a,pts)

      ! Make total density in "grid"
      grid = rho_a
      do j = 1,overlapping_atom.dim
         i = overlapping_atom(j)
         if (i==a) cycle
         .atom(i).add_interpolated_density(grid,pts)
      end

      ! Make the stockholder weight
      do i = 1,n_pts
         if (grid(i)>epsilon(ONE)) then; grid(i) = rho_a(i)/grid(i)
         else;                           grid(i) = ZERO
         end
      end
      rho_a.destroy

   end

   make_stockholder_atom_weight(grid,a,pts,overlapping_atom) :: PURE
   ! Make the Hirshfeld stockholder weight density "grid" for the atom
   ! with index "a" using supplied points "pts". This version uses
   ! interpolated atom densities to make the weight function only for
   ! the "overlapping_atoms" which are considered the near neighbours.
      self :: IN
      grid :: VEC{REAL}, OUT
      a    :: INT, IN
      pts  :: MAT{REAL}, IN
      overlapping_atom :: VEC{INT}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(grid.dim==pts.dim1,"incompatible dim1, grid & pts")

      if (.n_atom>1) then
         .make_stockholder_atom_weight_int(grid,a,pts,overlapping_atom)
      else
         grid = ONE
      end

   end

!  ==============================
!  Salvador-RC neighbours & radii
!  ==============================

   make_Salvador_radii :: PURE
   ! Put the Salvador & Ramos-Cordoba radii for each atom.
      self :: INOUT

   ENSURE(.atom.allocated,"no atoms")

      .make_Salvador_radii_orig(.Salvador_bonds_for &
                                ,.Salvador_radii_for &
                                ,.Salvador_chi       )
   ! .make_Salvador_radii_orig(.Salvador_radii_for,50,400)

   end

   make_Salvador_radii_orig(bonds_for,radii_for,chi,n_div,n_sub) :: leaky, PURE
   ! Make the Mayer-Salvador atom radii corresponding to the
   ! bonded neighbours (which are also calculated) for the Topological
   ! Fuzzy Voronoi Atoms.
      self      :: IN
      bonds_for :: VEC{EVEC{INT}}@, OUT
      radii_for :: VEC{EVEC{REAL}}@, OUT
      chi       :: MAT{REAL}@, OUT
      n_div     :: INT, optional, IN
      n_sub     :: INT, optional, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.density_mx.allocated,"no density_mx")
   ENSURE(.density_mx.r.allocated,"no restricted density_mx")

      n_atoms :: INT
      n_bonds :: INT
      a,b,n   :: INT
      ra,rb   :: VEC{REAL}(3)
      fac     :: REAL

      ! Neighbours first
      .atom.make_Salvador_neighbours(bonds_for)

      ! Create radii table
      n_atoms = .atom.dim
      radii_for.create(n_atoms)
      chi.create(n_atoms,n_atoms)
      chi = ONE

      ! Atom a
      do a = 1,n_atoms
         n_bonds = bonds_for(a).element.dim
         radii_for(a).element.create(n_bonds)
         ra = .atom(a).position
         ! Neighbours b
         do n = 1,n_bonds
            b   = bonds_for(a)[n]
            rb  = .atom(b).position 
            fac = .Mayer_Salvador_radius_for(a,b,n_div,n_sub)
            radii_for(a)[n] = fac*norm2(rb-ra)
            chi(a,b)        = fac/(ONE-fac)
         end
      end

   end

   Mayer_Salvador_radius_for(a,b,n_div,n_sub) result (res) :: PURE
   ! Return the Mayer-Salvador radius R(a.b) for atoms "a" and "b" in
   ! the direction a->b, used to make Topological Fuzzy Voronoi atoms.
   ! The code is accurate to 1/200-th of the bond length R(a-b).
   ! The code also ensures that R(a.b) + R(b.a) = R(a-b).
   ! Options:
   ! . "n_div" [50] is the number of divisions used to detect minima.
   ! . "n_sub" [40] is the no. of subdivisions to refine the result.
   ! NOTE: Code was extracted from APOST-3D and contains the original
   ! method from Mayer & Salvador used to define the Salvador &
   ! Ramos-Cordoba radii. The method accounts for numerical errors and
   ! instabilities in the internuclear density and atoms too far away.
      self  :: IN
      a, b  :: INT, IN
      n_div :: INT, optional, IN
      n_sub :: INT, optional, IN
      res   :: REAL
     
   ENSURE(a/=b,"atoms should not be the same")

      ra,rb,del :: VEC{REAL}(3)
      rc,rd     :: VEC{REAL}(3)
      rho       :: VEC{REAL}@
      kmin,kmax :: VEC{INT}@
      nmin,nmax :: INT
      ndiv,nsub :: INT
      step,subs :: REAL
      k, km,kf  :: INT
      midd,maxd :: INT
      best,diff :: INT
      is_min    :: BIN
      swap      :: BIN
      Za, Zb    :: INT

      ! Scan resolution: must be even
      ndiv = 50   ! No. of divisions 
      if (present(n_div)) ndiv = n_div

      ! Polishing resolution: also even
      nsub = 40   ! No. of subdivisions
      if (present(n_sub)) nsub = n_sub

      ! Are atoms too far?
      ra = .atom(a).position
      rb = .atom(b).position
      if (norm2(rb-ra)>TEN) then
         res = HALF       ! Divide half-way
         return
      end

      ! Ensure a has *smaller* atomic number.
      ! Or if equal, index a is less than b.
      ! This ensures R(a.b) + R(b.a) = R(a-b)
      Za = .atom(a).atomic_number
      Zb = .atom(b).atomic_number
      swap = FALSE
      if      (Za>Zb         ) then; swap = TRUE
      else if (Za==Zb AND a>b) then; swap = TRUE
      end

      ! Swap positions
      if (swap) then
         rc = ra
         ra = rb
         rb = rc
      end

      ! ED, min & max locations
      rho.create(ndiv+1) ! Note +1
      kmin.create(ndiv)   ! idx of k-th min
      kmax.create(ndiv)   ! idx of k-th max

      ! Get ED from a->b at ndiv+1 points 
      ! First and last point are on ra & rb
      rho = .ED_between_points(ra,rb,ndiv+1)

      ! Find indices of minima & maxima
      nmin = 0
      nmax = 0
      do k = 2,ndiv
         if (rho(k-1)>rho(k) AND rho(k)<rho(k+1)) then 
            ! Minima found
            nmin = nmin + 1
            kmin(nmin) = k
         end     
         if (rho(k-1)<rho(k) AND rho(k)>rho(k+1)) then 
            ! Maxima found
            nmax = nmax + 1
            kmax(nmax) = k
         end     
      end

      ! Sanity check: any critical points?
      ENSURE(nmin>0,"no minima found between the atoms!")
   ! WARN_IF(nmax>0,"maxima found between the atoms!")

      if (nmin==1 AND nmax==0) then

         ! Easy case: 1 minima, 0 maxima
         km = kmin(1)   ! Index of minimum
         is_min = TRUE  ! Set 1 if maxima

      else if (nmax>0 AND abs(nmin-nmax)==1) then

         ! Troubles.
         ! One more min than max, or vice versa
         if (nmax.is_odd) then
            ! Central max selected 
            km = kmax((nmax+1)/2)
            is_min = FALSE
         else
            ! Central min selected. If any.
            ! But there must, if nmax is even!
            km = kmin((nmin+1)/2)
            is_min = TRUE
         end 
         
      else

         ! Real touble. Inconsistent no. of extrema.
         ! Select best min/max i.e closest to midpoint
         midd = ndiv/2 ! Middle division
         maxd = ndiv   ! Max. diff to midd
         best = midd   ! Start at middle 
         is_min = TRUE
        
         ! First minima to middle division.
         ! If there is one, it is found
         do k = 1,nmin
            diff = abs(kmin(k)-midd)
            if (diff<maxd)  then
               best = kmin(k) ! Store
               maxd = diff    ! Look no further
               is_min = TRUE  ! Label it
            end 
         end
        
         ! Any maxima closer than maxd?
         ! Maxima trump minima.
         do k = 1,nmax
            diff = abs(kmax(k)-midd)
            if (diff<maxd)  then
               best = kmax(k)
               maxd = diff
               is_min = FALSE
            end 
         end

         ! Finally
         km = best
        
      end
       
      ! Extrema index km found.
      ! Go back one step, look ahead two steps
      step = ONE/ndiv        ! Orig. step size
      del  = (rb-ra)*step    ! Step vector
      rc   = ra + (km-2)*del ! km-1 is the extrema
      rd   = ra + (km  )*del ! *Two* steps ahead
      subs = TWO*step/nsub   ! Substep size, over 2 steps

      ! ED from rc->rd at nsub+1 points 
      ! First & last points on rc & rd
      rho  = .ED_between_points(rc,rd,nsub+1)
   
      ! Find first extrema, finer level
      if (is_min) then
         do k = 2,nsub
            kf = k
            if (rho(k-1)>rho(k) AND rho(k)<rho(k+1)) exit
         end
      else
         do k = 2,nsub
            kf = k
            if (rho(k-1)<rho(k) AND rho(k)>rho(k+1)) exit
         end
      end
      
      ! Steps from ra
      res = (km-2)*step + (kf-1)*subs

      ! Swap back?
      if (swap) res = ONE - res

   ENSURE(res>0.1 AND res<0.9,"Too close to nuclei!")

   end

   Mayer_Salvador_radius_for(a,b,n_div,n_sub,DM) result (res) :: PURE
   ! Return the Mayer-Salvador radius R(a.b) for atoms "a" and "b" in
   ! the direction a->b, used to make Topological Fuzzy Voronoi atoms.
   ! "DM" is the density matrix used to calculated the electron
   ! density. The code is accurate to 1/2000-th of the separation
   ! R(a-b). The code ensures that R(a.b) + R(b.a) = R(a-b). 
   ! Options:
   ! . "n_div"  [50] is the number of divisions used to detect minima.
   ! . "n_sub" [400] is the no. of subdivisions to refine the result.
   ! NOTE: Code was extracted from APOST3D and contains the original
   ! method from Mayer & Salvador used to define the Salvador &
   ! Ramos-Cordoba radii. The method accounts for numerical errors and
   ! instabilities in the internuclear density and atoms too far away.
      self  :: IN
      a, b  :: INT, IN
      n_div :: INT, optional, IN
      n_sub :: INT, optional, IN
      DM    :: MAT{REAL}, IN
      res   :: REAL
     
   ENSURE(a/=b,"atoms should not be the same")

      ra,rb,del :: VEC{REAL}(3)
      rc,rd     :: VEC{REAL}(3)
      rho       :: VEC{REAL}@
      kmin,kmax :: VEC{INT}@
      nmin,nmax :: INT
      ndiv,nsub :: INT
      step,subs :: REAL
      k, km,kf  :: INT
      midd,maxd :: INT
      best,diff :: INT
      is_min    :: BIN
      swap      :: BIN
      Za, Zb    :: INT

      ! Scan resolution: must be even
      ndiv = 50   ! No. of divisions 
      if (present(n_div)) ndiv = n_div

      ! Polishing resolution: also even
      nsub = 400  ! No. of subdivisions
      if (present(n_sub)) nsub = n_sub

      ! Are atoms too far?
      ra = .atom(a).position
      rb = .atom(b).position
      if (norm2(rb-ra)>TEN) then
         res = HALF       ! Divide half-way
         return
      end

      ! Ensure a has *smaller* atomic number.
      ! Or if equal, index a is less than b.
      ! This ensures R(a.b) + R(b.a) = R(a-b)
      Za = .atom(a).atomic_number
      Zb = .atom(b).atomic_number
      swap = FALSE
      if      (Za>Zb         ) then; swap = TRUE
      else if (Za==Zb AND a>b) then; swap = TRUE
      end

      ! Swap positions
      if (swap) then
         rc = ra
         ra = rb
         rb = rc
      end

      ! ED, min & max locations
      rho.create(ndiv+1) ! Note +1
      kmin.create(ndiv)   ! idx of k-th min
      kmax.create(ndiv)   ! idx of k-th max

      ! Get ED from a->b at ndiv+1 points 
      ! First and last point are on ra & rb
      rho = .ED_between_points(ra,rb,ndiv+1,DM)

      ! Find indices of minima & maxima
      nmin = 0
      nmax = 0
      do k = 2,ndiv
         if (rho(k-1)>rho(k) AND rho(k)<rho(k+1)) then 
            ! Minima found
            nmin = nmin + 1
            kmin(nmin) = k
         end     
         if (rho(k-1)<rho(k) AND rho(k)>rho(k+1)) then 
            ! Maxima found
            nmax = nmax + 1
            kmax(nmax) = k
         end     
      end

      ! Sanity check: any critical points?
      ENSURE(nmin>0,"no minima found between the atoms!")
      WARN_IF(nmax>0,"maxima found between the atoms!")

      if (nmin==1 AND nmax==0) then

         ! Easy case: 1 minima, 0 maxima
         km = kmin(1)   ! Index of minimum
         is_min = TRUE  ! Set 1 if maxima

      else if (nmax>0 AND abs(nmin-nmax)==1) then

         ! Troubles.
         ! One more min than max, or vice versa
         if (nmax.is_odd) then
            ! Central max selected 
            km = kmax((nmax+1)/2)
            is_min = FALSE
         else
            ! Central min selected. If any.
            ! But there must, if nmax is even!
            km = kmin((nmin+1)/2)
            is_min = TRUE
         end 
         
      else

         ! Real touble. Inconsistent no. of extrema.
         ! Select best min/max i.e closest to midpoint
         midd = ndiv/2 ! Middle division
         maxd = ndiv   ! Max. diff to midd
         best = midd   ! Start at middle 
         is_min = TRUE
        
         ! First minima to middle division.
         ! If there is one, it is found
         do k = 1,nmin
            diff = abs(kmin(k)-midd)
            if (diff<maxd)  then
               best = kmin(k) ! Store
               maxd = diff    ! Look no further
               is_min = TRUE  ! Label it
            end 
         end
        
         ! Any maxima closer than maxd?
         ! Maxima trump minima.
         do k = 1,nmax
            diff = abs(kmax(k)-midd)
            if (diff<maxd)  then
               best = kmax(k)
               maxd = diff
               is_min = FALSE
            end 
         end

         ! Finally
         km = best
        
      end
       
      ! Extrema index km found.
      ! Go back one step, look ahead two steps
      step = ONE/ndiv        ! Orig. step size
      del  = (rb-ra)*step    ! Step vector
      rc   = ra + (km-2)*del ! km-1 is the extrema
      rd   = ra + (km  )*del ! *Two* steps ahead
      subs = TWO*step/nsub   ! Substep size, over 2 steps

      ! ED from rc->rd at nsub+1 points 
      ! First & last points on rc & rd
      rho  = .ED_between_points(rc,rd,nsub+1,DM)
   
      ! Find first extrema, finer level
      if (is_min) then
         do k = 2,nsub
            kf = k
            if (rho(k-1)>rho(k) AND rho(k)<rho(k+1)) exit
         end
      else
         do k = 2,nsub
            kf = k
            if (rho(k-1)<rho(k) AND rho(k)>rho(k+1)) exit
         end
      end
      
      ! Steps from ra
      res = (km-2)*step + (kf-1)*subs

      ! Swap back?
      if (swap) res = ONE - res

   ENSURE(res>0.1 AND res<0.9,"Too close to nuclei!")

   end

   make_Salvador_radii_lmin :: PURE
   ! Put the Salvador & Ramos-Cordoba radii for each atom.
      self :: INOUT

   ENSURE(.atom.allocated,"no atoms")

      .atom.make_Salvador_neighbours(.Salvador_bonds_for)
      .make_Salvador_radii_lmin(.Salvador_radii_for)

   end

   make_Salvador_radii_lmin(radii_for) :: leaky, PURE
   ! Make the Mayer-Salvador atom radii corresponding to the bonded
   ! neighbours. If the point is outside the range a -ve radii is
   ! returned then it is not between those atoms, or too close.
   ! NOTE: This version uses canned line minimisation routines.
      self      :: IN
      radii_for :: VEC{EVEC{REAL}}@, OUT

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.density_mx.allocated,"no density_mx")
   ENSURE(.density_mx.r.allocated,"no restricted density_mx")

      bonds_for :: VEC{EVEC{INT}}@

      n_bonds :: INT
      a,b,c   :: INT
      ra, rc  :: VEC{REAL}(3)
      r1, r2  :: VEC{REAL}(3)
      rac,dir :: VEC{REAL}(3)
      E1,L,EDmin,r :: REAL

      .atom.make_Salvador_neighbours(bonds_for)

      ! Create radii table
      radii_for.create(.atom.dim)

      ! Atom a
      do a = 1,.atom.dim
         n_bonds = bonds_for(a).element.dim
         radii_for(a).element.create(n_bonds)
         ra = .atom(a).position
         ! Bonded atom c
         do b = 1,n_bonds
            c   = bonds_for(a)[b]
            rc  = .atom(c).position 
            rac = rc - ra
            r1  = ra 
            r2  = ra + HALF*rac
            dir = r2 - r1  ! search direction
            E1  = .ED_at_point(r1)
            VEC{REAL}:min_line(self,ED_at_point,r1,dir,EDmin,TOL(4),E1,L)
            r = norm2(dir*L)
            if (L<0.05 OR L>1.95) r = -BOHR_PER_ANGSTROM
            radii_for(a)[b] = r
         ! print *,"a=",a,"c=",c,"L=",L,"r=",r
         end
      end

   end

   make_Salvador_radii_pro(radii_for,bonds_for,DM,n_div,n_sub) :: leaky, PURE
   ! Make the Mayer-Salvador atom radii corresponding to the
   ! bonded neighbours (previously calculated!) for the Topological
   ! Fuzzy Voronoi Atoms, for the electron density obtained from
   ! density matrix "DM".
      self      :: IN
      radii_for :: VEC{EVEC{REAL}}@, OUT
      bonds_for :: VEC{EVEC{INT}}@, IN
      DM        :: MAT{REAL}, IN
      n_div     :: INT, optional, IN
      n_sub     :: INT, optional, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.density_mx.allocated,"no density_mx")
   ENSURE(.density_mx.r.allocated,"no restricted density_mx")

      n_atoms :: INT
      n_bonds :: INT
      a,b,n   :: INT
      ra,rb   :: VEC{REAL}(3)
      fac     :: REAL

      ! Create radii table
      n_atoms = .atom.dim
      radii_for.create(n_atoms)

      ! Atom a
      do a = 1,n_atoms
         n_bonds = bonds_for(a).element.dim
         radii_for(a).element.create(n_bonds)
         ra = .atom(a).position
         ! Neighbours b
         do n = 1,n_bonds
            b   = bonds_for(a)[n]
            rb  = .atom(b).position 
            fac = .Mayer_Salvador_radius_for(a,b,n_div,n_sub,DM)
            radii_for(a)[n] = fac*norm2(rb-ra)
         end
      end

   end

   put_Salvador_radii
   ! Put the Salvador & Ramos-Cordoba radii for each atom.
   ! The neighbours and radii should have veen made already.
   ! Promolecule radii are made here, only for comparison.
      self :: IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.Salvador_bonds_for.allocated,"no Salvador_bonds: make them!")
   ENSURE(.Salvador_radii_for.allocated,"no Salvador_radii: make them!")

      DM :: OPMATRIX@
      radii_pro :: VEC{EVEC{REAL}}@

      ! Make promolecule density
      .add_ANO_densities(DM)
      DM.convert_to("r",factor=HALF)

      ! Make promolecule radii
      .make_Salvador_radii_pro(radii_pro,.Salvador_bonds_for,DM.r)

      ! Put table
      .atom.put_Salvador_radii_table(.Salvador_bonds_for,.Salvador_radii_for,radii_pro)

      ! Clean
      radii_pro.destroy
      DM.destroy

   end

!  ===================================
!  Spherically averaged atomic density
!  ===================================

   SA_cell_fn_between_atoms(a,b,n_pts) result (res) :: PURE
   ! Return ED on equally spaced grid points between "ra" and "rb"
   ! as the first and last points, inclusive. "DM" is the density
   ! matrix used to calculated the electron density.
      self  :: IN
      a, b  :: INT, IN
      n_pts :: INT, IN
      res   :: VEC{REAL}(n_pts)

   ENSURE(n_pts>3,"too few points")

      pts :: MAT{REAL}@
      ra  :: VEC{REAL}(3)
      rb  :: VEC{REAL}(3)
      del :: VEC{REAL}(3)
      p   :: VEC{REAL}(3)
      i   :: INT

      pts.create(n_pts,3)

      ! Step vector
      ra  = .atom(a).position
      rb  = .atom(b).position
      del = rb - ra
      del = del/(n_pts-1)

      ! Line of points
      p = ra
      do i = 1,n_pts
         pts(i,1) = p(1)
         pts(i,2) = p(2)
         pts(i,3) = p(3)
         p = p + del
      end

      ! Cell fn. "a"
      .becke_grid.make_Salvador_cell_fn(res,pts,a)

      ! Clean
      pts.destroy

   end

   make_SA_cell_fn_interp_between_atoms(a,b)
   ! Make the .interpolator for the ED between two atoms "a" and "b"
      self :: INOUT
      a,b  :: INT, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.interpolator.allocated,"no interpolator info, specify n_data=")
   ENSURE(.interpolator.n_data>0,"wrong no. of data, interpolator")

      n_pts :: INT
      pts   :: VEC{REAL}@
      line  :: VEC{REAL}@
      ra,rb :: VEC{REAL}(3)
      del   :: VEC{REAL}(3)
      stp,val :: REAL
      i :: INT

      ! How many points?
      n_pts = .interpolator.n_data

      ! Positions
      ra = .atom(a).position
      rb = .atom(b).position

      ! Step vector
      del = rb - ra
      del = del/(n_pts-1)
      stp = norm2(del)

      ! Points as steps
      pts.create(n_pts)
      val = ZERO
      do i = 1,n_pts
         pts(i) = val
         val = val + stp
      end

      ! Make ED line values
      line = .SA_cell_fn_between_atoms(a,b,n_pts)

      ! Set domain scale factor. May not be required.
      .interpolator.set_data_points(pts)
      .interpolator.set_data_values(line)

      ! Clean
      line.destroy
      pts.destroy

   end


   SA_ED_between_atoms(a,b,n_pts) result (res) :: PURE
   ! Return ED on equally spaced grid points between "ra" and "rb"
   ! as the first and last points, inclusive. "DM" is the density
   ! matrix used to calculated the electron density.
      self  :: IN
      a, b  :: INT, IN
      n_pts :: INT, IN
      res   :: VEC{REAL}(n_pts)

   ENSURE(n_pts>3,"too few points")

      ED  :: VEC{REAL}@
      pts :: MAT{REAL}@
      ra  :: VEC{REAL}(3)
      rb  :: VEC{REAL}(3)
      del :: VEC{REAL}(3)
      p   :: VEC{REAL}(3)
      i   :: INT

      pts.create(n_pts,3)

      ! Step vector
      ra  = .atom(a).position
      rb  = .atom(b).position
      del = rb - ra
      del = del/(n_pts-1)

      ! Line of points
      p = ra
      do i = 1,n_pts
         pts(i,1) = p(1)
         pts(i,2) = p(2)
         pts(i,3) = p(3)
         p = p + del
      end

      ! Cell fn. "a"
      .becke_grid.make_Salvador_cell_fn(res,pts,a)

      ! ED
      ED.create(n_pts)
      ED = .ED_between_points(ra,rb,n_pts)

      ! Multiply
      res = ED*res

      ! Clean
      ED.destroy
      pts.destroy

   end

   make_SA_ED_interp_between_atoms(a,b)
   ! Make the .interpolator for the ED between two atoms "a" and "b"
      self :: INOUT
      a,b  :: INT, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.interpolator.allocated,"no interpolator info, specify n_data=")
   ENSURE(.interpolator.n_data>0,"wrong no. of data, interpolator")

      n_pts :: INT
      pts   :: VEC{REAL}@
      line  :: VEC{REAL}@
      ra,rb :: VEC{REAL}(3)
      del   :: VEC{REAL}(3)
      stp,val :: REAL
      i :: INT

      ! How many points?
      n_pts = .interpolator.n_data

      ! Positions
      ra = .atom(a).position
      rb = .atom(b).position

      ! Step vector
      del = rb - ra
      del = del/(n_pts-1)
      stp = norm2(del)

      ! Points as steps
      pts.create(n_pts)
      val = ZERO
      do i = 1,n_pts
         pts(i) = val
         val = val + stp
      end

      ! Make ED line values
      line = .SA_ED_between_atoms(a,b,n_pts)

      ! Set domain scale factor. May not be required.
      .interpolator.set_data_points(pts)
      .interpolator.set_data_values(line)

      ! Clean
      line.destroy
      pts.destroy

   end


   make_sph_avgd_SA_ED_v0(avg,pts,c) :: PURE
   ! Make "avg", the spherically averaged Salvador atom electron
   ! densities for atom "c" evaluated at a set of radial "pts" away
   ! from the nuclear position.
      self :: IN
      avg  :: VEC{REAL}, OUT
      pts  :: VEC{REAL}, IN
      c    :: INT, IN

   ENSURE(avg.dim==pts.dim,"incompatible size, avg & pts")

      rc        :: VEC{REAL}(3)
      wts,Wc,N0 :: VEC{REAL}@
      shell     :: MAT{REAL}@
      theta,phi :: QUADRATURE@
      nq,n_pts  :: INT
      t,p,n, i  :: INT
      th,ct,st  :: REAL
      ph,cp,sp  :: REAL
      r,rst     :: REAL

      ! Quadrature pt. density
      nq = 25
      n_pts = 2*nq*nq

      ! Polar angle quadrature
      theta.create
      theta.set_kind("gauss_legendre")
      theta.set_n_pts(nq)
      theta.set_quadrature_points
      theta.set_limits([ZERO,PI]) ! <---

      ! Azimuth - twice as many pts
      phi.create
      phi.set_kind("gauss_legendre")
      phi.set_n_pts(2*nq)
      phi.set_quadrature_points
      phi.set_limits([ZERO,2*PI]) ! <---

      ! Atom "c" position
      rc = .atom(c).position

      ! Radial pts
      do i = 1,pts.dim

         ! Radius
         r = pts(i)

         ! Shell radius "r"
         shell.create(n_pts,3)
         wts.create(n_pts) ! Quad. weights
         Wc.create(n_pts)  ! Salvador atom
         n = 0
         do t = 1,theta.n_pts
         do p = 1,  phi.n_pts
            n   = n + 1
            th  = theta.pts(t)
            ph  =   phi.pts(p)
            ct  = cos(th)
            st  = sin(th)
            cp  = cos(ph)
            sp  = sin(ph)
            ! Spherical shell around "rc"
            rst = r * st ! <---
            shell(n,1) = rst*cp + rc(1) 
            shell(n,2) = rst*sp + rc(2)
            shell(n,3) = r  *ct + rc(3)
            ! The area x weights
            wts(n) = st*theta.wts(t)*phi.wts(p) 
         end
         end

         ! Salvador atom "Wc" on "shell"
         .becke_grid.make_Salvador_cell_fn(Wc,shell,c)

         ! Prune "shell"
         wts = Wc*wts ! <---
      ! .becke_grid.prune_grid(shell,wts)

         ! ED for atom "c" on shell
         N0.create(shell.dim1)
         .make_ED_grid_r(N0,shell)

         ! Population of shell x 4 PI
         avg(i) = sum(N0*wts) ! Integrate

         ! Clean
         N0.destroy
         Wc.destroy
         wts.destroy
         shell.destroy

      end

      ! Clean
      phi.destroy
      theta.destroy

      ! Scale
      avg = avg/(FOUR*PI)

   end

   make_sph_avgd_SA_ED_v1(avg,pts,c) :: PURE
   ! Make "avg", the spherically averaged Salvador atom electron
   ! densities for atom "c" evaluated at a set of radial "pts" away
   ! from the nuclear position.
   ! NOTE: ths "pts" should be from .becke_grid.radial_grid(p).pts
      self :: IN
      avg  :: VEC{REAL}, OUT
      pts  :: VEC{REAL}, IN
      c    :: INT, IN

   ENSURE(avg.dim==pts.dim,"incompatible size, avg & pts")
   ENSURE(.becke_grid.allocated,"no becke_grid")
   ENSURE(.becke_grid.finalized,"becke_grid not finalized")

      rc        :: VEC{REAL}(3)
      wts,Wc,N0 :: VEC{REAL}@
      shell     :: MAT{REAL}@
      lebedev   :: LEBEDEV@
      i         :: INT
      r         :: REAL

      ! Atom "c" pos
      rc = .atom(c).position

      ! Radial pts
      do i = 1,pts.dim

         ! Radius "r"
         r = pts(i)

         ! Shell radius "r"
         lebedev = .becke_grid.angular_grid_for_atom(c,i)
         shell = r*r*lebedev.pts ! Quad. pts
         wts   =     lebedev.wts ! Quad. weights

         ! Displace to "rc"
         shell = shell + spread(rc,dim=2,ncopies=shell.dim2)

         ! Salvador atom "Wc" on "shell"
         Wc.create(shell.dim1)  ! Salvador atom
         .becke_grid.make_Salvador_cell_fn(Wc,shell,c)

         ! Prune "shell"
         wts = Wc*wts ! <---
      ! .becke_grid.prune_grid(shell,wts)

         ! ED for atom "c" on "shell"
         N0.create(shell.dim1)
         .make_ED_grid_r(N0,shell)

         ! Population of shell 
         avg(i) = sum(N0*wts) ! Integrate

         ! Clean
         N0.destroy
         Wc.destroy
         wts.destroy
         shell.destroy

      end

   end

   make_sph_SA_interp_from_atom(a,b,r_max) :: PURE
   ! Make the Salvador atom ED interpolator from atom "a". 
   ! The furthest neighbour atom index "b" is also returned.
   ! The no. of points "n_pts" must be given in an .interpolator.
   ! The distance away to plot is "r_max", if specified.
      self  :: INOUT
      a     :: INT, IN
      b     :: INT, OUT
      r_max :: REAL, optional, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.dim>1,"must have more than one atom.")
   ENSURE(.Salvador_bonds_for.allocated,"no Salvador_bonds: make them!")
   ENSURE(.interpolator.allocated,"no interpolator info, specify n_data=")
   ENSURE(.interpolator.n_data>0,"wrong no. of data, interpolator")

      line  :: VEC{REAL}@
      pts   :: VEC{REAL}@
      neigh :: VEC{INT}@
      del,p :: REAL
      rmax  :: REAL
      dist  :: REAL
      i,x   :: INT
      n_pts :: INT

      ! How many points?
      n_pts = .interpolator.n_data

      ! Find furthest neighbour
      b = 0
      rmax = ZERO
      neigh = .Salvador_bonds_for(a).element
      do i = 1,neigh.dim
         x = neigh(i)
         dist = .atom.distance_between(a,x)
         if (dist>rmax) then
            b = x
            rmax = dist
         end
      end
   ! rmax = .atom.distance_between(a,x)

      ! Override r_max?
      if (present(r_max)) then
         rmax = r_max
      end

      ! Make grid points &
      ! line of ED values
      pts.create(n_pts)
      line.create(n_pts)

      ! Step size
      del = rmax/(n_pts-1)

      ! Line of points from "ra"
      p = ZERO
      do i = 1,n_pts
         pts(i) = p
         p = p + del
      end

      ! Make the density
      .make_sph_avgd_SA_ED_v0(line,pts,a)

      ! Set domain scale factor. May not be required.
      .interpolator.set_data_points(pts)
      .interpolator.set_data_values(line)

      ! Clean
      line.destroy
      pts.destroy

   end

!  ====================
!  Atom partition grids
!  ====================

! These routines include Becke grid weights

   make_Hirshfeld_atom_ED_grid(N0,pts,c,DM) :: leaky, PURE
   ! Return "N0", the Hirshfeld atom electron density (ED) grid for
   ! atom "c" weighted by the Becke grid wts; and the pruned Becke
   ! grid "pts" on which N0 is evaluated. "DM" is the density mx.
   ! NOTE: sum(N0) is the electron population for atom "c". 
   ! NOTE: Rewritten to use Kang's code.
      self :: IN
      N0   :: VEC{REAL}@, OUT
      pts  :: MAT{REAL}@, OUT
      c    :: INT, IN
      DM   :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.density_mx.allocated,"no density matrix")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      wts    :: VEC{REAL}@
      cutoff :: REAL

      ! Get the Becke grid for atom "c"
      .becke_grid.make_atom_grid(pts,wts,c)

      ! Make stockholder weight function "Wc" for atom "c"
      ! If using interpolatators, then overlapping_atoms
      ! are not needed ... otherwise nothing is skipped
      .apply_stockholder_atom_weight(wts,c,pts)

      ! Prune the grid with new "wts"
      .becke_grid.prune_grid(pts,wts)

      ! Density grid for atom "c"
      N0.create(pts.dim1)
      cutoff = .becke_grid.basis_fn_cutoff
      .make_ED_grid_r_v2(N0,pts,DM,cutoff)

      ! N0 x weight for atom "c"
      N0 = N0*wts

      ! Clean
      wts.destroy

   end

   make_Becke_atom_ED_grid(N0,pts,c,DM) :: leaky, PURE
   ! Return "N0", the Becke atom electron density (ED) grid for
   ! atom "c" weighted by the Becke grid wts; and the pruned Becke
   ! grid "pts" on which N0 is evaluated. "DM" is the density mx.
   ! NOTE: sum(N0) is the electron population for atom "c". 
      self :: IN
      N0   :: VEC{REAL}@, OUT
      pts  :: MAT{REAL}@, OUT
      c    :: INT, IN
      DM   :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.density_mx.allocated,"no density matrix")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      wts    :: VEC{REAL}@
      cutoff :: REAL

      ! Get the Stratmann-Scuseria grid for atom "c"
      ! Actually this is with a=ONE.
      .becke_grid.make_Becke_atom_grid(pts,wts,c) 

      ! Prune the grid with new "wts"
      .becke_grid.prune_grid(pts,wts)

      ! Density grid for atom "c"
      N0.create(pts.dim1)
      cutoff = .becke_grid.basis_fn_cutoff
      .make_ED_grid_r_v2(N0,pts,DM,cutoff) ! Kang

      ! N0*Wc, weights for atom "c"
      N0 = N0*wts

      ! Clean
      wts.destroy

   end

   make_Stratmann_atom_ED_grid(N0,pts,c,DM) :: leaky, PURE
   ! Return "N0", the Stratmann-Scuseria atom electron density (ED)
   ! grid for atom "c" weighted by the Becke grid wts; and the pruned
   ! Becke grid "pts" on which N0 is evaluated. "DM", the density mx.
   ! NOTE: sum(N0) is the electron population for atom "c". 
      self :: IN
      N0   :: VEC{REAL}@, OUT
      pts  :: MAT{REAL}@, OUT
      c    :: INT, IN
      DM   :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.density_mx.allocated,"no density matrix")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      wts    :: VEC{REAL}@
      cutoff :: REAL

      ! Get the Stratmann-Scuseria grid for atom "c"
      ! Actually this is with a=ONE.
      ! Becke grid "wts" are multiplied by normalized Voronoi cell fn "W"
      .becke_grid.make_SS1_atom_grid(pts,wts,c) 

      ! Prune the grid with new "wts"
      .becke_grid.prune_grid(pts,wts)

      ! Density grid for atom "c"
      N0.create(pts.dim1)
      cutoff = .becke_grid.basis_fn_cutoff
      .make_ED_grid_r_v2(N0,pts,DM,cutoff) ! Kang

      ! N0*Wc, weights for atom "c"
      N0 = N0*wts

      ! Clean
      wts.destroy

   end

   make_Salvador_atom_ED_grid(N0,pts,c,DM) :: leaky, PURE
   ! Return "N0", the Salvador atom electron density (ED) grid for
   ! atom "c" weighted by the Becke grid wts; and the pruned Becke
   ! grid "pts" on which N0 is evaluated. "DM" is the density mx.
   ! NOTE: sum(N0) is the electron population for atom "c". 
      self :: IN
      N0   :: VEC{REAL}@, OUT
      pts  :: MAT{REAL}@, OUT
      c    :: INT, IN
      DM   :: MAT{REAL}, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.density_mx.allocated,"no density matrix")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      wts    :: VEC{REAL}@
      cutoff :: REAL

      ! Get the Salvador & Ramos-Cordoba grid for atom "c"
      ! Becke grid "wts" are multiplied by normalized Voronoi cell fn "W"
      .becke_grid.make_Salvador_atom_grid_v0(pts,wts,c) 
   ! .becke_grid.make_Salvador_atom_grid_v1(pts,wts,c) ! NOT WORKING

      ! Prune the grid with new "wts"
      .becke_grid.prune_grid(pts,wts)

      ! Density grid for atom "c"
      N0.create(pts.dim1)
      cutoff = .becke_grid.basis_fn_cutoff
      .make_ED_grid_r_v2(N0,pts,DM,cutoff) ! Kang

      ! N0*Wc, weights for atom "c"
      N0 = N0*wts

      ! Clean
      wts.destroy

   end

   make_sph_avgd_SA_ED_grid(N0,pts,c) :: PURE
   ! Return "N0", the spherically averaged Salvador atom electron
   ! density (ED) grid for atom "c" *weighted* by the Becke radial
   ! grid wts; and return the radial grid points as well on which N0
   ! is evaluated. 
   ! NOTE: the radial grid points are from the origin.
   ! NOTE: sum(N0) is the electron population for atom "c". 
      self :: IN
      N0   :: VEC{REAL}@, OUT
      pts  :: VEC{REAL}@, OUT
      c    :: INT, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")

      rgrid :: QUADRATURE@

      ! Radial grid
      rgrid = .becke_grid.radial_grid_for_atom(c)

      ! Radial quadrature pts
      pts = rgrid.pts

      ! Averaged densities
      N0.create(rgrid.n_pts)
      .make_sph_avgd_SA_ED_v0(N0,pts,c)

      ! N0 x radial weights
      N0 = N0*rgrid.wts

      ! Clean
      rgrid.destroy

   end

!  =================
!  Charges & moments
!  =================

   make_atomic_moments(spin,output) :: template
   ! Make the restricted atomic moments for some partitioning.
   ! NOTE: the charges & dipoles are set for every .atom 
   !       and then propagated to .asymmetric_unit_atoms.
   !       Needed for core-matrix-cluster-of-charges method
   ! NOTE: Moments aren't printed, but total no. of electrons
   !       is printed as a check unless supressed via "output".
      self   :: INOUT
      spin   :: BIN, optional, IN
      output :: BIN, optional, IN

   ENSURE(.basis_info_made, "no basis info")
   ENSURE(.atom.allocated,  "no atom list")
   ENSURE(.DFT_grid_info_made,"no becke_grid")
   ENSURE(.density_mx.allocated,"no density matrix")

      pts, DM  :: MAT{REAL}@
      N0       :: VEC{REAL}@
      r1,r2,r3 :: VEC{REAL}@
      c1,c2,c3 :: REAL
      q, n_e   :: REAL
      dipole   :: VEC{REAL}(3)
      quadru   :: MAT{REAL}(3,3)
      spn, out :: BIN
      c :: INT

      spn = FALSE
      if (present(spin)) spn = spin

      out = FALSE
      if (present(output)) out = output

      ! Make the AO density matrix
      DM.create(.n_bf,.n_bf)
      if (spn) then; .make_r_Sz_density_mx(DM)
      else;          .make_r_density_mx(DM)
      end

      ! Total no of electrons (check)
      n_e = ZERO

      ! Loop over atoms "c"
      do c = 1,.n_atom

         if (.atom(c).atomic_number<1) cycle

         ! Get density N0 for atom "c"
         .make_Hirshfeld?_atom_ED_grid(N0,pts,c,DM)

         ! Integration points
         r1 = pts(:,1)
         r2 = pts(:,2)
         r3 = pts(:,3)

         ! Atom c position
         c1 = .atom(c).position(1)
         c2 = .atom(c).position(2)
         c3 = .atom(c).position(3)

         ! Make moments
         q   = sum(N0)
         n_e = n_e + q

         dipole(1) = sum(N0*(r1-c1))
         dipole(2) = sum(N0*(r2-c2))
         dipole(3) = sum(N0*(r3-c3))

         quadru(1,1) = sum(N0*(r1-c1)*(r1-c1))
         quadru(2,2) = sum(N0*(r2-c2)*(r2-c2))
         quadru(3,3) = sum(N0*(r3-c3)*(r3-c3))
         quadru(1,2) = sum(N0*(r1-c1)*(r2-c2))
         quadru(1,3) = sum(N0*(r1-c1)*(r3-c3))
         quadru(2,3) = sum(N0*(r2-c2)*(r3-c3))
         quadru(2,1) = quadru(1,2)
         quadru(3,1) = quadru(1,3)
         quadru(3,2) = quadru(2,3)


         ! charges and moments
         q      = -q + .atom(c).atomic_number
         dipole = -dipole
         quadru = -quadru

         ! Assign the charges and moments
         .atom(c).set_charge(q)
         .atom(c).set_dipole(dipole)
         .atom(c).set_quadrupole(quadru)

         ! Clean up
         pts.destroy
         N0.destroy

      end ! -- integration atom c

      ! Clean up
      DM.destroy

      ! Check integration accuracy
      if (out) then
      stdout.flush
      stdout.text("Making Hirshfeld? atom moments ...")
      stdout.flush
      stdout.show("Check: no. of electrons =",n_e)
      end

      ! Put charges to asymmetric unit
      if (.crystal.allocated) then
         .crystal.destroy_asymmetric_unit
         .crystal.update_fragment_info(.atom)
      end

   end

   make_r_HA_moments(spin,output) :: get_from(make_atomic_moments, Hirshfeld?=>Hirshfeld), leaky
   ! Make the restricted atomic moments for some partitioning.
   ! NOTE: the charges & dipoles are set for every .atom 
   !       and then propagated to .asymmetric_unit_atoms.
   !       Needed for core-matrix-cluster-of-charges method
   ! NOTE: Moments aren't printed, but total no. of electrons
   !       is printed as a check unless supressed via "output".
   end

