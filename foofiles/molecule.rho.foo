   make_BA_info(output) :: leaky
   ! Make the Becke atomic charges & moments.
   ! Set up Becke grid before (if not there) ready for integration.
      self   :: INOUT
      output :: BIN, optional, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.basis_info_made,"no basis info")

      ! Set up integration grid
      .set_up_becke_grid

      ! Make Becke moments
      .make_r_BA_moments(output=output) ! NOT PURE

   end

   make_SS_info(output) :: leaky
   ! Make the Stratmann-Scuseria atomic charges & moments.
   ! Set up Becke grid before (if not there) ready for integration.
      self   :: INOUT
      output :: BIN, optional, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.basis_info_made,"no basis info")

      ! Set up integration grid
      .set_up_becke_grid

      ! Make Becke moments
      .make_r_SS_moments(output=output) ! NOT PURE

   end

   make_SA_info(output) :: leaky
   ! Make the TFVA atomic charges & moments.
   ! Set up Becke grid before (if not there) ready for integration.
   ! The latter need Salvador neighbors & radii which are also made.
      self   :: INOUT
      output :: BIN, optional, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.basis_info_made,"no basis info")

      ! Set up integration grid
      .set_up_becke_grid 

      ! Make Salvador radii
      .make_Salvador_radii
      .becke_grid.set_Salvador_bonds(.Salvador_bonds_for)
      .becke_grid.set_Salvador_radii(.Salvador_radii_for)
      .becke_grid.set_Salvador_chi(.Salvador_chi)

      ! Make Salvador moments
      .make_r_SA_moments(output=output) ! NOT PURE

   end


!  ============
!  Form factors
!  ============

   make_unique_IAM_atom_FFs(ff) :: leaky, PURE
   ! Get "ff", the IAM structure factors for the symmetry generated
   ! K points with *no* thermal smearing, for every unique atom.
      self :: INOUT
      ff   :: MAT{CPX}@, OUT

   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no x-ray data")
   ENSURE(.crystal.asymmetric_unit_atom.allocated,"no asymmetric unit atoms")
   ENSURE(.crystal.unique_atom_for_frag_atom.allocated,"no unique-frag_atom")
   ENSURE(.crystal.asym_atom_for_frag_atom.allocated,"no asym-frag_atom")

      k_pts :: MAT{REAL}@
      n_atom,n_k, u,f :: INT
      rf :: REAL
   ! old :: BIN
   ! rc :: VEC{REAL}(3)
   ! k  :: INT
   ! k1,k2,k3,kr :: REAL
   ! sf :: CPX

      ! Asymmetric unit atoms;
      ! Symmetry generated K points and SF's
      n_atom = .crystal.asymmetric_unit_atom.dim
      n_k    = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k,n_atom)

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! Make the SF's
      ff = ZERO

      ! Loop over integration atoms "c"
      do u = 1,.crystal.n_unique_frag_atoms

         ! Atoms
         f = .crystal.unique_frag_atom(u)

         ! Structure factors
         .atom(f).make_FT(ff(:,u),k_pts)

         ! Repetition (site-symmetry) factor
         rf = .crystal.frag_atom_sym_factor(f)
         if (rf.is_zero) cycle
         rf = ONE/rf

         ! Scale
         ff(:,u) = ff(:,u) * rf

      ! ! Add on real part of dispersion - testing only
      ! if (.crystal.xray_data.use_real_dispersion) then
      !    sf = .atom(c).dispersion_correction * rf
      !    rc = .atom(c).position
      !    do k = 1,n_k
      !       k1 = k_pts(k,1)
      !       k2 = k_pts(k,2)
      !       k3 = k_pts(k,3)
      !       kr = k1*rc(1)+k2*rc(2)+k3*rc(3)
      !       ff(k,u) = ff(k,u) + sf*COMPLEXIFY(cos(kr),sin(kr))
      !    end
      ! end

      end

      ! Clean up
      k_pts.destroy

   end

!   get_Tanaka_atom_FFs(ff_n,spin_density) :: leaky, PURE
!   ! Get "ff_n", the Tanaka *static* atomic form factors for the
!   ! symmetry related K points for every unique atom.
!   ! NOTE: "ff_n" is the FT rho_a(r), eqn (3) in Jayatilaka 2008,
!   ! Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn (11) except
!   ! without the thermal smearing factor.
!      self :: INOUT
!      ff_n :: MAT{CPX}@, OUT
!      spin_density :: BIN, optional, IN
!
!   ENSURE(.basis_info_made,"no basis info")
!   ENSURE(.atom.allocated,"no atom list")
!   ENSURE(.density_mx.allocated, "no density matrix")
!   ENSURE(.crystal.allocated, "no crystal")
!   ENSURE(.crystal.xray_data.allocated, "no reflection data")
!   ENSURE(.crystal.xray_data.allocated, "no x-ray reflection data")
!   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")
!
!      FT :: MAT3{CPX}@
!      k_pts, DM, pf :: MAT{REAL}@
!      sh :: SHELL2
!      n_atom, n_k,k, q :: INT
!      ua,ra,fa,la,na,atom_a :: INT
!      ub,   fb,lb,nb,atom_b :: INT
!      pa,pk  :: VEC{REAL}(3)
!    ! pb     :: VEC{REAL}(3)
!      sa     :: REAL
!      cutoff :: REAL
!      do_it,spin :: BIN
!      II, phase  :: CPX
!
!      ! Asymmetric unit atoms
!      n_atom = .crystal.asymmetric_unit_atom.dim
!
!      ! Symmetry generated K points and SF's
!      n_k = .crystal.n_unique_SF_k_pts
!
!      ! Form factor array (no temp factor) (leaky)
!      ff_n.create(n_k,n_atom)
!      ff_n = IMAGIFY(ZERO)
!      II   = IMAGIFY(ONE)
!
!      ! Make list of symmetry non-equivalent symops
!      ! and the necessary k points
!      k_pts.create(n_k,3)
!      .crystal.make_unique_X_SF_k_pts(k_pts)
!
!      ! X-ray or PND?
!      spin = FALSE
!      if (present(spin_density)) spin = spin_density
!
!      ! Density matrix (leaky)
!      if (NOT spin) then; .make_r_density_mx
!      else;               .make_r_Sz_density_mx
!      end
!      ENSURE(.density_mx.r.allocated, "no restricted DM")
!
!      ! Store density matrix
!      DM.create(.n_bf,.n_bf)
!      DM = .density_mx.r
!
!      ! Too small threshhold
!      cutoff = TOL(10)/.n_shell_pairs
!
!      ! Loop over all shell pairs
!      do q = 1,.n_shell_pairs
!
!         ! Get shell pairs
!         .set_shell2_from(q,sh,fa,la,na,fb,lb,nb,atom_a,atom_b)
!
!         ! Skip?
!         ua = .crystal.unique_frag_atom.index_of_value(atom_a)
!         ub = .crystal.unique_frag_atom.index_of_value(atom_b)
!         do_it = (ua>0 OR ub>0) AND NOT sh.skip_ft(cutoff)
!
!         ! =============================
!         ! Do (non-zero) asym-atom pairs
!         ! =============================
!         if (do_it) then
!
!            ! Tanaka gaussian-partition factors
!            pf.create(sh.a.n_cc,sh.b.n_cc)
!
!            ! Block of FT basis-function integrals
!            FT.create(n_k,na,nb)
!
!            if (atom_a==atom_b) then ! SAME ATOMS A==B
!
!               ! Site symmetry factor can't be zero
!               pa = .atom(atom_a).position
!               ra = .crystal.frag_atom_sym_factor(atom_a)
!               sa = ONE/ra
!
!               ! Only one atom -- no need to partition
!               pf = ONE
!              
!               ! The static FT integrals 
!               sh.make_FT_parted(FT,k_pts,pf)
!
!               if (fa==fb) then
!                  ! Diagonal shell
!                  do k = 1,n_k
!                     pk = k_pts(k,:)
!                     phase = exp(-II*dot_product(pk,pa))
!                     ff_n(k,ua) = ff_n(k,ua) +     sum(FT(k,:,:)*DM(fa:la,fb:lb))*phase
!                  end
!               else
!                  ! Off-diagonal shell -- count twice for same atom
!                  do k = 1,n_k
!                     pk = k_pts(k,:)
!                     phase = exp(-II*dot_product(pk,pa))
!                     ff_n(k,ua) = ff_n(k,ua) + TWO*sum(FT(k,:,:)*DM(fa:la,fb:lb))*phase
!                  end
!               end
!
!          ! else ! DIFFERENT ATOMS A /= B
!
!          !    ! Zero site symmetry factors if not asymmetric-unit atom
!          !    pa = .atom(atom_a).position
!          !    ra = .crystal.frag_atom_sym_factor(atom_a)
!          !    if      (ua<1) then; sa = ZERO
!          !    else;                sa = ONE/ra
!          !    end
!          !    pb = .atom(atom_b).position
!          !    rb = .crystal.frag_atom_sym_factor(atom_b)
!          !    if      (ub<1) then; sb = ZERO
!          !    else;                sb = ONE/rb
!          !    end
!
!          !    ! Make the ATOM A static FT integrals, lower-diagonal
!          !    if (ua>1) then
!          !       sh.make_tanaka_partition(pf,sa,sb,center="A")
!          !       sh.make_FT_parted(FT,k_pts,pf)
!          !       do k = 1,n_k
!          !          phase = exp(-II*dot_product(pk,pa))
!          !          ff_n(k,ua) = ff_n(k,ua) + sum(FT(k,:,:)*DM(fa:la,fb:lb))*phase
!          !       end
!          !    end
!
!          !    ! Make the ATOM B static FT integrals, lower-diagonal
!          !    ! No need to actually transpose ...
!          !    if (ub>1) then
!          !       sh.make_tanaka_partition(pf,sa,sb,center="B")
!          !       sh.make_FT_parted(FT,k_pts,pf)
!          !       do k = 1,n_k
!          !          phase = exp(-II*dot_product(pk,pb))
!          !          ff_n(k,ub) = ff_n(k,ub) + sum(FT(k,:,:)*DM(fa:la,fb:lb))*phase
!          !       end
!          !    end
!          !   
!            end
!
!            ! Clean
!            pf.destroy
!            FT.destroy
!
!         end
!
!         ! Clean
!         sh.destroy_ptr_part
!
!      end
!
!      ! Clean up
!      k_pts.destroy
!      DM.destroy
!
!   end


   make_aspherical_atomic_FFs(ff) :: leaky
   ! Get "ff", the *static* Hirshfeld atom form factors for the
   ! symmetry related K points, for every unique fragment atom.
   ! NOTE: "ff" is the FT rho_a(r), eqn (3) in Jayatilaka (2008)
   !       Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn 
   !       (11) except without the thermal smearing factor.
      self :: INOUT
      ff   :: MAT{CPX}@, OUT

      ! Hirshfeld-atom structure factors
      ! NOTE: in iteration 0, these were already calculated
      !       as part of make_X_SFs ... double work!
      select case (.crystal.xray_data.partition_model)
      case("oc-crystal23  "); .make_C23_Hirshfeld_atom_FFs(ff) ! NOT PURE
      case("oc-g-hirshfeld"); .make_gHirshfeld_atom_FFs(ff)
      case("oc-g-salvador "); .make_gSalvador_atom_FFs(ff)
      case("oc-hirshfeld  "); .make_Hirshfeld_atom_FFs(ff)
      case("oc-salvador   "); .make_Salvador_atom_FFs(ff)
      case("oc-sph-tfva   "); .make_sph_TFVA_atom_FFs(ff)
      end

   end

   make_Hirshfeld_atom_FFs(ff,spin_density) :: leaky, PURE
   ! Get "ff", the static Hirshfeld atom form factors for the
   ! symmetry related K points with *no* thermal smearing, for every
   ! unique fragment atom.
   ! NOTE: this version uses Kang's density code!
   ! NOTE: "ff" is the FT rho_a(r), eqn (3) in Jayatilaka 2008,
   ! Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn (11) except
   ! without the thermal smearing factor.
      self :: INOUT
      ff   :: MAT{CPX}@, OUT
      spin_density :: BIN, optional, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      rc          :: VEC{REAL}(3)
      rho         :: VEC{REAL}@
      pt, k_pts   :: MAT{REAL}@
      cutoff      :: REAL
      ss,sc,s2    :: REAL
      k1,k2,k3,kr :: REAL
      n_atom, u,c :: INT
      n_k,  k     :: INT
      n_pt, i     :: INT
      spin        :: BIN
      sf          :: CPX

      ! Asymmetric unit atoms
      n_atom = .crystal.asymmetric_unit_atom.dim

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k,n_atom)
      ff = ZERO

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! X-ray or PND?
      spin = FALSE
      if (present(spin_density)) spin = spin_density

      ! Density matrix (leaky)
      if (NOT spin) then; .make_r_density_mx
      else;               .make_r_Sz_density_mx
      end
      ENSURE(.density_mx.r.allocated, "no restricted DM")

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Loop over asymmetric/unique atoms "c"
      parallel do u = 1,.crystal.n_unique_frag_atoms

         c  = .crystal.unique_frag_atom(u)
         rc = .atom(c).position

         ! Site-symmetry factor for this atom
         ss = .crystal.frag_atom_sym_factor(c)
         sc = ss
         if (sc.is_zero) cycle
         s2 = ONE/sc

         ! Get the Becke grid for atom "c" (leaky)
         .make_Hirshfeld_atom_ED_grid(rho,pt,c,.density_mx.r)
         n_pt = pt.dim1   ! <-- New n_pt !!!

         ! The (unique) atomic form factors
         ! Fourier transform, yay!
         do k = 1,n_k
            k1 = k_pts(k,1)
            k2 = k_pts(k,2)
            k3 = k_pts(k,3)
            sf = IMAGIFY(ZERO)
            do i = 1,n_pt
               kr = k1*pt(i,1)+k2*pt(i,2)+k3*pt(i,3)
               sf = sf + rho(i)*exp(IMAGIFY(kr))
            end
            ff(k,u) = sf * s2 * .atom(c).site_occupancy ! <-----
         end

         ! Clean up
         rho.destroy
         pt.destroy

      end ! -- loop over atom "c"

      ! Parallel
      if (WORK_IS_SHARED) then
         PARALLEL_SUM(ff)
      end

      ! Clean up
      k_pts.destroy

   end

   make_Salvador_atom_FFs(ff) :: leaky, PURE
   ! Make "ff", the static Salvador (TFVA) atom form factors for the
   ! symmetry related K points with *no* thermal smearing, for every
   ! unique fragment atom.
   ! NOTE: "ff" is the FT rho_a(r), eqn (3) in Jayatilaka 2008,
   ! Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn (11) except
   ! without the thermal smearing factor.
      self :: INOUT
      ff   :: MAT{CPX}@, OUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.xray_data.allocated, "no x-ray reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      rc          :: VEC{REAL}(3)
      rho         :: VEC{REAL}@
      pt, k_pts   :: MAT{REAL}@
      cutoff      :: REAL
      ss,sc,s2    :: REAL
      k1,k2,k3,kr :: REAL
      n_atom, u,c :: INT
      n_k,  k     :: INT
      n_pt, i     :: INT
      sf          :: CPX

      ! Asymmetric unit atoms
      n_atom = .crystal.asymmetric_unit_atom.dim

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k,n_atom)
      ff = ZERO

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! Density matrix (leaky)
      .make_r_density_mx
      ENSURE(.density_mx.r.allocated, "no restricted DM")

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Loop over asymmetric/unique atoms "c"
      parallel do u = 1,.crystal.n_unique_frag_atoms

         c  = .crystal.unique_frag_atom(u)
         rc = .atom(c).position

         ! Site-symmetry factor for this atom
         ss = .crystal.frag_atom_sym_factor(c)
         sc = ss
         if (sc.is_zero) cycle
         s2 = ONE/sc

         ! Get the Becke grid for atom "c" (leaky)
         ! Grid points "pt" are around position "rc"
         .make_Salvador_atom_ED_grid(rho,pt,c,.density_mx.r)
         n_pt = pt.dim1   ! <-- New n_pt !!!

         ! The (unique) atomic form factors
         ! Fourier transform, yay!
         do k = 1,n_k
            k1 = k_pts(k,1)
            k2 = k_pts(k,2)
            k3 = k_pts(k,3)
            sf = IMAGIFY(ZERO)
            do i = 1,n_pt
               kr = k1*pt(i,1)+k2*pt(i,2)+k3*pt(i,3)
               sf = sf + rho(i)*exp(IMAGIFY(kr))
            end
            ff(k,u) = sf * s2 * .atom(c).site_occupancy ! <-----
         end

         ! Clean up
         rho.destroy
         pt.destroy

      end ! -- loop over atom "c"

      ! Parallel
      if (WORK_IS_SHARED) then
         PARALLEL_SUM(ff)
      end

      ! Clean up
      k_pts.destroy

   end

   make_sph_TFVA_atom_FFs(ff) :: leaky, PURE
   ! Make "ff", the static Hirshfeld atom form factors for the
   ! symmetry related K points with *no* thermal smearing, for every
   ! unique fragment atom.
   ! NOTE: "ff" is the FT rho_a(r), eqn (3) in Jayatilaka 2008,
   ! Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn (11) except
   ! without the thermal smearing factor.
      self :: INOUT
      ff   :: MAT{CPX}@, OUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.xray_data.allocated, "no x-ray reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      rc          :: VEC{REAL}(3)
      rho, pt     :: VEC{REAL}@
      k_pts       :: MAT{REAL}@
      cutoff      :: REAL
      ss,sc,s2    :: REAL
      kk,kr,kc    :: REAL
      n_atom, u,c :: INT
      n_k,  k     :: INT
      n_pt, i     :: INT
      sf          :: REAL
      sfc         :: CPX

      ! Asymmetric unit atoms
      n_atom = .crystal.asymmetric_unit_atom.dim

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k,n_atom)
      ff = ZERO

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! Density matrix (leaky)
      .make_r_density_mx
      ENSURE(.density_mx.r.allocated, "no restricted DM")

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Loop over asymmetric/unique atoms "c"
      parallel do u = 1,.crystal.n_unique_frag_atoms

         c  = .crystal.unique_frag_atom(u)
         rc = .atom(c).position

         ! Site-symmetry factor for this atom
         ss = .crystal.frag_atom_sym_factor(c)
         sc = ss
         if (sc.is_zero) cycle
         s2 = ONE/sc

         ! Get the Becke grid for atom "c" (leaky)
         ! Note: "pt" is around the origin, not "rc"
         .make_sph_avgd_SA_ED_grid(rho,pt,c)
         n_pt = pt.dim1   ! <-- New n_pt !!!

         ! The (unique) atomic form factors
         ! Fourier transform, yay!
         do k = 1,n_k
            kk = norm2(k_pts(k,:))
            sf = ZERO
            do i = 1,n_pt
               kr = kk*pt(i)
               sf = sf + rho(i)*sin(kr)/kr
            end
            kc  = dot_product(k_pts(k,:),rc)
            sfc = exp(IMAGIFY(kc)) ! position phase
            ff(k,u) = sfc * s2 * .atom(c).site_occupancy ! <-----
         end

         ! Clean up
         rho.destroy
         pt.destroy

      end ! -- loop over atom "c"

      ! Parallel
      if (WORK_IS_SHARED) then
         PARALLEL_SUM(ff)
      end

      ! Clean up
      k_pts.destroy

   end
   
   delete_Hirshfeld_atom_FFs
   ! Delete all the asymmetric unit form factor (FF) files
   ! before they are (re)generated.
      self :: IN

      arch :: ARCHIVE
      a :: INT

      do a = 1,.crystal.n_asymmetric_unit_atoms
         arch.set(trim(.crystal.asymmetric_unit_atom(a).label)//"-SFs")
         arch.delete
      end 

   end


   make_gHirshfeld_atom_FFs(ff) :: leaky, PURE
   ! Get "ff", the static gaussian-partitioned Hirshfeld atom form
   ! factors for the symmetry related K points "k_pts", for every
   ! unique fragment atom.
   ! NOTE: This version uses interpolators for efficiency.
      self :: IN
      ff   :: MAT{CPX}@, OUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.density_mx.r.allocated, "no restricted DM")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      sh    :: SHELL2
      Wc    :: VEC{REAL}@
      pts   :: MAT{REAL}@
      k_pts :: MAT{REAL}@
      DM    :: MAT{REAL}@
      FT_ab :: MAT3{CPX}@
      n_k,k, q        :: INT
      n_atom,u,c      :: INT
      fa,la,na,atom_a :: INT
      fb,lb,nb,atom_b :: INT
      cutoff, ss      :: REAL

   ! TF    :: MAT3{REAL}@
   ! Wcm   :: MAT{REAL}@
   ! Ua,Ub :: MAT{REAL}(3,3)

      ! Parameters
      cutoff = TOL(10)/.n_shell_pairs
      n_atom = .crystal.asymmetric_unit_atom.dim

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k,n_atom)
      ff = ZERO

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! Shell pairs
      do q = 1,.n_shell_pairs

         .set_shell2_from(q,sh,fa,la,na,fb,lb,nb,atom_a,atom_b)

         ! Get thermal factors "TF"
      ! TF.create(n_k,sh.a.n_cc,sh.b.n_cc)
      ! TF = ONE
      ! Ua = .atom(atom_a).ADP_tensor
      ! Ub = .atom(atom_b).ADP_tensor
      ! sh.make_temperature_factors(TF,"tc-tanaka",k_pts,Ua,Ub)

         DM  = .density_mx.r(fa:la,fb:lb)
         if (fa/=fb) DM = TWO*DM

         pts = transpose(sh.pair_center)
         Wc.create(pts.dim1)
         FT_ab.create(n_k,na,nb)
         
         ! Loop on asymmetric/unique atoms "c"
         do u = 1,.crystal.n_unique_frag_atoms

            c  = .crystal.unique_frag_atom(u)

            ! Site-symmetry & occupancy for this atom
            ss = .crystal.frag_atom_sym_factor(c)
            if (ss.is_zero) cycle
            ss = .atom(c).site_occupancy/ss
         
            ! Get weights
            .make_stockholder_atom_weight_int(Wc,c,pts,.overlapping_atoms_for_atom(c).element)
            Wc = ss*Wc
            
            ! Do FT with partition factor
            sh.make_FT_no_TF(FT_ab,k_pts,Wc)
         ! Wcm = reshape(Wc,[sh.a.n_cc,sh.b.n_cc])
         ! sh.make_ft(FT_ab,k_pts,TF,Wcm)
            
            ! Trace with density matrix
            do k = 1,n_k
               ff(k,u) = ff(k,u) + sum(FT_ab(k,:,:)*DM)
            end
         
         end
         
         ! Clean
         FT_ab.destroy
         Wc.destroy
         pts.destroy
         DM.destroy
      ! TF.destroy

         ! Clean
         sh.destroy_ptr_part

      end

   end

   make_gSalvador_atom_FFs(ff) :: leaky, PURE
   ! Get "ff", the static gaussian-partitioned Hirshfeld atom form
   ! factors for the symmetry related K points "k_pts", for every
   ! unique fragment atom.
   ! NOTE: This version uses interpolators for efficiency.
      self :: IN
      ff   :: MAT{CPX}@, OUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.density_mx.r.allocated, "no restricted DM")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      sh    :: SHELL2
      Wc    :: VEC{REAL}@
      pts   :: MAT{REAL}@
      k_pts :: MAT{REAL}@
      DM    :: MAT{REAL}@
      FT_ab :: MAT3{CPX}@
      n_k,k, q        :: INT
      n_atom,u,c      :: INT
      fa,la,na,atom_a :: INT
      fb,lb,nb,atom_b :: INT
      cutoff, ss      :: REAL

      ! Parameters
      cutoff = TOL(10)/.n_shell_pairs
      n_atom = .crystal.asymmetric_unit_atom.dim

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k,n_atom)
      ff = ZERO

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! Shell pairs
      do q = 1,.n_shell_pairs

         .set_shell2_from(q,sh,fa,la,na,fb,lb,nb,atom_a,atom_b)

         DM  = .density_mx.r(fa:la,fb:lb)
         if (fa/=fb) DM = TWO*DM

         pts = transpose(sh.pair_center)
         Wc.create(pts.dim1)
         FT_ab.create(n_k,na,nb)
         
         ! Loop on asymmetric/unique atoms "c"
         do u = 1,.crystal.n_unique_frag_atoms

            c  = .crystal.unique_frag_atom(u)

            ! Site-symmetry & occupancy for this atom
            ss = .crystal.frag_atom_sym_factor(c)
            if (ss.is_zero) cycle
            ss = .atom(c).site_occupancy/ss
         
            ! Get weights
            .becke_grid.make_Salvador_cell_fn(Wc,pts,c)
            Wc = ss*Wc
            
            ! Do FT with partition factor
            sh.make_FT_no_TF(FT_ab,k_pts,Wc)
            
            ! Trace with density matrix
            do k = 1,n_k
               ff(k,u) = ff(k,u) + sum(FT_ab(k,:,:)*DM)
            end
         
         end
         
         ! Clean
         FT_ab.destroy
         Wc.destroy
         pts.destroy
         DM.destroy

         ! Clean
         sh.destroy_ptr_part

      end

   end


   make_C23_Hirshfeld_atom_FFs(ff) :: leaky
   ! MAke "ff", the static Hirshfeld atom form factors (from a
   ! periodic CRYSTAL23 calculation) for the symmetry related K points
   ! with *no* thermal smearing, for every unique atom.
   ! NOTE: "ff" is the FT rho_a(r), eqn (3) in Jayatilaka 2008,
   ! Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn (11) except
   ! without the thermal smearing factor.
      self :: INOUT
      ff :: MAT{CPX}@, OUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      rho,wt,Wa :: VEC{REAL}@
      pt, k_pts :: MAT{REAL}@
      library_basis_labels :: VEC{STR}@
      library  :: STR(len=PATH_SIZE)
      cluster  :: CRYSTAL@
      HS_atoms :: VEC{ATOM}@
      sa,  k1,k2,k3,kr :: REAL
      n_atom, n_k,n_pt :: INT
      a,i,k :: INT
      sf :: CPX
      tmp_atom :: VEC{ATOM}@
      found :: BIN
      pos1,pos2 :: VEC{REAL}(3)

      ! Asymmetric unit atoms,
      ! Symmetry-generated K points and/or SF's
      n_atom = .crystal.asymmetric_unit_atom.dim
      n_k    = .crystal.n_unique_SF_k_pts

      ! Form factor array (leaky)
      ff.create(n_k,n_atom)
      ff = ZERO

      ! Make the Thakkar slaterbases
      .slaterbasis.destroy
      .slaterbasis_name = "Thakkar" ! ugly
      .atom.set_basis_kind("slater")
      library = .slaterbasis.library_file(.slaterbasis_name)
      library_basis_labels = .atom.library_basis_labels(.slaterbasis_name)
      .slaterbasis.read_library_data(library,library_basis_labels) !  NOT PURE
      library_basis_labels.destroy
      .slaterbasis.unnormalize

      ! Ensure .atom's have their .slaterbases
      .make_slater_interpolators
      .resolve_slaterbases(.crystal.asymmetric_unit_atom)

      ! Make a new crystal only for generating clusters.
      ! Since we need to define the fragment_geometry to be
      ! the asymmetric unit for this purpose, but for
      ! structure refinement we need to stay with the C23
      ! XML file geometry which is the [-half,+half]^3 cell.
      ! NOTE: wasteful copy of xray_data is done here
      ! In case of periodic defragment, .asymmetric_unit_atom(:) are compared with .atom(:)
      !   If an asym_atom is not found in .atom, then it is manually updated by (CRY23 primitive_cell) lattice translastion.
      !   Without defragment, all the asym_atoms are always found among .atom(:). 2025.Mar.19 Kang

      cluster = .crystal

!!! // phar_defragment compatibility //
!
!! Kang Note. 1-to-1 match between asymmetric_unit_atom(=tmp_atom) and (.molecule).atom (=atoms from Crystal23 xml file)
!            Without pHAR_defragment, it does basically nothing.
!            If .asymmetric_unit_atom(a) is not found in .atom, then it is replaced by one of atom(i)
!            Take a lattice-translation-equivalent atom in atom(:). Use the CRY23 primitive unit cell, not crystallographic .crystal.unit_cell
!            tmp_atom will be the source of HS_atoms 
      tmp_atom.create(.crystal.n_asymmetric_unit_atoms)
      tmp_atom = .crystal.asymmetric_unit_atom

      do a = 1,tmp_atom.dim
      
         pos1 = tmp_atom(a).position ! pos1 from asymmetric_unit_atom
         found = FALSE
 
         do i = 1,.atom.dim  ! Kang comment. It is not efficient search. any found item is not excluded from the search

            pos2 = .atom(i).position ! pos2 from Crystal23 xml_atom (=.atom); .atom is for the ED calculation
            if (pos1.equals(pos2)) then
!>DEBUG         stdout.show("cry.asym_atom, .atom" ,[a,i] ) ! Without phar_defragment, it is same to .crystal.asym_atom_for_frag_atom
               found = TRUE 
               exit
            end     
         end
         if (found) cycle

         ! asymmetric_unit_atom is not found in .atom(:). Then find translation-equivalent one from .atom(:)
         do i = 1,.atom.dim
            pos2 = .atom(i).position - pos1 ! Abusing variable "pos2". Now pos2 is the coordinate difference.
            pos2 = matmul(.crystal23.Primitive_unit_cell.inverse_mx, pos2)  ! To fractional coord (in C23 primitive cell)
            pos2 = mod( pos2 + HALF + ONE, ONE ) - HALF ! modulo operation. Map to [-0.5, 0.5)

            if ( pos2.is_zero ) then 
!               stdout.show("cry.asym_atom translated, .atom" ,[a,i] ) ! Without periodic defragmen
               tmp_atom(a).set_position( .atom(i).position ) ! Overwrite tmp asym atom
               ! Kang's note. You may double check by comparing ADPs. 
               exit
            end
         end         
      end 
      .crystal.asymmetric_unit_source = "Crystal23-xml-selected-by-tonto"

!! //phar_defragment compatibility// by Kang 2025.Mar.20

      cluster.asymmetric_unit_geometry.destroy
      cluster.asymmetric_unit_atom.destroy
      cluster.update_fragment_info(tmp_atom) ; tmp_atom.destroy ! tmp_atom ~ .asymmetric_unit_atom

      cluster.asymmetric_unit_atom.set_basis_kind("slater")
     
      ! Make the HS_atoms & resolve the interpolators
      cluster.make_asym_unit_HS_cluster(HS_atoms,TOL(10)) ! <=== Kang note: HS_atoms are the source of becke_grid
      HS_atoms.set_basis_kind("slater")
      HS_atoms.resolve_bases(.slaterbasis,.slaterbasis_name)
      HS_atoms.update_kinds    

!>DEBUG: show super cluster for Hirshfeld weight function calculation
!      stdout.text(" ----------------------------------------------------")
!      stdout.text(" CLUSTER GEOMETRY for Hirshfeld partitioning function")
!      stdout.text(" ----------------------------------------------------")
!      HS_atoms.put_coordinates(no_header=TRUE)

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! Set up integration grid for the HS atom cluster
      .becke_grid.create
      .becke_grid.set_atom_info(HS_atoms) ! NOT PURE. Kang note: HS_atoms = .becke_grid.atom
      .becke_grid.set_one_atom_grid_data

      ! Loop over asymmetric/unique atoms "c"
      parallel do a = 1,.crystal.n_asymmetric_unit_atoms

         ! Site-symmetry factor for this atom
         sa = .crystal.asym_atom_sym_factor(a)
         if (sa.is_zero) cycle
         sa = ONE/sa

         ! Get the Becke grid for one-atom grid
         ! For 'a' from 1 to .n_asym_atoms:
         ! HS_atoms(a) == .asymmetric_unit_atom(a)
         .becke_grid.make_atom_grid(pt,wt,a)  
         n_pt = pt.dim1

         ! Stockholder weight function "Wa" for atom "a"
         Wa.create(n_pt)
         HS_atoms.make_Hirshfeld_weight_grid(Wa,pt,a)

         ! Incorporate integration weight
         wt = Wa*wt
         Wa.destroy

         ! Prune the grid with new "wt"
         ! and new no of points, n_pt 
         .becke_grid.prune_grid(pt,wt)
         n_pt = pt.dim1 ! *New* points
         !!!!!!!!!!!!!!
    
         ! Density for atom "a"
         ! NOTE: only uses actual "pt" array for the C23 .atom
         ! geometry & density matrix read from the XML file.
         rho.create(n_pt)
         .make_CRYSTAL23_ED_grid_v1(rho,pt)

         ! Weight the atom "a" density
         ! Now only the FT e^(ik.r) part missing
         rho = rho*wt

         ! Make the (symmetry-generated) atomic form factors "ff"
         ! Fourier transform, yay!
         do k = 1,n_k
            k1 = k_pts(k,1)
            k2 = k_pts(k,2)
            k3 = k_pts(k,3)
            sf = IMAGIFY(ZERO)
            do i = 1,n_pt
               kr = k1*pt(i,1)+k2*pt(i,2)+k3*pt(i,3)
               sf = sf + rho(i)*exp(IMAGIFY(kr))
            end
            ff(k,a) = sf * sa ! <-----
         end

         rho.destroy
         wt.destroy
         pt.destroy

      end ! -- loop over atom "a"

      ! Parallel
      if (WORK_IS_SHARED) then
         PARALLEL_SUM(ff)
      end

      ! Clean up
      k_pts.destroy
      HS_atoms.destroy

   end


   get_unique_fragHAR_SFs(spin_density) :: leaky
   ! Write out the fragHAR static structure factors for each
   ! .atom_group.mol molecule.
      self :: INOUT
      spin_density :: BIN, optional, IN

   ENSURE(.atom_group.allocated,"no .atom_group")
   ENSURE(.mol.allocated,"no .mol")
   ENSURE(.mol.dim==.atom_group.dim,"wrong size, .mol")
   ENSURE(.cif.allocated,"no cif specified")

      g, n_group :: INT

      ! Make ANO's & interpolators for parent
      ! WARNING: dies if no ANOs or interpolators
   ! .make_ANO_data

      ! Make sutructure factors for each residue
      do g = 1,.atom_group.dim

         ! NOTE: change DFT -> becke
         .mol(g).initialize_DFT_grids

         ! Assign previously made ANOs
         .mol(g).resolve_ANOs_from(self)

         ! Write the SFs for each fragment to disk
         n_group = .atom_group(g).atom_index.dim
         .mol(g).get_Hirshfeld_atom_FFs_disk(n_group,spin_density)

      end

   end

   get_Hirshfeld_atom_FFs_disk(n_last,spin_density) :: leaky
   ! Write out the static Hirshfeld atom form factors for the symmetry
   ! related K points with *no* thermal smearing, for every unique
   ! atom. If "n_last" is present only do unique atoms up to this
   ! atom, which is useful to eliminate capping atoms in a fragment.
   ! If "spin_densityy" is present the spinb density SFs are made.
   ! NOTE: The integrals "sf_u" written  are the FT rho_a(r), eqn (3)
   ! in Jayatilaka 2008, Acta Cryst A 64 p. 383-393. It is also f_a(q)
   ! in eqn (11) except without the thermal smearing factor.
      self   :: INOUT
      n_last :: INT, optional, IN
      spin_density :: BIN, optional, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      rc     :: VEC{REAL}(3)
      wt,rho :: VEC{REAL}@
      pt     :: MAT{REAL}@
      k_pts  :: MAT{REAL}@
      n_unique, n_atom :: INT
      u,c,k,n_k,i,n_pt :: INT
      cutoff,sc,s2 :: REAL
      k1,k2,k3, kr :: REAL
      sf_u   :: VEC{CPX}@
      sf     :: CPX
      spin   :: BIN
      arch   :: ARCHIVE@

      n_unique = .crystal.n_unique_frag_atoms
      if (present(n_last)) n_unique = n_last

      ! Asymmetric unit atoms
      n_atom = .crystal.asymmetric_unit_atom.dim

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      sf_u.create(n_k)

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! X-ray or PND?
      spin = FALSE
      if (present(spin_density)) spin = spin_density

      ! Density matrix (leaky)
      if (NOT spin) then; .make_r_density_mx
      else;               .make_r_Sz_density_mx
      end
      ENSURE(.density_mx.r.allocated, "no restricted DM")

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Loop over integration atoms "c"
      parallel do u = 1,n_unique

         sf_u = ZERO

         c  = .crystal.unique_frag_atom(u)
         rc = .atom(c).position

         ! Skip cap atoms
         if (.atom(c).is_cap_atom) cycle

         ! Repetition factor for this atom
         ! Also include the site occupancy factor
         ! (Dont forget this for the non-fragHAR routine)
         sc = .crystal.frag_atom_sym_factor(c)
         if (sc.is_zero) cycle
         s2 = .crystal.fragment_atom(c).site_occupancy/sc
      ! s2 = s2*s2

         ! Get the Becke grid for atom "c" (leaky)
         .becke_grid.make_atom_grid(pt,wt,c)

         ! Apply stockholder weights "Wc" for atom "c" to "wt"
         .apply_stockholder_atom_weight(wt,c,pt)

         ! Prune the grid with new "wt"
         .becke_grid.prune_grid(pt,wt)

         ! Density for atom "c"
         n_pt = pt.dim1   ! <-- New n_pt !!!
         rho.create(n_pt)
         .make_ED_grid_r_v2(rho,pt,.density_mx.r,cutoff)

         ! Weight the atom "c" density
         rho = rho*wt

         ! Get aspherical form factor sf_u
         do k = 1,n_k
            k1 = k_pts(k,1)
            k2 = k_pts(k,2)
            k3 = k_pts(k,3)
            sf = IMAGIFY(ZERO)
            do i = 1,n_pt
               kr = k1*pt(i,1)+k2*pt(i,2)+k3*pt(i,3)
               sf = sf + rho(i)*exp(IMAGIFY(kr))
            end
            sf_u(k) = sf * s2
         end

         ! Write out sf_u
         arch.create(trim(.atom(c).tag)//"-SFs")
         if (.crystal.xray_data.use_text_SFs) arch.set_format("ascii")
         arch.per_rank_write(sf_u)
         arch.destroy

         ! Clean up atom "c" stuff
         rho.destroy
         wt.destroy
         pt.destroy

      end ! -- loop over atom "c"

      ! NO barrier here -- deliberately. See MOLECULE.SCF:make_X_SFs_HAR_disk and
      ! MOLECULE.SCF:fragment_SCF, which have it instead.
      !
      ! One was added here on 2026-08-02 and removed the same day. It is wrong
      ! at THIS level because this routine has two kinds of caller:
      !
      !   collective  MOLECULE.SCF:make_X_SFs_HAR_disk, and the `do g` loop in
      !               MOLECULE.RHO:get_Hirshfeld_atom_FFs -- every rank calls,
      !               the same number of times.
      !   RANK-LOCAL  the three per-fragment calls in MOLECULE.SCF:fragment_SCF_-
      !               norm / _para -- rank r calls it only for the fragments it
      !               owns, and in the >2-rank master/worker branch the master
      !               `cycle`s and never calls it at all.
      !
      ! A barrier is a COLLECTIVE, so on the rank-local paths it would execute a
      ! different number of times on different ranks and deadlock. The rule from
      ! milestone 6 applies to the CALL SITE as much as to the macro: whether a
      ! collective executes must not depend on rank-local state.

      ! Clean up
      sf_u.destroy
      k_pts.destroy

   end

   get_Hirshfeld_atom_FFs_for_atom(u,ff,spin_density) :: leaky
   ! Get "ff", the static Hirshfeld atom form factors for the
   ! symmetry related K points with *no* thermal smearing, for every
   ! unique atom.
   ! NOTE: "ff" is the FT rho_a(r), eqn (3) in Jayatilaka 2008,
   ! Acta Cryst A 64 p. 383-393. It is also f_a(q) in eqn (11) except
   ! without the thermal smearing factor.
      self :: INOUT
      u    :: INT, IN
      ff   :: VEC{CPX}@, OUT
      spin_density :: BIN, optional, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.density_mx.allocated, "no density matrix")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated, "no reflection data")
   ENSURE(.crystal.xray_data.allocated, "no x-ray reflection data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      rc     :: VEC{REAL}(3)
      wt,rho :: VEC{REAL}@
      pt     :: MAT{REAL}@
      k_pts  :: MAT{REAL}@
      cutoff,sc,s2 :: REAL
      k1,k2,k3, kr :: REAL
      sf     :: CPX
      k,n_k  :: INT
      i,n_pt :: INT
      c      :: INT
      spin   :: BIN

      ! Symmetry generated K points and SF's
      n_k = .crystal.n_unique_SF_k_pts

      ! Allocate structure factor array (leaky)
      ff.create(n_k)
      ff = ZERO

      ! Make list of symmetry non-equivalent symops
      ! and the necessary k points
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)

      ! X-ray or PND?
      spin = FALSE
      if (present(spin_density)) spin = spin_density

      ! Density matrix (leaky)
      if (NOT spin) then; .make_r_density_mx
      else;               .make_r_Sz_density_mx
      end
      ENSURE(.density_mx.r.allocated, "no restricted DM")

      ! Basis function cutoff
      cutoff = .becke_grid.basis_fn_cutoff

      ! Max no of becke grid points per atom
      n_pt = .becke_grid.max_no_of_pts_per_atom

      ! Loop over integration atoms "c"
         c  = .crystal.unique_frag_atom(u)
         rc = .atom(c).position

         ! Repetition factor for this atom
         sc = .crystal.frag_atom_sym_factor(c)
      ! if (sc.is_zero) cycle
         s2 = ONE/sc
      ! s2 = s2*s2

         ! Get the Becke grid for atom "c" (leaky)
         .becke_grid.make_atom_grid(pt,wt,c)
         n_pt = pt.dim1

         ! Apply stockholder weights "Wc" for atom "c" to "wt"
         .apply_stockholder_atom_weight(wt,c,pt)

         ! Prune the grid with new "wt"
         .becke_grid.prune_grid(pt,wt)

         ! Density for atom "c"
         n_pt = pt.dim1   ! <-- New n_pt !!!
         rho.create(n_pt)
         .make_ED_grid_r_v2(rho,pt,.density_mx.r,cutoff)

         ! Weight the atom "c" density
         rho = rho*wt

         ! Make the (unique) structure factors
         do k = 1,n_k
            k1 = k_pts(k,1)
            k2 = k_pts(k,2)
            k3 = k_pts(k,3)
            sf = IMAGIFY(ZERO)
            do i = 1,n_pt
               kr = k1*pt(i,1)+k2*pt(i,2)+k3*pt(i,3)
               sf = sf + rho(i)*exp(IMAGIFY(kr))
            end
            ff(k) = sf * s2 * .atom(c).site_occupancy
         end

         ! Clean up atom "c" stuff
         rho.destroy
         wt.destroy
         pt.destroy

      ! Clean up
      k_pts.destroy

   end

!  ======================
!  Residual density grids
!  ======================

   make_residual_density_grid(grid,pts) :: PURE
   ! Make the residual density grid from experimental and calculated
   ! structure factors. Needs crystal & those to exist already!
   ! NOTE: unusually, this always returns values in Anstrom^-3
   ! NOTE: USE residual_density_cell FOR RECTILIEAR PTS GRID.
      self :: INOUT
      grid :: VEC{REAL}, OUT
      pts  :: MAT{REAL}, IN

   ENSURE(pts.dim1==grid.dim, "wrong dim1, pts")
   ENSURE(pts.dim2==3,        "wrong dim2, pts")
   ENSURE(.atom.allocated, "no atoms to fit")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")
   ENSURE(.crystal.xray_data.allocated,"no crystal xray data")

      fac,fac3 :: REAL

      ! Make the residual map
      .crystal.make_residual_density_grid(grid,pts)

      ! Change to /A3
      fac    = ANGSTROM_PER_BOHR
      fac3   = BOHR_PER_ANGSTROM**3
      grid   = fac3*grid

   end

!  ========================
!  Min-max residual density
!  ========================

   get_minmax_residual_density(output)
   ! Evaluate the min and max residual density from the
   ! fitted structure factors, evaluated on a grid 0.1 A
   ! per side. Also evaluate the residuals at the atom
   ! centers and report the worst one. Store results in the
   ! diffraction data object.
      self :: INOUT
      output :: BIN, IN

   ENSURE(.crystal.allocated,"no crystal")
   ENSURE(.crystal.xray_data.allocated,"no crystal data")

      .get_minmax_residual_density_p( &
         .crystal.xray_data.min_residual, &
         .crystal.xray_data.max_residual, &
         .crystal.xray_data.rms_residual, &
!        .crystal.xray_data.min_atom_residual, &
!        .crystal.xray_data.max_atom_residual, &
!        .crystal.xray_data.rms_atom_residual, &
!        .crystal.xray_data.min_atom_residual_tag, &
!        .crystal.xray_data.max_atom_residual_tag, &
         output)   

   end

   get_minmax_residual_density_p(minp,maxp,rmsp,output) :: private
   ! Evaluate the min and max residual density from the
   ! fitted structure factors, evaluated on a grid 0.1 A
   ! per side. Also evaluate the residuals at the atom
   ! centers and report the worst one.
      self :: INOUT
      minp, maxp, rmsp  :: REAL, OUT
!     minpa,maxpa,rmspa :: REAL, OUT
!     minat,maxat       :: STR, OUT
      output :: BIN, IN

   DIE_IF(NOT .atom.allocated, "no atoms to fit")
   DIE_IF(NOT .crystal.allocated, "no crystal")
   DIE_IF(NOT .crystal.fragment_info_made, "no crystal fragment info")
   DIE_IF(NOT .crystal.xray_data.allocated,"no crystal data")
   DIE_IF(NOT .crystal.xray_data.allocated,"no crystal xray data")

      map,map_peeled :: VEC{REAL}@
      pt :: MAT{REAL}@
      n_pt :: INT
      nx,ny,nz :: INT
      n_peeled :: INT
      map_mat3 :: MAT3{REAL}@
      maxpos,minpos :: VEC{REAL}(3)
      maxa,  mina   :: INT
      maxats,minats :: VEC{INT}@
      maxtag,mintag :: VEC{STR}@
      fac,fac3,maxd,mind :: REAL

      if (.plot_grid.deallocated) .plot_grid.create

      ! Set up
      .plot_grid.set_plot_kind("residual_density")
      .plot_grid.set_box_scale_factor(ONE)
      if (.plot_grid.desired_separation.is_zero) then
         if (.plot_grid.n_x==1) &
            .plot_grid.set_desired_separation(0.1*BOHR_PER_ANGSTROM)
         if (.plot_grid.n_y==1) &
            .plot_grid.set_desired_separation(0.1*BOHR_PER_ANGSTROM)
         if (.plot_grid.n_z==1) &
            .plot_grid.set_desired_separation(0.1*BOHR_PER_ANGSTROM)
      end

      ! Use unit cell as bbox 
      .plot_grid.set_bbox_from_unit_cell(.crystal.unit_cell)

      if (output) then

      stdout.flush
      stdout.text("=====================")
      stdout.text("Residual density data")
      stdout.text("=====================")

      stdout.flush
      stdout.text(". Grid has voxels less than 0.1 A per side")
      stdout.text(". Length units are in Angstrom")

      stdout.flush
      .plot_grid.put_minimal

      end

      ! Make the residual density map
      n_pt = .plot_grid.n_pt
      pt.create(n_pt,3) ! Needed to see cartesian (xyz) coord
      map.create(n_pt)  ! Done in fractionals using plot.nx's
      .plot_grid.set_plot_kind("residual_density")
      .plot_grid.make_points(pt)
      .crystal.make_residual_density_cell(map,.plot_grid.n_x,.plot_grid.n_y,.plot_grid.n_z)

      ! Change to /A3
      fac    = ANGSTROM_PER_BOHR
      fac3   = BOHR_PER_ANGSTROM**3
      map    = fac3*map

      maxa   = maxloc(map,dim=1)
      mina   = minloc(map,dim=1)
      maxp   = map(maxa)
      minp   = map(mina)

      ! RMS value calculation without double counting of boundaries / Kang
      nx = .plot_grid.n_x 
      ny = .plot_grid.n_y
      nz = .plot_grid.n_z

      map_mat3.create( nx, ny, nz )         ! Note: map_mat3(1,:,:) = map_mat3(nx,:,:)
      map_mat3 = reshape( map ,[nx,ny,nz] ) !       map_mat3(:,1,:) = map_mat3(:,ny,:)
                                             !       map_mat3(:,:,1) = map_mat3(:,:,nz)
      n_peeled = (nx-1) * (ny-1) * (nz-1)

      map_peeled.create(n_peeled)
      map_peeled = reshape(map_mat3(1:nx-1, 1:ny-1, 1:nz-1), [n_peeled])
      rmsp   = map_peeled.standard_deviation ! Kang 2024 Nov. 1

      maxpos = pt(maxa,:)
      minpos = pt(mina,:)
      maxats = .crystal.unit_cell_atom.nearest_atoms_to(maxpos,TOL(1)) ! There could be many
      minats = .crystal.unit_cell_atom.nearest_atoms_to(minpos,TOL(1))
      maxtag = .crystal.unit_cell_atom(maxats).tag
      mintag = .crystal.unit_cell_atom(minats).tag
      maxd   = norm2(maxpos-.crystal.unit_cell_atom(maxats(1)).position)
      mind   = norm2(minpos-.crystal.unit_cell_atom(minats(1)).position)

      if (output) then
      stdout.flush
      stdout.text("Unit cell residual density:")
      stdout.flush
      stdout.show("Maximum                 = ",maxp)
      if (.crystal.xray_data.do_minmax_atoms) then
      stdout.show("- nearest atom          = ",maxtag)
      stdout.show("- distance to it        = ",maxd*fac)
      end
      stdout.show("Minimum                 = ",minp)
      if (.crystal.xray_data.do_minmax_atoms) then
      stdout.show("- nearest atom          = ",mintag)
      stdout.show("- distance to it        = ",mind*fac)
      end
      stdout.show("RMS                     = ",rmsp)
      end

      ! Write cube file
      .dump_plot_grid(map,"residual_density",form="cell.cube")

      ! Clean
      pt.destroy
      map.destroy
      map_mat3.destroy
      map_peeled.destroy
!     .plot_grid.destroy

!     ! Create atom coords
!     pt.create(.n_atom,3)
!     map.create(.n_atom)
!     .atom.put_coordinates_to(pt,positions_as_rows=FALSE)
!     .crystal.make_residual_density_map(map,pt)

!     ! Change to /A3
!     map    = fac3*map
!     maxa   = maxloc(map,dim=1)
!     mina   = minloc(map,dim=1)
!     maxpa  = map(maxa)
!     minpa  = map(mina)
!     rmspa  = map.standard_deviation
!     maxat  = .atom(maxa).tag
!     minat  = .atom(mina).tag

   ! if (output) then
   ! stdout.flush
   ! stdout.text("Residuals on atoms:")
   ! stdout.flush
   ! stdout.show("Maximum                 = ",maxpa)
   ! stdout.show("- for atom              = ",maxat)
   ! stdout.show("Minimum                 = ",minpa)
