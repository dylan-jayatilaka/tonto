!   LS_fit_Tanaka_atoms :: leaky
!   ! LS fit the Hirshfeld atoms to the calculated structure factors.
!   ! In-memory version.
!      self :: INOUT
!
!      ff :: MAT{CPX}@
!
!      ! Hirshfeld-atom structure factors
!      ! NOTE: in iteration 0, these were already calculated
!      ! as part of make_X_SFs ... double work!
!      .get_Tanaka_atom_FFs(ff)
!
!      ! Do a least squares
!      .LS_fit(ff,.crystal.xray_data.show_fit_output,.crystal.xray_data.show_fit_results)
!
!      ! Final results
!      .crystal.put_correlations(name=trim(.name)//".correlation-coefficients")
!
!      ! Put final CIF after residuals
!      .put_CIFs
!
!      ! Clean up
!      ff.destroy
!
!   end


   HAR_refinement :: leaky
   ! Do a Hirshfeld atom refinement (HAR) on the X-ray data. 
   ! The wavefunction and form factors are recalculated every 
   ! time the geometry changes, until appropriately converged, 
   ! normally to a maximum relative change of 0.01\sigma
      self :: INOUT

   DIE_IF(NOT .atom.allocated, "no atoms to fit")
   DIE_IF(NOT .SCF_data.allocated,"no SCF_data")
   DIE_IF(NOT .crystal.allocated, "no crystal")
   DIE_IF(NOT .crystal.xray_data.allocated,"no crystal xray data")
   DIE_IF(NOT .crystal.xray_data.reflections.allocated,"no x-ray reflections")
   DIE_IF(NOT (.crystal.using_one_center_TF_model OR .crystal.partition_model=="tc-tls"),"must use a one-center model or tc-tls")

      results :: BIN
      output  :: BIN

      ! This is a HAR
      .crystal.xray_data.set_refine_structure(TRUE)
      .SCF_data.set_output(FALSE)

      ! Output options
      results = .crystal.xray_data.show_refinement_results
      output  = .crystal.xray_data.show_refinement_output

      ! Set up atom partition info
      .make_atom_partition_info

      ! Initial SCF
      if (.density_mx.deallocated) then
         if (output) then
            stdout.flush
            stdout.text("Initial density matrix for refinement ...")
         end
         ! Initial promolecule SCF
         if (.SCF_data.using_cluster_charges) &
         .promolecule_SCF
         .SCF ! ???
      end

      ! Initial F_calc's for pruning
      if (NOT .crystal.xray_data.reflections.have_F_pred) then
         if (output) then
            stdout.flush
            stdout.text("Making F_pred ...")
         end
         .make_X_SFs
      end

      ! Prune?
      if (.crystal.xray_data.is_F_calc_prunable) then
         if (output) then
            stdout.flush
            stdout.text("Pruning reflections with F_pred/F_calc for refinement ...")
         end
         .crystal.prune_xray_data
      end

      ! Initialize & turn off SCF printing ...
      .crystal.initialize_refinement_data

      ! Always use initial_density for stability
      .SCF_data.set_initial_density(.SCF_data.spinorbital_genre)

      ! A TLS model needs the stiff-mode ADPs
      if (.crystal.xray_data.ADP_model=="tls") .set_crystal_U_high

      ! BANNER: options/switches, initial parameters,
      ! iteration banner, and iteration table header
      if (output) then
         stdout.flush
         stdout.text("Starting refinement ...")
         .crystal.put_refinement_header_info
      end

      !==========
      ! HAR cycle
      !==========
      do

         ! SCF: skip first one
         if (.crystal.xray_data.ref_iteration>0) then
            if (.crystal.xray_data.restart_HAR_with_promolecule) &
            .promolecule_SCF
            .SCF ! ???
         end

         !=======================
         .LS_fit_Hirshfeld_atoms
         !=======================

         ! Update geometry & errors
         .crystal.xray_data.update_refinement_parameters
         .crystal.update_refinement_ESDs

         ! Put the iteration results
         if (output) then
            .crystal.xray_data.put_refinement_table_body
         end

         ! Finished?
         .crystal.xray_data.update_refinement_info
         if (.crystal.xray_data.refinement_finished) exit

      end ! HAR cycle

      ! Table footer
      if (output) then
         .crystal.xray_data.ref_table.put_footer
      end

      ! Final results
      if (results) then
         .crystal.put_refinement_results
      end

      ! Final bond lengths, angles, torsions, with errors
      if (output) then
         .crystal.put_bond_info_with_errors
      end

      ! SCF @ final geometry
      .SCF
      .SCF_data.set_output(TRUE) ! put back

      ! Put analysis info ...
      if (.crystal.xray_data.do_standard_plots) then
         .crystal.put_X_data_analysis(output=TRUE,job=.name)
      end

      ! Put residuals ...
      if (.crystal.xray_data.do_residual_cube) then
         .get_minmax_residual_density(output=TRUE)
      end

      ! Put final CIF after residuals
      .put_CIFs

      ! Do standatd plots and properties
      if (.crystal.xray_data.do_standard_plots) then
      end

   end

   HA_fit :: leaky
   ! Do a single least-squares fit with HA form factor
      self :: INOUT

      results :: BIN
      output  :: BIN
      
      ! This is a rigid-atom fit
      .crystal.xray_data.set_fit_structure(TRUE)

      ! Output options
      results = .crystal.xray_data.show_fit_results
      output  = .crystal.xray_data.show_fit_output

      ! ANO's and interpolators?
      .make_atom_partition_info

      ! Initial SCF
      if (.density_mx.deallocated) then
         if (output) then
            stdout.flush
            stdout.text("Initial density matrix for refinement ...")
         end
         ! Initial promolecule SCF
         if (.SCF_data.using_cluster_charges) &
         .promolecule_SCF
         .SCF ! ???
      end

      ! Initial F_calc's for pruning
      if (NOT .crystal.xray_data.reflections.have_F_pred) then
         if (output) then
            stdout.flush
            stdout.text("Making F_pred ...")
         end
         .make_X_SFs
      end

      ! Prune?
      if (.crystal.xray_data.is_F_calc_prunable) then
         if (output) then
            stdout.flush
            stdout.text("Pruning reflections with F_pred/F_calc for refinement ...")
         end
         .crystal.prune_xray_data
      end

      ! Do the LSQ fit
      ! Header output appears inside here
      .LS_fit_Hirshfeld_atoms

   end

   LS_fit_Hirshfeld_atoms :: leaky
   ! LS fit the Hirshfeld atoms to the calculated structure factors.
   ! Cartesian (bohr) coordinates are used because structure factors
   ! are aspherical and calculated from the QM wavefunction.
   ! NOTE: this routine does only one cycle of fitting with the
   ! current density matrix i.e. this is a "rigid atom fit".
   ! NOTE: It's tricky exactly which atom's are used for refinement:
   ! * Structure factors are calculated only for *unique* fragment
   !   atoms since the QM wavefunction refers to the fragment_atoms.
   ! * However, asymmetric unit atoms are used to "store" the updating
   !   geometry; thus unique fragment atom pADPs and shifts are
   !   calculated (and derivatives with respect to the fragment atom
   !   positions and ADPs) but these parameters and shifts are later
   !   transformed back into asymmetric unit.
      self :: INOUT

      if      (.crystal.partition_model=="tc-tls") then; .LS_fit_two_center
      else if (.crystal.xray_data.use_disk_SFs)    then; .LS_fit_HAs_disk
      else;                                              .LS_fit_HAs_memory
      end

      ! Finalise stuff at new geometry ...

      .prepare_SCF_at_new_geometry

   end

   prepare_SCF_at_new_geometry :: leaky
   ! The atoms have moved: orthonormalise the MOs at the new geometry
   ! and delete what was stored for the old one, ready for the next SCF.
      self :: INOUT

      ! Orthonormalize MO's at new geometry
      if (.MOs.allocated) then
      if (NOT .crystal.xray_data.partition_model=="oc-crystal23") then
      if (.SCF_data.allocated) then
      if (NOT .SCF_data.SCF_kind(1:8)=="fragment") then
         ! Orthonormalize MO's at new geometry
         .symmetrically_orthonormalize(.MOs)
      end
      end
      end
      end

      ! Delete stored matrices
      ! NOTE: DM is incorrect, but OK as a guess.
      .delete_SCF_archives(keep_DM=TRUE)
      .destroy_SCF_results(keep_MOs=TRUE)
      .destroy_SCF_integrals

      ! New geometry, new moments
      .partition_info_made = FALSE

   end

   make_stiff_mode_SF_correction(dsf,k_pts) :: leaky
   ! Make "dsf", a correction to the tc-tls structure factors at the
   ! "k_pts" for what that model leaves out along the stiff internal
   ! modes: the change in size and shape of each product of basis
   ! functions, and the change of the density matrix. The modes are
   ! those of make_stiff_modes, with the harmonic <Q^2>; each is
   ! averaged by make_mode_SF_correction.
      self :: INOUT
      dsf :: VEC{CPX}, OUT
      k_pts :: MAT{REAL}, IN

   DIE_IF(.normal_mode_eigenvectors.deallocated,"tc_integrate_stiff_modes= needs the normal modes of this molecule")
   DIE_IF(.crystal.n_TLS_atoms/=.atom.dim,"tc_integrate_stiff_modes= is for a molecule, not a cluster")

      V :: MAT{REAL}@
      a0 :: VEC{REAL}@

      .make_stiff_modes(V,a0)
      .make_mode_SF_correction(dsf,k_pts,V,a0)
      a0.destroy
      V.destroy

   end

   make_rigid_body_SF_correction(dsf,k_pts) :: leaky
   ! Make "dsf", a correction to the tc-tls structure factors at the
   ! "k_pts" for what that model leaves out in the rigid-body motion and
   ! the refined soft modes: when the molecule turns, a product of basis
   ! functions turns about its own centre as well as moving with it, and
   ! the centre moves on an arc. The motion is taken along the principal
   ! coordinates of the refined covariance Sigma, which are uncorrelated;
   ! each is averaged by make_mode_SF_correction, the molecule being
   ! turned exactly by the rotation part of the coordinate.
      self :: INOUT
      dsf :: VEC{CPX}, OUT
      k_pts :: MAT{REAL}, IN

   DIE_IF(.crystal.n_TLS_atoms/=.atom.dim,"tc_integrate_rigid_body= is for a molecule, not a cluster")

      V,W :: MAT{REAL}@
      a0 :: VEC{REAL}@

      .crystal.make_TLS_principal_motions(V,a0,W)
      .make_mode_SF_correction(dsf,k_pts,V,a0,W,.crystal.TLS_origin)
      a0.destroy
      W.destroy
      V.destroy

   end

   make_gauss_hermite_pairs(n,node,weight) :: leaky
   ! Make the Gauss-Hermite rule of "n" points, n odd, for the average of
   ! a function of a Gaussian variable with zero mean and unit mean
   ! square: the average is w0 f(0) + sum_i weight(i) [f(node(i)) +
   ! f(-node(i))]. Only the (n-1)/2 positive "node"s and their "weight"s
   ! are returned. The points are the eigenvalues of the symmetric
   ! tridiagonal matrix with zero diagonal and sqrt(i) beside it, and
   ! each weight is the square of the first component of the eigenvector
   ! (Golub and Welsch).
      self :: IN
      n :: INT, IN
      node,weight :: VEC{REAL}@, OUT

   DIE_IF(n<3 OR mod(n,2)==0,"the number of quadrature points must be odd, and at least 3")

      Jm,evec :: MAT{REAL}@
      eval :: VEC{REAL}@
      i,m :: INT

      Jm.create(n,n)
      evec.create(n,n)
      eval.create(n)
      Jm = ZERO
      do i = 1,n-1
         Jm(i,i+1) = sqrt(REALIFY(i))
         Jm(i+1,i) = Jm(i,i+1)
      end
      Jm.solve_symmetric_eigenproblem(eval,evec)

      ! The eigenvalues come in increasing order: the last (n-1)/2 are positive
      m = (n-1)/2
      node.create(m)
      weight.create(m)
      do i = 1,m
         node(i)   = eval(m+1+i)
         weight(i) = evec(1,m+1+i)**2
      end

      eval.destroy
      evec.destroy
      Jm.destroy

   end

   make_mode_SF_correction(dsf,k_pts,V,a0,W,origin) :: leaky
   ! Make "dsf", a correction to the tc-tls structure factors at the
   ! "k_pts" for what that model leaves out along some uncorrelated
   ! coordinates of the motion. Coordinate j displaces atom a by
   ! V(3a-2:3a,j) per unit, to first order, and has mean square a0(j).
   ! Each is averaged by itself with a Gauss-Hermite rule of
   ! .crystal.xray_data.tc_quadrature_points points, an odd number. The
   ! rule has the undisplaced point and pairs of displaced points at +s
   ! and -s, each pair with its own weight w, from
   ! make_gauss_hermite_pairs: for three points s = sqrt(3 a0(j)),
   ! w = 1/6. At each displaced point an SCF is done
   ! from the undisplaced MOs and the structure factors are made, F(+s)
   ! and F(-s). The model's own value for the same two points keeps the
   ! undisplaced products and density matrix and moves their centres by
   ! +s V and -s V, which multiplies each by cos(k.d); call it F_cos.
   ! Each pair of points adds
   !    w [F(+s) + F(-s) - 2 F_cos]
   ! to "dsf", all three made without this coordinate's own smearing.
   ! If "W" is present, W(:,j) is the rotation vector per unit of
   ! coordinate j, about "origin", already counted in "V" to first order
   ! as W x r: the displaced atoms are then turned exactly by s W, and
   ! the rest of V is added as it is. The atoms, MOs and density matrix
   ! are put back. See docs/REPORT_ON_TC_TLS_AVERAGES.md section 6.
      self :: INOUT
      dsf :: VEC{CPX}, OUT
      k_pts :: MAT{REAL}, IN
      V :: MAT{REAL}, IN
      a0 :: VEC{REAL}, IN
      W :: MAT{REAL}, optional, IN
      origin :: VEC{REAL}(3), optional, IN

   ENSURE(dsf.dim==k_pts.dim1, "dsf and k_pts, incompatible")
   ENSURE(V.dim1==3*.atom.dim, "V: three rows per atom")
   ENSURE(a0.dim==V.dim2, "one a0 per coordinate")

      sp,sm,sc :: VEC{CPX}@
      pos0,D0 :: MAT{REAL}@
      U0 :: MAT4{REAL}@
      MOs0 :: OPMATRIX@
      r,rot,ax,cr,disp :: VEC{REAL}(3)
      node,weight :: VEC{REAL}@
      s,sgn,ang :: REAL
      n_a,j,a,b,i,side,pt :: INT

      n_a = .atom.dim

      ! The displaced points of the rule, in units of the root mean
      ! square, and the weight of each pair
      .make_gauss_hermite_pairs(.crystal.xray_data.tc_quadrature_points,node,weight)

      ! Keep the undisplaced atoms, MOs, density matrix and two-center ADPs
      pos0.create(3,n_a)
      do a = 1,n_a
         pos0(:,a) = .atom(a).position
      end
      MOs0 = .MOs
      D0 = .density_mx.r
      U0 = .crystal.two_center_ADPs

      sp.create(k_pts.dim1)
      sm.create(k_pts.dim1)
      sc.create(k_pts.dim1)
      dsf = ZERO

      do j = 1,V.dim2
      do pt = 1,node.dim

         if (a0(j)<=ZERO) cycle
         s = node(pt)*sqrt(a0(j))

         ! The two-center ADPs without this coordinate
         do a = 1,n_a
         do b = 1,n_a
            do i = 1,3
               .crystal.two_center_ADPs(i,:,a,b) = U0(i,:,a,b) - a0(j)*V(3*a-3+i,j)*V(3*b-2:3*b,j)
            end
         end
         end

         ! The model's value: undisplaced products with their centres moved
         .crystal.two_center_shift.destroy
         .crystal.two_center_shift.create(3,n_a)
         do a = 1,n_a
            .crystal.two_center_shift(:,a) = s*V(3*a-2:3*a,j)
         end
         .make_FT(sc,D0,k_pts)
         .crystal.two_center_shift.destroy

         ! The displaced points, each with its own SCF
         do side = 1,2
            sgn = ONE
            if (side==2) sgn = -ONE
            do a = 1,n_a
               disp = sgn*s*V(3*a-2:3*a,j)
               if (present(W)) then
                  ! Turn exactly by the rotation vector "rot", in place of
                  ! its first-order displacement rot x r
                  rot = sgn*s*W(:,j)
                  r = pos0(:,a) - origin
                  cr = [rot(2)*r(3)-rot(3)*r(2), rot(3)*r(1)-rot(1)*r(3), rot(1)*r(2)-rot(2)*r(1)]
                  ang = norm2(rot)
                  if (ang>TOL(12)) then
                     ax = rot/ang
                     disp = disp - cr + (cos(ang)-ONE)*r + sin(ang)*cr/ang + (ONE-cos(ang))*dot_product(ax,r)*ax
                  end
               end
               .atom(a).set_position(pos0(:,a) + disp)
            end
            .MOs = MOs0
            .prepare_SCF_at_new_geometry
            .SCF
            .make_r_density_mx
            if (side==1) then; .make_FT(sp,.density_mx.r,k_pts)
            else;              .make_FT(sm,.density_mx.r,k_pts)
            end
         end

         ! Put the atoms back for the next coordinate
         do a = 1,n_a
            .atom(a).set_position(pos0(:,a))
         end

         dsf = dsf + weight(pt)*(sp + sm - TWO*sc)

      end
      end

      ! Put everything else back
      .crystal.two_center_ADPs = U0
      .MOs = MOs0
      .prepare_SCF_at_new_geometry
      .SCF
      .make_r_density_mx

      sc.destroy
      sm.destroy
      sp.destroy
      U0.destroy
      D0.destroy
      MOs0.destroy
      pos0.destroy
      weight.destroy
      node.destroy

   end

   make_two_center_position_derivs(sf_d,k_pts,redo_SCF) :: leaky
   ! Make "sf_d", the derivatives of the structure factors at the "k_pts"
   ! with respect to the positions of the unique fragment atoms, for
   ! partition_model= tc-tls, by central differences. Column base+i is
   ! coordinate i of a unique atom, with base as the pADPs are stored;
   ! the ADP columns are zero. Each unique atom is moved with its images
   ! in the fragment, and its basis functions move with it. The
   ! two-center ADPs are held. If "redo_SCF" an SCF is done at every
   ! displaced geometry, so the density matrix follows the atoms, and
   ! once more at the end to restore the wavefunction; otherwise the
   ! density matrix is held. Every one of those SCFs starts from the
   ! MOs of the undisplaced geometry.
      self :: INOUT
      sf_d :: MAT{CPX}, OUT
      k_pts :: MAT{REAL}, IN
      redo_SCF :: BIN, IN

   ENSURE(sf_d.dim1==k_pts.dim1, "sf_d and k_pts, incompatible")
   ENSURE(sf_d.dim2==.crystal.asymmetric_unit_atom.no_of_pADPs, "sf_d: wrong dim2")

      sp,sm :: VEC{CPX}@
      pos0 :: MAT{REAL}@
      MOs0 :: OPMATRIX@
      M :: MAT{REAL}(3,3)
      step :: REAL
      u,fu,f,a,base,i,side :: INT
      refine_positions,refine_ADPs,refine_Uiso :: BIN

      step = 0.01d0

      sp.create(k_pts.dim1)
      sm.create(k_pts.dim1)
      pos0.create(3,.atom.dim)
      do f = 1,.atom.dim
         pos0(:,f) = .atom(f).position
      end
      if (redo_SCF) MOs0 = .MOs

      sf_d = ZERO

      do u = 1,.crystal.n_unique_frag_atoms

         fu = .crystal.unique_frag_atom(u)
         .crystal.refinement_flags_for_frag_atom(fu,refine_positions,refine_ADPs,refine_Uiso)
         if (NOT refine_positions) cycle
         base = .crystal.fragment_atom.no_of_pADPs_up_to_atom(u,.crystal.unique_frag_atom)
         a = .crystal.asym_atom_for_frag_atom(fu)

         do i = 1,3
         do side = 1,2

            ! Move the unique atom along axis i, and its images with it
            do f = 1,.atom.dim
               if (.crystal.asym_atom_for_frag_atom(f)/=a) cycle
               M = .crystal.image_rotation(fu,f)
               if (side==1) then; .atom(f).set_position(pos0(:,f) + step*M(:,i))
               else;              .atom(f).set_position(pos0(:,f) - step*M(:,i))
               end
            end

            ! The structure factors there
            if (redo_SCF) then
               .MOs = MOs0
               .prepare_SCF_at_new_geometry
               .SCF
               .make_r_density_mx
            end
            if (side==1) then; .make_FT(sp,.density_mx.r,k_pts)
            else;              .make_FT(sm,.density_mx.r,k_pts)
            end

            ! Put the atoms back
            do f = 1,.atom.dim
               .atom(f).set_position(pos0(:,f))
            end

         end
         sf_d(:,base+i) = (sp - sm)/(TWO*step)
         end

      end

      ! The wavefunction at the undisplaced geometry
      if (redo_SCF) then
         .MOs = MOs0
         .prepare_SCF_at_new_geometry
         .SCF
         .make_r_density_mx
         MOs0.destroy
      end

      pos0.destroy
      sm.destroy
      sp.destroy

   end

   LS_fit_two_center :: leaky
   ! LS fit the atom positions and the TLS model to the structure
   ! factors for partition_model= tc-tls: one rigid fit with the current
   ! density matrix. There are no atomic form factors to shift here, so
   ! every cycle makes the structure factors and their derivatives
   ! again from the shell pairs, with the atoms where the last cycle
   ! put them.
      self :: INOUT

   DIE_IF(NOT .crystal.allocated, "no crystal")
   DIE_IF(NOT .SCF_data.spinorbital_genre=="r ", "tc-tls refinement is for restricted wavefunctions")
   DIE_IF(.crystal.xray_data.tc_analytic_rigid_body AND .crystal.xray_data.tc_integrate_rigid_body, "use tc_analytic_rigid_body= or tc_integrate_rigid_body=, not both")
   DIE_IF(.crystal.xray_data.tc_analytic_rigid_body AND .crystal.n_TLS_atoms/=.atom.dim, "tc_analytic_rigid_body= is for a molecule, not a cluster")

      sf_e,dsf,dsf_rb :: VEC{CPX}@
      sf_pos,sf_sig,sf_dpos :: MAT{CPX}@
      k_pts,dF :: MAT{REAL}@
      fitout,fitres :: BIN
      n_k,f :: INT

      fitout = .crystal.xray_data.show_fit_output
      fitres = .crystal.xray_data.show_fit_results

      ! The k points and the density matrix
      n_k = .crystal.n_unique_SF_k_pts
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)
      .make_r_density_mx

      ! Initialise, and put the header
      .crystal.start_structure_fit(fitout)
      sf_e.create(n_k)
      sf_pos.create(n_k,.atom.dim)
      sf_sig.create(n_k,.crystal.n_TLS_sigma)

      ! The stiff modes averaged numerically, once for this fit
      if (.crystal.xray_data.tc_integrate_stiff_modes) then
         .crystal.make_two_center_ADPs
         dsf.create(n_k)
         .make_stiff_mode_SF_correction(dsf,k_pts)
      end

      ! The rigid-body motion averaged numerically, once for this fit
      if (.crystal.xray_data.tc_integrate_rigid_body) then
         .crystal.make_two_center_ADPs
         dsf_rb.create(n_k)
         .make_rigid_body_SF_correction(dsf_rb,k_pts)
         if (dsf.allocated) then
            dsf = dsf + dsf_rb
         else
            dsf = dsf_rb
         end
         dsf_rb.destroy
      end

      ! Position derivatives by differences, once for this fit
      if (.crystal.xray_data.tc_position_derivs/="center") then
         .crystal.make_two_center_ADPs
         sf_dpos.create(n_k,.crystal.asymmetric_unit_atom.no_of_pADPs)
         .make_two_center_position_derivs(sf_dpos,k_pts,.crystal.xray_data.tc_position_derivs=="scf")
      end

      ! Rigid fit loop
      do

         ! Structure factors and derivatives, and the shifts from them
         .crystal.make_two_center_ADPs
         .make_FT_and_TLS_derivs(sf_e,sf_pos,sf_sig,.density_mx.r,k_pts)
         if (dsf.allocated) sf_e = sf_e + dsf
         if (sf_dpos.allocated) then
            .crystal.get_two_center_parameter_shifts(sf_e,sf_pos,sf_sig,sf_dpos)
         else
            .crystal.get_two_center_parameter_shifts(sf_e,sf_pos,sf_sig)
         end

         ! Apply them; the basis functions move with the atoms
         dF.create(3,.crystal.n_fragment_atoms)
         .crystal.apply_parameter_shifts(dF)
         dF.destroy
         do f = 1,.atom.dim
            .atom(f).set_position(.crystal.fragment_atom(f).position)
         end

         ! Put the iteration results; finished?
         .crystal.finish_fit_cycle(fitout)
         if (.crystal.xray_data.fit_finished) exit

      end

      ! Results, and refresh the asymmetric unit
      .crystal.finish_structure_fit(fitout,fitres)
      .atom = .crystal.fragment_atom
      .crystal.asymmetric_unit_source = "tonto-refinement"

      ! Put final CIF
      .put_CIFs

      dsf.destroy
      sf_dpos.destroy
      sf_sig.destroy
      sf_pos.destroy
      sf_e.destroy
      k_pts.destroy

   end

   check_two_center_average :: leaky
   ! Check the average over the rigid-body motion made by formula
   ! (tc_analytic_rigid_body=) against the numerical one
   ! (make_rigid_body_SF_correction, with tc_quadrature_points= points)
   ! at the current TLS model, for partition_model= tc-tls. Puts the
   ! largest and the root-mean-square size, over the k points, of the
   ! numerical correction to the structure factors, of the correction
   ! by formula, and of the difference of the two; and the last three
   ! again for the k points shorter than 2 bohr^-1. The numerical
   ! average takes the principal coordinates of the motion one at a
   ! time, which is good only at low angle, so that is where the two
   ! should agree. Needs a TLS model, so use it after a refinement.
      self :: INOUT

   DIE_IF(NOT .crystal.allocated, "no crystal")
   DIE_IF(NOT .crystal.partition_model=="tc-tls", "partition_model must be tc-tls")
   DIE_IF(.crystal.TLS_basis.deallocated, "no TLS model: refine first")

      sf_0,sf_1,dsf :: VEC{CPX}@
      k_pts :: MAT{REAL}@
      by_formula :: BIN
      val,v_n,v_f,v_d :: REAL
      n_k,n_q,n_low,k :: INT

      n_k = .crystal.n_unique_SF_k_pts
      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)
      .make_r_density_mx
      sf_0.create(n_k)
      sf_1.create(n_k)
      dsf.create(n_k)
      by_formula = .crystal.xray_data.tc_analytic_rigid_body

      ! To first order, and the numerical correction to it
      .crystal.xray_data.tc_analytic_rigid_body = FALSE
      .crystal.make_two_center_ADPs
      .make_FT(sf_0,.density_mx.r,k_pts)
      .make_rigid_body_SF_correction(dsf,k_pts)

      ! By formula
      .crystal.xray_data.tc_analytic_rigid_body = TRUE
      .crystal.make_two_center_ADPs
      .make_FT(sf_1,.density_mx.r,k_pts)
      sf_1 = sf_1 - sf_0
      .crystal.xray_data.tc_analytic_rigid_body = by_formula

      stdout.flush
      stdout.text("Check of the rigid-body average of the tc-tls structure factors:")
      stdout.flush
      n_q = .crystal.xray_data.tc_quadrature_points
      stdout.show("No. of quadrature points          =",n_q)
      val = maxval(abs(sf_0))
      stdout.show("Largest F, first order            =",val)
      val = maxval(abs(dsf))
      stdout.show("Largest numerical correction      =",val)
      val = maxval(abs(sf_1))
      stdout.show("Largest correction by formula     =",val)
      val = maxval(abs(sf_1-dsf))
      stdout.show("Largest difference of the two     =",val)
      val = sqrt(sum(abs(dsf)**2)/n_k)
      stdout.show("RMS numerical correction          =",val)
      val = sqrt(sum(abs(sf_1)**2)/n_k)
      stdout.show("RMS correction by formula         =",val)
      val = sqrt(sum(abs(sf_1-dsf)**2)/n_k)
      stdout.show("RMS difference of the two         =",val)

      ! The same at low angle
      n_low = 0
      v_n = ZERO; v_f = ZERO; v_d = ZERO
      do k = 1,n_k
         if (sum(k_pts(k,:)**2)>=FOUR) cycle
         n_low = n_low + 1
         v_n = v_n + abs(dsf(k))**2
         v_f = v_f + abs(sf_1(k))**2
         v_d = v_d + abs(sf_1(k)-dsf(k))**2
      end
      stdout.show("No. of k points below 2 bohr^-1   =",n_low)
      if (n_low>0) then
         val = sqrt(v_n/n_low)
         stdout.show("RMS numerical correction, those   =",val)
         val = sqrt(v_f/n_low)
         stdout.show("RMS correction by formula, those  =",val)
         val = sqrt(v_d/n_low)
         stdout.show("RMS difference of the two, those  =",val)
      end

      dsf.destroy
      sf_1.destroy
      sf_0.destroy
      k_pts.destroy

   end

   check_two_center_derivs :: leaky
   ! Check the derivatives from make_FT_and_TLS_derivs against central
   ! differences of make_FT, for partition_model= tc-tls, and put the
   ! largest disagreement of each kind as a fraction of the largest
   ! derivative. For Sigma the two should agree. For the positions they
   ! should not: the derivative moves only the centre of each product of
   ! basis functions, and the difference also changes its size and
   ! shape, which the refinement leaves to the next SCF. So that number
   ! is the size of what is left out. With tc_analytic_rigid_body= the
   ! average over the rotation depends on Sigma as well, so the check
   ! changes what it is made from along with the two-center ADPs.
   ! Needs a TLS model, so use it after a refinement.
      self :: INOUT

   DIE_IF(NOT .crystal.allocated, "no crystal")
   DIE_IF(NOT .crystal.partition_model=="tc-tls", "partition_model must be tc-tls")
   DIE_IF(.crystal.TLS_basis.deallocated, "no TLS model: refine first")

      sf_e,sp,sm :: VEC{CPX}@
      sf_pos,sf_sig :: MAT{CPX}@
      k_pts,Ba,Bb,E :: MAT{REAL}@
      U0,dU :: MAT4{REAL}@
      G0,dG :: MAT3{REAL}@
      L0 :: MAT{REAL}@
      pr :: MAT{INT}@
      pos :: VEC{REAL}(3)
      step,err,big,err_pos,err_sig :: REAL
      n_k,n_b,n_v,n_f,a,b,i :: INT

      n_k = .crystal.n_unique_SF_k_pts
      n_b = .crystal.n_TLS_atoms
      n_v = 6 + .crystal.n_soft_modes
      n_f = .atom.dim

      k_pts.create(n_k,3)
      .crystal.make_unique_X_SF_k_pts(k_pts)
      .make_r_density_mx
      .crystal.make_two_center_ADPs

      ! The derivatives to be checked
      sf_e.create(n_k)
      sf_pos.create(n_k,n_f)
      sf_sig.create(n_k,.crystal.n_TLS_sigma)
      .make_FT_and_TLS_derivs(sf_e,sf_pos,sf_sig,.density_mx.r,k_pts)
      sp.create(n_k)
      sm.create(n_k)

      ! Positions: move one atom along one axis
      step = TOL(4)
      err = ZERO
      big = ZERO
      do a = 1,n_f
      do i = 1,3
         pos = .atom(a).position
         pos(i) = pos(i) + step
         .atom(a).set_position(pos)
         .make_FT(sp,.density_mx.r,k_pts)
         pos(i) = pos(i) - TWO*step
         .atom(a).set_position(pos)
         .make_FT(sm,.density_mx.r,k_pts)
         pos(i) = pos(i) + step
         .atom(a).set_position(pos)
         sp = (sp - sm)/(TWO*step)
         sm = IMAGIFY(k_pts(:,i))*sf_pos(:,a)
         err = max(err,maxval(abs(sp-sm)))
         big = max(big,maxval(abs(sm)))
      end
      end
      err_pos = err/big

      ! Sigma: change one element, and with it every two-center ADP
      .crystal.TLS_sigma_pairs(pr)
      U0 = .crystal.two_center_ADPs
      G0 = .crystal.two_center_turn
      L0 = .crystal.two_center_L
      dG.create(3,3,n_f)
      dU.create(3,3,n_f,n_f)
      E.create(n_v,n_v)
      Ba.create(3,n_v)
      Bb.create(3,n_v)
      err_sig = ZERO
      do i = 1,pr.dim2
         E = ZERO
         E(pr(1,i),pr(2,i)) = ONE
         E(pr(2,i),pr(1,i)) = ONE
         dU = ZERO
         dG = ZERO
         do a = 1,n_b
            Ba = .crystal.TLS_displacement_mx(a)
            dG(:,:,a) = matmul(E(4:6,:),transpose(Ba))
            do b = 1,n_b
               Bb = .crystal.TLS_displacement_mx(b)
               dU(:,:,a,b) = matmul(Ba,matmul(E,transpose(Bb)))
            end
         end
         step = TOL(5)/maxval(abs(dU))
         .crystal.two_center_ADPs = U0 + step*dU
         .crystal.two_center_turn = G0 + step*dG
         .crystal.two_center_L    = L0 + step*E(4:6,4:6)
         .make_FT(sp,.density_mx.r,k_pts)
         .crystal.two_center_ADPs = U0 - step*dU
         .crystal.two_center_turn = G0 - step*dG
         .crystal.two_center_L    = L0 - step*E(4:6,4:6)
         .make_FT(sm,.density_mx.r,k_pts)
         sp = (sp - sm)/(TWO*step)
         err = maxval(abs(sp-sf_sig(:,i)))
         big = maxval(abs(sf_sig(:,i)))
         err_sig = max(err_sig,err/big)
      end
      .crystal.two_center_ADPs = U0
      .crystal.two_center_turn = G0
      .crystal.two_center_L    = L0

      stdout.flush
      stdout.text("Two-center derivatives against central differences")
      stdout.flush
      stdout.set_real_fortran_fmt("e")
      stdout.show("Largest error, Sigma              =",err_sig)
      stdout.show("Left out of position derivatives  =",err_pos)
      stdout.set_real_fortran_fmt("f")

      Bb.destroy
      Ba.destroy
      E.destroy
      dU.destroy
      dG.destroy
      L0.destroy
      G0.destroy
      U0.destroy
      pr.destroy
      sm.destroy
      sp.destroy
      sf_sig.destroy
      sf_pos.destroy
      sf_e.destroy
      k_pts.destroy

   end

   LS_fit_HAs_memory :: leaky
   ! LS fit the Hirshfeld atoms to the calculated structure factors.
   ! In-memory version.
      self :: INOUT

   DIE_IF(NOT .crystal.allocated, "no crystal")

      fitout :: BIN
      fitres :: BIN
      ff :: MAT{CPX}@

      ! Hirshfeld-atom structure factors
      ! NOTE: in iteration 0, these were already calculated
      !       as part of make_X_SFs ... double work! Oh well.
      !       Store in .xray_data?
      if (.crystal.xray_data.ref_iteration>=1) &
         .make_atom_partition_info 
      .make_aspherical_atomic_FFs(ff)

      ! Symmetrize form factors "ff" -- kang (2024.Jun.3) 
      ! ... Thank you! --dylan
      .crystal.symmetrize_FFs(ff) 
                                    
      ! Least squares (maybe with output)
      ! Here, .atom = .crystal.fragment_atom
      fitout = .crystal.xray_data.show_fit_output
      fitres = .crystal.xray_data.show_fit_results
      .LS_fit(ff,fitout,fitres) 

      ! Put final CIF after residuals
      .put_CIFs

      ! Clean up
      ff.destroy

   end

!  Strategy: insert calls, separate out sf_u.
!  End result: one shift update of parameters
!  Then this goes in the normal LSQ cycle in LS_fit
!  NOTE: routine make_LS_mx is very long! Is it working? Rewrite?

   LS_fit_HAs_disk :: leaky
   ! LS fit the Hirshfeld atoms to the calculated structure factors.
   ! Low memory version.
      self :: INOUT

      d_Fa :: MAT{REAL}@

      ! Once-only preamble, mirroring CRYSTAL:LS_structure_fit (crystal.foo:4272
      ! onwards). All four used to run inside make_LS_mx, hence once per LS
      ! iteration -- and the X_fit seeding once per ATOM per iteration, since it
      ! sat inside that routine's `do u` loop.
      .crystal.initialize_fit_data
      .crystal.asymmetric_unit_atom.put_pADP_vector_to(.crystal.xray_data.X_fit)
      if (.crystal.xray_data.refine_structure) .crystal.xray_data.X_ref = .crystal.xray_data.X_fit
      .crystal.put_fit_header

      do

         ! This allocation is REAL, and make_LS_mx relies on it: its d_Fa
         ! dummy is INOUT, so what is created here is what it fills. It was
         ! declared OUT, which deallocates an allocatable on entry and made
         ! this line dead code -- and the job segfaulted. See make_LS_mx.
         d_Fa.create(.crystal.xray_data.reflections.dim,.crystal.asymmetric_unit_atom.no_of_pADPs)
         .make_LS_mx(d_Fa)
         .do_LS_refinement(d_Fa)
         d_Fa.destroy

         .crystal.xray_data.put_fit_table_body

         ! Finished?
         !
         ! update_fit_info is what DECIDES that, and it was missing: it sets
         ! .fit_converged / .too_many_fit_iterations, and from them
         ! .fit_finished, and it is also the only thing that advances
         ! .fit_iteration (diffraction_data.set.foo, "fit_iteration =
         ! fit_iteration + 1" at the end). Without it the loop tested a flag
         ! nothing ever set: the fit re-solved iteration 1 forever, reprinting
         ! identical rows -- 599 of them before a timeout, GoF2 49.702984 every
         ! time -- and never converged.
         !
         ! This loop is hand-rolled. The two that work call update_fit_info
         ! immediately before the same test: CRYSTAL:LS_structure_fit
         ! (crystal.foo:4332 and :4472), which is where LS_fit_HAs_MEMORY and
         ! LS_fit_fragHAR_disk both end up. That is why the in-core path and
         ! fragHAR converge and only this one did not.
         .crystal.xray_data.update_fit_info
         if (.crystal.xray_data.fit_finished) exit

      end

      ! Table footer
      .crystal.xray_data.fit_table.put_footer

      ! Set the fragment covariances from cov matrix
      .crystal.set_fragment_esds

      ! Print out bond length, angle, torsion tables with errors
      .crystal.put_bond_info_with_errors

      ! Finally: remake .asymmetric_unit_atom/unit_cell geometry from
      ! .fragment_atom, which *must* be assigned since it must point
      ! to molecule.atom
      .crystal.asymmetric_unit_atom.destroy
      .crystal.asymmetric_unit_geometry.destroy
      .crystal.asymmetric_unit_source = "tonto-ls-structure-fit"
      .crystal.update_fragment_info(.crystal.fragment_atom)

      ! Set geometry type
      .crystal.asymmetric_unit_source = "tonto-refinement"

      ! Final results
      .crystal.put_correlations(name=trim(.name)//".correlation-coefficients")

      ! Put final CIF after residuals
      .put_CIFs

      if (.crystal.xray_data.is_IAM_refinement) then
      if (NOT .crystal.xray_data.use_IAM_ITC_FFs) then
         ! Delete stored matrices
         .delete_SCF_archives(keep_DM=TRUE)
         .destroy_SCF_results(keep_MOs=TRUE) 
         .destroy_SCF_integrals
         if (.SCF_data.allocated) then
         if (NOT .SCF_data.SCF_kind=="mfcc") then
         ! Orthonormalize MO's at new geometry
         ! This makes new overlap integrals ...
         .symmetrically_orthonormalize(.MOs)
         end
         end
      end
      end

   end

   get_derivative_F_calc_for_atom(a,dFc) :: leaky
   ! Get "dFc", the derivatives of the complex F_calcs for the
   ! fragment atom corresponding to asymmetric unit atom "a".
      self :: INOUT
      a :: INT, IN
      dFc :: MAT{CPX}, OUT

      ff :: VEC{CPX}@
      n_refl,n_p :: INT

      ! Complex structure factor derivatives
      n_refl = .crystal.xray_data.reflections.dim
      n_p    = .crystal.asymmetric_unit_atom(a).no_of_pADPs

      ! Hirshfeld-atom structure factors
      ! NOTE: in iteration 0, these were already calculated
      ! as part of make_X_SFs ... double work!
      .get_Hirshfeld_atom_FFs_for_atom(a,ff)

      ! Do a least squares
      .crystal.make_F_calc_derivs_for_atom(a,dFc,ff)

      ! Clean up
      ff.destroy

   end

   make_LS_mx(d_Fa) :: leaky
   ! Calculate the LS matrix Low memory version.
      self :: target, INOUT
      ! INOUT, not OUT. The caller allocates this (LS_fit_HAs_disk does, with
      ! exactly the shape used below) and its sibling DO_LS_refinement, which
      ! takes the very same variable from the very same caller, is likewise
      ! declared MAT{REAL}@, INOUT. `OUT` was the slip, and on an ALLOCATABLE
      ! dummy it is not a documentation nicety: Fortran DEALLOCATES an
      ! intent(out) allocatable on entry, so the caller's allocation was thrown
      ! away, nothing here ever allocated it again, and it arrived unallocated
      ! at DIFFRACTION_DATA:d_F_abs_dX -- whose "res" dummy is MAT{REAL}, OUT,
      ! assumed-shape and NOT allocatable. Passing an unallocated allocatable
      ! to such a dummy is undefined; gfortran dereferenced a null array
      ! descriptor and every run that reached here died with SIGSEGV.
      d_Fa :: MAT{REAL}@, INOUT
   
   ENSURE(.crystal.xray_data.allocated, "no data")
   ENSURE(.crystal.fragment_info_made, "no fragment info")
   ENSURE(.atom.allocated, "no atoms to fit")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated,"no crystal xray data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")
   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.density_mx.allocated, "no density matrix")

      list      :: VEC{STR}@
      tags      :: VEC{STR}@
      sf_d :: MAT{CPX}@
      sf_u :: VEC{CPX}@
      sf_e :: VEC{CPX}@
      rc   :: VEC{REAL}(3)
      kv   :: VEC{REAL}(3)
      wt   :: VEC{REAL}@
      pt   :: MAT{REAL}@
      rho  :: VEC{REAL}@
      arch :: ARCHIVE@
      n_unique, n_k :: INT
      n_p, n_p_atom :: INT
      c,u,f,base, k :: INT
      a,n_f, n_pt :: INT
      k_pts :: MAT{REAL}@  ! Why?
      k_pt  :: MAT{REAL}@  ! Same?
      adp2  :: MAT{REAL}(3,3)
      adp3  :: MAT3{REAL}(3,3,3)
      adp4  :: MAT4{REAL}(3,3,3,3)
      dFc      :: MAT{CPX}@
      dFc_atom :: MAT{CPX}@
      dFa_atom :: MAT{CPX}@
      dFb_atom :: MAT{CPX}@
      rf, cutoff,sc,s2 :: REAL
      k1,k2,k3, c2,c3,c4  :: REAL
      k1_k1,k2_k2,k3_k3   :: REAL
      k1_k2,k1_k3,k2_k3   :: REAL
      zero3 :: REAL
      spin, has_skip,has_Uiso,is_H_atom :: BIN
      refine_positions,refine_Uiso :: BIN
      refine_positions_only,refine_ADPs_only :: BIN
      refine_ADPs,refine_ADP4s,refine_ADP3s :: BIN
      II, sfh,sf1,sf2,sf4,sf6,sf24 :: CPX
      tag :: STR

      ! Constants
      II  = IMAGIFY(ONE)
      n_p = .crystal.asymmetric_unit_atom.no_of_pADPs
      n_f = .crystal.fragment_atom.no_of_pADPs
      n_k = .crystal.n_unique_SF_k_pts
      
      ! Hirshfeld-atom structure factors
      n_unique = .crystal.n_unique_frag_atoms

      ! Make sure HA stuff is there
      .make_atom_partition_info

      ! Is there a nothing list?
      has_skip = .crystal.xray_data.refine_nothing_for_atom.allocated
      if (has_skip) then
         tags = .crystal.fragment_atom.tag
         list = .crystal.xray_data.refine_nothing_for_atom
         DIE_IF(NOT list.has_all_elements_common_with(tags), "you try to refine nothing for an atom that is not in your list")
      end

      ! Are there atoms to be refined isotropically?
      has_Uiso = .crystal.xray_data.refine_U_iso_for_atom.allocated
      if (has_Uiso) then
         tags = .crystal.fragment_atom.tag
         list = .crystal.xray_data.refine_U_iso_for_atom
         DIE_IF(NOT list.has_all_elements_common_with(tags), "you try to refine an atom isotropically that is not in your list")
      end

      refine_ADPs_only = .crystal.xray_data.refine_ADPs_only
      refine_positions_only = .crystal.xray_data.refine_positions_only
      
      ! Defaults per atom
      if (NOT refine_ADPs_only) then 
         refine_positions = TRUE 
      else
         refine_positions = FALSE
      end
      
      if (NOT refine_positions_only) then 
         refine_ADPs      = TRUE
      else
         refine_ADPs      = FALSE
      end
      
      ! Final check to do U_iso this atom?
      refine_Uiso = FALSE
      if (NOT refine_Uiso) then
      if (has_Uiso) then
      if (any(.crystal.xray_data.refine_U_iso_for_atom==tag)) then
         refine_Uiso = TRUE
      end
      end
      end
      
      ! Skip derivatives for this atom?
      if (has_skip) then
      if (any(.crystal.xray_data.refine_nothing_for_atom==tag)) then
         refine_positions = FALSE
         refine_ADPs      = FALSE
      end
      end

      ! NOTE: the fit is initialised ONCE by LS_fit_HAs_disk before its loop,
      ! via CRYSTAL:initialize_fit_data -- exactly where CRYSTAL:LS_structure_fit
      ! does it. Calling it here meant once per LS iteration, re-creating
      ! X_fit / X_fit0 and resetting GoF2_fit0 to huge() every pass.
      !
      ! make_LS_mx now does one job: build the design matrix. That is the single
      ! thing which genuinely differs between the disk path and the in-core one.

      ! Allocate structure factor array (leaky)
      ! For pne atom
      dFc.create(.crystal.xray_data.reflections.dim,n_p)

      sf_e.create(n_k)     ! Symmetry generated SF's
      sf_e = ZERO

      do u = 1,n_unique

         refine_Uiso  = FALSE
         refine_ADP4s = .crystal.fragment_atom(u).has_only_ADP4s_and_errors
         refine_ADP3s = .crystal.fragment_atom(u).has_only_ADP3s_and_errors
    
         ! Special cases for H atom
         is_H_atom = .crystal.fragment_atom(u).atomic_number==1
         if (is_H_atom) then
            refine_positions = .crystal.xray_data.refine_H_positions
            refine_ADPs      = .crystal.xray_data.refine_H_ADPs
            refine_Uiso      = .crystal.xray_data.refine_H_U_iso
         end
    
         sf_u.create(n_k)
         sf_u = ZERO

         ! Symmetry generated K points and SF's
    
         ! Make list of symmetry non-equivalent symops
         ! and the necessary k points
         k_pts.create(n_k,3)
         .crystal.xray_data.reflections.make_unique_SF_k_pts(k_pts,.crystal.spacegroup,.crystal.unit_cell)
    
         ! X-ray or PND?
         spin = FALSE
    
         ! Density matrix (leaky)
         if (NOT spin) then; .make_r_density_mx
         else;               .make_r_Sz_density_mx
         end
         ENSURE(.density_mx.r.allocated, "no restricted DM")
    
         ! Basis function cutoff
         cutoff = .becke_grid.basis_fn_cutoff
    
         ! Max no of becke grid points per atom
         n_pt = .becke_grid.max_no_of_pts_per_atom
    
         ! Loop over integration atoms "c"
         c  = .crystal.unique_frag_atom(u)
         rc = .atom(c).position
  
         ! Repetition factor for this atom, INCLUDING the site occupancy.
         !
         ! The occupancy was missing here, and this is the routine
         ! MOLECULE.RHO:get_Hirshfeld_atom_FFs_disk warns about in its own
         ! comment -- "Also include the site occupancy factor (Dont forget this
         ! for the non-fragHAR routine)". It was forgotten. Every other route to
         ! an aspherical form factor applies it:
         !
         !   in core   MOLECULE.RHO:make_Hirshfeld_atom_FFs, :make_Salvador_-
         !             atom_FFs, :make_sph_TFVA_atom_FFs   -- sf*s2*occupancy
         !   on disk   MOLECULE.RHO:get_Hirshfeld_atom_FFs_disk (fragHAR)
         !                                                  -- s2 = occupancy/sc
         !   recompute MOLECULE.RHO:get_Hirshfeld_atom_FFs_for_atom
         !                                                  -- sf*s2*occupancy
         !
         ! so the same structure refined with use_disk_SFs on and off gave
         ! different structure factors whenever an occupancy was not 1. Silent:
         ! for a fully occupied small molecule the factor is exactly 1 and
         ! nothing changes, which is every job in tests/. It is disordered
         ! structures and proteins -- per Dylan, "definitely not [one] for
         ! proteins" -- where it is wrong.
         !
         ! sf_u feeds sf_e and the derivatives sf_d as well as the <tag>-SFs
         ! file, so this corrects the refinement, not just the stored factors.
         !
         ! Indexed as .crystal.fragment_atom(c), matching get_Hirshfeld_atom_-
         ! FFs_disk, because the two write the SAME files and must agree.
         sc = .crystal.frag_atom_sym_factor(c)

         if (NOT sc.is_zero) then

            s2 = .crystal.fragment_atom(c).site_occupancy/sc
  
            ! Get the Becke grid for atom "c" (leaky)
            .becke_grid.make_atom_grid(pt,wt,c)
            n_pt = pt.dim1
  
            ! Apply stockholder weight function "Wc" for atom "c"
            ! If using interpolatators, then on overlapping atoms
            ! are used ... otherwise nothing is skipped
            .apply_stockholder_atom_weight(wt,c,pt)
  
            ! Prune the grid with new "wt"
            .becke_grid.prune_grid(pt,wt)

            ! Density for atom "c"
            n_pt = pt.dim1   ! <-- New n_pt !!!
            rho.create(n_pt)
            .make_ED_grid_r_v2(rho,pt,.density_mx.r,cutoff)

            ! Weight the atom "c" density
            rho = rho*wt
  
            ! Get aspherical form factor sf_u
            .make_atom_FFs_on_grid(sf_u,k_pts,pt,rho,c)
            sf_u = sf_u * s2
  
         !  ! Write out sf_u
         !  arch.create(trim(.atom(c).tag)//"-SFs")
         !  if (.crystal.xray_data.use_text_SFs) arch.set_format("ascii")
         !  arch.per_rank_write(sf_u)
         !  arch.destroy
  
            ! Clean up atom "c" stuff
            rho.destroy
            wt.destroy
            pt.destroy
  
            ! Clean up
            k_pts.destroy

         end

         ! NOTE: seeding X_fit from the atoms, copying X_ref and printing the
         ! fit header used to happen HERE -- inside this `do u` loop, so once
         ! per ATOM per LS iteration. X_fit is authoritative, so re-seeding it
         ! from the atoms mid-fit throws away the refinement. They are now done
         ! once in LS_fit_HAs_disk before the loop, where
         ! CRYSTAL:LS_structure_fit has them.

         ! Constants
         ! Fragment atom
         f   = .crystal.unique_frag_atom(u)
         a   = .crystal.asym_atom_for_frag_atom(f) ! declare
         n_p_atom = .crystal.asymmetric_unit_atom(a).no_of_pADPs
         
         
         ! Per u-atom Symmetry generated structure factors
         sf_d.create(n_k,n_p_atom) ! Symmetry generated SF derivatives
         
         ! Aspherical temperature independent SFs
         ! sf_u = ZERO
         ! HERE
         
         ! Symmetry generated k points
         k_pt.create(n_k,3)
         .crystal.xray_data.reflections.make_unique_SF_k_pts(k_pt,.crystal.spacegroup,.crystal.unit_cell)
         
         ! Refine only 4th's?
         zero3 = ONE
         if (.crystal.xray_data.refine_4th_order_only) zero3 = ZERO
         
         ! Initialize
         sf_d = ZERO
         
         ! This atom's label
         tag = .crystal.fragment_atom(f).tag
  
  
         ! Read stored SFS !!!!!!!!!!!!
         ! arch.create(trim(tag)//"-SFs")
         ! if (.crystal.xray_data.use_text_SFs) arch.set_format("ascii")
         ! arch.read(sf_u)
         ! arch.destroy
         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  
         ! May need to be initialised. Trying without atm
         ! DIE_IF(NOT adp2.equals(.crystal.fragment_atom(f).ADP_tensor),"ADP2 not equal to ADP_tensor")
            
         ! Get ADP2s
         .crystal.fragment_atom(f).put_ADP2_vector_to(adp2)
         
         ! ADP4's !!!!!!!!!!!!!
         if (refine_ADP4s) then
         !!!!!!!!!!!!!!!!!!!!!!
         
            ! Get ADP tensors
            .crystal.fragment_atom(f).put_ADP3_vector_to(adp3)
            .crystal.fragment_atom(f).put_ADP4_vector_to(adp4)
         
            do k = 1,n_k
         
               ! Scattering vector
               k1 = k_pt(k,1)
               k2 = k_pt(k,2)
               k3 = k_pt(k,3)
               kv = [k1,k2,k3]
         
               ! Component products
               k1_k1 = k1*k1
               k2_k2 = k2*k2
               k3_k3 = k3*k3
               k1_k2 = k1*k2
               k1_k3 = k1*k3
               k2_k3 = k2*k3
         
               ! U tensor contracted with k vector
               c2 = adp2.contract_with(kv)*HALF
               c3 = adp3.contract_with(kv)*SIXTH
               c4 = adp4.contract_with(kv)*SIXTH*QUARTER
         
               ! Static structure factor x TF
               ! i.e. dynamic structure factor,
               ! in the harmonic approximation
               sfh = sf_u(k) * exp(-c2)
         
               ! Multiples of *anharmonic* structure factor
               sf1 = sfh * (ONE - II*c3 + c4)
               sf2 = sf1 * HALF
         
               ! SF contribution (anharmonic!)
               sf_e(k) = sf_e(k) + sf1
         
               if (refine_positions) then 
                  sf_d(k, 1) =  II*k1*sf1
                  sf_d(k, 2) =  II*k2*sf1
                  sf_d(k, 3) =  II*k3*sf1
               end
         
               if (refine_ADPs) then
         
                  ! U2 derivatives
                  sf_d(k, 4) = -k1_k1*sf2
                  sf_d(k, 5) = -k2_k2*sf2
                  sf_d(k, 6) = -k3_k3*sf2
                  sf_d(k, 7) = -k1_k2*sf1
                  sf_d(k, 8) = -k1_k3*sf1
                  sf_d(k, 9) = -k2_k3*sf1
                 
                  ! Structure factor (harmonic)
                  sf1  = sfh
                 
                  ! Multiples of *harmonic* sf
                  sf2  = sf1 * HALF
                  sf4  = sf1 * QUARTER
                  sf6  = sf1 * SIXTH
                  sf24 = sf1 * SIXTH*QUARTER
                 
                  ! U3 derivatives
                  sf_d(k,10) = -II*k1_k1*k1*sf6*zero3
                  sf_d(k,11) = -II*k2_k2*k2*sf6*zero3
                  sf_d(k,12) = -II*k3_k3*k3*sf6*zero3
                  sf_d(k,13) = -II*k1_k1*k2*sf2*zero3
                  sf_d(k,14) = -II*k1_k1*k3*sf2*zero3
                  sf_d(k,15) = -II*k2_k2*k1*sf2*zero3
                  sf_d(k,16) = -II*k2_k2*k3*sf2*zero3
                  sf_d(k,17) = -II*k3_k3*k1*sf2*zero3
                  sf_d(k,18) = -II*k3_k3*k2*sf2*zero3
                  sf_d(k,19) = -II*k1*k2*k3*sf1*zero3
                 
                  ! U4 derivatives
                  sf_d(k,20) = k1_k1*k1_k1*sf24
                  sf_d(k,21) = k2_k2*k2_k2*sf24
                  sf_d(k,22) = k3_k3*k3_k3*sf24
                  sf_d(k,23) = k1_k1*k1_k2*sf6
                  sf_d(k,24) = k1_k1*k1_k3*sf6
                  sf_d(k,25) = k2_k2*k1_k2*sf6
                  sf_d(k,26) = k2_k2*k2_k3*sf6
                  sf_d(k,27) = k3_k3*k1_k3*sf6
                  sf_d(k,28) = k3_k3*k2_k3*sf6
                  sf_d(k,29) = k1_k1*k2_k2*sf4
                  sf_d(k,30) = k1_k1*k3_k3*sf4
                  sf_d(k,31) = k2_k2*k3_k3*sf4
                  sf_d(k,32) = k1_k1*k2_k3*sf2
                  sf_d(k,33) = k2_k2*k1_k3*sf2
                  sf_d(k,34) = k3_k3*k1_k2*sf2
         
               end
         
            end
         
         
         ! ADP3's !!!!!!!!!!!!!!!!!!
         else if (refine_ADP3s) then
         !!!!!!!!!!!!!!!!!!!!!!!!!!!
         
         
            ! Get ADP tensors
            .crystal.fragment_atom(f).put_ADP3_vector_to(adp3)
         
            do k = 1,n_k
         
               ! Scattering vector
               k1 = k_pt(k,1)
               k2 = k_pt(k,2)
               k3 = k_pt(k,3)
               kv = [k1,k2,k3]
         
               ! Component products
               k1_k1 = k1*k1
               k2_k2 = k2*k2
               k3_k3 = k3*k3
               k1_k2 = k1*k2
               k1_k3 = k1*k3
               k2_k3 = k2*k3
         
               ! U tensor contracted with k vector
               c2 = adp2.contract_with(kv)*HALF
               c3 = adp3.contract_with(kv)*SIXTH
         
               ! Static structure factor x TF
               ! i.e. dynamic structure factor,
               ! in the harmonic approximation
               sfh = sf_u(k) * exp(-c2)
         
               ! Multiples of *anharmonic* structure factor
               ! -- 3rd order only.
               sf1 = sfh * (ONE - II*c3)
               sf2 = sf1 * HALF
         
               ! SF contribution (anharmonic!)
               sf_e(k) = sf_e(k) + sf1
         
               !test refine_H_positions Lorraine
               if (refine_positions) then
         
                  ! Pos derivatives
                  sf_d(k, 1) =  II*k1*sf1
                  sf_d(k, 2) =  II*k2*sf1
                  sf_d(k, 3) =  II*k3*sf1
         
               end
         
               if (refine_ADPs) then
         
                  ! U2 derivatives
                  sf_d(k, 4) = -k1_k1*sf2
                  sf_d(k, 5) = -k2_k2*sf2
                  sf_d(k, 6) = -k3_k3*sf2
                  sf_d(k, 7) = -k1_k2*sf1
                  sf_d(k, 8) = -k1_k3*sf1
                  sf_d(k, 9) = -k2_k3*sf1
                 
                  ! Structure factor (harmonic!)
                  sf1  = sfh
                 
                  ! Multiples of *harmonic* sf
                  sf2  = sf1 * HALF
                  sf6  = sf1 * SIXTH
                 
                  ! U3 derivatives
                  sf_d(k,10) = -II*k1_k1*k1*sf6
                  sf_d(k,11) = -II*k2_k2*k2*sf6
                  sf_d(k,12) = -II*k3_k3*k3*sf6
                  sf_d(k,13) = -II*k1_k1*k2*sf2
                  sf_d(k,14) = -II*k1_k1*k3*sf2
                  sf_d(k,15) = -II*k2_k2*k1*sf2
                  sf_d(k,16) = -II*k2_k2*k3*sf2
                  sf_d(k,17) = -II*k3_k3*k1*sf2
                  sf_d(k,18) = -II*k3_k3*k2*sf2
                  sf_d(k,19) = -II*k1*k2*k3*sf1
         
               end
         
            end
         
         
         ! ADP2's !!!!!!!!!!!!!!
         else ! NO anharmonicity
         !!!!!!!!!!!!!!!!!!!!!!!
         
         
            ! This is for isotropic refinement
            if (refine_Uiso) then ! For U_iso 
         
               do k = 1,n_k
         
                  ! Scattering vector
                  k1 = k_pt(k,1)
                  k2 = k_pt(k,2)
                  k3 = k_pt(k,3)
                  kv = [k1,k2,k3]
         
                  ! Component products
                  k1_k1 = k1*k1
                  k2_k2 = k2*k2
                  k3_k3 = k3*k3
                  k1_k2 = k1*k2
                  k1_k3 = k1*k3
                  k2_k3 = k2*k3
         
                  ! U tensor contracted with k vector
                  c2 = adp2.contract_with(kv)*HALF
         
                  ! Static structure factor x TF
                  ! i.e. dynamic structure factor,
                  ! in the harmonic approximation
                  sfh = sf_u(k) * exp(-c2)
         
                  ! Multiples *harmonic* structure factor
                  sf1 = sfh
                  sf2 = sf1 * HALF * (k1_k1+k2_k2+k3_k3)
         
                  ! SF contribution (harmonic)
                  sf_e(k) = sf_e(k) + sf1
         
                  if (refine_positions) then
         
                     ! Pos derivatives
                     sf_d(k, 1) =  II*k1*sf1
                     sf_d(k, 2) =  II*k2*sf1
                     sf_d(k, 3) =  II*k3*sf1
         
                  end
         
                  if (refine_ADPs) then
         
                     ! U_iso derivatives
                     sf_d(k, 4) = -sf2
                     sf_d(k, 5) = -sf2
                     sf_d(k, 6) = -sf2
                     sf_d(k, 7) = ZERO
                     sf_d(k, 8) = ZERO
                     sf_d(k, 9) = ZERO
         
                  end
         
               end
         
            ! This is an isotropic refinement
            else ! For ADP2s !!!!!!!!!!!!!!!!!
         
               do k = 1,n_k
         
                  ! Scattering vector
                  k1 = k_pt(k,1)
                  k2 = k_pt(k,2)
                  k3 = k_pt(k,3)
                  kv = [k1,k2,k3]
         
                  ! Component products
                  k1_k1 = k1*k1
                  k2_k2 = k2*k2
                  k3_k3 = k3*k3
                  k1_k2 = k1*k2
                  k1_k3 = k1*k3
                  k2_k3 = k2*k3
         
                  ! U tensor contracted with k vector
                  c2 = adp2.contract_with(kv)*HALF
         
                  ! Static structure factor x TF
                  ! i.e. dynamic structure factor,
                  ! in the harmonic approximation
                  sfh = sf_u(k) * exp(-c2)
         
                  ! Multiples *harmonic* structure factor
                  sf1 = sfh
                  sf2 = sf1 * HALF
         
                  ! SF contribution (harmonic)
                  sf_e(k) = sf_e(k) + sf1
         
                  if (refine_positions) then
         
                     ! Pos derivatives
                     sf_d(k, 1) =  II*k1*sf1
                     sf_d(k, 2) =  II*k2*sf1
                     sf_d(k, 3) =  II*k3*sf1
         
                  end
         
                  if (refine_ADPs) then
         
                     ! U2 derivatives
                     sf_d(k, 4) = -k1_k1*sf2
                     sf_d(k, 5) = -k2_k2*sf2
                     sf_d(k, 6) = -k3_k3*sf2
                     sf_d(k, 7) = -k1_k2*sf1
                     sf_d(k, 8) = -k1_k3*sf1
                     sf_d(k, 9) = -k2_k3*sf1
         
                  end
         
               end
         
            end
         
         end
         
         ! Clean
         k_pt.destroy ! KEEP ... Keep what? DJ
         
         ! WRITE SF_U TO DISK HERE TO SAVE TIME
         ! Write out sf_u
         !
         ! Plain `write`, NOT `per_rank_write`. The enclosing `do u` loop is
         ! SERIAL, so every rank reaches this with the same "u", hence the same
         ! atom "c", hence the same file name -- and per_rank_write is the
         ! ordinary write with the master-only guard REMOVED, so that was every
         ! rank writing one file concurrently, with no locking and no offsets.
         ! See FILE:per_rank_write for the precondition it violates.
         !
         ! Not a regression: this loop was never parallelised. The commit that
         ! introduced it (bfd30b95) followed two that say so outright -- "for
         ! FUTURE parallelism" (b2c53834) and "needs to be tested before
         ! parallelisation can begin" (15c2aee3). The per_rank_write came in
         ! with the loop body, copied from MOLECULE.RHO:get_Hirshfeld_atom_FFs_-
         ! disk, which does the same thing inside a `parallel do u` and is
         ! therefore correct -- there each rank owns distinct u, so distinct
         ! file names. The `parallel` keyword never arrived at this copy.
         !
         ! Master-only is right here, not `parallel do`: sf_e accumulates ACROSS
         ! u (see "sf_e(k) = sf_e(k) + sf1" below) and make_F_predicted_from is
         ! called INSIDE this loop, so parallelising needs a reduction and a
         ! restructure. Since the loop is serial every rank computes the same
         ! sf_u, so the master's file is complete and correct.
         !
         ! ARCHIVE:write is the safe path: FILE:open_for guards the open and
         ! then broadcasts .unit and .io_status, so the DIE_IF stays collective,
         ! and FILE:write/close are guarded with .record kept in step on every
         ! rank.
         arch.create(trim(.atom(c).tag)//"-SFs")
         if (.crystal.xray_data.use_text_SFs) arch.set_format("ascii")
         arch.write(sf_u)
         arch.destroy
         
         sf_u.destroy
         
         ! .crystal.make_unique_sf_derivs(sf_e,sf_d) ! processor 1 finishes here
         
         ! Make and set F_pred with scale & extinction.
         .crystal.xray_data.reflections.reset_F_corr_to_F_exp ! We fit to F_corr
         .crystal.make_F_predicted_from(sf_e)  ! ... and applies the dispersion convention
         
         ! Base index for unique frag atom
         base = .crystal.fragment_atom(.crystal.unique_frag_atom).no_of_pADPs_up_to_atom(u)
         
         ! Sum the symmetry-generated SF's to get
         ! the derivative structure factors dFc
         dFc_atom.create(.crystal.xray_data.reflections.dim,n_p_atom)
         .crystal.spacegroup.sum_unique_sf_derivs(dFc_atom,sf_d,.crystal.xray_data.reflections) ! Check dimensions in here
         sf_d.destroy
         
         ! Add derivative of anomalous contribution to |SF|, dFc
         ! Only if F_calc has anomalous dispersion added into it.
         if (.crystal.xray_data.add_dispersion_to_F_calc) then
         
            ! Size of symmetry generated k points
            ! WARNING: new k_pt array
            n_k = .crystal.n_symop_generated_SF_k_pts
            k_pts.create(n_k,3) ! NEW
          
            ! Size of anamalous Jacobian
            dFa_atom.create(n_k,n_p_atom)
            dFb_atom.create(.crystal.xray_data.reflections.dim,n_p)
          
            ! The full list of symmetry-generated k points
            .crystal.xray_data.reflections.make_symop_generated_SF_k_pts(k_pts,.crystal.spacegroup,.crystal.unit_cell)
          
            ! Note: each atom contribution scales by a site-symmetry factor
            dFa_atom = ZERO
          
            rf = .crystal.frag_atom_sym_factor(f)
            if (NOT rf.is_zero) then
               base = .crystal.fragment_atom(.crystal.unique_frag_atom).no_of_pADPs_up_to_atom(u)
               .crystal.fragment_atom(f).add_derivative_dispn(dFa_atom,base,k_pts,rf) ! Get rid of base here
            end
          
            ! Add together symmetry contributions
            dFb_atom = ZERO
            .crystal.spacegroup.add_full_sf_derivs_d(dFb_atom,dFa_atom,.crystal.xray_data.reflections)
          
            dFc_atom = dFc_atom + dFb_atom
         
            ! Clean
            dFb_atom.destroy
            dFa_atom.destroy
            k_pts.destroy
         
         end 
         
         ! Copy & clean
         dFc(:,base+1:base+n_p_atom) = dFc_atom
         dFc_atom.destroy

      end
     
      sf_e.destroy
     
      ! Get the derivative absolute SF's, F_abs = |F_calc|
      .crystal.xray_data.d_F_abs_dX(d_Fa,dFc)
      dFc.destroy

   end

   do_LS_refinement(d_Fa) :: leaky 
   ! Performs the least squares refinement
      self :: INOUT
      d_Fa :: MAT{REAL}@, INOUT

      dF :: MAT{REAL}@

      ! Get the unique atom shifts, dX (leaky)
      .crystal.xray_data.solve_normal_equations(d_Fa)

      ! Change/store unique frag atom -> asym atom shifts
      ! Change/store the covariance matrix too.
      .crystal.set_asym_from_ufrag_shifts ! .xray_data.dX now for asym atoms
      .crystal.set_asym_from_ufrag_cov_mx

      ! Stop symmetry breaking
      ! NOTE: we should apply this to the gradient *not*
      ! the shift to make sure the shift maintains symmetry
      .crystal.stabilize_asym_atom_shifts

      ! Store old asym-atom parameter vector.
      ! Add shift dA to get new .xray_data.X_fit
      .crystal.xray_data.update_fit_parameters
      .crystal.asymmetric_unit_atom.set_pADP_vector_to(.crystal.xray_data.X_fit)

      ! Set the fit errors e.g. max(dX/esd)
      ! Copy them to the asymmetric unit atoms.
      .crystal.update_fit_esds
      .crystal.asymmetric_unit_atom.set_pADP_errors_to(.crystal.xray_data.covariance_mx,.crystal.xray_data.refine_H_U_iso)

      ! Set ALL fragment_atom positions/ADPs from asym atoms HERE
      ! >>>fragment_atom must be the same as molecule.atom
      dF.create(3,.crystal.n_fragment_atoms)
      .crystal.set_frag_from_asym_pADPs(dF)

      ! Update structure factors, the unique (rigid) frag atom SF's.
      ! Use the frag atom position shifts "dF".
      .crystal.shift_update_ff(dF)
      dF.destroy

      ! Close the chain. X_fit is authoritative and the atoms follow it:
      !
      !   X_fit  --set_pADP_vector_to-->  asymmetric_unit_atom
      !          --set_frag_from_asym_pADPs-->  crystal.fragment_atom
      !          --THIS LINE-->  .atom
      !
      ! and make_LS_mx builds the next design matrix from .atom -- its Becke
      ! grid and Fourier sum read .atom(c).position. Without this the moved
      ! geometry never reached the next iteration, so the design matrix was
      ! rebuilt from the ORIGINAL coordinates every pass.
      !
      ! The requirement was already written down two lines up -- ">>>
      ! fragment_atom must be the same as molecule.atom" -- but nothing did it.
      ! The in-core path gets away without it because CRYSTAL:LS_structure_fit
      ! computes its form factors once, before the fit, and MOLECULE.HAR:LS_fit
      ! does `.atom = .crystal.fragment_atom` after the whole thing. The disk
      ! path rebuilds every iteration, so it needs the refresh every iteration.
      .atom = .crystal.fragment_atom

   end

!  ==============
!  IAM refinement
!  ==============

   IAM_refinement
   ! Do an IAM refinement. Actually this is just a fit.
   ! Cartesian (bohr) coordinates are used because structure factors
   ! are aspherical and calculated from the QM wavefunction.
   ! NOTE: this routine does only one cycle of fitting with the
   ! current density matrix i.e. this is a "rigid atom fit".
   ! NOTE: It's tricky exactly which atom's are used for refinement:
   ! * Structure factors are calculated only for *unique* fragment
   !   atoms since the QM wavefunction refers to the fragment_atoms.
   ! * However, asymmetric unit atoms are used to "store" the updating
   !   geometry; thus unique fragment atom pADPs and shifts are
   !   calculated (and derivatives with respect to the fragment atom
   !   positions and ADPs) but these parameters and shifts are later
   !   transformed back into asymmetric unit.
      self :: INOUT

   ENSURE(.atom.allocated, "no atoms to fit")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated,"no crystal xray data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      ff :: MAT{CPX}@

      ! Set so that called routines know
      .crystal.xray_data.set_is_IAM_refinement(TRUE)

      ! Isotropic H's?
      if (.crystal.xray_data.refine_H_U_iso) .atom.set_isotropic_H_ADP

      ! Do we need atomic density matrices
      if (NOT .crystal.xray_data.use_IAM_ITC_FFs) then
         .make_ANOs_and_interpolators
         .atom.set_use_IAM_ITC_FFs(FALSE)
      end

      ! Get atom SF's. May IAM gaussian FFs.
      .make_unique_IAM_atom_FFs(ff)

      ! Do a least squares
      .LS_fit(ff,.crystal.xray_data.show_IAM_output,.crystal.xray_data.show_IAM_results)

      ! Clean up
      ff.destroy

      ! Correlations
      .crystal.put_correlations(name=trim(.name)//".correlation-coefficients")

      ! Put residuals ...
      if (.crystal.xray_data.do_residual_cube) then
         .get_minmax_residual_density(output=TRUE)
      end

      ! Put final CIF after residuals
      .put_CIFs

      ! Do standatd plots and properties
      if (.crystal.xray_data.do_standard_plots) then
      end

   end

!  ================================================
!  Least-squares refinement with given form factors
!  ================================================

   LS_fit(ff,output,results) :: leaky, private
   ! Do a least squares structure refinement with a given set of
   ! static aspherical form factors "ff". Note the dimensions.
   ! The structure factors "ff" update when the geometry shifts.
   ! If "output"  is false, do not print any LS fit output.
   ! If "results" is false, do not print any LS fit results.
      self    :: INOUT
      ff      :: MAT{CPX}, INOUT
      output  :: BIN, IN
      results :: BIN, IN

   ENSURE(.atom.allocated, "no atoms to fit")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.xray_data.allocated,"no crystal xray data")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")
   ENSURE(ff.dim1==.crystal.n_unique_SF_k_pts,       "ff: wrong dim1")
   ENSURE(ff.dim2==.crystal.n_asymmetric_unit_atoms, "ff: wrong dim2")

      ! Do the fit 
      .crystal.LS_structure_fit(ff,output,results)

      ! Set geometry type
      if (NOT .crystal.xray_data.partition_model=="oc-crystal23") then 
         ! NOTE: For pHAR, .atom is xml_atom and 
         ! .crystal.fragment_atom is for geometry analysis
         .atom = .crystal.fragment_atom 
         .crystal.asymmetric_unit_source = "tonto-refinement"
      end

   end

   ! Split? Simplifify logic & presentation?

   LS_fit(output,results) :: leaky, private
   ! Do a least squares structure refinement with a given set of
   ! static aspherical form factors which are on disk.
   ! If "output"  is FALSE, do not print any LS fit output.
   ! If "results" is FALSE, do not print any LS fit results.
      self    :: INOUT
      output  :: BIN, IN
      results :: BIN, IN

   ENSURE(.atom.allocated, "no atoms to fit")
   ENSURE(.crystal.allocated, "no crystal")
   ENSURE(.crystal.fragment_info_made, "no crystal fragment info")

      ! Do the fit 
      .crystal.LS_structure_fit(output,results)

      ! Set geometry type
      .atom = .crystal.fragment_atom
      .crystal.asymmetric_unit_source = "tonto-refinement"

   end

!  ===============
!  Invariom labels
!  ===============

   put_SMILES_invariom_labels
   ! Analyze the SCF energy into MO contributions
      self :: IN

   ENSURE(.atom.allocated,"no atoms")

      labels :: VEC{STR}@
      invariom_kind :: VEC{EVEC{INT}}@
      n_kind,n_elem,n_dash,k,l :: INT

      ! Get the invariom labels
      labels = .atom.smiles_invariom_labels

      ! Put labels out
      stdout.flush
      stdout.text("SMILES invariom labels:")
      stdout.put(labels,left=TRUE)

      ! Make the invariom kind table
      invariom_kind.repetitions_in(labels)

      ! Maximum no. of elements
      n_kind = invariom_kind.dim
      n_elem = 0
      do k = 1,n_kind
         n_elem = max(n_elem,invariom_kind(k).element.dim)
      end

      ! Put invariom kind table out
      stdout.flush
      stdout.show("No. of distinct labels =",invariom_kind.dim)
      stdout.flush
      stdout.text("Table of invariom kinds")
      stdout.flush
      n_dash = min(10,n_elem)
      stdout.dash(width=5*(n_dash+1))
      stdout.put("Kind",width=5)
      stdout.put(" #'s",width=5)
      stdout.flush
      stdout.dash(width=5*(n_dash+1))
      do k = 1,n_kind
         stdout.put(k,width=5)
         n_elem = invariom_kind(k).element.dim
         stdout.put(invariom_kind(k)[1],width=5)
         l = 1
         do
            l = l + 1
            if (l>n_elem) exit
            if (mod(l,10)==1) then
            stdout.flush
            stdout.tab(width=5)
            end
            stdout.put(invariom_kind(k)[l],width=5)
         end
         stdout.flush
      end
      stdout.dash(width=5*(n_dash+1))

      ! Cleanup
      invariom_kind.destroy
      labels.destroy

   end

   put_invariom_labels
   ! Analyze the SCF energy into MO contributions
      self :: IN

   ENSURE(.atom.allocated,"no atoms")

      labels :: VEC{STR}@
      invariom_kind :: VEC{EVEC{INT}}@

      n_kind,n_elem,n_dash,k,l :: INT

      ! Get the invariom labels
      labels = .atom.invariom_labels

      ! Put labels out
      stdout.flush
      stdout.text("Atom names and their invariom labels:")

      do k = 1,labels.dim
         stdout.put(k,width=5)
         stdout.put(.atom(k).label,width=10,left=TRUE)
         stdout.put(labels(k),width=25,left=TRUE)
         stdout.flush
      end
      stdout.flush


      ! Make the invariom kind table
      invariom_kind.repetitions_in(labels)

      ! Maximum no. of elements
      n_kind = invariom_kind.dim
      n_elem = 0
      do k = 1,n_kind
         n_elem = max(n_elem,invariom_kind(k).element.dim)
      end

      ! Put invariom kind table out
      stdout.flush
      stdout.show("No. of distinct labels =",invariom_kind.dim)
      stdout.flush
      stdout.text("Table of invariom kinds")
      stdout.flush

      n_dash = min(10,n_elem)
      stdout.dash(width=5*(n_dash+1))
      stdout.put("Kind",width=5)
      stdout.put(" #'s",width=5)
      stdout.flush
      stdout.dash(width=5*(n_dash+1))

      do k = 1,n_kind

         stdout.put(k,width=5)
         n_elem = invariom_kind(k).element.dim
         stdout.put(invariom_kind(k)[1],width=5)
         l = 1
         do
            l = l + 1
            if (l>n_elem) exit
            if (mod(l,10)==1) then
            stdout.flush
            stdout.tab(width=5)
            end
            stdout.put(invariom_kind(k)[l],width=5)
         end
         stdout.flush

      end

      stdout.dash(width=5*(n_dash+1))

      ! Cleanup
      invariom_kind.destroy
      labels.destroy

   end

   put_invariom_label
   ! Analyze the SCF energy into MO contributions
      self :: IN

   ENSURE(.atom.allocated,"no atoms")

      label :: STR
      i :: INT

      stdin.read(i)
      label = .atom.invariom_label_of(i)
      stdout.flush
      stdout.show("Invariom label for atom ="//trim(i.to_str)//" = ",label)

   end

   put_next_neighbour_handedness
   ! Put the next neighbour handedness out, for the atom with the
   ! index specified in the input.
      self :: IN

   ENSURE(.atom.allocated,"no atoms")

      hand :: STR
      i :: INT

      stdin.read(i)
      hand = .atom.next_neighbour_handedness_of(i)
      stdout.flush
      stdout.show("Next-neighbour handedness of atom ="//trim(i.to_str)//" = ",hand)

   end

!  ====================================
!  Spherically averaged Hirshfeld atoms
!  ====================================

   make_iterative_HAs :: leaky
   ! Make the (iteratively) Hirshfeld atoms a la Wheatly.
      self :: INOUT

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom_info_made,"no atom info")
   ENSURE(.n_atom_kind>0,"no atom kinds")

      max_iterations :: INT

      ! Do it
      max_iterations = 250
      .make_SAHA(max_iterations)

   end

   make_spherically_averaged_HAs :: leaky
   ! Make the (iteratively) spherically averaged Hirshfeld atom (SAHA)
   ! density interpolators. You may specify the maximum iterations on
   ! the input line if you want; if not, it is assumed to be 1.
      self :: INOUT

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom_info_made,"no atom info")
   ENSURE(.n_atom_kind>0,"no atom kinds")

      max_iterations :: INT

      ! Read max # if iterations
      max_iterations = 1
      if (stdin.n_line_items>1) stdin.read(max_iterations)

      ! Do it
      .make_SAHA(max_iterations)

   end

   make_SAHA(max_iterations) :: private, leaky
   ! Make the (iteratively) spherically averaged Hirshfeld atom (SAHA)
   ! density interpolators, for every atom. NOTE: these are supposed
   ! to be the iterative stockholder atoms (ISA) of Lillestolen &
   ! Wheatley, Chem. Commun., 2008, 5909–5911.
      self :: INOUT
      max_iterations :: INT

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom_info_made,"no atom info")
   ENSURE(.n_atom_kind>0,"no atom kinds")

      interpolator :: VEC{INTERPOLATOR}@
      rho_av :: VEC{EVEC{REAL}}@
      max_eps,eps,eps_a :: REAL
      max_l, a,iteration :: INT

      ! Parameters defining the SAHA's
      max_l          = 18     ! L-value for for spherical averaging.
      max_eps        = TOL(6) ! Maximum absolute difference for convergence

      ! Switch interpolators on
      if (NOT .use_interpolators) then
         WARN("You must be using interpolators!")
         .use_interpolators = TRUE
      end

      ! Set default template for atom interpolators
      if (.interpolator.deallocated) then
         .interpolator.create
         .interpolator.set_interpolation_method("linear")
         .interpolator.set_range_mapping("none")
         .interpolator.set_domain_mapping("sqrt(x/(1-x))*scale")
         .interpolator.set_table_length(ONE)
         .interpolator.set_spacing(0.01d0)
         .interpolator.set_table_eps(0.001d0)
      end

      ! Reset ANO interpolators
      .destroy_interpolators
      .make_atom_partition_info

      ! Copy ANO interpolators (which become IHA's)
      interpolator.create(.n_atom)
      do a = 1,.n_atom
         interpolator(a) = .atom(a).interpolator
      ! interpolator(a).put
      end

      ! Reassign fresh (non-ANO) interpolator copy;
      ! Create averaged rho; set extrapolator.
      .destroy_ANO_matrices
      rho_av.create(.n_atom)
      do a = 1,.n_atom
         .atom(a).interpolator = interpolator(a)
         rho_av(a).element.create(interpolator(a).n_data)
      end
      .atom.set_is_unique_kind(FALSE)

      ! Banner
      stdout.flush
      stdout.text("=========================================")
      stdout.text("Make spherically averaged Hirshfeld atoms")
      stdout.text("=========================================")

      stdout.flush
      if (max_iterations==1) then
      stdout.text("This will make a single-iteration average")
      else
      stdout.text("This may make an iteratively spherical averaged")
      stdout.text("Hirshfeld atom (IHA) or ISA as described by these :")
      stdout.text("Lillestolen & Wheatley, Chem. Commun., 2008, 5909–5911.")
      stdout.text("but only if the precedure converges!")
      stdout.flush
      stdout.show("Max. iterations             =",max_iterations)
      end

      stdout.show("Convergence on density      =",max_eps)
      stdout.show("L max (for spherical avg.)  =",max_l)

      stdout.flush
      stdout.dash(int_fields=1,real_fields=1)
      stdout.put("Iter",int_width=TRUE)
      stdout.put("Max change")
      stdout.flush
      stdout.dash(int_fields=1,real_fields=1)


      ! Begin iterative cycle to get the IHA
      iteration = 0

      do

         iteration = iteration + 1

         ! Spherically average & extrapolate, for each atom
         eps = ZERO
         do a = 1,.n_atom

            .make_spherically_averaged_HA(rho_av(a).element,eps_a,a,interpolator(a),max_l)

            eps = max(eps,eps_a)

         end

         ! Update convergence
         stdout.put(iteration)
         stdout.put(eps)
         stdout.flush

         ! Transfer averaged values to atoms and interpolators
         do a = 1,.n_atom
            interpolator(a).set_data_values(rho_av(a).element)
            interpolator(a).finalize
         end

         ! Spherically avereaged Hirshfeld atoms obtained?
         if (eps<max_eps) exit
         if (iteration>max_iterations) exit

      end

      ! Footer
      stdout.dash(int_fields=1,real_fields=1)

      ! Clean up
      rho_av.destroy

   end

   make_spherically_averaged_HA(rho_av,eps,a,interpolator,l_max)
   ! Make the spherically averaged Hirshfeld atom density "rho_av" for
   ! the atom with index "a". Also return "eps", the maximum
   ! difference between the rho_av values and those stored in the
   ! interpolator data_values. The spacing and radial data values from
   ! the center of atom "a" are taken from the "interpolator". "l_max"
   ! is the maximum l value for the lebedev angular integration grid
      self :: INOUT
      rho_av :: VEC{REAL}, OUT
      eps :: REAL, OUT
      a,l_max :: INT, IN
      interpolator :: INTERPOLATOR

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.atom.has_all_interpolators,"No interpolators")
   ENSURE(rho_av.dim==interpolator.n_data,"wrong size, rho_av")
   ENSURE(a.is_in_range([1,.n_atom]),"a out of range")
   ENSURE(.overlapping_atoms_for_atom.allocated,"no overlapping_atoms")

      pt     :: MAT{REAL}@
      rho,Wa :: VEC{REAL}@
      pos    :: VEC{REAL}(3)
      old,r  :: REAL
      n_pts,n,i :: INT
      lebedev :: LEBEDEV@

      ! Set the spherical grid
      lebedev.create
      lebedev.set_l(l_max)

      ! No of quadrature points (on sphere)
      n_pts = lebedev.n_pts

      ! Weight function, molecular density, spherical points
      ! and weights
      Wa.create(n_pts)
      rho.create(n_pts)
      pt.create(n_pts,3)

      ! Atom position
      pos = .atom(a).position

      ! Maximum relative difference
      eps = ZERO

   ! Debug
   ! stdout.show("atom =",a)
   ! interpolator.put

   ! stdout.put("r")
   ! stdout.put("rho_av")
   ! stdout.put("old")
   ! stdout.put("%")
   ! stdout.flush

      ! Loop over radial values
      do i = 1,interpolator.n_data

         ! Table value r
         r = interpolator.data_point(i)

         ! Interpolator data valie
         old = interpolator.data_value(i)

         ! Convert to actual r?
         if (interpolator.domain_is_sqrt_x1x) &
            r = sqrt(r/(1-r))*interpolator.domain_scale_factor

         ! For each r, make a spherical shell of points
         do n = 1,n_pts
            pt(n,1) = pos(1) + r*lebedev.pts(n,1)
            pt(n,2) = pos(2) + r*lebedev.pts(n,2)
            pt(n,3) = pos(3) + r*lebedev.pts(n,3)
         end

         ! Weight function for atom a on the spherical shell
         .make_stockholder_atom_weight(Wa,a,pt,.overlapping_atoms_for_atom(a).element)

         ! Molecular density on the spherical shell
         .make_ED_grid_at_pts(rho,pt)

         ! Weighted Hirshfeld atom density on shell
         Wa  = Wa*rho*lebedev.wts

         ! Averaged value
         rho_av(i) = sum(Wa)

         ! Average percentage change
         eps = max(eps,abs((rho_av(i)-old)))

   ! del = rho_av(i)-old
   ! stdout.put(r)
   ! stdout.put(rho_av(i))
   ! stdout.put(del)
   ! stdout.flush

      end

      ! Clean up
      pt.destroy
      rho.destroy
      Wa.destroy
      lebedev.destroy

   end

!  ====================
!  Bonded density atoms
!  ====================

   make_averaged_BDAs :: leaky
   ! Make the spherically averaged bond density atom
   ! interpolators for every atom.
      self :: INOUT

   ENSURE(.use_interpolators,"must be using interpolators")

      cluster      :: CLUSTER
      interpolator :: VEC{INTERPOLATOR}@
      rho_av       :: VEC{EVEC{REAL}}@
      eps,eps_a    :: REAL
      a,l_max,iteration :: INT

      ! Set up the template for interpolators
      if (.interpolator.deallocated) then
         .interpolator.create
         .interpolator.set_interpolation_method("cubic_spline")
         .interpolator.set_range_mapping("none")
         .interpolator.set_domain_mapping("sqrt(x/(1-x))*scale")
         .interpolator.set_table_length(ONE)
         .interpolator.set_spacing(0.001d0)
         .interpolator.set_table_eps(cluster.atom_density_cutoff)
      end

      ! Set up grids, atomic densities, and NO's
      .make_atom_partition_info

      ! List of initial atom interpolators. Leaky
      interpolator.create(.n_atom)
      do a = 1,.n_atom
         interpolator(a) = .atom(a).interpolator
      end

      ! Destroy atom ANO data and interpolators. Leaky.
      .destroy_ANO_matrices
      .destroy_interpolators

      ! The list of new atomic radial densities
      rho_av.create(.n_atom)

      ! Reassign fresh interpolator copy; create averaged rho
      do a = 1,.n_atom
         .atom(a).interpolator = interpolator(a)
         rho_av(a).element.create(interpolator(a).n_data)
      end

      ! No of Gauss-Legendre integration points
      l_max = 35

      ! Banner
      stdout.flush
      stdout.dash(int_fields=1,real_fields=1)
      stdout.put("Iter",int_width=TRUE)
      stdout.put("Max change")
      stdout.flush
      stdout.dash(int_fields=1,real_fields=1)

      ! Begin iterative cycle
      iteration = 0

      do

         iteration = iteration + 1

         stdout.show("Iteration =",iteration)

         ! Spherically average each atom
         eps = ZERO
         do a = 1,.n_atom
            .make_averaged_BDAs(rho_av(a).element,eps_a,a,interpolator(a),l_max)
            eps = max(eps,eps_a)
         end

         ! Update convergence
         stdout.put(iteration)
         stdout.put(eps)
         stdout.flush

         ! Transfer averaged values to atoms and interpolators
         do a = 1,.n_atom
            interpolator(a).set_data_values(rho_av(a).element)
            interpolator(a).finalize
            .atom(a).interpolator = interpolator(a)
         ! interpolator(a).put
         end

         ! Spherical atoms obtained
         if (eps<TOL(6)) exit
         if (iteration>=1) exit

      end

      ! Footer
      stdout.dash(int_fields=1,real_fields=1)

      ! Copy atom interpolators. Leaky
      do a = 1,.n_atom
         .atom(a).interpolator.destroy
         .atom(a).interpolator =  interpolator(a)
      end

      ! Clean up
      rho_av.destroy
      interpolator.destroy

   end

   make_averaged_BDAs(rho_av,eps,a,interpolator,l_max)
   ! Make the spherically averaged Hirshfeld atom density "rho_av" for
   ! the atom with index "a". Also return "eps", the maximum
   ! difference between the rho_av values and those stored in the
   ! interpolator data_values. The spacing and radial data values from
   ! the center of atom "a" are taken from the "interpolator". "l_max"
   ! is the maximum l value for the lebedev angular integration grid
      self :: IN
      rho_av :: VEC{REAL}, OUT
      eps :: REAL, OUT
      a,l_max :: INT, IN
      interpolator :: INTERPOLATOR

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.atom.has_all_interpolators,"No interpolators")
   ENSURE(rho_av.dim==interpolator.n_data,"wrong size, rho_av")
   ENSURE(a.is_in_range([1,.n_atom]),"a out of range")

      pt :: MAT{REAL}@
      rho,Wa, del,pc :: VEC{REAL}@
      pos :: VEC{REAL}(3)
      old,r :: REAL
      n_pts,n,i :: INT
      lebedev :: LEBEDEV@

      ! Set the spherical grid
      lebedev.create
      lebedev.set_l(l_max)

      ! No of quadrature points (on sphere)
      n_pts = lebedev.n_pts

      ! Weight function, molecular density, spherical points
      ! and weights
      Wa.create(n_pts)
      rho.create(n_pts)
      pt.create(n_pts,3)

      del.create(interpolator.n_data)
      pc.create(interpolator.n_data)

      ! Atom position
      pos = .atom(a).position

      ! Maximum relative difference
      eps = ZERO

      stdout.show("atom =",a)
      interpolator.put

   ! stdout.put("r")
   ! stdout.put("rho_av")
   ! stdout.put("old")
   ! stdout.put("%")
   ! stdout.flush

      ! Loop over radial values
      do i = 1,interpolator.n_data

         ! Table value r
         r = interpolator.data_point(i)

         ! Interpolator data valie
         old = interpolator.data_value(i)

         ! Convert to actual r?
         if (interpolator.domain_is_sqrt_x1x) &
            r = sqrt(r/(1-r))*interpolator.domain_scale_factor

         ! For each r, make a spherical shell of points
         do n = 1,n_pts
            pt(n,1) = pos(1) + r*lebedev.pts(n,1)
            pt(n,2) = pos(2) + r*lebedev.pts(n,2)
            pt(n,3) = pos(3) + r*lebedev.pts(n,3)
         end

         ! Weight function for atom a on the spherical shell
         .make_bond_density_atom_grid(Wa,pt,a)

         ! Weighted Hirshfeld atom density on shell
         Wa  = Wa*lebedev.wts

         ! Averaged value
         rho_av(i) = VEC{REAL}:sum_elements(Wa)

         ! Average percentage change
         eps = max(eps,abs((rho_av(i)-old)))
         del(i) = rho_av(i)-old
         pc(i)  = del(i)/old

   ! stdout.put(r)
   ! stdout.put(rho_av(i))
   ! stdout.put(old)
   ! stdout.put(pc)
   ! stdout.flush

      end

      stdout.text("del:")
      stdout.put(del)

      stdout.text("pc:")
      stdout.put(pc)

      ! Clean up
      pc.destroy; del.destroy
      pt.destroy; rho.destroy; Wa.destroy
      lebedev.destroy

   end

   put_BDA_charges
   ! Put the BDA charges.
   self :: INOUT
   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")

      bond :: VEC{EVEC{INT}}@
      bond_charge :: VEC{EVEC{REAL}}@
      label :: STR
      a,b,c :: INT
      has_bond :: BIN

      ! Make the charges
      .make_BDA_charges(bond,bond_charge)

      ! Put the table
      stdout.dash(real_fields=3)
      stdout.tab(real_fields=1)
      stdout.put("Bonded")
      stdout.put("Bond")
      stdout.flush
      stdout.put("Atom")
      stdout.put("Atom")
      stdout.put("Charge")
      stdout.flush
      stdout.dash(real_fields=3)

      do a = 1,.n_atom

         label = trim(.atom(a).label) // "(" // trim(a.to_str) // ")"
         stdout.put(label)

         has_bond = bond(a).element.allocated
         if (has_bond) has_bond = bond(a).element.dim>0

         if (NOT has_bond) then
            stdout.flush
         else

            do b = 1,bond(a).element.dim
               if (b>1) stdout.tab(real_fields=1)
               c = bond(a).element(b)
               label = trim(.atom(c).label) // "(" // trim(c.to_str) // ")"
               stdout.put(label)
               stdout.put(-bond_charge(a).element(b))
               stdout.flush
            end
            stdout.tab(real_fields=2)
            stdout.put(-VEC{REAL}:sum_elements(bond_charge(a).element))
            stdout.flush

         end

      end

      stdout.dash(real_fields=3)

      ! Clean up
      bond.destroy
      bond_charge.destroy

   end

   make_BDA_charges(bond,bond_charge) :: leaky
   ! make the bond density atom charges.
      self :: INOUT
      bond :: VEC{EVEC{INT}}@, OUT
      bond_charge :: VEC{EVEC{REAL}}@, OUT

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")

      pt :: MAT{REAL}@
      wt,rho_aba,def_density_grid :: VEC{REAL}@
      bond_density_atom :: VEC{INT}@
      n_pt,a,b :: INT
      val :: REAL

      ! Set up grids, atomic densities, and NO's
      .make_atom_partition_info

      ! Array for bonds and bond charges
      bond.create(.n_atom)
      bond_charge.create(.n_atom)

      ! Loop over atoms, a
      do a = 1,.n_atom

         ! Make becke grid
         .becke_grid.make_grid(pt,wt,[a])
         n_pt = pt.dim1

         ! Deformation density on grid
         def_density_grid.create(n_pt)
         .make_def_ED_grid(def_density_grid,pt)

         ! Bond density on grid
         rho_aba.create(n_pt)

         ! bond density atom
         bond_density_atom.create(3)
         bond_density_atom(1) = a
         bond_density_atom(3) = a

         ! Loop over atoms b, bonded to a
         do b = 1,.n_atom

            if (a==b) cycle
            if (NOT .atom.bonded(a,b)) cycle

            ! Get the bond density
            bond_density_atom(2) = b
            .make_def_bond_density_grid(rho_aba,pt,bond_density_atom,def_density_grid)

            ! Get weighted integral
            rho_aba  = rho_aba*wt

            ! Get charge
            val = VEC{REAL}:sum_elements(rho_aba)

            ! Store charge
            bond(a).element.append(b)
            bond_charge(a).element.append(val)

         end

         ! Clean up
         bond_density_atom.destroy
         rho_aba.destroy
         def_density_grid.destroy
         pt.destroy
         wt.destroy

      end

   end

!  =======================================
!  Scaled and derivative stockholder grids
!  =======================================

   make_scaled_stockholder_derivs(G,H,kappa,delta,skip_ANOs)
   ! Make the scaled stockholder atom derivatives "G" and hessian "H"
   ! for used in a Newton-Raphson procedure to find the best scale
   ! factors.
      self      :: INOUT
      G         :: VEC{REAL}, OUT
      H         :: MAT{REAL}, OUT
      kappa     :: VEC{REAL}, IN
      delta     :: REAL, OUT
      skip_ANOs :: BIN, optional, IN

   ENSURE(.basis_info_made,"no basis info")
   ENSURE(.atom.allocated,"no atom list")
   ENSURE(.MOs.allocated, "no MO's")
   ENSURE(.MOs.r.allocated, "no restricted MO's")
   ENSURE(.becke_grid.allocated, "no becke_grid")
   ENSURE(.becke_grid.finalized,"no finalized becke_grid")
   ENSURE(H.is_square,"H is not square")
   ENSURE(G.dim==H.dim1,"G and H are inconsistent")

      Wa_cd :: MAT3{REAL}@
      pt,Wa_c :: MAT{REAL}@
      wt,Wa,G_grid,K_grid,Ga :: VEC{REAL}@
      delta2 :: REAL
      a,c,d,n_pt :: INT

      ! Set up grids, spherical atomic densities, and NO's
      .make_HA_info(skip_ANOs=skip_ANOs) ! Must be HA

      ! Make the stockholder derivatives D and H
      delta = ZERO
      G = ZERO
      H = ZERO
      do a = 1,.n_atom

         ! Make integration grids
         .becke_grid.make_grid(pt,wt,[a])
         n_pt = pt.dim1

         ! Make G and K kinetic densities
         G_grid.create(n_pt)
         K_grid.create(n_pt)
         .make_G_and_K_kinetic_grids(G_grid,K_grid,pt)

         ! Make Hirshfeld atoms
         Wa.create(n_pt)
         .make_stockholder_atom_weight_kappa(Wa,a,kappa,pt)

         ! Make delta kinetic grid
         G_grid = (G_grid - K_grid)*wt
         delta2 = TWO*VEC{REAL}:sum_elements(G_grid*Wa)
         delta  = delta + QUARTER*delta2*delta2
         Wa.destroy
         K_grid.destroy

         ! Stockholder 1st derivatives
         Ga.create(.n_atom)
         Wa_c.create(n_pt,.n_atom)
         .make_d_stockholder_atom_grid(Wa_c,a,kappa,pt)
         do c = 1,.n_atom
            Ga(c) = VEC{REAL}:sum_elements(Wa_c(:,c)*G_grid)
         end
         Wa_c.destroy

         ! Add contribution from 1st derivatives
         G = G + delta2*Ga
         H.plus_outer_product_of(Ga,TWO)
         Ga.destroy

         ! Stockholder 2nd derivatives
         Wa_cd.create(n_pt,.n_atom,.n_atom)
         .make_d2_stockholder_atom_grid(Wa_cd,a,kappa,pt)

         ! Add contribution from 2nd derivatives
         G_grid = delta2*G_grid
         do c = 1,.n_atom
         do d = 1,.n_atom
            H(c,d) = H(c,d) + VEC{REAL}:sum_elements(Wa_cd(:,c,d)*G_grid)
         end
         end
         Wa_cd.destroy

         ! Clean
         G_grid.destroy
         wt.destroy
         pt.destroy

      end

      delta = sqrt(delta)

   end

   make_stockholder_atom_weight_kappa(grid,a,kappa,pt)
   ! Make the scaled stockholder desity "grid" for the atom with index
   ! "a" and with scale parameters "kappa" using supplied points "pt".
   ! This uses gaussian atomic densities.
      self  :: IN
      grid  :: VEC{REAL}, OUT
      a     :: INT, IN
      kappa :: VEC{REAL}, IN
      pt    :: MAT{REAL}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(grid.dim==pt.dim1,"wrong size, grid")
   ENSURE(kappa.dim==.n_atom,"wrong size, kappa")

      rho_a  :: VEC{REAL}@
      n_pt,i :: INT

      ! Allocate temporary densities
      n_pt = grid.dim
      rho_a.create(n_pt)

      ! Make density for atom "a"
      .atom(a).make_ED_grid(rho_a,pt)

      ! Make total density in "grid"
      grid = kappa(a)*rho_a
      do i = 1,.n_atom
         if (i==a) cycle
         .atom(i).add_ED_grid(grid,pt,kappa(i))
      end

      ! Make the stockholder weight
      do i = 1,n_pt
      if (grid(i)>epsilon(ONE)) then; grid(i) = rho_a(i)/grid(i)
      else;                           grid(i) = ZERO
      end
      end
      rho_a.destroy

   end

   make_d_stockholder_atom_grid(grid,a,kappa,pt)
   ! Make the derivative scaled stockholder desity "grid" for the atom
   ! with index "a" and with scale parameters "kappa" using supplied
   ! points "pt".  This uses gaussian atomic densities.
      self :: IN
      grid :: MAT{REAL}, OUT
      a  :: INT, IN
      kappa :: VEC{REAL}, IN
      pt :: MAT{REAL}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(grid.dim1==pt.dim1,"wrong dim1, grid")
   ENSURE(grid.dim2==.n_atom,"wrong dim2, grid")
   ENSURE(kappa.dim==.n_atom,"wrong size, kappa")

      rho_a,rho_c,rho :: VEC{REAL}@
      n_pt,i,c :: INT

      ! Allocate temporary densities
      n_pt = grid.dim1
      rho_a.create(n_pt)
      rho_c.create(n_pt)
      rho.create(n_pt)

      ! Make density for atom "a"
      .atom(a).make_ED_grid(rho_a,pt)

      ! Make total density in "rho" with kappa factors
      rho_a = kappa(a)*rho_a
      rho = rho_a
      do i = 1,.n_atom
         if (i==a) cycle
         .atom(i).add_ED_grid(rho,pt,kappa(i))
      end

      where (rho>epsilon(ONE)); rho_a = rho_a/(rho*rho)
      elsewhere;                rho_a = ZERO
      end

      ! Make the derivative stockholder weight
      do c = 1,.n_atom

         .atom(c).make_ED_grid(rho_c,pt)

         grid(:,c) = -rho_a*rho_c

         if (c/=a) cycle
         where (rho>epsilon(ONE)) grid(:,c) = grid(:,c) + rho_c/rho

      end

      ! Clean
      rho.destroy
      rho_c.destroy; rho_a.destroy

   end

   make_d2_stockholder_atom_grid(grid,a,kappa,pt)
   ! Make the 2nd derivative scaled stockholder desity "grid" for the
   ! atom with index "a" and with scale parameters "kappa" using
   ! supplied points "pt".  This uses gaussian atomic densities.
      self :: IN
      grid :: MAT3{REAL}, OUT
      a  :: INT, IN
      kappa :: VEC{REAL}, IN
      pt :: MAT{REAL}, IN

   ENSURE(.atom.allocated,"no atoms")
   ENSURE(.atom.has_interpolators_any_kind,"missing atomic interpolators")
   ENSURE(grid.dim1==pt.dim1,"wrong dim1, grid")
   ENSURE(grid.dim2==.n_atom,"wrong dim2, grid")
   ENSURE(grid.dim3==.n_atom,"wrong dim3, grid")
   ENSURE(kappa.dim==.n_atom,"wrong size, kappa")

      rho_a,rho_c,rho_d,rho :: VEC{REAL}@
      n_pt,i,c,d :: INT

      ! Allocate temporary densities
      n_pt = grid.dim1
      rho_a.create(n_pt)
      rho_c.create(n_pt)
      rho_d.create(n_pt)
      rho.create(n_pt)

      ! Make density for atom "a"
      .atom(a).make_ED_grid(rho_a,pt)

      ! Make total density in "rho" with kappa factors
      rho_a = kappa(a)*rho_a
      rho = rho_a
      do i = 1,.n_atom
         if (i==a) cycle
         .atom(i).add_ED_grid(rho,pt,kappa(i))
      end

      where (rho>epsilon(ONE)); rho_a = TWO*rho_a/(rho*rho*rho)
      elsewhere;                rho_a = ZERO
      end

      where (rho>epsilon(ONE)); rho = ONE/(rho*rho)
      elsewhere;                rho = ZERO
      end

      ! Make the derivative stockholder weight
      do c = 1,.n_atom

         .atom(c).make_ED_grid(rho_c,pt)

         do d = 1,.n_atom

            .atom(d).make_ED_grid(rho_d,pt)

            grid(:,c,d) =  rho_a*rho_c*rho_d

            if (c==a) grid(:,c,d) = grid(:,c,d) - rho_d*rho
            if (d==a) grid(:,c,d) = grid(:,c,d) - rho_c*rho

         end

      end

      ! Clean
      rho.destroy
      rho_d.destroy; rho_c.destroy; rho_a.destroy

   end

end
