!===================================================================
!
! INTERPOLATOR: a table of a function of distance, looked up by the
! squared distance.
!
! The table is for a function that is steep near zero and falls away
! at large distance, such as a spherical atomic density. Its points
! are evenly spaced inside each power of two of the squared distance,
! ".octave_cells" to each power, so the cell a point lies in is read
! from the binary exponent and fraction of the number and no logarithm
! is taken; the core of a heavy atom and its tail are both resolved.
! The values are interpolated linearly, so a looked-up value lies
! between its two neighbours in the table. Below the first tabulated
! distance the value at zero is used; beyond the last, zero. The
! table ends where the function first falls below ".table_eps".
!
! To make one: set ".table_length" (the largest distance, bohr),
! ".table_eps" and ".octave_cells" if the defaults will not do; call
! .set_octave_points; evaluate the function at the square roots of
! ".data_point"; hand the values to .set_data_values; call .finalize.
! The caller evaluates the function, so no function is passed in and
! the table is made in pure code.
!
! Copyright (C) Dylan Jayatilaka, 2002
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!===================================================================
!

module INTERPOLATOR

   implicit none

contains

!  ==================
!  Allocation methods
!  ==================

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object and set defaults
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part :: leaky, PURE
   ! Destroy the pointer parts
      self :: INOUT
      .data_point.destroy
      .data_value.destroy
   end

   destroyed result (res) :: get_from(OBJECT), inlined_by_foo
   ! Returns true if self has *not* been created
      self :: PTR
      res :: BIN
   end

!  ===========
!  Set methods
!  ===========

   set_defaults :: PURE
   ! Set up a defaults
      self :: INOUT

      .table_length = INTERPOLATOR_TABLE_LENGTH
      .table_eps    = INTERPOLATOR_TABLE_EPS
      .octave_cells = INTERPOLATOR_OCTAVE_CELLS
      .octave_first = 0
      .n_data       = 0
      .data_point.destroy
      .data_value.destroy
      .finalized    = FALSE

   end

   set_table_length(length) :: PURE
   ! Set the largest distance tabulated, "length".
      self :: INOUT
      length :: REAL, IN

   ENSURE(length>ZERO,"the length must be positive")

      .table_length = length

   end

   set_table_eps(eps) :: PURE
   ! Set "eps", the value below which the tabulated function is taken
   ! to be zero: the table ends where the function first falls below it.
      self :: INOUT
      eps :: REAL, IN

   ENSURE(eps>ZERO,"the eps must be positive")

      .table_eps = eps

   end

   set_octave_cells(cells) :: PURE
   ! Set the number of table "cells" in each power of two of the
   ! squared distance.
      self :: INOUT
      cells :: INT, IN

   ENSURE(cells>0,"the number of cells must be positive")

      .octave_cells = cells

   end

   set_octave_points(r_min) :: leaky, PURE
   ! Set ".data_point" to the squared distances of the table. The first
   ! is zero. The rest start at or below the square of "r_min" (default
   ! 1e-6) and end at or above the square of ".table_length". Any
   ! values are discarded.
      self :: INOUT
      r_min :: REAL, optional, IN

   ENSURE(.table_length>ZERO,"table length must be +ve")

      first :: REAL
      n_octaves,m,i,j :: INT

      ! First and last powers of two
      first = 1.0d-6
      if (present(r_min)) first = r_min
      .octave_first = exponent(first*first)
      n_octaves = exponent(.table_length*.table_length) - .octave_first + 1
      m = .octave_cells

      ! The points
      .data_point.destroy
      .data_value.destroy
      .n_data = n_octaves*m + 2
      .data_point.create(.n_data)
      .data_point(1) = ZERO
      do i = 1,n_octaves
         do j = 0,m-1
            .data_point((i-1)*m+j+2) = set_exponent(HALF+HALF*j/m,.octave_first+i-1)
         end
      end
      .data_point(.n_data) = set_exponent(HALF,.octave_first+n_octaves)

      .finalized = FALSE

   end

   set_data_values(values) :: leaky, PURE
   ! Set the function "values" at the points. Call .finalize after.
      self :: INOUT
      values :: VEC{REAL}, IN

   ENSURE(values.dim==.n_data,"wrong size, values")

      .data_value.destroy
      .data_value.create(values.dim)
      .data_value = values
      .finalized = FALSE

   end

   finalize :: leaky, PURE
   ! End the table at the first value below ".table_eps", the function
   ! being taken to decrease from there on, and mark it ready to use.
      self :: INOUT

   ENSURE(.data_point.allocated," no data_point's")
   ENSURE(.data_value.allocated," no data_value's")
   ENSURE(.data_point.dim==.data_value.dim,"inconsistent data/value lengths")
   ENSURE(.data_point.dim>2,"not enough data_point's")

      n :: INT

      do n = 2,.n_data
         if (.data_value(n)<.table_eps) exit
      end
      n = min(n,.n_data)

      if (n<.n_data) then
         .n_data = n
         .data_point.shrink(n)
         .data_value.shrink(n)
      end

      .finalized = TRUE

   end

!  =======
!  Lookups
!  =======

   values_for(points,values,fac) :: PURE
   ! Set "values" to the table's values at the squared distances
   ! "points", times "fac" if present.
      self :: IN
      points :: VEC{REAL}, IN
      values :: VEC{REAL}, OUT
      fac :: REAL, optional, IN

      .octave_values_for(points,values,fac,add=FALSE)

   end

   add_values_for(points,values,fac) :: PURE
   ! Add to "values" the table's values at the squared distances
   ! "points", times "fac" if present.
      self :: IN
      points :: VEC{REAL}, IN
      values :: VEC{REAL}, INOUT
      fac :: REAL, optional, IN

      .octave_values_for(points,values,fac,add=TRUE)

   end

   value_for(point) result (res) :: PURE
   ! The table's value at the squared distance "point".
      self :: IN
      point :: REAL, IN
      res :: REAL

      pt,val :: VEC{REAL}(1)

      pt(1) = point
      .octave_values_for(pt,val,add=FALSE)
      res = val(1)

   end

   octave_values_for(points,values,fac,add) :: PURE, private
   ! Set "values" to the table's values at the squared distances
   ! "points", times "fac" if present; or add them to "values" if "add"
   ! is TRUE.
      self :: IN
      points :: VEC{REAL}, IN
      values :: VEC{REAL}, INOUT
      fac :: REAL, optional, IN
      add :: BIN, IN

   ENSURE(.finalized,"not finalized")
   ENSURE(values.dim==points.dim,"wrong size, values")

      first,last,q,t,b,v,scale :: REAL
      i,k,m,e0 :: INT

      scale = ONE
      if (present(fac)) scale = fac

      m     = .octave_cells
      e0    = .octave_first
      first = .data_point(2)
      last  = .data_point(.n_data)

      do i = 1,points.dim

         q = points(i)

         if (q>=last) then
            v = ZERO
         else if (q<first) then
            v = .data_value(1)
         else
            t = (TWO*fraction(q)-ONE)*m
            k = int(t)
            b = t - k
            k = (exponent(q)-e0)*m + k + 2
            v = .data_value(k) + b*(.data_value(k+1)-.data_value(k))
         end

         if (add) then; values(i) = values(i) + scale*v
         else;          values(i) = scale*v
         end

      end

   end

!  =======
!  Inquiry
!  =======

   last_data_point result (res)  :: PURE
   ! The largest squared distance in the table.
      self :: IN
      res :: REAL

   ENSURE(.finalized,"Not finalized")
   ENSURE(.n_data>0,"No data")
   ENSURE(.data_point.allocated,"No data")

      res = .data_point(.n_data)

   end

!  ============
!  Read methods
!  ============

   read_keywords :: get_from(OBJECT), recursive, leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) :: leaky
   ! Process command "keyword". Any required data needed by the "keyword" is
   ! inputted from "stdin". The table has one kind now; the keywords of
   ! the old kinds are read and ignored, so an old input still runs.
      self :: INOUT
      keyword :: STR
      word :: STR
      word = keyword
      word.to_lower_case
      select case (word)
         case ("}                    ")  ! exit case
         case ("octave_cells=        "); .read_octave_cells
         case ("put                  "); .put
         case ("table_eps=           "); .read_table_eps
         case ("table_length=        "); .read_table_length
         case ("units=               "); .read_units
         case ("domain_mapping=      ",  &
               "domain_scale_factor= ",  &
               "interpolation_method=",  &
               "n_data=              ",  &
               "range_mapping=       ",  &
               "table_origin=        ",  &
               "table_spacing=       ",  &
               "y1_initial=          ",  &
               "y1_final=            "); .read_and_ignore
         case default;         UNKNOWN(word)
      end
   end

   read_units :: get_from(OBJECT), private
   ! Read a string which describes the units to be used
   end

   read_octave_cells
   ! Read the number of cells in each power of two of the squared distance
      self :: INOUT
      cells :: INT
      stdin.read(cells)
      .set_octave_cells(cells)
   end

   read_table_length
   ! Read the largest distance tabulated
      self :: INOUT
      length :: REAL
      stdin.read_quantity(length)
      .set_table_length(length)
   end

   read_table_eps
   ! Read the value below which the function is taken to be zero
      self :: INOUT
      eps :: REAL
      stdin.read_quantity(eps)
      .set_table_eps(eps)
   end

   read_and_ignore
   ! Read one item and ignore it: a setting of the old table kinds.
      self :: INOUT
      word :: STR
      if (FALSE) self = self
      stdin.read(word)
   end

!  ====
!  Dump
!  ====

   do_dump :: private
   ! Dump all the components of "self". Called by dmp and dmpa.
      self :: IN

      stdout.dump("table_length",.table_length)
      stdout.dump("table_eps",.table_eps)
      stdout.dump("octave_cells",.octave_cells)
      stdout.dump("octave_first",.octave_first)
      stdout.dump("n_data",.n_data)
      stdout.dump("data_point",.data_point)
      stdout.dump("data_value",.data_value)
      stdout.dump("finalized",.finalized)

   end

   dump(object_name,all) :: get_from(OBJECT, TYPE?=>INTERPOLATOR)
   ! Dump "self" using "object_name" as the label for the object.
   end

   dmpa(object_name) :: get_from(OBJECT, TYPE?=>INTERPOLATOR)
   ! Dump "self" as part of an array, using "object_name" as the name
   end

!  ==============
!  Output methods
!  ==============

   put
   ! Put the table
      self :: IN

   ENSURE(.finalized,"not finalized")

      i :: INT

      stdout.flush
      stdout.text("INTERPOLATOR info")
      stdout.flush
      stdout.show("Table length                     =",.table_length)
      stdout.show("Table eps (smallest data value)  =",.table_eps)
      stdout.show("Cells in each power of two       =",.octave_cells)
      stdout.show("No. of interpolating data points =",.n_data)
      stdout.show("First squared distance           =",.data_point(2))
      stdout.show("Last squared distance            =",.data_point(.n_data))
      stdout.flush
      stdout.dash(int_fields=1,real_fields=2)
      stdout.put("#",int_width=TRUE)
      stdout.put("r^2")
      stdout.put("value")
      stdout.flush
      stdout.dash(int_fields=1,real_fields=2)
      do i = 1,.n_data
         stdout.put(i)
         stdout.put(.data_point(i))
         stdout.put(.data_value(i))
         stdout.flush
      end
      stdout.dash(int_fields=1,real_fields=2)

   end

   put_gnuplot(do_log10,to_angstrom)
   ! Put the table as two columns for gnuplot: the distance, in bohr or
   ! in Angstrom if "to_angstrom", and the value or its log10 if
   ! "do_log10".
      self :: IN
      do_log10    :: BIN, optional, IN
      to_angstrom :: BIN, optional, IN

   ENSURE(.data_point.allocated,"no data_point")
   ENSURE(.data_value.allocated,"no data_value")

      lg10,angstrom :: BIN
      r :: REAL
      i :: INT

      lg10 = FALSE
      if (present(do_log10)) lg10 = do_log10
      angstrom = FALSE
      if (present(to_angstrom)) angstrom = to_angstrom

      if (angstrom) then; stdout.text("# distance/Angstrom")
      else;               stdout.text("# distance/bohr")
      end
      if (lg10) stdout.text("# log10(values)")

      do i = 1,.n_data
         r = sqrt(.data_point(i))
         if (angstrom) r = r.to_units("angstrom")
         stdout.put(r)
         if (lg10) then; stdout.put(log10(.data_value(i)))
         else;           stdout.put(.data_value(i))
         end
         stdout.flush
      end

   end

end
