module TABLE_COLUMN

   implicit none

   std_table_column  :: TABLE_COLUMN@, public

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object and set defaults
   end

   create_std_table_column :: selfless
   ! Create an object

      std_table_column.destroy
      std_table_column.create

   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   clear_column :: leaky, PURE
   ! Destroy the pointer parts, only if created
      self :: INOUT

      .b_values.destroy ! leaky
      .i_values.destroy
      .r_values.destroy
      .e_values.destroy
      .s_values.destroy
      .iv_values.destroy
      .rv_values.destroy
      .sv_values.destroy

   end

!  ============
!  Set routines
!  ============

   set_defaults :: PURE
   ! Set up defaults
      self :: INOUT

      ! Set some defaults from stdout
      if (stdout.allocated) then
         .width          = stdout.style.real_width
         .real_precision = stdout.style.real_precision
      end

   end

   set_heading(val) :: PURE
   ! Set the heading
      self :: INOUT
      val :: STR, IN

      .heading = val
      .set_width_from(.heading)

   end

   set_subheading(val) :: PURE
   ! Set the subheading
      self :: INOUT
      val :: STR, IN

      .subheading = val
      .set_width_from(.subheading)

   end

   set_subhead(val) :: PURE
   ! Set the subheading
      self :: INOUT
      val :: STR, IN

      .set_subheading(val)

   end

   set_sb3head(val) :: PURE
   ! Set the sub3 heading
      self :: INOUT
      val :: STR, IN

      .sb3heading = val
      .set_width_from(.sb3heading)

   end

   set_real_precision(val) :: PURE
   ! Set the real precision
      self :: INOUT
      val :: INT, IN

! ENSURE(val>0,"real_precision must be positive")
   ENSURE(val<.width,"real_precision must be less than column width")

      .real_precision = max(val,0)

   end

   set_real_fortran_fmt(val) :: PURE
   ! Set the fortran format style string
   ! WARNING: Auto-width won't work, always set width explicity
      self :: INOUT
      val :: STR, IN
      .real_fortran_fmt = val
   end

   set_max_cp(val) :: PURE
   ! Set the maximum closing parenthesis position, for imprecise real
      self :: INOUT
      val :: INT, IN

   ENSURE(val<.width,"max_cp must be less than column width")

      .max_cp = max(val,0)

   end

   set_e_under_r(val) :: PURE
   ! Set whether to print the error value under the real.
   ! In the case errors are not shown as parentheses.
      self :: INOUT
      val :: BIN, IN

      .e_under_r = val

   end

   set_two_digit_error(val) :: PURE
   ! Set whether toalways use two-digit errors for more precision.
      self :: INOUT
      val :: BIN, IN

      .two_digit_error = val

   end

   set_column_spacing(val) :: PURE
   ! Set the free space within each column width
      self :: INOUT
      val :: INT, IN

   ENSURE(val>=0,"column_spacing must be non-negative")
   ENSURE(NOT .width_set,"set column_spacing before width or heading")

      .column_spacing = val

   end

   set_list_item_spacing(val) :: PURE
   ! Set the free space between items in a list-item column
      self :: INOUT
      val :: INT, IN

   ENSURE(val>=0,"spacing must be non-negative")
   ENSURE(NOT .width_set,"set spacing before width or heading")

      .list_item_spacing = val

   end

   set_spacer(val) :: PURE
   ! Set the space character between each column
      self :: INOUT
      val :: STR, IN

      .spacer = val

   end

   set_center(val) :: PURE
   ! Set whether to center a STR column
      self :: INOUT
      val :: BIN, IN

      .center = val

   end

   set_left_justify(val) :: PURE
   ! Set whether to left-justify a column
      self :: INOUT
      val :: BIN, IN

      .left_justify = val

   end

   set_left(val) :: PURE
   ! Set whether to left-justify a column
      self :: INOUT
      val :: BIN, IN

      .left_justify = val

   end

   set_list_as_column(val) :: PURE
   ! Set whether to put a list-of-lists as a column, one-per-line.
   ! NOTE: this can only be set when the list is the last column.
      self :: INOUT
      val :: BIN, IN

      .list_as_column = val

   end

   set_width_set(val) :: PURE
   ! Set whether width was set.
      self :: INOUT
      val :: BIN, IN

      .width_set = val

   end

   set_width(val) :: PURE
   ! Set the column width to be the maximum of what it was and "val"
   ! If headings are set, take into account those widths too.
      self :: INOUT
      val :: INT, IN

      if (.width_set) then; .width = max(.width,val)
      else;                 .width = val
      end

      .width_set = TRUE

   end

   force_width(val) :: PURE
   ! Force set the column width to be "val"
      self :: INOUT
      val :: INT, IN

      .width = val
      .width_set = TRUE

   end

   set_auto_width(val) :: PURE
   ! Set whether to use automatic widths
      self :: INOUT
      val :: BIN, IN

      .auto_width = val

   end

   set_item_width(val) :: PURE
   ! Set the list item width
      self :: INOUT
      val :: INT, IN

      if (.item_width_set) then; .item_width = max(.item_width,val)
      else;                      .item_width = val
      end

      .item_width_set = TRUE

   end

! =========================
! Set column width (scalar)
! =========================

! Non-real ...

   set_width_from(val) :: template, PURE
   ! Set width from the width of scalar value "val"
      self :: INOUT
      val :: VAL?, IN

      wid :: INT

      val.get_str_length(wid,.column_spacing)
      .set_width(wid)

   end

   set_width_from(val) :: get_from(TABLE_COLUMN, VAL?=>BIN), PURE
   ! Set width from the width of scalar value "val"
   end

   set_width_from(val) :: get_from(TABLE_COLUMN, VAL?=>INT), PURE
   ! Set width from the width of scalar value "val"
   end

   set_width_from(val) :: get_from(TABLE_COLUMN, VAL?=>STR), PURE
   ! Set width from the width of scalar value "val"
   end

! Real ...

   set_width_from(val) :: PURE
   ! Set width from the width of the REAL value "val".
      self :: INOUT
      val :: REAL, IN
      wid :: INT

      val.get_str_length_maxdp(wid,.real_precision,.column_spacing)
      .set_width(wid)

   end

! =========================
! Set column width (arrays)
! =========================

   set_width_automatically :: PURE
   ! Set width automatically from the column values
      self :: INOUT

      valtyp :: STR

      valtyp = .value_type_to_output

      ! Cases
      select case (valtyp)
      case ("bin        "); .set_width_from(.b_values)
      case ("int        "); .set_width_from(.i_values)
      ! A value-with-error column must derive its layout from the (value,error)
      ! PAIRS, not from the errors alone: only the pair version works out the
      ! decimal places "mdp" and the closing-brace position "mcb", and sets
      ! .real_precision and .max_cp from them. The errors-only version sets the
      ! width and nothing else, leaving .real_precision at whatever it happened
      ! to hold -- and since .real_precision is handed to every cell as its
      ! "max_dp" (see put_value), the whole column's precision was effectively
      ! undefined. That is the longstanding "zero(error) problem": cells with an
      ! exactly-zero error take dp = max_dp, so they printed a stale precision
      ! that differed from the rest of the column and even between platforms
      ! (0.000000(0) on Linux vs 0.00(0) on macOS, with the requested
      ! real_precision being 4 on both).
      case ("real(error)"); .set_width_from(.r_values,.e_values)
      case ("real       "); .set_width_from(.r_values)
      case ("real-over  "); .set_width_from(.r_values) ! Handle outside
      case ("error-under"); .set_width_from(.e_values) ! with coltype
      case ("str        "); .set_width_from(.s_values)
      end ! case

   end

! Arrays of non-real ...

   set_width_from(v) :: template, PURE
   ! Set width from the maximum width of values in array "v"
      self :: INOUT
      v :: V?, IN

      wid :: INT

      v.get_max_str_length(wid,.column_spacing)
      .set_width(wid)

   end

   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{BIN}), PURE
   ! Set width from the maximum width of values in array "v"
   end

   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{INT}), PURE
   ! Set width from the maximum width of values in array "v"
   end

   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{STR}), PURE
   ! Set width from the maximum width of values in array "v"
   end

! Arrays of real ...

   set_width_from(v) :: template, PURE
   ! Set width from the maximum width of REALs in array "v"
      self :: INOUT
      v :: V?, IN

      wid :: INT

      v.get_max_str_length(wid,.real_precision,.column_spacing)
      .set_width(wid)

   end

   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{REAL}), PURE
   ! Set width from the maximum width of REALs in array "v"
   end

   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>MAT{REAL}), PURE
   ! Set width from the maximum width of REALs in array "v"
   end

! Real with errors ...

   set_width_from(r,e) :: PURE
   ! Set width from the width of value "r" and its error "e".
   ! Also set the precision.
      self :: INOUT
      r,e :: REAL, IN

      wid,dp, de,le,pad :: INT
      valtyp :: STR

      valtyp = .value_type_to_output

      if (valtyp=="real-over") then

         .set_defaults

      else

         ! Get width & precision
         r.get_str_length_align(e,wid,dp,de,le,pad,.real_precision)
        
         ! Set width & precision
         .set_width(wid+.column_spacing)
         .set_real_precision(dp)

      end

   end

! Arrays of real with errors ...

   set_width_from(r,e) :: PURE
   ! Set width from the maximum  width of value "r" and its error "e".
   ! Also set the precision.
      self :: INOUT
      r,e :: VEC{REAL}, IN

      msl,mdp,mcb,mcc :: INT
      valtyp :: STR

      valtyp = .value_type_to_output

      if (valtyp=="real-over") then

         .set_defaults

      else

         ! Get max width & precision & closing bracket
         r.get_max_str_length(msl,mdp,mcc,e,.real_precision)
         r.get_max_str_length(msl,mdp,mcb,e,.real_precision,max_cb=mcc,two_digit_error=.two_digit_error)
        
         ! Set 
         .set_width(msl+.column_spacing)
         .set_real_precision(mdp)
         .set_max_cp(mcb)

      end

   end

! List of lists VEC{EVEC{TYPE}} of non-real ...  

   set_width_from(v) :: template, PURE
   ! Set width from the width of list-of-lists value(s) in "v"
      self :: INOUT
      v :: V?, IN

      vid :: INT
      wid :: INT

      vid = v.item_str_length

      wid = vid
      wid = wid + .list_item_spacing
      .set_item_width(wid)

      wid = wid*min(.n_list_fields,v.max_element_dim)
      wid = wid + .column_spacing
      .set_width(wid)

   end
   
   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{EVEC{INT}}), PURE
   ! Set width from the width of list-of-lists value(s) in "v"
   end
   
   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{EVEC{REAL}}), PURE
   ! Set width from the width of list-of-lists value(s) in "v"
   end

   set_width_from(v) :: get_from(TABLE_COLUMN, V?=>VEC{EVEC{STR}}), PURE
   ! Set width from the width of list-of-lists value(s) in "v"
   end

! =================
! Set column values
! =================

   set_values(v,auto) :: template
   ! Set the column values "v"
      self :: INOUT
      v    :: V?, IN
      auto :: BIN, optional, IN

   DIE_IF(.values_set,"column has already been set!")

      flex :: BIN

      .VALUES? = v

      ! Auto adjust width?
      flex = TRUE
      if (present(auto)) flex = auto
      if (flex) .set_width_from(v)

   end

   set_values(v,auto) :: get_from(TABLE_COLUMN, V?=>VEC{BIN}, VALUES?=>b_values)
   ! Set the column values "v"
   end

   set_values(v,auto) :: get_from(TABLE_COLUMN, V?=>VEC{INT}, VALUES?=>i_values)
   ! Set the column values "v"
   end

   set_values(v,auto) :: get_from(TABLE_COLUMN, V?=>VEC{REAL}, VALUES?=>r_values)
   ! Set the column values "v"
   end

   set_values(v,auto) :: get_from(TABLE_COLUMN, V?=>VEC{EVEC{INT}}, VALUES?=>iv_values)
   ! Set the column values "v"
   end

   set_values(v,auto) :: get_from(TABLE_COLUMN, V?=>VEC{EVEC{REAL}}, VALUES?=>rv_values)
   ! Set the column values "v"
   end

   set_values(v,auto) :: get_from(TABLE_COLUMN, V?=>VEC{EVEC{STR}}, VALUES?=>sv_values)
   ! Set the column values "v"
   end

   set_values(v)
   ! Set the column values "v"
      self :: INOUT
      v :: VEC{STR}(len=STR_SIZE,:), IN

   DIE_IF(.values_set,"column has already been set!")

      .s_values = v
      .set_width_from(v)

   end

   set_values_and_errors(r,e) 
   ! Set the column values "r" and errors "e"
      self :: INOUT
      r,e :: VEC{REAL}, IN

   DIE_IF(.values_set,"column has already been set!")

      .r_values = r
      .e_values = e
      .set_width_from(r,e)

   end

!  ================
!  Inquiry routines
!  ================

   values_set result (res) :: pure
   ! Return true if any column has been set
      self :: IN
      res :: BIN
      res =  .b_values.allocated &
         OR  .i_values.allocated &
         OR  .r_values.allocated &
         OR  .s_values.allocated &
         OR .iv_values.allocated &
         OR .rv_values.allocated &
         OR .sv_values.allocated 
   end

! This is very important

   value_type_to_output(coltype) result (res) :: pure
   ! Return a string "res" describing kind of value to be printed.
   ! Normally the value printed is related to "X" if .X_values is set.
   ! If "coltype" is present (and equal to "error") then "res" is:
   !  . "error-under" ... for a error value like 0.00693 if there
   ! If "coltype" is NOT present then "res" is:
   !  . "real(error)" ... for a value printed like 1.234(7)
   !  . "real-over"   ... for a real value like  1.23456 with error 
   !                      to be printed below as 0.00693
      self :: IN
      coltype :: STR, optional, IN
      res :: STR

      res = "none"

      if (present(coltype)) then
         ! ENSURE(coltype=="error","coltype is not 'error'")
         if (.may_be_e_under_column)  then; res = "error-under"
         else;                              res = "blank"
         end
      else if (.b_values.allocated)   then; res = "bin"
      else if (.i_values.allocated)   then; res = "int"
      else if (.may_be_an_re_column)  then; res = "real(error)"
      else if (.may_be_r_over_column) then; res = "real-over"
      else if (.r_values.allocated)   then; res = "real"
      else if (.s_values.allocated)   then; res = "str"
      else if (.iv_values.allocated)  then; res = "int-list"
      else if (.rv_values.allocated)  then; res = "real-list"
      else if (.sv_values.allocated)  then; res = "str-list"
      end

   end

   may_be_e_under_column result (res) :: elemental
   ! Return TRUE if self has e_values allocated, and 
   !    e_under_r is TRUE.
   ! It really is an "error-under" column if .value_type_to_output 
   ! is called *with* the "coltype" option.
      self :: IN
      res :: BIN
      res = .e_values.allocated AND .e_under_r
   end

   may_be_r_over_column result (res) :: pure
   ! Return TRUE if self has r_values, and 
   !    e_under_r is TRUE. 
   ! It really is a "real-over" column if .value_type_to_output 
   ! is called *without* the "coltype" option.
      self :: IN
      res  :: BIN
      res = .r_values.allocated AND .e_under_r
   end

   may_be_an_re_column result (res) :: pure
   ! Return TRUE if self has r_values, e_values, and 
   !    e_under_r is FALSE. 
   ! It definitely is an "real(error)" column if .value_type_to_output 
   ! is called *without* the "coltype".
      self :: IN
      res  :: BIN
      res = .r_values.allocated AND .e_values.allocated AND NOT .e_under_r
   end

   n_rows result (res) :: pure
   ! Returns the number of rows.
   ! NOTE: if the error column is printed, this may not correspond
   ! to the actual number of outputted rows, because the error may be
   ! wriiten underneath the real value.
      self :: IN
      res :: INT

   ! ENSURE(.values_set,"column not set")

      res = 0
      if      ( .b_values.allocated)  then; res =  .b_values.dim
      else if ( .i_values.allocated)  then; res =  .i_values.dim
      else if ( .r_values.allocated)  then; res =  .r_values.dim
      else if ( .s_values.allocated)  then; res =  .s_values.dim
      else if (.iv_values.allocated)  then; res = .iv_values.dim
      else if (.rv_values.allocated)  then; res = .rv_values.dim
      else if (.sv_values.allocated)  then; res = .sv_values.dim
      end

   end

!  ============
!  I/O Routines
!  ============

   read_keywords :: get_from(OBJECT), recursive, leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) :: leaky
   ! Process command "keyword". Any required data needed by the "keyword" is
   ! inputted from "stdin".
      self :: INOUT
      keyword :: STR, IN

      word :: STR

      word = keyword
      word.to_lower_case

      select case (word)
      case ("}                 ")  ! exit case
      case ("column_spacing=   "); .read_column_spacing
      case ("error_under_value="); .read_su_under_value
      case ("list_item_spacing="); .read_list_item_spacing
      case ("real_precision=   "); .read_real_precision
      case ("su_under_value=   "); .read_su_under_value
      case ("two_digit_error=  "); .read_two_digit_error
      case  default;               UNKNOWN(word)
      end

   end

   read_column_spacing
   ! Read space to apply between columns
      self :: INOUT

      val :: INT

      stdin.read(val)
      .set_column_spacing(val)

   end

   read_list_item_spacing
   ! Read spacing to apply between list-of-items column
      self :: INOUT

      val :: INT

      stdin.read(val)
      .set_list_item_spacing(val)

   end

   read_real_precision
   ! Read the number of decimal places for rea number output
      self :: INOUT

      val :: INT

      stdin.read(val)
      .set_real_precision(val)

   end

   read_su_under_value
   ! Read whether to priunt su's under tha colum value.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_e_under_r(val)

   end

   read_two_digit_error
   ! Read whether to always use two-digit errors for imprecise real
   ! output.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_two_digit_error(val)

   end

!  ============
!  Put routines
!  ============

   put_heading
   ! Put the column heading out
      self :: IN

      if (.spacer/=" ") stdout.put(trim(.spacer))

      stdout.put(.heading,center=.center,left=.left_justify,width=.width)

   end

   put_subheading
   ! Put the column subheading out
      self :: IN

      if (.spacer/=" ") stdout.put(trim(.spacer))
      stdout.put(.subheading,center=.center,left=.left_justify,width=.width)

   end

   put_sb3heading
   ! Put the column subheading out
      self :: IN

      if (.spacer/=" ") stdout.put(trim(.spacer))
      stdout.put(.sb3heading,center=.center,left=.left_justify,width=.width)

   end

! This is the main procedure

   put_value(i,coltype)
   ! Put out the value "i" in the column; it is normally of type 
   ! "X" if .X_values is allocated, except i "coltype" is present 
   ! and equal to "error"
      self :: IN
      i    :: INT, IN
      coltype :: STR, optional, IN

   ENSURE(.values_set,"column not set")
   ENSURE(i.is_in_range([1,.n_rows]),"column index i out of range")
   ENSURE(present(coltype) EQV coltype=="error","if used, coltype must be 'error'")

      margin  :: INT
      fields  :: INT
      n_block :: INT
      dim,s,f :: INT
      w,p,b,j :: INT
      l,c     :: BIN
      valtyp  :: STR
      m       :: STR


      ! Widths & centering
      w = .width
      p = .real_precision
      m = .real_fortran_fmt
      l = .left_justify
      c = .center

      ! Put the spacer
      if (.spacer/=" ") stdout.put(trim(.spacer))

      ! Value type to be printed
      valtyp = .value_type_to_output(coltype)

      ! Cases
      select case (valtyp)
      case ("blank      "); stdout.put(" ",width=w,blank=TRUE)       ! Output a blank
      case ("bin        "); stdout.put(.b_values(i),left=l,center=c,width=w)
      case ("int        "); stdout.put(.i_values(i),left=l,center=c,width=w)
      case ("real(error)")                                           ! Default
      stdout.put(.r_values(i),.e_values(i),width=w,precision=p,max_cb=.max_cp,d2_err=.two_digit_error) 
      case ("real       ") 
      stdout.put(.r_values(i),left=l,center=c,width=w,precision=p,fmt=m) 
      case ("real-over  "); stdout.put(.r_values(i),left=l,center=c) ! Handle outside
      case ("error-under"); stdout.put(.e_values(i),left=l,center=c) !   with coltype
      case ("str        "); stdout.put(.s_values(i),left=l,center=c,width=w)
      case ("int-list   ") ! VEC{INT}
         if (.list_as_column) then
            stdout.put(" ",width=.column_spacing)
            margin = stdout.buffer.item_end
            do j = 1,.iv_values(i).element.dim
               if (j>1) then
                  stdout.flush
                  stdout.tab(width=margin)
               end
               stdout.put(.iv_values(i)[j],left=l,center=c,width=.item_width)
            end
         else
            dim     = .iv_values(i).element.dim
            fields  = .n_list_fields
            n_block = int((dim-0.1)/fields) + 1
            stdout.put(" ",width=.column_spacing)
            margin  = stdout.buffer.item_end ! save margin
            do b = 1,n_block
               s = 1 + fields*(b-1)
               f = min(s+fields-1,dim)
               if (b>1) then
                  stdout.flush
                  stdout.tab(width=margin)
               end
               do j = s,f
                  stdout.put(.iv_values(i)[j],left=l,center=c,width=.item_width)
               end
            end
         end

      case ("real-list  ") ! VEC{REAL}
         if (.list_as_column) then
            stdout.put(" ",width=.column_spacing)
            margin = stdout.buffer.item_end
            do j = 1,.rv_values(i).element.dim
               if (j>1) then
                  stdout.flush
                  stdout.tab(width=margin)
               end
               stdout.put(.rv_values(i)[j],left=l,center=c,width=.item_width)
            end
         else
            dim     = .rv_values(i).element.dim
            fields  = .n_list_fields
            n_block = int((dim-0.1)/fields) + 1
            stdout.put(" ",width=.column_spacing)
            margin  = stdout.buffer.item_end ! save margin
            do b = 1,n_block
               s = 1 + fields*(b-1)
               f = min(s+fields-1,dim)
               if (b>1) then
                  stdout.flush
                  stdout.tab(width=margin)
               end
               do j = s,f
                  stdout.put(.rv_values(i)[j],left=l,center=c,width=.item_width)
               end
            end
         end

      case ("str-list") ! VEC{STR}
         if (.list_as_column) then
            stdout.put(" ",width=.column_spacing)
            margin = stdout.buffer.item_end
            do j = 1,.sv_values(i).element.dim
               if (.sv_values(i)[j]==" ") cycle
               if (j>1) then
                  stdout.flush
                  stdout.tab(width=margin)
               end
               stdout.put(.sv_values(i)[j],left=l,center=c,width=.item_width)
            end
         else
            dim     = .sv_values(i).element.dim
            fields  = .n_list_fields
            n_block = int((dim-0.1)/fields) + 1
            stdout.put(" ",width=.column_spacing)
            margin  = stdout.buffer.item_end ! save margin
            do b = 1,n_block
               s = 1 + fields*(b-1)
               f = min(s+fields-1,dim)
               if (b>1) then
                  stdout.flush
                  stdout.tab(width=margin)
               end
               do j = s,f
                  stdout.put(.sv_values(i)[j],left=l,center=c,width=.item_width)
               end
            end
         end


      end ! case

   end

end
