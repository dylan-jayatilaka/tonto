module CSF_TO_SD

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part :: leaky, PURE
   ! Destroy the pointer parts of self
      self :: INOUT

      .CSF_graph.destroy
      .SD_graph.destroy

   end

!  ===========================
!  Set defaults, reset, update
!  ===========================

   update :: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT
   
   ENSURE(.n_e>1, "n_e must be > 1")

      n :: INT

      n = .n_e

      .CSF_graph.create(0,n,0,n)
      .SD_graph.create(0,n,0,n)

      .make_graph(.CSF_graph)

   end

   set_defaults :: leaky, PURE
   ! Set default SCF data values
      self  :: INOUT

   end

   set_n_e(val) :: PUREr
   ! Set number of electrons.
      self :: INOUT
      val  :: INT, IN

   ENSURE(val>0,"n_evals must be +ve")

      .n_e = val

   end

   set_n_up(val) :: PURE
   ! Set the number of "up couplings"
      self :: INOUT
      val  :: INT, IN

   ENSURE(val>0,"n_keep must be +ve")

      .n_up = val

   end

!  =============
!  Input methods
!  =============

   read_keywords :: get_from(OBJECT), recursive, leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) :: leaky
   ! Process a command "keyword". Data is inputted from "stdin", unless
   ! "word" is a sequence of blank separated strings. In this case,
   ! the sequence is processed as if it were a separate file.
      self :: INOUT
      keyword :: STR, IN

      word :: STR
      die  :: BIN

      word = keyword
      word.to_lower_case

      select case (word)

      case ("n_e=    "); .read_n_e
      case ("n_up=   "); .read_n_up
      case default;            UNKNOWN(word)
      end

   end


   docu_help :: selfless, private
   ! Documentation.

      stdout.flush
      stdout.flush
      stdout.text("==================")
      stdout.text("Help for CSF_TO_SD")
      stdout.text("==================")

      DIE("end of help documentation")

   end

! N

   docu_n_e(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("n_e= INT    [0]")
      stdout.flush
      stdout.text(". The number of electrons in the CSF or Slater determinant")
      if (present(die)) stop
   end

   read_n_e :: get_from(OBJECT:read_and_set, VAL_TYPE?=>INT, SET?=>.set_n_e), private
   ! Generic read and set
   end

   docu_n_up(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.text("n_up= INT    [0]")
      stdout.flush
      stdout.text(". The number of 'up coupled' electrons in the CSF")
      if (present(die)) stop
   end

   read_n_up :: get_from(OBJECT:read_and_set, VAL_TYPE?=>INT, SET?=>.set_n_up), private
   ! Generic read and set
   end

!  ===============
!  Make the graphs
!  ===============

   make_graph(G) :: leaky, PURE
   ! Make Olsen's CSF graph "G".
   ! Note: is zero- dimensioned
      self :: INOUT
      G :: MAT{INT}@, INOUT

      n :: INT

      n = .n_e

      G = 0

   end

end
