!---------------------------------------------------------------------------
!
! CELL_MAP: a density of the unit cell held as its Fourier coefficients,
! and the maps made from it.
!
! The coefficients are structure factors already expanded over the whole
! sphere of reciprocal space, on absolute scale and divided by the cell
! volume, so that the density at a point r is the real part of
!
!    rho(r) = sum_n coeff(n) exp(-i q_n.r),   q_n = 2 pi B h_n,
!
! with B the reciprocal cell matrix and h_n the Miller indices of
! reflection n. CRYSTAL:make_cell_map fills the object from diffraction
! data; this module only holds the coefficients and sums the series.
! It holds no crystal, atoms or plot grid: those are passed in.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!
!---------------------------------------------------------------------------

module CELL_MAP

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object and set defaults
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part :: leaky, PURE
   ! Destroy the pointer parts
      self :: INOUT

      .h1.destroy
      .h2.destroy
      .h3.destroy
      .coeff.destroy
      .F_pro.destroy
      .atom_tags.destroy
      .axes.destroy_ptr_part

   end

!  ===
!  Set
!  ===

   set_defaults :: leaky, PURE
   ! Set the defaults: a residual map, no angular filter, the cartesian frame
      self :: INOUT

      .kind         = "residual"
      .l_value      = -1
      .m_value      = -99
      .m_maps       = "auto"
      .window_width = 0.25*BOHR_PER_ANGSTROM
      .moment_kind  = "gaussian"
      .sharpen_U    = ZERO
      .sharpen_order   = 0
      .laplacian_order = 0
      .wiener_weight   = FALSE
      .fill_missing    = FALSE
      .in_sigma_units  = FALSE
      .use_FFT         = FALSE
      .fft_sampling    = 6
      .l_max        = 2
      .axes.set_defaults
      .n_radii      = 40
      .radius_max   = 2*BOHR_PER_ANGSTROM
      .volume       = ZERO
      .reciprocal_mx = ZERO
      .direct_mx    = ZERO
      .density_source = "wavefunction"
      .atom_weight    = "hirshfeld"

   end

   set_m_value(m) :: pure
   ! Set the component of a local-moment map; -99 for the norm over m
      self :: INOUT
      m :: INT, IN

      .m_value = m

   end

   writes_all_m result (res) :: pure
   ! TRUE if a plot of the local moment writes every m component and the
   ! norm: m_maps= all, or by default when axes are given, unless m_value
   ! picks one component. l = 0 has one component and is never split.
      self :: IN
      res :: BIN

      res = .l_value>=1 AND .m_value==-99 &
        AND (.m_maps=="all" OR (.m_maps=="auto" AND NOT .axes.is_cartesian))

   end

   set_kind(kind) :: PURE
   ! Set the "kind" of density the coefficients describe
      self :: INOUT
      kind :: STR, IN

      .kind = kind
      .kind.to_lower_case

   ENSURE(.kind_is_known, "unknown kind: "//trim(.kind))

   end

   kind_is_known result (res) :: pure
   ! Return TRUE if ".kind" is one CRYSTAL:make_cell_map can make
      self :: IN
      res :: BIN

      select case (.kind)
      case ("deformation_calc"); res = TRUE
      case ("deformation_exp "); res = TRUE
      case ("f_calc          "); res = TRUE
      case ("f_exp           "); res = TRUE
      case ("residual        "); res = TRUE
      case default;              res = FALSE
      end

   end

   is_deformation_kind result (res) :: pure
   ! Return TRUE if ".kind" subtracts the promolecule, so that the
   ! promolecule structure factors must be set first
      self :: IN
      res :: BIN

      res = .kind=="deformation_calc" OR .kind=="deformation_exp"

   end

   set_promolecule_F(F) :: leaky, PURE
   ! Take "F", the promolecule structure factors of the unique reflections,
   ! in the model's conventions (the same positions, ADPs and phase
   ! convention as F_calc), for the deformation kinds
      self :: INOUT
      F :: VEC{CPX}, IN

      .F_pro.destroy
      .F_pro.create(F.dim)
      .F_pro = F

   end

   set_cell(unit_cell) :: PURE
   ! Take the reciprocal cell matrix and the volume from "unit_cell"
      self :: INOUT
      unit_cell :: UNIT_CELL, IN

   ENSURE(unit_cell.volume>ZERO, "unit cell has no volume")

      .reciprocal_mx = unit_cell.reciprocal_mx
      .direct_mx     = unit_cell.direct_mx
      .volume        = unit_cell.volume

   end

   set_coefficients(h1,h2,h3,coeff) :: leaky, PURE
   ! Take the Miller indices "h1", "h2", "h3" and the coefficients "coeff",
   ! one per reflection over the whole sphere and on absolute scale. The
   ! coefficients are divided by the cell volume here, so set_cell must
   ! have been called first.
      self :: INOUT
      h1,h2,h3 :: VEC{INT}, IN
      coeff    :: VEC{CPX}, IN

   ENSURE(.volume>ZERO, "set the cell first")
   ENSURE(h1.dim==coeff.dim, "h1: wrong dim")
   ENSURE(h2.dim==coeff.dim, "h2: wrong dim")
   ENSURE(h3.dim==coeff.dim, "h3: wrong dim")

      ! Only the coefficient arrays: the settings and the promolecule stay.
      ! Assignment reallocates each to the size of the new arrays.
      .h1 = h1
      .h2 = h2
      .h3 = h3
      .coeff = coeff/.volume

   end

   set_coefficient_sigmas(sigma,source) :: leaky, PURE
   ! Take "sigma", the standard deviation of each coefficient as a complex
   ! number: the coefficient its measured reflection would give with |F|
   ! replaced by F_sigma, with the symmetry phase, multiplicity and site
   ! factor of the expansion; and "source", the measured reflection each
   ! coefficient comes from, 0 for F(000). Copies of one measurement have
   ! the same error; different measurements independent ones. In the order
   ! and on the scale given to set_coefficients; divided by the cell volume
   ! here, as the coefficients are.
      self :: INOUT
      sigma :: VEC{CPX}, IN
      source :: VEC{INT}, IN

   ENSURE(.volume>ZERO, "set the cell first")
   ENSURE(.coeff.allocated, "set the coefficients first")
   ENSURE(sigma.dim==.coeff.dim, "sigma: wrong dim")
   ENSURE(source.dim==.coeff.dim, "source: wrong dim")

      .coeff_sigma = sigma/.volume
      .coeff_source = source

   end

!  =======
!  Inquiry
!  =======

   n_reflections result (res) :: pure
   ! The number of reflections held, over the whole sphere
      self :: IN
      res :: INT

      if (.coeff.allocated) then; res = .coeff.dim
      else;                       res = 0
      end

   end

   electron_count result (res) :: PURE
   ! The integral of the density over the cell: the real part of the
   ! coefficient of (0,0,0) times the volume. Zero for a map with no
   ! (0,0,0) term, such as a residual map.
      self :: IN
      res :: REAL

   ENSURE(.coeff.allocated, "no coefficients")

      n :: INT

      res = ZERO
      do n = 1,.coeff.dim
         if (.h1(n)/=0 OR .h2(n)/=0 OR .h3(n)/=0) cycle
         res = res + REALIFY(.coeff(n))*.volume
      end

   end

!  ====
!  Maps
!  ====

   make_scattering_vectors(q) :: PURE
   ! Set row n of "q" to the scattering vector 2 pi B h_n of reflection n,
   ! in cartesian coordinates, with B the reciprocal cell matrix.
      self :: IN
      q :: MAT{REAL}, OUT

   ENSURE(.coeff.allocated, "no coefficients")
   ENSURE(q.dim1==.coeff.dim, "q: wrong dim1")
   ENSURE(q.dim2==3, "q: wrong dim2")

      h :: VEC{REAL}(3)
      n :: INT

      do n = 1,.coeff.dim
         h = [.h1(n),.h2(n),.h3(n)]
         q(n,:) = 2*PI*matmul(.reciprocal_mx,h)
      end

   end

   make_values_at(values,pts) :: leaky, PURE
   ! Set "values" to the density at the cartesian points "pts", one row
   ! per point, by summing the Fourier series at each point.
      self :: IN
      values :: VEC{REAL}, OUT
      pts    :: MAT{REAL}, IN

   ENSURE(.coeff.allocated, "no coefficients")
   ENSURE(values.dim==pts.dim1, "values: wrong dim")
   ENSURE(pts.dim2==3, "pts: wrong dim2")

      q :: MAT{REAL}@

      q.create(.coeff.dim,3)
      .make_scattering_vectors(q)

      .sum_series_at(values,q,.coeff,pts)

      q.destroy

   end

   make_blurred_values_at(values,pts) :: leaky, PURE
   ! Set "values" to the density seen through the Gaussian window of width
   ! ".window_width" at the cartesian points "pts", one row per point: the
   ! series with every coefficient damped by exp(-sigma^2 q^2/2), which is
   ! sqrt(4 pi) times the l = 0 local moment; with ".window_width" zero, the
   ! raw density. It is the density the Hirshfeld atoms are expanded from:
   ! a window makes them comparable with the local moments and damps the
   ! series-termination ripple, but blurs charge between atoms, so their
   ! populations are best taken with none.
      self :: IN
      values :: VEC{REAL}, OUT
      pts    :: MAT{REAL}, IN

   ENSURE(.coeff.allocated, "no coefficients")
   ENSURE(values.dim==pts.dim1, "values: wrong dim")
   ENSURE(pts.dim2==3, "pts: wrong dim2")
   ENSURE(.window_width>=ZERO, "window_width must not be negative")

      q :: MAT{REAL}@
      c :: VEC{CPX}@
      q2,net :: REAL
      n :: INT

      net = .window_width*.window_width
      q.create(.coeff.dim,3)
      .make_scattering_vectors(q)
      c.create(.coeff.dim)
      do n = 1,.coeff.dim
         q2   = q(n,1)*q(n,1) + q(n,2)*q(n,2) + q(n,3)*q(n,3)
         c(n) = .coeff(n)*exp(-net*q2/2)
      end
      .sum_series_at(values,q,c,pts)
      c.destroy
      q.destroy

   end

   make_map_at(values,pts) :: leaky, PURE
   ! Set "values" to the map these settings describe, at the cartesian
   ! points "pts", one row per point: the density itself when l_value is
   ! negative, otherwise the local moment of angular momentum l_value;
   ! divided by its noise level when "in_sigma_units" is set.
      self :: IN
      values :: VEC{REAL}, OUT
      pts    :: MAT{REAL}, IN

      noise :: REAL

      if (.l_value<0) then
         .make_values_at(values,pts)
      else
         .make_moment_at(values,pts)
      end

      ! As significances
      if (.in_sigma_units) then
         noise = .noise_level(.m_value)
         STOP_IF(noise<=ZERO, "in_sigma_units: the map has no measurement noise")
         values = values/noise
      end

   end

   sum_series_at(values,q,c,pts) :: leaky, PURE, private
   ! Set "values" to the real part of the Fourier series with coefficients
   ! "c", one per reflection with scattering vector a row of "q", at the
   ! cartesian points "pts", one row per point: by FFT when "use_FFT" is
   ! set (make_series_by_FFT), otherwise by a sum at each point.
      self :: IN
      values :: VEC{REAL}, OUT
      q      :: MAT{REAL}, IN
      c      :: VEC{CPX}, IN
      pts    :: MAT{REAL}, IN

      if (.use_FFT) then
         .make_series_by_FFT(values,c,pts)
      else
         FOURIER_SUMS:fourier_series_at(values,q,c,pts)
      end

   end

   make_series_by_FFT(values,c,pts) :: leaky, PURE, private
   ! Set "values" to the real part of the Fourier series with coefficients
   ! "c", one per reflection (h1,h2,h3), at the cartesian points "pts", one
   ! row per point. The series is put on a grid over the cell by one fast
   ! Fourier transform and interpolated to the points by a cubic B-spline.
   ! Each axis has at least "fft_sampling" grid points per period of its
   ! highest Miller index, and more than twice that index. Coefficient h
   ! is divided first by
   !
   !    b(h1/n1) b(h2/n2) b(h3/n3),   b(t) = (2 + cos(2 pi t))/3,
   !
   ! with n1, n2, n3 the grid sizes: b is the transform of the spline's
   ! values at the grid points, so the transform gives the spline's
   ! coefficients and the spline passes exactly through the series at
   ! every grid point. Between them the error in a wave with k grid points
   ! per period is about (2 pi/k)^4/720 of its amplitude: 3e-2 at k = 3,
   ! 2e-3 at the default k = 6.
   ! The cost is one transform of the grid plus 64 terms per point,
   ! instead of one term per reflection per point. Needs -DFFTW=ON.
      self :: IN
      values :: VEC{REAL}, OUT
      c      :: VEC{CPX}, IN
      pts    :: MAT{REAL}, IN

   ENSURE(c.dim==.h1.dim, "c: wrong dim")
   ENSURE(values.dim==pts.dim1, "values: wrong dim")
   ENSURE(pts.dim2==3, "pts: wrong dim2")
   ENSURE(.fft_sampling>=2, "fft_sampling must be at least 2")

      interface
         tonto_fft_3d(a,n1,n2,n3,sign) :: pure
            a :: VEC{CPX}(*), INOUT
            n1,n2,n3,sign :: INT, IN
         end
      end

      g :: VEC{CPX}@
      w :: MAT{REAL}(4,3)
      x,t :: VEC{REAL}(3)
      nn,i0,hmax :: VEC{INT}(3)
      b,val :: REAL
      i,n,p,j1,j2,j3,a1,a2,a3 :: INT

#ifdef FFTW
      ! The grid
      hmax = [maxval(abs(.h1)),maxval(abs(.h2)),maxval(abs(.h3))]
      do i = 1,3
         nn(i) = .FFT_size(max(ceiling(.fft_sampling*hmax(i)),2*hmax(i)+1))
      end

      ! The spline coefficients, from the series divided by b
      g.create(product(nn))
      g = ZERO
      do n = 1,c.dim
         j1 = modulo(.h1(n),nn(1))
         j2 = modulo(.h2(n),nn(2))
         j3 = modulo(.h3(n),nn(3))
         b  = (2+cos(2*PI*j1/nn(1)))*(2+cos(2*PI*j2/nn(2)))*(2+cos(2*PI*j3/nn(3)))/27
         p  = 1 + j1 + nn(1)*(j2 + nn(2)*j3)
         g(p) = g(p) + c(n)/b
      end
      call tonto_fft_3d(g,nn(1),nn(2),nn(3),-1)

      ! The spline at each point, from the 4x4x4 grid points around it
      do i = 1,pts.dim1
         x  = matmul(pts(i,:),.reciprocal_mx)*nn
         i0 = floor(x)
         t  = x - i0
         w(1,:) = (1-t)**3/6
         w(2,:) = (3*t**3 - 6*t**2 + 4)/6
         w(3,:) = (-3*t**3 + 3*t**2 + 3*t + 1)/6
         w(4,:) = t**3/6
         val = ZERO
         do a3 = 1,4
            j3 = modulo(i0(3)+a3-2,nn(3))
            do a2 = 1,4
               j2 = modulo(i0(2)+a2-2,nn(2))
               do a1 = 1,4
                  j1 = modulo(i0(1)+a1-2,nn(1))
                  p  = 1 + j1 + nn(1)*(j2 + nn(2)*j3)
                  val = val + w(a1,1)*w(a2,2)*w(a3,3)*REALIFY(g(p))
               end
            end
         end
         values(i) = val
      end

      g.destroy
#else
      values = ZERO
      STOP_IF(TRUE,"use_fft needs a Tonto built with FFTW; configure with -DFFTW=ON")
#endif

   end

   FFT_size(n) result (res) :: pure, private
   ! Return the smallest integer not less than "n" with no prime factor
   ! above 7: a length FFTW transforms quickly.
      self :: IN
      n :: INT, IN
      res :: INT

      m,f :: INT

      res = max(n,1)
      do
         m = res
         do f = 2,7
            do
               if (modulo(m,f)/=0) exit
               m = m/f
            end
         end
         if (m==1) exit
         res = res + 1
      end

   end

   make_moment_at(values,pts) :: leaky, PURE
   ! Set "values" to the local moment of the density of angular momentum
   ! l = l_value, scaled to the units of a density, at the cartesian
   ! points "pts". The moment is the Fourier series with coefficient n
   ! multiplied by
   !
   !    (-i)^l sigma^l q^l Y_lm(q^) exp(-sigma^2 q^2/2),
   !
   ! with q the scattering vector of reflection n, sigma the window width
   ! and Y_lm the real harmonic normalised to 1 over the sphere: it is the
   ! moment of the density seen through a Gaussian window of width sigma
   ! centred at the point, divided by sigma^l. With sharpen_U set, a mean
   ! ADP U is divided out of every reflection first, which is the same
   ! formula with sigma^2 - U in the exponent; it is allowed only while
   ! that is positive, so the series still converges. With sharpen_order
   ! the exact factor exp(U q^2/2) is replaced by its Taylor polynomial of
   ! that order, a sum of Laplacian powers, bounded by the window for any
   ! U. With laplacian_order the map is multiplied by (-sigma^2 q^2)^k, its
   ! k-th Laplacian scaled by sigma^2k. With m_value set it is that
   ! one component, in the frame of ".axes" (the cartesian axes unless
   ! axes were given); otherwise it is the norm over m, which does not
   ! depend on the axes. l = 0 has one component and keeps its sign.
   ! m is the usual real-harmonic index, m > 0 cosine-like and m < 0
   ! sine-like: for l = 1, m = -1, 0, 1 are y, z, x, and the three maps are
   ! sqrt(3/4 pi) sigma times the gradient of the blurred density
   ! (FOURIER_SUMS:harmonic_column maps m onto the columns).
   !
   ! With moment_kind "riesz" the factor is (-i)^l Y_lm(q^) alone, with no
   ! window and no q^l: the Riesz density map Y_lm(nabla) (-nabla^2)^(-l/2) rho,
   ! in the units of a density for every l. F(000) enters for l = 0 only,
   ! where the map is rho/sqrt(4 pi); for l = 2 it is -1/(4 pi) times the
   ! electric field gradient of the electron density, as harmonic components.
      self :: IN
      values :: VEC{REAL}, OUT
      pts    :: MAT{REAL}, IN

   ENSURE(.coeff.allocated, "no coefficients")
   ENSURE(values.dim==pts.dim1, "values: wrong dim")
   ENSURE(pts.dim2==3, "pts: wrong dim2")
   ENSURE(.l_value>=0, "l_value not set")
   ENSURE(.m_value==-99 OR abs(.m_value)<=.l_value, "m_value out of range")
   ENSURE(.moment_kind=="riesz" OR .window_width>ZERO, "window_width not set")
   ENSURE(.moment_kind=="riesz" OR .sharpen_order>0 OR .sharpen_U<.window_width**2, "sharpen_U must be below window_width^2")
   ENSURE(.moment_kind=="gaussian" OR (.sharpen_U==ZERO AND .sharpen_order==0 AND .laplacian_order==0), "a Riesz map has no sharpening or Laplacian")

      q :: MAT{REAL}@
      f,c :: VEC{CPX}@
      comp :: VEC{REAL}@
      n_refl,lv,m,m_lo,m_hi :: INT

      n_refl = .coeff.dim
      lv = .l_value

      ! The scattering vectors
      q.create(n_refl,3)
      .make_scattering_vectors(q)

      ! Which components
      if (.m_value==-99) then
         m_lo = -lv; m_hi = lv
      else
         m_lo = .m_value; m_hi = .m_value
      end

      ! Each component's series, squared and added
      f.create(n_refl)
      c.create(n_refl)
      comp.create(values.dim)
      values = ZERO
      do m = m_lo,m_hi
         .make_moment_factors(f,q,m)
         c = .coeff*f
         .sum_series_at(comp,q,c,pts)
         if (m_lo==m_hi) then
            values = comp
         else
            values = values + comp*comp
         end
      end
      if (m_lo/=m_hi) values = sqrt(values)

      comp.destroy
      c.destroy
      f.destroy
      q.destroy

   end

   make_moment_factors(f,q,m) :: leaky, PURE
   ! Set "f(n)", the factor that multiplies coefficient n in the local
   ! moment of component "m" of angular momentum l_value (make_moment_at),
   ! for the scattering vectors "q", one row per coefficient: the Gaussian
   ! window's (-i)^l sigma^l q^l Y_lm(q^) exp(-sigma^2 q^2/2), with the
   ! sharpening and Laplacian options, or the Riesz map's (-i)^l Y_lm(q^).
      self :: IN
      f :: VEC{CPX}, OUT
      q :: MAT{REAL}, IN
      m :: INT, IN

   ENSURE(f.dim==q.dim1, "f: wrong dim")
   ENSURE(abs(m)<=.l_value, "m out of range")

      qr,Y :: MAT{REAL}@
      q2,sig,net :: REAL
      fac :: CPX
      n,lv,col :: INT
      riesz :: BIN

      lv  = .l_value
      sig = .window_width
      riesz = .moment_kind=="riesz"
      fac = (-IMAGIFY(ONE))**lv * sig**lv
      if (riesz) fac = (-IMAGIFY(ONE))**lv

      ! The net blur: the window less the mean ADP divided out, when the
      ! sharpening is exact; with a Taylor polynomial of order sharpen_order
      ! the window stays whole and the polynomial in q^2 does the sharpening,
      ! which is bounded whatever U
      net = sig*sig
      if (.sharpen_order==0) net = net - .sharpen_U

      ! The solid harmonics q^l Y_lm(q^) in the frame of the axes: the
      ! harmonics take the components of q along the local axes, the
      ! columns of the frame's matrix
      qr.create(q.dim1,3)
      qr = matmul(q,.axes.matrix)
      Y.create(q.dim1,(lv+1)*(lv+1))
      FOURIER_SUMS:make_solid_harmonics(Y,qr,lv)
      col = FOURIER_SUMS:harmonic_column(lv,m)

      do n = 1,q.dim1
         q2 = q(n,1)*q(n,1) + q(n,2)*q(n,2) + q(n,3)*q(n,3)
         if (riesz) then
            ! Y_lm(q^) = q^l Y_lm(q^) / q^l; at q = 0 only l = 0 survives
            if (lv==0) then
               f(n) = Y(n,col)
            else if (q2>ZERO) then
               f(n) = fac*Y(n,col)/sqrt(q2)**lv
            else
               f(n) = ZERO
            end
            cycle
         end
         f(n) = fac*Y(n,col)*exp(-net*q2/2)
         if (.sharpen_order>0)   f(n) = f(n)*.sharpening_polynomial(q2)
         if (.laplacian_order>0) f(n) = f(n)*(-sig*sig*q2)**.laplacian_order
      end

      Y.destroy
      qr.destroy

   end

   noise_level(m) result (res) :: leaky, PURE
   ! The noise level of the map these settings describe: the root mean
   ! square, over the cell, of the map of the random errors of the measured
   ! |F|, with the phases held fixed. The map is the real part of
   ! sum_n f_n c_n exp(-i q_n.r), f_n the filter factor (one for the plain
   ! density). An error in a measured |F| moves all the coefficients copied
   ! from it together, those with the same wave vector, or opposite ones,
   ! adding as amplitudes; errors of different measurements are independent
   ! and add as squares (filtered_root_power). Near a special position the
   ! noise is larger, as for any density map. For a local moment, "m"
   ! selects the component; m = -99 gives the noise of the norm over m, the
   ! root of the sum of the components' variances. Zero when the
   ! coefficients have no standard deviations, as for f_calc.
      self :: IN
      m :: INT, IN
      res :: REAL

   ENSURE(.coeff.allocated, "no coefficients")

      res = ZERO
      if (.coeff_sigma.deallocated) return
      res = .filtered_root_power(.coeff_sigma,.coeff_source,m)

   end

   rms_over_cell(m) result (res) :: leaky, PURE
   ! The root mean square over the cell of the map these settings describe,
   ! its mean left out: by Parseval's theorem the root of 1/2 sum |D_g|^2
   ! over the distinct wave vectors g, D_g the coefficients of g and -g
   ! combined (filtered_root_power with every coefficient from one source).
   ! "m" is as for noise_level.
      self :: IN
      m :: INT, IN
      res :: REAL

   ENSURE(.coeff.allocated, "no coefficients")

      source :: VEC{INT}@

      source.create(.coeff.dim)
      source = 1
      res = .filtered_root_power(.coeff,source,m)
      source.destroy

   end

   filtered_root_power(x,source,m) result (res) :: leaky, PURE, private
   ! The root of 1/2 sum_g sum_s |a_gs|^2, with a_gs = sum of f_n x(n) over
   ! the coefficients n of wave vector g and source s, plus the complex
   ! conjugate of that sum over the coefficients of -g: the mean square over
   ! the cell of the real part of sum_n f_n x(n) exp(-i q_n.r) when the
   ! terms of one source are fixed together and those of different sources
   ! vary independently. f_n is the filter factor of component "m"
   ! (make_moment_factors), or one for the plain density; m = -99 sums the
   ! components of a local moment. The term g = 0 is left out.
      self :: IN
      x :: VEC{CPX}, IN
      source :: VEC{INT}, IN
      m :: INT, IN
      res :: REAL

   ENSURE(x.dim==.coeff.dim, "x: wrong dim")
   ENSURE(source.dim==.coeff.dim, "source: wrong dim")

      q :: MAT{REAL}@
      f,t :: VEC{CPX}@
      key,order :: VEC{INT}@
      tie :: MAT{INT}@
      run :: CPX
      var :: REAL
      n,i,j,mm,m_lo,m_hi,k_plus,k_minus,k0 :: INT
      flip :: BIN

      n = .coeff.dim

      ! Each wave vector and its negative share one key; a coefficient of
      ! the negative one enters as its complex conjugate
      key.create(n)
      t.create(n)
      f.create(n)
      tie.create(n,1)
      tie(:,1) = source
      k0 = ((512)*1024 + 512)*1024 + 512
      q.create(n,3)
      .make_scattering_vectors(q)

      if (.l_value<0) then
         m_lo = 0; m_hi = 0
      else if (m==-99) then
         m_lo = -.l_value; m_hi = .l_value
      else
         m_lo = m; m_hi = m
      end

      var = ZERO
      do mm = m_lo,m_hi

         if (.l_value<0) then; f = ONE
         else;                 .make_moment_factors(f,q,mm)
         end
         t = f*x

         do i = 1,n
            k_plus  = ((.h1(i)+512)*1024 + (.h2(i)+512))*1024 + (.h3(i)+512)
            k_minus = ((-.h1(i)+512)*1024 + (-.h2(i)+512))*1024 + (-.h3(i)+512)
            flip = k_minus>k_plus
            key(i) = max(k_plus,k_minus)
            if (flip) t(i) = conjg(t(i))
         end

         ! Runs of one key and one source, summed as amplitudes
         order.create(n)
         key.quick_sort(order,then_by=tie)
         i = 1
         do
            if (i>n) exit
            j = i
            run = t(order(i))
            do
               if (j+1>n) exit
               if (key(order(j+1))/=key(order(i)) OR source(order(j+1))/=source(order(i))) exit
               j = j + 1
               run = run + t(order(j))
            end
            if (key(order(i))/=k0) var = var + HALF*abs(run)**2
            i = j + 1
         end
         order.destroy

      end
      res = sqrt(var)

      q.destroy
      tie.destroy
      f.destroy
      t.destroy
      key.destroy

   end

   make_radial_functions(f,radii) :: leaky, PURE
   ! Set "f(i,lm)" to the radial functions rho_lm(s) of the density about
   ! ".axes.center" at the radii "radii(i)", for l = 0 to ".l_max" and m = -l
   ! to l, column lm = l^2 + l + m + 1:
   !
   !    rho_lm(s) = 4 pi (-i)^l sum_n coeff(n) exp(-i q_n.c) Y_lm(q^_n) j_l(q_n s),
   !
   ! the expansion of the density on each sphere about the centre c in
   ! real harmonics, so that rho(c + s s^) = sum_lm rho_lm(s) Y_lm(s^),
   ! with s^ in the frame of ".axes".
   ! It is exact for the Fourier series, and is the reference that an
   ! angular quadrature about an atom is tested against. The factor of
   ! each reflection is real once the phase about the centre and (-i)^l
   ! are taken together, so the sum over radii is real arithmetic.
      self :: IN
      f     :: MAT{REAL}, OUT
      radii :: VEC{REAL}, IN

   ENSURE(.coeff.allocated, "no coefficients")
   ENSURE(.l_max>=0, "l_max must not be negative")
   ENSURE(f.dim1==radii.dim, "f: wrong dim1")
   ENSURE(f.dim2==(.l_max+1)*(.l_max+1), "f: wrong dim2")

      q,qr,Y,A :: MAT{REAL}@
      qn,j  :: VEC{REAL}@
      ph,fac :: CPX
      n_refl,n,i,lv,m,col,lm :: INT

      n_refl = .coeff.dim

      ! The scattering vectors, their lengths, and the solid harmonics in
      ! the frame of the axes (see make_moment_at)
      q.create(n_refl,3)
      .make_scattering_vectors(q)
      qn.create(n_refl)
      do n = 1,n_refl
         qn(n) = sqrt(q(n,1)*q(n,1) + q(n,2)*q(n,2) + q(n,3)*q(n,3))
      end
      qr.create(n_refl,3)
      qr = matmul(q,.axes.matrix)
      Y.create(n_refl,(.l_max+1)*(.l_max+1))
      FOURIER_SUMS:make_solid_harmonics(Y,qr,.l_max)
      qr.destroy

      ! A(n,lm) = Re[4 pi (-i)^l coeff(n) exp(-i q.c) Y_lm(q^)], the columns in
      ! the order l^2 + l + m + 1; Y_lm(q^) is the solid harmonic over q^l,
      ! and at q = 0 only l = 0 survives
      A.create(n_refl,(.l_max+1)*(.l_max+1))
      do n = 1,n_refl
         ph = .coeff(n)*exp(-IMAGIFY(ONE)*(q(n,1)*.axes.center(1) + q(n,2)*.axes.center(2) + q(n,3)*.axes.center(3)))
         do lv = 0,.l_max
            fac = 4*PI*(-IMAGIFY(ONE))**lv*ph
            do m = -lv,lv
               lm = lv*lv + lv + m + 1
               col = FOURIER_SUMS:harmonic_column(lv,m)
               if (qn(n)>1.0d-12) then
                  A(n,lm) = REALIFY(fac)*Y(n,col)/qn(n)**lv
               else if (lv==0) then
                  A(n,lm) = REALIFY(fac)*Y(n,col)
               else
                  A(n,lm) = ZERO
               end
            end
         end
      end

      ! The sum over reflections at each radius
      j.create(.l_max+1)
      f = ZERO
      do i = 1,radii.dim
         do n = 1,n_refl
            FOURIER_SUMS:spherical_bessel(j,qn(n)*radii(i),.l_max)
            do lv = 0,.l_max
               do m = -lv,lv
                  lm = lv*lv + lv + m + 1
                  f(i,lm) = f(i,lm) + A(n,lm)*j(lv+1)
               end
            end
         end
      end

      j.destroy
      A.destroy
      Y.destroy
      qn.destroy
      q.destroy

   end

   sharpening_polynomial(q2) result (res) :: pure
   ! The Taylor polynomial of order ".sharpen_order" of exp(U q^2/2), the
   ! factor that divides a mean ADP U out of a reflection with q^2 = "q2":
   ! the backward step in scale as a sum of Laplacian powers, which is
   ! bounded by the window for any U
      self :: IN
      q2  :: REAL, IN
      res :: REAL

      term :: REAL
      j :: INT

      res  = ONE
      term = ONE
      do j = 1,.sharpen_order
         term = term*(.sharpen_U*q2/2)/j
         res  = res + term
      end

   end

   make_values_on_cell(values,nx,ny,nz) :: PURE
   ! Set "values" to the density on a grid of "nx", "ny", "nz" points
   ! along the cell axes, both ends of each axis included, incrementing
   ! first on x, then y, then z, as PLOT_GRID:make_points does. The phase
   ! of each reflection separates into one factor per axis, so the three
   ! one-dimensional tables of phases are made once and the sum at a
   ! point is a product of three table entries.
      self :: IN
      values   :: VEC{REAL}, OUT
      nx,ny,nz :: INT, IN

   ENSURE(.coeff.allocated, "no coefficients")
   ENSURE(values.dim==nx*ny*nz, "values: wrong dim")
   ENSURE(nx>1 AND ny>1 AND nz>1, "need at least two points on each axis")

      phx,phy,phz :: MAT{CPX}@
      ix,iy,iz,n,p,n_refl :: INT
      xi,yi,zi,del :: REAL
      ci :: CPX

      n_refl = .coeff.dim
      ci     = -2*PI*IMAGIFY(ONE)

      ! The x phases
      phx.create(n_refl,nx)
      del = ONE/(nx-1)
      xi  = ZERO
      do ix = 1,nx
         do n = 1,n_refl
            phx(n,ix) = exp(ci*.h1(n)*xi)
         end
         xi = xi + del
      end

      ! The y phases
      phy.create(n_refl,ny)
      del = ONE/(ny-1)
      yi  = ZERO
      do iy = 1,ny
         do n = 1,n_refl
            phy(n,iy) = exp(ci*.h2(n)*yi)
         end
         yi = yi + del
      end

      ! The z phases, carrying the coefficient
      phz.create(n_refl,nz)
      del = ONE/(nz-1)
      do iz = 1,nz
         zi = (iz-1)*del
         do n = 1,n_refl
            phz(n,iz) = exp(ci*.h3(n)*zi)*.coeff(n)
         end
      end

      ! The map
      p = 0
      do iz = 1,nz
      do iy = 1,ny
      do ix = 1,nx
         p = p + 1
         values(p) = sum(REALIFY(phx(:,ix)*phy(:,iy)*phz(:,iz)))
      end
      end
      end

      phz.destroy
      phy.destroy
      phx.destroy

   end

!  =====
!  Input
!  =====

   read_keywords :: get_from(OBJECT), leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) :: leaky
   ! Process command "keyword". Any required data needed by the "keyword" is
   ! inputted from "stdin".
      self :: INOUT
      keyword :: STR, IN

      word :: STR

      word = keyword
      word.to_lower_case

      select case (word)
      case ("}                  ")  ! exit case
      case ("kind=              "); .read_kind
      case ("l_value=           "); .read_l_value
      case ("m_value=           "); .read_m_value
      case ("m_maps=            "); .read_m_maps
      case ("window_width=      "); .read_window_width
      case ("moment_kind=       "); .read_moment_kind
      case ("sharpen_u=         "); .read_sharpen_U
      case ("sharpen_order=     "); .read_sharpen_order
      case ("laplacian_order=   "); .read_laplacian_order
      case ("wiener_weight=     "); .read_wiener_weight
      case ("fill_missing=      "); .read_fill_missing
      case ("in_sigma_units=    "); .read_in_sigma_units
      case ("use_fft=           "); .read_use_FFT
      case ("fft_sampling=      "); .read_fft_sampling
      case ("l_max=             "); .read_l_max
      case ("centre=            "); .axes.read_center
      case ("center=            "); .axes.read_center
      case ("centre_atom=       "); .axes.read_center_atom
      case ("center_atom=       "); .axes.read_center_atom
      case ("centre_atoms=      "); .axes.read_center_atoms
      case ("center_atoms=      "); .axes.read_center_atoms
      case ("centre_fractional= "); .read_centre_fractional
      case ("center_fractional= "); .read_centre_fractional
      case ("x_axis=            "); .axes.read_x_axis
      case ("x_axis_atoms=      "); .axes.read_x_axis_atoms
      case ("y_axis=            "); .axes.read_y_axis
      case ("y_axis_atoms=      "); .axes.read_y_axis_atoms
      case ("z_axis=            "); .axes.read_z_axis
      case ("z_axis_atoms=      "); .axes.read_z_axis_atoms
      case ("n_radii=           "); .read_n_radii
      case ("radius_max=        "); .read_radius_max
      case ("density_source=    "); .read_density_source
      case ("atom_weight=       "); .read_atom_weight
      case ("atoms=             "); .read_atoms
      case default; UNKNOWN(word)
      end

   end

   read_kind
   ! Read which density of the cell to make
      self :: INOUT

      kind :: STR

      stdin.read(kind)
      .set_kind(kind)

   end

   read_l_value :: leaky
   ! Read the angular momentum of a local-moment map, and make sure the
   ! harmonics up to it are available. A negative value asks for the plain
   ! density. Setting l resets m_value, so the map is the norm over m
   ! until m_value= is given again.
      self :: INOUT

      stdin.read(.l_value)

      .m_value = -99

      if (.l_value>=0) GAUSSIAN_DATA:set_indices(.l_value)

   end

   read_m_value
   ! Read one component m of a local-moment map; without it the map is
   ! the norm over m. l_value must come first.
      self :: INOUT

      stdin.read(.m_value)

   DIE_IF(.l_value<0, "set l_value before m_value")
   DIE_IF(abs(.m_value)>.l_value, "m_value must lie between -l_value and l_value")

   end

   read_m_maps
   ! Read what a plot of a local moment writes: "norm", the norm over m
   ! alone; "all", every component m to its own file and the norm from
   ! them; "auto", all when axes are given and the norm otherwise
      self :: INOUT

      stdin.read(.m_maps)
      .m_maps.to_lower_case

   DIE_IF(NOT .m_maps.is_one_of(["norm","all ","auto"]), "m_maps must be norm, all or auto")

   end

   read_window_width
   ! Read the width of the Gaussian window, a length: of a local-moment map,
   ! which needs it positive, and of the density the Hirshfeld atoms are
   ! expanded from when density_source is cell_map, where zero means the
   ! raw density, unblurred
      self :: INOUT

      stdin.read_quantity(.window_width)

   DIE_IF(.window_width<ZERO, "window_width must not be negative")

   end

   read_fill_missing :: leaky
   ! Read whether the reflections missing from the data within its
   ! resolution are added to the maps, valued by the refined model. Reading
   ! it drops any filled reflections already made, so that they are made
   ! again from the model as it now is
      self :: INOUT

      stdin.read(.fill_missing)

      if (.filled.allocated) .filled.destroy

   end

   read_use_FFT
   ! Read whether a map is summed by FFT onto a grid over the cell and then
   ! interpolated to the points (make_series_by_FFT), which is much faster
   ! for many reflections and many points; needs a Tonto built with FFTW
      self :: INOUT

      stdin.read(.use_FFT)

   end

   read_fft_sampling
   ! Read the number of FFT grid points per period of the highest Miller
   ! index on each axis; at least 2. The default, 6, keeps the interpolation
   ! error near 2e-3 of the amplitude of the finest wave
      self :: INOUT

      stdin.read(.fft_sampling)
   DIE_IF(.fft_sampling<2, "fft_sampling must be at least 2")

   end

   read_in_sigma_units
   ! Read whether a map is written divided by its noise level (see
   ! noise_level), so that its values are significances
      self :: INOUT

      stdin.read(.in_sigma_units)

   end

   read_moment_kind
   ! Read the kind of a local-moment map: "gaussian", the moment through a
   ! Gaussian window of width window_width; "riesz", the Riesz density map,
   ! with no window and the factor q^l left out (see make_moment_at)
      self :: INOUT

      stdin.read(.moment_kind)
      .moment_kind.to_lower_case

   DIE_IF(NOT .moment_kind.is_one_of(["gaussian","riesz   "]), "moment_kind must be gaussian or riesz")

   end

   read_sharpen_U
   ! Read the mean ADP divided out of a local-moment map, an area with
   ! units (angstrom^2); it must stay below the window width squared
      self :: INOUT

      stdin.read_quantity(.sharpen_U)

   DIE_IF(.sharpen_U<ZERO, "sharpen_u must not be negative")
   DIE_IF(.sharpen_order==0 AND .sharpen_U>=.window_width**2, "sharpen_u must be below window_width^2: blur more than you sharpen, or set sharpen_order")

   end

   read_sharpen_order
   ! Read the order of the Taylor polynomial that replaces the exact
   ! sharpening factor; 0 keeps the exact factor
      self :: INOUT

      stdin.read(.sharpen_order)

   DIE_IF(.sharpen_order<0, "sharpen_order must not be negative")

   end

   read_laplacian_order
   ! Read how many Laplacians to apply to a local-moment map
      self :: INOUT

      stdin.read(.laplacian_order)

   DIE_IF(.laplacian_order<0, "laplacian_order must not be negative")

   end

   read_wiener_weight
   ! Read whether each observed coefficient is weighted by F^2/(F^2+sigma_F^2)
      self :: INOUT

      stdin.read(.wiener_weight)

   end

   read_l_max :: leaky
   ! Read the highest l of the radial functions about a centre
      self :: INOUT

      stdin.read(.l_max)

   DIE_IF(.l_max<0, "l_max must not be negative")

      GAUSSIAN_DATA:set_indices(.l_max)

   end

   read_centre_fractional :: leaky
   ! Read the centre of the radial functions in fractional coordinates.
   ! The cell must be known: give crystal= first.
      self :: INOUT

      frac :: VEC{REAL}(3)

      stdin.read(frac)

   DIE_IF(.volume<=ZERO, "the cell is not set: give crystal= first")

      .axes.set_center(matmul(.direct_mx,frac))

   end

   read_n_radii
   ! Read the number of radii of the radial functions
      self :: INOUT

      stdin.read(.n_radii)

   DIE_IF(.n_radii<1, "n_radii must be positive")

   end

   read_radius_max
   ! Read the largest radius of the radial functions, a length
      self :: INOUT

      stdin.read_quantity(.radius_max)

   DIE_IF(.radius_max<=ZERO, "radius_max must be positive")

   end

   read_density_source
   ! Read which density the Hirshfeld-atom decomposition expands: the
   ! wavefunction's, or the Fourier density of this cell map
      self :: INOUT

      stdin.read(.density_source)
      .density_source.to_lower_case

   DIE_IF(.density_source/="wavefunction" AND .density_source/="cell_map", "density_source must be wavefunction or cell_map")

   end

   read_atom_weight
   ! Read whether the Hirshfeld weight is applied in the atom decomposition
      self :: INOUT

      stdin.read(.atom_weight)
      .atom_weight.to_lower_case

   DIE_IF(.atom_weight/="hirshfeld" AND .atom_weight/="none", "atom_weight must be hirshfeld or none")

   end

   read_atoms :: leaky
   ! Read the atoms of a rebuilt-atoms map, a list of indices or tags in
   ! braces, atoms= { O1 C1 3 }; without it every atom is used
      self :: INOUT

      stdin.read_all(.atom_tags)

   end

!  ======
!  Output
!  ======

   put_radial_functions :: leaky
   ! Put the radial functions rho_lm(s) of the density about ".axes.center",
   ! l = 0 to ".l_max", at ".n_radii" radii up to ".radius_max", in
   ! electrons per cubic Angstrom; then the power of each l, the sum of
   ! the squares over m, which does not depend on the axes.
      self :: IN

      f :: MAT{REAL}@
      radii :: VEC{REAL}@
      power :: REAL
      fac,fac3 :: REAL
      i,lv,m,lm,n_lm :: INT

      n_lm = (.l_max+1)*(.l_max+1)
      radii.create(.n_radii)
      do i = 1,.n_radii
         radii(i) = i*.radius_max/.n_radii
      end
      f.create(.n_radii,n_lm)
      .make_radial_functions(f,radii)

      fac  = ANGSTROM_PER_BOHR
      fac3 = BOHR_PER_ANGSTROM**3

      stdout.flush
      stdout.text("====================================")
      stdout.text("Radial functions of the cell density")
      stdout.text("====================================")
      stdout.flush
      stdout.show("Kind                    =",.kind)
      stdout.show("Centre (Angstrom)       =",.axes.center*fac)
      stdout.show("l_max                   =",.l_max)
      stdout.text(". rho_lm(s) in e/Angstrom^3, s in Angstrom; the density on the sphere")
      stdout.text("  of radius s is the sum over l, m of rho_lm(s) Y_lm, with Y_lm real")
      stdout.text("  harmonics of unit integral; m = -1, 0, 1 are y, z, x")
      stdout.flush

      ! The table of rho_lm(s)
      stdout.text("rho_lm(s), columns (l,m):")
      stdout.flush
      do i = 1,.n_radii
         stdout.put(radii(i)*fac,width=10,precision=5)
         do lm = 1,n_lm
            stdout.put(f(i,lm)*fac3,width=12,precision=5)
         end
         stdout.flush
      end

      ! The power of each l
      stdout.flush
      stdout.text("Power P_l(s) = sum over m of rho_lm(s)^2, columns l = 0 to l_max:")
      stdout.flush
      do i = 1,.n_radii
         stdout.put(radii(i)*fac,width=10,precision=5)
         do lv = 0,.l_max
            power = ZERO
            do m = -lv,lv
               lm = lv*lv + lv + m + 1
               power = power + (f(i,lm)*fac3)**2
            end
            stdout.put(power,width=12,precision=5)
         end
         stdout.flush
      end

      f.destroy
      radii.destroy

   end

   put
   ! Put the settings and the size of the map
      self :: IN

      comp :: VEC{REAL}@
      noise :: REAL
      m :: INT

      stdout.flush
      stdout.text("=============")
      stdout.text("Cell map data")
      stdout.text("=============")
      stdout.flush
      stdout.show("Kind                    =",.kind)
      stdout.show("No. of reflections      =",.n_reflections)
      stdout.show("Fill missing?           =",.fill_missing)
      if (.filled.allocated) &
      stdout.show("No. filled              =",.filled.dim)
      stdout.show("Cell volume             =",.volume)
      stdout.show("Electron count          =",.electron_count)
      if (.l_value>=0) then
      stdout.show("l_value                 =",.l_value)
      if (.m_value/=-99) &
      stdout.show("m_value                 =",.m_value)
      stdout.show("m maps                  =",.m_maps)
      stdout.show("Moment kind             =",.moment_kind)
      if (.moment_kind=="gaussian") &
      stdout.show("Window width            =",.window_width)
      stdout.show("Sharpening U            =",.sharpen_U)
      stdout.show("Sharpening order        =",.sharpen_order)
      stdout.show("Laplacian order         =",.laplacian_order)
      stdout.show("Wiener weight?          =",.wiener_weight)
      end

      ! The noise level, from the coefficients' standard deviations; in
      ! atomic units, and in electrons per cubic angstrom for the output
      if (.coeff_sigma.allocated) then
      noise = .noise_level(.m_value)
      stdout.show("Noise level             =",noise)
      stdout.show("Noise level/(e A^-3)    =",noise*BOHR_PER_ANGSTROM**3)
      if (.l_value>0 AND .m_value==-99) then
         comp.create(2*.l_value+1)
         do m = -.l_value,.l_value
            comp(m+.l_value+1) = .noise_level(m)*BOHR_PER_ANGSTROM**3
         end
      stdout.show("Noise per m/(e A^-3)    =",comp)
         comp.destroy
      end
      stdout.show("In sigma units?         =",.in_sigma_units)
      end
      if (.use_FFT) then
      stdout.show("Use FFT?                =",.use_FFT)
      stdout.show("FFT points per period   =",.fft_sampling)
      end
      stdout.show("Map r.m.s./(e A^-3)     =",.rms_over_cell(.m_value)*BOHR_PER_ANGSTROM**3)
      stdout.show("l_max                   =",.l_max)
      stdout.show("No. of radii            =",.n_radii)
      stdout.show("Largest radius          =",.radius_max)
      .axes.put

   end

end
