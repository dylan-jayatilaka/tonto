!=================================================================
!
! XC_DENSITY:
!
! The inputs to a density functional on one batch of grid points: the
! density, its gradient if the functional needs one, and the kinetic
! energy density "tau" if it needs that. "tau" is half the sum over the
! occupied orbitals of the square of the orbital gradient. The last
! dimension of each array is the spin channel: one channel holds the
! total quantity, two hold the alpha and beta ones.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!==================================================================

module XC_DENSITY

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   destroy_ptr_part :: leaky, PURE
   ! Deallocate the arrays
      self :: INOUT

      if (.tau.allocated)  .tau.destroy
      if (.grad.allocated) .grad.destroy
      if (.rho.allocated)  .rho.destroy

   end

   create_grids(n_pt,n_spin,has_gradient,has_tau) :: leaky, PURE
   ! Allocate the arrays for "n_pt" grid points and "n_spin" spin channels
   ! and set them to zero. The gradient is allocated only if "has_gradient"
   ! is TRUE, and the kinetic energy density only if "has_tau" is present
   ! and TRUE.
      self :: INOUT
      n_pt,n_spin :: INT, IN
      has_gradient :: BIN, IN
      has_tau :: BIN, optional, IN

   ENSURE(n_spin==1 OR n_spin==2,"n_spin must be 1 or 2")

      .destroy_ptr_part

      .n_pt         = n_pt
      .n_spin       = n_spin
      .has_gradient = has_gradient
      .has_tau      = FALSE
      if (present(has_tau)) .has_tau = has_tau

      .rho.create(n_pt,n_spin)
      .rho = ZERO
      if (.has_gradient) then
         .grad.create(n_pt,3,n_spin)
         .grad = ZERO
      end
      if (.has_tau) then
         .tau.create(n_pt,n_spin)
         .tau = ZERO
      end

   end

!  ===========
!  Set methods
!  ===========

   set_defaults :: leaky, PURE
   ! Set up defaults: no grid points, one spin channel, no gradient
   ! and no kinetic energy density
      self :: INOUT

      .destroy_ptr_part

      .n_pt         = 0
      .n_spin       = 1
      .has_gradient = FALSE
      .has_tau      = FALSE

   end

end
