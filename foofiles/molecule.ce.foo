module MOLECULE.CE

   implicit none

contains

!  ======================
!  Read CIF block options
!  ======================

   read_CX_file_name 
   ! Read the CX file name
      self :: INOUT
      stdin.read(.CX_file_name)
   end

   read_CX_uses_angstrom 
   ! Read whether CX should use angstroms
      self :: INOUT
      stdin.read(.CX_uses_angstrom)
   end

   read_CX_isosurface :: leaky
   ! Read in special crystalexplorer isosurface data. This only works
   ! if there is a .saved.cluster created . This CX isosurface differs
   ! from a normal isosurface in that the default box sizes for the
   ! isosurface are set from the cluster fragment (as opposed to the
   ! .atom list for normal isosurfaces), and there is a default
   ! isosurface kind, which is the "stockholder_density".  
   ! NOTE: the isosurface has its own plotgrid, different from that
   ! used in normal density plots, but .plot_grid is assigned to it.
      self :: INOUT

   ENSURE(.saved.allocated,"no saved molecule")
   ENSURE(.saved.cluster.allocated,"no saved cluster data")
   ENSURE(.saved.cluster.info_made, "no saved cluster info")
   ENSURE(.saved.atom.allocated,"no saved atom list")
   ENSURE(.atom.allocated,"no atom list")

      if (.isosurface.deallocated) .isosurface.create(.atom)

      .isosurface.plot_grid.set_defaults(.saved.atom)
      .isosurface.plot_grid.n_x = 2**ISOSURFACE_MINIMUM_SCAN_LEVEL + 1
      .isosurface.plot_grid.set_points_widths_origin

      .isosurface.property = "stockholder_weight"  

      !!!!!!!!!!!!!!!!!!!!!!!!!
      .isosurface.read_keywords
      !!!!!!!!!!!!!!!!!!!!!!!!!

      ! Use unit cell as bbox if requested
      if (.isosurface.plot_grid.use_unit_cell_as_bbox) then
         WARN("resetting plot axes, plot widths from unit cell")
         .isosurface.plot_grid.set_bbox_from_unit_cell(.saved.cluster.crystal.unit_cell)
      end

   end

!  =========================
!  Process CIF block options
!  =========================

   process_CIF_for_CX :: leaky
   ! Process the entire .cif file by reading *all* acceptable data
   ! blocks (i.e. those with crystal and atom information) and then
   ! writing this information to a CE information file. 
   ! NOTE: on termination, this does NOT produce a valid atom list.
   !       For that, use process_CIF
      self :: allocatable, INOUT

   ENSURE(.CX_file_name/=" ","no CX file name")
   ENSURE(.cif.allocated,"no CIF object created")
   ENSURE(.cif.file_name/=" ","no CIF file name specified")

      found,CX_uses_angstrom :: BIN
      CX_file :: TEXTFILE@
      cif :: CIF@

      CX_file.create(.CX_file_name)
      CX_file.open_for("write")

      ! Save .cif outside of self, since it gets destroyed
      call move_alloc(.cif,cif)

      do

         ! Find next data block
         .find_CIF_crystal_data_block(cif,found)

         ! Any data left?
         if (NOT found) exit 

         ! Read and create in from cif (leaky)
         .read_CIF_atoms(cif)
         .read_CIF_crystal(cif)

         ! Create the cluster
         .cluster.create
         .cluster.set_defaults(.crystal)
         .cluster.set_radius(ZERO)
         .cluster.set_generation_method("fragment")
         .cluster.set_defragment(FALSE)
         .cluster.update_info                   
         .cluster.put

         ! Write out 
         .put_CX_data(CX_file,cif)       

         ! Preserve
         CX_uses_angstrom  = .CX_uses_angstrom

         !!!!!!!!!!!!!!
         ! Destroy self
         .destroy                             
         .create
         !!!!!!!!!!!!!!

         ! Next 
         .CX_uses_angstrom = CX_uses_angstrom
         cif.move_to_end_of_data

      end

      ! Clean
      cif.destroy
      CX_file.destroy

   end

   process_CIF_cell_and_symmetry :: leaky
   ! Process only the cell and spacegroup from the CIF file.
   ! If ".cif.data_block_name" is not defined, use the first
   ! acceptable data block.
      self :: INOUT

   ENSURE(.cif.allocated,"no CIF object created")

      ! Find a data block name
      if (.cif.data_block_name==" ") then
         WARN("No CIF data block as specified")
         WARN("Searching for first acceptable data block")
         .find_CIF_crystal_data_block(.cif)
      end

      ! Find the data block
      ::open_CIF_at_data_block(.cif)
      
      ! Read crystal info
      .read_CIF_crystal(.cif) 

   end

   process_CIF(skip_HA_inputs) :: leaky
   ! Process a CIF file: read atom and crystal information.
   ! If ".cif.data_block_name" is not defined, use the first
   ! acceptable data block.
      self :: INOUT
      skip_HA_inputs :: BIN, optional, IN

   ENSURE(.cif.allocated,"no CIF object created")

      do_HA_inputs :: BIN

      do_HA_inputs = TRUE
      if (present(skip_HA_inputs)) do_HA_inputs = NOT skip_HA_inputs

      ! Find a data block name
      if (.cif.data_block_name==" ") then
         .find_CIF_crystal_data_block(.cif)
      end

      ! Find the data block
      ::open_CIF_at_data_block(.cif)
      
      ! Read crystal info, ensure .atom's are cartesian
      .read_CIF_crystal_only(.cif) 

      ! Assume there is X-ray data
      if (.crystal.allocated) then
      .crystal.read_CIF_xray_data(.cif)
      end

      ! Read in atoms of asymmetric unit
      ! If no .crystal.unit_cell, .atom's remain fractional
      .read_CIF_atoms_only(.cif)   

      ! Update any crystal fragment_atom info, positions.
      .update_CIF_crystal_atoms(.cif)

      ! Make Hirshfeld info
      if (.basis_info_made) then
      if (.SCF_data.allocated) then
      if (.atom.allocated) then
      if (.crystal.xray_data.allocated) then
      if (.crystal.using_one_center_TF_model) then
      if (do_HA_inputs) then
         .make_ANOs_and_interpolators
      end
      end
      end
      end
      end
      end

      ! Reset to finalize next time
      .crystal.finalize = TRUE

   end

   find_CIF_crystal_data_block(cif,found) :: public
   ! Find the *first* crystal data block in the "cif" file
   ! starting from line cif.start_of_data, and set the locator
   ! "cif.data_block_name". The name of the molecule is set to 
   ! the name of the cif file concatenated with the block name.  
      self :: INOUT
      cif :: CIF
      found :: BIN, optional, OUT

   ENSURE(cif.file.allocated,"no CIF file name")
   ENSURE(cif.file.name/=" ","no CIF file name")

      fnd :: BIN

      ! Set name
      if (.name==" " OR .name == "unknown") then
         .name = trim(cif.file.name.filename_head)
      end

      if (NOT cif.file.is_open) cif.open

      cif.find_crystal_data_block(fnd)

      if (present(found)) then
         found = fnd
         if (NOT found) return
      else 
         DIE_IF(NOT fnd,"couldn't find crystal data block")
      end


   end

   open_CIF_at_data_block(cif) :: selfless
   ! Open the "cif" file at the block with name "cif.data_block_name".
      cif :: CIF, INOUT

   ENSURE(cif.file_name/=" ","no CIF file name")
   ENSURE(cif.data_block_name/=" ","no CIF data block name")

      name :: STR

      ! Open?
      if (NOT cif.file.is_open) cif.open

      ! Store: cif.data_block_name is trashed
      name = cif.data_block_name 
      cif.find_data_block_called(name)

   end

!  ======================
!  New cluster operations
!  ======================

   defragment :: leaky
   ! Defragment the current atom list, assuming it is read in from CIF
   ! file and may consist of just an asymmetric unit.
      self :: INOUT

   ENSURE(.cif.allocated,"no CIF info")
   ENSURE(.crystal.allocated,"no crystal")

      ! Defragment any molecules in the CIF
      .crystal.set_generation_method("fragment")
      .crystal.set_radius(ZERO)
      .crystal.set_defragment(TRUE)
      .crystal.make_cluster_info

      ! Reset .atom list to the .crystal.geometry
      .atom.destroy
      .crystal.create_atom_list(.atom)

      ! Finalize atom info/bases & atom agroups
      .atom_info_made = FALSE
      .destroy_atom_group
      .update_atom_basis_group_info

      ! Redine crystal fragment
      .crystal.destroy_asymmetric_unit
      .crystal.update_fragment_info(.atom)
   ! .update_atom_basis_group_info ! Why a 2nd time?

      ! Make Hirshfeld info
      if (.basis_info_made) then
      if (.SCF_data.allocated) then
      if (.crystal.allocated) then
      if (.crystal.xray_data.allocated) then
      if (.crystal.using_one_center_TF_model) then
         .make_ANOs_and_interpolators
      end
      end
      end
      end
      end

   end

   phar_defragment :: leaky
   ! For periodic HAR. Find atoms for the bond analysis
   ! This updates .crystal.fragment_atom for further geometry analysis, while keeps 
   ! (.molecule).atom for the DFT calculation.
   ! Make sure that the updated crystal has the same ordred (.crystal).asymmetric_unit_atom 
   ! and they should have the identical counter part in (molecule).atom(:)
   ! It is recommended to put this keyword between "crystal= { ... }" and "ha_fit" keywords.
   ! Otherwise, "crystal= {" will reset the defragmented atom groups.
   
      self :: INOUT
   
   ENSURE(.crystal.allocated, "no crystal")

      tmp_Aatom :: VEC{ATOM}@
      umol_atom :: VEC{ATOM}@ ! new source for fragment_atom from unqiue molecules
      i,oi,m,um :: INT
      prune_ind,Z,Zs,perm :: VEC{INT}@
      b :: BIN

      tmp_Aatom.create(.crystal.n_asymmetric_unit_atoms) 
      tmp_Aatom = .crystal.asymmetric_unit_atom

      !stdout.text("Kang Debug: before defragment: .crystal.fragment_atom")
      !.crystal.fragment_atom.put_coordinates(no_header=TRUE)

      .crystal.set_generation_method("fragment")
      .crystal.make_occupation_list ! ".crystal.occupation_list" is set.
                                    ! Note: .crystal.unit_cell_atom_for_frag_atom(f) is .crystal.unit_cell_atom(u) 
      
      .crystal.do_defragment_v2 ! Grow fragment atoms by "do_defragment_v2" 
                                 ! - The first ".n_fragment_atoms" in the ".occupied_list" is the same to ".crystal.frag
                                 ! - The followings are available
                                 !   (.crystal).molecule_for_atom :: VEC{INT}@         group indices. 
                                 !             .molecule          :: VEC{EVEC{INT}}@  
                                 !             .n_molecules
                                 !             .n_unique_molecules
                                 !             .unique_molecule_for :: VEC{INT}@     unique molecules have value 0
                                
      ! extract the atoms from the unique molecules from the occupation list
      prune_ind.create(0)

      ! Prune occupation list for new fragment atom
      do oi = 1, .crystal.occupation_list.dim 
         m  = .crystal.molecule_for_atom(oi) 
         um = .crystal.unique_molecule_for(m)
         if (NOT um == 0 ) prune_ind.append( oi ) ! If oi-atom is not unique molecule, append "oi" to prune_ind(:)
    
      end
       
      ! Prune occupation list. leaving atoms belonging to the unique molecules.
      do i = prune_ind.dim,1,-1  ! Reverse order is important, from tail to head pruning
         .crystal.occupation_list.prune_element(prune_ind(i))  
         .crystal.molecule_for_atom.prune_element(prune_ind(i))
      end
      .crystal.n_atoms = .crystal.occupation_list.dim  ! Manually update .crystal.n_atoms 
      prune_ind.destroy                                ! > It should be same to ".crystal.occupation_list.dim"

      !! Sort occupation_list based on atomic_number, so the .crystal.fragment_atom will be sorted
!>DEBUG      .crystal.put_occupation_list  ! Note: .crystal.n_atom = .crystal.occupation_list.dim
      Z.create( .crystal.n_atoms )
      Zs.create(.crystal.n_atoms )
      perm.create(.crystal.n_atoms)

      Z = CLUSTER_UA_FROM_CODE(.crystal.occupation_list)
      Z = .crystal.unit_cell_atom(Z).atomic_number

      Zs = Z
      Zs.sort(decreasing_order=TRUE)
      Zs.is_permutation_of(Z,b,perm) ! this is a way to get the index ordering from the sorting, b::BIN is dummy
      
      .crystal.occupation_list   = .crystal.occupation_list(perm) 
      .crystal.molecule_for_atom = .crystal.molecule_for_atom(perm)
!>DEBUG      .crystal.put_occupation_list ! occupation list after sorting

      !! Kang's note.
      ! xml_atom's and cif_atom's ADPs are saved at (.molecule).atom 
      ! The ".crystal" object is created by ".update_fragment_info( .atom )"
      ! So,>  i) "crystal.asymmetric_unit_atom:: VEC{ATOM}@" id selected from xml_atom.
      !      ii) "crystal.fragment_atom       :: VEC{ATOM}@" is the same with "xml_atom" from CRYSTAL23
      !     iii) "crystal.occupation_list     :: VEC{INT}@"  is created from ".crystal.fragment_atom", then "do_defragment_v2"ed
      ! until now.
      ! Now, we are going to separate (.molecule).atom and .crystal.fragment_atom. Sorry Dylan ;) 
      ! .atom                        is for set_shell1_from(...) 
      ! .crystal.fragment_atom       is for geometry analysis
      ! .crystal.asymmetric_unit_atom will be found agian from xml_atom(= .atom )

      .crystal.create_atom_list( umol_atom ) ! unique molecule atom is ready.
      umol_atom.update ! How can I redefine label or tags?

      .crystal.destroy_asymmetric_unit
      .crystal.update_fragment_info( umol_atom ) ! now crystal.fragment_atom are defragmented
      
!>DEBUG  Show NEW .asymmetric_unit_atom ")
!>      .crystal.asymmetric_unit_atom.put_coordinates(no_header=TRUE)
!>      .crystal.asymmetric_unit_atom.put_ADPs(no_header=TRUE) ! These new asymmetric atom should be consistent with .beck_grid.atom & .becke_grid.unique_atom_for
   end


!  ===
!  Put
!  ===

   put_CX_data
   ! Output information that Crystal Explorer requires to the file 
   ! with name ".CX_file_name".
      self :: INOUT
      .put_CX_data(.cif)
   end

   put_CX_data(cif)
   ! Output information that Crystal Explorer requires to the file 
   ! with name ".CX_file_name".
      self :: INOUT
      cif  :: CIF@

      CX_file :: TEXTFILE@

      if (.CX_file_name/=" ") then

         CX_file.create(.CX_file_name)
         CX_file.open_for("write")
         .put_CX_data(CX_file,cif)
         CX_file.close
         CX_file.destroy

      else

         .put_CX_data(TEXTFILE::stdout,cif)

      end

   end

   put_CX_data(CX_file,cif)
   ! Output information that Crystal Explorer requires to file "CX_file".
   ! NOTE: this requires a "cif" file to have been read, and a valid data block
   ! name to be stored in the "cif" object.
      self :: INOUT
      CX_file :: TEXTFILE, IN
      cif :: CIF@, IN

! ENSURE(cif.allocated,"no CIF object created")
! ENSURE(cif.data_block_name/=" ","no CIF data block name")

      save :: TEXTFILE@
      CX_label,CX_name,formula,spacegroup :: STR
      in, out :: VEC{INT}@
      done :: BIN


      ! Exit if no outpiut
      if (NOT tonto.is_master_processor) return

      if (cif.allocated) then
         CX_name  = cif.file_name
         CX_label = cif.data_block_name
      else
         CX_name  = "unknown"
         CX_label = "unknown"
      end

      stdout.flush
      stdout.text("Writing Crystal Explorer data file: " // CX_file.name.trim)
      stdout.flush

      ! Redirect stdout to out
      save   = TEXTFILE::stdout                      
      stdout = CX_file

      ! Reset output format
      stdout.save_style
      stdout.set_int_width(7)
      stdout.set_real_fortran_fmt("f")
      stdout.set_real_precision(5)
      stdout.set_real_width(12)
      stdout.set_using_fields(FALSE)

      stdout.flush
      stdout.text("Crystal Explorer data")

      stdout.flush
      stdout.show("begin CIF ",CX_label,dots=FALSE)
      stdout.show("file_name =",CX_name,dots=FALSE)
      stdout.show("data_block_name =",CX_label,dots=FALSE)
      stdout.text("end CIF")
      stdout.flush

      ! Crystal data and cluster/fragment positions
      ! Try saved cluster first
      done = FALSE
      if (.saved.allocated) then
      if (.saved.cluster.allocated) then

         ENSURE(.saved.cluster.info_made,"no cluster information")
         ENSURE(.saved.cluster.crystal.allocated,"no cluster crystal data")
         ENSURE(.saved.cluster.n_fragment_atoms>0,"no fragment size")

         formula    = .saved.cluster.crystal.CIF_chemical_formula
         spacegroup = .saved.cluster.crystal.spacegroup.HM_symbol

         stdout.show("begin crystal ",CX_label,dots=FALSE)
         .saved.cluster.crystal.put_CX(CX_label,formula,spacegroup) 
         .saved.cluster.put_CX(angstrom=.CX_uses_angstrom)
         stdout.flush
         stdout.text("end crystal")

         done = TRUE

      end
      end

      ! Try normal cluster
      if (NOT done) then
      if (.cluster.allocated) then

         ENSURE(.cluster.info_made,"no cluster information")
         ENSURE(.cluster.crystal.allocated,"no cluster crystal data")
         ENSURE(.cluster.n_fragment_atoms>0,"no fragment size")

         formula    = .cluster.crystal.CIF_chemical_formula
         spacegroup = .cluster.crystal.spacegroup.HM_symbol

         stdout.show("begin crystal ",CX_label,dots=FALSE)
         .cluster.crystal.put_CX(CX_label,formula,spacegroup) 
         .cluster.put_CX(angstrom=.CX_uses_angstrom)
         stdout.flush
         stdout.text("end crystal")

         done = TRUE

      end
      end

      ! Finally try .crystal and .atom
      if (NOT done) then
      if (.crystal.allocated) then
      if (.atom.allocated) then

         formula    = .crystal.CIF_chemical_formula
         spacegroup = .crystal.spacegroup.HM_symbol

         stdout.show("begin crystal ",CX_label)
         .crystal.put_CX(CX_label,formula,spacegroup) ! INOUT
         .atom.put_CX(CX_label,angstrom=.CX_uses_angstrom)
         stdout.flush
         stdout.text("end crystal")

         done = TRUE

      end
      end
      end

      ! Isosurface information
      if (.isosurface.allocated) then
      if (.isosurface.atom.allocated) then 

         ! Saved cluster must exist
         done = FALSE
         if (.saved.allocated) then
         if (.saved.cluster.allocated) then
   
            ! Surface name
            stdout.flush
            if (.saved.isosurface.allocated) then
               ! saved_isosurface_plot
               stdout.show("begin surface ",.saved.isosurface.surface_label.trim,dots=FALSE)
            else
               ! Normal isosurface_plot
               stdout.show("begin surface ",.isosurface.surface_label.trim,dots=FALSE)
            end

            ! Surface vertices with IN and OUT atoms
            in  = .saved.cluster.fragment_atom_indices
            out = .saved.cluster.nonfragment_atom_indices 
            if (.saved.isosurface.allocated) then
               ! saved_isosurface_plot
               .saved.isosurface.put_CX(in,out,.atom,angstrom=.CX_uses_angstrom)
            else
               ! Normal isosurface_plot
               .isosurface.put_CX(in,out,.atom,angstrom=.CX_uses_angstrom)
            end

            ! Cluster atoms
            .saved.cluster.put_CX_atoms

            ! Fingerprint data
            if (.saved.isosurface.allocated) then
               ! saved_isosurface_plot
               .saved.isosurface.put_fingerprint_face_atoms(in,out)
            else
               ! Normal isosurface_plot
               .isosurface.put_fingerprint_face_atoms(in,out)
            end

            stdout.text("end surface")
   
            done = TRUE
   
         end
         end
   
         ! Try normal cluster
         if (NOT done) then
         if (.cluster.allocated) then
            DIE("should we be here?")
            done = TRUE
         end
         end
   
         ! Finally try isosurface only
         if (NOT done) then
            DIE("should we be here?")
            done = TRUE
         end

      end
      end

      ! Put back stdout
      stdout.unsave_style
      stdout = save                        

   end

!  ================
!  Lattice energies
!  ================

   make_monomer_energies_for_lattice_energy(res)
   ! But what gets returned? -- DJ
   ! res = [ E_en, E_1e, E_ee, E_ex ]
      self :: allocatable, INOUT
      res  :: VEC{REAL}(4), OUT

      J, K, saved_MOs :: OPMATRIX@
      exchange_factor :: REAL

      exchange_factor = -HALF
      
      saved_MOs = .MOs

      ! Below from scratch? Seems strange
      .make_overlap_mx
      .make_core_mx
      .make_NOs

      ! Make integrals
      .MOs = .NOs
      .make_SCF_density_mx
      .make_core_mx ! again ?!!
      .nuclear_attraction_mx.uncompress
      if (.SCF_data.is_restricted) then
         exchange_factor = -QUARTER
      end

      res(1) = .expectation(.nuclear_attraction_mx)
      res(2) = .expectation(.core_mx)

      J.create(.n_bf,.density_mx.genre)
      K.create(.n_bf,.density_mx.genre)
      if (.use_spherical_basis) then; .make_JK_direct(J,K,.density_mx)
      else;                          .make_JK_engine(J,K,.density_mx)
      end
      res(3) = .expectation(J) * HALF
      res(4) = .expectation(K) * exchange_factor
      res = -TWO * res
      J.destroy
      K.destroy

      .MOs = saved_MOs

   end

   estimate_z result (res) :: PURE
   ! Returns the Z factor of crystallography?
      self :: IN
      res  :: INT
      res = .crystal.n_unit_cell_atoms / .cluster.molecule(1).element.dim
   end

   calculate_cell_dipole_correction(mol_dipole) result (res)
   ! Reference?
      self :: IN
      mol_dipole :: VEC{REAL}(3), IN
      res :: REAL
     
      cell_dipole   :: VEC{REAL}(3)
      unique_symops :: VEC{INT}@
      rot :: MAT{REAL}(3,3)
      i :: INT
     
      unique_symops.to_unique_elements_of(.crystal.asym_symop_for_unit_cell_atom)

      res = ZERO
      cell_dipole = ZERO
      do i = 1, unique_symops.dim
         rot = .crystal.spacegroup.seitz(1:3, 1:3, unique_symops(i))
         rot = matmul(rot, .crystal.unit_cell.inverse_mx)
         rot = matmul(.crystal.unit_cell.direct_mx, rot)
         cell_dipole = cell_dipole + matmul(rot, mol_dipole)
      end
      res = - TWOTHIRD * PI * (cell_dipole.norm) ** 2
      res = res / (unique_symops.dim * .crystal.unit_cell.volume)

      unique_symops.destroy

   end

   create_wavefunction_file_for_lattice :: leaky, private
   ! Make a wavefunction file for a lattice-energy calculation.
      self :: INOUT

      mol   :: MOLECULE@
      model :: STR

      mol.create
      mol.SCF_data.create
      mol.name = trim(.cif.data_block_name)
      .cluster.create_mol_atom_list(mol.atom, 1)

      mol.update_atom_basis_group_info

      mol.SCF_data.SCF_kind = "rhf"
      VEC{PAIR_ENERGY}:get_energy_model(model)
      stdout.show("Making wavefunction for energy model ", trim(model))
      if (trim(model) == "ce-b3lyp") then
         mol.SCF_data.SCF_kind = "rks"
         mol.set_basis_name("6-31G(d,p)")
         mol.SCF_data.set_exchange_functional("b3lypgx")
         mol.SCF_data.set_correlation_functional("b3lypgc")
      end 
      mol.set_basis_name("3-21G")
      mol.make_ANOs_and_interpolators
      mol.scf

   end

   total_lattice_energy(wavefunction_filename)
   ! Some description needed here
      self :: INOUT
      wavefunction_filename :: STR, INOUT
 
      file_exists :: BIN
      mol1, mol2 :: MOLECULE@
      i, current_symop :: INT
      pair_energies :: VEC{PAIR_ENERGY}@
      indices, indices_calc :: VEC{INT}@
      monomer_energies, E :: VEC{REAL}(4)
      e_iter, e_prev, delta_e, radius, prev_radius :: REAL
      sep :: VEC{REAL}(3)
      cell_dipole_correction :: REAL
      mol_dipole :: VEC{REAL}(3)
      convergence_threshold :: REAL
 
 
      ! Central fragment wavefunction stuff
   ! if (.SCF_data.SCF_kind == "rks") then
   !    VEC{PAIR_ENERGY}:set_energy_model("ce-b3lyp")
   ! else
   !    VEC{PAIR_ENERGY}:set_energy_model("ce-hf")
   ! end if
 
      .cluster.create
      .cluster.set_defaults(.crystal) 
      .cluster.set_generation_method("fragment")
      .cluster.set_radius(100.0d0)      ! atomic units
      .cluster.set_defragment(TRUE)
      .cluster.update_info
 
      mol1.create
 
      inquire(file=trim(wavefunction_filename), exist=file_exists)
      if (file_exists) then
         stdout.text("Loading g09 wavefunction")
         mol1.read_wfn_file(trim(wavefunction_filename))
      end
 
      mol1.name = trim(.cif.data_block_name)
      mol1.atom.put
 
 
      stdout.flush
      stdout.text("==============================")
      stdout.text("CrystalExplorer lattice energy")
      stdout.text("==============================")
 
      stdout.text("Calculating monomer energies")
 
      ! Make monomer energies and multipoles
      stdout.flush
      mol1.make_monomer_energies_for_lattice_energy(monomer_energies)
      stdout.text("Monomer energies (Hartree) :")
      stdout.show("Electron-nuclear energy, E_en =", monomer_energies(1))
      stdout.show("One-electron energy,     E_1e =", monomer_energies(2))
      stdout.show("Two-electron energy,     E_ee =", monomer_energies(3))
      stdout.show("Electron exchange,       E_ex =", monomer_energies(4))
      stdout.flush
 
      mol1.make_atomic_multipoles
      mol_dipole = mol1.dipole_moment
      cell_dipole_correction = .calculate_cell_dipole_correction(mol_dipole)
      stdout.show("Cell dipole correction =", cell_dipole_correction)
 
 
      current_symop = 0
      prev_radius = ZERO
      radius = 7.2 ! Roughly 3.8 angstrom
      e_prev = ZERO
      e_iter = ZERO
      delta_e = INT_HUGE
      mol2.create
 
      VEC{PAIR_ENERGY}:get_convergence_threshold(convergence_threshold)
 
      stdout.text("Beginning lattice energy calculation by summation of pair interactions")
      do while (abs(delta_e) > convergence_threshold)
 
         ! 1 being the first molecule in the crystal
         .cluster.make_pairs_within_radius_of(1, pair_energies, radius, prev_radius)
         prev_radius = radius
 
         indices.create(pair_energies.dim)
      ! stdout.show("indices: ", indices)
      ! stdout.flush
         pair_energies(:).symop_id.quick_sort(indices)
         pair_energies(:) = pair_energies(indices)
         indices.destroy
 
      ! stdout.text("Sorted pairs by symop")
      ! stdout.flush
 
         do i = 1, pair_energies.dim
 
            if (pair_energies(i).energy_calculated) cycle
 
            if (current_symop /= pair_energies(i).symop_id) then
               mol2.destroy
               mol2.create
               mol2.read_wfn_file(wavefunction_filename)
               mol2.rotate_by(pair_energies(i).rot)
               mol2.make_overlap_mx
               mol2.make_NOs
               mol2.make_atomic_multipoles
               current_symop = pair_energies(i).symop_id
            end
            mol2.atom.translate_by(pair_energies(i).trans)
            sep = mol1.atom.center_of_mass - mol2.atom.center_of_mass
 
            ! If we have a unique molecule pair calculate the energies
            E = ZERO
 
            ! Disp
            E(1:2) = mol1.symmetric_intermolecular_qm_energies(mol2, monomer_energies)
            E(3)   = mol1.intermolecular_polarization_energy(mol2)
            E(4)   = mol1.atom.Grimme06_dispersion_energy(mol2.atom)
            pair_energies(i).set_energy_components(E)
            pair_energies(i).set_energy_calculated(TRUE)
            mol2.atom.translate_by(-pair_energies(i).trans)
 
         end
 
         e_iter = pair_energies.total_energy(scaled=TRUE)
         delta_e = e_iter - e_prev
         e_prev = e_iter
         indices_calc = pair_energies.calculated_pairs
         pair_energies(indices_calc).put_lattice_energy_table(cell_dipole_correction)
 
         radius = radius + 7.2
         if (radius > .cluster.radius) then
            stdout.show("Convergence not achieved within radius", .cluster.radius)
            exit
         end
      end
 
      mol1.destroy
      mol2.destroy

   end

end
