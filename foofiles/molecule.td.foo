   implicit none

contains

!  ===============
!  Davidson solver
!  ===============

   test_MGS_QR ::: selfless
   ! Test orthogonalisation routines for Davidson diagonaliser.
      self :: INOUT

      V, Q, R :: MAT{REAL}@
      dim     :: INT
      n_keep  :: INT

      ! Sizes
      dim    = 10 
      n_keep =  5

      ! Number Davidson vectors to keep.
      V.create(dim,n_keep)

      ! Initial
      call random_number(V)

      stdout.text("V:")
      stdout.put(V)

      Q.create(dim,n_keep)
      R.create(n_keep,n_keep)

      V.modified_Gram_Schmidt_QR(Q,R)

      stdout.flush
      stdout.text("========================")
      stdout.text("modified Gram-Schmidt QR")
      stdout.text("========================")
      stdout.flush

      stdout.text("Q:")
      stdout.put(Q)

      stdout.text("Q^T Q:")
      stdout.put(matmul(transpose(Q),Q))

      stdout.text("R:")
      stdout.put(R)

      stdout.text("QR - V:")
      stdout.put(matmul(Q,R) - V)

      stdout.flush
      stdout.text("==============")
      stdout.text("Householder QR")
      stdout.text("==============")
      stdout.flush

      V.Householder_QR(Q,R)

      stdout.text("Q:")
      stdout.put(Q)

      stdout.text("Q^T Q:")
      stdout.put(matmul(transpose(Q),Q))

      stdout.text("R:")
      stdout.put(R)

      stdout.text("QR - V:")
      stdout.put(matmul(Q,R) - V)

   end

   test_Davidson_CPS_6 ::: selfless
   ! Test the Davidson algorithm with the example in section 6 of
   ! Crouzeix et al (2006) Inria RR 1353

      A    :: MAT{REAL}@
      evec :: MAT{REAL}@
      eval :: VEC{REAL}@
      d,n_eig, i :: INT
      n_keep,maxit :: INT

      ! Sizes
      d = 30
      n_eig  = 2
      n_keep = 8 
      maxit  = 50

      ! Set up
      A.create(d,d)
      eval.create(d)
      evec.create(d,d)

      A = ZERO
      do i = 1,d
         A(i  ,i  ) = i
         if (i>1) then
            A(i-1,i  ) = HALF
            A(i  ,i-1) = HALF
         end
         if (i<d) then
            A(i+1,i  ) = HALF
            A(i  ,i+1) = HALF
         end
      end
      A(1,d) = HALF
      A(d,1) = HALF

      stdout.flush
      stdout.text("===========")
      stdout.text("Jacobi eigs")
      stdout.text("===========")
      stdout.flush

      A.diagonalize_Jacobi(eval,evec)

      stdout.flush
      stdout.text("eval:")
      stdout.put(eval(1:n_eig))

      stdout.text("evec:")
      stdout.put(evec(:,1:n_eig))

      eval.destroy
      evec.destroy

    ! A.diagonalize_Davidson(eval,evec,n_eig,n_keep,maxit,tolconv=TOL(7))
      ::diagonalize_Davidson(A,eval,evec,n_eig,n_keep,maxit,tolcon=TOL(7))

      stdout.flush
      stdout.text("===============")
      stdout.text("Davidson test 6")
      stdout.text("===============")
      stdout.flush

      stdout.flush
      stdout.text("eval:")
      stdout.put(eval)

      stdout.flush
      stdout.text("evec:")
      stdout.put(evec)

      stdout.flush
      stdout.text("evec^T evec:")
      stdout.put(matmul(transpose(evec),evec))

   end

   diagonalize_Davidson(A,eval,evec,n_eig,n_keep,maxit,tolcon) ::: selfless
   ! Davidson diagonaliser for matrix "A".
   ! See Crouzeix et al (2006) Inria RR 1353
   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
      A :: MAT{REAL}, IN
      eval   :: VEC{REAL}@, OUT ! The "n" eigenvalues
      evec   :: MAT{REAL}@, OUT ! The "n" eigenvector columns
      n_eig  :: INT, IN         ! No. of eigenvalues wanted, "n"
      n_keep :: INT, OUT        ! No. of trial vector sets kept
      maxit  :: INT, IN         ! Max. no. of iterations allowed
      tolcon :: REAL, IN        ! Max. residual vec norm, to end

   ENSURE(n_keep>=3,"Must store minimum 2+1=3 trial vector sets")

      R :: MAT{REAL}@     ! Ritz vectors <- becomes "evec"
      V :: MAT{REAL}@     ! V(:,n)       <- the Davidson trial vectors
      W :: MAT{REAL}@     ! W(:,n)       <- A.V
      H :: MAT{REAL}@     ! A            <- in basis "V"
      T   :: VEC{REAL}@   ! New direction, T
      rvl :: VEC{REAL}@   ! Length of the residual vectors
      iter,n_tr :: INT
      d,n,f,l,i :: INT
      converged :: BIN
      too_many  :: BIN
      collapse  :: BIN
      bot :: REAL

      ! Sizes
      d = A.dim1            ! "d" could be big!
      n = n_eig             ! Usually n << d

      ! Best vectors
      R.create(d,n)         ! Will be "evec"
      eval.create(n*n_keep) ! Will shrink to "n"

      ! Residue vector length
      rvl.create(n) 

      ! Davidson vectors "V"
      V.create(d,n*n_keep)  ! Need all in memory???
      W.create(d,n*n_keep)  ! Space for product A*V, worst case
      T.create(d)           ! Space for new directions

      stdout.flush
      stdout.text("=====================")
      stdout.text("Davidson diagonalizer")
      stdout.text("=====================")
      stdout.flush
      stdout.show("Dimension of matrix            ",d)
      stdout.show("No. of eigenvalues wanted      ",n)
      stdout.show("Max. trial vector sets kept + 1",n_keep)
      stdout.show("Max. no. of iterations         ",maxit)
      stdout.show("Tolerance for convergence      ",tolcon)

      ! Initialize
      V.to_unit_mx          ! Initial guess
      iter = 0              ! Overall iteration count
      n_tr = 0              ! No. of trial vector sets
      converged = FALSE
      too_many  = FALSE

      do 

         ! Iteration & no. of trial vector sets (-1)
         iter = iter + 1
         n_tr = n_tr + 1

         ! First & last trial vector columns
         l = n*(n_tr-1)
         f = l + 1
         l = l + n

         ! 1. Expensive step, extends W
         ! Replace with low-mem matrix product
         W(:,f:l) = matmul(A,V(:,f:l))

         ! 2. Expand Rayleigh matrix
         H.expand(l,l)
         evec.create(l,l)
         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise (increasing eigenvalues)
         H.diagonalize_Jacobi(eval(1:l),evec)

         ! 4. Lowest Ritz vectors
         R = matmul(V(:,1:l),evec(:,1:n))

         ! Too many iters? Collapse space?
         too_many = iter>maxit; if (too_many) exit 
         collapse = n_tr==n_keep

         stdout.flush
         stdout.text("=========")
         stdout.show("iter      ",iter)
         stdout.show("n_tr      ",n_tr)
         stdout.show("collapse? ",collapse)
         stdout.show("too many? ",too_many)
         stdout.show("f         ",f)
         stdout.show("l         ",l)

         if (too_many) then

            ! Save to disk?
            evec.destroy
            H.destroy

         else if (collapse) then

            ! Restart with Ritz vector
            n_tr = 0
            V(:,1:n) = R
          ! V(:,1:n).Householder_QR ! Needed?

            ! Note: clean both
            evec.destroy
            H.destroy

         else 

            ! 5-7. Get residual & new direction T, per-column
            do i = 1,n
        
               ! 5. Residual T & its length
               T = eval(i)*R(:,i) - matmul(W(:,1:l),evec(:,i)) 
               rvl(i) = norm2(T)
        
               ! 6. Precondition
               bot = eval(i) - H(i,i)
               if (abs(bot) < 0.001d0) bot = bot + TOL(2)
               bot= ONE/bot

               ! 7a. Set new direction t
               V(:,l+i) = bot*T
        
            end

         stdout.flush
         stdout.show("conv      ",maxval(abs(rvl)))
         stdout.flush
         stdout.text("eval:")
         stdout.put(eval(1:n))
        
            ! Finished?
            converged = all(rvl<tolcon); if (converged) exit
          
            ! 7. Orthonormalize vectors V
            V(:,1:l+n).modified_Gram_Schmidt_QR
          ! V(:,1:l+n).Householder_QR 
        
            ! Clean up
            evec.destroy

         end

      end

      ENSURE(converged,"No convergence")
      ENSURE(NOT too_many,"Too many iterations")

      ! Clean up
      evec.destroy
      H.destroy
      T.destroy
      W.destroy
      V.destroy
      rvl.destroy

      ! Recover solution
      call move_alloc(R,evec)
      eval.shrink(n)

   end

!  ===================================
!  Two-electron integrals for checking
!  ===================================

   TDHF_in_core ::: leaky
   ! Do an in-core TDHF calculation.
   ! Only does the restricted case so far.
      self :: INOUT

   ENSURE(.atom_info_made, "No atoms!")
   ENSURE(.basis_info_made,"No basis set!")
   ENSURE(.MOs.allocated,  "MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      ApB :: MAT{REAL}@
      AmB, AmB2 :: MAT{REAL}@
      no,nv,nvo :: INT

      ! Minimal setup
      if (.TD_data.deallocated) then
         .TD_data.create
         .TD_data.set_defaults(.n_bf,.n_a,.n_b)
         .TD_data.set_defaults(.MOs.r,.MO_energies.r)
      end
      if (.TD_data.single.deallocated) .TD_data.sort_singles

      ! Dimensions
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! The A-B & A+B matrices
      ApB.create(nvo,nvo)
      AmB.create(nvo,nvo)
      .TD::make_TDHF_ApB_AmB_singlet(ApB,AmB)

      ! Get sqrt
      AmB2.create(nvo,nvo)
      AmB2.to_sqrt_of(AmB)
      AmB = AmB2
      AmB2.destroy

      ! Form eq (28) in Dreuw & Head-Gordon (2005)
      ApB.change_basis_using(AmB)
      AmB.destroy

      ! Diagonalize for excitations
      .TD_data.eval.create(nvo)
      .TD_data.evec.create(nvo,nvo)
    ! ApB.diagonalize_Jacobi(.TD_data.eval,.TD_data.evec)
      ApB.solve_symmetric_eigenproblem(.TD_data.eval,.TD_data.evec)
      .TD_data.eval = sqrt(.TD_data.eval)

      ! Put
      .TD_data.put_results

      ! Clean
      ApB.destroy
      AmB.destroy

   end

   make_TDHF_ApB_AmB_singlet(ApB,AmB) ::: leaky
   ! Return the TDDFT A+B matrix and diagonal A-B, 
   ! respectively "ApB" and "AmB", for a singlet.
   ! They are made directly from the 2ERIs in the
   ! MO basis. See Weiss et al (1993) JCP 99 p1262-70.
      self :: IN
      ApB  :: MAT{REAL}, OUT
      AmB  :: MAT{REAL}, OUT

   ENSURE(.TD_data.allocated,"NO TD_data!")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      n,no,nv,nvo :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea,Ei,val,ex1,ex2 :: REAL
      aibj,ajbi,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .FOCK:make_MO_ERI_chem_integrals(v)

      ApB = ZERO
      AmB = ZERO

      ai = 0

      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         Ea  = .TD_data.Ev(a-no) 
         Ei  = .TD_data.Eo(i)

         val = Ea - Ei
         AmB(ai,ai) = val
         ApB(ai,ai) = val

         bj = 0

         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            aibj = v(a,i,b,j)*FOUR
            ajbi = v(a,j,b,i)
            abji = v(a,b,j,i)

            ApB(ai,bj) = ApB(ai,bj) + aibj - ajbi - abji
            AmB(ai,bj) = AmB(ai,bj)        + ajbi - abji

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AmB.symmetric_reflect
      ApB.symmetric_reflect

   end

!   make_TDHF_ApB_AmB(ApB,AmB) ::: leaky
!   ! Return the TDDFT A+B matrix and diagonal A-B.
!   ! This memory intensive implementation is for checking. 
!   ! See eqns (26)-(28) in Dreuw & Head-Gordon (2005) in
!   ! Chem. Rev. 105 p 4009-37.
!      self :: IN
!      ApB  :: MAT{REAL}, OUT
!      AmB  :: VEC{REAL}, OUT
!
!   ENSURE(.TD_data.allocated,"NO TD_data!")
!   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
!   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
!
!      a,i,ai :: INT
!      b,j,bj :: INT
!      n,no,nv,nvo :: INT
!      Ea,Ei,val :: REAL
!      vovo :: MAT{REAL}@
!      vvoo :: MAT{REAL}@
!
!      ! Dimensions
!      n   = .n_bf
!      no  = .n_a
!      nv  = n - no
!      nvo = nv*no
!
!      ! The VOVO integrals
!      vovo.create(nvo,nvo)
!      vvoo.create(nvo,nvo)
!      .TD::make_VOVO_VVOO_ERIs(vovo,vvoo)
!
!
!      ! Initialize
!      ApB = ZERO ! A+B
!      AmB = ZERO ! A-B
!
!      ! Check
!      ai = 0
!      do i = 1,no
!         Ei = .TD_data.Eo(i)
!         do a = 1,nv
!            ai = ai + 1
!            Ea = .TD_data.Ev(a)
!            val = Ea - Ei
!            AmB(ai)    = val
!            ApB(ai,ai) = val
!            bj = 0
!            do j = 1,no
!            do b = 1,nv
!               bj = bj + 1
!               val = vovo(ai,bj) - vvoo(ai,bj)
!               val = TWO*val
!               ApB(ai,bj) = ApB(ai,bj) + val
!               ApB(bj,ai) = ApB(bj,ai) + val
!            end
!            end
!         end
!      end
!
!      ! Clean
!      vvoo.destroy
!      vovo.destroy
!
!   end

   test_VOVO
   ! Test orthogonalisation routines for Davidson diagonaliser.
      self :: IN

      n,no,nv,nvo :: INT
      vovo :: MAT{REAL}@
      vvoo :: MAT{REAL}@

      ! Dimensions
      n   = .n_bf
      no  = .n_a
      nv  = n - no
      nvo = nv*no

      ! The VOVO integrals
      vovo.create(nvo,nvo)
      vvoo.create(nvo,nvo)

      .TD::make_VOVO_VVOO_ERIs(vovo,vvoo)

      vvoo.destroy
      vovo.destroy

   end

   make_VOVO_VVOO_ERIs(vovo,vvoo) ::: leaky
   ! Return the "vovo" and "vvoo ERIs stored as a 2D matrix, 
   ! with indices 12 and 34 linearized, respectively.
      self :: IN
      vovo :: MAT{REAL}, OUT
      vvoo :: MAT{REAL}, OUT

   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      W :: MAT{REAL}@
      n,no,nv,nvo :: INT
      p,q    :: INT
      a,i,ai :: INT
      b,j,bj :: INT

      ! Dimensions
      n   = .n_bf
      no  = .n_a
      nv  = n - no
      nvo = nv*no

      ! The VOVO integrals
    ! vovo.create(nvo,nvo)

      ! Get 2e integrals
      v.create(n,n,n,n)
      v = ZERO
      .FOCK:make_ERI_integrals(v)

      ! Change first two indices
      do p = 1,n
         v(:,:,p,p).change_basis_using(.MOs.r)
         do q = 1,p-1
            v(:,:,p,q).change_basis_using(.MOs.r)
            v(:,:,q,p) = v(:,:,p,q)
         end
      end

      ! VOVO
      W.create(nv,no)
      ai = 0
      do i = 1,no
      do a = no+1,n
         ai = ai + 1
         v(a,i,:,:).change_basis_to(W,.MOs.r(:,no+1:),.MOs.r(:,1:no))
         vovo(ai,:) = reshape(W,[nvo])
      end
      end
      W.destroy

      ! VVOO
      ! Can join with above?
      W.create(no,no)
      do b = no+1,n
      do a = no+1,n
         v(a,b,:,:).change_basis_to(W,.MOs.r(:,1:no),.MOs.r(:,1:no))
         do j = 1,no
         do i = 1,no
            ai = a-no + (i-1)*nv
            bj = b-no + (j-1)*nv
            vvoo(ai,bj) = W(i,j)
         end
         end
      end
      end
      W.destroy

      ! Check
    ! val = huge(ONE)
    ! ai = 0
    ! do i = 1,no
    ! do a = no+1,n
    !    ai = ai + 1
    !    bj = 0
    !    do j = 1,no
    !    do b = no+1,n
    !       bj = bj + 1
    !       val = min(val,abs(vovo(ai,bj)-v(a,i,b,j)))
    !    end
    !    end
    ! end
    ! end
    ! stdout.flush
    ! stdout.show("difference = ",val)

      v.destroy

   end

end
