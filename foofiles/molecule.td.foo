!  ===============
!  Davidson solver
!  ===============

   test_MGS_QR ::: selfless
   ! Test orthogonalisation routines for Davidson diagonaliser.
      self :: INOUT

      V, Q, R :: MAT{REAL}@
      dim     :: INT
      n_keep  :: INT

      ! Sizes
      dim    = 10 
      n_keep =  5

      ! Number Davidson vectors to keep.
      V.create(dim,n_keep)

      ! Initial
      call random_number(V)

      stdout.text("V:")
      stdout.put(V)

      Q.create(dim,n_keep)
      R.create(n_keep,n_keep)

      V.modified_Gram_Schmidt_QR(Q,R)

      stdout.flush
      stdout.text("========================")
      stdout.text("modified Gram-Schmidt QR")
      stdout.text("========================")
      stdout.flush

      stdout.text("Q:")
      stdout.put(Q)

      stdout.text("Q^T Q:")
      stdout.put(matmul(transpose(Q),Q))

      stdout.text("R:")
      stdout.put(R)

      stdout.text("QR - V:")
      stdout.put(matmul(Q,R) - V)

      stdout.flush
      stdout.text("==============")
      stdout.text("Householder QR")
      stdout.text("==============")
      stdout.flush

      V.Householder_QR(Q,R)

      stdout.text("Q:")
      stdout.put(Q)

      stdout.text("Q^T Q:")
      stdout.put(matmul(transpose(Q),Q))

      stdout.text("R:")
      stdout.put(R)

      stdout.text("QR - V:")
      stdout.put(matmul(Q,R) - V)

   end

   test_Davidson_CPS_6 ::: selfless
   ! Test the Davidson algorithm with the example in section 6 of
   ! Crouzeix et al (2006) Inria RR 1353
      A    :: MAT{REAL}@
      evec :: MAT{REAL}@
      eval :: VEC{REAL}@
      d,n_evals, i :: INT
      n_keep,maxit :: INT

      ! Sizes
      d = 30
      n_evals = 2
      n_keep  = 8 
      maxit   = 50

      ! Set up
      A.create(d,d)
      eval.create(d)
      evec.create(d,d)

      A = ZERO
      do i = 1,d
         A(i  ,i  ) = i
         if (i>1) then
            A(i-1,i  ) = HALF
            A(i  ,i-1) = HALF
         end
         if (i<d) then
            A(i+1,i  ) = HALF
            A(i  ,i+1) = HALF
         end
      end
      A(1,d) = HALF
      A(d,1) = HALF

      stdout.flush
      stdout.text("===========")
      stdout.text("Jacobi eigs")
      stdout.text("===========")
      stdout.flush

      A.diagonalize_Jacobi(eval,evec)

      stdout.flush
      stdout.text("eval:")
      stdout.put(eval(1:n_evals))

      stdout.text("evec:")
      stdout.put(evec(:,1:n_evals))

      eval.destroy
      evec.destroy

    ! A.diagonalize_Davidson(eval,evec,n_evals,n_keep,maxit,tolconv=TOL(7))
      ::diagonalize_Davidson(A,eval,evec,n_evals,n_keep,maxit,tolcon=TOL(7))

      stdout.flush
      stdout.text("===============")
      stdout.text("Davidson test 6")
      stdout.text("===============")
      stdout.flush

      stdout.flush
      stdout.text("eval:")
      stdout.put(eval)

      stdout.flush
      stdout.text("evec:")
      stdout.put(evec)

      stdout.flush
      stdout.text("evec^T evec:")
      stdout.put(matmul(transpose(evec),evec))

   end

   diagonalize_Davidson(A,eval,evec,n_evals,n_keep,maxit,tolcon) ::: selfless
   ! Davidson diagonaliser for matrix "A".
   ! See Crouzeix et al (2006) Inria RR 1353
   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
      A :: MAT{REAL}, IN
      eval :: VEC{REAL}@, OUT ! The "n" eigenvalues
      evec :: MAT{REAL}@, OUT ! The "n" eigenvector columns
      n_evals :: INT, IN      ! No. of eigenvalues wanted, "n"
      n_keep  :: INT, OUT     ! No. of trial vector sets kept
      maxit   :: INT, IN      ! Max. no. of iterations allowed
      tolcon  :: REAL, IN     ! Max. residual vec norm, to end

   ENSURE(n_keep>=3,"Must store minimum 2+1=3 trial vector sets")

      R :: MAT{REAL}@     ! Ritz vectors <- becomes "evec"
      V :: MAT{REAL}@     ! V(:,n)       <- the Davidson trial vectors
      W :: MAT{REAL}@     ! W(:,n)       <- A.V
      H :: MAT{REAL}@     ! A            <- in basis "V"
      T   :: VEC{REAL}@   ! New direction, T
      rvl :: VEC{REAL}@   ! Length of the residual vectors
      iter,n_tr :: INT
      d,n,f,l,i :: INT
      converged :: BIN
      too_many  :: BIN
      collapse  :: BIN
      bot :: REAL

      ! Sizes
      d = A.dim1            ! "d" could be big!
      n = n_evals           ! Usually n << d

      ! Best vectors
      R.create(d,n)         ! Will be "evec"
      eval.create(n*n_keep) ! Will shrink to "n"

      ! Residue vector length
      rvl.create(n) 

      ! Davidson vectors "V"
      V.create(d,n*n_keep)  ! Need all in memory???
      W.create(d,n*n_keep)  ! Space for product A*V, worst case
      T.create(d)           ! Space for new directions

    ! .TD_data.put_D_table_header

      ! Initialize
      V.to_unit_mx          ! Initial guess
      iter = 0              ! Overall iteration count
      n_tr = 0              ! No. of trial vector sets
      converged = FALSE
      too_many  = FALSE

      do 

         ! Iteration & no. of trial vector sets (-1)
         iter = iter + 1
         n_tr = n_tr + 1

         ! First & last trial vector columns
         l = n*(n_tr-1)
         f = l + 1
         l = l + n

         ! 1. Expensive step, extends W
         ! Replace with low-mem matrix product
         W(:,f:l) = matmul(A,V(:,f:l))

         ! 2. Expand Rayleigh matrix
         H.expand(l,l)
         evec.create(l,l)
         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise (increasing eigenvalues)
         H.diagonalize_Jacobi(eval(1:l),evec)

         ! 4. Lowest Ritz vectors
         R = matmul(V(:,1:l),evec(:,1:n))

         ! Too many iters? Collapse space?
         too_many = iter>maxit; if (too_many) exit 
         collapse = n_tr==n_keep

         stdout.flush
         stdout.text("=========")
         stdout.show("iter      ",iter)
         stdout.show("n_tr      ",n_tr)
         stdout.show("collapse? ",collapse)
         stdout.show("too many? ",too_many)
         stdout.show("f         ",f)
         stdout.show("l         ",l)

         if (too_many) then

            ! Save to disk?
            evec.destroy
            H.destroy

         else if (collapse) then

            ! Restart with Ritz vector
            n_tr = 0
            V(:,1:n) = R
          ! V(:,1:n).Householder_QR ! Needed?

            ! Note: clean both
            evec.destroy
            H.destroy

         else 

            ! 5-7. Get residual & new direction T, per-column
            do i = 1,n
        
               ! 5. Residual T & its length
               T = eval(i)*R(:,i) - matmul(W(:,1:l),evec(:,i)) 
               rvl(i) = norm2(T)
        
               ! 6. Precondition
               bot = eval(i) - H(i,i)
               if (abs(bot) < 0.001d0) bot = bot + TOL(2)
               bot= ONE/bot

               ! 7a. Set new direction t
               V(:,l+i) = bot*T
        
            end

         stdout.flush
         stdout.show("conv      ",maxval(abs(rvl)))
         stdout.flush
         stdout.text("eval:")
         stdout.put(eval(1:n))
        
            ! Finished?
            converged = all(rvl<tolcon); if (converged) exit
          
            ! 7. Orthonormalize vectors V
            V(:,1:l+n).modified_Gram_Schmidt_QR
          ! V(:,1:l+n).Householder_QR 
        
            ! Clean up
            evec.destroy

         end

      end

      ENSURE(converged,"No convergence")
      ENSURE(NOT too_many,"Too many iterations")

      ! Clean up
      evec.destroy
      H.destroy
      T.destroy
      W.destroy
      V.destroy
      rvl.destroy

      ! Recover solution
      call move_alloc(R,evec)
      eval.shrink(n)

   end

!  ==============
!  Excited states
!  ==============

   TD_excited_states ::: leaky
   ! Do an in-core TD excited state calculation.
   ! Only does the restricted case so far.
      self :: INOUT

   ENSURE(.atom_info_made, "No atoms!")
   ENSURE(.basis_info_made,"No basis set!")
   ENSURE(.MOs.allocated,  "MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      ! Minimal setup
      if (.TD_data.Eo.deallocated) then
         .TD_data.set_defaults(.n_bf,.n_a,.n_b)
         .TD_data.set_defaults(.MOs.r,.MO_energies.r)
      end
      if (.TD_data.single.deallocated) then
         .TD_data.sort_singles
      end

      ! Which TD calc?
      select case (.TD_data.implementation)

      case ("in-core ")
         select case (.TD_data.method)
         case("r-cis-s=0&s=1    "); .TD:make_r_CIS_S0_S1_IC  ! <---
         case("r-cis-s=0        "); .TD:make_r_CIS_S0_IC
         case("r-cis-singlet    "); .TD:make_r_CIS_S0_IC
         case("r-cis-s=1        "); .TD:make_r_CIS_S1_IC
         case("r-cis-triplet    "); .TD:make_r_CIS_S1_IC
         case("r-cis-s=0-ss     "); .TD:make_r_CIS_S0_SS_IC  ! <---
         case("r-cis-singlet-ss "); .TD:make_r_CIS_S0_SS_IC
         case("r-tdhf-s=0&s=1   "); .TD:make_r_TDHF_S0_S1_IC
         case("r-tdhf-s=0       "); .TD:make_r_TDHF_S0_IC
         case("r-tdhf-singlet   "); .TD:make_r_TDHF_S0_IC
         case("r-tdhf-s=1       "); .TD:make_r_TDHF_S1_IC
         case("r-tdhf-triplet   "); .TD:make_r_TDHF_S1_IC
         case("u-cis            "); .TD:make_u_CIS_IC        ! <---
         case default; UNKNOWN(.TD_data.method)
         end

      case ("davidson")
         select case (.TD_data.method)
         case("r-cis-s=0-ss     "); .TD:make_r_CIS_S0_SS
         case("r-cis-s=0-ss-d1  "); .TD:make_r_CIS_S0_SS_D1
         case("r-cis-s=0-ss-d2  "); .TD:make_r_CIS_S0_SS_D2
         case default; UNKNOWN(.TD_data.method)
         end

      case default
         UNKNOWN(.TD_data.implementation)

      end

      ! Put
      .TD_data.put_results

   end

! Efficient methods

   make_r_CIS_S0_SS
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! via Davidson. See Crouzeix et al (2006) Inria RR 1353.
   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
   ! NOTE: there is a complex interaction with .TD_data
   ! which keeps iteration and convergence information.
      self :: INOUT

      ! Main variables
      H :: MAT{REAL}@     ! A, in trial basis "V"
      eval :: VEC{REAL}@  ! The "n" eigenvalues
      evec :: MAT{REAL}@  ! The "n" eigenvector columns

      ! Matrix temporaries
      A :: MAT{REAL}@  
      V :: MAT{REAL}@     ! V(:,n) <- Davidson trial vectors
      W :: MAT{REAL}@     ! W(:,n) <- A.V in MO basis
      T :: VEC{REAL}@     ! T      <- new ditrection
      DM :: MAT3{REAL}@   ! DM     <-  V  in AO basis
      AV :: MAT3{REAL}@   ! AV     <- A.V in AO basis

      d, n   :: INT
      n_keep :: INT
      f,l, i :: INT
      maxres :: REAL
      bot :: REAL

      ! Start up
      .TD_data.initialise_iteration ! Leaky
      .TD_data.set_D_table_headings
      .TD_data.put_D_table_header

      ! Sizes
      d = .TD_data.deltaE.dim  ! "d" could nvo
      n = .TD_data.n_evals     ! Usually n << d
      n_keep = .TD_data.n_keep ! No. of trial vectors to keep

      ! Temporaries
      V.create(d,n*n_keep)     ! Davidson trial vector colums "V"
      W.create(d,n*n_keep)     ! A.V in MO basis
      T.create(d)              ! New directions, scaled residual
      DM.create(n,.n_bf,.n_bf) ! Density matrices
      AV.create(n,.n_bf,.n_bf) ! A.V in AO basis

      V(:,1:n).to_unit_mx      ! Initialise "V", choose wisely

      do ! Davidson loop

         ! Next iteration
         .TD_data.update_iteration

         ! Collapse subspace down?
         if (.TD_data.collapse) then
            .TD_data.reset_subspace  ! Keep one trial set
            V(:,1:n) = .TD_data.evec ! Restart with last one
            H.destroy                ! Remake H
         end

         ! 1. Expensive step: extend W = A.V
         f = .TD_data.fst_trial_vector
         l = .TD_data.lst_trial_vector
         ! Below does: W(:,f:l) = matmul(A,V(:,f:l)) 
       ! .TD_data.do_diagnl_AV_part(V(:,f:l),W(:,f:l)) ! 1e: Set W = diag(A).V
     W(:,f:l) = ZERO
         .TD_data.transform_V_to_DM_v0(V(:,f:l),DM)   ! Back transform to DM
         .FOCK:make_r_F_direct_v1(AV,DM)              ! 2e: A.V in AO basis
         .TD_data.transform_AV_to_V_v0(AV,W(:,f:l))   ! W = W + (AV)_ai
     stdout.text("W1:")
     stdout.put(W(:,f:l))

         ! 1. Expensive step, extends W
      A.create(d,d)
   ! .TD:make_r_CIS_S0_SS(A)
     .TD:make_r_CIS_S0_SS(A,one=FALSE)
   ! .TD:make_r_CIS_S0_SS(A,two=FALSE)
     W(:,f:l) = matmul(A,V(:,f:l)) 
     stdout.text("W2:")
     stdout.put(W(:,f:l))
     stop

         ! 2. Expand Rayleigh matrix
         H.expand(l,l)    ! A in V basis
         evec.create(l,l)
         eval.create(l)
         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise (increasing eigenvalues)
         H.solve_symmetric_eigenproblem(eval(1:l),evec)

         ! 4. Keep Ritz vectors "R" (lowest only)
         .TD_data.eval = eval(1:n)
         .TD_data.evec = matmul(V(:,1:l),evec(:,1:n))

          ! 5-7. Get residual & add new directions
          maxres = ZERO
          do i = 1,n
          
             ! 5. Residual T & its length
             T = eval(i)*.TD_data.evec(:,i) & ! "R"
               - matmul(W(:,1:l), evec(:,i) ) 
             maxres = max(norm2(T),maxres)
          
             ! 6. Precondition
             bot = eval(i) - H(i,i)
             if (abs(bot)<TOL(3)) bot = bot + TOL(2)
             bot= ONE/bot
         
             ! 7a. Set new direction T
             V(:,l+i) = bot*T
          
          end
          .TD_data.set_max_res(maxres)

         ! Clean up
         eval.destroy
         evec.destroy
        
         ! 7. Orthonormalize vectors V ?
         if (NOT .TD_data.converged) then
            V(:,1:l+n).modified_Gram_Schmidt_QR
          ! V(:,1:l+n).Householder_QR 
         end

         ! Print out table & finish? !!!!!!
         .TD_data.put_D_table_body_and_footer
         if (.TD_data.Davidson_done)   exit
         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

      end

      ! Clean up
      H.destroy
      T.destroy
      W.destroy
      V.destroy

   end

   make_r_CIS_S0_SS(AA,one,two) ::: leaky
   ! Make the restricted CIS singlet A matrix in "AA".
   ! If "one" is FALSE then skip 1-electron part.
   ! If "two" is FALSE then skip 2-electron part.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT
      AA  :: MAT{REAL}, OUT
      one :: BIN, optional, IN
      two :: BIN, optional, IN

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      a,i,ai :: INT
      b,j,bj :: INT
      lo, hv :: INT
      d,n,no :: INT
      aibj, abji :: REAL
      do1, do2 :: BIN

      ! Do one electron part?   
      do1 = TRUE 
      if (present(one)) do1 = one

      ! Do two electron part?
      do2 = TRUE 
      if (present(two)) do2 = two

      ! Dimensions
      d   = .TD_data.deltaE.dim
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      lo  = .TD_data.min_OMO
      hv  = .TD_data.max_VMO + no ! NOTE

      ! A matrix (leaky)
      AA = ZERO

      if (do1) then

         ! Do diagonal part
         if (.TD_data.Fv.deallocated) then
        
            ! Eigenvalue difference
            do ai = 1,d
               AA(ai,ai) = .TD_data.deltaE(ai)
            end
        
         else
        
            ! Non-diagonal VMO part
            do ai = 1,d
               a = .TD_data.single(ai,1)
               i = .TD_data.single(ai,2)
               AA(ai,ai) = -.TD_data.Eo(i)
               do bj = 1,d
                  b = .TD_data.single(bj,1)
                  j = .TD_data.single(bj,2)
                  if (i==j) then
                     AA(ai,bj) = AA(ai,bj) + .TD_data.Fv(a,b)
                  end
               end
            end
        
         end

      end

      if (do2) then

         ! Get ERIs in MO basis
         v.create([lo,hv],[lo,hv],[lo,hv],[lo,hv])
       ! .FOCK:make_MO_ERI_chem_integrals(v)
       ! .FOCK:make_MO_ERIs_v0(v,lo,hv)
         .FOCK:make_MO_ERIs_v1(v,lo,hv)
       ! .FOCK:make_MO_ERIs_v2(v,lo,hv)
   
         ! Two-electron part
         do ai = 1,d
            a = .TD_data.single(ai,1) + no
            i = .TD_data.single(ai,2)
            do bj = 1,d
               b = .TD_data.single(bj,1) + no
               j = .TD_data.single(bj,2)
               ! Integrals
               aibj = v(a,i,b,j)
               abji = v(a,b,j,i)
               ! Weiss et al (1993) JCP 99 p1262-70: ! Singlet
             ! AA(ai,bj) = AA(ai,bj) + TWO*aibj - abji ! eqn (3)+(5)/2
               AA(ai,bj) = AA(ai,bj)            - abji ! eqn (3)+(5)/2
             ! AA(ai,bj) = AA(ai,bj) + TWO*aibj ! - abji ! eqn (3)+(5)/2
            end
         end
   
         v.destroy
   
      end

      ! Symmetrize
      AA.symmetric_reflect

   end

   make_r_CIS_S0_SS_D2
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! via Davidson. See Crouzeix et al (2006) Inria RR 1353.
   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
      self :: INOUT

      ! Key results
      A :: MAT{REAL}@     ! A matrix
      H :: MAT{REAL}@     ! A, in trial basis "V"
      eval :: VEC{REAL}@  ! The "n" eigenvalues
      evec :: MAT{REAL}@  ! The "n" eigenvector columns

      ! Matrix temporaries
      V :: MAT{REAL}@     ! V(:,n) <- the Davidson trial vectors
      W :: MAT{REAL}@     ! W(:,n) <- A.V
      T :: VEC{REAL}@     ! T      <- new ditrection

    ! MOv :: MAT{REAL}@ 
    ! MOo :: MAT{REAL}@ 

      d, n   :: INT
      n_keep :: INT
      f,l, i :: INT
      maxres :: REAL
      bot :: REAL

      ! Start up
      .TD_data.initialise_iteration ! Leaky
      .TD_data.set_D_table_headings
      .TD_data.put_D_table_header

      ! Sizes
      d = .TD_data.deltaE.dim  ! "d" could nvo
      n = .TD_data.n_evals     ! Usually n << d
      n_keep = .TD_data.n_keep ! No. of trial vectors to keep

      ! Temporaries
      V.create(d,n*n_keep)  ! Davidson trial vectors "V"
      V.to_unit_mx          ! Initialise trial evecs
      W.create(d,n*n_keep)  ! Space for product A*V, worst case
      T.create(d)           ! Space for new directions

      ! MOs to transform
    ! no = .TD_data.n_occ
    ! MOv = .MOs.r(:,no+1:  )
    ! MOo = .MOs.r(:,   1:no) 

      ! The A matrix
      A.create(d,d)
      .TD:make_r_CIS_S0_SS(A)

      do ! Davidson loop

         ! Next iteration.
         .TD_data.update_iteration

         ! Collapse subspace?
         if (.TD_data.collapse) then

            ! Keep one trial set
            .TD_data.reset_subspace 

            ! Restart last Ritz vector
            V(:,1:n) = .TD_data.evec
          ! V(:,1:n).Householder_QR ! Needed?

            ! Remake
            H.destroy

         end

         ! Trial vector columns
         f = .TD_data.fst_trial_vector
         l = .TD_data.lst_trial_vector

         ! 2. Expand Rayleigh matrix
         H.expand(l,l)                 ! A in reduced basis
         evec.create(l,l)
         eval.create(l)
         W(:,f:l) = matmul(A,V(:,f:l)) ! 1. Expensive step, extends W
         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise (increasing eigenvalues)
       ! H.diagonalize_Jacobi(eval(1:l),evec)
         H.solve_symmetric_eigenproblem(eval(1:l),evec)

         ! 4. Keep lowest Ritz vectors "R"
         .TD_data.eval = eval(1:n)
         .TD_data.evec = matmul(V(:,1:l),evec(:,1:n))
         !!!!!!!!!!!!!!!!!!!!!!!!

       ! stdout.flush
       ! stdout.text("=========")
       ! stdout.show("iter      ",.TD_data.iteration)
       ! stdout.show("n_tr      ",.TD_data.n_trial)
       ! stdout.show("collapse? ",.TD_data.collapse)
       ! stdout.show("too many? ",.TD_data.reached_max_it)
       ! stdout.show("f         ",f)
       ! stdout.show("l         ",l)

          ! 5-7. Get residual 
          ! Append new directions
          maxres = ZERO
          do i = 1,n
          
             ! 5. Residual T & its length
             T = eval(i)*.TD_data.evec(:,i) & ! "R"
               - matmul(W(:,1:l),evec(:,i) ) 
             maxres = max(norm2(T),maxres)
          
             ! 6. Precondition
             bot = eval(i) - H(i,i)
             if (abs(bot)<TOL(3)) bot = bot + TOL(2)
             bot= ONE/bot
         
             ! 7a. Set new direction t
             V(:,l+i) = bot*T
          
          end
          .TD_data.set_max_res(maxres)

       ! stdout.flush
       ! stdout.show("conv      ",maxres)
       ! stdout.flush
       ! stdout.text("eval:")
       ! stdout.put(eval(1:n))
        
         ! Clean up
         eval.destroy
         evec.destroy
        
         if (NOT .TD_data.converged) then
            ! Continue ...
            ! 7. Orthonormalize vectors V
            V(:,1:l+n).modified_Gram_Schmidt_QR
          ! V(:,1:l+n).Householder_QR 
         end

         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
         .TD_data.put_D_table_body_and_footer
         if (.TD_data.Davidson_done)   exit
         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

      end

      ! Clean up
      H.destroy
      T.destroy
      W.destroy
      V.destroy

   end

   make_r_CIS_S0_SS_D1
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT

      ! Key results
      eval :: VEC{REAL}@  ! The "n" eigenvalues
      evec :: MAT{REAL}@  ! The "n" eigenvector columns
      maxit  :: INT       ! Max. no. of iterations allowed
      tolcon :: REAL      ! Max. residual vec norm, to end
      n_keep :: INT       ! No. of trial vectors to keep

      ! Matrix temporaries
      A :: MAT{REAL}@     ! A matrix
      R :: MAT{REAL}@     ! Ritz vectors <- becomes "evec"
      V :: MAT{REAL}@     ! V(:,n)       <- the Davidson trial vectors
      W :: MAT{REAL}@     ! W(:,n)       <- A.V
      H :: MAT{REAL}@     ! A            <- in basis "V"
      T :: VEC{REAL}@     ! New direction, T
      rvl :: VEC{REAL}@   ! Length of the residual vectors

      d,n,no :: INT
      f,l, i :: INT
      iter :: INT
      n_tr :: INT
      converged :: BIN
      too_many  :: BIN
      collapse  :: BIN
      bot :: REAL

      ! Sizes
      d  = .TD_data.deltaE.dim  ! "d" could nvo
      n  = .TD_data.n_evals     ! Usually n << d
      no = .TD_data.n_occ

      maxit  = .TD_data.max_iterations ! Max iterations
      tolcon = .TD_data.tol_Davidson   ! Convergence
      n_keep = .TD_data.n_keep         ! No. of trial vectors to keep

      ! Best vectors
      R.create(d,n)         ! Will be "evec"
      eval.create(n*n_keep) ! Will shrink to "n"

      ! The A matrix
      A.create(d,d)
      .TD:make_r_CIS_S0_SS(A)

      ! Residue vector length
      rvl.create(n) 

      ! Davidson vectors "V"
      V.create(d,n*n_keep)  ! Need all in memory???
      W.create(d,n*n_keep)  ! Space for product A*V, worst case
      T.create(d)           ! Space for new directions

      ! Initialize
      V.to_unit_mx          ! Initial guess
      iter = 0              ! Overall iteration count
      n_tr = 0              ! No. of trial vector sets
      converged = FALSE
      too_many  = FALSE

      !!!!!!!!!!!!!!!!!!!!!!!!!!!!!
      .TD_data.set_D_table_headings
      .TD_data.put_D_table_header
      !!!!!!!!!!!!!!!!!!!!!!!!!!!!!

      do 

         ! Iteration & no. of trial vector sets (-1)
         iter = iter + 1
         n_tr = n_tr + 1

         ! First & last trial vector columns
         l = n*(n_tr-1)
         f = l + 1
         l = l + n

         ! 1. Expensive step, extends W
         ! Replace with low-mem matrix product
         W(:,f:l) = matmul(A,V(:,f:l))

         ! 2. Expand Rayleigh matrix
         H.expand(l,l)
         evec.create(l,l)
         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise (increasing eigenvalues)
       ! H.diagonalize_Jacobi(eval(1:l),evec)
         H.solve_symmetric_eigenproblem(eval(1:l),evec)

         ! 4. Lowest Ritz vectors
         R = matmul(V(:,1:l),evec(:,1:n))

         ! Too many iters? Collapse space?
         too_many = iter>maxit; if (too_many) exit 
         collapse = n_tr==n_keep

         stdout.flush
         stdout.text("=========")
         stdout.show("iter      ",iter)
         stdout.show("n_tr      ",n_tr)
         stdout.show("collapse? ",collapse)
         stdout.show("too many? ",too_many)
         stdout.show("f         ",f)
         stdout.show("l         ",l)

         if (too_many) then

            ! Save to disk?
            evec.destroy
            H.destroy

         else if (collapse) then

            ! Restart with Ritz vector
            n_tr = 0
            V(:,1:n) = R
            V(:,1:n).Householder_QR ! Needed?

            ! Note: clean both
            evec.destroy
            H.destroy

         else 

            ! 5-7. Get residual & new direction T, per-column
            do i = 1,n
        
               ! 5. Residual T & its length
               T = eval(i)*R(:,i) - matmul(W(:,1:l),evec(:,i)) 
               rvl(i) = norm2(T)
        
               ! 6. Precondition
               bot = eval(i) - H(i,i)
               if (abs(bot) < 0.001d0) bot = bot + TOL(2)
               bot= ONE/bot

               ! 7a. Set new direction t
               V(:,l+i) = bot*T
        
            end

         stdout.flush
         stdout.show("conv      ",maxval(abs(rvl)))
         stdout.flush
         stdout.text("eval:")
         stdout.put(eval(1:n))
        
            ! Finished?
            converged = all(rvl<tolcon); if (converged) exit
          
            ! 7. Orthonormalize vectors V
            V(:,1:l+n).modified_Gram_Schmidt_QR
          ! V(:,1:l+n).Householder_QR 
        
            ! Clean up
            evec.destroy

         end

      end

      ENSURE(converged,"No convergence")
      ENSURE(NOT too_many,"Too many iterations")

      ! Clean up
      evec.destroy
      H.destroy
      T.destroy
      W.destroy
      V.destroy
      rvl.destroy
      A.destroy

      ! Recover & store solution
      eval.shrink(n)
      call move_alloc(eval,.TD_data.eval)
      call move_alloc(R   ,.TD_data.evec)

   end

! In-core methods

   TD_excited_state_solver_IC(AA,append) ::: leaky, private
   ! Diagonalise the CIS/TD matrix "A", or similar, in-core.
   ! Triplet (S=1) results are appended if requested.
      self :: INOUT
      AA   :: MAT{REAL}, IN
      append :: BIN, optional, IN

      ind :: VEC{INT}@
      dim :: INT
      add :: BIN

      add = FALSE
      if (present(append)) add = append

      ! Dimensions
      dim = AA.dim1

      ! Remove spin labels
      .TD_data.S.destroy

      ! Diagonalise
      if (.TD_data.has_states AND add) then

         ! Will this work for state selection?
         ENSURE(.TD_data.method/="u-cis","incorrect call, wrong method")
         ENSURE(.TD_data.eval.dim ==dim,"incorrect number of states")
         ENSURE(.TD_data.evec.dim2==dim,"incorrect number of states")

         ! Append triplets to singlets
         .TD_data.eval.expand(2*dim)
         .TD_data.evec.expand(dim,2*dim)
         .TD_data.S.create(2*dim)
         .TD_data.S(    1:dim) = 0 
         .TD_data.S(dim+1:   ) = 1 
         AA.solve_symmetric_eigenproblem(.TD_data.eval(dim+1:),.TD_data.evec(:,dim+1:))

         ! Sqrt? Only latest eigenvalues
         if (.TD_data.do_sqrt_evals) then
         .TD_data.eval(dim+1:) = sqrt(.TD_data.eval(dim+1:))
         end

         ! Sort
         ind.create(2*dim)
         .TD_data.eval.quick_sort(ind)
   
         ! Reorder
         .TD_data.S    = .TD_data.S(ind)
         .TD_data.eval = .TD_data.eval(ind)
         .TD_data.evec = .TD_data.evec(:,ind)
         ind.destroy

      else

         ! Don't append !!!!!!!!!!
         .TD_data.eval.create(dim)   
         .TD_data.evec.create(dim,dim)
         AA.solve_symmetric_eigenproblem(.TD_data.eval,.TD_data.evec)

         ! Sqrt?
         if (.TD_data.do_sqrt_evals) then
         .TD_data.eval = sqrt(.TD_data.eval)
         end

      end

   end

! Singlet & triplet

   make_r_CIS_S0_S1_IC ::: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet (S=0) 
   ! and triplet (S=1) calculation and merge and sort results
   ! by increasing excitation energy.
      self :: INOUT

      .TD::make_r_CIS_S0_IC
      .TD::make_r_CIS_S1_IC(append=TRUE)

   end

   make_r_TDHF_S0_S1_IC ::: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet (S=0) 
   ! and triplet (S=1) calculation and merge and sort results
   ! by increasing excitation energy.
      self :: INOUT

      .TD::make_r_TDHF_S0_IC
      .TD::make_r_TDHF_S1_IC(append=TRUE)

   end

! Singlet

   make_r_CIS_S0_IC ::: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      AA  :: MAT{REAL}@
      nvo :: INT

      ! A matrix (leaky)
      AA.create(nvo,nvo)
      AA = ZERO

      ! Get A matrix
      .TD:make_r_CIS_S0_SS(AA)

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD:TD_excited_state_solver_IC(AA,append=FALSE)

      ! Clean up
      AA.destroy

   end

   make_r_CIS_S0_SS_IC ::: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      AA  :: MAT{REAL}@
      nvo :: INT

      ! Dimensions
      nvo = .TD_data.deltaE.dim

      ! A matrix (leaky)
      AA.create(nvo,nvo)
      AA = ZERO

      ! Get A matrix
      .TD:make_r_CIS_S0_SS(AA)

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD:TD_excited_state_solver_IC(AA,append=FALSE)

      ! Clean up
      AA.destroy

   end

   make_r_TDHF_S0_IC ::: leaky
   ! Do a restricted TDHF singlet calculation.
   ! NOTE: for singlet or triplet instabilities this may fail
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      ApB :: MAT{REAL}@
      AmB :: MAT{REAL}@
      n, nvo :: INT
      no, nv :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea, Ei :: REAL
      val, aibj,ajbi,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! A+B & A-B matrices (leaky)
      ApB.create(nvo,nvo)
      AmB.create(nvo,nvo)

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .FOCK:make_MO_ERI_chem_integrals(v)

      ApB = ZERO
      AmB = ZERO

      ai = 0
      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         ! Eigenvalues
         Ea  = .TD_data.Ev(a-no) 
         Ei  = .TD_data.Eo(i)

         ! Diagonals
         val = Ea - Ei
         AmB(ai,ai) = val
         ApB(ai,ai) = val

         bj = 0
         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            ! Integrals
            aibj = v(a,i,b,j)
            ajbi = v(a,j,b,i)
            abji = v(a,b,j,i)

            ! Weiss et al (1993) JCP 99 p1262-70: ! Singlet
            ApB(ai,bj) = ApB(ai,bj) &
                       + FOUR*aibj  - ajbi - abji ! eqn (3)
            AmB(ai,bj) = AmB(ai,bj) + ajbi - abji ! eqn (5)

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AmB.symmetric_reflect
      ApB.symmetric_reflect

      ! eqn (28) in Dreuw (2005)
      AmB.to_sqrt
      ApB.change_basis_using(AmB) 
      AmB.destroy

      ! Diagonalize for excitations
      .TD:TD_excited_state_solver_IC(ApB,append=FALSE)

      ! Clean up
      ApB.destroy
      AmB.destroy

   end

! Triplet

   make_r_CIS_S1_IC(append) ::: leaky
   ! Do a restricted CIS/Tamm-Dancoff triplet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT
      append :: BIN, optional, IN

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      AA :: MAT{REAL}@
      n, nvo :: INT
      no, nv :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea, Ei :: REAL
      abji   :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! Allocate (leaky)
      AA.create(nvo,nvo)

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .FOCK:make_MO_ERI_chem_integrals(v)

      AA = ZERO

      ai = 0
      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         ! Eigenvalues
         Ea  = .TD_data.Ev(a-no) 
         Ei  = .TD_data.Eo(i)

         AA(ai,ai) = Ea - Ei

         bj = 0
         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            ! Integrals
            abji = v(a,b,j,i)

            ! Weiss et al (1993) JCP 99 p1262-70: ! Triplet
            AA(ai,bj) = AA(ai,bj) - abji ! eqn (4)+(5)/2

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD:TD_excited_state_solver_IC(AA,append)

      ! Clean up
      AA.destroy

   end

   make_r_TDHF_S1_IC(append) ::: leaky
   ! Do a restricted TDHF triplet calculation.
   ! NOTE: for singlet or triplet instabilities this may fail
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT
      append :: BIN, optional, IN

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      ApB :: MAT{REAL}@
      AmB :: MAT{REAL}@
      n, nvo :: INT
      no, nv :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea, Ei :: REAL
      val, ajbi,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! Allocate (leaky)
      ApB.create(nvo,nvo)
      AmB.create(nvo,nvo)

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .FOCK:make_MO_ERI_chem_integrals(v)

      ApB = ZERO
      AmB = ZERO

      ai = 0

      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         Ea  = .TD_data.Ev(a-no) 
         Ei  = .TD_data.Eo(i)

         val = Ea - Ei
         AmB(ai,ai) = val
         ApB(ai,ai) = val

         bj = 0

         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            ! Integrals
            ajbi = v(a,j,b,i)
            abji = v(a,b,j,i)

            ! Weiss et al (1993) JCP 99 p1262-70
            ! Triplet
            ApB(ai,bj) = ApB(ai,bj) - ajbi - abji ! eqn (4)
            AmB(ai,bj) = AmB(ai,bj) + ajbi - abji ! eqn (5)

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AmB.symmetric_reflect
      ApB.symmetric_reflect

      ! eqn (28) in Dreuw (2005)
      AmB.to_sqrt
      ApB.change_basis_using(AmB) 
      AmB.destroy

      ! Diagonalize for excitations
      .TD:TD_excited_state_solver_IC(ApB,append)

      ! Clean up
      ApB.destroy

   end

   make_u_CIS_IC ::: leaky
   ! Do an urestricted CIS/Tamm-Dancoff calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@      ! Eeek
      AA :: MAT{REAL}@
      nvo :: INT 
      n, no,nv :: INT 
      a, i, ai :: INT ! spinorbital
      b, j, bj :: INT ! spinorbital
      ra,ri, sa,si :: INT ! restricted
      rb,rj, sb,sj :: INT ! restricted
      Ea, Ei, aibj,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf  ! restricted
      no  = .TD_data.n_occ 
      nv  = .TD_data.n_vir
      nvo = 2*nv*2*no

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .FOCK:make_MO_ERI_chem_integrals(v)

      ! Allocate (leaky)
      AA.create(nvo,nvo)
      AA = ZERO

      ! Loops over spinorbitals
      ! order: alpha then beta
      ai = 0
      do i = 1,2*no
      do a = 1,2*nv

         ai = ai + 1

         ! Restricted indices
         ri = i
         si = 1
         if (i>no) then
            ri = ri - no
            si = -1
         end

         ra = a + no
         sa = 1
         if (a>nv) then
            ra = ra - nv
            sa = -1
         end

         ! Eigenvalues & diagonals
         Ea = .TD_data.Ev(ra-no) 
         Ei = .TD_data.Eo(ri)
         AA(ai,ai) = Ea - Ei

         bj = 0
         do j = 1,2*no
         do b = 1,2*nv

            bj = bj + 1

            ! Restricted indices
            rj = j
            sj = 1
            if (j>no) then
               rj = rj - no
               sj = -1
            end

            rb = b + no
            sb = 1
            if (b>nv) then
               rb = rb - nv
               sb = -1
            end

            ! Dreuw & Head-Gordon (2005) eqn (17).
            ! See also eqn (95) for the HF part.
            if (sa==si AND sb==sj) then
               aibj = v(ra,ri,rb,rj)
               AA(ai,bj) = AA(ai,bj) + aibj
            end

            if (sa==sb AND si==sj) then
               abji = v(ra,rb,rj,ri)
               AA(ai,bj) = AA(ai,bj) - abji 
            end

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD:TD_excited_state_solver_IC(AA,append=FALSE)

      ! Clean up
      AA.destroy

   end

!  =========
!  Integrals
!  =========

   test_VOVO
   ! Test orthogonalisation routines for Davidson diagonaliser.
      self :: IN

      n,no,nv,nvo :: INT
      vovo :: MAT{REAL}@
      vvoo :: MAT{REAL}@

      ! Dimensions
      n   = .n_bf
      no  = .n_a
      nv  = n - no
      nvo = nv*no

      ! The VOVO integrals
      vovo.create(nvo,nvo)
      vvoo.create(nvo,nvo)

      .TD::make_VOVO_VVOO_ERIs(vovo,vvoo)

      vvoo.destroy
      vovo.destroy

   end

   make_VOVO_VVOO_ERIs(vovo,vvoo) ::: leaky
   ! Return the "vovo" and "vvoo ERIs stored as a 2D matrix, 
   ! with indices 12 and 34 linearized, respectively.
      self :: IN
      vovo :: MAT{REAL}, OUT
      vvoo :: MAT{REAL}, OUT

   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      W :: MAT{REAL}@
      n,no,nv,nvo :: INT
      p,q    :: INT
      a,i,ai :: INT
      b,j,bj :: INT

      ! Dimensions
      n   = .n_bf
      no  = .n_a
      nv  = n - no
      nvo = nv*no

      ! The VOVO integrals
    ! vovo.create(nvo,nvo)

      ! Get 2e integrals
      v.create(n,n,n,n)
      v = ZERO
      .FOCK:make_ERI_integrals(v)

      ! Change first two indices
      do p = 1,n
         v(:,:,p,p).change_basis_using(.MOs.r)
         do q = 1,p-1
            v(:,:,p,q).change_basis_using(.MOs.r)
            v(:,:,q,p) = v(:,:,p,q)
         end
      end

      ! VOVO
      W.create(nv,no)
      ai = 0
      do i = 1,no
      do a = no+1,n
         ai = ai + 1
         v(a,i,:,:).change_basis_to(W,.MOs.r(:,no+1:),.MOs.r(:,1:no))
         vovo(ai,:) = reshape(W,[nvo])
      end
      end
      W.destroy

      ! VVOO
      ! Can join with above?
      W.create(no,no)
      do b = no+1,n
      do a = no+1,n
         v(a,b,:,:).change_basis_to(W,.MOs.r(:,1:no),.MOs.r(:,1:no))
         do j = 1,no
         do i = 1,no
            ai = a-no + (i-1)*nv
            bj = b-no + (j-1)*nv
            vvoo(ai,bj) = W(i,j)
         end
         end
      end
      end
