!      do b = 1,2
!
!         if (b==1 AND j==1) then
!            fb = 1
!            lb = d
!         end
!         if (b==2 AND j==1) then
!            fb = d+1
!            lb = d2
!         end
!         if (b==1 AND j==2) then
!            fb = d2+1
!            lb = d3
!         end
!         if (b==2 AND j==2) then
!            fb = d3+1
!            lb = d4
!         end
!
!         do i = 1,2
!         do a = 1,2
!
!            if (a==1 AND i==1) then
!               fa = 1
!               la = d
!            end
!            if (a==2 AND i==1) then
!               fa = d+1
!               la = d2
!            end
!            if (a==1 AND i==2) then
!               fa = d2+1
!               la = d3
!            end
!            if (a==2 AND i==2) then
!               fa = d3+1
!               la = d4
!            end
!
!            stdout.text("A "//trim(s(a))//trim(s(i))//","//trim(s(b))//trim(s(j)))
