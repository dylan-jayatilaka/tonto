   test_VOVO
   ! Test orthogonalisation routines for Davidson diagonaliser.
      self :: IN

      n,no,nv,nvo :: INT
      vovo :: MAT{REAL}@
      vvoo :: MAT{REAL}@

      ! Dimensions
      n   = .n_bf
      no  = .n_a
      nv  = n - no
      nvo = nv*no

      ! The VOVO integrals
      vovo.create(nvo,nvo)
      vvoo.create(nvo,nvo)

      .TD::make_VOVO_VVOO_ERIs(vovo,vvoo)

      vvoo.destroy
      vovo.destroy

   end

   make_VOVO_VVOO_ERIs(vovo,vvoo) ::: leaky
   ! Return the "vovo" and "vvoo ERIs stored as a 2D matrix, 
   ! with indices 12 and 34 linearized, respectively.
      self :: IN
      vovo :: MAT{REAL}, OUT
      vvoo :: MAT{REAL}, OUT

   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      W :: MAT{REAL}@
      n,no,nv,nvo :: INT
      p,q    :: INT
      a,i,ai :: INT
      b,j,bj :: INT

      ! Dimensions
      n   = .n_bf
      no  = .n_a
      nv  = n - no
      nvo = nv*no

      ! The VOVO integrals
    ! vovo.create(nvo,nvo)

      ! Get 2e integrals
      v.create(n,n,n,n)
      v = ZERO
      .FOCK:make_ERI_integrals(v)

      ! Change first two indices
      do p = 1,n
         v(:,:,p,p).change_basis_using(.MOs.r)
         do q = 1,p-1
            v(:,:,p,q).change_basis_using(.MOs.r)
            v(:,:,q,p) = v(:,:,p,q)
         end
      end

      ! VOVO
      W.create(nv,no)
      ai = 0
      do i = 1,no
      do a = no+1,n
         ai = ai + 1
         v(a,i,:,:).change_basis_to(W,.MOs.r(:,no+1:),.MOs.r(:,1:no))
         vovo(ai,:) = reshape(W,[nvo])
      end
      end
      W.destroy

      ! VVOO
      ! Can join with above?
      W.create(no,no)
      do b = no+1,n
      do a = no+1,n
         v(a,b,:,:).change_basis_to(W,.MOs.r(:,1:no),.MOs.r(:,1:no))
         do j = 1,no
         do i = 1,no
            ai = a-no + (i-1)*nv
            bj = b-no + (j-1)*nv
            vvoo(ai,bj) = W(i,j)
         end
         end
      end
      end
      W.destroy

      ! Check
    ! val = huge(ONE)
    ! ai = 0
    ! do i = 1,no
    ! do a = no+1,n
    !    ai = ai + 1
    !    bj = 0
    !    do j = 1,no
    !    do b = no+1,n
    !       bj = bj + 1
    !       val = min(val,abs(vovo(ai,bj)-v(a,i,b,j)))
    !    end
    !    end
    ! end
    ! end
    ! stdout.flush
    ! stdout.show("difference = ",val)

      v.destroy

   end

end
