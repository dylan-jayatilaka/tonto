   implicit none

contains

! ================
! Testing Davidson
! ================

   diagonalize_Davidson(A,eval,evec,n_evals,n_keep,maxit,tolcon) :: selfless
   ! Davidson diagonaliser for matrix "A".
   ! See Crouzeix et al (1990) Inria RR 1353
   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
      A :: MAT{REAL}, IN
      eval :: VEC{REAL}@, OUT ! The "n" eigenvalues
      evec :: MAT{REAL}@, OUT ! The "n" eigenvector columns
      n_evals :: INT, IN      ! No. of eigenvalues wanted, "n"
      n_keep  :: INT, OUT     ! No. of trial vector sets kept
      maxit   :: INT, IN      ! Max. no. of iterations allowed
      tolcon  :: REAL, IN     ! Max. residual vec norm, to end

   ENSURE(n_keep>=3,"Must store minimum 2+1=3 trial vector sets")

      R :: MAT{REAL}@     ! Ritz vectors <- becomes "evec"
      V :: MAT{REAL}@     ! V(:,n)       <- the Davidson trial vectors
      W :: MAT{REAL}@     ! W(:,n)       <- A.V
      H :: MAT{REAL}@     ! A            <- in basis "V"
      T   :: VEC{REAL}@   ! New direction, T
      rvl :: VEC{REAL}@   ! Length of the residual vectors
      iter,n_tr :: INT
      d,n,f,l,i :: INT
      converged :: BIN
      too_many  :: BIN
      collapse  :: BIN
      bot :: REAL

      ! Sizes
      d = A.dim1            ! "d" could be big!
      n = n_evals           ! Usually n << d

      ! Best vectors
      R.create(d,n)         ! Will be "evec"
      eval.create(n*n_keep) ! Will shrink to "n"

      ! Residue vector length
      rvl.create(n)

      ! Davidson vectors "V"
      V.create(d,n*n_keep)  ! Need all in memory???
      W.create(d,n*n_keep)  ! Space for product A*V, worst case
      T.create(d)           ! Space for new directions

   ! .TD_data.put_D_table_header

      ! Initialize
      V.to_unit_mx          ! Initial guess
      iter = 0              ! Overall iteration count
      n_tr = 0              ! No. of trial vector sets
      converged = FALSE
      too_many  = FALSE

      do

         iter = iter + 1    ! Iteration 
         n_tr = n_tr + 1    ! No. of vector blocks (-1)

         ! First & last trial vector columns
         l = n*(n_tr-1)
         f = l + 1
         l = l + n

         ! 1. Expensive step, extends W
         ! Replace with low-mem matrix product
         W(:,f:l) = matmul(A,V(:,f:l))

         ! 2. Expand Rayleigh matrix
         H.expand(l,l)
         evec.create(l,l)
         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise (increasing eigenvalues)
         H.diagonalize_Jacobi(eval(1:l),evec)

         ! 4. Lowest Ritz vectors
         R = matmul(V(:,1:l),evec(:,1:n))

         ! Too many iters? Collapse space?
         too_many = iter>maxit; if (too_many) exit
         collapse = n_tr==n_keep

         stdout.flush
         stdout.text("=========")
         stdout.show("iter      ",iter)
         stdout.show("n_tr      ",n_tr)
         stdout.show("collapse? ",collapse)
         stdout.show("too many? ",too_many)
         stdout.show("f         ",f)
         stdout.show("l         ",l)

         if (too_many) then

            ! Save to disk?
            evec.destroy
            H.destroy

         else if (collapse) then

            ! Restart with Ritz vector
            n_tr = 0
            V(:,1:n) = R
         ! V(:,1:n).Householder_QR ! Needed?

            ! Note: clean both
            evec.destroy
            H.destroy

         else

            ! 5-7. Get residual & new direction T, per-column
            do i = 1,n

               ! 5. Residual T & its length
               T = eval(i)*R(:,i) - matmul(W(:,1:l),evec(:,i))
               rvl(i) = norm2(T)

               ! 6. Precondition
               bot = eval(i) - H(i,i)
               if (abs(bot) < 0.001d0) bot = bot + TOL(2)
               bot= ONE/bot

               ! 7a. Set new direction t
               V(:,l+i) = bot*T

            end

         stdout.flush
         stdout.show("conv      ",maxval(abs(rvl)))
         stdout.flush
         stdout.text("eval:")
         stdout.put(eval(1:n))

            ! Finished?
            converged = all(rvl<tolcon); if (converged) exit

            ! 7. Orthonormalize vectors V
            V(:,1:l+n).modified_Gram_Schmidt_QR
         ! V(:,1:l+n).Householder_QR

            ! Clean up
            evec.destroy

         end

      end

      ENSURE(converged,"No convergence")
      ENSURE(NOT too_many,"Too many iterations")

      ! Clean up
      evec.destroy
      H.destroy
      T.destroy
      W.destroy
      V.destroy
      rvl.destroy

      ! Recover solution
      call move_alloc(R,evec)
      eval.shrink(n)

   end

   test_MGS_QR :: selfless
   ! Test orthogonalisation routines for Davidson diagonaliser.

      V, Q, R :: MAT{REAL}@
      dim     :: INT
      n_keep  :: INT

      ! Sizes
      dim    = 10
      n_keep =  5

      ! Number Davidson vectors to keep.
      V.create(dim,n_keep)

      ! Initial
      call random_number(V)

      stdout.text("V:")
      stdout.put(V)

      Q.create(dim,n_keep)
      R.create(n_keep,n_keep)

      V.modified_Gram_Schmidt_QR(Q,R)

      stdout.flush
      stdout.text("========================")
      stdout.text("modified Gram-Schmidt QR")
      stdout.text("========================")
      stdout.flush

      stdout.text("Q:")
      stdout.put(Q)

      stdout.text("Q^T Q:")
      stdout.put(matmul(transpose(Q),Q))

      stdout.text("R:")
      stdout.put(R)

      stdout.text("QR - V:")
      stdout.put(matmul(Q,R) - V)

      stdout.flush
      stdout.text("==============")
      stdout.text("Householder QR")
      stdout.text("==============")
      stdout.flush

      V.Householder_QR(Q,R)

      stdout.text("Q:")
      stdout.put(Q)

      stdout.text("Q^T Q:")
      stdout.put(matmul(transpose(Q),Q))

      stdout.text("R:")
      stdout.put(R)

      stdout.text("QR - V:")
      stdout.put(matmul(Q,R) - V)

   end

   test_Davidson_CPS_6 :: selfless
   ! Test the Davidson algorithm with the example in section 6 of
   ! Crouzeix et al (1990) Inria RR 1353
      A    :: MAT{REAL}@
      evec :: MAT{REAL}@
      eval :: VEC{REAL}@
      d,n_evals, i :: INT
      n_keep,maxit :: INT

      ! Sizes
      d = 30
      n_evals = 2
      n_keep  = 8
      maxit   = 50

      ! Set up
      A.create(d,d)
      eval.create(d)
      evec.create(d,d)

      A = ZERO
      do i = 1,d
         A(i  ,i  ) = i
         if (i>1) then
            A(i-1,i  ) = HALF
            A(i  ,i-1) = HALF
         end
         if (i<d) then
            A(i+1,i  ) = HALF
            A(i  ,i+1) = HALF
         end
      end
      A(1,d) = HALF
      A(d,1) = HALF

      stdout.flush
      stdout.text("===========")
      stdout.text("Jacobi eigs")
      stdout.text("===========")
      stdout.flush

      A.diagonalize_Jacobi(eval,evec)

      stdout.flush
      stdout.text("eval:")
      stdout.put(eval(1:n_evals))

      stdout.text("evec:")
      stdout.put(evec(:,1:n_evals))

      eval.destroy
      evec.destroy

   ! A.diagonalize_Davidson(eval,evec,n_evals,n_keep,maxit,tolconv=TOL(7))
      ::diagonalize_Davidson(A,eval,evec,n_evals,n_keep,maxit,tolcon=TOL(7))

      stdout.flush
      stdout.text("===============")
      stdout.text("Davidson test 6")
      stdout.text("===============")
      stdout.flush

      stdout.flush
      stdout.text("eval:")
      stdout.put(eval)

      stdout.flush
      stdout.text("evec:")
      stdout.put(evec)

      stdout.flush
      stdout.text("evec^T evec:")
      stdout.put(matmul(transpose(evec),evec))

   end

!  ==============
!  Excited states
!  ==============

   TD_excited_states :: leaky
   ! Do a TD excited state calculation.
   ! Most of the info is kept in .TD_data.
      self :: INOUT

   ENSURE(.atom_info_made, "No atoms!")
   ENSURE(.basis_info_made,"No basis set!")
   ENSURE(.MOs.allocated,  "MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      ! Minimal setup
      .TD_data.set_defaults(.n_bf,.n_a,.n_b)
      if (.SCF_data.allocated) then
         .TD_data.set_defaults(.MOs.r,.MO_energies.r,.SCF_data.VMO_energies)
      else
         .TD_data.set_defaults(.MOs.r,.MO_energies.r)
      end

      ! State selection
      .TD_data.update

      ! Banner
      .TD_data.put_banner

      ! Which TD calc?
      select case (.TD_data.implementation)

      case ("in-core ")
         select case (.TD_data.method)
         case("r-cis-s=0        "); .do_r_CIS_S0_IC
         case("r-cis-s=0&1      "); .do_r_CIS_S01_IC
         case("r-cis-s=1        "); .do_r_CIS_S1_IC
         case("r-cis-ss-s=0     "); .do_r_CIS_SS_S0_IC
         case("r-tdhf-s=0       "); .do_r_TDHF_S0_IC
         case("r-tdhf-s=0&1     "); .do_r_TDHF_S01_IC
         case("r-tdhf-s=1       "); .do_r_TDHF_S1_IC
         case("u-cis            "); .do_u_CIS_IC
         case("u-cis-v1         "); .do_u_CIS_IC_v1    ! Uses SS
         case default; UNKNOWN(.TD_data.method)
         end

      case ("davidson")
         select case (.TD_data.method)
         case("r-cis-ss-s=0     "); .do_r_CIS_SS_S0
         case("r-cis-ss-s=0&1   "); .do_r_CIS_SS_S01
         case("r-cis-ss-s=1     "); .do_r_CIS_SS_S1
         case("u-cis-ss         "); .do_u_CIS_SS
      ! case("r-cis-ss-s=0-d1  "); .do_r_CIS_SS_S0_D1 ! In core
      ! case("r-cis-ss-s=0-d2  "); .do_r_CIS_SS_S0_D2 ! In core
      ! case("r-cis-ss-s=0-v0  "); .do_r_CIS_SS_S0_v0
         case default; UNKNOWN(.TD_data.method)
         end

      case default
         UNKNOWN(.TD_data.implementation)

      end

      ! Put results
      .TD_data.put_results
      .TD_data.put_evecs

   end

! Efficient Davidson methods

   eigensolve_Davidson(TD,HV_prod)
   ! Davidson diagonalizer. See Crouzeix (1990) Inria RR 1353.
   ! See also Crouzeix (1994) SIAM J Sci Comput 15 p. 62-76.
   !
   ! Steps 1-7 & symbols in code below are mostly from p. 5
   ! of Crouzeix (1990). But "R" is the residual, not "T"! 
   !
   ! "TD" ......... Holds key calculation parameters.
   !                It is a kind of Davidson iterator object.
   !
   ! "HV_prod" .... Does the expensive method-specific 2e part
   !                of the "A matrix product" in the AO basis.
   !
   ! "TD" holds iteration count information, methods to test 
   ! for convergence, for subspace collapse, and CIS/TD 
   ! specific storage. Key variables are:
   !
   ! n_evals  ..... desired no. of lowest excitations   IN
   ! n_keep   ..... No. of trial vectors to keep        IN
   ! max_iter ..... Max. no. of iterations allowed      IN
   ! tol_Davidson.. Convergence tol on residual vector  IN
   ! eval     ..... the lowest eigenvalues              OUT
   ! evec     ..... corresponding eigenvectors          OUT
   !                Note: n_keep > evec.dim2 >= 3
   ! max_res  ..... Maximum residual vector norms       OUT
   !
   ! NOTE: the trial vectors "V" are initially set to unit
   ! vectors in the first few components. So the states that
   ! these components in "V" refer to must be chosen wisely
   ! e.g. by selecting appropriate virtual orbitals and by
   ! sorting single excitations into energy order.
   ! =====
      self :: INOUT
      TD   :: TD_DATA, target, INOUT 
      interface           ! Efficient H.V product
         HV_prod(mol,HV,V,TD) :: PURE
            use TYPES
            mol :: MOLECULE,    INOUT
            HV  :: MAT{REAL},   OUT
            V   :: MAT{REAL},   IN
            TD  :: TD_DATA, INOUT
         end
      end

   ENSURE(TD.eval.allocated,"no TD.eval")
   ENSURE(TD.evec.allocated,"no TD.eval")
   ENSURE(TD.eval.dim==TD.evec.dim2,"in TD: eval & evec incompatible")

      H :: MAT{REAL}@     ! H in basis of "V" columns
      U :: MAT{REAL}@     ! H eigenvectors
      E :: VEC{REAL}@     ! H eigenvalues

      W    :: MAT{REAL}*  ! Aliases
      V    :: MAT{REAL}*
      R    :: VEC{REAL}*
      evec :: MAT{REAL}*
      eval :: VEC{REAL}*

      bot,maxres :: REAL
      d,n,n_keep :: INT
      f,l,i :: INT

      ! Set up aliases.
      ! Put in TD to store & also to
      ! avoid extra memory allocation
      W    => TD.W
      V    => TD.V
      R    => TD.R
      evec => TD.evec
      eval => TD.eval

      ! Sizes
      d = evec.dim1             ! No. of excitations
      n = evec.dim2             ! Block of evals, n << d
      n_keep = TD.n_keep        ! No. of trial vector sets

      ! Output options
      TD.put_D_table_header

      do ! Davidson loop

         TD.update_iteration              

         if (TD.collapse) then
            TD.reset_subspace   ! Keep one trial set
            H.destroy           ! Remake H from scratch
         end

         ! 1. EXPENSIVE: W(:,f:l) = H x V(:,f:l) 
         f = TD.fst_trial_vector             
         l = TD.lst_trial_vector
         call HV_prod(self,W(:,f:l),V(:,f:l),TD)

         ! 2. Expand Rayleigh matrix
         H.expand(l,l); U.create(l,l); E.create(l)
         H(f:l,:) = matmul( transpose(V(:,f:l)), W(:,1:l) )
         H.symmetric_reflect(set_upper=TRUE)

         ! 3. Diagonalise 
         H.solve_symmetric_eigenproblem(E,U)

         ! 4. Keep Ritz vectors
         TD.eval = E(1:n)       ! <== ANSWER
         TD.evec = matmul(V(:,1:l),U(:,1:n))

         ! Get residual, add new directions
         maxres = ZERO
         do i = 1,n

            ! 5. Residual
            R = E(i)*TD.evec(:,i) - matmul(W(:,1:l),U(:,i))
            maxres = max(norm2(R),maxres)

            ! 6. New directions
            bot = E(i) - H(i,i)
            if (abs(bot)<TOL(3)) bot = bot + TOL(2)
            bot = ONE/bot
            V(:,l+i) = bot*R

         end
         TD.set_max_res(maxres) ! <== For convergence test

         ! Clean up
         E.destroy; U.destroy

         ! Print out table
         TD.put_D_table_body_and_footer

         ! Converged?
         if (TD.converged) then;  exit
         else
            ! 7. Orthonormalize vectors V 
            if (TD.use_MGS) then; V(:,1:l+n).modified_Gram_Schmidt_QR
            else;                 V(:,1:l+n).Householder_QR
            end
         end

      end

      ! Store results
      TD.store_results(.name)

   end

! Unrestricted

   do_u_CIS_SS
   ! Do an unrestricted CIS calculation.
   ! Magic is hidden in the .TD_data object, which keeps
   ! Davidson iteration, and other info. Also, the passed
   ! method does the efficient Davidson A.V product.
      self :: INOUT

      ! Start up; set archive name
      .TD_data.initialize_Davidson(.name)

      ! Do the diagonalisation & print results
      .eigensolve_Davidson(.TD_data,::do_u_CIS_SS_AV_prod)

      ! Doubles?
   ! .do_doubles(.TD_data)

      ! Clean up
      .TD_data.finalize_iteration

   end

   do_u_CIS_SS_AV_prod(AV,V,TD) :: PURE
   ! With *unrestricted* trial vectors "V" do the (A x V)
   ! product for the Davidson procedure (efficiently in
   ! the AO basis) and place the result into "AV".
      self :: INOUT
      AV :: MAT{REAL},  OUT
      V  :: MAT{REAL},  IN
      TD :: TD_DATA, INOUT

   ENSURE(TD.Vao.allocated,"TD.Vao not preallocated")
   ENSURE(TD.Jao.allocated,"TD.Jao not preallocated")
   ENSURE(TD.Kao.allocated,"TD.Kao not preallocated")
   
      d, d1,d2,d3,d4 :: INT
      n, n1,n2,n3,n4 :: INT

      ! 1e part: Set AV = diag(A).V
      TD.make_u_diag_AV(AV,V)

      ! Sizes
      d  = TD.single.dim1 
      d1 = d
      d2 = d + d1
      d3 = d + d2
      d4 = d + d3

      n  = TD.n_evals
      n1 =   n
      n2 = 2*n
      n3 = 3*n
      n4 = 4*n

      TD.change_r_V_to_AO(TD.Vao(   1:n1,:,:),V(   1:d1,:)) ! aa
      TD.change_r_V_to_AO(TD.Vao(n1+1:n2,:,:),V(d1+1:d2,:)) ! ba
      TD.change_r_V_to_AO(TD.Vao(n2+1:n3,:,:),V(d2+1:d3,:)) ! ab
      TD.change_r_V_to_AO(TD.Vao(n3+1:n4,:,:),V(d3+1:d4,:)) ! bb

      ! 2e part: AV =+ (AV)ai, in AO basis
      .u_CIS_AV(TD.Jao,TD.Kao,TD.Vao)  ! Expensive

      ! Change to MO basis
      TD.change_u_V_to_MO(AV,TD.Jao,TD.Kao)

   end

   do_doubles(TD) ! :: PURE
   ! Do the doubles contribution at the end if wanted.
      self :: INOUT
      TD :: TD_DATA, INOUT

      select case(TD.dressing)
      case ("mazur ");   .do_doubles_Mazur(.TD_data)
   ! case ("window");   .do_doubles_window(.TD_data)
      case default;      UNKNOWN(TD.dressing)
      end

   end

   do_doubles_Mazur(TD) ! :: PURE
   ! Do a one-shot (non-iterative) doubles contribution
   ! using the perturbative Mazur theory.
      self :: INOUT
      TD   :: TD_DATA, INOUT

      Jd, Kd, Pd   :: MAT{REAL}@
      J0, K0, P0   :: MAT{REAL}@
      Fg,Kg, Fe,Ke :: MAT{REAL}@
      d, n, no,nv  :: INT
      d1,d2,d3,d4  :: INT
      ai, a,i, bj, b,j :: INT
      Aai,Bai, Eai,Ebj :: REAL
      del,val, rt2,F,X :: REAL
      V :: MAT3{REAL}@

      TD.find_doubles_Mazur

      if (TD.double.deallocated) return

      ! See doubles
      TD.put_doubles

      ! Constants
      n   = TD.n_evals
      d   = TD.single.dim1
      rt2 = ONE/sqrt(TWO)

      ! Create correction array
      TD.evalc.create(TD.double.dim1)

      ! Copy Vaa and Vbb
      d1 = d
      d2 = d + d1
      d3 = d + d2
      d4 = d + d3
      V.create(d,n,2)
      V(  1:d1,:,1) = TD.V(   1:d1,:) ! aa
      V(d+1:d2,:,2) = TD.V(d3+1:d4,:) ! bb

      ! Density & J,K matrices
      n  = TD.n_bf
      no = TD.n_occ
      nv = TD.n_vir
      J0.create(n ,n ); K0.create(n,n); P0.create(n,n) ! G state
      Jd.create(n ,n ); Kd.create(n,n); Pd.create(n,n) ! Delta S-G
      Fg.create(nv,no); Kg.create(nv,no)               ! G state
      Fe.create(nv,no); Ke.create(nv,no)               ! S state

      ! Ground state density
      P0 = matmul(TD.MOo,transpose(TD.MOo))

      ! Ground state Fock mx, in AO basis
      .make_r_JK_direct(J0,K0,P0)

      ! VO block. Not all needed, wasteful.
      Fg = matmul(transpose(TD.MOv),matmul(J0,TD.MOo)) ! J
      Kg = matmul(transpose(TD.MOv),matmul(K0,TD.MOo))
      Fg = TWO*Fg - Kg

      ! Loop over classes
      do n = 1,TD.double.dim1

         ai = TD.double(n,1)
         a  = TD.single(ai,1)
         i  = TD.single(ai,2)

         bj = TD.double(n,2)
         b  = TD.single(bj,1)
         j  = TD.single(bj,2)

         stdout.show("ai = ",ai)
         stdout.show("i  = ",i-TD.n_occ)
         stdout.show("a  = ",a)

         stdout.show("bj = ",bj)
         stdout.show("j  = ",j-TD.n_occ)
         stdout.show("b  = ",b)
         
         ! Difference DM due to Phi(J->B)
         Pd = matmul(TD.MOv(:,b:b),transpose(TD.MOv(:,b:b))) &
            - matmul(TD.MOo(:,j:j),transpose(TD.MOo(:,j:j))) 

         ! Delta Fock matrix, in AO basis
         .make_r_JK_direct(Jd,Kd,Pd)

         ! Delta Fock, VO block.
         Fe = matmul(transpose(TD.MOv),matmul(Jd,TD.MOo)) ! J
         Ke = matmul(transpose(TD.MOv),matmul(Kd,TD.MOo))
         Fe = Fe - Kd

         ! Coefficients & Denominator
         Aai = TD.V(   ai,n) ! aa
         Bai = TD.V(d3+ai,n) ! bb
         Eai = TD.delEab(ai)
         Ebj = TD.delEab(bj) 
         del = TD.eval(n) - Eai - Ebj
         del = ONE/del

         ! Add the correction
         if (ai/=bj) then
            F   = Fg(a,i) + Fe(a,i)
            X   = Kg(a,i) 
            val = del*F*F*Aai
         end

      end

   end

!   do_doubles_window(TD) ! :: PURE
!   ! Do the doubles contribution at the end if wanted.
!      self :: INOUT
!      TD :: TD_DATA, INOUT
!
!      F, J, K ,P  :: MAT{REAL}@
!      F0,J0,K0,P0 :: MAT{REAL}@
!      ai, a,i :: INT
!      bj, b,j :: INT
!      n,  f,l :: INT
!      val :: REAL
!
!      if (TD.double.deallocated) return
!
!      TD.put_doubles
!
!      ! Density matrices
!      n = .n_bf
!       F.create(n,n);  J.create(n,n);  K.create(n,n);  P.create(n,n)
!      F0.create(n,n); J0.create(n,n); K0.create(n,n); P0.create(n,n)
!
!      ! Ground state density
!      P0 = matmul(TD.MO,transpose(TD.MO))
!
!      ! Ground state Fock mx
!      .make_r_JK_direct(J0,K0,P0)
!
!      ! Loop over classes
!      do n = 1,TD.S_list.dim1
!         f  = TD.S_list(n,1)
!         l  = TD.S_list(n,2)
!         bj = TD.double(f,2)
!         b  = TD.single(bj,1)
!         j  = TD.single(bj,2)
!         stdout.show("f  = ",f)
!         stdout.show("l  = ",l)
!         stdout.show("bj = ",bj)
!         stdout.show("j  = ",j-TD.n_occ)
!         stdout.show("b  = ",b)
!         
!         ! Make Phi(J->B) determinant density
!         P = D - matmul(TD.MO(:,j),transpose(TD.MO(:,j))) &
!               + matmul(TD.MO(:,b),transpose(TD.MO(:,j)))
!
!         ! AO Fock matrix
!         .make_r_JK_direct(J,K,P)
!
!         do ai = f,l
!            a  = TD.single(ai,1)
!            i  = TD.single(ai,2)
!            stdout.show("ai = ",ai)
!            stdout.show("i  = ",i-TD.n_occ)
!            stdout.show("a  = ",a)
!
!            ! Add the correction
!            val = F(a,i)
!            eval(i) = eval(i) + val*val/(E-TD.delEab(ai))
!
!         end
!      end
!
!      stop
!
!   end

   make_u_CIS_SS_A_mx(AA,one,two)
   ! FOR TESTING AND UNDERSTANDING.
   ! Make urestricted CIS "A" matrix. It is composed of 16
   ! spin sectors, labelled by single excitations, and the
   ! two-electron part of it is given by:
   !
   !                    BJ  aa  ba  ab  bb 
   !                 AI    ________________
   !                 aa  | J-K   0   0   J
   !    AA(AI,BJ) =  ba  |  0   -K   0   0
   !                 ab  |  0    0  -K   0
   !                 bb  |  J    0   0  J-K
   !
   ! where e.g. ab are spins for excitations ai or bj, and
   ! where J = (AI|BJ) and K = (AB|IJ). The above matrix can
   ! be derived from the 2e part of the spinorbital equation
   ! below, by performing integration over spin labels.
   !
   !  AA(AI,BJ) = (E_A-E_I) d_IJ d_AB + (AI|BJ) - (AB|IJ)
   !
   ! or better with complex orbitals
   !
   !  AA(AI,BJ) = (E_A-E_I) d_IJ d_AB + (AI|JB) - (AB|JI)
   !            = (E_A-E_I) d_IJ d_AB + <AJ|IB> - <AJ|BI>
   !
   ! NOTE: The 1e part in this eqn is non-zero for spin labels
   ! aa;aa aa;bb bb;aa and bb;bb, the corners of the mx above.
   ! See Dreuw & Head-Gordon (2005) eqn (17).
   ! See Oddershede (1984) Comp Phys Rep 2 p33-94 eqn (3.6)
      self :: INOUT
      AA  :: MAT{REAL}, OUT
      one :: BIN, optional, IN
      two :: BIN, optional, IN

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      ai, a, i :: INT
      bj, b, j :: INT
      d, d2,d3 :: INT
      no,lo,hv :: INT
      do1, do2 :: BIN
      val, aibj, abji :: REAL

      ! Do one electron part?
      do1 = TRUE
      if (present(one)) do1 = one

      ! Do two electron part?
      do2 = TRUE
      if (present(two)) do2 = two

      ! Dimensions
      d   = .TD_data.single.dim1 - 1 ! Remove G
      d2  = 2*d
      d3  = 3*d
      no  = .TD_data.n_occ
      lo  = .TD_data.min_OMO
      hv  = .TD_data.max_VMO + no ! NOTE

      ! A matrix (leaky)
      AA = ZERO

      if (do1) then

         ! Diagonal Fock mx
         if (.TD_data.Fv.deallocated) then

            ! Eigenvalue difference
            do ai = 2,d
               val = .TD_data.deltaE(ai)
               AA(   ai,   ai) = val ! aa;aa
               AA(d +ai,d +ai) = val ! ba;ba
               AA(d2+ai,d2+ai) = val ! ab;ab
               AA(d3+ai,d3+ai) = val ! bb;bb
            end

         else

            ! Non-diagonal VMO part
            do ai = 2,d
               a   =  .TD_data.single(ai,1)
               i   =  .TD_data.single(ai,2)
               val = -.TD_data.Eo(i)
               AA(   ai,   ai) = val
               AA(d +ai,d +ai) = val
               AA(d2+ai,d2+ai) = val
               AA(d3+ai,d3+ai) = val
               do bj = 2,d
                  b  = .TD_data.single(bj,1)
                  j  = .TD_data.single(bj,2)
                  if (i==j) then
                     val = .TD_data.Fv(a,b)
                     AA(   ai,   bj) = AA(   ai,   bj) + val
                     AA(d +ai,d +bj) = AA(d +ai,d +bj) + val
                     AA(d2+ai,d2+bj) = AA(d2+ai,d2+bj) + val
                     AA(d3+ai,d3+bj) = AA(d3+ai,d3+bj) + val
                  end
               end
            end

         end

      end

      if (do2) then

         ! Get ERIs in MO basis
         v.create([lo,hv],[lo,hv],[lo,hv],[lo,hv])
         .make_MO_ERIs_v1(v,lo,hv)

         ! Two-electron part
         do ai = 2,d
            a = .TD_data.single(ai,1) + no
            i = .TD_data.single(ai,2)
            do bj = 2,d
               b = .TD_data.single(bj,1) + no
               j = .TD_data.single(bj,2)
               ! J, Coulomb
               aibj = v(a,i,b,j) 
               AA(   ai,   bj) = AA(   ai,   bj) + aibj ! aa;aa
               AA(   ai,d3+bj) = AA(   ai,d3+bj) + aibj ! aa;bb
               AA(d3+ai,   bj) = AA(d3+ai,   bj) + aibj ! bb;aa
               AA(d3+ai,d3+bj) = AA(d3+ai,d3+bj) + aibj ! bb;bb
               ! K, exchange
               abji = v(a,b,j,i) 
               AA(   ai,   bj) = AA(   ai,   bj) - abji ! aa;aa
               AA(d +ai,d +bj) = AA(d +ai,d +bj) - abji ! ba;ba
               AA(d2+ai,d2+bj) = AA(d2+ai,d2+bj) - abji ! ab;ab
               AA(d3+ai,d3+bj) = AA(d3+ai,d3+bj) - abji ! bb;bb
            end
         end

         v.destroy

      end

      ! Symmetrize
      AA.symmetric_reflect

   end

! Restricted

   do_r_CIS_SS_S01
   ! Do a restricted CIS S=0 & S=1 calculation.
   ! This does both separately and then merges.
      self :: INOUT

      ! S=0 calculation
      .TD_data.set_method("r-cis-ss-s=0")
      .do_r_CIS_SS_S0

      ! S=1 calculation
      .TD_data.set_method("r-cis-ss-s=1")
      .do_r_CIS_SS_S1

      ! Reset calc type & append results
      .TD_data.set_method("r-cis-ss-s=0&1")
      .TD_data.merge_S01_results

   end

   do_r_CIS_SS_S0
   ! Do a restricted CIS S=0 *singlet* calculation.
   ! Magic is hidden in the .TD_data object, which keeps
   ! Davidson iteration, and other info; also the passed
   ! AV_prod method does the efficient Davidson A.V product
   ! where "A" are the 2e integral terms.
      self :: INOUT

      ! Start up; set archive name
      .TD_data.initialize_Davidson(.name)

      ! Do the diagonalisation & print results
      .eigensolve_Davidson(.TD_data,::do_r_CIS_SS_S0_AV_prod)

      ! Clean up
      .TD_data.finalize_iteration

   end

   do_r_CIS_SS_S0_AV_prod(AV,V,TD) :: PURE
   ! Given Davidson trial vectors "V", do the (A x V)
   ! product (efficiently in the AO basis) and place the
   ! result into "AV". *Singlet* S=0 case.
      self :: INOUT
      AV :: MAT{REAL},  OUT
      V  :: MAT{REAL},  IN
      TD :: TD_DATA, INOUT

   ENSURE(TD.Vao.allocated,"TD_data.Vao not preallocated")
   ENSURE(TD.Aao.allocated,"TD_data.Aao not preallocated")

      ! 1e part: Set AV = diag(A).V
      TD.make_r_diag_AV(AV,V)

      ! 2e part: accumulate AV =+ (AV)ai
      TD.change_r_V_to_AO(TD.Vao,V)    ! Get the DMs
      .r_CIS_S0_AV(TD.Aao,TD.Vao) ! AV in AO basis
      TD.change_r_V_to_MO(AV,TD.Aao)   ! Accumulate

   end

   do_r_CIS_SS_S1
   ! Do a restricted CIS S=1 *singlet* calculation.
   ! Magic is hidden in the .TD_data object, which keeps
   ! Davidson iteration, and other info; also and the passed
   ! AV_prod method does the efficient Davidson A.V product.
      self :: INOUT

      ! Start up; set archive name
      .TD_data.initialize_Davidson(.name)

      ! Do the diagonalisation & print results
      .eigensolve_Davidson(.TD_data,::do_r_CIS_SS_S1_AV_prod)

      ! Clean up
      .TD_data.finalize_iteration

   end

   do_r_CIS_SS_S1_AV_prod(AV,V,TD) :: PURE
   ! Given Davidson trial vectors "V", do the (A x V)
   ! product (efficiently in the AO basis) and place the
   ! result into "AV". *Triplet* S=1 case.
      self :: INOUT
      AV :: MAT{REAL},  OUT
      V  :: MAT{REAL},  IN
      TD :: TD_DATA, INOUT

   ENSURE(TD.Vao.allocated,"TD_data.Vao not preallocated")
   ENSURE(TD.Aao.allocated,"TD_data.Aao not preallocated")

      ! 1e part: Set AV = diag(A).V
      TD.make_r_diag_AV(AV,V)

      ! 2e part: accumulate AV =+ (AV)ai
      TD.change_r_V_to_AO(TD.Vao,V)    ! Get the DMs
      .r_CIS_S1_AV(TD.Aao,TD.Vao) ! AV in AO basis
      TD.change_r_V_to_MO(AV,TD.Aao)   ! Accumulate

   end

! Inefficient Davidson methods

!   do_r_CIS_SS_S0_v0
!   ! Do a restricted CIS/Tamm-Dancoff triplet calculation.
!   ! via Davidson. See Crouzeix et al (1990) Inria RR 1353.
!   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
!   ! NOTE: there is a complex interaction with .TD_data
!   ! which keeps iteration and convergence information.
!   ! THIS VERSION DOES NOT MAKE THE A MATRIX
!   ! BUT DOES EXPLICITLY CALL THE AV_prod LIKE METHODS.
!      self :: INOUT
!
!      ! Main variables
!      H :: MAT{REAL}@     ! A, in trial basis "V"
!      eval :: VEC{REAL}@  ! The "n" eigenvalues
!      evec :: MAT{REAL}@  ! The "n" eigenvector columns
!
!      ! Matrix temporaries
!      V :: MAT{REAL}@     ! V(:,n) <- Davidson trial vectors
!      W :: MAT{REAL}@     ! W(:,n) <- A.V vectors, MO basis
!      T :: VEC{REAL}@     ! A new trial vector direction
!      Vao :: MAT3{REAL}@  !   V in the AO basis
!      Aao :: MAT3{REAL}@  ! A.V in the AO basis
!
!      d, n   :: INT
!      n_keep :: INT
!      f,l, i :: INT
!      maxres :: REAL
!      bot :: REAL
!
!      ! Start up
!      .TD_data.initialize_iteration  ! Leaky
!      .TD_data.set_D_table_headings
!      .TD_data.put_D_table_header
!
!      ! Sizes
!      d = .TD_data.deltaE.dim        ! "d" could nvo
!      n = .TD_data.n_evals           ! Usually n << d
!      n_keep = .TD_data.n_keep       ! No. of trial vectors to keep
!
!      ! Temporaries
!      V.create(d,n*n_keep)           ! Davidson trial vector colums "V"
!      W.create(d,n*n_keep)           ! A.V in MO basis
!      T.create(d)                    ! New directions, scaled residual
!      Vao.create(n,.n_bf,.n_bf)      ! Density matrices
!      Aao.create(n,.n_bf,.n_bf)      ! A.V in AO basis
!
!      V(:,1:n).to_unit_mx            ! Initialise "V", choose wisely
!
!      do ! Davidson loop
!
!         ! Next iteration
!         .TD_data.update_iteration
!
!         ! Collapse subspace down?
!         if (.TD_data.collapse) then
!            .TD_data.reset_subspace  ! Keep one trial set
!            V(:,1:n) = .TD_data.evec ! Restart with last one
!            H.destroy                ! Remake H
!         end
!
!         ! 1. Expensive step: extend W = A.V
!         f = .TD_data.fst_trial_vector
!         l = .TD_data.lst_trial_vector
!         ! Below does: W(:,f:l) = matmul(A,V(:,f:l))
!         .TD_data.make_r_diag_AV(W(:,f:l),V(:,f:l))   ! 1e: Set W = diag(A).V
!         .TD_data.change_r_V_to_AO(Vao     ,V(:,f:l)) ! Back transform to Vao
!               .r_CIS_S0_AV(Aao,Vao)             ! AV in AO basis
!         .TD_data.change_r_V_to_MO(W(:,f:l),Aao)      ! W = W + (AV)ai
!       ! stdout.text("W:")
!       ! stdout.put(W(:,f:l))
!       ! stop
!
!         ! 2. Expand Rayleigh matrix
!         H.expand(l,l)    ! A in V basis
!         evec.create(l,l)
!         eval.create(l)
!         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
!         H.symmetric_reflect(set_upper=TRUE)
!
!         ! 3. Diagonalise (increasing eigenvalues)
!         H.solve_symmetric_eigenproblem(eval(1:l),evec)
!
!         ! 4. Keep Ritz vectors "R" (lowest only)
!         .TD_data.eval = eval(1:n)
!         .TD_data.evec = matmul(V(:,1:l),evec(:,1:n))
!
!          ! 5-7. Get residual & add new directions
!          maxres = ZERO
!          do i = 1,n
!
!             ! 5. Residual T & its length
!             T = eval(i)*.TD_data.evec(:,i) & ! "R"
!               - matmul(W(:,1:l), evec(:,i) )
!             maxres = max(norm2(T),maxres)
!
!             ! 6. Precondition
!             bot = eval(i) - H(i,i)
!             if (abs(bot)<TOL(3)) bot = bot + TOL(2)
!             bot= ONE/bot
!
!             ! 7a. Set new direction T
!             V(:,l+i) = bot*T
!
!          end
!          .TD_data.set_max_res(maxres)
!
!         ! Clean up
!         eval.destroy
!         evec.destroy
!
!         ! 7. Orthonormalize vectors V ?
!         if (NOT .TD_data.converged) then
!            V(:,1:l+n).modified_Gram_Schmidt_QR
!          ! V(:,1:l+n).Householder_QR
!         end
!
!         ! Print out table & finish? !!!!!!
!         .TD_data.put_D_table_body_and_footer
!         if (.TD_data.Davidson_done)   exit
!         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
!      end
!
!      ! Clean up
!      H.destroy
!      Aao.destroy
!      Vao.destroy
!      T.destroy
!      W.destroy
!      V.destroy
!
!   end

!   do_r_CIS_SS_S0_D2
!   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
!   ! via Davidson. See Crouzeix et al (1990) Inria RR 1353.
!   ! Step numbers & symbols below mostly from p. 5 Crouzeix.
!   ! THIS VERSION MAKES THE A MATRIX
!      self :: INOUT
!
!      ! Key results
!      A :: MAT{REAL}@     ! A matrix
!      H :: MAT{REAL}@     ! A, in trial basis "V"
!      eval :: VEC{REAL}@  ! The "n" eigenvalues
!      evec :: MAT{REAL}@  ! The "n" eigenvector columns
!
!      ! Matrix temporaries
!      V :: MAT{REAL}@     ! V(:,n) <- the Davidson trial vectors
!      W :: MAT{REAL}@     ! W(:,n) <- A.V
!      T :: VEC{REAL}@     ! T      <- new ditrection
!
!    ! MOv :: MAT{REAL}@
!    ! MOo :: MAT{REAL}@
!
!      d, n   :: INT
!      n_keep :: INT
!      f,l, i :: INT
!      maxres :: REAL
!      bot :: REAL
!
!      ! Start up
!      .TD_data.initialize_iteration ! Leaky
!      .TD_data.set_D_table_headings
!      .TD_data.put_D_table_header
!
!      ! Sizes
!      d = .TD_data.deltaE.dim  ! "d" could nvo
!      n = .TD_data.n_evals     ! Usually n << d
!      n_keep = .TD_data.n_keep ! No. of trial vectors to keep
!
!      ! Temporaries
!      V.create(d,n*n_keep)  ! Davidson trial vectors "V"
!      V.to_unit_mx          ! Initialise trial evecs
!      W.create(d,n*n_keep)  ! Space for product A*V, worst case
!      T.create(d)           ! Space for new directions
!
!      ! MOs to transform
!    ! no = .TD_data.n_occ
!    ! MOv = .MOs.r(:,no+1:  )
!    ! MOo = .MOs.r(:,   1:no)
!
!      ! The A matrix
!      A.create(d,d)
!      .make_r_CIS_SS_S0_A_mx(A)
!
!      do ! Davidson loop
!
!         ! Next iteration.
!         .TD_data.update_iteration
!
!         ! Collapse subspace?
!         if (.TD_data.collapse) then
!
!            ! Keep one trial set
!            .TD_data.reset_subspace
!
!            ! Restart last Ritz vector
!            V(:,1:n) = .TD_data.evec
!          ! V(:,1:n).Householder_QR ! Needed?
!
!            ! Remake
!            H.destroy
!
!         end
!
!         ! Trial vector columns
!         f = .TD_data.fst_trial_vector
!         l = .TD_data.lst_trial_vector
!
!         ! 2. Expand Rayleigh matrix
!         H.expand(l,l)                 ! A in reduced basis
!         evec.create(l,l)
!         eval.create(l)
!         W(:,f:l) = matmul(A,V(:,f:l)) ! 1. Expensive step, extends W
!         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
!         H.symmetric_reflect(set_upper=TRUE)
!
!         ! 3. Diagonalise (increasing eigenvalues)
!       ! H.diagonalize_Jacobi(eval(1:l),evec)
!         H.solve_symmetric_eigenproblem(eval(1:l),evec)
!
!         ! 4. Keep lowest Ritz vectors "R"
!         .TD_data.eval = eval(1:n)
!         .TD_data.evec = matmul(V(:,1:l),evec(:,1:n))
!         !!!!!!!!!!!!!!!!!!!!!!!!
!
!       ! stdout.flush
!       ! stdout.text("=========")
!       ! stdout.show("iter      ",.TD_data.iteration)
!       ! stdout.show("n_tr      ",.TD_data.n_trial)
!       ! stdout.show("collapse? ",.TD_data.collapse)
!       ! stdout.show("too many? ",.TD_data.reached_max_it)
!       ! stdout.show("f         ",f)
!       ! stdout.show("l         ",l)
!
!          ! 5-7. Get residual
!          ! Append new directions
!          maxres = ZERO
!          do i = 1,n
!
!             ! 5. Residual T & its length
!             T = eval(i)*.TD_data.evec(:,i) & ! "R"
!               - matmul(W(:,1:l),evec(:,i) )
!             maxres = max(norm2(T),maxres)
!
!             ! 6. Precondition
!             bot = eval(i) - H(i,i)
!             if (abs(bot)<TOL(3)) bot = bot + TOL(2)
!             bot= ONE/bot
!
!             ! 7a. Set new direction t
!             V(:,l+i) = bot*T
!
!          end
!          .TD_data.set_max_res(maxres)
!
!       ! stdout.flush
!       ! stdout.show("conv      ",maxres)
!       ! stdout.flush
!       ! stdout.text("eval:")
!       ! stdout.put(eval(1:n))
!
!         ! Clean up
!         eval.destroy
!         evec.destroy
!
!         if (NOT .TD_data.converged) then
!            ! Continue ...
!            ! 7. Orthonormalize vectors V
!            V(:,1:l+n).modified_Gram_Schmidt_QR
!          ! V(:,1:l+n).Householder_QR
!         end
!
!         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!         .TD_data.put_D_table_body_and_footer
!         if (.TD_data.Davidson_done)   exit
!         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
!      end
!
!      ! Clean up
!      H.destroy
!      T.destroy
!      W.destroy
!      V.destroy
!
!   end

!   do_r_CIS_SS_S0_D1
!   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
!   ! See Weiss et al (1993) JCP 99 p1262-70.
!   ! THIS OLDER VERSION MAKES THE A MATRIX IN CORE
!   ! BUT DOES NOT USE TD_DATA iteration test methods.
!      self :: INOUT
!
!      ! Key results
!      eval :: VEC{REAL}@  ! The "n" eigenvalues
!      evec :: MAT{REAL}@  ! The "n" eigenvector columns
!      maxit  :: INT       ! Max. no. of iterations allowed
!      tolcon :: REAL      ! Max. residual vec norm, to end
!      n_keep :: INT       ! No. of trial vectors to keep
!
!      ! Matrix temporaries
!      A :: MAT{REAL}@     ! A matrix
!      R :: MAT{REAL}@     ! Ritz vectors <- becomes "evec"
!      V :: MAT{REAL}@     ! V(:,n)       <- the Davidson trial vectors
!      W :: MAT{REAL}@     ! W(:,n)       <- A.V
!      H :: MAT{REAL}@     ! A            <- in basis "V"
!      T :: VEC{REAL}@     ! New direction, T
!      rvl :: VEC{REAL}@   ! Length of the residual vectors
!
!      d,n,no :: INT
!      f,l, i :: INT
!      iter :: INT
!      n_tr :: INT
!      converged :: BIN
!      too_many  :: BIN
!      collapse  :: BIN
!      bot :: REAL
!
!      ! Sizes
!      d  = .TD_data.deltaE.dim  ! "d" could nvo
!      n  = .TD_data.n_evals     ! Usually n << d
!      no = .TD_data.n_occ
!
!      maxit  = .TD_data.max_iterations ! Max iterations
!      tolcon = .TD_data.tol_Davidson   ! Convergence
!      n_keep = .TD_data.n_keep         ! No. of trial vectors to keep
!
!      ! Best vectors
!      R.create(d,n)         ! Will be "evec"
!      eval.create(n*n_keep) ! Will shrink to "n"
!
!      ! The A matrix
!      A.create(d,d)
!      .make_r_CIS_SS_S0_A_mx(A)
!
!      ! Residue vector length
!      rvl.create(n)
!
!      ! Davidson vectors "V"
!      V.create(d,n*n_keep)  ! Need all in memory???
!      W.create(d,n*n_keep)  ! Space for product A*V, worst case
!      T.create(d)           ! Space for new directions
!
!      ! Initialize
!      V.to_unit_mx          ! Initial guess
!      iter = 0              ! Overall iteration count
!      n_tr = 0              ! No. of trial vector sets
!      converged = FALSE
!      too_many  = FALSE
!
!      !!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!      .TD_data.set_D_table_headings
!      .TD_data.put_D_table_header
!      !!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
!      do
!
!         ! Iteration & no. of trial vector sets (-1)
!         iter = iter + 1
!         n_tr = n_tr + 1
!
!         ! First & last trial vector columns
!         l = n*(n_tr-1)
!         f = l + 1
!         l = l + n
!
!         ! 1. Expensive step, extends W
!         ! Replace with low-mem matrix product
!         W(:,f:l) = matmul(A,V(:,f:l))
!
!         ! 2. Expand Rayleigh matrix
!         H.expand(l,l)
!         evec.create(l,l)
!         H(f:l,:) = matmul( transpose(V(:,f:l)) , W(:,1:l) )
!         H.symmetric_reflect(set_upper=TRUE)
!
!         ! 3. Diagonalise (increasing eigenvalues)
!       ! H.diagonalize_Jacobi(eval(1:l),evec)
!         H.solve_symmetric_eigenproblem(eval(1:l),evec)
!
!         ! 4. Lowest Ritz vectors
!         R = matmul(V(:,1:l),evec(:,1:n))
!
!         ! Too many iters? Collapse space?
!         too_many = iter>maxit; if (too_many) exit
!         collapse = n_tr==n_keep
!
!         stdout.flush
!         stdout.text("=========")
!         stdout.show("iter      ",iter)
!         stdout.show("n_tr      ",n_tr)
!         stdout.show("collapse? ",collapse)
!         stdout.show("too many? ",too_many)
!         stdout.show("f         ",f)
!         stdout.show("l         ",l)
!
!         if (too_many) then
!
!            ! Save to disk?
!            evec.destroy
!            H.destroy
!
!         else if (collapse) then
!
!            ! Restart with Ritz vector
!            n_tr = 0
!            V(:,1:n) = R
!            V(:,1:n).Householder_QR ! Needed?
!
!            ! Note: clean both
!            evec.destroy
!            H.destroy
!
!         else
!
!            ! 5-7. Get residual & new direction T, per-column
!            do i = 1,n
!
!               ! 5. Residual T & its length
!               T = eval(i)*R(:,i) - matmul(W(:,1:l),evec(:,i))
!               rvl(i) = norm2(T)
!
!               ! 6. Precondition
!               bot = eval(i) - H(i,i)
!               if (abs(bot) < 0.001d0) bot = bot + TOL(2)
!               bot= ONE/bot
!
!               ! 7a. Set new direction t
!               V(:,l+i) = bot*T
!
!            end
!
!         stdout.flush
!         stdout.show("conv      ",maxval(abs(rvl)))
!         stdout.flush
!         stdout.text("eval:")
!         stdout.put(eval(1:n))
!
!            ! Finished?
!            converged = all(rvl<tolcon); if (converged) exit
!
!            ! 7. Orthonormalize vectors V
!            V(:,1:l+n).modified_Gram_Schmidt_QR
!          ! V(:,1:l+n).Householder_QR
!
!            ! Clean up
!            evec.destroy
!
!         end
!
!      end
!
!      ENSURE(converged,"No convergence")
!      ENSURE(NOT too_many,"Too many iterations")
!
!      ! Clean up
!      evec.destroy
!      H.destroy
!      T.destroy
!      W.destroy
!      V.destroy
!      rvl.destroy
!      A.destroy
!
!      ! Recover & store solution
!      eval.shrink(n)
!      call move_alloc(eval,.TD_data.eval)
!      call move_alloc(R   ,.TD_data.evec)
!
!   end

   make_r_CIS_SS_S0_A_mx(AA,one,two) :: leaky
   ! Make the restricted CIS singlet A matrix in "AA".
   ! If "one" is FALSE then skip 1-electron part.
   ! If "two" is FALSE then skip 2-electron part.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT
      AA  :: MAT{REAL}, OUT
      one :: BIN, optional, IN
      two :: BIN, optional, IN

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      a,i,ai :: INT
      b,j,bj :: INT
      lo, hv :: INT
      d,n,no :: INT
      aibj, abji :: REAL
      do1, do2 :: BIN

      ! Do one electron part?
      do1 = TRUE
      if (present(one)) do1 = one

      ! Do two electron part?
      do2 = TRUE
      if (present(two)) do2 = two

      ! Dimensions
      d   = .TD_data.deltaE.dim
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      lo  = .TD_data.min_OMO
      hv  = .TD_data.max_VMO + no ! NOTE

      ! A matrix (leaky)
      AA = ZERO

      if (do1) then

         ! Do diagonal part
         if (.TD_data.Fv.deallocated) then

            ! Eigenvalue difference
            do ai = 1,d
               AA(ai,ai) = .TD_data.deltaE(ai)
            end

         else

            ! Non-diagonal VMO part
            do ai = 1,d
               a = .TD_data.single(ai,1)
               i = .TD_data.single(ai,2)
               AA(ai,ai) = -.TD_data.Eo(i)
               do bj = 1,d
                  b = .TD_data.single(bj,1)
                  j = .TD_data.single(bj,2)
                  if (i==j) then
                     AA(ai,bj) = AA(ai,bj) + .TD_data.Fv(a,b)
                  end
               end
            end

         end

      end

      if (do2) then

         ! Get ERIs in MO basis
         v.create([lo,hv],[lo,hv],[lo,hv],[lo,hv])
      ! .make_MO_ERI_chem_integrals(v)
      ! .make_MO_ERIs_v0(v,lo,hv)
         .make_MO_ERIs_v1(v,lo,hv)
      ! .make_MO_ERIs_v2(v,lo,hv)

         ! Two-electron part
         do ai = 1,d
            a = .TD_data.single(ai,1) + no
            i = .TD_data.single(ai,2)
            do bj = 1,d
               b = .TD_data.single(bj,1) + no
               j = .TD_data.single(bj,2)
               ! Integrals
               aibj = v(a,i,b,j)
               abji = v(a,b,j,i)
               ! Weiss et al (1993) JCP 99 p1262-70: ! Singlet
               AA(ai,bj) = AA(ai,bj) + TWO*aibj - abji ! eqn (3)+(5)/2
            ! AA(ai,bj) = AA(ai,bj)            - abji ! eqn (3)+(5)/2
            ! AA(ai,bj) = AA(ai,bj) + TWO*aibj ! - abji ! eqn (3)+(5)/2
            end
         end

         v.destroy

      end

      ! Symmetrize
      AA.symmetric_reflect

   end

! ===============
! In-core methods
! ===============

   TD_excited_state_solver_IC(AA) :: leaky, private
   ! Diagonalise the CIS/TD matrix "A", or similar, in-core.
   ! Triplet (S=1) results are appended if requested.
      self :: INOUT
      AA :: MAT{REAL}, IN

      dim, n :: INT

      ! Dimensions
      dim = AA.dim1

      ! Solve
      .TD_data.eval.create(dim)
      .TD_data.evec.create(dim,dim)
      AA.solve_symmetric_eigenproblem(.TD_data.eval,.TD_data.evec)

      ! Shrink to desired
      n = .TD_data.n_evals
      .TD_data.eval.shrink(n)
      .TD_data.evec.shrink_columns(n)

      ! Sqrt?
      if (.TD_data.do_sqrt_evals) then
      .TD_data.eval = sqrt(.TD_data.eval)
      end

   end

! Singlet & triplet

   do_r_CIS_S01_IC :: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet (S=0)
   ! and triplet (S=1) calculation and merge and sort results
   ! by increasing excitation energy.
      self :: INOUT

      ! S=0 calculation
      .TD_data.set_method("r-cis-s=0")
      .::do_r_CIS_S0_IC

      ! S=1 calculation
      .TD_data.set_method("r-cis-s=1")
      .::do_r_CIS_S1_IC

      ! Reset calc type & append results
      .TD_data.set_method("r-cis-s=0&1")
      .TD_data.merge_S01_results

   end

   do_r_TDHF_S01_IC :: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet (S=0)
   ! and triplet (S=1) calculation and merge and sort results
   ! by increasing excitation energy.
      self :: INOUT

      ! S=0 calculation
      .TD_data.set_method("r-tdhf-s=0")
      .::do_r_TDHF_S0_IC

      ! S=1 calculation
      .TD_data.set_method("r-tdhf-s=1")
      .::do_r_TDHF_S1_IC

      ! Reset calc type & append results
      .TD_data.set_method("r-tdhf-s=0&1")
      .TD_data.merge_S01_results

   end

! Restricted Singlet

   do_r_CIS_S0_IC :: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      AA  :: MAT{REAL}@
      nvo :: INT

      ! Dimensions
      nvo = .TD_data.no_of_singles

      ! A matrix (leaky)
      AA.create(nvo,nvo)
      AA = ZERO

      ! Get A matrix
      .make_r_CIS_SS_S0_A_mx(AA)

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(AA)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      AA.destroy

   end

   do_r_CIS_SS_S0_IC :: leaky
   ! Do a restricted CIS/Tamm-Dancoff singlet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
      self :: INOUT

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      AA  :: MAT{REAL}@
      nvo :: INT

      ! Dimensions
      nvo = .TD_data.deltaE.dim

      ! A matrix (leaky)
      AA.create(nvo,nvo)
      AA = ZERO

      ! Get A matrix
      .make_r_CIS_SS_S0_A_mx(AA)

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(AA)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      AA.destroy

   end

   do_r_TDHF_S0_IC :: leaky
   ! Do a restricted TDHF singlet calculation.
   ! NOTE: for singlet or triplet instabilities this may fail
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      ApB :: MAT{REAL}@
      AmB :: MAT{REAL}@
      n, nvo :: INT
      no, nv :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea, Ei :: REAL
      val, aibj,ajbi,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! A+B & A-B matrices (leaky)
      ApB.create(nvo,nvo)
      AmB.create(nvo,nvo)

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .make_MO_ERI_chem_integrals(v)

      ApB = ZERO
      AmB = ZERO

      ai = 0
      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         ! Eigenvalues
         Ea  = .TD_data.Ev(a-no)
         Ei  = .TD_data.Eo(i)

         ! Diagonals
         val = Ea - Ei
         AmB(ai,ai) = val
         ApB(ai,ai) = val

         bj = 0
         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            ! Integrals
            aibj = v(a,i,b,j)
            ajbi = v(a,j,b,i)
            abji = v(a,b,j,i)

            ! Weiss et al (1993) JCP 99 p1262-70: ! Singlet
            ApB(ai,bj) = ApB(ai,bj) &
                       + FOUR*aibj  - ajbi - abji ! eqn (3)
            AmB(ai,bj) = AmB(ai,bj) + ajbi - abji ! eqn (5)

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AmB.symmetric_reflect
      ApB.symmetric_reflect

      ! eqn (28) in Dreuw (2005)
      AmB.to_sqrt
      ApB.change_basis_using(AmB)
      AmB.destroy

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(ApB)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      ApB.destroy
      AmB.destroy

   end

! Restricted Triplet

   do_r_CIS_S1_IC :: leaky
   ! Do a restricted CIS/Tamm-Dancoff triplet calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      AA :: MAT{REAL}@
      n, nvo :: INT
      no, nv :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea, Ei :: REAL
      abji   :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! Allocate (leaky)
      AA.create(nvo,nvo)

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .make_MO_ERI_chem_integrals(v)

      AA = ZERO

      ai = 0
      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         ! Eigenvalues
         Ea  = .TD_data.Ev(a-no)
         Ei  = .TD_data.Eo(i)

         AA(ai,ai) = Ea - Ei

         bj = 0
         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            ! Integrals
            abji = v(a,b,j,i)

            ! Weiss et al (1993) JCP 99 p1262-70: ! Triplet
            AA(ai,bj) = AA(ai,bj) - abji ! eqn (4)+(5)/2

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AA.symmetric_reflect

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(AA)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      AA.destroy

   end

   do_r_TDHF_S1_IC :: leaky
   ! Do a restricted TDHF triplet calculation.
   ! NOTE: for singlet or triplet instabilities this may fail
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@
      ApB :: MAT{REAL}@
      AmB :: MAT{REAL}@
      n, nvo :: INT
      no, nv :: INT
      a,i,ai :: INT
      b,j,bj :: INT
      Ea, Ei :: REAL
      val, ajbi,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! Allocate (leaky)
      ApB.create(nvo,nvo)
      AmB.create(nvo,nvo)

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .make_MO_ERI_chem_integrals(v)

      ApB = ZERO
      AmB = ZERO

      ai = 0

      do i =    1,no
      do a = no+1,n

         ai = ai + 1

         Ea  = .TD_data.Ev(a-no)
         Ei  = .TD_data.Eo(i)

         val = Ea - Ei
         AmB(ai,ai) = val
         ApB(ai,ai) = val

         bj = 0

         do j = 1,no
         do b = no+1,n

            bj = bj + 1

            ! Integrals
            ajbi = v(a,j,b,i)
            abji = v(a,b,j,i)

            ! Weiss et al (1993) JCP 99 p1262-70
            ! Triplet
            ApB(ai,bj) = ApB(ai,bj) - ajbi - abji ! eqn (4)
            AmB(ai,bj) = AmB(ai,bj) + ajbi - abji ! eqn (5)

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AmB.symmetric_reflect
      ApB.symmetric_reflect

      ! eqn (28) in Dreuw (2005)
      AmB.to_sqrt
      ApB.change_basis_using(AmB)
      AmB.destroy

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(ApB)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      ApB.destroy

   end

! Unrestricted CIS

   do_u_CIS_IC :: leaky
   ! Do an urestricted CIS/Tamm-Dancoff calculation.
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Fv.deallocated,"VMO canonisation disallowed here")
   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      v :: MAT4{REAL}@      ! Eeek
      AA :: MAT{REAL}@
      nvo :: INT
      n, no,nv :: INT
      a, i, ai :: INT ! spinorbital
      b, j, bj :: INT ! spinorbital
      ra,ri, sa,si :: INT ! restricted
      rb,rj, sb,sj :: INT ! restricted
      Ea, Ei, aibj,abji :: REAL

      ! Dimensions
      n   = .TD_data.n_bf  ! restricted
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = 2*nv*2*no

      ! Get ERIs in MO basis
      v.create(n,n,n,n)
      .make_MO_ERI_chem_integrals(v)

      ! Allocate (leaky)
      AA.create(nvo,nvo)
      AA = ZERO

      ! Loops over spinorbitals
      ! order: alpha then beta
      ai = 0
      do i = 1,2*no
      do a = 1,2*nv

         ai = ai + 1

         ! Restricted indices
         ri = i
         si = 1
         if (i>no) then
            ri = ri - no
            si = -1
         end

         ra = a + no
         sa = 1
         if (a>nv) then
            ra = ra - nv
            sa = -1
         end

         ! Eigenvalues & diagonals
         Ea = .TD_data.Ev(ra-no)
         Ei = .TD_data.Eo(ri)
         AA(ai,ai) = Ea - Ei

         bj = 0
         do j = 1,2*no
         do b = 1,2*nv

            bj = bj + 1

            ! Restricted indices
            rj = j
            sj = 1
            if (j>no) then
               rj = rj - no
               sj = -1
            end

            rb = b + no
            sb = 1
            if (b>nv) then
               rb = rb - nv
               sb = -1
            end

            ! Dreuw & Head-Gordon (2005) eqn (17).
            ! See also eqn (95) for the HF part.
            if (sa==si AND sb==sj) then
               aibj = v(ra,ri,rb,rj)
               AA(ai,bj) = AA(ai,bj) + aibj
            end

            if (sa==sb AND si==sj) then
               abji = v(ra,rb,rj,ri)
               AA(ai,bj) = AA(ai,bj) - abji
            end

         end
         end

      end
      end

      v.destroy

      ! Symmetrize
      AA.symmetric_reflect

   ! .put_u_CIS_A_mx(AA)

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(AA)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      AA.destroy

   end

   put_u_CIS_A_mx(AA) :: leaky
   ! Put out the different sectors of the unrestricted A matrix.
      self :: INOUT
      AA :: MAT{REAL}, IN

      nvo :: INT
      no, nv :: INT
      ai, bj :: STR
      a,i,b,j :: INT
      sa, sb :: VEC{INT}@
      s :: VEC{STR}(2)

      ! Dimensions
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir
      nvo = nv*no

      ! Indices
      sa.create(nvo)
      sb.create(nvo)

      ! Spin chars
      s(1) = "a"
      s(2) = "b"

      do i = 1,2
      do a = 1,2

         .set_u_VO_spin_ind(sa,a,i)
         ai = trim(s(a))//trim(s(i))

         do j = 1,2
         do b = 1,2

            .set_u_VO_spin_ind(sb,b,j)
            bj = trim(s(b))//trim(s(j))

            stdout.text("A "//trim(bj)//","//trim(ai))
            stdout.put(AA(sb,sa))

         end
         end

      end
      end

   end

   set_u_VO_spin_ind(ind,as,is) :: leaky
   ! Put out the different sectors of the unrestricted A matrix.
      self :: INOUT
      ind :: VEC{INT}, OUT
      as  :: INT, IN
      is  :: INT, IN

      no, nv :: INT
      ai,a,i,k :: INT

      ! Dimensions
      no  = .TD_data.n_occ
      nv  = .TD_data.n_vir

      if (as==1 AND is==1) then
         ai = 0
         k  = 0
         do i = 1,2*no
         do a = 1,2*nv
            ai = ai + 1
            if (a<=nv AND i<=no) then
               k = k + 1
               ind(k) = ai
            end
         end
         end
      end

      if (as==2 AND is==1) then
         ai = 0
         k  = 0
         do i = 1,2*no
         do a = 1,2*nv
            ai = ai + 1
            if (a>nv AND i<=no) then
               k = k + 1
               ind(k) = ai
            end
         end
         end
      end

      if (as==1 AND is==2) then
         ai = 0
         k  = 0
         do i = 1,2*no
         do a = 1,2*nv
            ai = ai + 1
            if (a<=nv AND i>no) then
               k = k + 1
               ind(k) = ai
            end
         end
         end
      end

      if (as==2 AND is==2) then
         ai = 0
         k  = 0
         do i = 1,2*no
         do a = 1,2*nv
            ai = ai + 1
            if (a>nv AND i>no) then
               k = k + 1
               ind(k) = ai
            end
         end
         end
      end

   end


   do_u_CIS_IC_v1 :: leaky
   ! Do an urestricted CIS calculation.
   ! This version does different order of states.
   ! See Weiss et al (1993) JCP 99 p1262-70.
   ! See Hirata & Head-Gordon (1999) CPL 314, 291-299.
      self :: INOUT

   ENSURE(.TD_data.Eo.allocated,"NO TD_data.Eo!")
   ENSURE(.TD_data.Ev.allocated,"NO TD_data.Ev!")
   ENSURE(.MOs.allocated,"MOs do not exist")
   ENSURE(.MOs.r.allocated,"MOs.r does not exist")

      AA :: MAT{REAL}@
      d,d4 :: INT

      ! Dimensions
      d = .TD_data.deltaE.dim - 1 ! Remove G state
      d4 = 4*d + 1

      ! Allocate & make
      AA.create(d4,d4)
      .make_u_CIS_SS_A_mx(AA)

      ! Symmetrize
      AA.symmetric_reflect

   ! .put_u_CIS_A_mx(AA)
   ! .put_u_CIS_SS_A_mx(AA)

      ! Diagonalize for excitations
      .TD_excited_state_solver_IC(AA)

      ! Store
      .TD_data.store_results(.name)

      ! Clean up
      AA.destroy

   end

!   put_u_CIS_SS_A_mx(AA) :: leaky
!   ! Put out the different sectors of the unrestricted A matrix.
!      self :: INOUT
!      AA :: MAT{REAL}, IN
!
!      a,i, fa,la :: INT
!      b,j, fb,lb :: INT
!      d,d2,d3,d4 :: INT
