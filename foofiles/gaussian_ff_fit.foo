!---------------------------------------------------------------------------
!
! GAUSSIAN_FF_FIT: fit a spherical form factor to a few Gaussians.
!
! Plain procedures belonging to no object. They fit a form factor f(s),
! given on points s = sin(theta)/lambda in 1/Angstrom, to the form every
! crystallographic program reads, the International Tables one,
!
!    f(s) = sum_{i=1..n} a_i exp(-b_i s^2) + c,
!
! and write the result in the format of a refinement program.
!
! The fit is done in square roots of the coefficients, so a_i, b_i and c
! come back positive, as the International Tables' are.
!
! The minimiser is gnuplot's "fit" (Levenberg-Marquardt), run through the
! SYSTEM_COMMAND part of "tonto": the data and a script go to disk, gnuplot
! runs, and the coefficients come back from a file the script prints. The
! same script draws f(s) - fit(s). gnuplot absent is not fatal: "ok" comes
! back FALSE, the start values are returned, and the files are left so the
! fit can be run by hand.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!
!---------------------------------------------------------------------------

module GAUSSIAN_FF_FIT

   implicit none

contains

!  ==========
!  Evaluation
!  ==========

   gaussian_sum(s,a,b,c) result (res) :: selfless, pure
   ! The fitted form, sum_i a(i) exp(-b(i) s^2) + c, at every point of "s".
      s   :: VEC{REAL}, IN
      a,b :: VEC{REAL}, IN
      c   :: REAL, IN
      res :: VEC{REAL}(s.dim)

      i :: INT

      res = c
      do i = 1,a.dim
         res = res + a(i)*exp(-b(i)*s*s)
      end

   end

   deviations(s,f,a,b,c,s_max,rms,max_dev) :: selfless, pure
   ! The rms and the largest absolute deviation of the fit from "f" over
   ! the points of "s" within [0,s_max].
      s,f :: VEC{REAL}, IN
      a,b :: VEC{REAL}, IN
      c   :: REAL, IN
      s_max :: REAL, IN
      rms,max_dev :: REAL, OUT

      g :: VEC{REAL}(s.dim)
      d :: REAL
      i,n :: INT

      g = GAUSSIAN_FF_FIT:gaussian_sum(s,a,b,c)

      rms = ZERO; max_dev = ZERO; n = 0
      do i = 1,s.dim
         if (s(i)>s_max) cycle
         d = abs(f(i)-g(i))
         rms = rms + d*d
         max_dev = max(max_dev,d)
         n = n + 1
      end
      if (n>0) rms = sqrt(rms/n)

   end

!  =======
!  The fit
!  =======

   fit(s,f,a,b,c,s_max,stem,ok,a_err,b_err,c_err) :: selfless, leaky
   ! Fit f(s), given at the points "s" (1/Angstrom), on [0,s_max] to
   ! sum_i a(i) exp(-b(i) s^2) + c. On entry a, b and c are the starting
   ! values; on exit they are the fit, with their esds in a_err, b_err and
   ! c_err if wanted. Files written, all headed by "stem":
   !    <stem>.dat      s and f(s)
   !    <stem>.gnuplot  the script: the fit, then the difference plot
   !    <stem>.fit.log  gnuplot's own record of the fit
   !    <stem>.coeffs   the coefficients and esds, read back here
   !    <stem>.png      f(s) - fit(s)
   ! "ok" is FALSE if gnuplot could not be run or every fit failed; a, b
   ! and c are then the starting values still. A fit that fails (gnuplot
   ! stops on a singular matrix when two Gaussians fall together) is
   ! retried from the same a and c with b scaled by 0.7, 1.4, 0.5 and 2.
   ! MPI: the master rank writes and runs; every rank reads the result.
      s,f :: VEC{REAL}, IN
      a,b :: VEC{REAL}, INOUT
      c   :: REAL, INOUT
      s_max :: REAL, IN
      stem  :: STR, IN
      ok    :: BIN, OUT
      a_err,b_err :: VEC{REAL}, optional, OUT
      c_err :: REAL, optional, OUT

      cf :: TEXTFILE@
      ae,be,b0 :: VEC{REAL}@
      data,script,coeffs :: STR
      scale :: VEC{REAL}(5)
      ce,wssr :: REAL
      ndf,i,try :: INT

   ENSURE(s.dim==f.dim,"s and f differ in length")
   ENSURE(a.dim==b.dim,"a and b differ in length")
   ENSURE(a.dim>0,"no Gaussians to fit")
   ENSURE(s_max>ZERO,"s_max must be positive")

      data   = trim(stem)//".dat"
      script = trim(stem)//".gnuplot"
      coeffs = trim(stem)//".coeffs"

      ok = FALSE

      ! Every process makes the same output calls, which write on the master
      ! alone. Only the master runs gnuplot, and it tells the others the result.
      GAUSSIAN_FF_FIT:put_data_file(data,s,f,s_max)
      b0 = b
      scale = [ONE,0.7d0,1.4d0,HALF,TWO]
      do try = 1,scale.dim
         b = scale(try)*b0
         GAUSSIAN_FF_FIT:put_script(script,stem,a,b,c,s_max)
         if (tonto.is_master_processor) then
            tonto.execute("rm -f '"//trim(coeffs)//"'")
            tonto.execute("gnuplot '"//trim(script)//"' > /dev/null 2>&1")
            ok = NOT tonto.command_failed
         end
         PARALLEL_BROADCAST(ok,tonto.master_processor)
         if (ok) ok = stdout.exists(coeffs)
         if (ok) exit
      end
      if (NOT ok) then
         b = b0
         stdout.flush
         stdout.text("WARNING: the form factor fit "//trim(stem)//" failed from every start.")
         stdout.text("The data and the last script were written; see")
         stdout.text("   gnuplot '"//trim(script)//"'")
         stdout.flush
      end
      b0.destroy

      if (NOT ok) return

      ! Read back: a_i a_i_err b_i b_i_err ... c c_err WSSR NDF
      ae.create(a.dim)
      be.create(b.dim)
      cf.create(coeffs)
      cf.open_for("read")
      do i = 1,a.dim
         cf.read(a(i)); cf.read(ae(i))
         cf.read(b(i)); cf.read(be(i))
      end
      cf.read(c); cf.read(ce)
      cf.read(wssr); cf.read(ndf)
      cf.close
      cf.destroy

      if (present(a_err)) a_err = ae
      if (present(b_err)) b_err = be
      if (present(c_err)) c_err = ce

      be.destroy
      ae.destroy

   end

   put_data_file(data,s,f,s_max) :: selfless, private
   ! Write "data": two columns, s and f(s), for s within [0,s_max].
      data :: STR, IN
      s,f  :: VEC{REAL}, IN
      s_max :: REAL, IN

      i :: INT

      stdout.redirect(data)
      stdout.text("# Spherical atom form factor to be fitted")
      stdout.text("# 1st column: sin(theta)/lambda, 1/Angstrom")
      stdout.text("# 2nd column: f(s), electrons")
      do i = 1,s.dim
         if (s(i)>s_max) cycle
         stdout.text(trim(s(i).to_str("es22.14"))//" "//trim(f(i).to_str("es22.14")))
      end
      stdout.revert

   end

   put_script(script,stem,a,b,c,s_max) :: selfless, private
   ! Write the gnuplot "script": the model with its start values, the
   ! fit on [0,s_max], the print of the coefficients, and the plot of
   ! the difference.
      script,stem :: STR, IN
      a,b :: VEC{REAL}, IN
      c   :: REAL, IN
      s_max :: REAL, IN

      fn,via,si,sm :: STR
      i :: INT

      ! The model is written in square roots, f(x) = sum A_i^2 exp(-B_i^2 x^2) + C^2,
      ! so that every a_i, b_i and c stays positive, as in the International
      ! Tables; the printed values and esds are converted back to a, b, c.
      fn  = "f(x) = C**2"
      via = "C"
      do i = a.dim,1,-1
         si  = trim(adjustl(i.to_str))
         fn  = "f(x) = A"//trim(si)//"**2*exp(-B"//trim(si)//"**2*x**2) + "//fn(8:)
         via = "A"//trim(si)//",B"//trim(si)//","//via
      end
      sm = trim(adjustl(s_max.to_str("f10.4")))

      stdout.redirect(script)
      stdout.text("# Fit of a spherical atom form factor to Gaussians, written by Tonto.")
      stdout.text("# Run with:  gnuplot '"//trim(script)//"'")
      stdout.text(trim(fn))
      do i = 1,a.dim
         si = trim(adjustl(i.to_str))
         stdout.text("A"//trim(si)//" = "//trim(adjustl(sqrt(abs(a(i))).to_str("es22.14"))))
         stdout.text("B"//trim(si)//" = "//trim(adjustl(sqrt(abs(b(i))).to_str("es22.14"))))
      end
      stdout.text("C = "//trim(adjustl(sqrt(abs(c)).to_str("es22.14"))))
      stdout.text("set fit quiet")
      stdout.text("set fit errorvariables")
      stdout.text("set fit limit 1e-10")
      stdout.text("set fit maxiter 2000")
      stdout.text("set fit logfile '"//trim(stem)//".fit.log'")
      stdout.text("fit [0:"//trim(sm)//"] f(x) '"//trim(stem)//".dat' using 1:2 via "//trim(via))
      ! One value per line, so Tonto can read them back
      stdout.text("set print '"//trim(stem)//".coeffs'")
      do i = 1,a.dim
         si = trim(adjustl(i.to_str))
         stdout.text("print A"//trim(si)//"**2; print 2*abs(A"//trim(si)//")*A"//trim(si)//"_err")
         stdout.text("print B"//trim(si)//"**2; print 2*abs(B"//trim(si)//")*B"//trim(si)//"_err")
      end
      stdout.text("print C**2; print 2*abs(C)*C_err")
      stdout.text("print FIT_WSSR; print FIT_NDF")
      stdout.text("set terminal pngcairo size 900,600")
      stdout.text("set output '"//trim(stem)//".png'")
      stdout.text("set xlabel 'sin(theta)/lambda / 1/Angstrom'")
      stdout.text("set ylabel 'f(s) - fit(s) / electrons'")
      stdout.text("set grid")
      stdout.text("plot '"//trim(stem)//".dat' using 1:($2-f($1)) with lines title 'f(s) - fit'")
      stdout.revert

   end

!  ======
!  Output
!  ======

   put_SHELX_SFAC(label,a,b,c,comment) :: selfless
   ! Write one SHELX SFAC instruction for a fitted atom type, as
   !    SFAC label a1 b1 a2 b2 a3 b3 a4 b4 c f' f" mu r wt
   ! to the current stdout. The fit must have four Gaussians, which is
   ! what SHELX reads; f', f", mu, r and wt are written as 0, to be
   ! filled in by the user. "comment" goes before it as a REM line.
      label :: STR, IN
      a,b   :: VEC{REAL}, IN
      c     :: REAL, IN
      comment :: STR, optional, IN

      line :: STR
      i :: INT

   ENSURE(a.dim==4,"SHELX SFAC takes exactly four Gaussians")

      if (present(comment)) stdout.text("REM "//trim(comment))
      line = "SFAC "//trim(label)
      do i = 1,4
         line = trim(line)//" "//trim(a(i).to_str("f10.5"))//" "//trim(b(i).to_str("f10.5"))
      end
      line = trim(line)//" "//trim(c.to_str("f10.5"))//" ="
      stdout.text(trim(line))
      stdout.text("     0.00000   0.00000   0.00000   0.00000   0.00000")

   end

   put_BUSTER_FORMFACTOR(ff_type,a,b,c) :: selfless
   ! Write one BUSTER form-factor line, in the TNT format BUSTER reads
   ! with "refine FormfactorDat=", to the current stdout:
   !    FORMFACTOR type  a1 b1  a2 b2  a3 b3  a4 b4  c
   ! with b multiplying (sin theta/lambda)^2 in 1/Angstrom^2, the pairs
   ! in order of decreasing b. "ff_type" is an element symbol, or one with
   ! a BUSTER type label after it, such as C+0.1 (see BUSTER_type_label).
      ff_type :: STR, IN
      a,b  :: VEC{REAL}, IN
      c    :: REAL, IN

      order :: VEC{INT}@
      bb :: VEC{REAL}@
      line :: STR
      i :: INT

   ENSURE(a.dim==4,"BUSTER takes exactly four Gaussians")
   ENSURE(b.dim==4,"BUSTER takes exactly four Gaussians")

      ! The pair with the largest exponent first
      bb = b
      order.create(4)
      bb.quick_sort(order,decreasing_order=TRUE)

      line = "FORMFACTOR "//ff_type
      line = line(1:17)
      do i = 1,4
         line = trim(line)//" "//trim(a(order(i)).to_str("f11.6"))//" "//trim(b(order(i)).to_str("f11.6"))//" "
      end
      line = trim(line)//" "//trim(c.to_str("f11.6"))
      stdout.text(trim(line))

      order.destroy
      bb.destroy

   end

   BUSTER_type_label(i) result (res) :: selfless, pure
   ! The "i"-th type label BUSTER allows an atom of an element with its own
   ! form factor: a sign, a digit, a point and a digit, written after the
   ! element symbol in the PDB file and on the FORMFACTOR line. The labels
   ! go +0.1, -0.1, +0.2, -0.2, ... to +9.9, -9.9: 198 of them. They are
   ! labels, not charges.
      i :: INT, IN
      res :: STR(len=4)

      k :: INT

      k = (i+1)/2
      if (mod(i,2)==1) then; res = "+"
      else;                  res = "-"
      end
      res(2:2) = achar(iachar("0")+k/10)
      res(3:3) = "."
      res(4:4) = achar(iachar("0")+mod(k,10))

   end

   PDB_atom_record(serial,label,symbol,res_name,chain,res_seq,pos,occ,B_iso,type_label) result (line) :: selfless, pure
   ! One HETATM record of a PDB file, 82 columns: the element symbol in
   ! columns 77-78 and the BUSTER "type_label" (see BUSTER_type_label) in
   ! 79-82, which is how BUSTER gives an atom its own form factor. "label"
   ! is the atom name (columns 13-16, the element right-justified in
   ! 13-14), "pos" is in Angstrom, "occ" the site occupancy, "B_iso" the
   ! isotropic displacement parameter in Angstrom^2.
      serial :: INT, IN
      label,symbol,res_name,chain :: STR, IN
      res_seq :: INT, IN
      pos :: VEC{REAL}(3), IN
      occ,B_iso :: REAL, IN
      type_label :: STR, IN
      line :: STR(len=82)

      name :: STR(len=4)
      n :: INT

      ! The atom name: element in 13-14, the rest of the label after it
      n = len_trim(symbol)
      name = adjustr(symbol(1:2))//label(n+1:)

      line = " "
      line(1:6)   = "HETATM"
      line(7:11)  = serial.to_str("i5")
      line(13:16) = name
      line(18:20) = adjustr(res_name(1:3))
      line(22:22) = chain(1:1)
      line(23:26) = res_seq.to_str("i4")
      line(31:38) = pos(1).to_str("f8.3")
      line(39:46) = pos(2).to_str("f8.3")
      line(47:54) = pos(3).to_str("f8.3")
      line(55:60) = occ.to_str("f6.2")
      line(61:66) = B_iso.to_str("f6.2")
      line(77:78) = adjustr(symbol(1:2))
      line(79:82) = type_label(1:4)

   end

   put_table_line(label,a,b,c) :: selfless
   ! Write one line of the plain table: label, n, a_1..a_n, b_1..b_n, c.
      label :: STR, IN
      a,b   :: VEC{REAL}, IN
      c     :: REAL, IN

      line :: STR
      i :: INT

      line = label
      line = line(1:8)//" "//trim(a.dim.to_str("i4"))
      do i = 1,a.dim
         line = trim(line)//" "//trim(a(i).to_str("f14.6"))
      end
      do i = 1,a.dim
         line = trim(line)//" "//trim(b(i).to_str("f14.6"))
      end
      line = trim(line)//" "//trim(c.to_str("f14.6"))
      stdout.text(trim(line))

   end

!  =====
!  Check
!  =====

   check_round_trip result (n_failed) :: selfless, leaky
   ! Fit the International Tables curve of carbon, made from its own
   ! coefficients on an even s grid to 2/Angstrom, starting from
   ! those coefficients perturbed by 10%, and count how many of the
   ! nine come back further than 1e-4 from where they started.
   ! Returns -1 if gnuplot could not be run.
      n_failed :: INT

      s,f,a,b,a0,b0 :: VEC{REAL}@
      c,c0,rms,max_dev :: REAL
      i,n :: INT
      ok :: BIN

      n = 201
      s.create(n)
      do i = 1,n
         s(i) = TWO*(i-1)/(n-1)
      end

      ! Carbon, International Tables Vol. C, Table 6.1.1.4
      a0 = [2.31000d0, 1.02000d0, 1.58860d0, 0.865000d0]
      b0 = [20.8439d0, 10.2075d0, 0.568700d0, 51.6512d0]
      c0 = 0.215600d0
      f = GAUSSIAN_FF_FIT:gaussian_sum(s,a0,b0,c0)

      a = 1.1d0*a0; b = 0.9d0*b0; c = 1.1d0*c0
      GAUSSIAN_FF_FIT:fit(s,f,a,b,c,TWO,"carbon_IT_check",ok)

      if (NOT ok) then
         n_failed = -1
      else
         n_failed = count(abs(a-a0)>1.0d-4) + count(abs(b-b0)>1.0d-4)
         if (abs(c-c0)>1.0d-4) n_failed = n_failed + 1
         GAUSSIAN_FF_FIT:deviations(s,f,a,b,c,TWO,rms,max_dev)
         stdout.flush
         stdout.text("Round-trip fit of the carbon International Tables curve:")
         stdout.show("rms deviation         =",rms)
         stdout.show("largest deviation     =",max_dev)
         stdout.show("coefficients off      =",n_failed)
         stdout.flush
      end

      b.destroy; a.destroy
      f.destroy; s.destroy

   end

end
