!=====================================================================
!
! ERI_SCRATCH :
!
! Work arrays for the two-electron integral quartet loop. They are
! sized once, before the loop, for the largest shell quartet the basis
! can form, so that the loop itself does not allocate.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!=====================================================================

module ERI_SCRATCH

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

!  =====
!  Sizes
!  =====

   set_sizes_for(pair) :: leaky, PURE
   ! Size the work arrays for the largest shell quartet that the
   ! precomputed shell pairs "pair" can form: a dry run before the quartet
   ! loop. Primitive-pair screening only shrinks a quartet, so these are
   ! upper bounds.
      self :: INOUT
      pair :: MAT{SHELL1PAIR}, IN

      n_prim_l :: VEC{INT}(17)
      i,j,l,l1,l2,n,n_2d,n_gauss,n_comp :: INT

      ! Largest (primitive pairs)*(l_sum+1) for each pair l_sum
      n_prim_l = 0
      n_gauss  = 0
      n_comp   = 0
      do j = 1,pair.dim2
      do i = 1,pair.dim1
         l = pair(i,j).l_sum
         ENSURE(l<=16,"pair l_sum too large")
         n = pair(i,j).n_gaussian_pairs*(l+1)
         n_prim_l(l+1) = max(n_prim_l(l+1),n)
         n_gauss = max(n_gauss,pair(i,j).n_gaussian)
         n_comp  = max(n_comp,pair(i,j).n_comp_pairs)
      end
      end

      ! 2D integrals: n_roots * (ab prims)*(ab dim) * (cd prims)*(cd dim)
      n_2d = 0
      do l2 = 0,16
      do l1 = 0,16
         n = ((l1+l2+2)/2)*n_prim_l(l1+1)*n_prim_l(l2+1)
         n_2d = max(n_2d,n)
      end
      end

      .ensure(n_2d,n_gauss,n_gauss*n_gauss,n_gauss*n_comp,n_comp*n_comp)

   end

   ensure(n_2d,n_ab,n_esfs,n_escd,n_ints) :: leaky, PURE
   ! Grow the work arrays, where needed, to at least these lengths. They
   ! never shrink.
      self :: INOUT
      n_2d,n_ab,n_esfs,n_escd,n_ints :: INT, IN

      ERI_SCRATCH::grow(.Ix,n_2d)
      ERI_SCRATCH::grow(.Iy,n_2d)
      ERI_SCRATCH::grow(.Iz,n_2d)
      ERI_SCRATCH::grow(.esfs,n_esfs)
      ERI_SCRATCH::grow(.escd,n_escd)
      ERI_SCRATCH::grow(.ints,n_ints)
      ERI_SCRATCH::grow(.ev,n_ab)
      ERI_SCRATCH::grow(.fv,n_ab)

   end

   grow(v,n) :: selfless, private, leaky, PURE
   ! Reallocate "v" to length "n" only if it is shorter.
      v :: VEC{REAL}@, INOUT
      n :: INT, IN

      if (v.allocated) then
         if (v.dim>=n) return
      end

      v.destroy
      v.create(n)

   end

end
