! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
! This library is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
! Library General Public License for more details.
!
! You should have received a copy of the GNU Library General Public
! License along with this library; if not, write to the
! Free Software Foundation, Inc., 59 Temple Place - Suite 330,
! Boston, MA  02111-1307, USA.
!======================================================================

module PLOT_GRID

   implicit none

contains

!  ==========
!  Allocation
!  ==========

   create :: get_from(OBJECT), leaky, PURE
   ! Allocate an object
   end

   destroy :: get_from(OBJECT), leaky, PURE
   ! Deallocate "self"
   end

   create(atom) :: leaky, PURE
   ! Create object
      self :: allocatable, OUT
      atom :: VEC{ATOM}, IN

      .create
      .set_atom_defaults(atom)

   end

   destroy_ptr_part :: leaky, PURE
   ! Destroy the pointer parts
      self :: INOUT

      .plot_kinds.destroy
      .plot_kinds_units.destroy

      .atom.destroy
      .axes.destroy_ptr_part
      .bond_density_atom.destroy

   end

!  ===
!  Set
!  ===

   set_defaults :: PURE
   ! Set up a default grid.
      self :: INOUT

      .plot_kind             = " "
                             
      .orbital               = 0
      .HOMO_orbital          = 0
      .LUMO_orbital          = -1

      .projection_direction  = [ZERO,ZERO,ZERO]

      .axes.set_defaults
      .offset                = ZERO
      .n_x                   = PLOT_GRID_NX
      .n_y                   = PLOT_GRID_NY
      .n_z                   = PLOT_GRID_NZ
      .width(:)              = PLOT_GRID_WIDTH
      .width(3)              = ZERO    ! assume a planar plot
      .del_x                 = .width(1)/(PLOT_GRID_NX - 1)
      .del_y                 = .del_x
      .del_z                 = .del_x
      .x_width_set           = FALSE   ! These are set false only if the widths
      .y_width_set           = FALSE   ! are explicitly read in
      .z_width_set           = FALSE

      .use_bounding_box      = FALSE
      .box_center            = ZERO
      .box_widths            = PLOT_GRID_WIDTH
      .box_scale_factor      = ONE
      .box_axes(:,1)         = [ ONE,ZERO,ZERO]
      .box_axes(:,2)         = [ZERO, ONE,ZERO]
      .box_axes(:,3)         = [ZERO,ZERO, ONE]
      .use_unit_cell_as_bbox = FALSE
      .use_molecules_as_bbox = FALSE
      .box_margin            = 2*BOHR_PER_ANGSTROM
      .plot_atoms            = "box"

      .origin_atom           = FALSE

                             
      .desired_separation    = ZERO
      .points_filename       = "no_made-up_points"
                             
      .plot_units            = " "
      .plot_format           = " "
                             
      .use_plot_max          = FALSE
      .use_plot_min          = FALSE
      .plot_max              = ZERO
      .plot_min              = ZERO
                             
      .contour_min_value     = ZERO
      .contour_max_value     = ZERO

      .contour_min_color.set([253,114,121])
      .contour_mid_color.set([255,255,255])
      .contour_max_color.set([125,114,216])
      .contour_color_scale   = " "

      .contour_scale         = "log"
      .contour_increment     = ZERO
      .contour_line_width    = 1.25d0
      .contour_fade_factor   = 0.8d0
      .contour_tic_dps       = 2
      .contour_font_size     = 9
      .use_colorbox_scale    = TRUE
      .use_ruler_scale       = TRUE

   end

   set_defaults(atom) :: leaky, PURE
   ! Set up atom defaults. "atom" is used to define an xyz bounding
   ! box for the molecule.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .set_defaults
      .set_atom_defaults(atom)

   end

   set_atom_defaults(atom) :: leaky, PURE
   ! Set up atom defaults. "atom" is used to define an xyz bounding
   ! box for the molecule.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .atom = atom
      .set_bbox_with_shape_axes(atom)

   end

   reset_defaults :: PURE
   ! Reset a default grid. The only difference to set_defaults is that
   ! the bounding box and box_axes are not set again.
      self :: INOUT

      .plot_kind      = " "

      .orbital        = 0
      .HOMO_orbital   = 0
      .LUMO_orbital   = -1

      .axes.set_defaults
      .offset         = ZERO


      .n_x            = PLOT_GRID_NX
      .n_y            = PLOT_GRID_NY
      .n_z            = PLOT_GRID_NZ
      .width          = PLOT_GRID_WIDTH
      .width(3)       = ZERO    ! assume a planar plot

      .del_x          = .width(1)/(PLOT_GRID_NX - 1)
      .del_y          = .del_x
      .del_z          = .del_x

      .x_width_set    = FALSE   ! These are set TRUE only if the widths
      .y_width_set    = FALSE   ! are explicitly read in
      .z_width_set    = FALSE


      .desired_separation = ZERO

      .origin_atom        = FALSE
                         
      .plot_units         = " "
      .plot_format        = " "
      .points_filename    = "no_made-up_points"

   end

   set_for_marching_cubes :: PURE
   ! Update and set the grid data to be consistent with the
   ! (non-recursive) marching cubes algorithm. Essentially, a
   ! gridpoint is added along all dimensions.
      self :: INOUT

      .n_x = .n_x + 2
      .n_y = .n_y + 2
      .n_z = .n_z + 2

   ENSURE(.n_x>=4,"not enough x points for marching cube isosurface algorithm")
   ENSURE(.n_y>=4,"not enough y points for marching cube isosurface algorithm")
   ENSURE(.n_z>=4,"not enough z points for marching cube isosurface algorithm")

      ! center remains the same, extra points added around edges
      .width(1)  = .width(1)  + 2*.del_x
      .width(2)  = .width(2)  + 2*.del_y
      .width(3)  = .width(3)  + 2*.del_z

      .origin = .origin - .del_x*.axes.x_axis
      .origin = .origin - .del_y*.axes.y_axis
      .origin = .origin - .del_z*.axes.z_axis

      .n_pt = .n_x*.n_y*.n_z

   end

   set_plot_label(label) :: pure
   ! Set the plot label.
      self :: INOUT
      label :: STR, IN

      .plot_label = label

   end

   set_plot_kind(kind) :: PURE
   ! Set the plot kind to be a certain "kind"
      self :: INOUT
      kind :: STR, IN
      .plot_kind = kind
      .plot_kind.to_lower_case
   end

   set_plot_format(plot_format)
   ! Set the plot kind to be a certain "kind"
      self :: INOUT
      plot_format :: STR, IN

      .plot_format = plot_format
      .plot_format.to_lower_case

      select case (.plot_format)
      case ("all")
      case ("contour")
      case ("cube")
      case ("drishti")
      case ("gaussian")
      case ("gaussian.cube")
      case ("cell.cube")
      case ("gnuplot")
      case ("gnuplot.contour")
      case ("gnuplot.log_contour")
      case ("gnuplot.pos_log_contour")
      case ("mathematica")
      case ("spackman")
      case ("vapor")
      case ("vtk")
      case ("xcrysden")
      case ("xdgraph")
      case default; UNKNOWN(.plot_format)
      end

   end

   set_plot_units(units) :: PURE
   ! Set the plot "units".
      self :: INOUT
      units :: STR, IN

      .plot_units = units
      .plot_units.to_lower_case

   ENSURE(.plot_units.is_known_unit,"unknown unit specified")

   end

   set_bbox_with_current_axes(atom) :: PURE
   ! Set a bounding box to the plot axes, with the current center,
   ! with widths based on the "atom" list. NOTE: This is activated
   ! with the use_bounding_box_and_axes= option.
      self :: INOUT
      atom :: VEC{ATOM}, IN

   ENSURE(.x_or_y_or_z_axes_defined,"you must have already defined some axes!")

      sa :: MAT{REAL}(3,3)

      .use_bounding_box = TRUE

      ! Make shape moments and axes; keep order
      sa = .plot_axes

      ! Set box axes/center
      .box_axes   = sa
      .box_center = .axes.center

      ! Set bounding box
      .box_widths = atom.bounding_box_widths(sa)
      .box_widths = .box_scale_factor*.box_widths

      .use_unit_cell_as_bbox = FALSE

   end

   set_bbox_with_shape_axes(atom) :: PURE
   ! Set up a bounding box based on the "atom" list and ensure that
   ! the x-y-z axis widths x-y-z go longest to shortest.
   ! NOTE: This is set with a use_bounding_box_and_axes= option.
      self :: INOUT
      atom :: VEC{ATOM}, IN

   ENSURE(NOT .x_or_y_or_z_axes_defined,"you already defined some axes!")

      sm :: VEC{REAL}(3)
      sa :: MAT{REAL}(3,3)
      order :: VEC{INT}(3)

      .use_bounding_box = TRUE ! <<<< Careful

      ! Make shape moments and axes; keep order
      atom.make_shape_moments(sm,sa)

      ! Set bounding box
      .box_widths = atom.bounding_box_widths(sa)
      .box_widths = .box_scale_factor*.box_widths

      ! Make the x-axis the longest
      .box_widths.quick_sort(order,decreasing_order=TRUE)

      ! Swap
      sm = sm(order)
      sa = sa(:,order)
      if (sa.determinant<ZERO) sa(:,3) = -sa(:,3)

      ! Set (swap) box axes/center 
      .box_widths = .box_widths(order)
      .box_axes   = sa
      .box_center = atom.center_of_atoms

      .use_unit_cell_as_bbox = FALSE ! <<<< Careful

   end

   set_points_widths_origin :: pure
   ! Set the number of points along the x axis to be odd. Evaluate the
   ! grid point separation .del_x from the current x_width, .width(1);
   ! from this separation, evaluate the number of points along the y
   ! and z axes; adjust the y and z widths to be an exact multiple of
   ! .del_x; finally, set the origin once the widths are known.
      self :: INOUT

      ! Make # of x axis points odd ...
      ! MUST BE IN INPUT
      .n_x = 2*(.n_x/2) + 1

      ! Calculate del_x
      if (.n_x>1) then
         .del_x = .width(1)/(.n_x-1)
         .del_y = .del_x
         .del_z = .del_x
      else if (.n_x==1) then
         .width = ZERO
      end

      ! Adjust y width to the nearest grid point
      .n_y = nint(.width(2)/.del_x)
      .n_y = 2*(.n_y/2) + 1
      .width(2) = .del_x*(.n_y-1)

      ! Adjust z width to the nearest grid point
      .n_z = nint(.width(3)/.del_x)
      .n_z = 2*(.n_z/2) + 1
      .width(3) = .del_x*(.n_z-1)

      .n_pt = .n_x*.n_y*.n_z

      .set_origin

   end

   set_desired_separation(del) :: PURE
   ! Set the (approximate) desired separation "del" between grid
   ! points along an axis direction.  The *actual* separation used may
   ! not be the inputted separation, but may be slightly smaller: the
   ! current .x_width is used to work out the number of points along
   ! the x_axis which is then used to work out the actual .del.  
   ! NOTE: After this routine the y and z widths are changed to be the
   ! nearest multiple of "del" (actually, ".del") that exceeds their
   ! current value.
      self :: INOUT
      del :: REAL, IN

   ENSURE(del>0,"del must be positive")

      .desired_separation = del

      .n_x = ceiling(.width(1)/del)
      .n_y = ceiling(.width(2)/del)
      .n_z = ceiling(.width(3)/del)

      .set_points_widths_origin

   end

   set_center(pos) :: PURE
   ! Set the .center of the grid data to be "pos".
      self :: INOUT
      pos :: VEC{REAL}(3), IN

      .axes.center = pos
      .set_origin

   end

   set_center_from_atom_list(atom) :: PURE
   ! Set the centre of the grid to the position of the centre atom of
   ! "atom", and the origin from it with the current widths
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .axes.set_center_from_atom(atom)
      .set_origin

   end

   set_offset_to_center_of(atom) :: PURE
   ! Set the .offset to the center of an "atom" list. The .origin of
   ! the plot is also set updated.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      val :: VEC{REAL}(3)

      val = atom.center_of_atoms
      .set_offset(val)

   end

   set_offset(val) :: pure
   ! Offset the .center by .offset along the current axes.
      self :: INOUT
      val :: VEC{REAL}(3), IN

      .offset = val
      .set_center_from_offset

   end

   set_offset_cube(val) :: pure
   ! Offset the .center by .offset along the current axes.
      self :: INOUT
      val :: VEC{REAL}(3), IN

      .offset = val

      .set_center_cube_from_offset

   end

   set_center_from_offset :: pure
   ! Offset the .center by .offset along the current axes.
      self :: INOUT

      .axes.center = .axes.center + .offset(1)*.axes.x_axis
      .axes.center = .axes.center + .offset(2)*.axes.y_axis
      .axes.center = .axes.center + .offset(3)*.axes.z_axis
      .set_origin

   end

   set_center_cube_from_offset :: pure
   ! Offset the .center by .offset along the current axes.
      self :: INOUT

      .axes.center = .axes.center + .offset(1)*.axes.x_axis*BOHR_PER_ANGSTROM
      .axes.center = .axes.center + .offset(2)*.axes.y_axis*BOHR_PER_ANGSTROM
      .axes.center = .axes.center + .offset(3)*.axes.z_axis*BOHR_PER_ANGSTROM
      .set_origin

   end

   set_center_to_center_of(atom) :: PURE
   ! Set the .center to the center of an "atom" list. The .origin of
   ! the plot is also set updated.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .axes.center = atom.center_of_atoms
      .set_origin

   end

   set_origin :: pure
   ! Set the origin of the plot (the bottom, front, left-hand corner).
   ! It is equal to the .center of the plot minus half the (current)
   ! .widths along the (current) x, y, and z axes.
      self :: INOUT

      if (.origin_atom) then
         .origin = .axes.center
      else
         .origin = .axes.center
         .origin = .origin -.width(1)*HALF*.axes.x_axis
         .origin = .origin -.width(2)*HALF*.axes.y_axis
         .origin = .origin -.width(3)*HALF*.axes.z_axis
      end

   end

   set_x_axis_from_atom_list(atom) :: PURE
   ! Set the x axis of the grid from its two atoms in "atom". If the
   ! x width was not given it is set to four times the atom separation,
   ! so that those atoms are in the plot. Then the frame is completed.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .axes.set_x_axis_from_atoms(atom)

      if (NOT .x_width_set) then
         .width(1) = FOUR*.axes.x_axis.norm
         if (NOT .y_width_set) .width(2) = .width(1)
         .set_points_widths_origin
      end
      .complete_axes

   end

   set_y_axis_from_atom_list(atom) :: PURE
   ! Set the y axis of the grid from its two atoms in "atom". If the
   ! y width was not given it is set to four times the atom separation,
   ! so that those atoms are in the plot. Then the frame is completed.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .axes.set_y_axis_from_atoms(atom)

      if (NOT .y_width_set) then
         if (.axes.x_axis_defined) then; .width(2) = .width(1)
         else;                           .width(2) = FOUR*.axes.y_axis.norm
         end
         .set_points_widths_origin
      end
      .complete_axes

   end

   set_z_axis_from_atom_list(atom) :: PURE
   ! Set the z axis of the grid from its two atoms in "atom". If the
   ! z width was not given it is set to four times the atom separation,
   ! so that those atoms are in the plot. Then the frame is completed.
      self :: INOUT
      atom :: VEC{ATOM}, IN

      .axes.set_z_axis_from_atoms(atom)

      if (NOT .z_width_set) then
         if (.axes.x_axis_defined) then; .width(3) = .width(1)
         else;                           .width(3) = FOUR*.axes.z_axis.norm
         end
         .set_points_widths_origin
      end
      .complete_axes

   end

   complete_axes :: PURE
   ! Complete the frame about the axes given (see PLOT_AXES:complete)
   ! and set the origin, which depends on the axes
      self :: INOUT

      .axes.complete
      .set_origin

   end

   set_bbox_around(atom,margin) :: PURE
   ! Set the box, along the current axes, to hold every atom of "atom"
   ! with "margin" to spare on each side, and use it: the centre is the
   ! middle of the atoms along those axes. The point counts follow from
   ! the desired separation if one was given.
      self :: INOUT
      atom :: VEC{ATOM}, IN
      margin :: REAL, IN

   ENSURE(atom.dim>0,"no atoms")

      axes :: MAT{REAL}(3,3)
      lo,hi,v :: VEC{REAL}(3)
      a :: INT

      ! The extent of the atoms along the axes
      axes = .plot_axes
      v.to_product_of(axes,atom(1).position,transpose_a=TRUE)
      lo = v
      hi = v
      do a = 2,atom.dim
         v.to_product_of(axes,atom(a).position,transpose_a=TRUE)
         lo = min(lo,v)
         hi = max(hi,v)
      end

      ! The box, and the grid on it
      .box_axes   = axes
      .box_widths = hi - lo + 2*margin
      .box_center = matmul(axes,HALF*(lo+hi))
      .use_bounding_box      = TRUE
      .use_unit_cell_as_bbox = FALSE

      .axes.center = .box_center
      .width       = .box_widths
      if (.desired_separation>ZERO) then
         .set_desired_separation(.desired_separation)
      else
         .set_points_widths_origin
      end

   end

   set_bbox_from_unit_cell(unit_cell,midpt_is_center) :: PURE
   ! Use the "unit_cell" to set the bounding box. This bounding box
   ! must have a desired_separation to ensure even point density and
   ! sampling. The unit cell midpoint 1/2*[1,1,1] (plus any offset) is
   ! the plot center *unless* "midpt_is_center" is FALSE, in which
   ! case any user-defined box_center is used; if this is not set, it
   ! is the origin [0,0,0].
      self :: INOUT
      unit_cell :: UNIT_CELL, IN
      midpt_is_center :: BIN, optional, IN

! ENSURE(.desired_separation>ZERO,"must have non-zero desired_separation")

      mid_is_center :: BIN

      .box_axes = unit_cell.direct_mx

      .use_unit_cell_as_bbox = TRUE

      mid_is_center = TRUE
      if (present(midpt_is_center)) mid_is_center = midpt_is_center

      if (mid_is_center) then
         ! Midpoint (offset) of unit cell
         .axes.center = matmul(.box_axes,[HALF,HALF,HALF]+.offset)
      else
         ! Default: plot box_center is [0,0,0]
         .axes.center = .box_center
      end

      ! Widths are unit cell side lenths
      .width(1) = .box_axes(:,1).norm
      .width(2) = .box_axes(:,2).norm
      .width(3) = .box_axes(:,3).norm

      ! Normalise the box axes
      .box_axes(:,1) = .box_axes(:,1)/.width(1)
      .box_axes(:,2) = .box_axes(:,2)/.width(2)
      .box_axes(:,3) = .box_axes(:,3)/.width(3)

      ! Set plot axes
      .axes.x_axis = .box_axes(:,1)
      .axes.y_axis = .box_axes(:,2)
      .axes.z_axis = .box_axes(:,3)

      ! Scale by requested factor
      .width = .box_scale_factor*.width

      ! Set odd points
      if (.desired_separation>ZERO) then
         .n_x = ceiling(.width(1)/.desired_separation)
         .n_y = ceiling(.width(2)/.desired_separation)
         .n_z = ceiling(.width(3)/.desired_separation)
         ! Make # of axis points odd ...
         .n_x = 2*(.n_x/2) + 1               
         .n_y = 2*(.n_y/2) + 1               
         .n_z = 2*(.n_z/2) + 1               
      else
         .n_x = 2*(.n_x/2) + 1               
         .n_y = 2*(.n_y/2) + 1               
         .n_z = 2*(.n_z/2) + 1               
      end

      .n_pt  = .n_x*.n_y*.n_z

      .del_x = .width(1)/(.n_x-1)
      .del_y = .width(2)/(.n_y-1)
      .del_z = .width(3)/(.n_z-1)

      .set_origin

   end

   set_box_from_widths :: pure
   ! Forces the number of points in the three directions to be odd
   ! Calculates the separations from these.
      self :: INOUT

      .n_pt = .n_x*.n_y*.n_z

      if      (.n_x >1) then; .del_x = .width(1)/(.n_x)
      else if (.n_x==1) then; .width = ZERO
      end

      if      (.n_y >1) then; .del_y = .width(2)/(.n_y)
      else if (.n_y==1) then; .width = ZERO
      end

      if      (.n_z >1) then; .del_z = .width(3)/(.n_z)
      else if (.n_z==1) then; .width = ZERO
      end

      .set_origin

   end

   set_cube_from_widths   :: pure
   ! Set a plot grid which is a cube from the different widths for each
   ! axis (as specified). These means that the separations on each
   ! axis will be different. NOTE: that the axes need not be orthogonal.
      self :: INOUT

      .n_x = 2*(.n_x/2) + 1               ! Make # of axis points odd ...
      .n_y = .n_x                         ! Set other points from x
      .n_z = .n_x                         ! Equal points in all directions

      .n_pt = .n_x*.n_y*.n_z

      if (.n_x>1) then
         .del_x = .width(1)/(.n_x-1)
         .del_y = .width(2)/(.n_y-1)
         .del_z = .width(3)/(.n_z-1)
      else if (.n_x==1) then
         .width = ZERO
      end
      .set_origin

   end

   set_contour_scale(val) :: PURE
   ! Set the conour range scale mapping.
      self :: INOUT
      val :: STR, IN

   ENSURE(val.is_one_of(["linear      ","log         ","negative-log","positive-log"]),"unknown option: "//trim(val))

      .contour_scale = val

   end

   set_contour_min_value(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.contour_min_value), pure
   ! Generic set
   end

   set_contour_max_value(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.contour_max_value), pure
   ! Generic set
   end

   set_contour_increment(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.contour_increment), pure
   ! Generic set
   end

   set_contour_line_width(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.contour_line_width), pure
   ! Generic set
   end

   set_contour_fade_factor(val) :: get_from(OBJECT:set, VAL_TYPE?=>REAL, ARG?=>.contour_fade_factor), pure
   ! Generic set
   end

   set_contour_tic_dps(val) :: get_from(OBJECT:set, VAL_TYPE?=>INT, ARG?=>.contour_tic_dps), pure
   ! Generic set
   end

   set_contour_font_size(val) :: get_from(OBJECT:set, VAL_TYPE?=>INT, ARG?=>.contour_font_size), pure
   ! Generic set
   end

   set_contour_color_scale(val) :: get_from(OBJECT:set, VAL_TYPE?=>STR, ARG?=>.contour_scale), pure
   ! Generic set
   end

   set_use_colorbox_scale(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.use_colorbox_scale), pure
   ! Generic set
   end

   set_use_ruler_scale(val) :: get_from(OBJECT:set, VAL_TYPE?=>BIN, ARG?=>.use_ruler_scale), pure
   ! Generic set
   end

!  ==============
!  Bond alignment
!  ==============

   use_bond_axis_as_z_axis
   ! Align the bond axis (given in .bond_density_atoms) onto the z
   ! axis. Also print the positions of the bond axis atoms B and A and
   ! the neighbouring atoms of atom A in anticlockwise direction,
   ! along with the atomic numbers and rotation angles.
      self :: INOUT

      Z :: VEC{INT}@
      pos :: MAT{REAL}@
      theta :: VEC{REAL}@
      i :: INT

      ! Get the positions
      .get_bond_atoms_on_z_axis(pos,Z,theta)

      ! Print the positions of the atoms A, B and
      ! neighbour atoms n1,n2, .... in anticlockwise order
      stdout.text("Rotated positions of atoms B, A, n1, n2 ...")
      stdout.text("relative to the plot origin")
      do i = 1,Z.dim
         stdout.put(pos(1,i))
         stdout.put(pos(2,i))
         stdout.put(pos(3,i))
         stdout.put(Z(i))
         stdout.put(theta(i))
         stdout.flush
      end

      ! Clean up
      theta.destroy
      Z.destroy
      pos.destroy

   end

   get_bond_atoms_on_z_axis(pos,Z,theta) :: leaky, PURE
   ! Get "pos", the positions of the atoms on the bond axis, aligned
   ! so that the bond axis is on the z axis. The atom positions are in
   ! the order B, A, followed by the neighbours of atom A, in
   ! anticlockwise order. Also get the atomic numbers "Z"
   ! corresponding to the atom positions in "pos", and the
   ! corresponding rotation angles "theta" around the bond axis
   ! NOTE: the routine sets the plot width to be the AB bond length
   ! times the .box_scale_factor
      self :: INOUT
      pos :: MAT{REAL}@, OUT
      Z   :: VEC{INT}@, OUT
      theta :: VEC{REAL}@, OUT

   ENSURE(.bond_density_atom.allocated,"no bond_density_atoms")
   ENSURE(.bond_density_atom.dim==3,"must have 3 bond_density_atoms")
   ENSURE(.axes.x_atom_1/=0 AND .axes.x_atom_2/=0,"must have x axis atoms")
   ENSURE(.atom.allocated,"must have a list of atoms")

      a,b,c,n,i :: INT
      x,y,d_max :: REAL
      na,order :: VEC{INT}@
      v :: VEC{REAL}(3)
      R :: MAT{REAL}(3,3)

      ! Get a, b, c atoms
      a = .bond_density_atom(1)
      b = .bond_density_atom(2)
      c = .bond_density_atom(3) ! this must be either a or b

      ! If the third bond atom c is equal to b, swap
      ! a and b so that atom a has neighbours.
      if (c==b) then
         b = a
         a = c
      end

      ! Get the neighbours of A
      na = .atom.neighbours_of(a)

      ! Get the plot axes. First make the z axis
      .axes.z_axis = .atom(b).position - .atom(a).position
      .axes.z_axis.normalize

      ! Make the x axis orthogonal to z axis
      .axes.x_axis = .atom(.axes.x_atom_2).position - .atom(.axes.x_atom_1).position
      .axes.x_axis = .axes.x_axis - dot_product(.axes.x_axis,.axes.z_axis)*.axes.z_axis
      .axes.x_axis.normalize

      ! Now make the y axis
      .axes.y_axis = .axes.z_axis.cross(.axes.x_axis)

      ! Set the center of the plot to be atom a position
      .axes.center = .atom(a).position

      ! Get the plot with as 2 times the largest bond
      ! length to the central atom a
   ! n = na.dim
   ! d_max = ZERO
   ! do i = 1,n
   !    d_max = max(d_max,.atom.bond_distance(a,na(i)))
   ! end
   ! .width(1) = 2*d_max
   ! .width(2) = 2*d_max
   ! .width(3) = 2*d_max

      ! Make the plot size 2 times the bond length
      d_max = .atom.bond_distance(a,b)
      .width(1) = .box_scale_factor*d_max
      .width(2) = .box_scale_factor*d_max
      .width(3) = .box_scale_factor*d_max

      .set_points_widths_origin
      .x_width_set = TRUE
      .y_width_set = TRUE
      .z_width_set = TRUE

      ! Remove atom B from the neighbours of A
      na.prune(b)

      ! Allocate space for positions, atomic numbers, angles
      n = na.dim
      pos.create(3,n+2)
      Z.create(n+2)
      theta.create(n)

      ! Get the cos and sin of the neighbours
      ! and sort into anticlockwise order
      order.create(n)
      if (n>0) then
         do i = 1,n
            v = .atom(na(i)).position - .atom(a).position
            v.normalize
            x = dot_product(v,.axes.x_axis)
            y = dot_product(v,.axes.y_axis)
            theta(i) = atan2(y,x)*DEGREE_PER_RADIAN
         end
         theta.quick_sort(order)
         theta = theta(order)
         na = na(order)
      end
      order.destroy

      ! Make the rotation matrix which rotates the bond
      ! axis to the z axis
      R(1,:) = .axes.x_axis
      R(2,:) = .axes.y_axis
      R(3,:) = .axes.z_axis

      ! Get the rotated position of atom B
      v = .atom(b).position - .axes.center
      pos(:,1).to_product_of(R,v)
      Z(1) = .atom(b).atomic_number

      ! Get the rotated position of atom A
      v = .atom(a).position - .axes.center
      pos(:,2).to_product_of(R,v)
      Z(2) = .atom(a).atomic_number

      ! Get the rotated position of neighbours of atom A
      if (n>0) then
         do i = 1,n
            v = .atom(na(i)).position - .axes.center
            pos(:,i+2).to_product_of(R,v)
            Z(i+2) = .atom(na(i)).atomic_number
         end
      end

      ! Add the theta angles for the B and A atoms
      theta.prepend([ZERO,ZERO])

      ! Clean up
      na.destroy

   end

   align_to_bond
   ! Make the rotation matrix R which aligns the bond axis given in
   ! .bond_density_atoms along the z axis
   ! WARNING: do not set n_points in the input after this routine
      self :: INOUT

      pos,pos0,pos0r,pos_keep,p :: MAT{REAL}@
      Z,Z0   :: VEC{INT}@
      theta,theta0 :: VEC{REAL}@
      x,y :: VEC{REAL}(3)
      R :: MAT{REAL}(3,3)
      found :: BIN
      word :: STR
      fac_z,fac_r,r_ab,r_ab0,d2,angle,a,b,c,dist2,an,top,bot :: REAL
      n,i,s :: INT

      ! Get the positions
      .get_bond_atoms_on_z_axis(pos,Z,theta)

      ! Print out again the bond atom positions
      stdout.text("Rotated positions of bond atoms B, A, n1, n2 ...(N')")
      do i = 1,Z.dim
         stdout.put(pos(1,i))
         stdout.put(pos(2,i))
         stdout.put(pos(3,i))
         stdout.put(Z(i))
         stdout.put(theta(i))
         stdout.flush
      end

      ! Get the number of atoms including A and B
      n = Z.dim
      ENSURE(n>1,"must have at least two atoms!")

      ! Create space for reference positions, atomic numbers,
      ! and angles
      pos0.create(3,n)
      Z0.create(n)
      theta0.create(n)

      ! Read in the reference positions we align to
      stdin.read(word)
      ENSURE(word=="{","missing open curly bracket?")
      do i = 1,n
         stdin.read(pos0(:,i))
         stdin.read(Z0(i))
         stdin.read(theta0(i))
      end
      stdin.read(word)
      ENSURE(word=="}","missing close curly bracket?")

      ! Print out again the reference positions
      stdout.text("Rotated positions of REFERENCE bond atoms ... (N0)")
      do i = 1,Z0.dim
         stdout.put(pos0(1,i))
         stdout.put(pos0(2,i))
         stdout.put(pos0(3,i))
         stdout.put(Z0(i))
         stdout.put(theta0(i))
         stdout.flush
      end

      ! Find the cyclic permutation shift that causes the atomic
      ! numbers Z to match the reference ones in Z0
      found = FALSE
      do s = 0,n-3
         if (any(cshift(Z(3:),s)/=Z0(3:))) cycle
         found = TRUE
         exit
      end
      DIE_IF(NOT found,"a matching shift was not found!")
      stdout.show("shift left/up      =",s)

      Z(3:)     = cshift(Z(3:),s)
      theta(3:) = cshift(theta(3:),s)
      pos(:,3:) = cshift(pos(:,3:),s,dim=2)

      pos_keep = pos

      ! Print out again the bond atom positions
      stdout.text("Cyclic shifted neighbour positions ...")
      do i = 1,Z.dim
         stdout.put(pos(1,i))
         stdout.put(pos(2,i))
         stdout.put(pos(3,i))
         stdout.put(Z(i))
         stdout.put(theta(i))
         stdout.flush
      end

      ! Work out at the optimum rotation angle which rotates N0 to N'
      a = sum( (pos0(1,3:)*pos0(1,3:) + pos0(2,3:)*pos0(2,3:) + pos0(3,3:)*pos0(3,3:)) ) &
        + sum( ( pos(1,3:)* pos(1,3:) +  pos(2,3:)* pos(2,3:) +  pos(3,3:)* pos(3,3:)) ) &
        - TWO*sum(pos(3,3:)*pos0(3,3:))
      b = -TWO*sum(pos(1,3:)*pos0(1,3:)) - TWO*VEC{REAL}:sum_elements(pos(2,3:)*pos0(2,3:))
      c = -TWO*sum(pos(2,3:)*pos0(1,3:)) + TWO*VEC{REAL}:sum_elements(pos(1,3:)*pos0(2,3:))
      angle = atan(c/b)
      stdout.show("a =",a)
      stdout.show("b =",b)
      stdout.show("c =",c)

      ! Does this have a negative second derivative?
      ! If not, add pi to the solution
      d2 = -b*cos(angle) - c*sin(angle)
      if (d2<ZERO) angle = angle + PI
      dist2 = a + b*cos(angle) + c*sin(angle)
      stdout.show("rotation angle converting reference to this geometry (degrees) =",angle*DEGREE_PER_RADIAN)
      stdout.show("distance2                                                      =",dist2)

      ! Now, rotate the x and y plot axes by the angle
      x =  cos(angle)*.axes.x_axis + sin(angle)*.axes.y_axis
      y = -sin(angle)*.axes.x_axis + cos(angle)*.axes.y_axis
      .axes.x_axis = x
      .axes.y_axis = y

      ! Get the matrix which rotates reference (N0)
      ! to this position (N')
      R(:,3) = [ZERO,ZERO,ONE]
      R(3,:) = [ZERO,ZERO,ONE]
      R(1,1) = cos(angle); R(1,2) = -sin(angle)
      R(2,1) = sin(angle); R(2,2) =  cos(angle)

      stdout.text("Matrix which rotates reference (N0) to this position (N'):")
      stdout.put(R)

      ! Print out again the bond atom positions
      ! and check squared distance
      stdout.text("Rotated neighbour positions (R^T N') which match scaled reference (N0)")
      p = pos
      pos.to_product_of(R,p,transpose_a=TRUE)
      p.destroy
      dist2 = ZERO
      do i = 1,Z.dim
         stdout.put(pos(1,i))
         stdout.put(pos(2,i))
         stdout.put(pos(3,i))
         stdout.put(Z(i))
         if (i>2) then
         stdout.put(theta(i)-angle*DEGREE_PER_RADIAN)
         dist2 = dist2 + VEC{REAL}:sum_elements((pos(:,i) - pos0(:,i))*(pos(:,i)-pos0(:,i)))
         else
         stdout.put(theta(i))
         end
         stdout.flush
      end
      stdout.show("distance2 (should be same as above)                            =",dist2)

      ! Get the z scale factor which scales reference N0
      ! to *this* geonmetry N'
      r_ab  = pos(3,1)  - pos(3,2)
      r_ab0 = pos0(3,1) - pos0(3,2)
      fac_z = r_ab/r_ab0
      stdout.show("Z scale factor scaling N0 to N1 =",fac_z)

      ! Get the radial scale factor from the
      ! rotated reference atom positions
      if (n==2) then
         fac_r = ONE        ! no neighbours
      else
         top = ZERO
         bot = ZERO
         do i = 3,n
            top = top + dot_product(pos0(1:2,i),pos(1:2,i))
            bot = bot + dot_product(pos0(1:2,i),pos0(1:2,i))
         end
         fac_r = top/bot
      end
      stdout.show("radial scale factor =",fac_r)

      ! Rotate and stretch reference positions "pos0" so they
      ! match this set of positions "pos"
      ! No need to rotate as the plot axes are rotated
      ! to simulate a rotation of this molecule
      pos0r.create(3,pos0.dim2)
      pos0r.to_product_of(R,pos0)

      ! Scale pos0
      pos0(3  ,:) = pos0(3  ,:)*fac_z
      pos0(1:2,:) = pos0(1:2,:)*fac_r

      ! Scale pos0r
      pos0r(3  ,:) = pos0r(3  ,:)*fac_z
      pos0r(1:2,:) = pos0r(1:2,:)*fac_r

      ! Now, scale the radial plot widths to match
      ! the reference positions
      .width(1) = .width(1)*fac_r
      .width(2) = .width(2)*fac_r
      .width(3) = .width(3)
      .x_width_set = TRUE
      .y_width_set = TRUE
      .z_width_set = TRUE

      ! Make sure axes widths, etc, are OK. Checked.
      ! This grid has unequal spacings in z, y and x
      ! WARNING: do not set n_points after this routine
   ! .set_points_widths_origin
      .n_x = 2*(.n_x/2) + 1
      if (.n_x>1) then
         .del_x = .width(1)/(.n_x-1)
         .del_y = .width(2)/(.n_y-1)
         .del_z = .width(3)/(.n_z-1)
      else if (.n_x==1) then
         .width = ZERO
      end
      .n_pt = .n_x*.n_y*.n_z
      .set_origin

      ! Print out the scaled reference atom positions
      ! "pos0" in cube file format ...
      stdout.text("Scaled, rotated reference positions (R N0) which match original positions (N')")
      stdout.text("Place these in the cube file")
      stdout.save_style                ! Save settings
      stdout.set_real_fortran_fmt("e") ! Gaussian format
      stdout.set_real_width(13)
      stdout.set_real_precision(5)
      dist2 = ZERO
      do i = 1,Z.dim
         stdout.put(Z0(i))             ! Z
         an = Z0(i)
         stdout.put(an,precision=1)    ! Charge
         stdout.put(pos0(1,i))         ! Pos in plot grid axis system
         stdout.put(pos0(2,i))
         stdout.put(pos0(3,i))
         stdout.flush
         if (i>2) then
         dist2 = dist2 + VEC{REAL}:sum_elements((pos0r(:,i) - pos_keep(:,i))*(pos0r(:,i)-pos_keep(:,i)))
         end
      end
      stdout.unsave_style            ! Put back settings
      stdout.show("distance2 (should be smaller than above)                       =",dist2)

      ! Clean up
      theta0.destroy; Z0.destroy; pos0.destroy; pos0r.destroy
      theta.destroy;  Z.destroy;  pos.destroy; pos_keep.destroy

   end

!  ==============
!  Atom positions
!  ==============

   get_rotated_atom_positions(pos) :: leaky, PURE
   ! Calculate the atom positions "pos" which have been shifted to the
   ! grid center and rotated to the grid axes.
      self :: IN
      pos :: MAT{REAL}@, OUT

   ENSURE(.atom.allocated,"no atoms!")

      p :: MAT{REAL}@
      axes :: MAT{REAL}(3,3)
      limits :: VEC{REAL}(3)
      a,n :: INT

      ! No of atoms
      n = .atom.dim

      ! Create positions (leaky)
      pos.create(3,n)

      ! Shift atom positions
      do a = 1,n
         pos(:,a) = .atom(a).position - .axes.center
      end

      ! Rotate positions into plot grid axis
      axes = .transposed_plot_axes
      p.create(3,n)
      p.to_product_of(axes,pos)
      pos = p
      p.destroy

      ! Adjust positions to be within plot box width
      limits = .width*HALF
      do a = 1,n
         where (pos(:,a)>+limits) pos(:,a) = +limits
         where (pos(:,a)<-limits) pos(:,a) = -limits
      end

   end

   get_rotoranged_atom_positions(math_pos,z_range,valid) :: leaky, PURE
   ! Calculate the positions "math_pos" of the valid atoms which have
   ! been rotated and shifted and scaled into grid point coordinates.
   ! Valid atoms are those which are within "z_range" of the plot
   ! plane; the indices of the valid atoms are stored in "valid"
      self :: IN
      math_pos :: MAT{REAL}@, OUT
      z_range :: REAL, IN
      valid :: VEC{INT}@, OUT

   ENSURE(.atom.allocated,"no atoms!")
   ENSURE(z_range>ZERO,"z_range must be non-negative")
   ENSURE(math_pos.deallocated,"math_pos, already allocated")
   ENSURE(valid.deallocated,"valid, already allocated")

      scale_factor,p :: VEC{REAL}(3)
      tr :: MAT{REAL}(3,3)
      pos :: MAT{REAL}@
      n,nv,a,i :: INT

      ! Get shifted atom positions
      n = .atom.dim
      pos.create(n,3)
      do a = 1, n
         pos(a,:) = .atom(a).position - .origin    !shift
      end

      ! Rotate positions into plot grid axis
      tr = .transposed_plot_axes
      do a = 1, n
         p = pos(a,:)
         pos(a,:).to_product_of(tr,p)
      end

      ! Reject atoms far from plot plane, get valid atoms
      valid.create(0)
      do a = 1, n
         ! if ( abs(pos(a,z)) > z_range) cycle
         if ( abs(pos(a,3)) > z_range) cycle
         valid.append(a)
      end

      ! Create list of valid atoms positions
      nv = valid.dim
      math_pos.create(nv,3)
      i = 0
      do a = 1, n
         if ( abs(pos(a,3)) > z_range) cycle
         i = i + 1
         math_pos(i,:) = pos(a,:)
      end

      ! Finally, scale positions
      scale_factor(1) = (.n_x - ONE) / .width(1)
      scale_factor(2) = (.n_y - ONE) / .width(2)
      scale_factor(3) = ZERO
      do a = 1,nv
         math_pos(a,:) = scale_factor * math_pos(a,:) + ONE ! since plot begins at 1
      end

      pos.destroy

   end

!  =======
!  Inquiry
!  =======

   atom_data_used result (res) :: pure
   ! Return TRUE if atom-based data was used to specify plot axes.
      self :: IN
      res :: BIN

      res = .axes.center_atoms.allocated OR .axes.x_atom_1/=0 OR .axes.y_atom_1 /=0

   end

   x_or_y_axes_defined result (res) :: pure
   ! Return TRUE if the x or y axes have been explicitly inputted.
      self :: IN
      res :: BIN

      res = .axes.x_axis_defined OR .axes.y_axis_defined

   end

   x_or_y_or_z_axes_defined result (res) :: pure
   ! Return TRUE if any of the x or y or z axes have been explicitly
   ! inputted.
      self :: IN
      res :: BIN

      res = .axes.x_axis_defined OR .axes.y_axis_defined OR .axes.z_axis_defined

   end

   has_orthogonal_plot_axes result (res) :: pure
   ! Return TRUE if the plot axes are orthogonal
      self :: IN
      res :: BIN

      dot :: REAL

      dot = dot_product(.axes.x_axis,.axes.y_axis)
      res = dot.is_zero
      if (NOT res) return

      dot = dot_product(.axes.x_axis,.axes.z_axis)
      res = dot.is_zero
      if (NOT res) return

      dot = dot_product(.axes.y_axis,.axes.z_axis)
      res = dot.is_zero

   end

   has_equal_spacing result (res) :: pure
   ! Return TRUE if the plot spacings are all equal
      self :: IN
      res :: BIN

      res = .del_x.equals(.del_y)
      if (NOT res) return

      res = .del_x.equals(.del_z)
      if (NOT res) return

      res = .del_y.equals(.del_z)

   end

   plot_axes result (res) :: pure
   ! Return the plot axes as a matrix.
      self :: IN
      res :: MAT{REAL}(3,3)

      res(:,1) = .axes.x_axis
      res(:,2) = .axes.y_axis
      res(:,3) = .axes.z_axis

   end

   volume result (res) :: PURE
   ! Return the volume of the plot box.
   ! PURE (the macro), not `pure` (the keyword): it calls .determinant, which
   ! is itself PURE, and PURE expands to nothing in a debug build. A lower-case
   ! `pure` caller keeps its purity while its callee loses it, which is a
   ! compile error in every debug build -- see CLAUDE.md on PURE vs pure.
      self :: IN
      res :: REAL

      axes :: MAT{REAL}(3,3)

      axes = .plot_axes
      res  = abs(axes.determinant) * product(.width)

   end

   pixel_volume result (res) :: PURE
   ! Return the volume of one voxel of the plot grid.
      self :: IN
      res :: REAL

      n :: INT

      n = (.n_x-1)*(.n_y-1)*(.n_z-1)
      res = .volume/n

   end

   transposed_plot_axes result (res) :: pure
   ! Return the transposed plot axis matrix.
      self :: IN
      res :: MAT{REAL}(3,3)

      res(1,:) = .axes.x_axis
      res(2,:) = .axes.y_axis
      res(3,:) = .axes.z_axis

   end

   plot_file_name(n_a) result (res) :: PURE
   ! Return the name of the file in which the plot values are stored.
   ! "n_a" is the number of alpha electrons used to obtain the actual
   ! orbital index as an offset from the HOMO/LUMO index.
      self :: IN
      n_a  :: INT, optional, IN
      res :: STR

      res = .plot_file_name(.plot_kind,n_a)

   end

   plot_file_name(plot_kind,n_a) result (res) :: PURE
   ! Return the name of the file corresponding to "plot_kind" in which
   ! the plot values are stored.  "n_a" is the number of alpha
   ! electrons used to obtain the actual orbital index as an offset
   ! from the HOMO/LUMO index.
      self :: IN
      plot_kind :: STR, IN
      n_a  :: INT, optional, IN
      res :: STR

      orb :: INT

      res = plot_kind
      res = res.trim_from_end("_grid")

      ! Fix up special file names
      select case (res)

      case("orbital_density                     ")

         ! Sanity test!
         ENSURE(present(n_a),"must supply n_a argument!")

         ! Get the orbital index
         orb = .orbital
         if (orb==0) then
            if      (.HOMO_orbital/= 0) then; orb = n_a + .HOMO_orbital
            else if (.LUMO_orbital/=-1) then; orb = n_a + .LUMO_orbital ! -1 Error?
            else;                             orb = n_a
            end
            ENSURE(orb>0,"non positive orbital")
         end

         res = "orbital_"// trim(orb.to_str) // "_density"

      end

      ! Add _grid to the end
      res = trim(res) // trim("_grid")

   end

!  =====
!  Input
!  =====

   read_keywords :: get_from(OBJECT), leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) :: leaky
   ! Process command "keyword". Any required data needed by the "keyword" is
   ! inputted from "stdin".
      self :: INOUT
      keyword :: STR, IN

      word :: STR

      word = keyword
      word.to_lower_case

      select case (word)
      case ("}                         ")  ! exit case
      case ("align_to_bond=            "); .align_to_bond
      case ("bond_density_atoms=       "); .read_bond_density_atoms
      case ("box_margin=               "); .read_box_margin
      case ("box_scale_factor=         "); .read_box_scale_factor
      case ("center=                   "); .read_center
      case ("centre=                   "); .read_center
      case ("center_atom=              "); .read_center_atom
      case ("center_atoms=             "); .read_center_atoms
      case ("centre_atom=              "); .read_center_atom
      case ("centre_atoms=             "); .read_center_atoms
      case ("contour_color_scale=      "); .read_contour_color_scale
      case ("contour_tic_dps=          "); .read_contour_tic_dps
      case ("contour_fade_factor=      "); .read_contour_fade_factor
      case ("contour_font_size=        "); .read_contour_font_size
      case ("contour_increment=        "); .read_contour_increment
      case ("contour_line_width=       "); .read_contour_line_width
      case ("contour_max_color=        "); .read_contour_max_color
      case ("contour_max_value=        "); .read_contour_max_value
      case ("contour_mid_color=        "); .read_contour_mid_color
      case ("contour_min_color=        "); .read_contour_min_color
      case ("contour_min_value=        "); .read_contour_min_value
      case ("contour_scale=            "); .read_contour_scale
      case ("crystal_plane=            "); .read_z_axis
      case ("cube_scale_factor=        "); .read_cube_scale_factor
      case ("desired_separation=       "); .read_desired_separation
      case ("group=                    "); .read_group
      case ("electric_potential_method="); .read_electric_potential_method
      case ("homo_orbital_plus=        "); .read_HOMO_orbital_plus
      case ("homo_orbital_minus=       "); .read_HOMO_orbital_minus
      case ("kind=                     "); .read_plot_kind
      case ("kinds=                    "); .read_plot_kinds
      case ("lumo_orbital_plus=        "); .read_LUMO_orbital_plus
      case ("max_x_points=             "); .read_max_x_points
      case ("min_x_points=             "); .read_min_x_points
      case ("n_all_points=             "); .read_all_points
      case ("n_points=                 "); .read_x_points
      case ("n_x=                      "); .read_n_x
      case ("n_y=                      "); .read_n_y
      case ("n_z=                      "); .read_n_z
      case ("normal=                   "); .read_z_axis
      case ("offset=                   "); .read_offset
      case ("offset_cube=              "); .read_offset_cube
      case ("orbital=                  "); .read_orbital
      case ("origin_atom=              "); .read_origin_atom
      case ("plot_atoms=               "); .read_plot_atoms
      case ("plot_format=              "); .read_plot_format
      case ("plot_kind=                "); .read_plot_kind
      case ("plot_kinds=               "); .read_plot_kinds
      case ("plot_kinds_units=         "); .read_plot_kinds_units
      case ("plot_label=               "); .read_plot_label
      case ("plot_max=                 "); .read_plot_max
      case ("plot_min=                 "); .read_plot_min
      case ("plot_units=               "); .read_plot_units
      case ("projection_direction=     "); .read_projection_direction
      case ("put                       "); .put
      case ("units=                    "); .read_plot_units
      case ("use_bbox                  "); .use_bbox_with_current_axes
      case ("use_bbox_with_shape_axes  "); .use_bbox_with_shape_axes
      case ("use_bcube                 "); .use_bcube_with_current_axes
      case ("use_bcube_with_shape_axes "); .use_bcube_with_shape_axes
      case ("use_bond_axis_as_z_axis   "); .use_bond_axis_as_z_axis
      case ("use_bounding_box          "); .use_bbox_with_current_axes
      case ("use_bounding_box_and_axes "); .use_bbox_with_shape_axes
      case ("use_bounding_cube         "); .use_bcube_with_current_axes
      case ("use_bounding_cube_and_axes"); .use_bcube_with_shape_axes
      case ("use_colorbox_scale=       "); .read_use_colorbox_scale
      case ("use_plot_max=             "); .read_use_plot_max
      case ("use_plot_min=             "); .read_use_plot_min
      case ("use_ruler_scale=          "); .read_use_ruler_scale
      case ("use_molecules_as_bbox     "); .use_molecules_as_bbox = TRUE
      case ("use_unit_cell_as_bbox     "); .use_unit_cell_as_bbox = TRUE
      case ("x_axis=                   "); .read_x_axis
      case ("x_axis_atoms=             "); .read_x_axis_atoms
      case ("x_axis_atom_list=         "); .read_x_axis_atom_list
      case ("x_points=                 "); .read_x_points
      case ("x_width=                  "); .read_x_width
      case ("y_axis=                   "); .read_y_axis
      case ("y_axis_atoms=             "); .read_y_axis_atoms
      case ("y_axis_atom_list=         "); .read_y_axis_atom_list
      case ("y_width=                  "); .read_y_width
      case ("z_axis=                   "); .read_z_axis
      case ("z_width=                  "); .read_z_width
      case ("3d_points_filename=       "); .read_points_filename
      case default;                    UNKNOWN(word)
      end

   end

   read_plot_units
   ! Read the units to which the plot should be converted to.
      self :: INOUT

      units :: STR

      stdin.read(units)
      .set_plot_units(units)

   end

   read_plot_kinds_units :: leaky
   ! Read a string vector which describes the units to be used
   ! for each of the plot_kinds_units
      self :: INOUT

      stdin.read_all(.plot_kinds_units)
      .plot_kinds_units.to_lower_case

   end

   read_plot_atoms
   ! Read which atoms a cube file lists: "box", "unit_cell" or "molecules"
      self :: INOUT

      stdin.read(.plot_atoms)
      .plot_atoms.to_lower_case

   DIE_IF(NOT .plot_atoms.is_one_of(["box      ","unit_cell","molecules"]),"plot_atoms must be box, unit_cell or molecules")

   end

   read_box_margin
   ! Read the space left between the outermost atom and a box set around
   ! the molecules, a length with units
      self :: INOUT

      stdin.read_quantity(.box_margin)

   DIE_IF(.box_margin<ZERO,"box_margin must not be negative")

   end

   read_plot_format
   ! Read the format of the plot file
      self :: INOUT

      plot_format :: STR

      stdin.read(plot_format)
      .set_plot_format(plot_format)

   end

   read_plot_max
   ! Read the plot maximum to use
      self :: INOUT

      stdin.read_quantity(.plot_max)
      .use_plot_max = TRUE

   end

   read_plot_min
   ! Read the plot minimum to use
      self :: INOUT

      stdin.read_quantity(.plot_min)
      .use_plot_min = TRUE

   end

   read_use_plot_max
   ! Read whether to use the plot maximum
      self :: INOUT
      stdin.read(.use_plot_max)
   end

   read_use_plot_min
   ! Read whether to use the plot minimum
      self :: INOUT
      stdin.read(.use_plot_min)
   end

   read_plot_kind
   ! Read in the plot kind
      self :: INOUT

      kind :: STR

      stdin.read(kind)
      .set_plot_kind(kind)

   end

   read_plot_kinds :: leaky
   ! Read in the plot kind
      self :: INOUT

      n :: INT

      stdin.read_all(.plot_kinds)

      .plot_kinds.to_lower_case

      n = .plot_kinds.dim
      .plot_kinds_units.create(n)
      .plot_kinds_units = " "

   end

   read_plot_label
   ! Read in the plot label
      self :: INOUT

      label :: STR

      stdin.read(label)
      .set_plot_label(label)

   end

   read_desired_separation
   ! Read the (approximate) desired separation between grid points along an axis
   ! direction.  The number of x points for the plot is adjusted so that the
   ! *actual* separation is less than the inputted separation. NOTE: the current
   ! .x_width is used to calculate the number of points.
      self :: INOUT
   
   ENSURE(.n_x>1,"# of x_points must be greater than 1")

      del :: REAL

   WARN_IF(NOT .x_width_set,"default x_width used to calculate # of x_points")

      stdin.read_quantity(del)
      .set_desired_separation(del)

   end

   read_group
   ! Read the molecular group to plot in a fragment_plot.
      self :: INOUT
      stdin.read(.group)
   end

   read_electric_potential_method
   ! Read a string representing which method to use when calculating
   ! electric potential on the generated isosurface
      self :: INOUT
      stdin.read(.electric_potential_method)
   end

   read_max_x_points
   ! Read the *maximum number* of x points to be used for the plot.
   ! The number of points is adjusted to be no more than this.
      self :: INOUT

      max_n_x :: INT

      stdin.read(max_n_x)
      if (.n_x<=max_n_x) return

      .n_x = max_n_x
      WARN_IF(.n_x.is_even,"resetting to nearest odd number")

      .set_points_widths_origin

   end

   read_min_x_points
   ! Read the *minimum number* of x points to be used for the plot.
      self :: INOUT

      min_n_x :: INT

      stdin.read(min_n_x)
      if (min_n_x<=.n_x) return

      .n_x = min_n_x
      WARN_IF(.n_x.is_even,"resetting to nearest odd number")

      .set_points_widths_origin

   end

   read_all_points 
   ! Read the number of x y and z points for the plot. This is the precision
   ! of the plot.
      self :: INOUT

      grid_points :: VEC{INT}(3)

      stdin.read(grid_points)

      .n_x = grid_points(1)
      .n_y = grid_points(2)
      .n_z = grid_points(3)

   ENSURE( .n_x>0,"number of x_points must be positive")
   ENSURE( .n_y>0,"number of y_points must be positive")
   ENSURE( .n_z>0,"number of z_points must be positive")

   end

   read_x_points
   ! Read the number of x points for the plot. This is the precision
   ! of the plot.
      self :: INOUT

      stdin.read(.n_x)
      ENSURE( .n_x>0,"number of x_points must be positive")

      WARN_IF(.n_x.is_even,"resetting to nearest odd number")

      .set_points_widths_origin

   end

   read_n_x
   ! Read the value of n_x and nothing else.
   ! WARNING: use only for unit_cell as bbox.
   ! of the plot.
      self :: INOUT

      stdin.read(.n_x)
      ENSURE(.n_x>0,"n_x must be positive")

   end

   read_n_y
   ! Read the value of n_y and nothing else.
   ! WARNING: use only for unit_cell as bbox.
   ! of the plot.
      self :: INOUT

      stdin.read(.n_y)
      ENSURE(.n_y>0,"number n_y must be positive")

   end

   read_n_z
   ! Read the value of n_z and nothing else.
   ! WARNING: use only for unit_cell as bbox.  of the plot.
      self :: INOUT

      stdin.read(.n_z)
      ENSURE(.n_z>0,"number n_z must be positive")

   end

   read_offset
   ! Read a 3-vector, used to offset the plot along.
      self :: INOUT

      val :: VEC{REAL}(3)

      stdin.read_quantity(val)
      .set_offset(val)

   end

   read_offset_cube
   ! Read a 3-vector, used to offset the plot along.
      self :: INOUT

      val :: VEC{REAL}(3)

      stdin.read_quantity(val)
      .set_offset_cube(val)

   end

   read_orbital
   ! Read the orbital to plot out
      self :: INOUT
      stdin.read(.orbital)
   end

   read_origin_atom
   ! Read whether the centre atom should be the origin of the plot
   ! default FALSE
      self :: INOUT
      stdin.read(.origin_atom)
   end

   read_HOMO_orbital_plus
   ! Read the HOMO orbital to plot out. This is actually the index "n", where
   ! the orbital plotted out is "HOMO+n". The default value for n is 0, i.e. the
   ! HOMO is plotted out.
      self :: INOUT

      stdin.read(.HOMO_orbital)

   ENSURE(.HOMO_orbital<=0,"HOMO orbital must be less than or equal to zero")

   end

   read_HOMO_orbital_minus
   ! Read the minus HOMO orbital to plot out. This actually the index "n" where
   ! the orbital to be plotted out is "HOMO-n". The default value for n is 0,
   ! i.e. the HOMO is plotted out.
      self :: INOUT

      orb :: INT

      stdin.read(orb)

      .HOMO_orbital = -orb

   ENSURE(.HOMO_orbital<=0,"HOMO orbital must be less than or equal to zero")

   end

   read_LUMO_orbital_plus
   ! Read the LUMO orbital to plot out. This is actually the index "n" where the
   ! orbital to be plotted out is "LUMO+n". The default value of n is -1, and
   ! the HOMO is plotted out by default; if thgis routine is called then the
   ! value must be non-zero and we know that the LUMO value was set.
      self :: INOUT

      stdin.read(.LUMO_orbital)
      ENSURE(.LUMO_orbital>=0,"LUMO orbital must be greater than or equal to zero")

      .HOMO_orbital = .LUMO_orbital + 1

   end

   read_center_atom
   ! Read the atom at the centre of the plot
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      .axes.read_center_atom
      .set_center_from_atom_list(.atom)

   end

   read_center_atoms :: leaky
   ! Read the atoms whose mean position is the centre of the plot
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      .axes.read_center_atoms
      .axes.set_center_from_atoms(.atom)
      .set_origin

   end

   read_center
   ! Read the centre of the plot, and set the origin from it
      self :: INOUT

      .axes.read_center
      .set_origin

   end

   read_x_axis
   ! Read the x axis of the plot as a vector; the frame is completed
   ! about it (see PLOT_AXES:complete)
      self :: INOUT

      .axes.read_x_axis
      .set_origin

   end

   read_x_axis_atoms
   ! Read the two atoms the x axis of the plot runs between
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      .axes.read_x_axis_atoms
      .set_x_axis_from_atom_list(.atom)

   end

   read_x_axis_atom_list
   ! Make the x-axis along the mean of two lists of atoms.
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      atom_list :: VEC{INT}@
      pos1,pos2 :: VEC{REAL}(3)
      i :: INT

      stdin.read_all(atom_list)
      ENSURE(atom_list.dim>0,"no atoms specified in input")

      pos1 = ZERO
      do i=1,atom_list.dim
         pos1 = pos1 + .atom(atom_list(i)).position
      end
      pos1 = pos1/atom_list.dim
      atom_list.destroy

      stdin.read_all(atom_list)
      ENSURE(atom_list.dim>0,"no atoms specified in input")

      pos2 = ZERO
      do i=1,atom_list.dim
         pos2 = pos2 + .atom(atom_list(i)).position
      end
      pos2 = pos2/atom_list.dim
      atom_list.destroy

      .axes.x_axis = pos2 - pos1

      .axes.x_axis_defined = TRUE

      if (NOT .x_width_set) then
         .width(1) = FOUR*.axes.x_axis.norm
         .set_points_widths_origin
      end

      .complete_axes

   end

   read_y_axis
   ! Read the y axis of the plot as a vector; the frame is completed
   ! about it (see PLOT_AXES:complete)
      self :: INOUT

      .axes.read_y_axis
      .set_origin

   end

   read_y_axis_atoms
   ! Read the two atoms the y axis of the plot runs between
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      .axes.read_y_axis_atoms
      .set_y_axis_from_atom_list(.atom)

   end

   read_y_axis_atom_list
   ! Make the y-axis along the mean of two lists of atoms.
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      atom_list :: VEC{INT}@
      pos1,pos2 :: VEC{REAL}(3)
      i :: INT

      stdin.read_all(atom_list)
      ENSURE(atom_list.dim>0,"no atoms specified in input")

      pos1 = ZERO
      do i=1,atom_list.dim
         pos1 = pos1 + .atom(atom_list(i)).position
      end
      pos1 = pos1/atom_list.dim
      atom_list.destroy

      stdin.read_all(atom_list)
      ENSURE(atom_list.dim>0,"no atoms specified in input")

      pos2 = ZERO
      do i=1,atom_list.dim
         pos2 = pos2 + .atom(atom_list(i)).position
      end
      pos2 = pos2/atom_list.dim
      atom_list.destroy

      .axes.y_axis = pos2 - pos1
      .axes.y_axis_defined = TRUE

      if (NOT .y_width_set) then
         .width(2) = FOUR*.axes.y_axis.norm
         .set_points_widths_origin
      end

      .complete_axes

   end

   read_z_axis
   ! Read the z axis of the plot as a vector; the frame is completed
   ! about it (see PLOT_AXES:complete)
      self :: INOUT

      .axes.read_z_axis
      .set_origin

   end

   read_z_axis_atoms
   ! Read the two atoms the z axis of the plot runs between
      self :: INOUT

   ENSURE(.atom.allocated,"atom list not present")

      .axes.read_z_axis_atoms
      .set_z_axis_from_atom_list(.atom)

   end

   read_x_width
   ! Read the x width of the plot
      self :: INOUT

      stdin.read_quantity(.width(1))

      .set_points_widths_origin

      .x_width_set = TRUE

   end

   read_y_width
   ! Read the y width of the plot
      self :: INOUT

      stdin.read_quantity(.width(2))

      .set_points_widths_origin

      .y_width_set = TRUE

   end

   read_z_width
   ! Read the z width of the plot. This is normally 0.
      self :: INOUT

      stdin.read_quantity(.width(3))

      .set_points_widths_origin

      .z_width_set = TRUE

   end

   read_bond_density_atoms :: leaky
   ! Read bond density atoms
      self :: INOUT

      n_atom :: INT

      .bond_density_atom.destroy
      stdin.read_all(.bond_density_atom)

      ! Check
      n_atom = .bond_density_atom.dim
      ENSURE(n_atom>=1 AND n_atom<=3,"wrong length for bond_density_atoms")
      if (n_atom==3) then
      ENSURE(any(.bond_density_atom(1:2)==.bond_density_atom(3)),"atom 3 unmatching")
      end

   end

   read_box_scale_factor
   ! Read the bounding box scale factor and apply it immediately.
      self :: INOUT

      val :: REAL

      stdin.read(val)
      .set_box_scale_factor(val)

      .set_box_axes

   end

   read_cube_scale_factor
   ! Read the bounding box scale factor and apply it immediately.
      self :: INOUT

      val :: REAL

      stdin.read(val)
      .set_box_scale_factor(val)

      .set_cube_scale_factor(val)

   end

   read_projection_direction
   ! Read the directionb to prject the vectors onto
      self :: INOUT

      stdin.read(.projection_direction)

      .projection_direction.normalize

   end

   read_points_filename
   ! Read 3D points grid filename
      self :: INOUT
      stdin.read(.points_filename)
   end

   read_3D_grid(pt) :: leaky
   ! Read Cassam-Chenai's 3D grid
      self :: IN
      pt :: MAT{REAL}@, OUT

      textfile :: TEXTFILE@
      i :: INT

      ! Open the file for reading
      textfile.create(.points_filename)
      textfile.open_for("read")

      ! Read them in.
      ! NOTE: this is a RAW Fortran read on textfile.unit, bypassing the TEXTFILE
      ! API and its IO_IS_ALLOWED guarding. Under MPI only the master actually
      ! opens the file (TEXTFILE.open is guarded) and its unit is then broadcast,
      ! so every non-master rank was reading from a unit it had never opened.
      ! Unlike the write-only cases, this one needs BOTH halves: guard the read
      ! so only the master does it, then broadcast the DATA -- a unit number
      ! cannot be shared between processes, only its contents.
      pt.create(.n_pt,3)
      if (IO_IS_ALLOWED) then
         do i = 1,.n_pt
            read(textfile.unit,*) pt(i,:)
         end
      end
      PARALLEL_BROADCAST(pt,tonto.master_processor)

      textfile.close
      textfile.destroy

   end

   read_contour_min_value :: get_from(OBJECT:read_and_set, VAL_TYPE?=>REAL, SET?=>.set_contour_min_value), private
   ! Generic read and set a quantity with units
   end

   read_contour_max_value :: get_from(OBJECT:read_and_set, VAL_TYPE?=>REAL, SET?=>.set_contour_max_value), private
   ! Generic read and set a quantity with units
   end

   read_contour_increment :: get_from(OBJECT:read_and_set, VAL_TYPE?=>REAL, SET?=>.set_contour_increment), private
   ! Generic read and set a quantity with units
   end

   read_contour_min_color :: private
   ! Read the color used for the minimum-value contour
      self :: INOUT
      .contour_min_color.read
   end

   read_contour_max_color :: private
   ! Read the color used for the maximum-value contour
      self :: INOUT
      .contour_max_color.read
   end

   read_contour_mid_color :: private
   ! Read the color used for the mid-value contour, usually the
   ! zero-value contour
      self :: INOUT
      .contour_mid_color.read
   end

   read_contour_color_scale :: get_from(OBJECT:read_and_set, VAL_TYPE?=>STR, SET?=>.set_contour_color_scale), private
   ! Generic read and set
   end

   read_contour_line_width :: get_from(OBJECT:read_and_set, VAL_TYPE?=>REAL, SET?=>.set_contour_line_width), private
   ! Generic read and set a quantity with units
   end

   read_contour_tic_dps :: get_from(OBJECT:read_and_set, VAL_TYPE?=>INT, SET?=>.set_contour_tic_dps), private
   ! Generic read and set
   end

   read_contour_font_size :: get_from(OBJECT:read_and_set, VAL_TYPE?=>INT, SET?=>.set_contour_font_size), private
   ! Generic read and set
   end

   read_contour_fade_factor :: get_from(OBJECT:read_and_set, VAL_TYPE?=>REAL, SET?=>.set_contour_fade_factor), private
   ! Generic read and set a quantity with units
   end

   read_use_colorbox_scale :: get_from(OBJECT:read_and_set, VAL_TYPE?=>BIN, SET?=>.set_use_colorbox_scale), private
   ! Generic read and set
   end

   read_use_ruler_scale :: get_from(OBJECT:read_and_set, VAL_TYPE?=>BIN, SET?=>.set_use_ruler_scale), private
   ! Generic read and set
   end

   read_contour_scale :: get_from(OBJECT:read_and_set, VAL_TYPE?=>STR, SET?=>.set_contour_scale), private
   ! Generic read and set
   end

!  ============
!  Bounding box
!  ============

   set_box_scale_factor(factor) :: PURE
   ! Set the bounding box scale factor
      self :: INOUT
      factor :: REAL, IN

      .box_scale_factor = factor

   ENSURE(.box_scale_factor>ZERO,"scale factor not positive")

   end

   set_box_axes :: private, PURE
   ! Set box axes -- they might have different widths.
      self :: INOUT
      if (NOT .use_unit_cell_as_bbox) then
         if (.x_or_y_or_z_axes_defined) then; .use_bbox_with_current_axes
         else;                                .use_bbox_with_shape_axes
         end
      end
   end

   set_cube_scale_factor(factor) :: PURE
   ! Set the bounding cube scale factor
      self :: INOUT
      factor :: REAL, IN

      .set_box_scale_factor(factor)

      .set_cube_axes

   end

   set_cube_axes :: private, PURE
   ! Set cube axes
      self :: INOUT
      if (.x_or_y_or_z_axes_defined) then; .use_bcube_with_current_axes
      else;                                .use_bcube_with_shape_axes
      end
   end

   use_bbox_with_current_axes :: private, PURE
   ! Use a bounding box axes and widths coming from the current
   ! user-specified axes
      self :: INOUT

      .set_bbox_with_current_axes(.atom)

      .axes.center = .box_center
      .width  = .box_widths
      .axes.x_axis = .box_axes(:,1)
      .axes.y_axis = .box_axes(:,2)
      .axes.z_axis = .box_axes(:,3)

      .set_points_widths_origin

   end

   use_bbox_with_shape_axes :: PURE
   ! Use a bounding box axes and widths coming from the principal axes
   ! of the shape tensor (the inertia tensor with unit atomic masses).
      self :: INOUT

   ENSURE(.atom.allocated,"no atom list")

      .set_bbox_with_shape_axes(.atom)

      .axes.center = .box_center
      .width  = .box_widths
      .axes.x_axis = .box_axes(:,1)
      .axes.y_axis = .box_axes(:,2)
      .axes.z_axis = .box_axes(:,3)

      .set_points_widths_origin

   end

   use_bcube_with_current_axes :: PURE
   ! Use a bounding cube from the current axes. The box width are
   ! taken to be the maximum of the three widths along current axes.
      self :: INOUT

      .set_bbox_with_current_axes(.atom)

      .axes.center = .box_center

      .width  = maxval(.box_widths)
      .n_x    = maxval([.n_x,.n_y,.n_z])
      .n_y    = .n_x
      .n_z    = .n_x

      .axes.x_axis = .box_axes(:,1)
      .axes.y_axis = .box_axes(:,2)
      .axes.z_axis = .box_axes(:,3)

      .set_points_widths_origin

   end

   use_bcube_with_shape_axes :: PURE
   ! Use a bounding cube from the current shape tensor. The box width
   ! is taken to be the maximum of the three widths.
      self :: INOUT

      .set_bbox_with_shape_axes(.atom)

      .axes.center = .box_center
      .width  = maxval(.box_widths)
      .axes.x_axis = .box_axes(:,1)
      .axes.y_axis = .box_axes(:,2)
      .axes.z_axis = .box_axes(:,3)

      .set_points_widths_origin

   end

!   use_unit_cell_as_bbox
!   ! Use the unit cell as the bounding box.  This sets a switch and
!   ! the axes must be obtained afterwards from a supplied cell.
!       .use_unit_cell_as_bbox = TRUE
!   end

!   widths_were_set result (res)
!   ! Return TRUE if any of the widths were inputted.
!      res :: BIN
!      res =  .x_width_set &
!          OR .y_width_set &
!          OR .z_width_set
!   end

!   read_crystal_plane(in,unit_cell)
!   ! To read in a vector which describes a plane in the crystal.
!   ! The vector is the normal of the plane.
!     in :: INPUT
!     unit_cell :: UNIT_CELL, IN
!     in.read( .z_axis )
!     .z_axis.rotate(unit_cell.cell_mx)
!     .z_axis.normalize
!     .x_axis.normalize
!     .y_axis.to_cross_product_of( .z_axis, .x_axis)
!     .y_axis.normalize
!     .x_axis.to_cross_product_of( .y_axis, .z_axis)
!     .x_axis.normalize
!   end

!  ================
!  Make grid points
!  ================

   make_points(x_pt,y_pt,z_pt) :: PURE
   ! Make a list of the grid points
      self :: IN
      x_pt,y_pt,z_pt :: VEC{REAL}, OUT

   ENSURE(x_pt.dim==.n_pt,"x_pt not correct size")
   ENSURE(y_pt.dim==.n_pt,"y_pt not correct size")
   ENSURE(z_pt.dim==.n_pt,"z_pt not correct size")

      x1,x2,x3,y1,y2,y3,z1,z2,z3 :: REAL
      ox,oy,oz :: REAL
      ix,iy,iz,i,t2,t3 :: INT

      ox = .origin(1)
      oy = .origin(2)
      oz = .origin(3)

      x1 = .del_x*.axes.x_axis(1)
      x2 = .del_x*.axes.x_axis(2)
      x3 = .del_x*.axes.x_axis(3)

      y1 = .del_y*.axes.y_axis(1)
      y2 = .del_y*.axes.y_axis(2)
      y3 = .del_y*.axes.y_axis(3)

      z1 = .del_z*.axes.z_axis(1)
      z2 = .del_z*.axes.z_axis(2)
      z3 = .del_z*.axes.z_axis(3)

      t2 = .n_x*.n_y

      do i = 1,.n_pt

         iz = (i-1)/t2
         t3 = i - iz*t2
         iy = (t3-1)/.n_x
         ix = t3 - iy*.n_x - 1

         x_pt(i) = ox + ix*x1 + iy*y1 + iz*z1
         y_pt(i) = oy + ix*x2 + iy*y2 + iz*z2
         z_pt(i) = oz + ix*x3 + iy*y3 + iz*z3

      end

   end

   make_points(pt) :: PURE
   ! Return a list of the grid points in "pt". 
      self :: IN
      pt :: MAT{REAL}, OUT

   ENSURE(.n_x/=0,"zero number of x points")
   ENSURE(.n_y/=0,"zero number of y points")
   ENSURE(pt.dim1==.n_pt,"wrong 1st dimension, pt")
   ENSURE(pt.dim2==3    ,"wrong 2nd dimension, pt")

      x,y,z :: VEC{REAL}(3)
      v     :: VEC{INT}(3)
      i, t2,t3 :: INT

      ! Voxel vectors
      x = .del_x*.axes.x_axis
      y = .del_y*.axes.y_axis
      z = .del_z*.axes.z_axis

      ! No. of points in base plane
      t2 = .n_x*.n_y

      do i = 1,.n_pt

         ! Voxel coordinates "v'
         v(3) = (i-1)/t2
         t3   = i - v(3)*t2
         v(2) = (t3-1)/.n_x
         v(1) = t3 - v(2)*.n_x - 1

         ! Get actual cartesian coords of voxel "v"
         pt(i,1) = .origin(1) + v(1)*x(1) + v(2)*y(1) + v(3)*z(1)
         pt(i,2) = .origin(2) + v(1)*x(2) + v(2)*y(2) + v(3)*z(2)
         pt(i,3) = .origin(3) + v(1)*x(3) + v(2)*y(3) + v(3)*z(3)

      end

   end

   make_points(pt,first,last) :: PURE
   ! Return a list of the grid points in "pt". Will return a subset of
   ! the grid points from "first" to "last", if these options
   ! are provided.
      self :: IN
      first,last :: INT, IN
      pt :: MAT{REAL}, OUT

   ENSURE(.n_x/=0,"zero number of x points")
   ENSURE(.n_y/=0,"zero number of y points")

      x1,x2,x3,y1,y2,y3,z1,z2,z3 :: REAL
      ox,oy,oz :: REAL
      ix,iy,iz,i,f,l,t2,t3 :: INT

      f = first
      l = last

      ox = .origin(1)
      oy = .origin(2)
      oz = .origin(3)

      x1 = .del_x*.axes.x_axis(1)
      x2 = .del_x*.axes.x_axis(2)
      x3 = .del_x*.axes.x_axis(3)

      y1 = .del_y*.axes.y_axis(1)
      y2 = .del_y*.axes.y_axis(2)
      y3 = .del_y*.axes.y_axis(3)

      z1 = .del_z*.axes.z_axis(1)
      z2 = .del_z*.axes.z_axis(2)
      z3 = .del_z*.axes.z_axis(3)

      t2 = .n_x*.n_y

      do i = f,l

         iz = (i-1)/t2
         t3 = i - iz*t2
         iy = (t3-1)/.n_x
         ix = t3 - iy*.n_x - 1

         pt(i,1) = ox + ix*x1 + iy*y1 + iz*z1
         pt(i,2) = oy + ix*x2 + iy*y2 + iz*z2
         pt(i,3) = oz + ix*x3 + iy*y3 + iz*z3

      end

   end


   make_points(pt,f,l) :: PURE
   ! Return a list of the grid points in "pt" in grid xyz order, starting from
   ! the first and last x, y, and z points: "fx", "lx", "fy", "ly", "fz", "lz"
   ! respectively
      self :: IN
      pt   :: MAT{REAL}, OUT
      f,l  :: VEC{INT}(3), IN

      .make_points(pt,f(1),l(1),f(2),l(2),f(3),l(3))

   end

   make_points(pt,fx,lx,fy,ly,fz,lz) :: PURE
   ! Return a list of the grid points in "pt" in grid xyz order, starting from
   ! the first and last x, y, and z points: "fx", "lx", "fy", "ly", "fz", "lz"
   ! respectively
      self  :: IN
      pt    :: MAT{REAL}, OUT
      fx,lx :: INT, IN
      fy,ly :: INT, IN
      fz,lz :: INT, IN

   ENSURE(pt.dim1==(lx-fx+1)*(ly-fy+1)*(lz-fz+1),"wrong 1st dimension, pt")
   ENSURE(pt.dim2==3,"wrong 2nd dimension, pt")

      x1,x2,x3 :: REAL
      y1,y2,y3 :: REAL
      z1,z2,z3 :: REAL
      ox,oy,oz :: REAL
      x, y, z   :: INT
      ix,iy,iz,i :: INT

      ox = .origin(1)
      oy = .origin(2)
      oz = .origin(3)

      x1 = .del_x*.axes.x_axis(1)
      x2 = .del_x*.axes.x_axis(2)
      x3 = .del_x*.axes.x_axis(3)

      y1 = .del_y*.axes.y_axis(1)
      y2 = .del_y*.axes.y_axis(2)
      y3 = .del_y*.axes.y_axis(3)

      z1 = .del_z*.axes.z_axis(1)
      z2 = .del_z*.axes.z_axis(2)
      z3 = .del_z*.axes.z_axis(3)

      i = 0

      do z = fz,lz
      do y = fy,ly
      do x = fx,lx

         ix = x - 1
         iy = y - 1
         iz = z - 1
         i  = i + 1

         pt(i,1) = ox + ix*x1 + iy*y1 + iz*z1
         pt(i,2) = oy + ix*x2 + iy*y2 + iz*z2
         pt(i,3) = oz + ix*x3 + iy*y3 + iz*z3

      end
      end
      end

   end

   point(x,y,z) result (res) :: PURE
   ! Return one particular point "res" of the grid, given by grid coordinates
   ! "x", "y", and "z". (1,1,1) is the bottom (front) left hand corner.
      self  :: IN
      x,y,z :: INT, IN
      res   :: VEC{REAL}(3)

      x1,x2,x3,y1,y2,y3,z1,z2,z3,ox,oy,oz :: REAL
      ix,iy,iz :: INT

      ox = .origin(1)
      oy = .origin(2)
      oz = .origin(3)

      x1 = .del_x*.axes.x_axis(1)
      x2 = .del_x*.axes.x_axis(2)
      x3 = .del_x*.axes.x_axis(3)

      y1 = .del_y*.axes.y_axis(1)
      y2 = .del_y*.axes.y_axis(2)
      y3 = .del_y*.axes.y_axis(3)

      z1 = .del_z*.axes.z_axis(1)
      z2 = .del_z*.axes.z_axis(2)
      z3 = .del_z*.axes.z_axis(3)

      ix = x - 1
      iy = y - 1
      iz = z - 1

      res(1) = ox + ix*x1 + iy*y1 + iz*z1
      res(2) = oy + ix*x2 + iy*y2 + iz*z2
      res(3) = oz + ix*x3 + iy*y3 + iz*z3

   end


   make_cube_of_points(p,f,l,del_x,del_y,del_z,x,y,z,eval) :: public, PURE
   ! Return a cube of points "p" where the cube edge points start from
   ! index "f" and end at index "l", and each point separated by
   ! distance "del_x", "del_y", "del_z" along a grid axis direction
   ! (these are *not* the same as the grid .del's).  The (0,0,0) point
   ! of the cube "p" corresponds to the plot grid coordinates "x", "y",
   ! "z", which are numbered from 0 (normally the first point is
   ! numbered from 1; these are grid coords in .del_x, .dely, .del_z).
   ! The axes of the cube are given by the plot grid axes.
      self  :: IN
      f,l,x,y,z :: INT, IN
      p :: MAT{REAL}(3,*), OUT
      del_x,del_y,del_z :: REAL, IN
      eval :: VEC{BIN}(*), optional, IN

      x1,x2,x3,y1,y2,y3,z1,z2,z3,ox,oy,oz :: REAL
      ix,iy,iz,k :: INT

      ! Plot grid axes times plot grid del's
      x1 = .del_x*.axes.x_axis(1); x2 = .del_x*.axes.x_axis(2); x3 = .del_x*.axes.x_axis(3)
      y1 = .del_y*.axes.y_axis(1); y2 = .del_y*.axes.y_axis(2); y3 = .del_y*.axes.y_axis(3)
      z1 = .del_z*.axes.z_axis(1); z2 = .del_z*.axes.z_axis(2); z3 = .del_z*.axes.z_axis(3)

      ! Cube origin in plotrgrid coords
      ox = .origin(1) + x*x1 + y*y1 + z*z1
      oy = .origin(2) + x*x2 + y*y2 + z*z2
      oz = .origin(3) + x*x3 + y*y3 + z*z3

      ! Plotgrid axes times cube del's
      x1 = del_x*.axes.x_axis(1); x2 = del_x*.axes.x_axis(2); x3 = del_x*.axes.x_axis(3) !
      y1 = del_y*.axes.y_axis(1); y2 = del_y*.axes.y_axis(2); y3 = del_y*.axes.y_axis(3)
      z1 = del_z*.axes.z_axis(1); z2 = del_z*.axes.z_axis(2); z3 = del_z*.axes.z_axis(3)

      if (NOT present(eval)) then

         k = 0
         do iz = f,l
         do iy = f,l
         do ix = f,l
            k = k + 1
            p(1,k) = ox + ix*x1 + iy*y1 + iz*z1
            p(2,k) = oy + ix*x2 + iy*y2 + iz*z2
            p(3,k) = oz + ix*x3 + iy*y3 + iz*z3
         end
         end
         end

      else

         k = 0
         do iz = f,l
         do iy = f,l
         do ix = f,l
            k = k + 1
            if (NOT eval(k)) cycle
            p(1,k) = ox + ix*x1 + iy*y1 + iz*z1
            p(2,k) = oy + ix*x2 + iy*y2 + iz*z2
            p(3,k) = oz + ix*x3 + iy*y3 + iz*z3
         end
         end
         end

      end

   end

   make_math_pos(math_pos,z_range,valid) :: leaky, PURE
   ! Calculate the positions "math_pos" of the valid atoms which have
   ! been rotated and shifted and scaled into grid point coordinates.
   ! Valid atoms are those which are within "z_range" of the plot
   ! plane; the indices of the valid atoms are stored in "valid"
      self :: IN
      math_pos :: MAT{REAL}@, OUT
      z_range :: REAL, IN
      valid :: VEC{INT}@, OUT

   ENSURE(.atom.allocated,"no atoms!")
   ENSURE(z_range>ZERO,"z_range must be non-negative")
   ENSURE(valid.deallocated,"valid array already allocated")

      scale_factor,p :: VEC{REAL}(3)
      tr :: MAT{REAL}(3,3)
      pos :: MAT{REAL}@
      n,nv,a,i :: INT

      ! Get shifted atom positions
      n = .atom.dim
      pos.create(n,3)
      do a = 1, n
         pos(a,:) = .atom(a).position - .origin    !shift
      end

      ! Rotate positions into plot grid axis
      tr = .transposed_plot_axes
      do a = 1, n
         p = pos(a,:)
         pos(a,:).to_product_of(tr,p)
      end

      ! Reject atoms far from plot plane, get valid atoms
      valid.create(0)
      do a = 1, n
         ! if ( abs(pos(a,z)) > z_range) cycle
         if ( abs(pos(a,3)) > z_range) cycle
         valid.append(a)
      end

      ! Create list of valid atoms positions
      nv = valid.dim
      math_pos.create(nv,3)
      i = 0
      do a = 1, n
         if ( abs(pos(a,3)) > z_range) cycle
         i = i + 1
         math_pos(i,:) = pos(a,:)
      end

      ! Finally, scale positions
      scale_factor(1) = (.n_x - ONE) / .width(1)
      scale_factor(2) = (.n_y - ONE) / .width(2)
      scale_factor(3) = ZERO
      do a = 1,nv
         math_pos(a,:) = scale_factor * math_pos(a,:) + ONE ! since plot begins at 1
      end

      pos.destroy

   end

!  ===================
!  Batched grid points
!  ===================

   make_01_uc_pts_as_mhph_pts(pt) :: PURE
   ! Make the [0,1] unit-cell points (with the first and last poinyts
   ! on each cell representing the same plane) transformed into a
   ! [-1/2,+1/2) cell, for the CRYTSTAL23 program. 
   ! NOTE: plot axes should be set to unit cell already!
      self :: IN
      pt :: MAT{REAL}, OUT

   ENSURE(.n_x/=0,"zero number of x points")
   ENSURE(.n_y/=0,"zero number of y points")
   ENSURE(.n_x.is_odd,"n_x is not odd!")
   ENSURE(.n_y.is_odd,"n_x is not odd!")
   ENSURE(.n_z.is_odd,"n_x is not odd!")
   ENSURE(pt.dim1==.n_pt,"wrong 1st dimension, pt")
   ENSURE(pt.dim2==3    ,"wrong 2nd dimension, pt")

      da,db,dc :: VEC{REAL}(3)
      j1,j2,j3 :: INT
      i1,i2,i3 :: INT
      hx,hy,hz :: INT
      n :: INT

      ! Delta times unit cell axes
      da = .del_x*.axes.x_axis
      db = .del_y*.axes.y_axis
      dc = .del_z*.axes.z_axis

      ! The is the half-periodicity
      hx = (.n_x-1)/2
      hy = (.n_y-1)/2
      hz = (.n_z-1)/2

      n = 0
      ! Ordering is standard [0,1] unit cell
      ! with positive tic marks per point
      do i3 = 0,.n_z-1
      do i2 = 0,.n_y-1
      do i1 = 0,.n_x-1 ! i1=1 origin (x = 0) ! n_x=5 :: i1 = 1,2,3,4,5 
                                          !               :       :
                                          !             ::  repeated
         ! CRYSTAL23 [-1/2,+1/2] points
               !       = 2                                   org    hf
               ! mod(1-1+2=2,4) - 2 =  0   mod(x  ,4)   =   0   1   2   3   4   5
               ! mod(2-1+2=3,4) - 2 =  1   mod(x  ,4)-2 =  -2  -1   0   1 
               ! mod(3-1+2=4,4) - 2 = +-2  mod(x+2,4)-2 =   0   1  -2  -1
               ! mod(4-1+2=5,4) - 2 = -1
               ! mod(5-1+2=6,4) - 2 =  0
               !
               ! target j1 = 0 ,"1/4", "1/2", "-1/2" ,"-1/4"
               !           = 0 1 2 -2 -1    
         j1 = mod(i1+hx,2*hx) - hx
         j2 = mod(i2+hy,2*hy) - hy
         j3 = mod(i3+hz,2*hz) - hz
         n  = n + 1
         pt(n,1) = j1*da(1) + j2*db(1) + j3*dc(1)
         pt(n,2) = j1*da(2) + j2*db(2) + j3*dc(2)
         pt(n,3) = j1*da(3) + j2*db(3) + j3*dc(3)
      end
      end
      end

   end

!  ===================
!  Batched grid points
!  ===================

   make_batched_points(pt,batch) :: PURE
   ! Return a list of the grid points "pt" for a given "batch" index.
   ! These are a little rectlinear part of the big grid.
      self  :: IN
      pt    :: MAT{REAL}@, OUT
      batch :: INT, IN

      f,l :: VEC{INT}(3)
      np  :: INT

      .set_fl_for_batch(f,l,batch)
      np = product(l-f+1)
      pt.create(np,3)
      .make_points(pt,f,l)

   end

   n_batches result (res) :: PURE
   ! Return the number of batches for the given ".min_batch_size". 
      self :: IN
      res :: INT

      mx,my,mz :: INT
      np :: INT

      np = .n_pts_per_axis

      mx = ceiling(REALIFY(.n_x/np))
      my = ceiling(REALIFY(.n_y/np))
      mz = ceiling(REALIFY(.n_z/np))

      res = mx*my*mz

   end

   n_pts_for_batch(batch) result (res) :: PURE
   ! Return the number of points for batch "batch".
      self :: IN
      batch :: INT, IN
      res :: INT

      f,l  :: VEC{INT}(3)

      .set_fl_for_batch(f,l,batch)
      res = product(l-f+1)

   end

   set_fl_for_batch(f,l,batch) :: PURE
   ! Set the fitst and last starting tics on each axis, "f" and "l",
   ! for a given "batch" index.
      self :: IN
      f,l  :: VEC{INT}(3), OUT
      batch :: INT, IN

      mx,my,mz :: INT
      bx,by,bz :: INT
      bb,np  :: INT

      np = .n_pts_per_axis

      mx = ceiling(REALIFY(.n_x/np))
      my = ceiling(REALIFY(.n_y/np))
      mz = ceiling(REALIFY(.n_z/np))

      bb = 0

      outer: &
      do bz = 1,mz
      do by = 1,my
      do bx = 1,mx

         bb = bb + 1

         ! X, Y, Z axis poinht limits
         f(1) = (bx-1)*np + 1
         l(1) = min(bx*np,.n_x)

         f(2) = (by-1)*np + 1
         l(2) = min(by*np,.n_y)

         f(3) = (bz-1)*np + 1
         l(3) = min(bz*np,.n_z)

         if (bb==batch) exit outer

      end
      end
      end

   end

   n_pts_per_axis result (res) :: PURE
   ! Return the number of points per axis so that the number of points
   ! is just above ".min_batch_size". This assumes that points per axis
   ! are separated by equal divisions and groups them by cubes.
      self :: IN
      res :: INT

      if (.n_z>1) then
         res = ceiling((REALIFY(.min_batch_size))**(THIRD))
      else
         res = ceiling((REALIFY(.min_batch_size))**(HALF))
      end

   end

!  ======
!  Output
!  ======

   put(title)
   ! Put the grid data to "stdout"
      self :: IN
      title :: STR, optional, IN

      axes :: MAT{REAL}(3,3)
      length,wid :: INT
      heading :: STR

      heading = "Plot grid data"
      if (present(title)) heading = title
      length = len_trim(heading)

      stdout.flush
      stdout.text(repeat("=",length))
      stdout.text(trim(heading))
      stdout.text(repeat("=",length))
      stdout.flush
      stdout.text(". Usually, the plot center, plot widths, and plot axes are specified.")
      stdout.text("  Unless specified otherwise the z-axis width is assumed to be zero")
      stdout.text("  i.e. it is assumed we are constructing a 2D plot grid.")
      stdout.flush
      stdout.text(". The origin is calculated as the front-left-bottom point.")
      stdout.flush
      stdout.text(". An atom or atoms may be used to specify the plot center.")
      stdout.flush
      stdout.text(". Atoms may also be used to specify the x and y axes; and the y and z")
      stdout.text("  axes are orthogonalized to the x and y axes, respectively.")
      stdout.flush
      stdout.text(". Alternatively, a a bonding box around the molecule may be used.")
      stdout.text("  The axes diagonalised the moment of inertia tensor using unit")
      stdout.text("  weight atoms, so-called shape axes.")
      stdout.flush
      stdout.text(". For crystals, the unit cell axes may be chosen to be the plot axes.")
      stdout.text("  In most cases the midpoint of the unit cell is the plot center.")
      stdout.text("  For CRYSTAL23, the origin is chosen as the plot center")
      stdout.flush
      stdout.text(". Normally only the no. of points on the x axis is specified, the no.")
      stdout.text("  of points on the other axes is adjusted to have the same linear")
      stdout.text("  point density, roughly.")
      stdout.flush
      stdout.text(". Alternatively, a desired point separation is specified. Then the")
      stdout.text("  no. of points on each axis is calculated to just exceed it.")
      stdout.flush
      stdout.text(". All coordinates are in au.")
      stdout.flush

      ! What is it?
      stdout.show("Kind of plot            =", .plot_kind)
      stdout.show("Plot orbital no. ?      =", .orbital)

      ! Point info ...
      stdout.flush
      stdout.text("No. of points:")
      stdout.show("Number of X grid points =",.n_x)
      stdout.show("Number of Y grid points =",.n_y)
      stdout.show("Number of Z grid points =",.n_z)
      stdout.show("Total number of points  =",.n_pt)
      stdout.flush
      stdout.text("Point separations:")
      stdout.show("Point separation (x)    =",.del_x)
      stdout.show("Point separation (y)    =",.del_y)
      stdout.show("Point separation (z)    =",.del_z)

      ! Nice width
      axes = .plot_axes
      wid  = maxval(len_trim(axes.to_str("f",50,stdout.style.real_precision))) + 1
      axes = .plot_axes

      ! Centering
      stdout.flush
      stdout.text("Plot centering:")
      stdout.show("Plot center point       =",.axes.center,width=wid)
      stdout.show("Center offset           =",.offset,width=wid)
      stdout.show("Origin                  =",.origin,width=wid)

      ! Plot bounding boxes
      stdout.flush
      stdout.text("Plot bounding box info:")
      stdout.show("Box center              =",.box_center,wid)
      stdout.show("Bounding box used?      =",.use_bounding_box)
      stdout.show("Unit cell as is bbox?   =",.use_unit_cell_as_bbox)

      ! Plot widths & axes
      stdout.flush
      stdout.text("Plot widths & axes:")
      stdout.show("Widths                  =",.width,wid)
      stdout.show("Axis vector columns     =",axes(1,:),width=wid)
      stdout.show("                        =",axes(2,:),width=wid)
      stdout.show("                        =",axes(3,:),width=wid)

      ! The frame, and the atoms that gave it
      .axes.put

   end

   put_minimal
   ! Put minimal *angstrom*
      self :: IN

      fac :: REAL

      fac = ANGSTROM_PER_BOHR

      stdout.show("No. of X grid points     =",.n_x)
      stdout.show("No. of Y grid points     =",.n_y)
      stdout.show("No. of Z grid points     =",.n_z)
      stdout.show("Total no. of points      =",.n_pt)
      stdout.show("X point separation       =",.del_x*fac)
      stdout.show("Y point separation       =",.del_y*fac)
      stdout.show("Z point separation       =",.del_z*fac)

   end

end
