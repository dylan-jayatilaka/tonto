   docu_tol_for_shift_on_esd(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("tol_for_shift_on_esd= REAL [0.01]")
      stdout.flush
      stdout.text(". Tolerance for the largest change in any least-squares")
      stdout.text("  -refined structural parameter, divided by its estimated")
      stdout.text("  standard uncertainly (ESU), such that convergence of the")
      stdout.text("  iterative LSQ procedure is regarded to have occured.")
      if (present(die)) stop
   end

   read_tol_for_shift_on_esd
   ! Read the tolerance for the shift on esd to decide on convergence.
      self :: INOUT

      stdin.read(.tol_for_shift_on_esd)

   ENSURE(.tol_for_shift_on_esd>ZERO,"must be positive")

   end

   docu_near_0_tol(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("near_0_tol= REAL [0.001]")
      stdout.text("tol_near_0= REAL [0.001]")
      stdout.flush
      stdout.text(". Specifies the absolute value for eigenvalues of the")
      stdout.text("  least-squares matrix *below* which the corresponding")
      stdout.text("  eigenvectors are regarded to describe linear dependencies.")
      stdout.text("  These linear dependencies are removed when solving")
      stdout.text("  the least-squares equations for crystal structure parameters.")
      stdout.flush
      stdout.text(". Must be a positive quantity.")
      if (present(die)) stop
   end

   read_near_0_tol
   ! Read the tolerance for deciding on *near* zero eigenvalues in
   ! solving the normal equations.
      self :: INOUT

      stdin.read(.near_0_tol)

   ENSURE(.near_0_tol>ZERO,"near_0_tol must be positive")

   end

! U

   docu_use_disk_SFs(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_disk_SFs= BIN [FALSE]")
      stdout.flush
      stdout.text(". Set if you want the atomic form factors to be written")
      stdout.text("  out onto the disk, instead of being stored in memory.")
      stdout.text("  This drastically reduced memory usage for a HAR")
      stdout.text("  but at (possible) cost of slowing the calculation.")
      stdout.flush
      stdout.text(". This option is set by default for fragHAR refinements")
      stdout.flush
      stdout.text(". See Bergman et al (2020) IUCrJ 7 p. 1-8.")
      if (present(die)) stop
   end

   read_use_disk_SFs :: leaky, private
   ! Read whether to use disk structure factors.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_disk_SFs(val)

   end

   docu_use_equivalents(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_disk_SFs= BIN [FALSE]")
      stdout.flush
      stdout.text(". Set if you want to *keep* equivalent reflections.")
      stdout.text("  If you do *not* set this TRUE, equivalent reflections")
      stdout.text("  will be deleted.")
      stdout.flush
      stdout.text(". IMPORTANT: Tonto requires a  symmetry independent set")
      stdout.text("  of reflections.")
      stdout.flush
      stdout.text(". Friedel pairs may or may not be present; if you are")
      stdout.text("  using dispersion corrections, you had better have")
      stdout.text("  Friedel pairs in you set of reflections!")
      if (present(die)) stop
   end

   read_use_equivalents :: leaky, private
   ! Read whether to keep equivalent reflections in the data set. 
   ! Normally symmetry-equivalent reflections will be pruned out.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_equivalents(val)

   end

   docu_use_IAM_ITC_FFs(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_IAM_ITC_FFs= BIN [TRUE]")
      stdout.flush
      stdout.text(". Set FALSE if an IAM refinement will use gaussian atomic")
      stdout.text("  atomic densities.")
      stdout.flush
      stdout.text("  In that case sphericized density matrices are obtained")
      stdout.text("  from a high-spin atomic ground state QM calculation using")
      stdout.text("  the specified SCF method, and with the specified basis set.")
      stdout.flush
      stdout.text(". The default is to use tabulated atomic form factors from")
      stdout.text("  the International Tables volume C.")
      if (present(die)) stop
   end

   read_use_IAM_ITC_FFs :: leaky, private
   ! Read whether to use gaussian atomic densities in an IAM refinement.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_IAM_ITC_FFs(val)

   end

   docu_use_NN(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_NN= BIN [FALSE]")
      stdout.flush
      stdout.text(". Set TRUE if you want to break a periodic network")
      stdout.text("  solid into H-atom-capped fragments, one centred on")
      stdout.text("  each atom of the asymmetric unit, for the purpose of")
      stdout.text("  efficiently obtaining aspherical atomic form factors,")
      stdout.text("  the fragHAR procedure.")
      stdout.flush
      stdout.text(". Unlike use_Ryde_capping, which splits a structure at")
      stdout.text("  its compound boundaries, this makes a fragment for")
      stdout.text("  every asymmetric unit atom by following bonds out")
      stdout.text("  NN_level shells. It is intended for solids such as")
      stdout.text("  quartz, where no molecule can be isolated at all.")
      stdout.flush
      stdout.text(". Use NN_level= to set how far the fragments extend,")
      stdout.text("  and use_NN_capping= to turn the capping off.")
      if (present(die)) stop
   end

   read_use_NN :: leaky, private
   ! Read whether to use nearest-neighbour capping to make atom-centred
   ! fragments of a periodic network solid.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_NN(val)

   end

   docu_use_NN_capping(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_NN_capping= BIN [TRUE]")
      stdout.flush
      stdout.text(". Set FALSE if you want the nearest-neighbour")
      stdout.text("  fragments left with a bare outermost shell, instead")
      stdout.text("  of having that shell replaced by capping hydrogen")
      stdout.text("  atoms. Only meaningful when use_NN= is set.")
      stdout.flush
      stdout.text(". A capping hydrogen is placed along the internuclear")
      stdout.text("  vector of the bond it replaces, at the sum of the")
      stdout.text("  two CCDC covalent radii from the atom it caps.")
      if (present(die)) stop
   end

   read_use_NN_capping :: leaky, private
   ! Read whether the nearest-neighbour fragments have their outermost
   ! shell replaced by capping hydrogen atoms.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_NN_capping(val)

   end

   docu_NN_level(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("NN_level= INT [1]")
      stdout.flush
      stdout.text(". The number of shells of nearest neighbours, by atom")
      stdout.text("  bonding, to include in the fragment made around each")
      stdout.text("  asymmetric unit atom of a periodic network solid.")
      stdout.text("  Everything beyond this shell is replaced by a")
      stdout.text("  capping hydrogen atom.")
      stdout.flush
      stdout.text(". Setting this implies use_NN= TRUE.")
      stdout.flush
      stdout.text(". For quartz, level 1 around the silicon atom gives")
      stdout.text("  orthosilicic acid, and around the oxygen atom gives")
      stdout.text("  silyloxysilane.")
      if (present(die)) stop
   end

   read_NN_level :: leaky, private
   ! Read how many shells of nearest neighbours are included before
   ! capping hydrogen atoms, for a periodic network solid.
      self :: INOUT

      val :: INT

      stdin.read(val)

      ! Should not be given unless the NN method is in use
      .set_use_NN(TRUE)

      .set_NN_level(val)

   end

   docu_use_Ryde_capping(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_Ryde_capping= BIN [FALSE]")
      stdout.flush
      stdout.text(". Set TRUE if you want to use the Ulf Ryde method")
      stdout.text("  for breaking up proteins into H-atom-capped")
      stdout.text("  fragments, for the purpose of efficiently obtaining")
      stdout.text("  aspherical atomic form factors, the fragHAR procedure.")
      stdout.flush
      stdout.text(". This option is set by default for fragHAR_refinement")
      stdout.flush
      stdout.text(". See Bergman et al (2020) IUCrJ 7 p. 1-8.")
      if (present(die)) stop
   end

   read_use_Ryde_capping :: leaky, private
   ! Read whether to use Ulf Ryde's capping method to split and cap
   ! polypeptides to make wavefunction and atomic structure factor
   ! calculations for proteins quicker.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_Ryde_capping(val)

   end

   docu_use_text_SFs(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("use_text_SFs= BIN [FALSE]")
      stdout.flush
      stdout.text(". Set if you want the atomic form factors to be written")
      stdout.text("  out onto the disk in *text* or ASCII format, instead of")
      stdout.text("  being stored in memory.")
      stdout.flush
      stdout.text(". This option sets use_disk_SFs=")
      stdout.flush
      stdout.text(". This option is set by default for fragHAR refinements")
      stdout.flush
      stdout.text(". See Bergman et al (2020) IUCrJ 7 p. 1-8.")
      if (present(die)) stop
   end

   read_use_text_SFs :: leaky, private
   ! Read whether to use disk structure factors in ASCII format.
      self :: INOUT

      val :: BIN

      stdin.read(val)
      .set_use_text_SFs(val)

   end

   docu_wavelength(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("wavelength= REAL ")
      stdout.flush
      stdout.text(". Set the wavelength of the particles used for diffraction.")
      stdout.text("  Do not forget to specify the units.")
      stdout.flush
      stdout.text(". You must specify this quantity for sensible plane spacings")
      stdout.text("  or for sensible pruning.")
      if (present(die)) stop
   end

! U

   read_wavelength :: private
   ! Read the experimental wavelength
      self :: INOUT

      val :: REAL

      stdin.read_quantity(val)
      .set_wavelength(val)

   end

! Undocumented so far ...

   read_synthesize_sigma_I :: private
   ! Read the switch whether to artificially create sigma(I) errors when
   ! evaluating the chi2 statistics based on intensities. Refer to routine
   ! .I_sigma
      self :: INOUT

      stdin.read(.synthesize_sigma_I)

   end

   read_stop_after_dispersion :: private
   ! Stop after applying dispersion correction in the zeroth iteration
   ! of a refinement.
      self :: INOUT

      stdin.read(.stop_after_dispersion)

   end

   read_temperature
   ! Read the temperature
      self :: INOUT

      stdin.read(.temperature)

   ENSURE(.temperature>=0,"temperature is not positive!")

   end

