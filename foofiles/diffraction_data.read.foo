module DIFFRACTION_DATA.READ

   implicit none

contains

!  ============
!  Read methods
!  ============

   read_keywords :: get_from(OBJECT), recursive, leaky
   ! Read data from "stdin" using keyword style input.
   end

   process_keyword(keyword) :: leaky
   ! Process command "keyword". Any required data needed by the
   ! "keyword" is inputted from "stdin".
      self :: INOUT
      keyword :: STR, IN

      word :: STR
      die  :: BIN

      word = keyword
      word.to_lower_case

      select case (word)

      case ("}                             ")  ! exit read_loop

      case ("add_dispersion_to_f_calc=     "); .read_add_dispersion_to_F_calc
      case ("correct_dispersion=           "); .read_add_dispersion_to_F_calc
      case ("d_low_cutoff=                 "); .read_d_low_cutoff
      case ("destroy_reflection_data       "); .destroy_reflection_data
      case ("display_correlation_matrix=   "); .read_show_corrrelation_mx
      case ("display_near_0_eigenvectors=  "); .read_show_near_0_evecs
      case ("do_residual_cube=             "); .read_do_residual_cube
      case ("exp_scale_factor=             "); .read_exp_scale_factor
      case ("f_calc_cutoff=                "); .read_F_calc_cutoff
      case ("f_pred_cutoff=                "); .read_F_pred_cutoff
      case ("f_sigma_cutoff=               "); .read_F_sigma_cutoff
      case ("f_sigma_noise=                "); .read_F_sigma_noise
      case ("f_z_cutoff=                   "); .read_F_z_cutoff
      case ("hkl_range=                    "); .read_hkl_range
      case ("i_pred_cutoff=                "); .read_I_pred_cutoff
      case ("i_sigma_cutoff=               "); .read_I_sigma_cutoff
      case ("i_z_cutoff=                   "); .read_I_z_cutoff
   ! case ("invariom_database_directory=  "); .read_invariom_directory
   ! case ("invariom_refinement=          "); .read_invariom_refinement
   ! case ("junk=                         "); .read_junk
      case ("kind=                         "); .read_data_kind
      case ("make_f_predicted              "); .make_F_predicted
      case ("max_allowed_param_shift=      "); .read_max_allowed_param_shift
      case ("max_iterations=               "); .read_max_iterations
      case ("max_prune_iterations=         "); .read_max_prune_iterations
      case ("min_correlation=              "); .read_min_correlation
      case ("min_iterations=               "); .read_min_iterations
   ! case ("nka_t_sequence_no=            "); .read_NKA_T_seq_no
      case ("nn_level=                     "); .read_NN_level
      case ("n_data_sets=                  "); .read_n_data_sets
      case ("n_param=                      "); .read_n_param
      case ("n_worst_reflections=          "); .read_n_worst_reflections
      case ("near_0_tol=                   "); .read_near_0_tol
      case ("optimise_extinction=          "); .read_refine_extinction
      case ("optimize_extinction=          "); .read_refine_extinction
      case ("optimise_scale_factor=        "); .read_refine_scale
      case ("optimize_scale_factor=        "); .read_refine_scale
      case ("optimise_scale_factors=       "); .read_refine_scale
      case ("optimize_scale_factors=       "); .read_refine_scale
      case ("partition_model=              "); .read_partition_model
   ! case ("prune_reflections             "); .prune_reflections ! Apply automatically?

      !  Put            

      case ("put                           "); .put
      case ("put_worst_reflections         "); .put_worst_reflections
      case ("put_sin_theta_on_lambda       "); .put_sin_theta_on_lambda
      case ("put_wavelength                "); .put_wavelength

      case ("read_cif                      "); .read_CIF
      case ("read_fcf_file                 "); .read_fcf_file
      case ("redirect                      "); .redirect
      case ("refine_3rd_order_for_atoms=   "); .read_refine_3rd_order
      case ("refine_4th_order_for_atoms=   "); .read_refine_4th_order
      case ("refine_4th_order_only=        "); .read_refine_4th_order_only
      case ("refine_adps_only=             "); .read_refine_ADPs_only
      case ("refine_anharmonicity=         "); .read_refine_anharmonicity
      case ("refine_extinction=            "); .read_refine_extinction
      case ("refine_f=                     "); .read_refine_F
      case ("refine_h_adps=                "); .read_refine_H_ADPs
      case ("refine_h_adps_only=           "); .read_refine_H_ADPs
      case ("refine_h_positions=           "); .read_refine_H_positions
      case ("refine_h_positions_only=      "); .read_refine_H_positions
      case ("refine_h_u_iso=               "); .read_refine_H_U_iso
      case ("refine_nothing_for_atoms=     "); .read_refine_nothing_for_atoms
      case ("refine_positions_only=        "); .read_refine_positions_only
      case ("refine_scale_factor=          "); .read_refine_scale
      case ("refine_scale_factors=         "); .read_refine_scale
      case ("refine_u_iso_for_atoms=       "); .read_refine_U_iso_for_atoms
      case ("reflection_data=              "); .read_reflection_data
      case ("remove_dispersion_from_f_exp= "); .read_remove_disp_from_F_exp
      case ("restart_har_with_promolecule= "); .read_restart_with_promolecule
      case ("revert                        "); .revert
      case ("sf_mixing_parameter=          "); .read_SF_mixing_parameter
      case ("show_correlation_matrix=      "); .read_show_corrrelation_mx
      case ("show_fit_output=              "); .read_show_fit_output
      case ("show_fit_results=             "); .read_show_fit_results
      case ("show_iam_output=              "); .read_show_IAM_output
      case ("show_iam_results=             "); .read_show_IAM_results
      case ("show_near_0_eigenvectors=     "); .read_show_near_0_evecs
      case ("show_refinement_output=       "); .read_show_ref_output
      case ("show_refinement_results=      "); .read_show_ref_results
      case ("show_rejects=                 "); .read_show_rejects
      case ("stl_high_cutoff=              "); .read_stl_high_cutoff
      case ("stl_limit=                    "); .read_stl_limit
      case ("stl_low_cutoff=               "); .read_stl_low_cutoff
      case ("stop_after_dispersion=        "); .read_stop_after_dispersion
      case ("synthesize_sigma_i=           "); .read_synthesize_sigma_I
   ! case ("thermal_smearing_model=       "); .read_temperature_factor_model
      case ("temperature=                  "); .read_temperature
   ! case ("temperature_factor_model=     "); .read_temperature_factor_model
      case ("tol_for_shift_on_esd=         "); .read_tol_for_shift_on_esd
      case ("tol_near_0=                   "); .read_near_0_tol
      case ("use_disk_sfs=                 "); .read_use_disk_SFs
      case ("use_equivalents=              "); .read_use_equivalents
      case ("use_iam_itc_ffs=              "); .read_use_IAM_ITC_FFs
      case ("use_nn=                       "); .read_use_NN
      case ("use_nn_capping=               "); .read_use_NN_capping
      case ("use_ryde_capping=             "); .read_use_Ryde_capping
      case ("use_text_sfs=                 "); .read_use_text_SFs
      case ("wavelength=                   "); .read_wavelength

      !  Documentation

      case ("add_dispersion_to_f_calc=?    "); .docu_add_dispersion_to_F_calc(die)
      case ("correct_dispersion=?          "); .docu_add_dispersion_to_F_calc(die)
      case ("d_low_cutoff=?                "); .docu_d_low_cutoff(die)
      case ("destroy_reflection_data?      "); .docu_destroy_reflection_data(die)
      case ("display_correlation_mx=?      "); .docu_show_corr_matrix(die)
      case ("display_near_0_eigenvectors=? "); .docu_show_near_0_evecs(die)
      case ("do_residual_cube=?            "); .docu_do_residual_cube(die)
      case ("exp_scale_factor=?            "); .docu_exp_scale_factor(die)
      case ("f_calc_cutoff=?               "); .docu_F_calc_cutoff(die)
      case ("f_pred_cutoff=?               "); .docu_F_pred_cutoff(die)
      case ("f_sigma_cutoff=?              "); .docu_F_sigma_cutoff(die)
      case ("f_sigma_noise=?               "); .docu_F_sigma_noise(die)
      case ("f_z_cutoff=?                  "); .docu_F_z_cutoff(die)
      case ("fcf_file=?                    "); .docu_fcf_file(die)
      case ("hkl_range=?                   "); .docu_hkl_range(die)
      case ("i_pred_cutoff=?               "); .docu_I_pred_cutoff(die)
      case ("i_sigma_cutoff=?              "); .docu_I_sigma_cutoff(die)
      case ("i_z_cutoff=?                  "); .docu_I_z_cutoff(die)
   ! case ("invariom_database_directory=? "); .docu_invariom_directory(die)
   ! case ("invariom_refinement=?         "); .docu_invariom_refinement(die)
   ! case ("junk=?                        "); .docu_junk(die)
      case ("kind=?                        "); .docu_data_kind(die)
      case ("make_f_predicted?             "); .docu_make_F_predicted(die)
      case ("max_allowed_param_shift=?     "); .docu_max_allowed_param_shift(die)
      case ("max_iterations=?              "); .docu_max_iterations(die)
      case ("max_prune_iterations=?        "); .docu_max_prune_iterations(die)
      case ("min_correlation=?             "); .docu_min_correlation(die)
      case ("min_iterations=?              "); .docu_min_iterations(die)
   ! case ("nka_t_sequence_no=?           "); .docu_NKA_T_seq_no(die)
      case ("nn_level=?                    "); .docu_NN_level(die)
      case ("n_data_sets=?                 "); .docu_n_data_sets(die)
      case ("n_param=?                     "); .docu_n_param(die)
      case ("n_worst_reflections=?         "); .docu_n_worst_reflections(die)
      case ("near_0_tol=?                  "); .docu_near_0_tol(die)
      case ("optimize_scale_factors=?      "); .docu_refine_scale(die)
      case ("optimise_extinction=?         "); .docu_refine_extinction(die)
      case ("optimize_extinction=?         "); .docu_refine_extinction(die)
      case ("optimise_scale_factor=?       "); .docu_refine_scale(die)
      case ("optimize_scale_factor=?       "); .docu_refine_scale(die)
      case ("optimise_scale_factors=?      "); .docu_refine_scale(die)
      case ("refine_extinction=?           "); .docu_refine_extinction(die)
      case ("refine_scale_factor=?         "); .docu_refine_scale(die)
      case ("refine_scale_factors=?        "); .docu_refine_scale(die)
      case ("partition_model=?             "); .docu_partition_model(die)
   ! case ("prune_reflections             "); .prune_reflections ! Apply automatically?(die)
      case ("put?                          "); .docu_put(die)
      case ("put_worst_reflections?        "); .docu_put_worst_reflections(die)
      case ("put_sin_theta_on_lambda?      "); .docu_put_sin_theta_on_lambda(die)
      case ("put_wavelength?               "); .docu_put_wavelength(die)
      case ("read_cif?                     "); .docu_CIF(die)
      case ("redirect?                     "); .docu_redirect(die)
      case ("refine_3rd_order_for_atoms=?  "); .docu_refine_3rd_order(die)
      case ("refine_4th_order_for_atoms=?  "); .docu_refine_4th_order(die)
      case ("refine_4th_order_only=?       "); .docu_refine_4th_order_only(die)
      case ("refine_adps_only=?            "); .docu_refine_ADPs_only(die)
      case ("refine_anharmonicity=?        "); .docu_refine_anharmonicity(die)
      case ("refine_f=?                    "); .docu_refine_F(die)
      case ("refine_h_adps=?               "); .docu_refine_H_ADPs_only(die)
      case ("refine_h_adps_only=?          "); .docu_refine_H_ADPs_only(die)
      case ("refine_h_positions=?          "); .docu_refine_H_positions_only(die)
      case ("refine_h_positions_only=?     "); .docu_refine_H_positions_only(die)
      case ("refine_h_u_iso=?              "); .docu_refine_H_U_iso(die)
      case ("refine_nothing_for_atoms=?    "); .docu_refine_nothing_for_atoms(die)
      case ("refine_positions_only=?       "); .docu_refine_positions_only(die)
      case ("refine_u_iso_for_atoms=?      "); .docu_refine_U_iso_for_atoms(die)
      case ("reflection_data=?             "); .docu_reflection_data(die)
      case ("remove_dispersion_from_f_exp=?"); .docu_remove_disp_from_F_exp(die)
      case ("restart_har_with_promolecule=?"); .docu_restart_with_promolecule(die)
      case ("revert?                       "); .docu_revert(die)
      case ("sf_mixing_parameter=?         "); .docu_SF_mixing_parameter(die)
      case ("show_fit_output=?             "); .docu_show_fit_output(die)
      case ("show_fit_results=?            "); .docu_show_fit_results(die)
      case ("show_iam_output=?             "); .docu_show_IAM_output(die)
      case ("show_iam_results=?            "); .docu_show_IAM_results(die)
      case ("show_refinement_output=?      "); .docu_show_ref_output(die)
      case ("show_refinement_results=?     "); .docu_show_ref_results(die)
      case ("show_rejects=?                "); .docu_show_rejects(die)
      case ("stl_high_cutoff=?             "); .docu_stl_high_cutoff(die)
      case ("stl_low_cutoff=?              "); .docu_stl_low_cutoff(die)
      case ("stl_limit=?                   "); .docu_stl_limit(die)
   ! case ("stop_after_dispersion=?       "); .docu_stop_after_dispersion(die)
   ! case ("synthesize_sigma_i=?          "); .docu_synthesize_sigma_I(die)
   ! case ("thermal_smearing_model=?      "); .docu_temperature_factor_model(die)
   ! case ("temperature=?                 "); .docu_temperature(die)
   ! case ("temperature_factor_model=?    "); .docu_temperature_factor_model(die)
      case ("tol_for_shift_on_esd=?        "); .docu_tol_for_shift_on_esd(die)
      case ("tol_near_0=?                  "); .docu_near_0_tol(die)
      case ("use_disk_sfs=?                "); .docu_use_disk_SFs(die)
      case ("use_equivalents=?             "); .docu_use_equivalents(die)
      case ("use_iam_itc_ffs=?             "); .docu_use_IAM_ITC_FFs(die)
      case ("use_nn=?                      "); .docu_use_NN(die)
      case ("use_nn_capping=?              "); .docu_use_NN_capping(die)
      case ("use_ryde_capping=?            "); .docu_use_Ryde_capping(die)
      case ("use_text_sfs=?                "); .docu_use_text_SFs(die)
      case ("wavelength=?                  "); .docu_wavelength(die)
      case ("help?                         "); .docu_help

      case default;                       UNKNOWN(word)

      end

   end

