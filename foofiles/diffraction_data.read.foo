      .set_F_pred_cutoff(val)

   end

   docu_F_sigma_cutoff(die) :: selfless, private
   ! Documentation.
      die :: BIN, optional, IN
      stdout.flush
      stdout.flush
      stdout.text("F_sigma_cutoff= REAL")
      stdout.flush
      stdout.text(". Set cutoff for |F_exp/F_sigma| values, used to prune out")
