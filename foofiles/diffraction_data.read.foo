   ! .docu_NKA_T_seq_no
      .docu_NN_level
      .docu_n_data_sets
      .docu_n_param
      .docu_n_worst_reflections
      .docu_near_0_tol
      .docu_refine_extinction
      .docu_refine_scale
      .docu_partition_model
!   ! .prune_reflections ! Apply automatically?
      .docu_put
