      .docu_put_sin_theta_on_lambda
      .docu_put_wavelength
      .docu_CIF
      .docu_redirect
      .docu_refine_3rd_order
      .docu_refine_4th_order
      .docu_refine_4th_order_only
      .docu_refine_ADPs_only
      .docu_refine_anharmonicity
      .docu_refine_F
      .docu_refine_H_ADPs_only
