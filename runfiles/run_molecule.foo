program run_MOLECULE

   implicit none

   command_line :: COMMAND_LINE
   option,value :: STR
   infile,outfile,basis_library_dir :: STR(len=PATH_SIZE)   ! paths
   i :: INT
   maxlen :: INT   ! len() into a declared INT: see CLAUDE.md sec 8
   m :: MOLECULE@

   ! Macro to create Tonto system object
   ! Initialise MPI parallel stuff too.
   TONTO_CREATE

   ! Assign std_err to screen
   TEXTFILE::create_std_err
   std_err.open_for("write")

   ! Assign stdout to screen
   TEXTFILE::create_stdout

   ! Get command line
   command_line.process_options
   DIE_IF(command_line.has_arguments,"illegal arguments; use --options only e.g. --help")

   ! Default option values
   infile  = " "
   outfile = " "
   basis_library_dir = " "

   ! Analyze command line options
   do i = 1,command_line.n_options

      ! Get options
      option = command_line.option(i)
      value  = command_line.option_value(i)

      ! Analyze options
      select case (option)

      case("input")
         infile  = value

      case("output")
         outfile = value

      case("basis-library")
         basis_library_dir = value

      case("help")
         stdout.text("Usage:")
         stdout.flush
         stdout.text("  tonto [--help] [--input INPUT] [--output OUTPUT]")
         stdout.flush
         stdout.text("        [--basis-library BASIS_LIBRARY_DIR] [--version]")
         stdout.flush
         stdout.text("Optional arguments:")
         stdout.flush
         stdout.text("--help")
         stdout.flush
         stdout.text("  Show this help message and exit")
         stdout.flush
         stdout.text("--input INPUT")
         stdout.flush
         stdout.text("  Set input file to INPUT [default='stdin']")
         stdout.flush
         stdout.text("--output OUTPUT")
         stdout.flush
         stdout.text("  Set output file to OUTPUT [default='stdout']")
         stdout.flush
         stdout.text("--basis-library BASIS_LIBRARY_DIR")
         stdout.flush
         stdout.text("  Set the basis set library directory to BASIS_LIBRARY_DIR [default='"// VEC_BASIS_LIBRARY_DIRECTORY//"']")
         stdout.flush
         stdout.text("--version")
         stdout.flush
         stdout.text("  Return the version of tonto and stop")
         ! Stop, like --version below. Without this, --help printed the usage
         ! and then fell through to stdin.open_for("read"), dying on a missing
         ! input file straight after telling the user how to supply one.
         stop

      case("version")
         stdout.text("This is Tonto version"//TONTO_VERSION//" "//GIT_VERSION)
         stop

      case default
         DIE("unknown option: "//trim(option))

      end

   end

   ! Renitialise stdout?
   if (outfile/=" ") then
      stdout.destroy
      stdout.create(outfile)
   end
   stdout.open_for("write")
   tonto.set_stdout_file(stdout)

   ! Renitialise std_err
   std_err.close
   tonto.set_std_err_file(stdout)

   ! Assign stdin stdin
   if (infile/=" ") then; stdin.create(infile)
   else;                  TEXTFILE::create_stdin
   end
   stdin.open_for("read")

   if(basis_library_dir == " ") then
      ! status is -1 when the value was TRUNCATED to fit, and >0 when the
      ! variable is unset. The status used to be ignored entirely, so an
      ! over-long path was silently cut and the failure surfaced later as
      ! "no library basis set" -- naming the basis rather than the path.
      ! See DEFERRED.md, "long paths to the basis sets fail".
      call get_environment_variable(BASIS_LIBRARY_ENV_NAME, basis_library_dir, status=i)
      maxlen = len(basis_library_dir)
      DIE_IF(i<0,"the "//BASIS_LIBRARY_ENV_NAME//" path is too long: it does "// &
             "not fit in "//trim(maxlen.to_str)//" characters")
      if (i/=0) basis_library_dir = " "
   end if

   ! Run the molecule
   m.MAIN:run(basis_library_dir)

   ! Clean-up molecule
   MOLECULE.MAIN:cleanup

   ! Clean-up files
   TEXTFILE:destroy(stdout)
   TEXTFILE:destroy(stdin)
   TEXTFILE:destroy(std_err)

   ! Clean-up tonto system
   TONTO_DESTROY


end
