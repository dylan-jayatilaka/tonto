program run_PI

!  This program generates pi by Reimann integration.
!  It uses the formula pi = \int_0^1 4/(1+x^2) dx.

   implicit none

   pi,h,x :: REAL  
   i,n :: INT

   ! Macro to create Tonto system object
   ! Initialise MPI parallel stuff too.
   ! Initialise standard I/O files too.
   TONTO_CREATE ! Always have these lines
   ! NOTE: create_stdout/create_std_err are `selfless` (foofiles/textfile.foo),
   ! so they must be called as TEXTFILE::create_stdout, not stdout.create_stdout
   ! -- the latter passes stdout as an argument and fails to compile with "no
   ! specific subroutine for the generic 'create_stdout_'". This file had been
   ! commented out of CMakeLists.txt for years, so it was never compiled against
   ! the current library and had drifted.
   TEXTFILE::create_stdout; stdout.open_for("writing")
   TEXTFILE::create_std_err; std_err.open_for("writing")

   ! This program is the MPI smoke test (scripts/check_mpi_pi.sh): it must show
   ! that the answer does not change with the rank count. The default 6-decimal
   ! output cannot resolve a reduction-order difference at all, so print enough
   ! digits for the comparison to mean something.
   ! Width must be widened together with precision, or the value overflows the
   ! field and Fortran prints "****************" instead of a number.
   stdout.set_real_width(25)
   stdout.set_real_precision(15)

   ! Set how many Riemann blocks
   n = 100000000
!  stdin.read(n)
   stdout.show("No. of intervals = ",n)

   ! Start the timer
   std_time.start_timing  

   ! Pi = Integral[0,1] 4/(1+x^2) dx
   pi = ZERO    
   h  = ONE/n  
   parallel do i = 1,n ! <<< Parallel loop
      x  = h * (i-HALF)           
      pi = pi + h * FOUR/(ONE+x*x) 
   end

   ! Sum all processor answers in "pi"
   PARALLEL_SUM(pi)                

   ! Report answer
   stdout.show("Pi = ",pi)         
   
   ! Stop timing & report time
   std_time.stop_timing
   stdout.text(std_time.elapsed_time_message)
   stdout.text(std_time.elapsed_cpu_time_message)

   ! Clean up standard files and Tonto system object
   TEXTFILE:destroy(std_err)
!  TEXTFILE:destroy(stdin)
   TEXTFILE:destroy(stdout)
   TONTO_DESTROY

end
