program run_MP2_EXERCISE
   ! The MP2 teaching exercise: this is `run_mp2.foo` with the correlation
   ! energy left for the student to write. Everything up to and including
   ! the orbital energies is done for you; the blanks are marked below.
   !
   ! Originally `run_mp2.foo` on the archived `Teaching` branch (Max
   ! Davidson and Dylan Jayatilaka, October 2019), where it was the student
   ! worksheet. It is renamed here so that the working program can keep the
   ! plain name. The branch's near-empty `run_exercise.foo` skeleton is
   ! subsumed by this file.
   !
   ! Build it with:      make run_mp2_exercise
   ! Run it with:        cd <a directory holding your job as a file named
   !                     "stdin">; run_mp2_exercise
   ! The answers are in: runfiles/run_mp2.foo

   implicit none

   m :: MOLECULE@
   v :: MAT4{REAL}@
   eval :: VEC{REAL}@
   n,no,i,j,a,b :: INT
   e_hf,e2,top,bot :: REAL
   basis_library_dir :: STR(len=PATH_SIZE)
   stat :: INT

   ! ---------- Initialisation: nothing to do here ----------

   ! Macro to create Tonto system object
   ! Initialise MPI parallel stuff too.
   TONTO_CREATE

   ! Open the error log
   TEXTFILE::create_std_err
   std_err.open_for("write")

   ! Start the timer
   std_time.start_timing

   ! Open the "stdin" input file
   TEXTFILE::create_stdin
   stdin.open_for("read")

   ! Open the "stdout" output file
   TEXTFILE::create_stdout
   stdout.open_for("write")

   ! Where are the basis sets? This program takes no command-line options,
   ! so it reads the TONTO_BASIS_SET_DIRECTORY environment variable.
   basis_library_dir = " "
   call get_environment_variable(BASIS_LIBRARY_ENV_NAME,basis_library_dir,status=stat)
   if (stat/=0) basis_library_dir = " "

   ! Run the molecule calculation. It reads commands from "stdin", so your
   ! job file must do an "scf" before there are any orbitals to correlate.
   m.MAIN:run(basis_library_dir)

   ! The Hartree-Fock energy
   e_hf = m.SCF_data.energy

   ! Important numbers
   n  = m.n_bf    ! No. of basis functions
   no = m.n_e/2   ! No. of occupied spatial orbitals

   ! The two-electron integrals over molecular orbitals, in chemists'
   ! notation: v(i,a,j,b) is the integral (ia|jb)
   v.create(n,n,n,n)
   m.FOCK:make_MO_ERI_chem_integrals(v)

   ! The orbital energies
   eval.create(n)
   eval = m.MO_energies.r

   ! ---------- End of initialisation ----------


   ! EXERCISE 1. Print the number of basis functions and the number of
   ! occupied orbitals, to check you have what you think you have. Use
   ! either of:
   !
   !    stdout.show("No. of basis functions =",n)
   !    print*, "No. of basis functions =", n
   !
   ! The first writes to the output file, the second to your terminal.

   ! ... your code here


   ! EXERCISE 2. Print the orbital energies. They are in the vector "eval",
   ! which has "n" elements. `stdout.put(eval)` prints the whole vector at
   ! once; a "do" loop over its elements also works.

   ! ... your code here


   ! EXERCISE 3. Evaluate the MP2 correlation energy,
   !
   !    E2 = sum over i,j,a,b of
   !
   !               (ia|jb) [ 2(ia|jb) - (ib|ja) ]
   !               -----------------------------
   !               e_i + e_j - e_a - e_b
   !
   ! where i and j run over the OCCUPIED orbitals, 1 to no, and a and b run
   ! over the VIRTUAL orbitals, no+1 to n. Remember that (ia|jb) is
   ! v(i,a,j,b) and that e_i is eval(i). There is no factor of one half.
   !
   ! Accumulate the answer into "e2". The variables "top" and "bot" are
   ! declared for you if you want to build the numerator and denominator
   ! separately -- which makes it much easier to see what went wrong.

   e2 = ZERO

   ! do i =
   ! do j =
   ! do a =
   ! do b =
   !
   !    top =
   !    bot =
   !
   !    e2 = e2 +
   !
   ! end
   ! end
   ! end
   ! end


   ! EXERCISE 4. Print the Hartree-Fock energy "e_hf", your MP2 correlation
   ! energy "e2", and their sum, which is the total MP2 energy.

   ! ... your code here


   ! EXERCISE 5. Check your answer. Add the keyword "mp2" to your job file
   ! and Tonto will compute the same thing itself. The two will not agree
   ! at first: the library freezes the lowest occupied orbital, so start
   ! your i and j loops at 2 to compare like with like. Explain why
   ! freezing an orbital makes the correlation energy smaller in magnitude.


   ! ---------- Tidy up: nothing to do here either ----------

   eval.destroy
   v.destroy

   ! Clean-up molecule
   MOLECULE.MAIN:cleanup

   ! Clean-up files
   TEXTFILE:destroy(stdout)
   TEXTFILE:destroy(stdin)
   TEXTFILE:destroy(std_err)

   ! Clean-up tonto system
   TONTO_DESTROY


end
