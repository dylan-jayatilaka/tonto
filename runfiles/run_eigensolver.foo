!-------------------------------------------------------------------------------
!
! run_eigensolver: checks MAT{REAL}:diagonalize_QR, the pure symmetric
! eigensolver behind the structure refinement's normal equations, and exits
! non-zero if a check fails, then times the solvers on a 322-parameter
! normal matrix. The `symmetric_eigensolver_known_answer` ctest.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
!-------------------------------------------------------------------------------

program run_EIGENSOLVER

   implicit none

   n_failed :: INT
   A,B,Q :: MAT{REAL}@
   lam :: VEC{REAL}@
   t0,t_jacobi,t_qr,t_lapack :: REAL
   n,i,j :: INT

   TONTO_CREATE
   std_time.start_timing

   TEXTFILE::create_std_err
   std_err.open_for("write")
   TEXTFILE::create_stdout

   n_failed = MAT{REAL}:check_QR_eigensolver()

   DIE_IF(n_failed>0,"symmetric eigensolver check failed")

   ! Not a check: the CPU time of each solver on a normal matrix the size
   ! of the largest refinement in the test suite, 322 parameters
   n = 322
   B.create(4*n,n)
   do i = 1,4*n
   do j = 1,n
      B(i,j) = sin(0.7d0*i+0.3d0*j)/(ONE+abs(i-4*j))
   end
   end
   A.create(n,n)
   A.to_product_of(B,B,transpose_a=TRUE)
   lam.create(n); Q.create(n,n)

   t0 = TIME:current_cpu_time()
   A.diagonalize_Jacobi(lam,Q)
   t_jacobi = TIME:current_cpu_time() - t0

   t0 = TIME:current_cpu_time()
   A.diagonalize_QR(lam,Q)
   t_qr = TIME:current_cpu_time() - t0

   t0 = TIME:current_cpu_time()
   A.solve_symmetric_eigenproblem(lam,Q)
   t_lapack = TIME:current_cpu_time() - t0

   stdout.flush
   stdout.text("CPU time to diagonalise a "//trim(n.to_str)//" x "//trim(n.to_str)//" normal matrix, seconds:")
   stdout.show("Jacobi                =",t_jacobi)
   stdout.show("Householder and QR    =",t_qr)
   stdout.show("LAPACK dsyev          =",t_lapack)
   stdout.flush

   Q.destroy; lam.destroy; A.destroy; B.destroy

   TEXTFILE:destroy(std_err)
   TEXTFILE:destroy(stdout)
   TONTO_DESTROY

end
