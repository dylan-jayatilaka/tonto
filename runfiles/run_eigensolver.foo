!-------------------------------------------------------------------------------
!
! run_eigensolver: checks MAT{REAL}:diagonalize_QR, the pure symmetric
! eigensolver behind the structure refinement's normal equations, and exits
! non-zero if a check fails. The `symmetric_eigensolver_known_answer` ctest.
!
! Copyright (C) Dylan Jayatilaka, 2026
!
! This library is free software; you can redistribute it and/or
! modify it under the terms of the GNU Library General Public
! License as published by the Free Software Foundation; either
! version 2 of the License, or (at your option) any later version.
!
!-------------------------------------------------------------------------------

program run_EIGENSOLVER

   implicit none

   n_failed :: INT

   TONTO_CREATE
   std_time.start_timing

   TEXTFILE::create_std_err
   std_err.open_for("write")
   TEXTFILE::create_stdout

   n_failed = MAT{REAL}:check_QR_eigensolver()

   DIE_IF(n_failed>0,"symmetric eigensolver check failed")

   TEXTFILE:destroy(std_err)
   TEXTFILE:destroy(stdout)
   TONTO_DESTROY

end
