program run_HAR

   implicit none

   default_basis :: STR  DEFAULT("def2-SVP")
   allowed_bases :: VEC{STR}(len=10,7)

   default_grid :: STR  DEFAULT("low")
   grid_levels  :: VEC{STR}(len=9,6)

   m :: MOLECULE@
   command_line :: COMMAND_LINE
   option,value :: STR
   spinorbitals :: STR
   mess,etime,ctime :: STR
   basis,basdir,basnam,gracc :: STR
   cif,guess,job,out,err,scf :: STR
   tail :: STR
   std_f2,std_f,shx_f2,shx_f :: STR
   dtol,fos,fzcut     :: REAL
   ldtol,radius,ten   :: REAL
   anharm,disperse    :: VEC{STR}@
   grp_charge         :: VEC{INT}@
   grp_mult           :: VEC{INT}@
   wavelen            :: REAL
   i, charge, mult    :: INT
   g, n_groups, maxit  :: INT
   do_4_only, extinct :: BIN
   h_ADPs,h_iso,h_pos :: BIN
   radius_is_0        :: BIN
   tmetal,defragment  :: BIN
   disk_sfs           :: BIN
   mmcif, do_fragHAR  :: BIN
   rescube            :: BIN
   file :: TEXTFILE@

   ! Macro to create Tonto system object
   ! Initialise MPI parallel stuff too.
   TONTO_CREATE

   ! Set stdout & std_err to screen. std_err must be *opened* as well as
   ! created: it is closed and deleted below once the <job> name is known,
   ! and TEXTFILE:close_and_delete dies on a file that does not exist.
   TEXTFILE::create_stdout
   TEXTFILE::create_std_err
   std_err.open_for("write")

   ! Defence in depth, not the fix. hart never reads a job file, but it once
   ! segfaulted on the second HAR cycle because MOLECULE.READ:read_archive
   ! reached for the global stdin to look for a trailing "normalise", and
   ! hart had created none -- dereferencing an unallocated TEXTFILE. That
   ! routine no longer touches stdin (the qualifier is an argument now, and
   ! read_archive_and_normalise is its keyword), so this is here only in case
   ! another library path reaches the same way. Create but do NOT open it:
   ! there is no stdin file, and an empty buffer answers such questions
   ! correctly. See DEFERRED.md for the survey of who else could.
   TEXTFILE::create_stdin

   ! Allowed values for --basis and --grid-accuracy.
   !
   ! These are assigned here, NOT with a `data` statement in the declarations:
   ! the ANTLR4 translator silently DROPS a `data` statement at `program` scope
   ! (it keeps them at module scope). The arrays were left uninitialised, so
   ! every basis name -- including the default -- failed `is_one_of` below with
   ! "unknown basis". See DEFERRED.md.
   allowed_bases = [ &
      "STO-3G    ", &
      "def2-SVP  ", &
      "def2-TZVP ", &
      "def2-TZVPP", &
      "cc-pVDZ   ", &
      "cc-pVTZ   ", &
      "cc-pVQZ   "  ]

   grid_levels = [ &
      "very_low ", &
      "low      ", &
      "medium   ", &
      "high     ", &
      "very_high", &
      "extreme  "  ]

   ! Default option values
   basis      = default_basis
   basdir     = " "   ! see the TONTO_BASIS_SET_DIRECTORY fallback below
   charge     = 0
   cif        = "urea.cif"
   disk_sfs   = FALSE
   dtol       = TOL(2)
   do_4_only  = FALSE
   err        = " "
   extinct    = FALSE
   fos        = THREE
   fzcut      = -ONE
   gracc      = default_grid
   guess      = "mos"
   h_ADPs     = TRUE
   h_iso      = FALSE
   h_pos      = TRUE
   job        = " "
   ldtol      = TOL(5)
   maxit      = 0     ! 0 = leave the library default (100) alone
   mmcif      = FALSE
   mult       = 1
   rescube    = TRUE
   out        = " "
 ! radius     = EIGHT*BOHR_PER_ANGSTROM 
   radius     = ZERO
   defragment = TRUE
   shx_f2     = " "
   std_f2     = " "
   shx_f      = " "
   std_f      = " "
   scf        = "rhf"
   ten        = TEN*BOHR_PER_ANGSTROM
   wavelen    = -ONE   ! i.e. not set; see --wavelength

   ! Get command line !!!!!!!!!
   command_line.set_defaults
   command_line.process_options
   !!!!!!!!!!!!!!!!!!!!!!!!!!!!
   
   ! --help and --version report and stop; neither needs a <cif-file>, so the
   ! argument checks below must not run for them.
   if (NOT (command_line.has_option("help") OR command_line.has_option("version"))) then

      if  (NOT command_line.has_arguments) then

            ! No arguments
            stdout.text("Supply a <cif-file> and, if needed, a <hkl> file")
            stdout.text("via the --shelx-f <hkl> or --shelx-f2 <hkl> options.")
            stdout.text("Type 'hart --help' for additional help.")
            stop 1

      else if (command_line.n_args>1) then

            ! Too many arguments
            stdout.text("Supply a <cif-file> and, if needed, a <hkl> file")
            stdout.text("via the --shelx-f <hkl> or --shelx-f2 <hkl> options.")
            stdout.text("Type 'hart --help' for additional help.")
            stop 1

      else

         ! First argument
         cif = command_line.arg(1)

         ! No .cif or .cif2 extension. Both are accepted: a .cif2 file is
         ! what a previous hart run writes, and what a restart needs.
         tail = cif.filename_tail
         if (NOT tail.is_one_of(["cif ","cif2"])) then
            stdout.text("Supply a cif file with a '.cif' or '.cif2' extension!")
            stdout.text("Type 'hart --help' for additional help.")
            stop 1
         end
         
      end
      
      ! Get the <job>
      if (command_line.has_option("job")) then
         job = command_line.value_for_option("job")
      end

      ! Braced integer lists, one entry per atom group. Read here rather than
      ! in the option loop below because they are vectors, not scalars, and
      ! COMMAND_LINE owns the brace/integer checking. Their length is checked
      ! against the real number of atom groups once the structure is read.
      if (command_line.has_option("group-charges")) then
         command_line.int_vec_for_option("group-charges",grp_charge)
      end
      if (command_line.has_option("group-multiplicities")) then
         command_line.int_vec_for_option("group-multiplicities",grp_mult)
         DIE_IF(any(grp_mult<1),"--group-multiplicities: must all be 1 or more")
      end
     
      ! Preprocess main arguments
      if (job==" ") job = trim(cif.filename_head)
      if (out==" ") out = trim(job)//".out"
      if (err==" ") err = trim(job)//".err"
     
      ! Set std_err properly
      std_err.close_and_delete
      std_err.destroy
      TEXTFILE::create_std_err 
      std_err.set_name(err)
      std_err.open_for("write")

   end ! -- NOT help/version

   ! Analyze command line options
   do i = 1,command_line.n_options

      ! Get options
      option = command_line.option(i)
      value  = command_line.option_value(i)

      ! Analyze options
      select case (option)

       ! case ("anharm        ");  anharm     = value.split
       ! case ("4th-order-only");  do_4_only  = value.to_bin
         case ("basis         ");  basis      = value
         case ("basis-dir     ");  basdir     = value
       ! case ("charge        ");  charge     = value.to_int
         case ("cluster-radius");  radius     = value.to_real*BOHR_PER_ANGSTROM
         case ("complete-mol  ");  defragment = value.to_bin !test defrag Lorraine
         case ("dispersion    ");  disperse   = value.split
         case ("disk-sfs      ");  disk_sfs   = value.to_bin
         case ("dtol          ");  dtol       = value.to_real
         case ("extinction    ");  extinct    = value.to_bin
         case ("fos           ");  fos        = value.to_real
         case ("fzcut         ");  fzcut      = value.to_real

         ! Braced integer lists; read above via COMMAND_LINE:int_vec_for_option,
         ! which is where the brace and integer checking lives.
         case ("group-charges       ") ! already dealt with above
         case ("group-multiplicities") ! already dealt with above

         case ("grid-accuracy ");  gracc      = value
         case ("max-iterations");  maxit      = value.to_int
         case ("mmcif         ");  mmcif      = value.to_bin
         case ("residual-cube ");  rescube    = value.to_bin
         case ("wavelength    ");  wavelen    = value.to_real
         case ("h-adps        ");  h_ADPs     = value.to_bin
         case ("h-iso         ");  h_iso      = value.to_bin
         case ("h-pos         ");  h_pos      = value.to_bin !test_new refine_H_pos Lorraine
         case ("job           ") ! already dealt with above
       ! case ("ldtol         ");  ldtol      = value.to_real
       ! case ("mult          ");  mult       = value.to_int
         case ("shelx-f       ");  shx_f      = value
         case ("shelx-f2      ");  shx_f2     = value
         case ("std-f         ");  std_f      = value
         case ("std-f2        ");  std_f2     = value
         case ("scf           ");  scf        = value
       ! case ("scf-guess     ");  guess      = value
       ! case ("wavelength    ");  wavelength = value.to_real

         case ("version")

            stdout.text("This is hart, from Tonto version"//TONTO_VERSION//" "//GIT_VERSION)
            stop

         case ("help")

            stdout.text("SYNOPSIS")
            stdout.flush
            stdout.text("    hart [options] <cif-file>")
            stdout.flush     
            stdout.text("    . Do a Hirshfeld-atom refinement (HAR) on a fragment of the crystal structure")
            stdout.text("      whose initial atom coordinates and ADPs appear in the <cif-file>.")
            stdout.flush     
            stdout.text("    . X-ray structure factors must be in the <cif-file> or in a given <hkl> file.")
            stdout.flush
            stdout.text("    . Output comprises a standard asymmetric-unit CIF and an enhanced tonto CIF")
            stdout.text("      in CIF2 format which is necessary for restart")
            stdout.flush
            stdout.flush
            stdout.text("EXPLANATION")
            stdout.flush
            stdout.text("    . HAR is a final 'polishing' least-sqaures refinement applied after a normal")
            stdout.text("      normal X-ray refinement, with results in the <cif-file>. X-ray reflections")
            stdout.text("      may be within the <cif-file> in standard format. Data as _shelx_hkl_file")
            stdout.text("      comment ios currently not accepted.")
            stdout.flush
            stdout.text("    . HAR produces the best structure from available data, including H atom")
            stdout.text("      bond lengths as accurate as from neutron measurements - provided data is")
            stdout.text("      collected to at least 0.7 A^-1")
            stdout.flush
            stdout.text("    . HAR makes use of 'tailor-made' aspherical atomic form factors calculated")
            stdout.text("      on-the-fily from a Hirshfeld-partitioned electron density (ED) - not from")
            stdout.text("      spherical-atom form factors.")
            stdout.flush
            stdout.text("    . The ED is calculated from a gaussian <basis> set single determinant SCF")
            stdout.text("      <wavefunction> - either SCF or DFT - for a fragment of the crystal embedded in") 
            stdout.text("      an electrostatic crystal field") 
            stdout.flush
            stdout.text("    . The crystal field comprises atom-centered charges and dipoles placed on whole")
            stdout.text("      molecules surrounding the the central fragment out to a desired <radius>. The")
            stdout.text("      charges and dipoles on surrrouding molecules are themselves calculated from the")
            stdout.text("      atoms on the central fragment, so must be calcuated iteratively")
            stdout.flush
            stdout.text("    . The fragment structure is chosen so that the leading symmetry-unique atoms are")
            stdout.text("      in a 'realistic' chemical environment i.e. ideally the fragment is as large as")
            stdout.text("      practically possible. Use of a GUI is helpful.")
            stdout.flush
            stdout.flush
            stdout.text("RESTRICTIONS")
            stdout.flush
            stdout.text("    . The fragment must have zero overall charge")
            stdout.flush
            stdout.text("    . The fragment must have an even number of electrons i.e. be closed shell")
            stdout.flush
            stdout.text("    . All symmetry-unique atoms and molecules must appear in the fragment")
            stdout.flush
            stdout.text("    . Disordered structures may not be refined")
            stdout.flush
            stdout.text("    . Only elements up to Z=36 (Kr) are supported")
            stdout.flush
            stdout.text("    . Transition metals (Z=21 to 30, Sc to Zn) are not supported")
            stdout.flush
            stdout.flush
            stdout.text("REFERENCES")
            stdout.flush
            stdout.text("    . 'Hirshfeld atom refinement'")
            stdout.text("      S.C. Capelli, H.-B. Buergi, B. Dittrich, S. Grabowsky, D. Jayatilaka")
            stdout.text("      (2014) IUCrJ 1 pp 361-379")
            stdout.flush
            stdout.text("    . 'X-ray structure refinement using aspherical atomic density functions obtained")
            stdout.text("      from quantum-mechanical calculations'")
            stdout.text("      D. Jayatilaka and B. Dittrich,")
            stdout.text("      (2008) Acta Cryst. A 64, 383–393")
            stdout.flush
            stdout.flush
            stdout.text("OPTIONS")
          ! stdout.flush    
          ! stdout.text("   --anharm '<atom-label-list>'")
          ! stdout.flush    
          ! stdout.text("       Refine the listed atoms anharmonically using a 4th or Gram-Charlier expansion.")
          ! stdout.text("       The <atom-label-list> must correspond to the *unique* labels in the <cif-file>")
          ! stdout.text("       and must be separated by spaces e.g. 'S1 Cl'")
            stdout.flush
            stdout.text("   --basis <basis>")
            stdout.flush    
            stdout.text("       The gaussian atomic <basis> set to use. A file with the bases, also called")
            stdout.text("       <basis>, must reside in the <basis-dir> folder (see --basis-dir option)")
            stdout.flush
            stdout.text("       Default: def2-SVP")
            stdout.flush    
            stdout.text("       Other allowed values for <basis> are:")
            stdout.flush
            stdout.text("       Testing    Adequate    Excellent     Benchmark    Availability")
            stdout.text("       ______________________________________________________________")
            stdout.flush                              
            stdout.text("       STO-3G     def2-SVP    def2-TZVP    def2-TZVPP    H--Kr       ")
            stdout.text("                   cc-pVDZ      cc-pVTZ       cc-pVQZ    H--Kr (No K)")
            stdout.text("       ______________________________________________________________")
            stdout.flush                               
            stdout.text("       Additional bases may be added into the <basis-dir> folder from the EMSL")
            stdout.text("       basis-set library, if required. See examples in the <basis-dir> folder.")
            stdout.flush    
            stdout.text("   --basis-dir <basis-dir>")
            stdout.flush    
            stdout.text("       The location of the <basis-set> library files. See --basis option above.")
            stdout.flush
            stdout.text("       Default: the TONTO_BASIS_SET_DIRECTORY environment variable if it is")
            stdout.text("                set, otherwise './basis_sets'")
          ! stdout.flush    
          ! stdout.text("   --charge <q>")
          ! stdout.flush    
          ! stdout.text("       Set the (integer) charge of the molecule in au. Default: 0.")
            stdout.flush    
            stdout.text("   --shelx-f  <hkl>")
            stdout.text("   --shelx-f2 <hkl>")
            stdout.text("   --std-f    <hkl>")
            stdout.text("   --std-f2   <hkl>")
            stdout.flush    
            stdout.text("       Supply one of the different <hkl> reflection files. The --shelx file is in")
            stdout.text("       fortran fixed format '(I4,I4,I4,8F,8F)' for h, k, l, F or F2, and sigma.")
            stdout.text("       The --std file format is free and whitespace separated. Extra items may")
            stdout.text("       at the end of each line, as well as blank lines and an (0 0 0) reflection.")
            stdout.text("       Comments of any kind are disallowed.")
            stdout.flush    
            stdout.text("   --cluster-radius <radius>")
            stdout.flush    
            stdout.text("       The electric potential from whole molecules within <radius> Angstrom of")
            stdout.text("       the fragment is modeled by Hirshfeld charges and dipoles placed at each")
            stdout.text("       atom site.")
            stdout.flush    
            stdout.text("       Default:  0")
            stdout.text("       Maximum: 10")
            stdout.flush    
            stdout.text("   --dispersion '<dispersion-coefficient-list>'")
            stdout.flush    
            stdout.text("       Enter dispersion coefficients to be used in the refinement as a quoted")
            stdout.text("       space-separated list of the element-symbol, f' and f'', repeated. Values")
            stdout.text("       for elements which are not specified are assumed to be zero.")
            stdout.flush    
            stdout.text("       Example: --dispersion 'S 0.04370 0.04026  Cl 0.05457 0.05224'")
            stdout.flush    
            stdout.text("       Default: No dispersion used")
            stdout.flush    
            stdout.text("   --disk-sfs [t|f]")
            stdout.flush    
            stdout.text("       Whether to write aspherical atomic structure factors to disk.")
            stdout.text("       With this information, write your own HAR refinement program!")
            stdout.flush    
            stdout.text("       Default: f")
            stdout.flush    
            stdout.text("   --dtol <dtol>")
            stdout.flush    
            stdout.text("       Convergence tolerance <dtol> for the DIIS extrapolation procedure.")
            stdout.flush    
            stdout.text("       Default: 0.01")
            stdout.text("       Minimum: 0.00001")
            stdout.flush    
            stdout.text("   --extinction [t|f]")
            stdout.flush    
            stdout.text("       Whether to correct extinction via the Larson formula.")
            stdout.flush    
            stdout.text("       Default: f")
          ! stdout.flush    
          ! stdout.text("   --refine-4th-order-only [t|f]'")
          ! stdout.flush    
          ! stdout.text("       Refine only the 4th order Gram-Charlier coefficients, leave any")
          ! stdout.text("       3rd order coefficients unchanged. If not specified in the CIF")
          ! stdout.text("       initial coeffiicents are assumed to be zero.")
            stdout.flush    
            stdout.text("   --fos <ratio>")
            stdout.flush    
            stdout.text("       The ratio of F/sigma below which the reflection is rejected.")
            stdout.flush    
            stdout.text("       Default: 3")
            stdout.text("       Minimum: 0")
            stdout.flush    
            stdout.text("   --fzcut <F_z>")
            stdout.flush    
            stdout.text("       If <cif-file> is from a previous HAR and has F_pred values, then remove")
            stdout.text("       reflections which have a z-score greater than F_z=(F_pred-F_expt)/sigma.")
            stdout.text("       Use this option with care only after an initial refinement to remove")
            stdout.text("       outliers. By default no reflections are pruned.")
            stdout.flush    
            stdout.text("   --grid-accuracy [very_low|low|medium|high|very_high|extreme]")
            stdout.flush
            stdout.text("       Accuracy needed for DFT integrations.")
            stdout.flush    
            stdout.text("       Default: low")
            stdout.flush
            stdout.text("   --group-charges '{ <q1> <q2> ... }'")
            stdout.flush
            stdout.text("       The charge on each atom group, in group order. One entry per group;")
            stdout.text("       hart stops if the count does not match. Quote the whole list: it is a")
            stdout.text("       single option value, and the braces and any minus signs must survive")
            stdout.text("       the shell.")
            stdout.flush
            stdout.text("       Example, for a zwitterion split into two residues:")
            stdout.text("                --group-charges '{ 1 -1 }'")
            stdout.flush
            stdout.text("       Default: every group neutral")
            stdout.flush
            stdout.text("   --group-multiplicities '{ <m1> <m2> ... }'")
            stdout.flush
            stdout.text("       The spin multiplicity <m>=2S+1 of each atom group, in group order.")
            stdout.text("       Same form and same one-per-group rule as --group-charges.")
            stdout.flush
            stdout.text("       Default: every group a closed-shell singlet")
            stdout.flush
            stdout.text("   --h-adps [t|f]")
            stdout.flush    
            stdout.text("       Set whether to refine the H-atom ADPs. If set to 'f' only H atom positions")
            stdout.text("       are refined.")
            stdout.flush    
            stdout.text("       Default: t")
            stdout.flush    
            stdout.text("   --h-iso [t|f] ")
            stdout.flush    
            stdout.text("       Set isotropic H-atom ADPs and then refine isotropically.")
            stdout.flush    
            stdout.text("       Default: f")
            stdout.flush    
            stdout.text("       - If '--h-adps f' is set you get isotropic H ADPs without refinement")
            stdout.text("       - Using this option will produce poorer X-H bond lengths")
            stdout.flush    
            stdout.text("   --h-pos [t|f]")
            stdout.flush    
            stdout.text("       Set whether to refine H atom positions.")
            stdout.flush    
            stdout.text("       Default: t")
            stdout.flush    
            stdout.text("   --help")
            stdout.flush    
            stdout.text("       Print this documentation")
            stdout.flush    
            stdout.text("   --job <job>")
            stdout.flush    
            stdout.text("       The name of the job; used to name the output file and other intermediates.")
            stdout.flush    
            stdout.text("       Default: The head of <cif-file> e.g. 'urea' if <cif-file> is 'urea.cif'.")
            stdout.text("                The name of the output-file will then be <job>.out")
            stdout.flush
            stdout.text("   --max-iterations <n>")
            stdout.flush
            stdout.text("       Stop after at most <n> iterations, whether or not the refinement has")
            stdout.text("       converged. Caps both the rigid-atom fit and the outer HAR cycle. Useful")
            stdout.text("       for a smoke test, or to bound a long job. Must be 3 or more.")
            stdout.flush
            stdout.text("       Default: 100")
            stdout.flush
            stdout.text("   --mmcif [t|f]")
            stdout.flush
            stdout.text("       Read the <cif-file> as an mmCIF, i.e. with '_atom_site.' item names and")
            stdout.text("       residue (compound sequence) labels. Residues are then split into capped")
            stdout.text("       fragments by Ulf Ryde's method and refined by fragHAR.")
            stdout.flush
            stdout.text("       Default: f")
          ! stdout.flush    
          ! stdout.text("   --ldtol <ldtol>")
          ! stdout.flush    
          ! stdout.text("       Eliminate linear dependent basis functions i.e. eigenfunctions of the overlap")
          ! stdout.text("       matrix, with eigenvalue less that <tol>.  Default: 0.00001.")
          ! stdout.flush    
          ! stdout.text("   --mult <m>")
          ! stdout.flush    
          ! stdout.text("       The multiplicity of the <wavefunction> i.e. <m>=2S+1 where S is the total spin.")
          ! stdout.text("       Default: 1.")
            stdout.flush
            stdout.text("   --residual-cube [t|f]")
            stdout.flush
            stdout.text("       Write a residual-density cube over the unit cell after refinement.")
            stdout.text("       This is by far the largest file a refinement produces -- megabytes even")
            stdout.text("       for a dipeptide -- so turn it off for large structures or batch runs.")
            stdout.flush
            stdout.text("       Default: t")
            stdout.flush
            stdout.text("   --scf <wavefunction>")
            stdout.flush    
            stdout.text("       The scf <wavefunction> to be used. Allowed options:")
            stdout.flush    
            stdout.text("       rhf     restricted Hartree-Fock")
            stdout.text("       rks     restricted Kohn-Sham/BLYP")
            stdout.flush    
            stdout.text("       Default: rhf")
          ! stdout.text("       uhf     unrestricted Hartree-Fock")
          ! stdout.text("       uks     unrestricted Kohn-Sham/BLYP")
          ! stdout.text("       gchf    general-complex (relativistic) Hartree-Fock")
          ! stdout.flush    
          ! stdout.text("   --scf-guess [mos|density]")
          ! stdout.flush    
          ! stdout.text("       Initial guess for SCF <wavefunction> method.")
          ! stdout.flush    
            stdout.flush
            stdout.text("   --wavelength <wavelength>")
            stdout.flush
            stdout.text("       The <wavelength> of the X-radiation, in Angstrom. Needed only when the")
            stdout.text("       <cif-file> has no _diffrn_radiation_wavelength item; it defines the")
            stdout.text("       Bragg angle of each reflection.")
            stdout.flush
            stdout.text("       Default: taken from the <cif-file>")
            stdout.flush
            stdout.text("   --complete-mol [t|f] ")
            stdout.flush    
            stdout.text("       Set 't' to complete molecules for SC cluster point charges.")
            stdout.text("       Should be false in case of network compounds.")
            stdout.flush    
            stdout.text("       Default: TRUE")
            stdout.flush
            stdout.text("   --version")
            stdout.flush
            stdout.text("       Print the version of hart and stop")

            stop

         case default
            stdout.text("Type 'hart --help' for help.")
            stdout.flush
            UNKNOWN(option)
            stop 1

      end

   end


   ! Initialize output file
   stdout.destroy
   stdout.create
   stdout.set_name(out)
   stdout.open_for("write")
   tonto.set_stdout_unit(stdout.unit)

   ! Report
   stdout.text("======================================")
   stdout.text("Welcome to the hart refinement program")
   stdout.text("======================================")

   stdout.flush
   stdout.text("This is a command line program for performing Hirshfeld atom")
   stdout.text("refinement (HAR) on a crystal structure stored in a CIF file")
   stdout.text("using the Tonto library for quantum crystallography.")
   stdout.flush
   stdout.text("For detailed help, run the command:")
   stdout.flush
   stdout.text("   hart --help")
   stdout.flush
   stdout.text("If you publish any of the results from this program please")
   stdout.text("cite the following original scientific publications:")
   stdout.flush
   stdout.text("   D. Jayatilaka & B. Dittrich (2008) Acta Cryst. A 64 p. 383")
   stdout.text("   S. Capelli et al (2014) IUCrJ 1 p. 361")
   stdout.text("   M. Woinska et al (2016) Sci. Adv. 2 e1600192")

   stdout.flush
   stdout.flush
   stdout.text("===============")
   stdout.text("Program options")
   stdout.text("===============")
   stdout.flush
   stdout.text("You have run hart with the following options:")
   command_line.put_command_optarg

   stdout.flush
   stdout.text("The hart program version is:")
   stdout.text("                                                               ")
   stdout.text("Version: "//TONTO_VERSION//" v. "//GIT_VERSION)
   stdout.text("Platform: "//TONTO_PLATFORM)
   stdout.text("Build-date: "//TONTO_BUILD_DATE)

   stdout.flush
   stdout.flush
   stdout.text("=======")
   stdout.text("WARNING")
   stdout.text("=======")

   stdout.flush
   stdout.text("This software is always under heavy development and many")
   stdout.text("authors release codes before they are fully tested. Do not")
   stdout.text("use codes which have not been tested if they have not been")
   stdout.text("published in the literature. Contact original authors, who")
   stdout.text("will generally be interested to obtain help with testing,")
   stdout.text("validation, and publication.")

   stdout.flush
   stdout.flush
   stdout.text("=======")
   stdout.text("License")
   stdout.text("=======")

   stdout.flush
   stdout.text("This program is distributed under the terms of the GNU")
   stdout.text("Lesser General Public License (LGPL) version 3, the full")
   stdout.text("text of which is available at:")
   stdout.flush
   stdout.text("  www.gnu.org/licenses/lgpl-3.0.en.html")

 ! stdout.flush
 ! stdout.flush
 ! stdout.text("============")
 ! stdout.text("Contributors")
 ! stdout.text("============")

 ! stdout.flush
 ! stdout.text("Tonto & the hart program has been brought to you with the work")
 ! stdout.text("of the following groups and companies:")
 ! stdout.flush
 ! stdout.text(". The University of Western Australia (Jayatilaka)")
 ! stdout.text(". The University of Bremen (Grabowsky)")
 ! stdout.text(". The Slovak University of Technology (Bucinsky)")
 ! stdout.text(". The University of Warsaw (Dominiak,Wozniak)")
 ! stdout.text(". Olex2 @ Durham University (Puschmann,Dolomanov)")

 ! stdout.flush
 ! stdout.text("Important individual contributions are listed below")
 ! stdout.text("in roughly chronological order:")
 ! stdout.flush
 ! stdout.text(". D. Jayatilaka     - System design & conception.  Help.")
 ! stdout.text("                      Hirshfeld atom refinement (HAR)")
 ! stdout.text("                      X-ray constrained wavefunctions (XCW)")
 ! stdout.flush                     
 ! stdout.text(". D. Grimwood       - System design, integrals, XCW")
 ! stdout.flush                     
 ! stdout.text(". S. Wolff          - DFT, integration grids, isosurfaces")
 ! stdout.text("                      Roby bond indices")
 ! stdout.flush                     
 ! stdout.text(". C. Taylor         - Roby bond indices")
 ! stdout.flush                     
 ! stdout.text(". A. Whitton        - Joint X-ray/PND fitting")
 ! stdout.text("  M. Hudak")        
 ! stdout.flush                     
 ! stdout.text(". A. Whitten        - Sum-over-states (SOS) polarisabilities")
 ! stdout.text("  M. Spackman         in-crystal refractive indices")
 ! stdout.flush                     
 ! stdout.text(". M. Turner         - CPHF, Polarisabilities, energies")
 ! stdout.text("                      isosurface face capping,")
 ! stdout.text("                      CrystalkExplorer interface")
 ! stdout.flush                     
 ! stdout.text(". L. Bucinsky       - Relativistic methods")
 ! stdout.flush                     
 ! stdout.text(". B. Dittrich       - Original HAR method, dipersion")
 ! stdout.flush                     
 ! stdout.text(". M. Susli          - gnuplot picture output")
 ! stdout.flush                     
 ! stdout.text(". S. Grabowsky      - X-ray wavefunction refinement (XWR)")
 ! stdout.text("                      ELI-D and bonding tools")
 ! stdout.flush
 ! stdout.text(". J. Kreszczakovska - Anharmonicity & babies")
 ! stdout.text("  (nee Bak)")
 ! stdout.flush
 ! stdout.text(". H.-B. Buergi      - HAR validation & anharmonicity")
 ! stdout.text("  S. Capelli")
 ! stdout.text("  L. Malaspina")
 ! stdout.flush                     
 ! stdout.text(". M. Woinska        - H atom positions & ADPs; F2 refinement")
 ! stdout.flush                     
 ! stdout.text(". P. Cassam-Chenai  - Geminal/CI methods")
 ! stdout.flush                     
 ! stdout.text(". P. Spackman       - Build system, Travis test integration")
 ! stdout.text("                      B3LYP, spherical harmonics, multipoles")
 ! stdout.text("                      isosurface informatics")
 ! stdout.text("                      CrystalExplorer interface")
 ! stdout.flush                     
 ! stdout.text(". K. Abdalhussein   - Bond indices, bond energies,")
 ! stdout.text("                      finite temperature SCF")
 ! stdout.flush                     
 ! stdout.text(". M. Davidson       - Nonorthogonal SCF & ELMO")
 ! stdout.flush                     
 ! stdout.text("Did I forget anyone? Let me know.")

 ! stdout.flush
 ! stdout.flush
 ! stdout.text("Tonto library methods will now be called ...")
 ! stdout.flush
 ! stdout.flush

   ! Start timer !!!!!!!
   std_time.start_timing
   !!!!!!!!!!!!!!!!!!!!!

   ! Post-processing
 ! DIE_IF(shx_f2==" " AND shx_f==" " AND std_f2==" " AND std_f==" ", "no .hkl file supplied")
   ! Where are the basis sets? If --basis-dir was not given, fall back to the
   ! environment, exactly as run_molecule.foo does, so that hart can be run
   ! from anywhere without a machine-specific path on the command line.
   if (basdir==" ") then
      call get_environment_variable(BASIS_LIBRARY_ENV_NAME, basdir, status=i)
      if (i/=0) basdir = " "
   end
   if (basdir==" ") basdir = "./basis_sets"
   ! No check on the directory itself: whether INQUIRE reports a directory as
   ! existing is compiler dependent. The basis file inside it is checked below,
   ! and that message names the full path anyway.
   DIE_IF(NOT basis.is_one_of(allowed_bases), "unknown basis: "//trim(basis))
   DIE_IF(     dtol <TOL(5), "dtol is too small: "//trim(dtol.to_str))
   DIE_IF(     dtol >TOL(1), "dtol is too large: "//trim(dtol.to_str))
 ! DIE_IF(NOT ldtol <TOL(5), "ldtol is too small: "//trim(ldtol.to_str))
   DIE_IF(       fos<ZERO, "fos ratio must be positive")
   DIE_IF(    radius<ZERO, "radius must be positive")
   DIE_IF(    radius>ten,  "radius must be less than 10 angstrom")
   DIE_IF(NOT gracc.is_one_of(grid_levels), "unknown grid accuracy: "//trim(gracc))
   ! Validated here, not in the setter: DIFFRACTION_DATA's own check is an
   ! ENSURE and compiles away in the optimised build every user has. The lower
   ! bound is min_iterations, which defaults to 2.
   DIE_IF(maxit<0,"--max-iterations must not be negative")
   DIE_IF(maxit>0 AND maxit<3,"--max-iterations must be 3 or more (min_iterations is 2)")
   DIE_IF(NOT guess.is_one_of(["mos    ","density"]),"unknown initial guess: "//trim(guess))
   DIE_IF(NOT   scf.is_one_of(["rhf ","rks "]),"unknown scf: "//trim(scf))

   ! Basis exists?
   basnam = trim(basdir)//"/"//trim(basis)
   file.create(basnam)
   DIE_IF(NOT file.exists,"basis set does not exist: "//trim(basnam))
   file.destroy

   ! Initialize molecule
   m.SET:create
   GAUSSIAN_DATA:set_indices(GAUSSIAN_DATA_L_MAX)
   MOLECULE.MAIN:put_banner
   m.SET:set_name(job)
   m.SET:set_basis_directory(basdir)
   m.SET:set_basis_name(basis)
   m.SET:set_charge(charge)
   m.SET:set_spin_multiplicity(mult)

   ! Read CIF
   m.cif.create
   m.cif.set_file_name(cif)

   ! An mmCIF? This must be set BEFORE process_CIF, since it selects which
   ! item names are looked for (_atom_site.* rather than _atom_site_*) and
   ! brings in the compound_sequence_id's that Ryde capping groups on.
   if (mmcif) m.cif.set_is_mmCIF(TRUE)

   m.CE:process_CIF
   m.cif.update

   ! Complete whole molecules?
   if (defragment) then
      m.CE:defragment
   end

   ! Set job name
   m.SET:set_name(job)

   ! More checks
   DIE_IF(m.crystal.deallocated,          "no crystal information available!")
   DIE_IF(m.crystal.xray_data.deallocated,"no x-ray F structure factors supplied!")
   DIE_IF(m.atom.deallocated,             "no atoms specified")
   DIE_IF(any(m.atom.atomic_number>36),  "hart is not routinely available for heavy atoms, Z>36")
   tmetal = any(m.atom.atomic_number>=21 AND m.atom.atomic_number<=30)
   DIE_IF(tmetal, "hart is not routinely available for transition metals")

   ! Isotropic H ADPs? Set them.
   if (h_iso) &
   m.atom.set_isotropic_H_ADP

   ! Diffraction data info !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
   m.crystal.xray_data.SET:set_data_kind("x-ray")
   m.crystal.xray_data.SET:set_partition_model("oc-hirshfeld")
   m.crystal.xray_data.SET:set_refine_extinction(extinct)
   m.crystal.xray_data.SET:set_use_text_SFs(disk_sfs)
   m.crystal.xray_data.set_do_residual_cube(rescube)

   ! Cap the refinement. Bounds BOTH loops -- the inner rigid-atom fit and the
   ! outer HAR cycle -- since too_many_fit_iterations and too_many_ref_iterations
   ! are both measured against max_iterations.
   if (maxit>0) &
   m.crystal.xray_data.set_max_iterations(maxit)

   ! Wavelength. Not every CIF carries _diffrn_radiation_wavelength, and
   ! DIFFRACTION_DATA defaults it to -1 i.e. "not set", which leaves theta
   ! undefined for every reflection. Only override when asked. The option is
   ! in Angstrom and converted here, exactly as the CIF reader does with
   ! _diffrn_radiation_wavelength; the stored quantity is in Bohr.
   if (wavelen>ZERO) &
   m.crystal.xray_data.set_wavelength(wavelen*BOHR_PER_ANGSTROM)

   ! Ulf Ryde's capped residues. Only meaningful for an mmCIF, which is where
   ! the compound_sequence_id's come from, so it follows --mmcif rather than
   ! being an option of its own: splitting a covalent chain into residues
   ! WITHOUT capping would leave dangling bonds, so there is no second choice
   ! to offer. A multi-molecule (non-polymer) asymmetric unit needs no capping
   ! and is grouped by plain connectivity instead -- see below.
   if (mmcif) &
   m.crystal.xray_data.set_use_Ryde_capping(TRUE)

   ! Dispersion
   if (disperse.allocated) then
   ATOM:set_dispersion_coefficients(disperse)
   m.atom.set_tabular_dispersion
   m.crystal.xray_data.SET:set_add_dispersion_to_F_calc(TRUE)
   end

   ! Anharmonicity
   if (anharm.allocated) then
   m.crystal.xray_data.SET:set_refine_4th_order(anharm)
   m.crystal.xray_data.SET:set_refine_4th_order_only(do_4_only)
   end

   ! Refine isotropic H ADPs?
   if (h_iso) &
   m.crystal.xray_data.SET:set_refine_H_U_iso(TRUE)

   ! Refine H ADPs at all?
   m.crystal.xray_data.SET:set_refine_H_ADPs(h_ADPs)

   ! Refine H positions at all?
   m.crystal.xray_data.SET:set_refine_H_positions(h_pos)
   
   ! Read reflections from a separate file?
        if (shx_f2/=" ") then
      file.create(shx_f2)
      file.open_for("read")
      m.crystal.xray_data.reflections.read_shelx_F2_hkl_file(file)
      file.destroy
   else if (shx_f /=" ") then
      file.create(shx_f )
      file.open_for("read")
      m.crystal.xray_data.reflections.read_shelx_F_hkl_file(file)
      file.destroy
   else if (std_f2/=" ") then
      file.create(std_f2)
      file.open_for("read")
      m.crystal.xray_data.reflections.read_std_F2_hkl_file(file)
      file.destroy
   else if (std_f /=" ") then
      file.create(std_f )
      file.open_for("read")
      m.crystal.xray_data.reflections.read_std_F_hkl_file(file)
      file.destroy
   end

   ! Finalize data, and do data pruning
   m.crystal.xray_data.SET:set_F_sigma_cutoff(fos)
   if (fzcut>ZERO) &
   m.crystal.xray_data.SET:set_F_z_cutoff(fzcut)
   m.crystal.xray_data.SET:update(m.crystal.unit_cell,m.crystal.spacegroup)
   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

   ! Atom groups !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
   !
   ! Remake them now that use_Ryde_capping is known. This mirrors what a tonto
   ! job does: the groups are first made during process_CIF, when capping is
   ! still off, and remade when the crystal block is read -- MOLECULE.MAIN's
   ! read_crystal ends in exactly this call. Without it, an --mmcif run keeps
   ! the connectivity groups it built earlier and Ryde capping never happens.
   m.update_atom_basis_group_info

   n_groups = 0
   if (m.atom_group.allocated) n_groups = m.atom_group.dim

   ! fragHAR, or plain HAR? Decided by the data, not by an option: more than
   ! one group means more than one molecule (or capped residue) in the
   ! asymmetric unit, which is precisely the case HAR_refinement cannot do.
   do_fragHAR = n_groups>1

   ! Charges and multiplicities are per group, so the lists must be the length
   ! the structure actually has. Getting this wrong silently -- refining a
   ! zwitterion as two neutral fragments, say -- gives a converged, plausible,
   ! wrong answer, so it is a DIE and the message names both numbers.
   if (grp_charge.allocated) then
      DIE_IF(grp_charge.dim/=n_groups, &
             "--group-charges has "//trim(grp_charge.dim.to_str)// &
             " entries but there are "//trim(n_groups.to_str)//" atom groups")
   end
   if (grp_mult.allocated) then
      DIE_IF(grp_mult.dim/=n_groups, &
             "--group-multiplicities has "//trim(grp_mult.dim.to_str)// &
             " entries but there are "//trim(n_groups.to_str)//" atom groups")
   end

   ! Self-consistent cluster charges are a whole-molecule SCF idea and the
   ! fragment SCF does not use them. Silently ignoring --cluster-radius would
   ! hand back a refinement that is not the one that was asked for.
   DIE_IF(do_fragHAR AND radius>ZERO, &
          "--cluster-radius is not (yet) available with fragment refinement")
   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


   !!!!!!!!!
   m.PUT:put
   !!!!!!!!!

   ! Apply the per-group charges and multiplicities, then remake the group
   ! sub-molecules so they pick them up. Same two steps, in the same order, as
   ! MOLECULE.MAIN:read_atom_groups -- read onto the groups, then update.
   if (grp_charge.allocated OR grp_mult.allocated) then

      ! .atom_group_charges is the copy that SURVIVES. set_connected_atom_groups
      ! re-applies it every time the groups are rebuilt from the connection
      ! table, and fragHAR_refinement rebuilds them on every LS cycle. A charge
      ! written only onto the group itself would be dropped there.
      if (grp_charge.allocated) then
         m.atom_group_charges.create(n_groups)
         m.atom_group_charges = grp_charge
      end

      do g = 1,n_groups
         if (grp_charge.allocated) m.atom_group(g).set_charge(grp_charge(g))
         if (grp_mult.allocated)   m.atom_group(g).set_spin_multiplicity(grp_mult(g))
      end

      m.update_atom_basis_group_info

   end

   ! Set Becke grid
   m.becke_grid.create
   m.becke_grid.set_atom_info(m.atom)
   m.becke_grid.set_accuracy(gracc)
   m.becke_grid.set_grid_data

   ! Initial SCF - only if using cluster charges
   m.SCF_data.create
   if (do_fragHAR) then
      ! Each fragment gets its own SCF, driven by MOLECULE.SCF:fragment_SCF.
      ! The kinds are literally "fragment-rhf" / "fragment-rks" -- see the
      ! dispatch in molecule.scf.foo and the SCF_kind case list in scf_data.foo.
      m.SCF_data.set_SCF_kind("fragment-"//trim(scf))
   else
      m.SCF_data.set_SCF_kind(scf)
   end
   spinorbitals = m.SCF_data.spinorbital_genre
   m.SCF_data.set_initial_density("promolecule")

   ! NO second guess call here. The block that used to sit here was
   !
   !    select case (guess)
   !    case ("density"); m.SCF_data.set_initial_MOs(spinorbitals)
   !    case ("mos    "); m.SCF_data.set_initial_density(spinorbitals)
   !    end
   !
   ! and it was fatal. "guess" is always "mos" (--scf-guess is one of the
   ! frozen options), so it always ran the second branch, and
   ! SCF_DATA:set_initial_density("restricted") does not mean "guess a
   ! restricted density" -- it rewrites .initial_density to "r", i.e. *read*
   ! a restricted density from an SCF archive. No archive exists on a first
   ! run, so the SCF read garbage and segfaulted. It also silently discarded
   ! the promolecule guess set on the line above. (The two branches are
   ! swapped against their own names as well: "density" called set_initial_MOs.)
   !
   ! The equivalent tonto job -- tests/long/urea_rhf_STO-3G_HAR/stdin -- sets
   ! `initial_density= promolecule` and nothing else, which is what hart now
   ! does. Reviving --scf-guess means rewriting this correctly, not restoring
   ! the above. See DEFERRED.md.
   m.SCF_data.set_convergence(TOL(3))
   m.SCF_data.SCF_DIIS.set_convergence_tolerance(dtol)
   m.SCF_data.set_linear_dependence_tol(ldtol)

   ! Damping and level shifting for the fragment SCF. Fragments are charged
   ! and often open-shell-looking near the promolecule guess, so the plain
   ! DIIS settings above oscillate. These are the values the equivalent tonto
   ! job uses (tests/long/gly_ala_fragHAR_rhf_STO-3G/stdin) -- hardcoded here
   ! in the same spirit as the SCF/DIIS tolerances hart already fixes.
   if (do_fragHAR) then
      m.SCF_data.set_using_damping(TRUE)
      m.SCF_data.set_damp_factor(0.99d0)
      m.SCF_data.set_using_level_shift(TRUE)
      m.SCF_data.set_level_shift(100.0d0)
   end

   m.SCF_data.update

   ! A whole-of-asymmetric-unit SCF, but ONLY for a single fragment. With more
   ! than one fragment there is no single molecule to converge -- the fragments
   ! are separate wavefunctions and fragHAR_refinement does their SCF itself
   ! (via fragment_SCF, first call before the LS cycle). The tonto job has its
   ! `scf` keyword commented out for the same reason.
   if (NOT do_fragHAR) then

      !!!!!!!!!
      m.SCF:scf
      !!!!!!!!!

      ! Cluster/ED SCF settings
      radius_is_0 = abs(radius) < TOL(2)
      if (NOT radius_is_0) then
         m.SCF_data.set_using_SC_cluster_charges(TRUE)
         m.SCF_data.set_cluster_radius(radius)
         m.SCF_data.set_defragment(defragment)
         m.SCF_data.update
         m.SCF:scf ! Cluster charge SCF here
      end

   end


   ! HAR !!!!!!!!!!!!!!!!!!!!!!
   if (do_fragHAR) then
      m.fragHAR_refinement
   else
      m.HAR:HAR_refinement
   end
   !!!!!!!!!!!!!!!!!!!!!!!!!!!!

   ! Job timing
   stdout.flush
   mess  = "job "//'"'// trim(m.name) //'"'
   ctime = std_time.elapsed_time_message(mess)
   etime = std_time.elapsed_cpu_time_message(mess)
   stdout.text(etime)
   stdout.text(ctime)

   ! Clean-up
   MOLECULE.MAIN:cleanup

   ! Clean-up files
   TEXTFILE:destroy(std_err)
   TEXTFILE:destroy(stdout)
   TEXTFILE:destroy(stdin)

   ! Clean-up tonto system
   TONTO_DESTROY

end
