program run_QUADRATURE

! Exercise every rule in the QUADRATURE module against integrals known in
! closed form, and fail loudly if any is wrong. Registered as the
! `quadrature_rules` ctest; no reference file is involved. The checks
! themselves are QUADRATURE:check_rules.

   implicit none

   n_failed :: INT

   TONTO_CREATE
   std_time.start_timing

   TEXTFILE::create_std_err
   std_err.open_for("write")
   TEXTFILE::create_stdout

   n_failed = QUADRATURE:check_rules()

   DIE_IF(n_failed>0,"QUADRATURE rule check failed")

   TEXTFILE:destroy(std_err)
   TEXTFILE:destroy(stdout)
   TONTO_DESTROY

end
