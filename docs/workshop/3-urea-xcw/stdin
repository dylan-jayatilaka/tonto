{

   ! Exercise 3 -- X-ray constrained wavefunction (XCW) fitting on the
   ! geometry that exercise 2 refined. HAR then XCW on the HAR geometry
   ! is what is called an X-ray wavefunction refinement (XWR).
   !
   ! Copy urea.archive.cif here from exercise 2 first. It holds the
   ! refined coordinates and ADPs but not the reflections, so those come
   ! from urea.hkl.
   !
   ! No cluster charges: this is the isolated molecule constrained by
   ! the data, and nothing else.

   name= urea

   basis_name= def2-SVP

   charge= 0
   multiplicity= 1

   CIF= { file_name= urea.archive.cif  data_block_name= urea }
   process_CIF

   crystal= {

      xray_data= {

         wavelength= 0.3173 angstrom

         partition_model= oc-hirshfeld

         optimise_extinction= NO
         optimise_scale_factor= YES

         do_residual_cube= NO

         REDIRECT urea.hkl

         show_refinement_output=  FALSE
         show_refinement_results= TRUE

      }
   }

   ! The unconstrained wavefunction: lambda = 0. Every overlap <MO|M0>
   ! in the results table is measured against the orbitals from this SCF.
   scfdata= {
      kind=            rhf
      initial_density= promolecule
      convergence= 0.001
      diis= { convergence_tolerance= 0.01 }
   }
   scf

   ! Now turn the constraint on, gently: lambda = 0.01, 0.02, 0.03.
   scfdata= {

      kind= xray_rhf

      initial_density= restricted

      convergence= 0.001
      diis= { convergence_tolerance= 0.01 }

      max_iterations= 150

      use_damping=        YES
      damp_factor=        0.50
      damp_finish=        3
      use_level_shift=    NO
      level_shift_finish= 3

      initial_lambda= 0.01
      lambda_step=    0.01
      lambda_max=     0.03

   }
   scf

   ! Straight on from the converged lambda = 0.03 orbitals -- that is what
   ! initial_density= restricted picks up -- to lambda = 0.1, 0.2, 0.3.
   scfdata= {

      kind= xray_rhf

      initial_density= restricted

      convergence= 0.001
      diis= { convergence_tolerance= 0.01 }

      max_iterations= 150

      use_damping=        YES
      damp_factor=        0.50
      damp_finish=        3
      use_level_shift=    NO
      level_shift_finish= 3

      initial_lambda= 0.1
      lambda_step=    0.1
      lambda_max=     0.3

   }
   scf

   delete_scf_archives

}
